+def _recorders(monkeypatch):
+    """Replace the three operators by recorders; returns the call list."""
+    calls = []
+    for module, name in (
+        (exl3_ops, "linear_out"),
+        (exl3_ops, "linear_out_splitk"),
+        (tc, "linear_out_prefill"),
+    ):
+        monkeypatch.setattr(
+            module, name, lambda *args, _name=name: calls.append((_name, args))
+        )
+    return calls
+
