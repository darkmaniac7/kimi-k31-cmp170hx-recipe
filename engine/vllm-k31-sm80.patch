+def test_kimi_moe_uses_fused_router_and_passes_precomputed_routing(monkeypatch):
+    from vllm.model_executor.layers.fused_moe.router.gate_linear import GateLinear
+    from vllm.model_executor.layers.fused_moe.router.grouped_topk_router import (
+        GroupedTopKRouter,
+    )
+    from vllm.models.kimi_k3.nvidia.model import KimiMoE
+
+    _clear_env(monkeypatch)
+    fake = FakeGlueOps().install(monkeypatch)
+
+    M, H, E, top_k = 8, 64, 32, 4
+    moe = KimiMoE.__new__(KimiMoE)
+    nn.Module.__init__(moe)
+    moe.use_mega_moe = False
+    moe.use_grouped_topk = True
+    moe.routed_expert_down_proj = None
+    moe.moe_renormalize = True
+    moe.routed_scaling_factor = 1.75
+    moe.num_expert_group = 1
+    moe.topk_group = 1
+    moe.moe_router_activation_func = "sigmoid"
+
+    gate = GateLinear.__new__(GateLinear)
+    nn.Module.__init__(gate)
+    gate.is_unquantized = True
+    gate.bias = None
+    gate.weight = nn.Parameter(torch.randn(E, H, dtype=torch.bfloat16), requires_grad=False)
+    gate.e_score_correction_bias = nn.Parameter(
+        torch.randn(E, dtype=torch.float32), requires_grad=False
+    )
+    gate_calls = []
+
+    def _gate_forward(x):
+        gate_calls.append(x.shape)
+        return F.linear(x.float(), gate.weight.float()), None
+
+    gate.forward = _gate_forward
+    moe.gate = gate
+
+    router = GroupedTopKRouter.__new__(GroupedTopKRouter)
+    nn.Module.__init__(router)
+    router.top_k = top_k
+    router.renormalize = True
+    router.routed_scaling_factor = 1.75
+    router.num_expert_group = 1
+    router.topk_group = 1
+    router.scoring_func = "sigmoid"
+    router.e_score_correction_bias = gate.e_score_correction_bias
+
+    expert_calls = []
+
+    class _FakeExperts(nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.router = router
+
+        def can_use_precomputed_routing(self) -> bool:
+            return True
+
+        def forward(
+            self,
+            hidden_states,
+            router_logits,
+            shared_experts_input=None,
+            topk_weights=None,
+            topk_ids=None,
+        ):
+            expert_calls.append((topk_weights, topk_ids, router_logits))
+            return hidden_states
+
+    moe.experts = _FakeExperts()
+    x = torch.randn(M, H, dtype=torch.bfloat16)
+
+    # Switch OFF: stock gate runs, topk_ids is None.
+    moe.forward(x)
+    assert len(gate_calls) == 1
+    assert len(fake.calls_for("fused_router_gemv_topk")) == 0
+    assert expert_calls[-1][0] is None and expert_calls[-1][1] is None
+
+    # Switch ON: fused_router_gemv_topk runs, gate bypassed, precomputed routing passed.
+    monkeypatch.setenv("VLLM_K31_GLUE_FUSED_ROUTER", "1")
+    moe.forward(x)
+    assert len(gate_calls) == 1
+    assert len(fake.calls_for("fused_router_gemv_topk")) == 1
+    tw, ti, _ = expert_calls[-1]
+    assert tw is not None and ti is not None
+    ref_w, ref_i = ref_moe_topk_sigmoid(
+        F.linear(x.float(), gate.weight.float()),
+        gate.e_score_correction_bias.data,
+        top_k,
+        True,
+        1.75,
+    )
+    torch.testing.assert_close(tw, ref_w)
+    torch.testing.assert_close(ti, ref_i)
+
+    # Forward hook on gate cleanly falls back to stock gate.
+    hook_hits = []
+    handle = gate.register_forward_hook(lambda m, i, o: hook_hits.append(1))
+    try:
+        moe.forward(x)
+    finally:
+        handle.remove()
+    assert len(gate_calls) == 2
+    assert len(hook_hits) == 1
+    assert len(fake.calls_for("fused_router_gemv_topk")) == 1
+
