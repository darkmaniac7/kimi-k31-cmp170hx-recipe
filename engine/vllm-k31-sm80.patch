index 0000000000..39c5837d2a
--- /dev/null
+++ b/tests/models/kimi_k3/sm80/fake_vq.py
@@ -0,0 +1,220 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""A recording stand-in for the native VQ ops module
+(vllm/sm80/kernels/k31q/vq_ops.py) for CPU tests of the engine side.
+
+It computes nothing a kernel computes. ``vq_pack`` returns tensors of the
+documented packed shapes whose first words are a fingerprint of exactly the
+canonical data it was given, per expert, so a test can follow a pointer of
+the engine's table and tell which expert of which projection and which
+I-blocks it addresses, from the checkpoint file alone (:func:`fingerprint`).
+The MoE operators record their arguments and fill the output.
+
+It also accounts for "device" memory. On the CPU the device copy of a tensor
+would be the tensor itself, so :meth:`FakeVqOps.install` replaces the
+engine's one device-copy function by one that clones and registers the
+clone; ``vq_pack`` registers what it returns. Only weak references are kept,
+so a tensor counts while the engine keeps it alive: :attr:`FakeVqOps.events`
+has, per event, the bytes of canonical records, of codebooks and of packed
+tensors alive at that moment.
+"""
+
+import weakref
+from dataclasses import dataclass, field
+
+import numpy as np
+import torch
+
+FINGERPRINT_PRIME = 2147483629  # below 2 ** 31: fits the packed int32 words
+RATE_IDS = {(2, 3): 0, (2, 4): 1, (2, 5): 2, (4, 5): 3, (4, 6): 4}
+
+
+def fingerprint(records: np.ndarray) -> list[int]:
+    """Three int32 words of one expert's records U8 [blocks, record bytes]:
+    the number of bytes, their sum and a position-weighted sum, so another
+    expert, another projection, another block range or the blocks in another
+    order give other words."""
+    data = np.ascontiguousarray(records).reshape(-1)
+    weights = np.arange(data.size, dtype=np.int64) % 65521 + 1
+    return [
+        data.size % FINGERPRINT_PRIME,
+        int(data.sum(dtype=np.int64) % FINGERPRINT_PRIME),
+        int(np.dot(data.astype(np.int64), weights) % FINGERPRINT_PRIME),
+    ]
+
+
+def words_per_lane(dim: int, index_bits: int) -> int:
+    """Words of one lane of a packed tile (csrc/k31_vq/moe_vq_k31.cu)."""
+    bits_per_tile = 4 * index_bits if dim == 2 else 2 * index_bits
+    return (8 * bits_per_tile + 31) // 32
+
+
+@dataclass
+class Event:
+    name: str
+    records: int  # bytes of canonical idx and scale records on the "device"
+    codebooks: int
+    packed: int
+
+    @property
+    def total(self) -> int:
+        return self.records + self.codebooks + self.packed
+
+
+@dataclass
+class FakeVqOps:
+    fill: float = 7.0
+    packs: list = field(default_factory=list)
+    calls: list = field(default_factory=list)
+    workspace_calls: list = field(default_factory=list)
+    events: list = field(default_factory=list)
+    moves: list = field(default_factory=list)  # (kind, shape) of each device copy
+
+    def __post_init__(self):
+        self._alive: list[tuple[weakref.ref, str, int]] = []
+
+    # -- accounting ----------------------------------------------------------
+
+    def install(self, monkeypatch) -> "FakeVqOps":
+        """Make this object the native VQ module of every model built in the
+        test, with its own codebook cache and device-copy accounting."""
+        from vllm.sm80.kernels.k31q import moe
+
+        monkeypatch.setenv("VLLM_K31Q_VQ_BACKEND", "native")
+        monkeypatch.setattr(moe, "load_vq_native", lambda: self)
+        monkeypatch.setattr(moe, "_VQ_CODEBOOKS", {})
+        monkeypatch.setattr(moe, "_device_copy", self._device_copy)
+        return self
+
+    def _track(self, tensor: torch.Tensor, kind: str) -> None:
+        self._alive.append((weakref.ref(tensor), kind, tensor.nbytes))
+
+    def _device_copy(self, tensor: torch.Tensor, device) -> torch.Tensor:
+        copy = tensor.clone()
+        kind = "codebooks" if tensor.dim() == 2 else "records"
+        self.moves.append((kind, tuple(tensor.shape)))
+        self._track(copy, kind)
+        self._event(f"copy {kind} {tuple(tensor.shape)}")
+        return copy
+
+    def _event(self, name: str) -> None:
+        live = {"records": 0, "codebooks": 0, "packed": 0}
+        for reference, kind, size in self._alive:
+            if reference() is not None:
+                live[kind] += size
+        self.events.append(Event(name, **live))
+
+    def live(self) -> Event:
+        self._event("now")
+        return self.events.pop()
+
+    @property
+    def peak(self) -> int:
+        return max(event.total for event in self.events)
+
+    # -- the module's functions ------------------------------------------------
+
+    @staticmethod
+    def vq_rate_id(dim: int, index_bits: int) -> int:
+        return RATE_IDS.get((dim, index_bits), -1)
+
+    def vq_pack(
+        self,
+        idx_records,
+        scale_records,
+        codebook,
+        role,
+        hidden_size,
+        dim,
+        index_bits,
+        group_size=128,
+    ):
+        assert idx_records.dtype == torch.uint8 and idx_records.dim() == 3
+        assert scale_records.dtype == torch.float16 and scale_records.dim() == 3
+        assert tuple(codebook.shape) == (1 << index_bits, dim)
+        experts, blocks = idx_records.shape[:2]
+        out_f = blocks * 128 if role == 0 else hidden_size
+        in_f = hidden_size if role == 0 else blocks * 128
+        packed_idx = torch.zeros(
+            (experts, out_f // 16, in_f // 128, words_per_lane(dim, index_bits), 32),
+            dtype=torch.int32,
+        )
+        packed_scale = torch.zeros(
+            (experts, out_f // 16, in_f // 128, 16), dtype=torch.float16
+        )
+        for expert in range(experts):
+            words = fingerprint(idx_records[expert].numpy())
+            packed_idx[expert].view(-1)[:3] = torch.tensor(words, dtype=torch.int32)
+            packed_scale[expert].view(-1)[:16] = scale_records[expert].reshape(-1)[:16]
+        self._track(packed_idx, "packed")
+        self._track(packed_scale, "packed")
+        self.packs.append(
+            dict(
+                role=role,
+                hidden_size=hidden_size,
+                dim=dim,
+                index_bits=index_bits,
+                group_size=group_size,
+                idx=tuple(idx_records.shape),
+                scale=tuple(scale_records.shape),
+                codebook=codebook.data_ptr(),
+                record_bytes=idx_records.nbytes + scale_records.nbytes,
+                packed_bytes=packed_idx.nbytes + packed_scale.nbytes,
+            )
+        )
+        self._event(f"vq_pack {len(self.packs) - 1}")
+        return packed_idx, packed_scale
+
+    def moe_workspace_size_vq(self, rows, hidden, intermediate, topk, experts):
+        self.workspace_calls.append((rows, hidden, intermediate, topk, experts))
+        return 700 + rows
+
+    def _operator(self, name):
+        def run(
+            x,
+            topk_ids,
+            topk_weights,
+            packed_ptrs,
+            packed_meta,
+            expert_map,
+            intermediate_size,
+            out,
+            workspace,
+            situ_beta=4.0,
+            situ_linear_beta=25.0,
+            swiglu_limit=0.0,
+            rate_id_gu=-1,
+            rate_id_dn=-1,
+        ):
+            assert x.is_contiguous() and out.is_contiguous()
+            assert topk_ids.is_contiguous() and topk_weights.is_contiguous()
+            assert out.shape == x.shape and topk_ids.shape == topk_weights.shape
+            self.calls.append(
+                dict(
+                    name=name,
+                    rows=x.shape[0],
+                    x=x.data_ptr(),
+                    ids=topk_ids.data_ptr(),
+                    weights=topk_weights.data_ptr(),
+                    pointers=packed_ptrs,
+                    metadata=packed_meta,
+                    expert_map=expert_map,
+                    intermediate=intermediate_size,
+                    out=out.data_ptr(),
+                    workspace=workspace,
+                    betas=(situ_beta, situ_linear_beta),
+                    swiglu_limit=swiglu_limit,
+                    rates=(rate_id_gu, rate_id_dn),
+                )
+            )
+            out.fill_(self.fill)
+
+        return run
+
+    @property
+    def moe_out_vq(self):
+        return self._operator("decode")
+
+    @property
+    def moe_out_prefill_vq(self):
+        return self._operator("prefill")
