+    ids = torch.tensor([[3, 7, -1, 5, 0, 9], [7, 1, 2, 4, 6, 8],
+                        [10, 11, 12, 13, 14, 15], [3, 3, 7, 16, -1, 2]], dtype=torch.int32)
+    tw = torch.rand(4, 6, generator=g)
+    dense = [
