+
+def bank_flip_enabled() -> bool:
+    """VLLM_K31_PIPESPEC_BANK_FLIP: Chunk B commits by a slot permutation."""
+    return bool(getattr(envs, "VLLM_K31_PIPESPEC_BANK_FLIP", False))
+
+
+class KDAPipeSpecSlotFlip:
+    """Copy-free KDA state isolation for PipeSpec Chunk B
+    (``VLLM_K31_PIPESPEC_BANK_FLIP=1``).
+
+    ``KDAPipeSpecStateManager`` isolates Chunk B by copying: before B, the
+    convolution line and Chunk A's full-accept recurrent state (one FP32
+    ``[heads, 128, 128]`` block) of every KDA layer go to Bank 1, and after B a
+    predicated ``torch.where`` copies both back. That is about 12 eager device
+    ops and 13 recurrent-state transfers per KDA layer per Chunk B.
+
+    Here no recurrent state is ever copied. Each request keeps a permutation
+    ``perm`` of its ``spec_state_slots`` state slot columns: logical slot ``j``
+    is physical block-table column ``perm[j]``, and every KDA metadata builder
+    reads the permuted ("logical") block table. The KDA verify kernels (the
+    Triton pair and ``_k31_glue_C.fused_kda_spec_verify`` alike) read the
+    convolution history at columns ``a - 1 .. a + 1`` of the line of slot 0 and
+    the recurrent state of slot ``a - 1`` (``a = num_accepted_tokens``), then
+    write the line of slot 0 and one state per row into slots ``0 .. rows - 1``.
+    A column past the rows of a step is therefore read only, so:
+
+    * Chunk B (``c = chunk_k``, ``c + 1`` rows) runs on the state indices
+      ``[L[c + 1] .. L[2c + 1], L[c], 0 ...]`` (``L`` the logical row) with
+      ``num_accepted_tokens = c + 2``: its recurrent state starts from
+      ``L[c]``, Chunk A's own full-accept state, in place, and its rows write
+      ``L[c + 1 .. 2c + 1]``. Its convolution line is the line of ``L[c + 1]``,
+      read at columns ``c + 1 .. c + 3``: :meth:`prepare_chunk_b` copies the
+      three history columns ``c .. c + 2`` of the line of ``L[0]`` there (three
+      BF16 columns a layer instead of the line and a recurrent state).
+    * A valid B (``m_b = num_sampled_b > 0``) commits by swapping the logical
+      ranges ``0 .. c`` and ``c + 1 .. 2c + 1`` in ``perm`` and setting
+      ``num_accepted_tokens = m_b``: the next step finds B's line (already in
+      the standard layout) at slot 0 and B's row ``m_b - 1`` state at slot
+      ``m_b - 1``, which are the bits the copies would have produced.
+    * A dropped B (``num_sampled_b == 0``) changes nothing: B never wrote a
+      slot or a line of Bank 0.
+
+    Requires ``2 * (chunk_k + 1) <= spec_state_slots`` as the copies do.
+    """
+
+    # Chunk B's num_accepted_tokens is chunk_k + this.
+    ACCEPTED_OFFSET = 2
+    # Columns of convolution history a verify step reads (kernel width - 1).
+    HISTORY = 3
+
+    @staticmethod
+    def identity(max_num_reqs: int, slots: int, device: torch.device) -> torch.Tensor:
+        """``[max_num_reqs, slots]`` int64 identity permutations."""
+        return (
+            torch.arange(slots, dtype=torch.int64, device=device)
+            .unsqueeze(0)
+            .repeat(max_num_reqs, 1)
+        )
+
+    @staticmethod
+    def logical_block_table(
+        block_table: torch.Tensor, perm: torch.Tensor
+    ) -> torch.Tensor:
+        """``block_table[:, perm]`` row by row: ``[n, slots]`` block ids in
+        logical slot order (``perm`` ``[n, slots]`` int64)."""
+        slots = perm.shape[1]
+        if block_table.shape[1] < slots:
+            raise ValueError(
+                f"PipeSpec slot permutation covers {slots} state slots, the "
+                f"block table has {block_table.shape[1]} columns."
+            )
+        return torch.gather(block_table[:, :slots], 1, perm)
+
+    @staticmethod
+    def build_chunk_b_state_indices(
+        logical_block_table: torch.Tensor,
+        chunk_k: int,
+        spec_state_slots: int,
+    ) -> torch.Tensor:
+        """Chunk B's ``[num_reqs, spec_state_slots]`` state indices: its rows
+        write logical slots ``chunk_k + 1 .. 2 * chunk_k + 1`` and column
+        ``chunk_k + 1`` holds logical slot ``chunk_k`` (the start state)."""
+        needed = 2 * (chunk_k + 1)
+        if logical_block_table.shape[1] < needed or spec_state_slots < needed:
+            raise ValueError(
+                f"PipeSpec Chunk B (chunk_k={chunk_k}) needs {needed} state slots, "
+                f"got block_table={logical_block_table.shape[1]}, "
+                f"spec_state_slots={spec_state_slots}."
+            )
+        out = torch.zeros(
+            (logical_block_table.shape[0], spec_state_slots),
+            dtype=logical_block_table.dtype,
+            device=logical_block_table.device,
+        )
+        out[:, : chunk_k + 1] = logical_block_table[:, chunk_k + 1 : needed]
+        out[:, chunk_k + 1] = logical_block_table[:, chunk_k]
+        return out
+
+    @staticmethod
+    def prepare_chunk_b(
+        conv_states: list[torch.Tensor],
+        logical_row: torch.Tensor,
+        chunk_k: int,
+        *,
+        token_dim: int,
+    ) -> None:
+        """Give Chunk B its convolution history: columns ``chunk_k ..
+        chunk_k + 2`` of the line of logical slot 0, one column later in the
+        line of logical slot ``chunk_k + 1``. ``token_dim`` is the column
+        dimension of the ``[blocks, ., .]`` convolution states (2 when a line is
+        ``(dim, columns)``, 1 when it is ``(columns, dim)``). No host sync."""
+        if not conv_states:
+            return
+        hist = KDAPipeSpecSlotFlip.HISTORY
+        src_blk = logical_row[0:1].to(torch.int64)
+        dst_blk = logical_row[chunk_k + 1 : chunk_k + 2].to(torch.int64)
+        for conv_state in conv_states:
+            if conv_state.shape[token_dim] < chunk_k + 1 + hist:
+                raise ValueError(
+                    f"PipeSpec Chunk B (chunk_k={chunk_k}) reads convolution "
+                    f"columns up to {chunk_k + hist}, the line has "
+                    f"{conv_state.shape[token_dim]}."
+                )
+            src = conv_state.narrow(token_dim, chunk_k, hist).index_select(0, src_blk)
+            conv_state.narrow(token_dim, chunk_k + 1, hist).index_copy_(
+                0, dst_blk, src
+            )
+
+    @staticmethod
+    def commit_or_rollback_chunk_b(
+        perm: torch.Tensor,
+        chunk_k: int,
+        num_sampled_b: torch.Tensor,
+        num_accepted_tokens_gpu: torch.Tensor,
+        req_idx: torch.Tensor,
+        *,
+        update_accepted: bool = True,
+    ) -> None:
+        """Predicated device-only commit of Chunk B (no host sync, no per-layer
+        work): a valid B swaps the request's logical slot ranges and sets its
+        accepted count, a dropped B (``num_sampled_b[0] == 0``) or a masked
+        request (``req_idx[0] < 0``) leaves both untouched.
+
+        ``perm`` is the ``[max_num_reqs, slots]`` permutation table, updated in
+        place at row ``req_idx[0]``.
+        """
+        slots = perm.shape[1]
+        needed = 2 * (chunk_k + 1)
+        if slots < needed:
+            raise ValueError(
+                f"PipeSpec Chunk B (chunk_k={chunk_k}) needs {needed} state "
+                f"slots, the permutation has {slots}."
+            )
+        idx0_1d = req_idx[0:1].to(torch.int64)
+        valid_req = idx0_1d >= 0
+        valid_b_1d = (num_sampled_b[0:1] > 0) & valid_req
+        safe_idx = idx0_1d.clamp(min=0, max=perm.shape[0] - 1)
+
+        swap = torch.arange(slots, dtype=torch.int64, device=perm.device)
+        swap[: chunk_k + 1] += chunk_k + 1
+        swap[chunk_k + 1 : needed] -= chunk_k + 1
+        cur_perm = perm.index_select(0, safe_idx)
+        new_perm = cur_perm.index_select(1, swap)
+        perm.index_copy_(
+            0, safe_idx, torch.where(valid_b_1d.view(1, 1), new_perm, cur_perm)
+        )
+
+        if update_accepted:
+            m_b_1d = num_sampled_b[0:1].clamp(min=1, max=chunk_k + 1).to(torch.int64)
+            acc_idx = idx0_1d.clamp(min=0, max=num_accepted_tokens_gpu.shape[0] - 1)
+            cur = num_accepted_tokens_gpu.index_select(0, acc_idx)
+            num_accepted_tokens_gpu.index_copy_(
+                0, acc_idx, torch.where(valid_b_1d, m_b_1d.to(cur.dtype), cur)
+            )
+
+
+def shift_draft_logits_for_chunk_b(
+    draft_logits: Any,
+    req_idx: int,
+    chunk_k: int,
+) -> None:
+    """Move Chunk B's pre-temperature draft logits from cols k+1..2k to 0..k-1."""
+    if draft_logits is None:
+        return
+    values = getattr(draft_logits, "values", draft_logits)
+    row_mapping = getattr(draft_logits, "row_mapping", None)
+    if row_mapping is not None:
+        row = int(row_mapping[req_idx].item())
+        if row < 0:
+            return
+    else:
+        row = req_idx
+    if values.shape[1] >= 2 * chunk_k + 1:
+        values[row, :chunk_k].copy_(values[row, chunk_k + 1 : 2 * chunk_k + 1])
+
+
+def set_onehot_restored_draft_logits(
+    draft_logits: Any,
+    req_idx: int,
+    drafts: torch.Tensor,
+) -> None:
+    """Set one-hot draft logits for restored drafts on aborted A-without-B."""
+    if draft_logits is None:
+        return
+    values = getattr(draft_logits, "values", draft_logits)
+    row_mapping = getattr(draft_logits, "row_mapping", None)
+    if row_mapping is not None:
+        row = int(row_mapping[req_idx].item())
+        if row < 0:
+            return
+    else:
+        row = req_idx
+    k = drafts.shape[0]
+    dst = values[row, :k]
+    dst.fill_(-1e4)
+    dst.scatter_(1, drafts.clamp(min=0, max=dst.shape[1] - 1).view(k, 1), 0.0)
