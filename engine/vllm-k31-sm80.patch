+  const float slo = __half2float(__low2half(sh2)), shi = __half2float(__high2half(sh2));
+  acc[0] = fmaf(slo, ga[0], acc[0]); acc[1] = fmaf(slo, ga[1], acc[1]);
+  acc[2] = fmaf(shi, ga[2], acc[2]); acc[3] = fmaf(shi, ga[3], acc[3]);
+}
