+def _align(kind, table, idx, src, dst, bias, needs=None):
+    sic.check_align_copies(kind, [table], 415, t(idx), torch.tensor(src),
+                           torch.tensor(dst), torch.tensor(bias),
+                           torch.tensor(needs or [True] * len(idx)))
