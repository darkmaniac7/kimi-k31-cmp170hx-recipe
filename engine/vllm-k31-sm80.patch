+__global__ void f32_to_bf16_vec4_kernel(const float4* __restrict__ src, uint2* __restrict__ dst, int64_t n_v4) {
+  const int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
