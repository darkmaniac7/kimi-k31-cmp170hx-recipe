@@ -0,0 +1,260 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Build the Kimi K3.1 text model for one (pipeline stage, tensor-parallel
+rank) on the CPU from a k31q directory and run the k31q loader on it, without
+engine post-init or process groups (the pattern of
+tests/models/deepseek_v41/sm80/construct.py)."""
+
+import ctypes
+from contextlib import contextmanager
+
+import numpy as np
+import torch
+
+try:  # A no-GPU test container resolves the CPU platform, which loads neither.
+    import vllm._C_stable_libtorch  # noqa: F401
+    import vllm._moe_C_stable_libtorch  # noqa: F401
+except ImportError:
+    pass
+
+from tests.models.test_native_checkpoint_config_meta import (
+    _parallel_groups,
+    _runtime_defaults,
+)
+from vllm.config import (
+    CompilationConfig,
+    LoadConfig,
+    ModelConfig,
+    ParallelConfig,
+    SchedulerConfig,
+    VllmConfig,
+    set_current_vllm_config,
+)
+from vllm.transformers_utils.config import get_config, get_hf_text_config
+from vllm.utils.torch_utils import set_default_torch_dtype
+
+MAX_BATCHED_TOKENS = 256
+
+
+class _NoStream:
+    def __init__(self, *args, **kwargs):
+        pass
+
+
+def use_vq_backend(monkeypatch, native=None) -> None:
+    """The VQ routed-expert backend of the models built next. None: the
+    torch reference path (the native library needs a GPU build; without this
+    a VQ layer refuses to construct). ``native``: a stand-in for the native
+    ops module (tests/models/kimi_k3/sm80/fake_vq.py), installed with its
+    device accounting."""
+    if native is None:
+        monkeypatch.setenv("VLLM_K31Q_VQ_BACKEND", "reference")
+    else:
+        native.install(monkeypatch)
+
+
+def set_groups(
+    monkeypatch,
+    tp_size,
+    tp_rank,
+    pp_size=1,
+    pp_rank=0,
+    partition=None,
+    native=None,
+):
+    """Rank metadata of one (TP rank, PP stage); no process group is made.
+    Also picks the VQ backend (:func:`use_vq_backend`)."""
+    from vllm.model_executor.models import utils
+
+    use_vq_backend(monkeypatch, native)
+    _parallel_groups(monkeypatch, tp_size, tp_rank, pp_size, pp_rank)
+    if partition is None:
+        monkeypatch.delenv("VLLM_PP_LAYER_PARTITION", raising=False)
+    else:
+        monkeypatch.setenv("VLLM_PP_LAYER_PARTITION", ",".join(map(str, partition)))
+    # The model and its layers create side streams and events; none runs here.
+    monkeypatch.setattr(torch.cuda, "Stream", _NoStream)
+    monkeypatch.setattr(torch.cuda, "Event", _NoStream)
+    # Keyed by id(model): a model freed by an earlier case may share its id.
+    monkeypatch.setattr(utils, "_model_to_pp_missing_layer_names", {})
+
+
+def vllm_config(directory, tp_size=1, pp_size=1, multimodal=None) -> VllmConfig:
+    """``multimodal``: the MultiModalConfig of a wrapper build (see
+    :func:`multimodal_config`); None for the text model built on its own."""
+    from vllm.model_executor.layers.quantization import QUANTIZATION_METHODS
+    from vllm.sm80 import plugin
+    from vllm.sm80.kernels.k31q.quant import K31QConfig
+
+    if "k31q" not in QUANTIZATION_METHODS:
+        plugin._register_k31q()
+    directory = str(directory)
+    hf_config = get_config(directory, trust_remote_code=False)
+    model_config = _runtime_defaults(
+        ModelConfig,
+        model=directory,
+        tokenizer=directory,
+        hf_config=hf_config,
+        hf_text_config=get_hf_text_config(hf_config),
+        dtype=torch.bfloat16,
+        max_model_len=2048,
+        original_max_model_len=2048,
+        runner_type="generate",
+        convert_type="none",
+        multimodal_config=None,
+        quantization="k31q",
+        skip_tokenizer_init=True,
+    )
+    # As the engine's post-init: the architecture record is made before the
+    # multimodal config exists (no processor is created here).
+    model_config.model_arch_config = model_config.get_model_arch_config()
+    model_config.multimodal_config = multimodal
+    quant = K31QConfig.from_config(hf_config.quantization_config)
+    quant.maybe_update_config(directory, hf_config=hf_config)
+    parallel = _runtime_defaults(
+        ParallelConfig,
+        tensor_parallel_size=tp_size,
+        pipeline_parallel_size=pp_size,
+        distributed_executor_backend="mp",
+    )
+    scheduler = SchedulerConfig(
+        max_model_len=2048,
+        max_num_batched_tokens=MAX_BATCHED_TOKENS,
+        max_num_seqs=8,
+        is_encoder_decoder=False,
+    )
+    config = _runtime_defaults(
+        VllmConfig,
+        model_config=model_config,
+        parallel_config=parallel,
+        scheduler_config=scheduler,
+        compilation_config=CompilationConfig(
+            mode=0, cudagraph_mode="NONE", custom_ops=["all"]
+        ),
+        load_config=LoadConfig(load_format="k31q"),
+        quant_config=quant,
+    )
+    config.kernel_config.enable_jit_warmup = False
+    config.attention_config.sparse_mla_prefill_workspace_factor = 5
+    return config
+
+
+def build_model(config: VllmConfig) -> torch.nn.Module:
+    """The text model, named as inside the K3.1 wrapper."""
+    from vllm.models.kimi_k3.nvidia.model import KimiLinearForCausalLM
+
+    with set_current_vllm_config(config), set_default_torch_dtype(torch.bfloat16):
+        return KimiLinearForCausalLM(vllm_config=config, prefix="language_model")
+
+
+def multimodal_config(text_only: bool):
+    """Launch options of the wrapper: ``--language-model-only`` (every
+    modality limit 0, the tower a placeholder on every stage) or the default
+    (image inputs allowed, the tower built on the first pipeline stage)."""
+    from vllm.config.multimodal import MultiModalConfig
+
+    # Device-side input normalization reads the image processor's config,
+    # which is no part of a k31q directory's weights: left out here.
+    return MultiModalConfig(language_model_only=text_only, mm_device_do_normalize=False)
+
+
+def build_wrapper(monkeypatch, config: VllmConfig) -> torch.nn.Module:
+    """The model class config.json names, resolved through the registry as
+    the engine resolves it: the K3.1 wrapper with the vision tower, the
+    projector and the text model under ``language_model``."""
+    from vllm.model_executor.model_loader.utils import get_model_architecture
+    from vllm.platforms import current_platform
+
+    def with_hf_config(self, hf_config, architectures=None):
+        # VllmConfig.with_hf_config without its dataclasses.replace, which
+        # would run the engine post-init this harness leaves out.
+        import copy
+
+        if architectures is not None:
+            hf_config = copy.deepcopy(hf_config)
+            hf_config.architectures = architectures
+        model_config = copy.copy(self.model_config)
+        model_config.hf_config = hf_config
+        model_config.multimodal_config = None
+        model_config.model_arch_config = model_config.get_model_arch_config()
+        model_config.multimodal_config = self.model_config.multimodal_config
+        model_config.is_submodel_config = True
+        inner = copy.copy(self)
+        inner.model_config = model_config
+        return inner
+
+    monkeypatch.setattr(VllmConfig, "with_hf_config", with_hf_config)
+    # The wrapper moves a tower it really builds to the platform's device;
+    # the static platform of these tests names the meta device.
+    monkeypatch.setattr(
+        type(current_platform),
+        "current_device",
+        staticmethod(lambda: torch.device("cpu")),
+        raising=False,
+    )
+    model_class, _ = get_model_architecture(config.model_config)
+    with set_current_vllm_config(config), set_default_torch_dtype(torch.bfloat16):
+        return model_class(vllm_config=config, prefix="")
+
+
+def load(monkeypatch, model, config):
+    """Run the k31q loader on a CPU model; return its report."""
+    from vllm.sm80.kernels.exl3 import ops
+    from vllm.sm80.kernels.k31q import loader
+
+    monkeypatch.setattr(ops, "ensure_extension", lambda: None)
+    monkeypatch.setattr(loader, "require_cuda_parameters", lambda model: None)
+    with set_current_vllm_config(config):
+        return loader.load_k31q_weights(model, config.model_config)
+
+
+def build_and_load(
+    monkeypatch,
+    directory,
+    tp_size=1,
+    tp_rank=0,
+    pp_size=1,
+    pp_rank=0,
+    partition=None,
+    native=None,
+):
+    """(model, config, report, checkpoint tensor names) of one rank."""
+    set_groups(monkeypatch, tp_size, tp_rank, pp_size, pp_rank, partition, native)
+    config = vllm_config(directory, tp_size, pp_size)
+    names = set(config.quant_config.manifest.tensors)
+    model = build_model(config)
+    report = load(monkeypatch, model, config)
+    return model, config, report, names
+
+
+def memory_at(address: int, dtype, shape) -> np.ndarray:
+    """The host bytes at an address a pointer table holds, as an array."""
+    count = int(np.prod(shape)) * np.dtype(dtype).itemsize
+    return np.frombuffer(ctypes.string_at(address, count), dtype=dtype).reshape(shape)
+
+
+@contextmanager
+def no_host_reads(monkeypatch):
+    """Inside, reading a tensor's value on the host raises: what a device
+    tensor could only answer by waiting for the stream (a host sync, which a
+    CUDA graph cannot hold). Shapes, dtypes and addresses stay readable."""
+
+    def refuse(name):
+        def read(self, *args, **kwargs):
+            raise AssertionError(f"host read of a tensor value: Tensor.{name}")
+
+        return read
+
+    with monkeypatch.context() as patch:
+        for name in (
+            "item",
+            "tolist",
+            "numpy",
+            "cpu",
+            "__bool__",
+            "__int__",
+            "__float__",
+            "__index__",
+        ):
+            patch.setattr(torch.Tensor, name, refuse(name))
+        yield
