+static std::vector<std::string> split_csv(const std::string & s) {
+    std::vector<std::string> out;
+    std::string cur;
+    for (char c : s) {
+        if (c == ',') {
+            if (!cur.empty()) out.push_back(cur);
+            cur.clear();
+        } else if (!std::isspace(static_cast<unsigned char>(c))) {
+            cur.push_back(c);
+        }
+    }
+    if (!cur.empty()) out.push_back(cur);
+    return out;
+}
+
+static std::set<int> parse_layers_spec(const std::string & spec, int n_layer) {
+    std::set<int> out;
+    if (spec.empty() || spec == "all") {
+        for (int i = 0; i < n_layer; ++i) out.insert(i);
+        return out;
+    }
+    for (const auto & tok : split_csv(spec)) {
+        size_t dash = tok.find('-');
+        if (dash != std::string::npos) {
+            int lo = std::stoi(tok.substr(0, dash));
+            int hi = std::stoi(tok.substr(dash + 1));
+            for (int i = lo; i <= hi; ++i) {
+                if (i >= 0 && i < n_layer) out.insert(i);
+            }
+        } else {
+            int idx = std::stoi(tok);
+            if (idx >= 0 && idx < n_layer) out.insert(idx);
+        }
+    }
+    return out;
+}
