+# -- 3. Fused MLA q_a + kv_a + g_proj ------------------------------------------
+
+
+class _StubModule(torch.nn.Module):
+    def __init__(self, fn):
+        super().__init__()
+        self._fn = fn
+
+    def forward(self, *args, **kwargs):
+        return self._fn(*args, **kwargs)
+
+
+def _stub_mla_tail(wrapper):
+    """Stub the attention backend / indexer / o_proj inside a
+    MultiHeadLatentAttentionWrapper so forward() runs purely on CPU while
+    exercising the real fused_qkv_a_proj, g_proj, RMSNorm, and gating paths."""
+    wrapper.indexer = None
+    wrapper.is_sparse = False
+    wrapper.rotary_emb = None
+    wrapper.q_b_proj = _StubModule(
+        lambda x: (
+            x.new_zeros((x.shape[0], wrapper.num_heads * wrapper.qk_head_dim)),
+            None,
+        )
+    )
+    captured = {}
+
+    def fake_mla_attn(q, kv_c_normed, k_pe, output_shape, q_dcp_replicated=None):
+        captured["kv_c_normed"] = kv_c_normed.clone()
+        captured["k_pe"] = k_pe.clone()
+        rows, width = output_shape
+        base = kv_c_normed.float().mean(dim=-1, keepdim=True) + k_pe.squeeze(1).float().mean(
+            dim=-1, keepdim=True
+        )
+        return base.expand(rows, width).to(kv_c_normed.dtype).contiguous()
+
+    wrapper.mla_attn = _StubModule(fake_mla_attn)
+    wrapper.o_proj = _StubModule(lambda x: (x, None))
+    return captured
