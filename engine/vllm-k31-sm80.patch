+@pytest.mark.parametrize(
+    ("name", "ensure", "namespace"),
+    [
+        ("vq_ops", "ensure_vq_extension", "_k31_vq_C"),
+        ("dense_k31_ops", "ensure_dense_k31_extension", "_k31_dense_C"),
+    ],
+)
+def test_ops_modules_ask_for_release_2(monkeypatch, name, ensure, namespace):
+    """Both op modules load their library through native.load with the
+    interface version of their sources, and build_info() reports what the
+    loaded library says."""
+    module = importlib.import_module(f"vllm.sm80.kernels.k31q.{name}")
+    calls = []
+    library = types.SimpleNamespace(
+        build_info=lambda: {"api_version": module._API_VERSION}
+    )
+    monkeypatch.setattr(module, "_LOADED", False)
+    monkeypatch.setattr(module, "_FAKES_REGISTERED", True)
+    monkeypatch.setattr(module, "_MODULE", None)
+    monkeypatch.setattr(
+        module.native, "load", lambda *args: calls.append(args) or library
+    )
+    getattr(module, ensure)()
+    assert calls == [
+        (
+            namespace,
+            module._ABI_VERSION,
+            module._OPERATORS,
+            module.BUILD_COMMAND,
+            module._API_VERSION,
+        )
+    ]
+    assert module.build_info() == {"api_version": module._API_VERSION}
+    assert len(calls) == 1
