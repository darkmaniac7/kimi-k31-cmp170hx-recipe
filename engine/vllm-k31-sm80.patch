+def test_rows_above_the_launch_rows_run_as_several_launches(
+    monkeypatch, meta_platform, checkpoint, manager
+):
+    """VLLM_K31Q_DENSE_PREFILL=k31: a call of more rows than a launch takes
+    runs as consecutive launches, each row from its own input; the workspace
+    is the one buffer, sized for the largest registered launch, taken once
+    from the workspace manager."""
+    from vllm.sm80.kernels.k31q import dense
+
+    monkeypatch.setenv("VLLM_K31Q_DENSE_PREFILL", "k31")
+
+    ops = fake_dense.FakeDenseOps().install(monkeypatch)
+    _old_path(monkeypatch)
+    model, _ = _build(monkeypatch, checkpoint, ops)
+    kda = model.model.layers[1].self_attn.in_proj_qkvgfab
+    x = _inputs(kda, 2 * MAX_ROWS + 88)
+    with construct.no_host_reads(monkeypatch):
+        new, old = _same_as_old_path(kda, x)
+    assert torch.equal(new, old)
+    assert [c["rows"] for c in ops.calls] == [MAX_ROWS, MAX_ROWS, 88]
+    assert kda.quant_method.launcher.launches(x.shape[0]) == 3
+    needed = dense.workspace_elements(torch.device("cpu"))
+    largest = max(
+        g.workspace
+        for m in _dense_modules(model).values()
+        for g in m.quant_method.launcher.groups
+    )
+    assert needed == largest
+    assert {c["workspace_numel"] for c in ops.calls} == {needed}
+    assert len({c["workspace"] for c in ops.calls}) == 1
+    resources = manager._persistent_resources[0]
+    assert list(resources) == [(dense.WORKSPACE_KEY, "cpu", needed)]
+    # Locked (as after the profile run): the forward still finds its buffer.
+    manager.lock()
+    ops.calls.clear()
+    with construct.no_host_reads(monkeypatch):
+        _forward(
+            model.model.layers[MLA_LAYER].self_attn.o_proj,
+            _inputs(model.model.layers[MLA_LAYER].self_attn.o_proj, 4),
+        )
+    assert len(ops.calls) == 1 and ops.calls[0]["workspace_numel"] == needed
+
