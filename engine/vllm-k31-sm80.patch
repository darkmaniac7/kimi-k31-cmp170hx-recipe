+class _CudaLikeIdxMapping:
+    """Stand-in tensor whose is_cuda=True and .item() is forbidden (catches H1)."""
+
+    def __init__(self, vals: list[int]):
+        self._t = torch.tensor(vals, dtype=torch.int32)
+        self.is_cuda = True
+
+    @property
+    def shape(self):
+        return self._t.shape
+
+    def __getitem__(self, key):
+        return self._t[key]
+
+    def item(self):
+        raise AssertionError("Must never call .item() on CUDA idx_mapping")
+
