+    from vllm.sm80.kernels.k31q.quant import K31FusedLinearMethod
+    from vllm.third_party.flash_linear_attention.ops.kda import FusedRMSNormGated
+
+    device = torch.device("cuda:0")
+    manifest = K31QManifest(mini)
+    embed, l0_ao, l0_out = gpu.tensors(
+        mini / "ref_acts.safetensors", "embed", "L0.attn_out.q", "L0.out.q", device=device
+    )
+    layer_path = mini / "layer-001.safetensors"
+    H, D = 96, 128
+    C = 3 * H * D
+
+    from vllm.sm80.kernels.k31q.moe import K31VqLauncher
+
+    vq_ops.ensure_vq_extension()
+    experts, _ = gpu.load_experts(mini, layer=1, tp_size=1, tp_rank=0, native=vq_ops, device=device)
+    vq_launcher = K31VqLauncher(experts, 16, 16, 4.0, 25.0)
+    vq_ws = torch.empty(vq_launcher.workspace_elements, dtype=torch.float32, device=device)
+    expert_map = torch.arange(896, dtype=torch.int32, device=device)
+
+    with ExitStack() as stack:
+        files = {layer_path: stack.enter_context(safe_open(str(layer_path), framework="pt", device="cpu"))}
+        ledger = Exl3LoadLedger(manifest)
+        pfx = f"{LAYER_PREFIX}1."
+        qkvg_l, _ = _load_exl3_launcher(
