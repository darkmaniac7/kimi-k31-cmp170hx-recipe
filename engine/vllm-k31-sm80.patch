+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The fork plugin's Kimi K3 / K3.1 registrations and what they build, on
+the CPU with the static SM 8.0 platform of the meta-construction tests:
+
+* the registry resolves the three architectures to the fork classes, which
+  vLLM describes as the upstream ones;
+* the MLA wrapper override and its coexistence with the GLM registration;
+* the KV cache dtype default (upstream's hook turns "auto" into
+  "fp8_ds_mla", which the Triton sparse MLA backend does not read);
+* a small K3.1 text model: its DSA layer is adopted with upstream's
+  parameters, per tensor-parallel rank and pipeline stage, and a layer an
+  upstream backend serves is left alone.
+
+Run in a fresh process with CUDA_VISIBLE_DEVICES='' (no GPU is opened).
+"""
+
+import importlib
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from tests.models.kimi_k3.sm80 import sm80_dsa_cases as cases
+from tests.models.test_native_checkpoint_config_meta import _parallel_groups
+from vllm.model_executor.models.registry import ModelRegistry, _ModelInfo
+from vllm.sm80 import plugin
+
+ARCHITECTURES = (
+    "KimiLinearForCausalLM",
+    "KimiK3ForConditionalGeneration",
+    "KimiK31ForConditionalGeneration",
+)
+
+
+def _load(qualified: str) -> type:
+    module_name, _, class_name = qualified.partition(":")
+    return getattr(importlib.import_module(module_name), class_name)
+
+
+@pytest.fixture(autouse=True)
+def _registered():
+    plugin.register_models()
+    plugin.register_kv_cache_dtype_defaults()
+
+
+# -- registry -----------------------------------------------------------------
+
+
