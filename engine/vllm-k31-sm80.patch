index 0000000000..3873e92be9
--- /dev/null
+++ b/vllm/sm80/worker/stage_timing.py
@@ -0,0 +1,360 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Per-stage decode step timing that never waits for the GPU.
+
+``VLLM_K31_STAGE_TIMING=N`` (default 0 = off) makes every worker log, every N
+timed steps, where one decode step spends its time on that worker: the GPU
+time between named points of the step, the host time between the same points,
+and how often the host was late, meaning the GPU had already finished what a
+launch waits for while the host was still preparing that launch.
+
+Why it exists. Under pipeline parallelism with async scheduling the engine
+submits a step before the previous one returned, so a worker prepares a step
+while its GPU still waits for that step's inputs. Host time is then invisible
+in the step period unless a host wait splits the step (the PipeSpec Chunk A
+decision does). A wall-clock profile cannot tell the two cases apart; this
+probe can, because it reads both clocks at the same points.
+
+How it reads the GPU clock. A mark records a CUDA timing event on the current
+stream, behind everything the step has enqueued so far, and takes the host
+time. Nothing waits: a finished step is read only once all of its events have
+completed (``Event.query``), normally while the next step is prepared.
+``elapsed_time`` between two events of one device is the GPU time between
+them.
+
+Marks of a step, in order (a worker records the ones that apply to it):
+
+``x0``  host only, ``Worker.execute_model`` entered
+``bc``  the previous step's sampled tokens and drafts are applied (stages
+        before the last: the stream waited for the sampled-token broadcast;
+        last stage: nothing to wait for, the mark follows the previous step)
+``dr``  only with VLLM_PP_SPLIT_DRAFT_EVENT, stages before the last: the
+        previous step's draft tokens arrived (``bc`` then covers the sampled
+        tokens and counts alone, and ``bc>dr`` is input preparation that
+        overlaps the last stage's drafter plus the wait for the drafts)
+``rx``  the hop from the previous stage arrived and was copied in (stages
+        after the first)
+``f0``  everything the forward needs is enqueued; the forward starts
+``f1``  the forward (graph replay) ended
+``tx``  the hop to the next stage is packed and handed to the transport
+        (stages before the last)
+``sm``  last stage: the target tokens are sampled and their broadcast started
+``d0``  last stage: the drafter may start (request state updated)
+``d1``  last stage: the drafter ended
+``e``   last stage: the drafts are stored and their broadcast started
+
+Reading a line::
+
+    K31_STAGE_TIMING pp=0 tp=0 | N rows=8 n=64 period=41.20/43.01
+      gpu[bc>f0=0.210/0.300 f0>f1=9.800/9.900 f1>tx=0.050/0.060]
+      host[x0>bc=0.150 bc>f0=0.700 f0>f1=0.120 f1>tx=0.080] late[f1=0/64]
+
+(one line in the log). ``N`` is the step kind (``N`` normal, ``A`` or ``B``
+PipeSpec chunk), ``rows`` the scheduled token rows, ``n`` the steps averaged.
+``period`` is the GPU time from a step's ``f0`` to the next timed step's
+``f0`` on this worker, mean/max in ms, counted for the earlier step's kind and
+rows; it is the step period when consecutive timed steps are of the same
+request. ``gpu[a>b=mean/max]`` is the GPU time between
+two marks, ``host[a>b=mean]`` the host time. ``late[f1=k/n]``: in k of n
+steps the forward's input (``rx``, or on the first stage ``dr`` when recorded
+and else ``bc``) had already arrived when the host finished launching the
+forward, so the GPU sat idle behind the host for part of the segment from
+that mark to ``f0``. ``late[d1=k/n]`` is the same for the drafter against
+``sm``.
+
+What the lines of the four stages give together (take the ``tp=0`` lines):
+
+* a stage's busy time is ``f0`` to ``tx`` (to ``e`` on the last stage) plus
+  its prologue: ``rx>f0``, or on the first stage ``bc>f0`` (``dr>f0`` with
+  VLLM_PP_SPLIT_DRAFT_EVENT);
+* ``bc>rx`` on a later stage is idle time: the earlier stages and the hops;
+* the period minus the four busy times is what the transports cost: three
+  hops and the sampled-token and draft broadcasts;
+* a host time only matters where ``late`` is not zero.
+"""
+
+from __future__ import annotations
+
+import time
+from collections import deque
+from collections.abc import Callable
+from typing import Any
+
+import torch
+
+import vllm.envs as envs
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+SWITCH = "VLLM_K31_STAGE_TIMING"
+PERIOD_MARK = "f0"
+# Finished steps kept while their events are still pending. A stream that
+# stops completing events (a hung peer) must not grow the queue.
+MAX_PENDING = 256
+
+
+def _cuda_event() -> Any:
+    return torch.cuda.Event(enable_timing=True)
+
+
+class _Step:
+    __slots__ = ("kind", "rows", "names", "events", "host", "late")
+
+    def __init__(self, rows: int) -> None:
+        self.kind = "N"
+        self.rows = rows
+        self.names: list[str] = []
+        # None for a host-only mark.
+        self.events: list[Any] = []
+        self.host: list[float] = []
+        self.late: dict[str, bool] = {}
+
+
+class _Stats:
+    __slots__ = ("n", "total", "peak")
+
+    def __init__(self) -> None:
+        self.n = 0
+        self.total = 0.0
+        self.peak = 0.0
+
+    def add(self, value: float) -> None:
+        self.n += 1
+        self.total += value
+        if value > self.peak:
+            self.peak = value
+
+    @property
+    def mean(self) -> float:
+        return self.total / self.n if self.n else 0.0
+
+
+class StageTimer:
+    """Collects the marks of one worker's decode steps (see the module
+    docstring). Only the worker's main thread calls it. Every method is a
+    no-op once a CUDA call failed: timing must never fail a step.
+
+    ``event_factory`` and ``clock`` are injectable for tests: an event needs
+    ``record()``, ``query()`` and ``elapsed_time(other)`` (milliseconds).
+    """
+
+    def __init__(
+        self,
+        interval: int,
+        label: str = "",
+        event_factory: Callable[[], Any] | None = None,
+        clock: Callable[[], float] = time.perf_counter,
+        emit: Callable[[str], None] | None = None,
+    ) -> None:
+        assert interval > 0
+        self.interval = interval
+        self.label = label
+        self._new_event = event_factory or _cuda_event
+        self._clock = clock
+        self._emit = emit or (lambda line: logger.info("%s", line))
+        self._cur: _Step | None = None
+        self._pending: deque[_Step] = deque()
+        self._free: list[Any] = []
+        # The period mark of the last resolved step and that step's key: the
+        # time to the next step's mark is the last step's period.
+        self._prev_anchor: Any = None
+        self._prev_key: tuple[str, int] | None = None
+        # (kind, rows) -> name -> stats, in first-seen order.
+        self._gpu: dict[tuple[str, int], dict[str, _Stats]] = {}
+        self._host: dict[tuple[str, int], dict[str, _Stats]] = {}
+        self._late: dict[tuple[str, int], dict[str, list[int]]] = {}
+        self._period: dict[tuple[str, int], _Stats] = {}
+        self._steps: dict[tuple[str, int], int] = {}
+        self._since_log = 0
+        self.dropped = 0
+        self.failed = False
+
+    # ------------------------------------------------------------------
+    # Recording (hot path)
+    # ------------------------------------------------------------------
+    def begin(self, rows: int) -> None:
+        """Start a step. A step that never reached :meth:`end` is dropped."""
+        if self.failed:
+            return
+        if self._cur is not None:
+            self._release(self._cur)
+            self.dropped += 1
+        self._cur = _Step(rows)
+
+    def set_kind(self, kind: str) -> None:
+        if self._cur is not None:
+            self._cur.kind = kind
+
+    def mark(self, name: str, gpu: bool = True) -> None:
+        """Take the host time and, with ``gpu``, record a timing event on the
+        current stream."""
+        step = self._cur
+        if step is None or self.failed:
+            return
+        event = None
+        if gpu:
+            try:
+                event = self._free.pop() if self._free else self._new_event()
+                event.record()
+            except RuntimeError as error:
+                self._fail(error)
+                return
+        step.names.append(name)
+        step.events.append(event)
+        step.host.append(self._clock())
+
+    def late(self, name: str, *deps: str) -> None:
+        """Note whether the GPU already passed the input mark now that the
+        host reached ``name``: the launch at ``name`` came after its input.
+        The input mark is the first of ``deps`` this step recorded."""
+        step = self._cur
+        if step is None or self.failed:
+            return
+        for dep in deps:
+            for i in range(len(step.names) - 1, -1, -1):
+                if step.names[i] == dep and step.events[i] is not None:
+                    try:
+                        step.late[name] = bool(step.events[i].query())
+                    except RuntimeError as error:
+                        self._fail(error)
+                    return
+
+    def abort(self) -> None:
+        """Forget the current step (it ran no forward)."""
+        if self._cur is not None:
+            self._release(self._cur)
+            self._cur = None
+
+    def end(self) -> None:
+        """Finish the current step and read the steps whose events are done."""
+        step, self._cur = self._cur, None
+        if step is None or self.failed:
+            return
+        self._pending.append(step)
+        while len(self._pending) > MAX_PENDING:
+            self._release(self._pending.popleft())
+            self.dropped += 1
+        self.drain()
+
+    # ------------------------------------------------------------------
+    # Reading (never waits)
+    # ------------------------------------------------------------------
+    def drain(self) -> None:
+        while self._pending and not self.failed:
+            step = self._pending[0]
+            try:
+                if not all(e.query() for e in step.events if e is not None):
+                    return
+                self._resolve(step)
+            except RuntimeError as error:
+                self._fail(error)
+                return
+            self._pending.popleft()
+
+    def _resolve(self, step: _Step) -> None:
+        key = (step.kind, step.rows)
+        gpu = self._gpu.setdefault(key, {})
+        host = self._host.setdefault(key, {})
+        late = self._late.setdefault(key, {})
+        prev_name: str | None = None
+        prev_host = 0.0
+        prev_gpu_name: str | None = None
+        prev_event: Any = None
+        anchor: Any = None
+        for name, event, host_t in zip(step.names, step.events, step.host):
+            if prev_name is not None:
+                host.setdefault(f"{prev_name}>{name}", _Stats()).add(
+                    (host_t - prev_host) * 1e3
+                )
+            prev_name, prev_host = name, host_t
+            if event is None:
+                continue
+            if prev_event is not None:
+                gpu.setdefault(f"{prev_gpu_name}>{name}", _Stats()).add(
+                    prev_event.elapsed_time(event)
+                )
+            prev_gpu_name, prev_event = name, event
+            if name == PERIOD_MARK and anchor is None:
+                anchor = event
+        for name, was_late in step.late.items():
+            counts = late.setdefault(name, [0, 0])
+            counts[0] += int(was_late)
+            counts[1] += 1
+        if anchor is not None:
+            if self._prev_anchor is not None and self._prev_key is not None:
+                self._period.setdefault(self._prev_key, _Stats()).add(
+                    self._prev_anchor.elapsed_time(anchor)
+                )
+                self._free.append(self._prev_anchor)
+            self._prev_anchor, self._prev_key = anchor, key
+        for event in step.events:
+            if event is not None and event is not anchor:
+                self._free.append(event)
+        self._steps[key] = self._steps.get(key, 0) + 1
+        self._since_log += 1
+        if self._since_log >= self.interval:
+            self.flush()
+
+    def flush(self) -> None:
+        """Log one line per (kind, rows) seen since the last flush."""
+        for key, count in self._steps.items():
+            kind, rows = key
+            parts = [f"K31_STAGE_TIMING {self.label} | {kind} rows={rows} n={count}"]
+            period = self._period.get(key)
+            if period is not None and period.n:
+                parts.append(f"period={period.mean:.2f}/{period.peak:.2f}")
+            gpu = " ".join(
+                f"{name}={s.mean:.3f}/{s.peak:.3f}" for name, s in self._gpu[key].items()
+            )
+            host = " ".join(
+                f"{name}={s.mean:.3f}" for name, s in self._host[key].items()
+            )
+            late = " ".join(
+                f"{name}={c[0]}/{c[1]}" for name, c in self._late[key].items()
+            )
+            parts.append(f"gpu[{gpu}] host[{host}] late[{late}]")
+            if self.dropped:
+                parts.append(f"dropped={self.dropped}")
+            self._emit(" ".join(parts))
+        self._gpu.clear()
+        self._host.clear()
+        self._late.clear()
+        self._period.clear()
+        self._steps.clear()
+        self._since_log = 0
+
+    # ------------------------------------------------------------------
+    def _release(self, step: _Step) -> None:
+        # An event that may still be pending is not reused: recording it again
+        # would move a timestamp another reader could still wait for.
+        step.events.clear()
+
+    def _fail(self, error: Exception) -> None:
+        self.failed = True
+        self._cur = None
+        self._pending.clear()
+        logger.warning("%s off after a CUDA error: %s", SWITCH, error)
+
+
+def make_stage_timer(
+    pp_rank: int | None = None, tp_rank: int | None = None
+) -> StageTimer | None:
+    """The worker's timer, or None with the switch off (the default). The
+    ranks default to this worker's ranks in its pipeline and tensor groups."""
+    interval = int(getattr(envs, SWITCH, 0) or 0)
+    if interval <= 0:
+        return None
+    if pp_rank is None or tp_rank is None:
+        from vllm.distributed.parallel_state import get_pp_group, get_tp_group
+
+        pp_rank = get_pp_group().rank_in_group
+        tp_rank = get_tp_group().rank_in_group
+    logger.info(
+        "%s=%d: per-stage step timing on, one line every %d timed steps; "
+        "no step waits for it.",
+        SWITCH,
+        interval,
+        interval,
+    )
+    return StageTimer(interval, label=f"pp={pp_rank} tp={tp_rank}")
diff --git a/vllm/sm80/worker/state_index_check.py b/vllm/sm80/worker/state_index_check.py
new file mode 100644
index 0000000000..51e66ed60e
--- /dev/null
+++ b/vllm/sm80/worker/state_index_check.py
@@ -0,0 +1,299 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Runtime range checks for KDA / Mamba state indices (debug only).
+
+``VLLM_STATE_INDEX_CHECK=1`` checks, on the host and before the kernels
+that use them run:
+
+* every step's GDN/KDA attention metadata (also for steps replayed from CUDA
+  graphs, whose kernels run without Python): the state-pool rows the conv / recurrent kernels
+  will read or write (non-spec rows, spec rows and the accepted-token column
+  they start from) lie in ``[0, pool)``, the initial-state rows cover the
+  prefill sequences, and the ``cu_seqlens`` describe at most the tokens that
+  are there;
+* every block-table gather: each batch row names a request slot;
+* the align-mode state pre-copy (before the forward) and post-copy (after
+  sampling): for every request that will copy, the block-table columns lie in
+  its request-slot row and the block ids they hold lie in ``[0, num_blocks)``;
+  a copy from or into the null block is reported as a warning.
+
+A violation raises ``StateIndexError`` with the step's numbers instead of
+letting a kernel address memory outside the pool. Every check synchronizes
+with the device, so this is for diagnosis, never for serving.
+"""
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+FLAG = "VLLM_STATE_INDEX_CHECK"
+BANNER = (
+    "GLM5 state index check: every KDA/Mamba state index is range-checked on "
+    "the host before use (debug; synchronizes every step); "
+    "VLLM_STATE_INDEX_CHECK=1"
+)
+NULL_BLOCK_ID = 0
+
+
+class StateIndexError(RuntimeError):
+    pass
+
+
+def enabled() -> bool:
+    from vllm import envs
+
+    on = bool(envs.VLLM_STATE_INDEX_CHECK)
+    if on:
+        logger.warning_once(BANNER)
+    return on
+
+
+def _host(t: torch.Tensor | None) -> torch.Tensor | None:
+    return None if t is None else t.detach().to("cpu", torch.int64)
+
+
+def _range(problems: list[str], name: str, v: torch.Tensor | None, hi: int) -> None:
+    if v is None or v.numel() == 0:
+        return
+    lo_v, hi_v = int(v.min()), int(v.max())
+    if lo_v < 0 or hi_v >= hi:
+        bad = ((v < 0) | (v >= hi)).nonzero().tolist()[:8]
+        problems.append(
+            f"{name}: values {lo_v}..{hi_v} outside [0, {hi}) at {bad}"
+        )
+
+
+def _cu(problems: list[str], name: str, cu: torch.Tensor | None, num_tokens: int):
+    if cu is None or cu.numel() == 0:
+        return
+    if int(cu[0]) != 0:
+        problems.append(f"{name}[0] = {int(cu[0])}")
+    if cu.numel() > 1 and bool((cu[1:] < cu[:-1]).any()):
+        problems.append(f"{name} decreases: {cu.tolist()[:40]}")
+    if int(cu[-1]) > num_tokens:
+        problems.append(f"{name}[-1] = {int(cu[-1])} > {num_tokens} tokens")
+
+
+def _state_pools(vllm_config) -> dict[str, int]:
+    """Rows of each mamba-family layer's state pool (conv and recurrent)."""
+    pools: dict[str, int] = {}
+    ctx = vllm_config.compilation_config.static_forward_context
+    for name, layer in ctx.items():
+        kv = getattr(layer, "kv_cache", None)
+        if isinstance(kv, (list, tuple)) and kv and all(
+            isinstance(t, torch.Tensor) for t in kv
+        ) and len(kv) == 2 and kv[0].dim() >= 2:
+            rows = {int(t.shape[0]) for t in kv}
+            pools[name] = min(rows)
+    return pools
+
+
+def check_attn_metadata(attn_metadata: dict, vllm_config) -> None:
+    """Range-check every GDN/KDA metadata object of one step (once per object,
+    against the smallest pool of the layers that share it).
+
+    The pools are read from the layers' current state views on every call:
+    ``bind_kv_cache`` rebinds them when the KV cache is (re)allocated (the
+    start-up profiling pool, then the serving pool), so the bound is always
+    the tensor the kernels of this step will address."""
+    from vllm.v1.attention.backends.gdn_attn import GDNAttentionMetadata
+
+    pools = _state_pools(vllm_config)
+    by_md: dict[int, tuple] = {}
+    for name, md in attn_metadata.items():
+        if isinstance(md, GDNAttentionMetadata) and name not in pools:
+            # Never pass vacuously: a KDA layer whose pool is unknown is a failure.
+            raise StateIndexError(f"no state pool found for KDA layer {name}")
+        if isinstance(md, GDNAttentionMetadata):
+            prev = by_md.get(id(md))
+            pool = pools[name] if prev is None else min(prev[2], pools[name])
+            by_md[id(md)] = (name, md, pool)
+    for name, md, pool in by_md.values():
+        check_kda_metadata(name, md, pool, int(md.num_actual_tokens))
+
+
+def check_kda_metadata(layer: str, md, pool: int, num_tokens: int) -> None:
+    """Range-check the state indices the KDA kernels will use (module doc)."""
+    problems: list[str] = []
+    ns_idx = _host(md.non_spec_state_indices_tensor)
+    ns_cu = _host(md.non_spec_query_start_loc)
+    has_init = (None if md.has_initial_state is None
+                else md.has_initial_state.detach().to("cpu"))
+    if md.num_prefills > 0:
+        _range(problems, "non-spec state index", ns_idx, pool)
+        _cu(problems, "non_spec_query_start_loc", ns_cu, num_tokens)
+        if ns_idx is not None and ns_cu is not None and ns_idx.numel() < ns_cu.numel() - 1:
+            problems.append(
+                f"{ns_idx.numel()} non-spec state rows for {ns_cu.numel() - 1} sequences")
+        if has_init is not None and ns_idx is not None and has_init.numel() != ns_idx.numel():
+            problems.append(
+                f"has_initial_state {has_init.numel()} rows, state indices {ns_idx.numel()}")
+    elif md.num_decodes > 0:
+        _range(problems, "decode state index",
+               None if ns_idx is None else ns_idx[: md.num_decodes], pool)
+    n_spec = int(md.num_spec_decodes or 0)
+    # RecoverSSM (kda/recover.py): one state per request. Only column 0 of the spec
+    # state table is filled and read (the fused verify path leaves the other
+    # columns of its persistent buffer unwritten), and the verify reads
+    # num_accepted = 1; the query still spans up to num_spec + 1 tokens.
+    commit = getattr(md, "recover_commit", None)
+    if n_spec > 0 and md.spec_state_indices_tensor is not None:
+        sp_dev = md.spec_state_indices_tensor[:n_spec]
+        width = int(sp_dev.shape[1]) if sp_dev.dim() == 2 else 1
+        if commit is not None and sp_dev.dim() == 2:
+            sp_dev = sp_dev[:, :1]
+        sp = _host(sp_dev)
+        _range(problems, "spec state index", sp, pool)
+        cols = int(sp.shape[1]) if sp.dim() == 2 else 1
+        acc = _host(md.num_accepted_tokens)
+        if acc is not None:
+            acc = acc[:n_spec]
+            if acc.numel() and (int(acc.min()) < 1 or int(acc.max()) > cols):
+                problems.append(
+                    f"num_accepted_tokens {acc.tolist()} outside [1, {cols}]")
+        sq = _host(md.spec_query_start_loc)
+        if sq is not None:
+            sq = sq[: n_spec + 1]
+            _cu(problems, "spec_query_start_loc", sq, num_tokens)
+            query_limit, query_storage = width, "token columns"
+            if commit is not None:
+                from vllm.sm80.kernels.kda.recover import WS_T
+
+                query_limit, query_storage = WS_T, "recover record capacity"
+            if sq.numel() > 1 and int((sq[1:] - sq[:-1]).max()) > query_limit:
+                problems.append(
+                    f"spec query lengths {(sq[1:] - sq[:-1]).tolist()} > "
+                    f"{query_limit} {query_storage}")
+        if commit is not None:
+            _check_recover_commit(problems, commit, n_spec, pool,
+                                  int(md.num_prefills) + int(md.num_decodes) + n_spec)
+    if problems:
+        detail = (f"{layer}: pool {pool}, prefills {md.num_prefills}, decodes "
+                  f"{md.num_decodes}, spec {n_spec}, tokens {num_tokens}; "
+                  f"non-spec idx {None if ns_idx is None else ns_idx.tolist()[:40]}, "
+                  f"cu {None if ns_cu is None else ns_cu.tolist()[:40]}")
+        logger.error("state index check failed: %s | %s", "; ".join(problems), detail)
+        raise StateIndexError("; ".join(problems) + " | " + detail)
+
+
+def _check_recover_commit(problems: list[str], commit, n_spec: int, pool: int,
+                          num_seqs: int) -> None:
+    """The commit metadata of RecoverSSM (kda/recover.py): the
+    state rows the commit replays from and the batch rows it reads."""
+    si = _host(commit.state_indices)
+    if si is not None and si.numel() != n_spec:
+        problems.append(f"recover commit: {si.numel()} state rows for {n_spec} spec decodes")
+    _range(problems, "recover commit state index", si, pool)
+    ri = _host(commit.request_indices)
+    if ri is not None:
+        if ri.numel() != n_spec:
+            problems.append(
+                f"recover commit: {ri.numel()} request rows for {n_spec} spec decodes")
+        _range(problems, "recover commit request index", ri, num_seqs)
+    cq = _host(commit.query_start_loc)
+    if cq is not None and cq.numel() != n_spec + 1:
+        problems.append(
+            f"recover commit: query_start_loc has {cq.numel()} entries "
+            f"for {n_spec} spec decodes")
+
+
+def check_gather_mapping(idx_mapping: torch.Tensor, max_num_reqs: int) -> None:
+    """Rows gathered into the batch-order block tables must name a request
+    slot: a negative slot has no row (reading row -1 reads memory before the
+    table, whose contents would become state block ids)."""
+    v = _host(idx_mapping)
+    if v.numel() and (int(v.min()) < 0 or int(v.max()) >= max_num_reqs):
+        logger.error("state index check failed (gather): request slots %s", v.tolist())
+        raise StateIndexError(
+            f"block-table gather with request slots outside [0, {max_num_reqs}): "
+            f"{v.tolist()}")
+
+
+def check_align_copies(kind: str, block_tables: list[torch.Tensor], num_blocks: int,
+                       idx_mapping: torch.Tensor, src_col, dst_col, bias, needs) -> None:
+    """Shared range check of one align copy pass. ``block_tables`` are the
+    per-request-slot tables the copy kernels read (row = request slot), so a
+    batch row reads row ``idx_mapping[row]``. ``src_col`` / ``dst_col`` /
+    ``bias`` / ``needs`` are per batch row (host int64 / bool); rows whose
+    ``idx_mapping`` is negative or whose ``needs`` is False do not copy."""
+    req = _host(idx_mapping)
+    problems: list[str] = []
+    warnings: list[str] = []
+    for g, bt in enumerate(block_tables):
+        table = _host(bt)
+        width = int(table.shape[1])
+        for row in range(req.numel()):
+            r = int(req[row])
+            if r < 0 or not bool(needs[row]):
+                continue
+            s, d, b = int(src_col[row]), int(dst_col[row]), int(bias[row])
+            cols = {"src": s, "src+bias": s + b, "dst": d}
+            for name, c in cols.items():
+                if not 0 <= c < width:
+                    problems.append(f"{kind} group {g} row {row} (req slot {r}): "
+                                    f"{name} column {c} outside [0, {width})")
+                    continue
+                if r >= table.shape[0]:
+                    problems.append(f"{kind} group {g} row {row}: req slot {r} beyond "
+                                    f"{table.shape[0]} rows")
+                    continue
+                bid = int(table[r, c])
+                if not 0 <= bid < num_blocks:
+                    problems.append(f"{kind} group {g} row {row} (req slot {r}): "
+                                    f"{name} column {c} holds block {bid} outside [0, {num_blocks})")
+                elif bid == NULL_BLOCK_ID and name != "src":
+                    warnings.append(f"{kind} group {g} row {row} (req slot {r}): "
+                                    f"{name} column {c} is the null block")
+                elif bid == NULL_BLOCK_ID:
+                    warnings.append(f"{kind} group {g} row {row} (req slot {r}): "
+                                    f"copies from the null block (column {c})")
+    if warnings:
+        logger.warning("state index check (%s): %s", kind, "; ".join(warnings[:16]))
+    if problems:
+        logger.error("state index check failed (%s): %s", kind, "; ".join(problems[:16]))
+        raise StateIndexError("; ".join(problems[:16]))
+
+
+def precopy_plan(src_col_slots, state_idx_slots, src_off_slots, idx_mapping):
+    """Per batch row (src, dst, bias, needs) of precopy_mamba_align_fused_kernel."""
+    req = _host(idx_mapping)
+    src_s, dst_s, off_s = _host(src_col_slots), _host(state_idx_slots), _host(src_off_slots)
+    n = req.numel()
+    src = torch.full((n,), -1, dtype=torch.int64)
+    dst = torch.full((n,), -1, dtype=torch.int64)
+    bias = torch.zeros(n, dtype=torch.int64)
+    ok = req >= 0
+    src[ok], dst[ok], bias[ok] = src_s[req[ok]], dst_s[req[ok]], off_s[req[ok]]
+    needs = ok & (src >= 0) & (src != dst)
+    return src, dst, bias, needs
+
+
+def postcopy_plan(num_accepted_slots, state_idx_slots, num_computed_slots, idx_mapping,
+                  block_size: int):
+    """Per batch row (src, dst, bias, needs) of postprocess_mamba_fused_kernel
+    with PRECOMPUTED_NEW_COMPUTED (the V2 call)."""
+    req = _host(idx_mapping)
+    acc_s, st_s, nc_s = (_host(num_accepted_slots), _host(state_idx_slots),
+                         _host(num_computed_slots))
+    n = req.numel()
+    src = torch.full((n,), -1, dtype=torch.int64)
+    dst = torch.full((n,), -1, dtype=torch.int64)
+    bias = torch.zeros(n, dtype=torch.int64)
+    needs = torch.zeros(n, dtype=torch.bool)
+    for row in range(n):
+        r = int(req[row])
+        if r < 0:
+            continue
+        acc, s, new = int(acc_s[r]), int(st_s[r]), int(nc_s[r])
+        running = new - acc + 1
+        aligned = (new // block_size) * block_size
+        if aligned < running:
+            continue
+        b = aligned - running
+        d = aligned // block_size - 1
+        if s == d and b == 0:
+            continue
+        src[row], dst[row], bias[row], needs[row] = s, d, b, True
+    return src, dst, bias, needs
diff --git a/vllm/sm80/worker/target_argmax.py b/vllm/sm80/worker/target_argmax.py
new file mode 100644
index 0000000000..0b2b7fedd7
--- /dev/null
+++ b/vllm/sm80/worker/target_argmax.py
@@ -0,0 +1,301 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+# The idea (hand the sampler logits that hold only the vocabulary-parallel
+# argmax when every request is greedy) follows GNmac-lab's greedy-argmax
+# patch: Copyright (c) 2026 GNmac-lab, MIT.
+"""Greedy target sampling with a per-rank argmax, without the all-gather of
+the target logits.
+
+``GPUModelRunner.sample`` computes the target logits once
+(``self.model.compute_logits``: the vocabulary-parallel head, then an
+all-gather over the TP group) before the grammar bitmask, the sampler and the
+rejection sampler read them. When every request of the step is greedy and
+nothing reads the logits beyond their argmax, that gather only feeds an
+argmax.
+
+With ``VLLM_SM80_TARGET_SHARD_ARGMAX`` the fork's V2 model runner
+(``vllm/sm80/worker/graph_mem_worker.py``) runs ``sample`` inside
+:func:`step`, which decides from the step's batch, grammar output and sampler
+states whether the step is greedy-only (:func:`greedy_only`). While such a
+step runs (:func:`active`), the sm_80 target's ``compute_logits`` returns
+:func:`argmax_rows` in place of the gathered logits; every other call (other
+steps, prompt logprobs, the dummy sampler run) gathers.
+
+:func:`argmax_token_ids` keeps each rank's own columns
+(``compute_logits_local``), takes their argmax per 4096-column chunk and
+reduces the chunks over the TP group with the DSpark drafter's slot
+all-reduce (``vllm/sm80/spec_decode/shard_argmax.py``: ``chunk_slots``,
+``tensor_model_parallel_all_reduce``, ``pick``). The tokens are torch.argmax's
+over the gathered row, ties and NaN included: the first index of the largest
+value, the first NaN when any is NaN, -0.0 equal to +0.0.
+
+When ``VLLM_SM80_TARGET_SHARD_ARGMAX_DIRECT`` is enabled (default ``1``) and
+the greedy step has no ``draft_logits``, no ``masked_token_ids``, no FLy
+window, no synthetic acceptance rates, and no device adaptive verification,
+:func:`argmax_rows` hands ``int64 [rows, 1]`` winning token IDs directly to
+``Sampler`` and ``RejectionSampler``, skipping the ``[rows, vocab]`` ``-inf``
+allocation, ``scatter_``, and full-vocabulary re-argmax kernels. Otherwise it
+falls back to dense ``[rows, vocab]`` rows holding ``0.0`` at the winner and
+``-inf`` elsewhere.
+
+No host synchronization and no data-dependent shape: the slots, the token
+ids and the rows have shapes fixed by the step's row count.
+"""
+
+from collections.abc import Iterator
+from contextlib import contextmanager
+import os
+
+import numpy as np
+import torch
+
+import vllm.envs as envs
+from vllm.distributed import tensor_model_parallel_all_reduce
+from vllm.logger import init_logger
+from vllm.sm80.spec_decode import shard_argmax
+from vllm.triton_utils import triton
+from vllm.v1.worker.gpu.sample.sampler import Sampler
+from vllm.v1.worker.gpu.spec_decode.rejection_sampler import RejectionSampler
+
+logger = init_logger(__name__)
+
+SWITCH = "VLLM_SM80_TARGET_SHARD_ARGMAX"
+DIRECT_SWITCH = "VLLM_SM80_TARGET_SHARD_ARGMAX_DIRECT"
+
+# True while the runner samples a greedy-only step (:func:`step`).
+_active = False
+_direct = False
+
+
+def _head(model):
+    """The module holding the target's ``lm_head`` and ``logits_processor``."""
+    return getattr(model, "language_model", model)
+
+
+def direct_enabled() -> bool:
+    """Whether the direct int64 token-ID carrier fast path is enabled."""
+    raw = os.environ.get(DIRECT_SWITCH, "1").strip().lower()
+    return raw not in ("0", "false", "no", "off")
+
+
+def is_direct_token_ids(logits: torch.Tensor) -> bool:
+    """True when ``logits`` is a pre-computed ``int64 [rows, 1]`` carrier."""
+    return (
+        logits.dtype == torch.int64
+        and logits.ndim == 2
+        and logits.shape[1] == 1
+    )
+
+
+def refusal(runner) -> str | None:
+    """Why the per-rank argmax cannot serve this runner's target."""
+    if not getattr(runner, "target_argmax_steps", False):
+        return (
+            f"the model runner {type(runner).__name__} does not sample in "
+            "greedy steps (the fork V2 runner of vllm/sm80/worker/"
+            f"graph_mem_worker.py, chosen at boot with {SWITCH}=1)"
+        )
+    if not getattr(runner, "is_last_pp_rank", True):
+        return None  # samples nothing
+    model = getattr(runner, "model", None)
+    if not getattr(model, "target_argmax_logits", False):
+        return (
+            f"{type(model).__name__} does not return the argmax rows in a "
+            "greedy step (compute_logits)"
+        )
+    if not hasattr(model, "compute_logits_local"):
+        return (
+            f"{type(model).__name__} has no vocabulary-shard logits "
+            "(compute_logits_local)"
+        )
+    lm = _head(model)
+    head = getattr(lm, "lm_head", None)
+    processor = getattr(lm, "logits_processor", None)
+    if not hasattr(head, "tp_rank") or processor is None:
+        return f"{type(model).__name__} has no vocabulary-parallel LM head"
+    if getattr(processor, "logits_as_input", False):
+        return "the logits processor takes logits as input"
+    if processor.org_vocab_size > shard_argmax.MAX_VOCAB:
+        return f"a vocabulary above {shard_argmax.MAX_VOCAB} tokens"
+    if getattr(runner, "lora_config", None):
+        return "LoRA adapters replace the logits processor"
+    if getattr(runner, "batch_sharder", None) is not None:
+        return "batch-sharded sampling replaces the all-gather already"
+    return None
+
+
+def set_enabled(runner, on: bool) -> None:
+    """Turn the per-rank argmax on or off for ``runner``; on is refused
+    (ValueError) for a runner it cannot serve (:func:`refusal`)."""
+    if on:
+        reason = refusal(runner)
+        if reason is not None:
+            raise ValueError(f"{SWITCH}: {reason}")
+        logger.info_once(
+            "Greedy target sampling takes a per-rank argmax (%s=1, direct=%d): "
+            "no all-gather of the target logits when every request is greedy.",
+            SWITCH,
+            int(direct_enabled()),
+        )
+    runner._target_shard_argmax = on
+
+
+def enabled(runner) -> bool:
+    on = getattr(runner, "_target_shard_argmax", None)
+    if on is None:
+        set_enabled(runner, bool(getattr(envs, SWITCH)))
+        on = runner._target_shard_argmax
+    return on
+
+
+def greedy_only(runner, input_batch, grammar_output) -> bool:
+    """True when the step's samplers read the target logits only through
+    their argmax (see the module docstring). Host state only."""
+    if grammar_output is not None:
+        return False
+    sampler = runner.sampler
+    if type(sampler) is not Sampler:
+        return False
+    rejection = runner.rejection_sampler
+    if rejection is not None and type(rejection) is not RejectionSampler:
+        return False
+    if sampler.compute_nans or sampler.return_sampling_mask:
+        return False
+    draft_logits = getattr(getattr(runner, "speculator", None), "draft_logits", None)
+    if draft_logits is not None:
+        vocab = _head(runner.model).logits_processor.org_vocab_size
+        if draft_logits.shape[-1] < vocab:
+            return False
+    idx = input_batch.idx_mapping_np
+    states = sampler.sampling_states
+    return (
+        bool(np.all(states.temperature.np[idx] == 0.0))
+        and not np.any(sampler.needs_logits_processing[idx])
+        and sampler.get_logprobs_dims(idx) is None
+        # No top-k/top-p (get_top_k_top_p): top-p may drop the first of tied
+        # maxima. SamplingParams resets both for a greedy request.
+        and bool(np.all(states.top_k.np[idx] == states.vocab_size))
+        and bool(np.all(states.top_p.np[idx] == 1.0))
+    )
+
+
+def direct_supported(runner, input_batch) -> bool:
+    """True when a greedy-only step can consume ``int64 [rows, 1]`` token IDs
+    directly without allocating dense ``[rows, vocab]`` logits."""
+    if not direct_enabled():
+        return False
+    if getattr(runner, "masked_token_ids", None) is not None:
+        return False
+    draft_logits = getattr(getattr(runner, "speculator", None), "draft_logits", None)
+    if draft_logits is not None:
+        return False
+    rejection = getattr(runner, "rejection_sampler", None)
+    if rejection is not None and getattr(input_batch, "num_draft_tokens", 0) != 0:
+        if getattr(rejection, "synthetic_conditional_rates", None) is not None:
+            return False
+        if getattr(rejection, "fly_window_size", 0) > 0:
+            return False
+        if getattr(rejection, "enable_adaptive_verification", False):
+            return False
+    return True
+
+
+@contextmanager
+def step(runner, input_batch, grammar_output) -> Iterator[None]:
+    """Run one ``GPUModelRunner.sample``: while it runs, :func:`active` says
+    whether the target's ``compute_logits`` returns the argmax rows (or direct
+    token IDs when :func:`direct_active` is also True)."""
+    global _active, _direct
+    is_active = enabled(runner) and greedy_only(runner, input_batch, grammar_output)
+    _active = is_active
+    _direct = is_active and direct_supported(runner, input_batch)
+    try:
+        yield
+    finally:
+        _active = False
+        _direct = False
+
+
+def active() -> bool:
+    return _active
+
+
+def direct_active() -> bool:
+    return _direct
+
+
+def argmax_token_ids(model, hidden_states: torch.Tensor) -> torch.Tensor:
+    """Winning token IDs ``int64 [rows]`` matching torch.argmax of
+    ``model.compute_logits(hidden_states)``, without gathering the logits or
+    allocating a full-vocabulary row buffer."""
+    lm = _head(model)
+    local = model.compute_logits_local(hidden_states)
+    rows, width = local.shape
+    if rows == 0:
+        # Every rank has the same rows: none enters the all-reduce.
+        return torch.empty((0,), dtype=torch.int64, device=local.device)
+    rank, tp_size = lm.lm_head.tp_rank, lm.lm_head.tp_size
+    vocab = lm.logits_processor.org_vocab_size
+    # The gathered row is the ranks' columns in rank order, cut at the
+    # vocabulary size.
+    col_start = rank * width
+    n_cols = min(max(vocab - col_start, 0), width)
+    cols = local[:, :n_cols]
+    if cols.dtype != torch.float32:
+        cols = cols.float()  # exact; keeps order, ties and NaN
+    chunks = triton.cdiv(width, shard_argmax.BLOCK)
+    slots = shard_argmax.chunk_slots(cols, col_start, rank, tp_size, chunks)
+    if tp_size > 1:
+        slots = tensor_model_parallel_all_reduce(slots)
+    return shard_argmax.pick(slots, vocab)
+
+
+def argmax_rows(model, hidden_states: torch.Tensor) -> torch.Tensor:
+    """In a direct greedy step (:func:`direct_active`), returns ``int64
+    [rows, 1]`` winning token IDs directly for ``Sampler`` and
+    ``RejectionSampler``. Otherwise returns dense ``[rows, vocab]`` rows
+    holding 0.0 at torch.argmax and -inf elsewhere."""
+    if _direct:
+        return argmax_token_ids(model, hidden_states).unsqueeze(1)
+    lm = _head(model)
+    local = model.compute_logits_local(hidden_states)
+    rows, width = local.shape
+    rank, tp_size = lm.lm_head.tp_rank, lm.lm_head.tp_size
+    vocab = lm.logits_processor.org_vocab_size
+    out = local.new_full((rows, vocab), float("-inf"))
+    if rows == 0:
+        # Every rank has the same rows: none enters the all-reduce.
+        return out
+    col_start = rank * width
+    n_cols = min(max(vocab - col_start, 0), width)
+    cols = local[:, :n_cols]
+    if cols.dtype != torch.float32:
+        cols = cols.float()  # exact; keeps order, ties and NaN
+    chunks = triton.cdiv(width, shard_argmax.BLOCK)
+    slots = shard_argmax.chunk_slots(cols, col_start, rank, tp_size, chunks)
+    if tp_size > 1:
+        slots = tensor_model_parallel_all_reduce(slots)
+    return out.scatter_(1, shard_argmax.pick(slots, vocab)[:, None], 0.0)
+
+
+def warm(runner, hidden_states: torch.Tensor | None = None) -> None:
+    """With the switch on, refuse a runner it cannot serve and compile the
+    slot kernels on ``hidden_states`` (the dummy sampler run at boot), or on
+    one zero row of the model's hidden size (the A/B switch's arm), outside
+    graph capture. Every rank of the last pipeline stage calls it with the
+    same rows."""
+    if not (enabled(runner) and getattr(runner, "is_last_pp_rank", True)):
+        return
+    if hidden_states is None:
+        config = runner.model_config
+        hidden_states = torch.zeros(
+            1, config.get_hidden_size(), dtype=config.dtype, device=runner.device
+        )
+    with torch.inference_mode():
+        winners = argmax_token_ids(runner.model, hidden_states)
+        if direct_enabled() and getattr(runner, "rejection_sampler", None) is not None:
+            from vllm.v1.worker.gpu.spec_decode.rejection_sampler import (
+                warm_greedy_argmax_rejection_sample,
+            )
+
+            warm_greedy_argmax_rejection_sample(winners.device)
