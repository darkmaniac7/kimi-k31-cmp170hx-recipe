@@ -0,0 +1,249 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Exhaustive checks of the sm_80 FP8/FP4 quantize-dequantize emulation.
+
+Every finite bf16 bit pattern is placed at the start, the middle and the end
+of a block, alone (it sets the scale) and next to fixed companions (the
+companion sets the scale and the pattern lands anywhere on the grid, down into
+the E4M3 denormals and up to saturation). The module's output must equal, bit
+for bit, an independent implementation: the scale exponent from ``frexp``, the
+E4M3 element from ``torch.Tensor.to(torch.float8_e4m3fn)`` and the E2M1
+element from an explicit nearest-value table with ties to the even code.
+
+    pytest -q tests/models/deepseek_v41/sm80/test_act_quant.py
+"""
+
+import pytest
+import torch
+
+from vllm.models.deepseek_v41.nvidia.ops.sm80_act_quant import (
+    act_quant_qdq_fp8,
+    act_quant_qdq_fp8_triton,
+    fp4_qdq,
+    fp4_qdq_triton,
+)
+
+_INV448 = torch.tensor(1.0 / 448.0, dtype=torch.float32)
+_INV6 = torch.tensor(1.0 / 6.0, dtype=torch.float32)
+_E2M1 = torch.tensor([0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0], dtype=torch.float64)
+
+
+def _all_finite_bf16() -> torch.Tensor:
+    bits = torch.arange(-32768, 32768, dtype=torch.int32).to(torch.int16)
+    x = bits.view(torch.bfloat16)
+    return x[torch.isfinite(x.float())]
+
+
+def _pow2_ceil_frexp(a: torch.Tensor) -> torch.Tensor:
+    mant, exp = torch.frexp(a)  # a = mant * 2**exp, mant in [0.5, 1)
+    k = torch.where(mant == 0.5, exp - 1, exp)
+    return torch.exp2(k.double()).float()
+
+
+def _e2m1_table(v: torch.Tensor) -> torch.Tensor:
+    a = v.double().abs().unsqueeze(-1)
+    dist = (a - _E2M1).abs()
+    nearest = dist == dist.min(-1, keepdim=True).values
+    even = torch.arange(8) % 2 == 0
+    tie = nearest.sum(-1, keepdim=True) > 1
+    pick = torch.where(tie, nearest & even, nearest)
+    mag = _E2M1[pick.to(torch.int8).argmax(-1)]
+    return torch.copysign(mag.float(), v)
+
+
+def ref_fp8(x: torch.Tensor, block: int) -> torch.Tensor:
+    xf = x.float().unflatten(-1, (-1, block))
+    amax = xf.abs().amax(-1, keepdim=True).clamp_min(1e-4)
+    s = _pow2_ceil_frexp(amax * _INV448)
+    q = (xf / s).clamp(-448.0, 448.0).to(torch.float8_e4m3fn).float()
+    return (q * s).flatten(-2).to(x.dtype)
+
+
+def ref_fp4(x: torch.Tensor, block: int, scale: str) -> torch.Tensor:
+    xf = x.float().unflatten(-1, (-1, block))
+    amax = xf.abs().amax(-1, keepdim=True)
+    if scale == "e8m0":
+        s = _pow2_ceil_frexp(amax.clamp_min(6 * 2.0**-126) * _INV6)
+    else:
+        a = (amax.clamp_min(6 * 2.0**-9) / 6.0).clamp_max(448.0)
+        s = a.to(torch.float8_e4m3fn).float()
+    q = _e2m1_table((xf / s).clamp(-6.0, 6.0))
+    return (q * s).flatten(-2).to(x.dtype)
+
+
+def _bits_equal(a: torch.Tensor, b: torch.Tensor) -> bool:
+    return torch.equal(a.view(torch.int16), b.view(torch.int16))
+
+
+def _assert_bits_equal(got: torch.Tensor, want: torch.Tensor) -> None:
+    if not _bits_equal(got, want):
+        bad = (got.view(torch.int16) != want.view(torch.int16)).nonzero()
+        r = bad[0].tolist()
+        raise AssertionError(
+            f"{bad.shape[0]} mismatches, first at {r}: got "
+            f"{got[tuple(r)].item()!r} want {want[tuple(r)].item()!r}"
+        )
+
+
+def _sweep(block: int, pos: int, companion: float | None, cpos: int):
+    patterns = _all_finite_bf16()
+    x = torch.zeros(patterns.numel(), block, dtype=torch.bfloat16)
+    if companion is not None:
+        x[:, cpos] = companion
+    x[:, pos] = patterns
+    return x
+
+
+_POSITIONS = ("first", "middle", "last")
+
+
+def _pos(block: int, which: str) -> tuple[int, int]:
+    p = {"first": 0, "middle": block // 2, "last": block - 1}[which]
+    return p, (block - 1 if p == 0 else 0)
+
+
+@pytest.mark.parametrize("which", _POSITIONS)
+@pytest.mark.parametrize(
+    "companion", [None, 1.0, 448.0, 3.0, 2.0**-10, 1.5e-4, 65536.0, -0.75]
+)
+def test_fp8_every_bf16_pattern(which: str, companion: float | None) -> None:
+    pos, cpos = _pos(32, which)
+    x = _sweep(32, pos, companion, cpos)
+    _assert_bits_equal(act_quant_qdq_fp8(x, 32), ref_fp8(x, 32))
+
+
+@pytest.mark.parametrize("scale,block", [("e8m0", 32), ("e4m3", 16)])
+@pytest.mark.parametrize("which", _POSITIONS)
+@pytest.mark.parametrize(
+    "companion", [None, 6.0, 1.0, 5.0, 2.0**-9, 3000.0, 6.375, -0.1]
+)
+def test_fp4_every_bf16_pattern(
+    scale: str, block: int, which: str, companion: float | None
+) -> None:
+    pos, cpos = _pos(block, which)
+    x = _sweep(block, pos, companion, cpos)
+    _assert_bits_equal(fp4_qdq(x, block, scale), ref_fp4(x, block, scale))
+
+
+@pytest.mark.parametrize("scale,block", [("e8m0", 32), ("e4m3", 16)])
+def test_e2m1_ties_round_to_even(scale: str, block: int) -> None:
+    # amax 6 gives scale exactly 1 for both formats, so x / s is x itself.
+    ties = {0.25: 0.0, 0.75: 1.0, 1.25: 1.0, 1.75: 2.0, 2.5: 2.0, 3.5: 4.0, 5.0: 4.0}
+    for v, want in ties.items():
+        for sign in (1.0, -1.0):
+            x = torch.zeros(1, block, dtype=torch.bfloat16)
+            x[0, 0] = 6.0
+            x[0, 1] = sign * v
+            y = fp4_qdq(x, block, scale)
+            assert y[0, 1].item() == sign * want, (scale, v, sign, y[0, 1].item())
+            assert y[0, 0].item() == 6.0
+            assert ref_fp4(x, block, scale)[0, 1].item() == sign * want
+
+
+def test_all_zero_blocks() -> None:
+    x = torch.zeros(3, 64, dtype=torch.bfloat16)
+    for y in (
+        act_quant_qdq_fp8(x, 32),
+        fp4_qdq(x, 32, "e8m0"),
+        fp4_qdq(x[:, :48], 16, "e4m3"),
+    ):
+        assert torch.equal(y.view(torch.int16), torch.zeros_like(y.view(torch.int16)))
+    # Negative zeros keep their sign, as the hardware casts do.
+    nz = torch.full((1, 32), -0.0, dtype=torch.bfloat16)
+    assert torch.signbit(act_quant_qdq_fp8(nz, 32).float()).all()
+    assert torch.signbit(fp4_qdq(nz, 32, "e8m0").float()).all()
+
+
+@pytest.mark.parametrize("k", range(-20, 21))
+def test_fp8_amax_exact_powers_of_two(k: int) -> None:
+    for amax in (448.0 * 2.0**k, 2.0**k, 1.75 * 2.0**k):
+        x = torch.zeros(1, 32, dtype=torch.bfloat16)
+        x[0, 7] = amax
+        x[0, 8] = -amax / 3
+        y = act_quant_qdq_fp8(x, 32)
+        _assert_bits_equal(y, ref_fp8(x, 32))
+        # The block maximum is always representable after the round trip.
+        assert y[0, 7].item() == x[0, 7].item()
+
+
+@pytest.mark.parametrize("k", range(-20, 21))
+def test_fp4_amax_exact_powers_of_two(k: int) -> None:
+    for scale, block in (("e8m0", 32), ("e4m3", 16)):
+        for amax in (6.0 * 2.0**k, 2.0**k):
+            x = torch.zeros(1, block, dtype=torch.bfloat16)
+            x[0, 3] = amax
+            x[0, 4] = amax / 5
+            _assert_bits_equal(fp4_qdq(x, block, scale), ref_fp4(x, block, scale))
+
+
+def test_fp8_subnormal_results() -> None:
+    # amax 448 -> scale 1; E4M3 denormals step by 2**-9.
+    x = torch.zeros(1, 32, dtype=torch.bfloat16)
+    x[0, 0] = 448.0
+    cases = {
+        3 * 2.0**-9: 3 * 2.0**-9,  # exact denormal
+        2.0**-10: 0.0,  # half the smallest denormal: tie to even (0)
+        3 * 2.0**-10: 2.0**-8,  # 1.5 denormal steps: tie to even (2 steps)
+        2.0**-6: 2.0**-6,  # smallest normal
+        7 * 2.0**-9: 7 * 2.0**-9,  # largest denormal
+    }
+    for v, want in cases.items():
+        x[0, 1] = v
+        assert act_quant_qdq_fp8(x, 32)[0, 1].item() == want, v
+        assert ref_fp8(x, 32)[0, 1].item() == want, v
+
+
+def test_fp4_saturation() -> None:
+    # e4m3(6.375 / 6 = 1.0625) ties down to 1.0, so the block max lands at
+    # 6.375 / 1 and saturates to 6.
+    x = torch.zeros(1, 16, dtype=torch.bfloat16)
+    x[0, 0] = 6.375
+    assert fp4_qdq(x, 16, "e4m3")[0, 0].item() == 6.0
+    # The E4M3 scale itself saturates at 448 (satfinite): 3000 / 6 = 500.
+    x[0, 0] = 3000.0
+    assert fp4_qdq(x, 16, "e4m3")[0, 0].item() == 6.0 * 448.0
+    _assert_bits_equal(fp4_qdq(x, 16, "e4m3"), ref_fp4(x, 16, "e4m3"))
+
+
+def test_shapes_and_dtype() -> None:
+    x = torch.randn(2, 3, 512, dtype=torch.bfloat16)
+    assert act_quant_qdq_fp8(x).shape == x.shape
+    assert fp4_qdq(x, 16, "e4m3").dtype == torch.bfloat16
+    with pytest.raises(ValueError):
+        act_quant_qdq_fp8(x[..., :40], 32)
+    with pytest.raises(ValueError):
+        fp4_qdq(x, 32, "ue8m0")
+
+
+_cuda = pytest.mark.skipif(not torch.cuda.is_available(), reason="needs CUDA")
+
+
+@_cuda
+@pytest.mark.parametrize("which", _POSITIONS)
+@pytest.mark.parametrize("companion", [None, 1.0, 448.0, 2.0**-10, 6.375, 3000.0])
+def test_triton_matches_torch_every_pattern(which: str, companion: float | None) -> None:
+    for block, fn, tfn in (
+        (32, lambda x: act_quant_qdq_fp8(x, 32), act_quant_qdq_fp8_triton),
+        (32, lambda x: fp4_qdq(x, 32, "e8m0"), lambda x: fp4_qdq_triton(x, 32)),
+        (
+            16,
+            lambda x: fp4_qdq(x, 16, "e4m3"),
+            lambda x: fp4_qdq_triton(x, 16, "e4m3"),
+        ),
+    ):
+        pos, cpos = _pos(block, which)
+        x = _sweep(block, pos, companion, cpos)
+        _assert_bits_equal(tfn(x.cuda()).cpu(), fn(x))
+
+
+@_cuda
+def test_triton_random_rows() -> None:
+    g = torch.Generator().manual_seed(0)
+    x = (torch.randn(257, 8192, generator=g) * 3).to(torch.bfloat16)
+    x[5] = 0
+    xc = x.cuda()
+    _assert_bits_equal(act_quant_qdq_fp8_triton(xc).cpu(), act_quant_qdq_fp8(x))
+    _assert_bits_equal(fp4_qdq_triton(xc, 32).cpu(), fp4_qdq(x, 32))
+    _assert_bits_equal(
+        fp4_qdq_triton(xc, 16, "e4m3").cpu(), fp4_qdq(x, 16, "e4m3")
+    )
diff --git a/tests/models/deepseek_v41/sm80/test_attn_layers.py b/tests/models/deepseek_v41/sm80/test_attn_layers.py
new file mode 100644
index 0000000000..303fc2496a
--- /dev/null
+++ b/tests/models/deepseek_v41/sm80/test_attn_layers.py
@@ -0,0 +1,309 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The sm_80 DeepSeek-V4.1 attention layer against an fp32 reference.
+
+For each layer type -- ratio 0 (sliding window only), ratio 2 kv + index
+source, and the ratio-1 stack of the candidate source (layer 20), a pure
+consumer (21) and an index source that reads the candidates (24) -- several
+requests run through the paged sm_80 layer with chunked prefill, decode steps
+of one and of several tokens, recycled high block ids and padding rows. The
+reference (``dsv41_ref.RefAttention``) runs each request alone, prefill then
+one token per step. Every cache row the layer writes (window, compressed,
+index key) must match the reference bit for bit, every top-k selection must
+be the same set, and the ``wo_a`` input must match up to the BF16 rounding of
+softmax probabilities (the reference rounds them per 64-row block against a
+running max).
+
+    pytest -q tests/models/deepseek_v41/sm80/test_attn_layers.py
+"""
+
+import random
+
+import pytest
+import torch
+
+from vllm.models.deepseek_v41.nvidia.ops import sm80_attn_core as core
+
+from .dsv41_ref import (
+    LayerSpec,
+    PagedRun,
+    RefArgs,
+    RefAttention,
+    RefShared,
+    core_config,
+    core_weights,
+    layer_inputs,
+    make_weights,
+)
+
+BF16 = torch.bfloat16
+
+# (prompt length, total length) per request.
+REQUESTS = {0: (70, 79), 1: (23, 41), 2: (101, 105)}
+
+
+def make_schedule(seed: int) -> list[list[tuple[int, int]]]:
+    """Prefill chunks of uneven sizes, then decode steps of 1-3 tokens, with
+    requests interleaved in a different order every step."""
+    rng = random.Random(seed)
+    fed = dict.fromkeys(REQUESTS, 0)
+    prefill_chunks = {0: [30, 25, 15], 1: [23], 2: [40, 33, 28]}
+    steps = []
+    while any(fed[r] < REQUESTS[r][1] for r in REQUESTS):
+        step = []
+        for r in rng.sample(sorted(REQUESTS), len(REQUESTS)):
+            prompt, total = REQUESTS[r]
+            if fed[r] >= total or (not steps and r == 2):
+                continue
+            if fed[r] < prompt:
+                n = prefill_chunks[r].pop(0)
+            else:
+                n = min(rng.choice([1, 1, 2, 3]), total - fed[r])
+            step.append((r, n))
+            fed[r] += n
+        steps.append(step)
+    for r, (prompt, _) in REQUESTS.items():
+        assert not prefill_chunks[r]
+    return steps
+
+
+def make_inputs(args: RefArgs, n_layers: int, seed: int) -> list[dict[int, torch.Tensor]]:
+    g = torch.Generator().manual_seed(seed)
+    return [
+        {
+            r: torch.randn(total, args.dim, generator=g).to(BF16)
+            for r, (_, total) in REQUESTS.items()
+        }
+        for _ in range(n_layers)
+    ]
+
+
+def run_sm80(args, specs, weights, xs, schedule, device="cpu"):
+    run = PagedRun(args, specs, device=device)
+    cfgs = [core_config(args, s) for s in specs]
+    cws = [core_weights(args, s, w, device) for s, w in zip(specs, weights)]
+    h = args.n_heads // args.world_size
+    outs = {}  # (layer, rid, pos) -> [H, D]
+    topks = {}  # (layer, rid, pos) -> sorted list of local positions
+    g = torch.Generator().manual_seed(7)
+    for sched in schedule:
+        starts = {r: (run.reqs[r].length if r in run.reqs else 0) for r, _ in sched}
+        batch = run.build(sched)
+        T = batch.num_tokens
+        tokens = [(r, starts[r] + i) for r, n in sched for i in range(n)]
+        for li, spec in enumerate(specs):
+            x = torch.cat([xs[li][r][starts[r] : starts[r] + n] for r, n in sched])
+            qr_kv, kv_score, iw = layer_inputs(args, spec, weights[li], x)
+            pad = 3  # CUDA-graph padding rows carry garbage
+            qr_kv = torch.cat([qr_kv, torch.randn(pad, qr_kv.shape[1], generator=g).to(BF16)])
+            if kv_score is not None:
+                kv_score = torch.cat([kv_score, torch.randn(pad, kv_score.shape[1], generator=g)])
+            if iw is not None:
+                iw = torch.cat([iw, torch.randn(pad, iw.shape[1], generator=g).to(BF16)])
+            out = torch.full((T + pad, h, args.head_dim), 3.0, dtype=BF16, device=device)
+            core.forward_layer(
+                cfgs[li],
+                cws[li],
+                run.caches(li),
+                batch,
+                qr_kv.to(device),
+                None if kv_score is None else kv_score.to(device),
+                None if iw is None else iw.to(device),
+                out,
+            )
+            assert not out[T:].any(), "padding rows must come back zero"
+            for t, (r, p) in enumerate(tokens):
+                outs[(li, r, p)] = out[t].cpu()
+                if spec.ratio:
+                    row = run.topk[t].cpu().tolist()
+                    topks[(li, r, p)] = [j for j in row if j >= 0]
+        run.after_step()
+    return run, outs, topks
+
+
+def run_reference(args, specs, weights, xs, device="cpu"):
+    """The reference, every request alone, on ``device`` (its tensors are
+    created under that default device, so its libm, reductions and RoPE
+    table are the device's)."""
+    outs, topks, layers = {}, {}, {}
+    weights = [{k: v.to(device) for k, v in w.items()} for w in weights]
+    with torch.device(device):
+        for r, (prompt, total) in REQUESTS.items():
+            refs = [RefAttention(args, s, w) for s, w in zip(specs, weights)]
+            shared = RefShared()
+            layers[r] = refs
+            steps = [(0, prompt)] + [(p, 1) for p in range(prompt, total)]
+            for start, n in steps:
+                for li, ref in enumerate(refs):
+                    x = xs[li][r][start : start + n].unsqueeze(0).to(device)
+                    o = ref.forward(x, start, shared).cpu()
+                    for i in range(n):
+                        outs[(li, r, start + i)] = o[0, i]
+                    if specs[li].ratio:
+                        idxs = shared.topk_idxs.cpu()
+                        offset = n if start == 0 else args.window_size
+                        for i in range(n):
+                            row = idxs[0, i].tolist() if idxs.shape[-1] else []
+                            topks[(li, r, start + i)] = [
+                                j - offset for j in row if j >= 0
+                            ]
+    return layers, outs, topks
+
+
+def check(
+    args, specs, run, outs, topks, ref_layers, ref_outs, ref_topks,
+    compare_outputs: bool = True,
+):
+    """Caches bitwise and top-k sets equal; with ``compare_outputs`` also the
+    wo_a inputs to the per-element bound and the <= 2 % mismatch gate (CPU
+    against CPU, where the reference kernel's arithmetic is the sm_80 one
+    up to the BF16 probability rounding). The GPU test compares outputs
+    against an FP64 reference instead."""
+    # Top-k selections: identical sets (both sorted ascending).
+    for key, want in ref_topks.items():
+        assert topks[key] == want, f"top-k differs at (layer, req, pos) {key}"
+    # The schedule exercises both regimes of every selection: rows that see
+    # fewer compressed positions than index_topk (all kept) and rows that
+    # must choose.
+    for li, spec in enumerate(specs):
+        if spec.ratio:
+            sizes = {len(v) for k, v in ref_topks.items() if k[0] == li}
+            assert args.index_topk in sizes, sizes
+            assert min(sizes) < args.index_topk // 4, sizes
+            assert len(sizes) > 3, sizes
+    assert len(topks) == len(ref_topks)
+    # Cache rows: bit for bit.
+    for r, (_, total) in REQUESTS.items():
+        for li, spec in enumerate(specs):
+            ref = ref_layers[r][li]
+            for p in range(max(0, total - args.window_size), total):
+                got = run.window_row(li, r, p).cpu()
+                want = ref.window_kv_cache[0, p % args.window_size].cpu()
+                assert torch.equal(got.view(torch.int16), want.view(torch.int16)), (
+                    f"window row layer {li} req {r} pos {p}"
+                )
+            if spec.kv_source:
+                for j in range(total // spec.ratio):
+                    got = run.comp_row(r, j).cpu()
+                    want = ref.compress_kv_cache[0, j].cpu()
+                    assert torch.equal(got.view(torch.int16), want.view(torch.int16)), (
+                        f"compressed row req {r} pos {j}"
+                    )
+                    if spec.index_source:
+                        got = run.comp_row(r, j, idxk=True).cpu()
+                        want = ref.k_cache[0, j].cpu()
+                        assert torch.equal(
+                            got.view(torch.int16), want.view(torch.int16)
+                        ), f"index key req {r} pos {j}"
+    # wo_a inputs: the same values except where a BF16 probability rounding
+    # changed the pre-quant output. That change is one BF16 step relative to
+    # the terms being summed, which have the magnitude of the element's FP8
+    # block, not of the element: near-zero elements may move by one BF16
+    # ulp of their block's amax. Larger elements may cross one FP8 rounding
+    # boundary (an E4M3 step, at most 12.5 % of the element).
+    nonzero = sum(int((v != 0).sum()) for v in outs.values())
+    n_total = sum(v.numel() for v in outs.values())
+    assert nonzero > 0.9 * n_total, "outputs are mostly zero"
+    assert all(bool(torch.isfinite(v.float()).all()) for v in outs.values())
+    if not compare_outputs:
+        return
+    n_diff = n_total = 0
+    for key, want in ref_outs.items():
+        got = outs[key]
+        assert torch.isfinite(got.float()).all()
+        diff = got.float() != want.float()
+        n_diff += int(diff.sum())
+        n_total += diff.numel()
+        w = want.float().flatten()
+        amax = w.view(-1, 32).abs().amax(-1, keepdim=True)
+        bf16_ulp = torch.where(
+            amax > 0, torch.exp2(torch.floor(torch.log2(amax)) - 7), 0.0
+        )
+        tol = bf16_ulp.expand(-1, 32).flatten() + 0.13 * w.abs()
+        err = (got.float().flatten() - w).abs()
+        worst = int(torch.argmax(err - tol))
+        assert bool((err <= tol).all()), (
+            f"{key} element {worst}: |diff| {err[worst].item():.4g} > "
+            f"{tol[worst].item():.4g} (block amax {amax[worst // 32].item():.4g})"
+        )
+    assert n_diff <= 0.02 * n_total, f"{n_diff}/{n_total} wo_a input elements differ"
+
+
+@pytest.mark.parametrize(
+    "name,specs",
+    [
+        ("ratio0", [LayerSpec(0)]),
+        ("ratio2_source", [LayerSpec(2, kv_source=True, index_source=True)]),
+        (
+            "ratio1_candidate_stack",
+            [
+                LayerSpec(1, kv_source=True, index_source=True, candidate_source=True),
+                LayerSpec(1),
+                LayerSpec(1, index_source=True, uses_candidates=True),
+            ],
+        ),
+    ],
+)
+def test_layer_matches_reference(name: str, specs: list[LayerSpec]) -> None:
+    torch.manual_seed(0)
+    args = RefArgs()
+    weights = [make_weights(args, s, 100 + i) for i, s in enumerate(specs)]
+    xs = make_inputs(args, len(specs), 5)
+    schedule = make_schedule(11)
+    run, outs, topks = run_sm80(args, specs, weights, xs, schedule)
+    ref_layers, ref_outs, ref_topks = run_reference(args, specs, weights, xs)
+    check(args, specs, run, outs, topks, ref_layers, ref_outs, ref_topks)
+
+
+def test_candidate_mask() -> None:
+    """Level two keeps the candidate blocks' scores, sends the other visible
+    positions to -FLT_MAX and leaves invisible ones at -inf; with fewer
+    candidate positions than k the selection then takes the lowest-index
+    masked ones, as the reference's top-k over -inf does with ties to the
+    lowest index."""
+    s = torch.arange(10, dtype=torch.float32).unsqueeze(0)
+    s[0, 9] = float("-inf")  # not visible yet
+    cands = torch.tensor([[2, -1]])  # positions 8..9 with block size 4
+    m = core.mask_to_candidates(s, cands, 4)
+    want = [-core.FLT_MAX] * 8 + [8.0, float("-inf")]
+    assert m[0].tolist() == want
+    got = core.topk_canonical(m, torch.tensor([9]), 3)
+    assert got.tolist() == [[0, 1, 8]]
+    cands = torch.tensor([[0, 2]])
+    m = core.mask_to_candidates(s, cands, 4)
+    assert core.topk_canonical(m, torch.tensor([9]), 3).tolist() == [[2, 3, 8]]
+
+
+def test_topk_canonical_ties() -> None:
+    scores = torch.tensor(
+        [[1.0, 2.0, 2.0, 2.0, 0.5, float("-inf")], [3.0, -core.FLT_MAX, 1.0, 1.0, 1.0, 1.0]]
+    )
+    n_vis = torch.tensor([5, 6])
+    got = core.topk_canonical(scores, n_vis, 3)
+    assert got.tolist() == [[1, 2, 3], [0, 2, 3]]
+    got = core.topk_canonical(scores, torch.tensor([2, 1]), 3)
+    assert got.tolist() == [[0, 1, -1], [0, -1, -1]]
+
+
+def test_candidate_blocks_pin_newest_block() -> None:
+    # Block 2 (positions 8..9, newest) scores lowest but is pinned in.
+    s = torch.full((1, 10), 0.0)
+    s[0, :4] = 5.0
+    s[0, 4:8] = 4.0
+    s[0, 8:] = -3.0
+    got = core.select_candidate_blocks(s, torch.tensor([10]), 2, 4)
+    assert got.tolist() == [[0, 2]]
+    # Unreachable blocks (all -inf) are never kept.
+    s[0, 4:] = float("-inf")
+    got = core.select_candidate_blocks(s, torch.tensor([4]), 3, 4)
+    assert got.tolist() == [[0, -1, -1]]
+
+
+def test_paged_offsets_use_int64() -> None:
+    """Slots whose element offset passes 2**31 address the right rows."""
+    cache = torch.zeros(2, 4, 8, dtype=BF16)
+    big = torch.as_strided(cache, (2**27, 4, 8), (0, 8, 1))  # block id 2**26 + 1
+    slots = torch.tensor([(2**26 + 1) * 4 + 3], dtype=torch.int64)
+    blk, off = core._paged(big, slots)
+    assert blk.item() == 2**26 + 1 and off.item() == 3
+    assert blk.dtype == torch.int64 and blk.item() * 4 * 8 > 2**31
diff --git a/tests/models/deepseek_v41/sm80/test_boot_warmup.py b/tests/models/deepseek_v41/sm80/test_boot_warmup.py
new file mode 100644
index 0000000000..570a32003f
--- /dev/null
+++ b/tests/models/deepseek_v41/sm80/test_boot_warmup.py
@@ -0,0 +1,548 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Boot warmup of the Triton kernels served DeepSeek-V4.1 runs used to compile
+mid-request: the sm_80 index scores, the speculative-decoding kernels, the
+MoE gate and route of VLLM_DEEPSEEK_V41_ROUTER_MMA and the grouped wo_a GEMM.
+
+* The index-score launch's specialisation key (Triton's: pointer dtypes and
+  16-byte alignment, the class of every specialised integer -- 1, divisible by
+  16, other -- and the constexprs) is the same for every score width, row
+  count and block-table width on one cache, so the one warmup compile per
+  cache covers every served call.
+* The prepare kernel's BLOCK_SIZE set the warmup walks is exactly the set
+  ``prepare_dflash_inputs`` can pick.
+* The spec-decode warmup drives the runner's own rejection sampler and the
+  speculator's own buffers.
+* The router warmup's and the wo_a warmup's launches have, between them, the
+  specialisation key (constexprs and launch options exactly) of every launch
+  a served call of 1..MAX_ROWS (router: target and drafter shapes, with and
+  without image routing, several SM counts) or 1..2048 rows (wo_a) makes.
+
+    pytest -q tests/models/deepseek_v41/sm80/test_boot_warmup.py
+"""
+
