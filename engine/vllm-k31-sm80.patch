+def test_m11_update_draft_logits_zero_full_vocab_temporaries(monkeypatch):
+    """M11: update_draft_logits_for_suffix must allocate zero [B, W, V] temporaries."""
+    vocab = 2048
+    vals = torch.full((4, 12, vocab), 1.5, dtype=torch.float32)
+    row_map = torch.tensor([0, -1, 2, 3], dtype=torch.int32)
+    cache = SimpleNamespace(values=vals, row_mapping=row_map)
+
+    idx_mapping = torch.tensor([0, 1, 2], dtype=torch.int32)
+    blended = torch.tensor(
+        [
+            list(range(10, 22)),
+            list(range(30, 42)),
+            list(range(50, 62)),
+        ],
+        dtype=torch.int64,
+    )
+    override_mask = torch.zeros((3, 12), dtype=torch.bool)
+    override_mask[0, :4] = True
+    override_mask[1, :12] = True  # unowned row (-1): must NOT touch row 0!
+    override_mask[2, 2:5] = True
+
+    orig_full_like = torch.full_like
+    orig_where = torch.where
+
+    def _forbid_full_vocab_full_like(t, *args, **kwargs):
+        if t.numel() >= vocab:
+            raise AssertionError(f"Allocated full-vocab temporary via full_like: {t.shape}")
+        return orig_full_like(t, *args, **kwargs)
+
+    def _forbid_full_vocab_where(cond, x, y):
+        out = orig_where(cond, x, y)
+        if out.numel() >= vocab:
+            raise AssertionError(f"Allocated full-vocab temporary via torch.where: {out.shape}")
+        return out
+
+    monkeypatch.setattr(torch, "full_like", _forbid_full_vocab_full_like)
+    monkeypatch.setattr(torch, "where", _forbid_full_vocab_where)
+
+    update_draft_logits_for_suffix(cache, idx_mapping, blended, override_mask)
+
+    # Row 0 slots 0..3 overridden to one-hot; slots 4..11 untouched (1.5).
+    for s in range(4):
+        tok = 10 + s
+        assert vals[0, s, tok].item() == pytest.approx(0.0)
+        assert vals[0, s, (tok + 1) % vocab].item() == pytest.approx(-1e4)
+    assert torch.all(vals[0, 4:, :] == 1.5)
+    # Row 1 untouched; Row 2 slots 2..4 overridden; slots 0..1 and 5..11 untouched.
+    assert torch.all(vals[1] == 1.5)
+    assert torch.all(vals[2, :2, :] == 1.5)
+    for s in range(2, 5):
+        tok = 50 + s
+        assert vals[2, s, tok].item() == pytest.approx(0.0)
+        assert vals[2, s, 0].item() == pytest.approx(-1e4)
+    assert torch.all(vals[2, 5:, :] == 1.5)
+    assert torch.all(vals[3] == 1.5)
