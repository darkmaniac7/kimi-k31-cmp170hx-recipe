+def _gru_gates_ctx_kernel(
+    e_proj_ptr,
+    s_proj_ptr,
+    state_ptr,
+    hz_ptr,
+    hr_ptr,
+    hn_ptr,
+    hctx_ptr,
+    next_state_ptr,
+    cat_out_ptr,
+    D: tl.constexpr,
+    BLOCK: tl.constexpr,
+    HAS_STATE: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    blk = tl.program_id(1)
+    offs = blk * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < D
+
+    ez = tl.load(e_proj_ptr + row * (3 * D) + offs, mask=mask, other=0.0).to(tl.float32)
+    er = tl.load(e_proj_ptr + row * (3 * D) + D + offs, mask=mask, other=0.0).to(tl.float32)
+    en = tl.load(e_proj_ptr + row * (3 * D) + 2 * D + offs, mask=mask, other=0.0).to(tl.float32)
+    hz = tl.load(hz_ptr + row * D + offs, mask=mask, other=0.0).to(tl.float32)
+    hn = tl.load(hn_ptr + row * D + offs, mask=mask, other=0.0).to(tl.float32)
+    hctx = tl.load(hctx_ptr + row * D + offs, mask=mask, other=0.0)
+
+    if HAS_STATE:
+        sz = tl.load(s_proj_ptr + row * (3 * D) + offs, mask=mask, other=0.0).to(tl.float32)
+        sr = tl.load(s_proj_ptr + row * (3 * D) + D + offs, mask=mask, other=0.0).to(tl.float32)
+        sn = tl.load(s_proj_ptr + row * (3 * D) + 2 * D + offs, mask=mask, other=0.0).to(tl.float32)
+        hr = tl.load(hr_ptr + row * D + offs, mask=mask, other=0.0).to(tl.float32)
+        st = tl.load(state_ptr + row * D + offs, mask=mask, other=0.0).to(tl.float32)
