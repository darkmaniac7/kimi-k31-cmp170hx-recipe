+struct CaptureState {
+    bool active = false;
+    std::string key_prefix;
+    SaveDtype save_dtype = SaveDtype::BF16;
+    std::set<int> layers;
+    std::unordered_set<std::string> taps;
+    bool verbose = false;
+
+    std::vector<uint8_t> staging;
+    std::map<std::string, TensorRecord> captured;
+    std::unordered_map<std::string, std::string> raw_name_to_canon;
+
+    std::string map_tensor_name(const char * raw_name) const {
+        if (!raw_name || raw_name[0] == '\0') return "";
+        std::string name(raw_name);
+
+        if (name == "inp_embd") {
+            return taps.count("embed") ? "embed" : "";
+        }
+        if (name == "result_norm") {
+            return taps.count("final_norm") ? "final_norm" : "";
+        }
+
+        size_t dash = name.rfind('-');
+        if (dash == std::string::npos || dash + 1 >= name.size()) {
+            return "";
+        }
+        for (size_t i = dash + 1; i < name.size(); ++i) {
+            if (!std::isdigit(static_cast<unsigned char>(name[i]))) {
+                return "";
+            }
+        }
+        int il = std::stoi(name.substr(dash + 1));
+        if (!layers.count(il)) {
+            return "";
+        }
+        std::string prefix = name.substr(0, dash);
+        std::string lpre = "L" + std::to_string(il) + ".";
+
+        if (prefix == "l_out") {
+            return taps.count("out") ? (lpre + "out") : "";
+        }
+        if (prefix == "kda_out" || prefix == "mla_out" || prefix == "attn_out") {
+            return taps.count("attn_out") ? (lpre + "attn_out") : "";
+        }
+        if (prefix == "ffn_out") {
+            return taps.count("mlp_out") ? (lpre + "mlp_out") : "";
+        }
+        if (prefix == "attn_norm") {
+            return taps.count("attn_in") ? (lpre + "attn_in") : "";
+        }
+        if (prefix == "ffn_norm") {
+            return taps.count("mlp_in") ? (lpre + "mlp_in") : "";
+        }
+        if (prefix == "prefix_sum_attn") {
+            return taps.count("prefix_sum_attn") ? (lpre + "prefix_sum_attn") : "";
+        }
+        return "";
+    }
+};
+
+static inline float read_ggml_scalar_f32(const uint8_t * ptr, ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_F32: {
+            float v = 0.0f;
+            std::memcpy(&v, ptr, sizeof(v));
+            return v;
+        }
+        case GGML_TYPE_F16: {
+            ggml_fp16_t h = 0;
+            std::memcpy(&h, ptr, sizeof(h));
+            return ggml_fp16_to_fp32(h);
+        }
+        case GGML_TYPE_BF16: {
+            ggml_bf16_t b{};
+            std::memcpy(&b, ptr, sizeof(b));
+            return ggml_bf16_to_fp32(b);
+        }
+        default:
+            return 0.0f;
+    }
+}
+
+static bool k31_cb_eval(struct ggml_tensor * t, bool ask, void * user_data) {
+    auto * st = static_cast<CaptureState *>(user_data);
+    if (!st || !st->active || !t) {
+        return ask ? false : true;
+    }
+    if (ggml_is_quantized(t->type)) {
+        return ask ? false : true;
+    }
+    if (t->type != GGML_TYPE_F32 && t->type != GGML_TYPE_F16 && t->type != GGML_TYPE_BF16) {
+        return ask ? false : true;
+    }
+
+    std::string canon = st->map_tensor_name(t->name);
+    if (canon.empty()) {
+        return ask ? false : true;
+    }
+    if (ask) {
+        return true;
+    }
+
+    const int64_t cols = t->ne[0];
+    const int64_t rows = t->ne[1] * t->ne[2] * t->ne[3];
+    if (cols <= 0 || rows <= 0) {
+        return true;
+    }
+
+    const bool is_host = (t->buffer == nullptr) || ggml_backend_buffer_is_host(t->buffer);
+    const uint8_t * src_data = nullptr;
+    if (is_host) {
+        src_data = static_cast<const uint8_t *>(t->data);
+    } else {
+        const size_t nbytes = ggml_nbytes(t);
+        if (st->staging.size() < nbytes) {
+            st->staging.resize(nbytes);
+        }
+        ggml_backend_tensor_get(t, st->staging.data(), 0, nbytes);
+        src_data = st->staging.data();
+    }
+
+    const std::string key = st->key_prefix + canon;
+    TensorRecord & rec = st->captured[key];
+    const size_t elem_bytes = dtype_elem_bytes(st->save_dtype);
+    if (rec.dtype.empty()) {
+        rec.dtype = dtype_st_name(st->save_dtype);
+        rec.shape = {0, cols};
+    } else if (rec.shape.size() != 2 || rec.shape[1] != cols) {
+        LOG_WRN("k31-dump: shape mismatch on %s (got cols=%lld vs %lld), resetting\n",
+                key.c_str(), (long long) cols, (long long) (rec.shape.size() == 2 ? rec.shape[1] : -1));
+        rec.bytes.clear();
+        rec.shape = {0, cols};
+        rec.nan_count = 0;
+        rec.inf_count = 0;
+        rec.sum_sq = 0.0;
+        rec.max_abs = 0.0;
+    }
+
+    const size_t old_bytes = rec.bytes.size();
+    const size_t add_elems = static_cast<size_t>(rows) * static_cast<size_t>(cols);
+    rec.bytes.resize(old_bytes + add_elems * elem_bytes);
+    uint8_t * dst = rec.bytes.data() + old_bytes;
+
+    const bool contig = ggml_is_contiguous(t);
+    const size_t src_eb = ggml_type_size(t->type);
+    size_t out_idx = 0;
+
+    auto emit_val = [&](float v) {
+        if (std::isnan(v)) {
+            rec.nan_count += 1;
+        } else if (std::isinf(v)) {
+            rec.inf_count += 1;
+        } else {
+            double dv = static_cast<double>(v);
+            rec.sum_sq += dv * dv;
+            double av = std::fabs(dv);
+            if (av > rec.max_abs) rec.max_abs = av;
+        }
+
+        if (st->save_dtype == SaveDtype::BF16) {
+            uint16_t b = fp32_to_bf16(v);
+            std::memcpy(dst + out_idx * 2, &b, 2);
+        } else if (st->save_dtype == SaveDtype::F16) {
+            uint16_t h = fp32_to_fp16(v);
+            std::memcpy(dst + out_idx * 2, &h, 2);
+        } else {
+            std::memcpy(dst + out_idx * 4, &v, 4);
+        }
+        ++out_idx;
+    };
+
+    if (contig) {
+        for (size_t i = 0; i < add_elems; ++i) {
+            emit_val(read_ggml_scalar_f32(src_data + i * src_eb, t->type));
+        }
+    } else {
+        for (int64_t i3 = 0; i3 < t->ne[3]; ++i3) {
+            for (int64_t i2 = 0; i2 < t->ne[2]; ++i2) {
+                for (int64_t i1 = 0; i1 < t->ne[1]; ++i1) {
+                    const size_t row_off = static_cast<size_t>(i3) * t->nb[3] +
+                                           static_cast<size_t>(i2) * t->nb[2] +
+                                           static_cast<size_t>(i1) * t->nb[1];
+                    for (int64_t i0 = 0; i0 < t->ne[0]; ++i0) {
+                        const uint8_t * ptr = src_data + row_off + static_cast<size_t>(i0) * t->nb[0];
+                        emit_val(read_ggml_scalar_f32(ptr, t->type));
+                    }
+                }
+            }
+        }
+    }
+
+    rec.shape[0] += rows;
+    st->raw_name_to_canon[t->name] = canon;
+    if (st->verbose) {
+        LOG_INF("  [cb_eval] %s -> %s shape=[%lld,%lld] ggml_type=%s nan=%lld inf=%lld\n",
+                t->name, key.c_str(), (long long) rec.shape[0], (long long) rec.shape[1],
+                ggml_type_name(t->type), (long long) rec.nan_count, (long long) rec.inf_count);
+    }
+    return true;
+}
+
+struct LogitTopKResult {
+    std::vector<int32_t> topk_ids;
+    std::vector<float>   topk_logits;
+    float                logsumexp = 0.0f;
+    int64_t              nan_count = 0;
+    int64_t              inf_count = 0;
+};
+
+static LogitTopKResult extract_topk_and_lse(const float * logits, int32_t n_vocab, int32_t topk) {
+    LogitTopKResult res;
+    const int32_t k = std::min(std::max(topk, 1), n_vocab);
+    res.topk_ids.resize(k);
+    res.topk_logits.resize(k);
+
+    double max_val = -std::numeric_limits<double>::infinity();
+    std::vector<std::pair<float, int32_t>> buf;
+    buf.reserve(static_cast<size_t>(n_vocab));
+
+    for (int32_t i = 0; i < n_vocab; ++i) {
+        float v = logits[i];
+        if (std::isnan(v)) {
+            res.nan_count += 1;
+            buf.emplace_back(-std::numeric_limits<float>::infinity(), i);
+        } else if (std::isinf(v)) {
+            res.inf_count += 1;
+            buf.emplace_back(v, i);
+            if (v > max_val) max_val = static_cast<double>(v);
+        } else {
+            buf.emplace_back(v, i);
+            if (static_cast<double>(v) > max_val) max_val = static_cast<double>(v);
+        }
+    }
+
+    if (res.nan_count > 0 || !std::isfinite(max_val)) {
+        res.logsumexp = std::numeric_limits<float>::quiet_NaN();
+    } else {
+        double sum_exp = 0.0;
+        for (int32_t i = 0; i < n_vocab; ++i) {
+            float v = logits[i];
+            if (std::isfinite(v)) {
+                sum_exp += std::exp(static_cast<double>(v) - max_val);
+            }
+        }
+        res.logsumexp = static_cast<float>(max_val + std::log(sum_exp));
+    }
+
+    auto cmp = [](const std::pair<float, int32_t> & a, const std::pair<float, int32_t> & b) {
+        if (a.first != b.first) return a.first > b.first;
+        return a.second < b.second;
+    };
+    std::partial_sort(buf.begin(), buf.begin() + k, buf.end(), cmp);
+    for (int32_t j = 0; j < k; ++j) {
+        res.topk_logits[j] = buf[j].first;
+        res.topk_ids[j]    = buf[j].second;
+    }
+    return res;
+}
+
+static TensorRecord make_i32_tensor(const std::vector<int32_t> & vals, const std::vector<int64_t> & shape) {
+    TensorRecord rec;
+    rec.dtype = "I32";
+    rec.shape = shape;
+    rec.bytes.resize(vals.size() * sizeof(int32_t));
+    if (!vals.empty()) {
+        std::memcpy(rec.bytes.data(), vals.data(), rec.bytes.size());
+    }
+    return rec;
+}
+
+static TensorRecord make_f32_tensor(const std::vector<float> & vals, const std::vector<int64_t> & shape) {
+    TensorRecord rec;
+    rec.dtype = "F32";
+    rec.shape = shape;
+    rec.bytes.resize(vals.size() * sizeof(float));
+    if (!vals.empty()) {
+        std::memcpy(rec.bytes.data(), vals.data(), rec.bytes.size());
+    }
+    for (float v : vals) {
+        if (std::isnan(v)) rec.nan_count += 1;
+        else if (std::isinf(v)) rec.inf_count += 1;
+        else {
+            double dv = static_cast<double>(v);
+            rec.sum_sq += dv * dv;
+            if (std::fabs(dv) > rec.max_abs) rec.max_abs = std::fabs(dv);
+        }
+    }
+    return rec;
+}
