+    "router_workspace_size",
+    "attn_res_rmsnorm",
+    "fused_router_gemv_topk",
+    "moe_topk_sigmoid",
+    "bf16_gemv_split2",
+    "fused_kda_decode",
+    "fused_q_kv_rmsnorm",
+    "sigmoid_mul",
