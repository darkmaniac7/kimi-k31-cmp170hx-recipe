+def test_bayesian_online_stats_shrink_bad_suffix_back_to_dspark():
+    match_len = torch.tensor([8], dtype=torch.int64)
+    num_valid = torch.tensor([4], dtype=torch.int32)
+    buckets = torch.tensor([6], dtype=torch.int32)
+    stats = torch.zeros((18, 4, 2), dtype=torch.int64)
+    # 0 accepted out of 40 observed -> shrunk confidence drops far below 0.2.
+    stats[6, :, 0] = 0
+    stats[6, :, 1] = 40
+    conf = compute_suffix_confidence(
+        match_len, num_valid, 4, min_match_len=4, conf_floor=0.90,
+        accept_stats=stats, buckets=buckets,
+    )
+    assert float(conf.max()) < 0.12
