+def test_track2_fixed_prompts_schema_and_real_tokenizer() -> None:
+    suite = json.loads(PROMPTS_JSON.read_text())
+    assert suite["schema"] == "k31_track2_prompts_v1"
+    prompts = suite["prompts"]
+    assert len(prompts) == 4
+    cats = {p["category"] for p in prompts}
+    assert cats == {"code", "prose", "reasoning", "factual"}
+
+    tik_path = REAL_MINI_DIR / "tiktoken.model"
+    tok_cfg_path = REAL_MINI_DIR / "tokenizer_config.json"
+    if not tik_path.is_file():
+        pytest.skip("real mini-k31q tiktoken.model not present")
+
+    import tiktoken
+
+    pat_str = "|".join([
+        r"""[\p{Han}]+""",
+        r"""[^\r\n\p{L}\p{N}]?[\p{Lu}\p{Lt}\p{Lm}\p{Lo}\p{M}&&[^\p{Han}]]*[\p{Ll}\p{Lm}\p{Lo}\p{M}&&[^\p{Han}]]+(?i:'s|'t|'re|'ve|'m|'ll|'d)?""",
+        r"""[^\r\n\p{L}\p{N}]?[\p{Lu}\p{Lt}\p{Lm}\p{Lo}\p{M}&&[^\p{Han}]]+[\p{Ll}\p{Lm}\p{Lo}\p{M}&&[^\p{Han}]]*(?i:'s|'t|'re|'ve|'m|'ll|'d)?""",
+        r"""\p{N}{1,3}""",
+        r""" ?[^\s\p{L}\p{N}]+[\r\n]*""",
+        r"""\s*[\r\n]+""",
+        r"""\s+(?!\S)""",
+        r"""\s+""",
+    ])
+    ranks = {}
+    for line in tik_path.read_text().splitlines():
+        if line.strip():
+            b64, r = line.split()
+            ranks[base64.b64decode(b64)] = int(r)
+    tc = json.loads(tok_cfg_path.read_text())
+    sp_by_id = {int(k): v["content"] for k, v in tc.get("added_tokens_decoder", {}).items()}
+    n_base = len(ranks)
+    special = {sp_by_id.get(i, f"<|reserved_token_{i}|>"): i for i in range(n_base, n_base + 256)}
+    enc = tiktoken.Encoding(name="kimi_k31", pat_str=pat_str, mergeable_ranks=ranks, special_tokens=special)
+    bos = special["[BOS]"]
+
+    with safe_open(str(REAL_REF_ACTS), framework="pt") as f:
+        ref_ids = f.get_tensor("token_ids").tolist()
+
+    for p in prompts:
+        ids = p["token_ids"]
+        assert ids[0] == bos == 163584
+        re_encoded = [bos] + enc.encode(p["prompt_text"], allowed_special="all")
+        assert re_encoded == ids, f"Prompt {p['id']} token_ids diverged from K3.1 tiktoken encoding"
+        if "ref_acts_slice" in p:
+            lo, hi = p["ref_acts_slice"]
+            assert ids == ref_ids[lo:hi], f"Prompt {p['id']} does not match ref_acts[{lo}:{hi}]"
+
