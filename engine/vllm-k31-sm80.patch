+# ---------------------------------------------------------------------------
+# 1. Deliverable 2: Manifest Check, expert_split TP=4, and EXL3 Zero-Padding
+# ---------------------------------------------------------------------------
+
+
+def test_k31q_v1_manifest_routed_experts_are_100_percent_vq():
+    manifest_paths = [
+        Path("/tmp/k31q-v1/k31q_manifest.json"),
+        Path("/tmp/k31q-v1-1p80/k31q_manifest.json"),
+    ]
+    found = next((p for p in manifest_paths if p.exists()), None)
+    if found is None:
+        pytest.skip("k31q-v1 manifest not mounted in this test environment")
+
+    data = json.loads(found.read_text())
+    layers = data["layers"]
+    layer_iter = layers.values() if isinstance(layers, dict) else layers
+    moe_layers = 0
+    exl3_expert_layers = 0
+    for layer in layer_iter:
+        experts = layer.get("experts") or {}
+        if not experts:
+            continue
+        moe_layers += 1
+        for proj_name in ("w1", "w2", "w3"):
+            method = experts[proj_name]["method"]
+            if method == "exl3":
+                exl3_expert_layers += 1
+            else:
+                assert method == "vq"
+    assert moe_layers > 0
+    assert exl3_expert_layers == 0
+
+
+@pytest.mark.parametrize("layer_idx", [1, 2, 17, 52, 92])
+def test_expert_split_tp4_768_columns_all_ranks(layer_idx: int):
+    seen_blocks: list[int] = []
+    for rank in range(4):
+        parallel = SimpleNamespace(
+            use_ep=False,
+            dp_size=1,
+            pcp_size=1,
+            is_sequence_parallel=False,
+            enable_eplb=False,
+            use_all2all_kernels=False,
+            tp_rank=rank,
+            tp_size=4,
+        )
+        moe_cfg = SimpleNamespace(
+            moe_parallel_config=parallel, intermediate_size=3072
+        )
+        inter, cols = moe.expert_split(moe_cfg, layer_idx)
+        assert inter == 3072
+        assert cols.stop - cols.start == 768
+        assert cols.start % BLOCK == 0 and cols.stop % BLOCK == 0
+        seen_blocks.extend(range(cols.start // BLOCK, cols.stop // BLOCK))
+    assert sorted(seen_blocks) == list(range(3072 // BLOCK))
+
