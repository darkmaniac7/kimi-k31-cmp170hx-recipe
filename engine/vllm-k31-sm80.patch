+def _clear_prune_env(monkeypatch) -> None:
+    for var in ("VLLM_K31Q_MOE_MAX_TOPK", "VLLM_K31Q_MOE_REL_THRESH"):
+        monkeypatch.delenv(var, raising=False)
+        if var in vars(envs):
+            monkeypatch.delattr(envs, var, raising=False)
+    glue._reset_state()
+
