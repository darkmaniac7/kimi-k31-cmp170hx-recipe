+def test_full_draft_stash_waits_for_the_draft_event(monkeypatch):
+    """PipeSpec reads a normal step's full block for a later Chunk B: it must
+    wait for the event behind the drafts, not the counts event."""
+    h, log = _handler(monkeypatch)
+    _queue(h, _slot([4], [[5, 6, 7]]), None)
+    h.get_prev_sampled_outputs()
+    assert h.full_drafts_stash[4][1] == "drafts"
+    h.get_prev_sampled_outputs()  # next step: the stash becomes readable
+    got = h.take_full_drafts_for_chunk_b(4, chunk_k=1)
+    assert got is not None and got[0].tolist() == [6, 7]
+    assert ("main", "wait_event", "drafts") in log
