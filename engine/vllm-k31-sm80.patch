+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Kimi K3.1 DSA layer on the sm_80 fork: the indexer without DeepGEMM and
+without Triton's ``tl.float8e4nv``.
+
+Upstream's :class:`~vllm.models.kimi_k3.nvidia.dsa.KimiK3DSAIndexer` writes
+its key cache and quantizes its query through Triton kernels that store
+through a ``float8_e4m3fn`` pointer (``ops/dsa_indexer.py``), which Triton
+refuses below sm_89, and scores through ``torch.ops.vllm.sparse_attn_indexer``,
+which needs DeepGEMM (no sm_80 kernels). The classes here keep upstream's
+modules, parameters and cache format and replace those three steps:
+
+* key insert: LayerNorm, the UE8M0 scale and the cache layout are upstream's;
+  the e4m3 bytes come from ``f32_to_e4m3_bits``
+  (``vllm/sm80/kernels/attention/triton_e4m3.py``) and go through a ``uint8``
+  pointer. The scale is stored as fp32 (the format of every CUDA device
+  outside the SM100 family, ``mqa_logits_use_mx_scales``).
+* query quantization: the same, with upstream's clamp to +-448.
+* logits and top-k: the fork's Triton MQA kernels
+  (``vllm/sm80/kernels/attention/triton_mqa_logits.py``) and upstream's
+  top-k dispatcher (``get_indexer_topk``), wired as in the GLM sparse indexer
+  (``vllm/models/glm5next/nvidia/sparse_indexer.py``).
+
+Packed cache layout. K3.1 binds the indexer cache as a strided
+``[pages, 64, head_dim + 4]`` ``uint8`` view of a block-outermost (BLHNC)
+allocation: a page is contiguous (``64 * head_dim`` value bytes, then 64 fp32
+scales), consecutive pages are a whole packed block row apart. The fork's
+paged logits wrapper asserts a contiguous cache; its kernel only needs the
+byte distance between pages, so :func:`sm80_paged_mqa_logits` launches that
+kernel with ``PAGE_BYTES`` set to the page stride. :func:`index_cache_geometry`
+checks what the kernels rely on and refuses anything else by name.
+
+One code path on every card type: the software e4m3 conversion is used
+whatever the device (never Triton's hardware ``cvt``), so two pipeline stages
+of different capability write the same key bytes.
+
+``VLLM_INDEXER_DSA_REF=1`` (the fork's debugging switch) runs the torch
+references of this module instead of the Triton kernels.
+
+:class:`KimiK3DSAAttention` and :class:`KimiK3DSAIndexer` are given to
+upstream-built modules by ``adopt`` (``sm80_model.py``); they add no
+parameter and no module.
+"""
+
+from dataclasses import dataclass
+from typing import cast
+
+import torch
+import torch.nn.functional as F
+
+import vllm.envs as envs
+from vllm.compilation.breakable_cudagraph import eager_break_during_capture
+from vllm.config import CUDAGraphMode, get_current_vllm_config_or_none
+from vllm.forward_context import get_forward_context
+from vllm.logger import init_logger
+from vllm.model_executor.layers.indexer_topk import (
+    RADIX_TOPK_WORKSPACE_SIZE,
+    get_indexer_topk,
+)
+from vllm.models.kimi_k3.nvidia import dsa as upstream_dsa
+from vllm.models.kimi_k3.nvidia.ops.dsa_indexer import _fill_topk, _ue8m0_scale
+from vllm.sm80.kernels.attention import triton_mqa_logits as mqa
+from vllm.sm80.kernels.attention.triton_e4m3 import f32_to_e4m3_bits
