+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The two-sided shortlist Markov sampling of the DSpark drafter
+(``vllm/sm80/spec_decode/markov_shortlist.py``,
+``VLLM_DSPARK_MARKOV_SHORTLIST``) on CPU.
+
+- The Triton kernels run in the Triton interpreter (a subprocess with
+  ``TRITON_INTERPRET=1``). The base candidates of a shard are its largest
+  values in ``shard_argmax``'s order (ties, NaN of either sign, -0.0 against
+  +0.0, a shard with fewer columns than candidates); the drafts of two and
+  four ranks, whose slots are summed as the all-reduce sums them, equal a
+  torch reference of the documented rule, equal the full-vocabulary argmax
+  whenever the lists cover the shard, and stay in the vocabulary on unwritten
+  slots.
+- ``DSparkSpeculator._sample_sequential`` in two and four gloo ranks: with
+  lists that cover every column the drafts and confidences equal the per-rank
+  argmax path's on every rank.
+- A column outside both lists is not drafted: the best listed one is.
+- The switch is off by default and refuses what it cannot serve.
+- The successor table holds the largest Markov biases of every previous token.
+- ``Qwen3DSparkForCausalLM.markov_w2_rows`` gives the bias of the unit
+  embeddings over the asked column range.
+- The kernels compile for sm_80 at the served shape (no GPU needed).
+
+    pytest -q tests/models/kimi_k3/sm80/test_k31_markov_shortlist.py
+"""
+
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+ROOT = Path(__file__).resolve().parents[4]
+SWITCH = "VLLM_DSPARK_MARKOV_SHORTLIST"
+SUCCESSORS = "VLLM_DSPARK_MARKOV_SUCCESSORS"
+ARGMAX_SWITCH = "VLLM_DSPARK_SHARD_ARGMAX"
+MODULE = "tests.models.kimi_k3.sm80.test_k31_markov_shortlist"
+
+
+def _key(values: torch.Tensor) -> torch.Tensor:
+    """The order key of FP32 values (torch.argmax's order: NaN above all,
+    -0.0 equal to +0.0), as int64."""
+    bits = values.float().contiguous().view(torch.int32).to(torch.int64)
+    bits = torch.where(bits == -(1 << 31), torch.zeros_like(bits), bits)
+    nan = (bits & 0x7FFFFFFF) > 0x7F800000
+    key = torch.where(bits >= 0, bits + (1 << 31), -1 - bits)
+    return torch.where(nan, torch.full_like(key, (1 << 32) - 1), key)
+
+
+def reference_top(row: torch.Tensor, n: int, cands: int) -> list[int]:
+    """The columns of a shard's largest values, the lower column first among
+    equal values; -1 pads a short shard."""
+    keys = _key(row[:n]).tolist()
+    order = sorted(range(n), key=lambda c: (-keys[c], c))[:cands]
+    return order + [-1] * (cands - len(order))
+
+
+def rank_best(state, row, top_cols, prev: int, col_start: int) -> tuple[int, int]:
+    """(key, token) of a rank's best listed column for one draft step, or
+    (0, 0) without one: FP32 scores, the lowest token among equal keys."""
+    prev = min(max(prev, 0), state.w1.shape[0] - 1)
+    e = state.w1[prev].float()
+    scored = []
+    for j, col in enumerate(state.succ_cols[prev].tolist()):
+        if col >= 0:
+            scored.append((row[col].float() + state.succ_bias[prev, j], col))
+    for col in top_cols:
+        if col >= 0:
+            scored.append((row[col].float() + state.w2_rows[col].float() @ e, col))
+    best = (0, 0)
+    for score, col in scored:
+        cand = (int(_key(score.reshape(1))[0]), col_start + col)
+        if cand[0] > best[0] or (cand[0] == best[0] and best[0] and cand[1] < best[1]):
+            best = cand
+    return best
+
+
+def reference_drafts(states, locals_, tops, first, steps, starts) -> list[list[int]]:
+    """The documented rule in torch: per step every rank's best listed column,
+    then the largest key, the lowest rank among equal keys."""
+    num_reqs = len(first)
+    out = [[0] * steps for _ in range(num_reqs)]
+    for r in range(num_reqs):
+        prev = int(first[r])
+        for i in range(steps):
+            row = r * steps + i
+            bests = [
+                rank_best(state, locals_[k][row], tops[k][row], prev, starts[k])
+                for k, state in enumerate(states)
+            ]
+            prev = max(bests, key=lambda b: b[0])[1]
+            out[r][i] = prev
+    return out
+
+
+def _state(mt, w1, w2_rows, cands, successors):
+    cols, bias = mt.successor_table(w1, w2_rows, successors)
+    return SimpleNamespace(
+        cands=cands, successors=successors, w1=w1, w2_rows=w2_rows,
+        succ_cols=cols, succ_bias=bias,
+    )
+
+
+def _sum(per_rank: list[torch.Tensor]) -> torch.Tensor:
+    """The all-reduce: FP32 sum rounded once to BF16."""
+    return torch.stack([s.float() for s in per_rank]).sum(0).to(torch.bfloat16)
+
+
+def run_ranks(mt, states, locals_, n_cols, input_ids, anchors, steps, starts, vocab):
+    """Every rank's drafts with the ranks' slots summed between the steps, and
+    the base candidates each rank searched."""
+    tp, num_reqs = len(states), anchors.shape[0]
+    tops = [mt.top_candidates(locals_[k], n_cols[k], states[k].cands) for k in range(tp)]
+    outs = [torch.zeros(num_reqs, steps, dtype=torch.int64) for _ in range(tp)]
+    slots = None
+    for step in range(steps):
+        per_rank = [
+            mt.step_slots(
+                states[k], step, slots, locals_[k], tops[k][0], tops[k][1], input_ids,
+                anchors, outs[k], steps, starts[k], k, tp, vocab,
+            )
+            for k in range(tp)
+        ]
+        for k, own in enumerate(per_rank):
+            lanes = own.float()
+            assert torch.equal(lanes, lanes.round()) and lanes.min() >= 0
+            assert lanes.max() <= 255
+            parts = own.view(num_reqs, tp, mt.LANES)
+            others = torch.cat([parts[:, :k], parts[:, k + 1 :]], dim=1)
+            assert not others.float().any()
+        slots = _sum(per_rank)
+    for k in range(tp):
+        mt.last_drafts(slots, outs[k], steps, tp, vocab)
+    return outs, tops
+
+
+def _tables(g, tokens, vocab, rank_dim):
+    w1 = torch.randint(-2, 3, (tokens, rank_dim), generator=g, dtype=torch.int8)
+    w2 = torch.randint(-2, 3, (vocab, rank_dim), generator=g, dtype=torch.int8)
+    return w1.to(torch.bfloat16), w2.to(torch.bfloat16)
+
+
+def _adversarial(base, g, seed):
+    nan, inf = float("nan"), float("inf")
+    if seed % 4 == 1:
+        base[torch.rand(base.shape, generator=g) < 0.04] = nan
+    if seed % 4 == 2:
+        base[torch.rand(base.shape, generator=g) < 0.08] = inf
+        base[torch.rand(base.shape, generator=g) < 0.08] = -inf
+    if seed % 4 == 3:
+        sign = torch.where(torch.rand(base.shape, generator=g) < 0.5, -1.0, 1.0)
+        base = base.clamp(max=0) * 0.0 * sign  # signed zeros everywhere
+    return base
+
+
+def _shards(base, tp, width, dtype):
+    """Every rank's shard of [rows, vocab] logits (NaN in the padding columns
+    of the last one), its column count and its first column."""
+    rows, vocab = base.shape
+    padded = torch.full((rows, tp * width), float("nan"))
+    padded[:, :vocab] = base
+    locals_ = [
+        padded[:, k * width : (k + 1) * width].to(dtype).contiguous() for k in range(tp)
+    ]
+    n_cols = [min(max(vocab - k * width, 0), width) for k in range(tp)]
+    return locals_, n_cols, [k * width for k in range(tp)]
+
+
+def kernel_cases() -> dict:
+    """Run in the Triton interpreter: kernels against the torch references."""
+    assert os.environ.get("TRITON_INTERPRET") == "1"
+    from vllm.sm80.spec_decode import markov_shortlist as mt
+
+    served_block = mt.BLOCK
+    mt.BLOCK = 8
+    out = {"search": [], "drafts": [], "covers": [], "miss": None, "unwritten": None,
+           "served": None}
+    g = torch.Generator().manual_seed(0)
+    vocab, steps, num_reqs = 97, 3, 2
+    for seed in range(16):
+        tp = 2 if seed % 2 else 4
+        width = -(-vocab // tp)
+        cands = (3, 8, 9, 30)[seed % 4]
+        successors = (4, 16, 5, 2)[(seed // 4) % 4]
+        dtype = torch.bfloat16 if seed % 3 == 0 else torch.float32
+        rank_dim = 12 if seed % 2 else 8
+        rows = num_reqs * steps
+        base = _adversarial(torch.randint(-3, 4, (rows, vocab), generator=g).float(), g, seed)
+        locals_, n_cols, starts = _shards(base, tp, width, dtype)
+        w1, w2 = _tables(g, vocab, vocab, rank_dim)
+        states = [
+            _state(mt, w1, w2[starts[k] : starts[k] + n_cols[k]].contiguous(), cands, successors)
+            for k in range(tp)
+        ]
+        input_ids = torch.randint(0, vocab, (64,), generator=g, dtype=torch.int32)
+        anchors = torch.tensor([5, 40], dtype=torch.int64)
+        outs, tops = run_ranks(
+            mt, states, locals_, n_cols, input_ids, anchors, steps, starts, vocab
+        )
+        want_tops = [
+            [reference_top(locals_[k][row], n_cols[k], cands) for row in range(rows)]
+            for k in range(tp)
+        ]
+        ok = all(tops[k][0].tolist() == want_tops[k] for k in range(tp))
+        for k in range(tp):
+            cols, vals = tops[k]
+            live = cols >= 0
+            picked = locals_[k].float().gather(1, cols.clamp(min=0).long())
+            ok &= bool(torch.equal(_key(vals[live]), _key(picked[live])))
+        out["search"].append(ok)
+        want = reference_drafts(
+            states, locals_, want_tops, input_ids[anchors].tolist(), steps, starts
+        )
+        out["drafts"].append([[o.tolist() for o in outs], want])
+    # Lists that cover every column: the full-vocabulary argmax of every step.
+    for seed in range(6):
+        tp = 2 if seed % 2 else 4
+        width = -(-vocab // tp)
+        base = _adversarial(torch.randint(-3, 4, (steps, vocab), generator=g).float(), g, seed)
+        locals_, n_cols, starts = _shards(base, tp, width, torch.float32)
+        w1, w2 = _tables(g, vocab, vocab, 8)
+        cands, successors = (4, width) if seed % 3 else (width, 3)
+        states = [
+            _state(mt, w1, w2[starts[k] : starts[k] + n_cols[k]].contiguous(), cands, successors)
+            for k in range(tp)
+        ]
+        input_ids = torch.tensor([seed * 7 + 3], dtype=torch.int32)
+        anchors = torch.zeros(1, dtype=torch.int64)
+        outs, _ = run_ranks(mt, states, locals_, n_cols, input_ids, anchors, steps, starts, vocab)
+        prev, full = int(input_ids[0]), []
+        for i in range(steps):
+            total = base[i] + w2.float() @ w1[prev].float()
+            keys = _key(total)
+            prev = int(torch.nonzero(keys == keys.max())[0])
+            full.append(prev)
+        out["covers"].append([outs[0].tolist(), outs[-1].tolist(), [full]])
+    # A column outside both lists: the bias lifts column 60, which is neither
+    # one of the two best base logits of its shard nor (with one successor
+    # kept) the best successor of the previous token.
+    tp, width, rank_dim = 2, 49, 8
+    base = torch.zeros(1, vocab)
+    base[0, [50, 51]] = 3.0
+    base[0, [2, 3]] = 1.0
+    base[0, 60] = -50.0
+    w1 = torch.zeros(vocab, rank_dim, dtype=torch.bfloat16)
+    w2 = torch.zeros(vocab, rank_dim, dtype=torch.bfloat16)
+    w1[7, 0] = 1.0
+    w2[60, 0] = 100.0
+    w2[70, 0] = 101.0  # the kept successor of rank 1, whose base logit sinks it
+    base[0, 70] = -200.0
+    locals_, n_cols, starts = _shards(base, tp, width, torch.float32)
+    states = [
+        _state(mt, w1, w2[starts[k] : starts[k] + n_cols[k]].contiguous(), 2, 1)
+        for k in range(tp)
+    ]
+    ids = torch.tensor([7], dtype=torch.int32)
+    outs, _ = run_ranks(mt, states, locals_, n_cols, ids, torch.zeros(1, dtype=torch.int64),
+                        1, starts, vocab)
+    full = int(torch.argmax(base[0] + w2.float() @ w1[7].float()))
+    out["miss"] = [outs[0].tolist(), outs[1].tolist(), full]
+    # Unwritten slots (a capture warmup's all-reduce output): any bytes.
+    tp, num_reqs, steps = 2, 6, 3
+    base = torch.randint(-3, 4, (num_reqs * steps, vocab), generator=g).float()
+    locals_, n_cols, starts = _shards(base, tp, 49, torch.float32)
+    w1, w2 = _tables(g, vocab, vocab, 8)
+    state = _state(mt, w1, w2[:49].contiguous(), 4, 4)
+    lanes = torch.randint(0, 256, (num_reqs, tp * mt.LANES), generator=g).float()
+    lanes[1] = float("nan")
+    lanes[2] = float("inf")
+    lanes[3] = -float("inf")
+    lanes[4] = 3.0e38
+    lanes[5] = 255.0
+    garbage = lanes.to(torch.bfloat16)
+    ids = torch.tensor([-5, 1 << 20, 3, 4, 5, 6], dtype=torch.int32)  # held in range
+    anchors = torch.arange(num_reqs, dtype=torch.int64)
+    drafts = torch.full((num_reqs, steps), -1, dtype=torch.int64)
+    tops = mt.top_candidates(locals_[0], n_cols[0], 4)
+    for step, prev in ((0, None), (1, garbage), (2, garbage)):
+        own = mt.step_slots(state, step, prev, locals_[0], tops[0], tops[1], ids, anchors,
+                            drafts, steps, 0, 0, tp, vocab)
+        decoded = own.float().view(num_reqs, tp, mt.LANES)[:, 0].to(torch.int64)
+        token = sum(decoded[:, 4 + i] << (16 - 8 * i) for i in range(3))
+        assert bool(((token >= 0) & (token < vocab)).all())
+    mt.last_drafts(garbage, drafts, steps, tp, vocab)
+    out["unwritten"] = drafts.flatten().tolist()
+    # The served shape: 2 ranks of 81920 columns, 4096-column chunks, rank 512
+    # (64 previous tokens: the kernel holds a previous token in the tables).
+    mt.BLOCK = served_block
+    tp, width, vocab, rank_dim, steps = 2, 81920, 163840, 512, 2
+    base = torch.randint(-2, 3, (steps, vocab), generator=g).float()
+    base[0, [4095, 4096, 81919, 81920, 163839]] = 7.0
+    base[1, [81920 + 4096 * 7 + 1, 4096 * 3]] = float("nan")
+    locals_, n_cols, starts = _shards(base, tp, width, torch.bfloat16)
+    w1, w2 = _tables(g, 64, vocab, rank_dim)
+    states = [
+        _state(mt, w1, w2[starts[k] : starts[k] + n_cols[k]].contiguous(), 4, 8)
+        for k in range(tp)
+    ]
+    ids = torch.tensor([11], dtype=torch.int32)
+    anchors = torch.zeros(1, dtype=torch.int64)
+    outs, tops = run_ranks(mt, states, locals_, n_cols, ids, anchors, steps, starts, vocab)
+    want = reference_drafts(states, locals_, [t[0].tolist() for t in tops], [11], steps, starts)
+    out["served"] = [
+        [o.tolist() for o in outs], want, tops[0][0][0].tolist(), tops[1][0][0].tolist(),
+        [int(tops[0][0][1, 0]), int(tops[1][0][1, 0])],
+    ]
+    return out
+
+
+def _rank_main(rank: int, tp: int, init_file: str, result_file: str) -> None:
+    """One gloo rank: the speculator's sampling without and with the shortlist."""
+    import torch.distributed as dist
+
+    from vllm.sm80.spec_decode import markov_shortlist as mt
+    from vllm.sm80.spec_decode import shard_argmax as sa
+    from vllm.v1.worker.gpu.spec_decode.dspark.speculator import DSparkSpeculator
+
+    dist.init_process_group(
+        "gloo", init_method=f"file://{init_file}", rank=rank, world_size=tp
+    )
+
+    def all_reduce(t: torch.Tensor) -> torch.Tensor:
+        f = t.float()
+        dist.all_reduce(f)
+        return f.to(t.dtype)
+
+    sa.BLOCK = mt.BLOCK = 8
+    sa.tensor_model_parallel_all_reduce = all_reduce
+    mt.tensor_model_parallel_all_reduce = all_reduce
+    os.environ[ARGMAX_SWITCH] = "1"
+    vocab, n_spec, num_reqs, rank_dim = 97, 5, 3, 8
+    width = -(-vocab // tp)
+    results = []
+    for seed in range(8):
+        g = torch.Generator().manual_seed(seed)
+        rows = num_reqs * n_spec + 4
+        base = torch.randint(-2, 3, (rows, vocab), generator=g).float()
+        base = _adversarial(base, g, seed)
+        w1, w2 = _tables(g, vocab, vocab, rank_dim)
+        padded = torch.full((rows, tp * width), float("nan"))
+        padded[:, :vocab] = base
+
+        def lookup(h):
+            return h[:, 0].long()
+
+        model = SimpleNamespace(
+            lm_head=SimpleNamespace(tp_rank=rank, tp_size=tp),
+            logits_processor=SimpleNamespace(org_vocab_size=vocab),
+            draft_id_to_target_id=None,
+            compute_logits_local=lambda h: padded[
+                lookup(h), rank * width : (rank + 1) * width
+            ].contiguous(),
+            markov_embed=lambda t: w1[t.long()].float(),
+            markov_bias=lambda e: e.float() @ w2.float().T,
+            compute_confidence=lambda h, e: h[:, 0] * 1000.0 + e.sum(-1),
+            markov_w2_rows=lambda start, n: w2[start : start + n].contiguous(),
+            model=SimpleNamespace(
+                markov_head=SimpleNamespace(markov_w1=SimpleNamespace(weight=w1))
+            ),
+        )
+        perm = torch.randperm(rows, generator=g)[: num_reqs * n_spec]
+        drafts = {}
+        # Covered two ways: every column a base candidate, or every column a
+        # Markov successor.
+        for cands, successors in ((0, 64), (width, 2), (3, width)):
+            os.environ[SWITCH] = str(cands)
+            os.environ[SUCCESSORS] = str(successors)
+            s = object.__new__(DSparkSpeculator)
+            s.model = model
+            s.num_speculative_steps = n_spec
+            s.sample_indices = perm.clone()
+            s.input_buffers = SimpleNamespace(
+                input_ids=torch.randint(
+                    0,
+                    vocab,
+                    (num_reqs * n_spec,),
+                    generator=torch.Generator().manual_seed(seed),
+                    dtype=torch.int32,
+                )
+            )
+            s._anchor_idx = torch.arange(num_reqs) * n_spec
+            s.draft_tokens = torch.zeros(num_reqs, n_spec, dtype=torch.int64)
+            s.draft_token_confidence_probs = torch.zeros(num_reqs, n_spec)
+            s.draft_logits = None
+            s._draft_topk = None
+            s.acceptance_estimator = None
+            s.use_confidence_head = True
+            head_hidden = torch.arange(rows, dtype=torch.float32)[:, None]
+            s._sample_sequential(num_reqs, head_hidden)
+            assert (getattr(s, "_markov_shortlist", None) is not None) is bool(cands)
+            drafts[cands] = [
+                s.draft_tokens.tolist(),
+                s.draft_token_confidence_probs.tolist(),
+            ]
+        results.append(drafts[0] + drafts[width] + drafts[3])
+    with open(result_file, "w") as f:
+        json.dump(results, f)
+    dist.destroy_process_group()
+
+
+def gloo_cases(tmp: str, tp: int) -> list:
+    """Run in the Triton interpreter: every gloo rank's drafts, off and on."""
+    import torch.multiprocessing as mp
+
+    files = [os.path.join(tmp, f"rank{r}.json") for r in range(tp)]
+    init = os.path.join(tmp, "gloo-init")
+    ctx = mp.get_context("spawn")
+    procs = [
+        ctx.Process(target=_rank_main, args=(r, tp, init, files[r])) for r in range(tp)
+    ]
+    for p in procs:
+        p.start()
+    for p in procs:
+        p.join(900)
+        assert p.exitcode == 0, p.exitcode
+    out = []
+    for name in files:
+        with open(name) as f:
+            out.append(json.load(f))
+    return out
+
+
+def _interpret(code: str) -> object:
+    env = dict(os.environ, TRITON_INTERPRET="1", CUDA_VISIBLE_DEVICES="")
+    done = subprocess.run(
+        [sys.executable, "-c", code],
+        cwd=ROOT,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=1800,
+    )
+    assert done.returncode == 0, done.stderr[-4000:]
+    line = [ln for ln in done.stdout.splitlines() if ln.startswith("RESULT ")][-1]
+    return json.loads(line[len("RESULT ") :])
+
+
