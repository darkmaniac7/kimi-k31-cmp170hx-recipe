+def test_last_stage_with_a_drafter_loads_the_embedding(
+    tmp_path, monkeypatch, meta_platform, checkpoint
+):
+    """With a hidden-state drafter that may share the target's embedding,
+    upstream builds embed_tokens on the last pipeline stage too
+    (spec_decode_needs_target_embed; its answer for such a drafter is given
+    here in place of a full speculative config): the stage's view carries
+    embed.safetensors (bin/k31q_views.py without --no-drafter), the loader
+    fills it, and the manifest is kept for the draft model."""
+    from types import SimpleNamespace
+
+    from vllm.distributed import get_pp_group
+    from vllm.model_executor.models.utils import PPMissingLayer
+    from vllm.models.kimi_k3.nvidia import model as kimi
+
+    last = len(PARTITION) - 1
+    upstream_rule = kimi.spec_decode_needs_target_embed
+    views = {
+        drafter: fixture.build_views(
+            checkpoint[0], tmp_path / f"views-{drafter}", PARTITION, drafter=drafter
+        )
+        for drafter in (False, True)
+    }
+    assert not (views[False][last] / "embed.safetensors").exists()
+    assert (views[True][last] / "embed.safetensors").is_symlink()
+
+    def build(view):
+        construct.set_groups(monkeypatch, 2, 1, len(PARTITION), last, PARTITION)
+        monkeypatch.setattr(
+            kimi,
+            "spec_decode_needs_target_embed",
+            lambda vllm_config: get_pp_group().is_last_rank,
+        )
+        config = construct.vllm_config(view, 2, len(PARTITION))
+        model = construct.build_model(config)
+        # What the loader reads of it: a draft model follows the target.
+        config.speculative_config = SimpleNamespace(draft_model_config=object())
+        return model, config
+
+    model, config = build(views[True][last])
+    assert not isinstance(model.model.embed_tokens, PPMissingLayer)
+    report = construct.load(monkeypatch, model, config)
+    embed = fixture.st_read(
+        checkpoint[0] / "embed.safetensors", fixture.P + "embed_tokens.weight"
+    )
+    # Rank 1 of 2 holds the second half of the vocabulary.
+    assert np.array_equal(_bits(model.model.embed_tokens.weight), embed[256:])
+    assert report.ledger[fixture.P + "embed_tokens.weight"][0] == "consumed"
+    assert config.quant_config.manifest is not None  # kept for the drafter
+    # The same stage from a view made without the drafter has no source for it.
+    model, config = build(views[False][last])
+    with pytest.raises(ValueError, match="Unloaded k31q runtime parameters") as error:
+        construct.load(monkeypatch, model, config)
+    assert "embed_tokens.weight" in str(error.value)
+    # Without a drafter the last stage builds no embedding, loads, and
+    # releases the manifest.
+    monkeypatch.setattr(kimi, "spec_decode_needs_target_embed", upstream_rule)
+    _, config, report, _ = _stage_case(monkeypatch, views[False][last], last, 2, 1)
+    assert report.layers == (4, 6) and config.quant_config.manifest is None
