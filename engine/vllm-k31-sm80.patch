+            [12288] * 4, 7168,
+        )
+        o_l, _ = _load_exl3_launcher(manifest, files, ledger, [pfx + "self_attn.o_proj"], [7168], 12288)
+        r_down_l, _ = _load_exl3_launcher(manifest, files, ledger, [pfx + "block_sparse_moe.routed_expert_down_proj"], [3584], 7168)
+        r_up_l, _ = _load_exl3_launcher(manifest, files, ledger, [pfx + "block_sparse_moe.routed_expert_up_proj"], [7168], 3584)
+        sh_gu_l, _ = _load_exl3_launcher(
+            manifest, files, ledger,
+            [pfx + "block_sparse_moe.shared_experts.gate_proj", pfx + "block_sparse_moe.shared_experts.up_proj"],
+            [6144, 6144], 7168,
+        )
+        sh_down_l, _ = _load_exl3_launcher(manifest, files, ledger, [pfx + "block_sparse_moe.shared_experts.down_proj"], [7168], 6144)
+
+        in_ln = _load_layer_plain(mini, 1, "input_layernorm.weight", device).contiguous()
+        post_ln = _load_layer_plain(mini, 1, "post_attention_layernorm.weight", device).contiguous()
+        ar_attn_nw = _load_layer_plain(mini, 1, "self_attention_res_norm.weight", device).contiguous()
+        ar_attn_qk = _load_layer_plain(mini, 1, "self_attention_res_proj.weight", device).squeeze(0).contiguous()
+        ar_mlp_nw = _load_layer_plain(mini, 1, "mlp_res_norm.weight", device).contiguous()
+        ar_mlp_qk = _load_layer_plain(mini, 1, "mlp_res_proj.weight", device).squeeze(0).contiguous()
+        r_norm_w = _load_layer_plain(mini, 1, "block_sparse_moe.routed_expert_norm.weight", device).contiguous()
+        gate_w = _load_layer_plain(mini, 1, "block_sparse_moe.gate.weight", device).contiguous()
+        gate_b = _load_layer_plain(mini, 1, "block_sparse_moe.gate.e_score_correction_bias", device).contiguous()
+
+        f_a_w = _load_layer_plain(mini, 1, "self_attn.f_a_proj.weight", device).contiguous()
+        b_w = _load_layer_plain(mini, 1, "self_attn.b_proj.weight", device).contiguous()
+        f_b_w = _load_layer_plain(mini, 1, "self_attn.f_b_proj.weight", device).contiguous()
+        conv_w = torch.cat(
+            [
+                _load_layer_plain(mini, 1, f"self_attn.{k}_conv1d.weight", device).view(-1, 4).to(torch.bfloat16)
+                for k in ("q", "k", "v")
+            ],
+            dim=0,
+        ).contiguous()
+        a_log = _load_layer_plain(mini, 1, "self_attn.A_log", device)[:H].contiguous()
+        dt_bias = _load_layer_plain(mini, 1, "self_attn.dt_bias", device).contiguous()
+        o_norm_w = _load_layer_plain(mini, 1, "self_attn.o_norm.weight", device).contiguous()
+        o_norm_mod = FusedRMSNormGated(D, activation="sigmoid", eps=1e-5, device=device, dtype=torch.float32)
+        o_norm_mod.weight.data.copy_(o_norm_w)
+
+        fab_method = K31FusedLinearMethod.__new__(K31FusedLinearMethod)
+        fab_method.out_dtype = torch.bfloat16
+        fab_method.padding = 0
+        fab_method.launcher = None
+        fab_method.row_chunks = []
+        fab_method.segments = [
+            (PLAIN, (0, 128, "f_a_proj.weight", slice(0, 128))),
+            (PLAIN, (128, 96, "b_proj.weight", slice(0, 96))),
+        ]
+        fab_layer = nn.Module()
+        fab_layer.exl3_weights = nn.ModuleList()
+        fab_layer.plain_weight = nn.Parameter(torch.cat([f_a_w, b_w], dim=0).contiguous(), requires_grad=False)
+
+        results = {}
+        for M in (1, 4, 8):
+            torch.manual_seed(2000 + M)
+            slots = 12
+            cs0 = torch.randn((slots, C, 3), dtype=torch.bfloat16, device=device) * 0.2
+            rs0 = torch.randn((slots, H, D, D), dtype=torch.float32, device=device) * 0.03
+            sidx = torch.arange(M, dtype=torch.int32, device=device) + 1
+            pref0 = l0_ao[:M].contiguous()
+            delta0 = l0_out[:M].contiguous()
+            blocks0 = torch.zeros((M, 8, 7168), dtype=torch.bfloat16, device=device)
+            blocks0[:, 0, :] = embed[:M]
+
+            def make_step(mode: str, cs_buf: torch.Tensor, rs_buf: torch.Tensor):
+                out_kda = torch.empty((1, M, H, D), dtype=torch.bfloat16, device=device)
+                conv_tmp = torch.empty((M, C), dtype=torch.bfloat16, device=device)
+                pref_buf = pref0.clone()
+                blk_buf = blocks0.clone()
+
+                def step():
+                    pref_buf.copy_(pref0)
+                    h = ar_mod.attn_res(pref_buf, delta0, blk_buf, ar_attn_nw, ar_attn_qk, in_ln, 1, -1, 1e-5, 1e-5)
+                    qkvg = qkvg_l(h, torch.bfloat16)
+                    fab = fab_method.apply(fab_layer, h)
+                    mixed_qkv = qkvg[:, :C]
+                    g2 = qkvg[:, C:].view(M, H, D)
+                    f_a, raw_beta = fab[:, :128], fab[:, 128:]
+                    raw_g = F.linear(f_a, f_b_w).view(M, H, D)
+                    if mode == "glue":
+                        glue.fused_kda_decode(
+                            mixed_qkv, cs_buf, conv_w, None, raw_g, raw_beta, a_log, dt_bias,
+                            g2, o_norm_w, rs_buf, sidx, -5.0, 1e-5, out_kda[0],
+                        )
+                    else:
+                        if mode == "fp32conv":
+                            post_qkv = _fp32_conv1d_silu_update(mixed_qkv, cs_buf, conv_w, sidx)
+                        else:
+                            post_qkv = causal_conv1d_update(
+                                mixed_qkv, cs_buf, conv_w, None, activation="silu",
+                                conv_state_indices=sidx, validate_data=True, out=conv_tmp,
+                            )
+                        fused_recurrent_kda_packed_decode(
+                            mixed_qkv=post_qkv, raw_g=raw_g.unsqueeze(0), raw_beta=raw_beta.unsqueeze(0),
+                            A_log=a_log, dt_bias=dt_bias, lower_bound=-5.0,
+                            initial_state=rs_buf, state_indices=sidx, out=out_kda,
+                        )
+                        out_kda.copy_(o_norm_mod(out_kda, g2))
+                    attn_out = o_l(out_kda[0].reshape(M, H * D), torch.bfloat16)
+                    h_moe = ar_mod.attn_res(pref_buf, attn_out, blk_buf, ar_mlp_nw, ar_mlp_qk, post_ln, 1, -1, 1e-5, 1e-5)
+                    logits = F.linear(h_moe, gate_w).float()
+                    tw, ti = gtr.grouped_topk(
+                        h_moe, logits, topk=16, renormalize=True,
+                        num_expert_group=1, topk_group=1, scoring_func="sigmoid",
+                        routed_scaling_factor=1.0, e_score_correction_bias=gate_b,
+                    )
+                    z = r_down_l(h_moe, torch.bfloat16)
+                    routed_lat = torch.empty_like(z)
+                    vq_launcher(z, ti.to(torch.int64), tw, expert_map, routed_lat, vq_ws)
+                    routed_up = r_up_l(_rmsnorm(routed_lat, r_norm_w), torch.bfloat16)
+                    sh_out = sh_down_l(_situ_and_mul(sh_gu_l(h_moe, torch.bfloat16)), torch.bfloat16)
+                    # Also exercise delta2 fold into next consumer AttnRes (output norm).
+                    if mode == "glue":
+                        return ar_mod.attn_res(
+                            pref_buf, routed_up, blk_buf, ar_attn_nw, ar_attn_qk, None, 1, -1, 1e-5, 0.0,
+                            delta2=sh_out,
+                        )
+                    combined = routed_up + sh_out
+                    return ar_mod.attn_res(
+                        pref_buf, combined, blk_buf, ar_attn_nw, ar_attn_qk, None, 1, -1, 1e-5, 0.0,
+                    )
+
+                return step
+
+            with _glue_switches():
+                out_off_fp32 = make_step("fp32conv", cs0.clone(), rs0.clone())()
+                out_off_tri = make_step("triton", cs0.clone(), rs0.clone())()
+            with _glue_switches(VLLM_K31_GLUE_ALL=1):
+                out_on = make_step("glue", cs0.clone(), rs0.clone())()
+
+            rel = _rel_l2(out_on, out_off_fp32)
+            rel_tri = _rel_l2(out_on, out_off_tri)
