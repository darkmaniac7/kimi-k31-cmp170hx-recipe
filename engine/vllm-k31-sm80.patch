+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Routed experts of a Kimi K3.1 k31q checkpoint.
+
+One :class:`K31Experts` module per MoE layer owns every routed-expert tensor
+of that layer on this rank (no module per expert: 896 experts times three
+projections would be 2,688 modules per layer). The method is chosen per layer
+from the manifest by ``K31QConfig.get_quant_method(RoutedExperts)``:
+
+  ``K31VqMoEMethod``    VQ codebook experts, by VLLM_K31Q_VQ_BACKEND (fixed
+        when the model is built).
+        ``native`` (default): the ops of ``vllm/_k31_vq_C``
+        (vllm/sm80/kernels/k31q/vq_ops.py): ``moe_out_vq`` for launches of 1
+        to 64 rows, ``moe_out_prefill_vq`` for up to 2,048. The device holds
+        only what the ops read: per projection the packed indices and scales
+        that ``vq_pack`` makes of this rank's canonical records, one shared
+        copy of each codebook per process, and the ``packed_ptrs`` [experts,
+        9] and ``packed_meta`` [experts, 12] tables. The canonical records
+        are never parameters: K31Experts.load reads one projection to the
+        host, moves it to the device, packs it and drops it before the next.
+        ``reference``: torch, keeps the canonical records, dequantizes the
+        routed experts by the format's definition (codec.vq_unpack) and runs
+        dense FP32 math, on any device; the oracle for the native ops.
+  ``K31Exl3MoEMethod``  EXL3 experts through ``ops.moe_out_k31`` (1 to 64
+        rows at top-k 16) and ``ops.moe_out_prefill_k31`` (above), with the
+        pointer and meta tables of the fork's EXL3 MoE.
+Both run MoE calls of more than VLLM_K31Q_MOE_CHUNK_ROWS rows (when set) as
+several launches and size their workspace for one launch.
+
+Tensor parallelism without expert parallelism: every rank holds every expert,
+cut at whole 128 blocks of the intermediate; rank r of layer L holds chunk
+(r + L) mod TP (vllm.sm80.kernels.exl3.utils.block_shard, the fork's rule).
+w1 and w3 keep the chunk's outputs, w2 its inputs, and the MoE's all-reduce
+sums the ranks' partial outputs. The K3.1 EXL3 kernels take one (hidden,
+intermediate) shape, :data:`K31_KERNEL_SHAPE`; a rank that holds a multiple
+of that intermediate (tensor parallel size 1 holds two) loads it as that many
+parts and adds the parts' outputs, which is what the all-reduce would do.
+"""
+
+import hashlib
+import math
+import os
+
+import torch
+from torch import nn
+
+from vllm import envs
+from vllm.logger import init_logger
+from vllm.model_executor.layers.fused_moe import modular_kernel as mk
+from vllm.model_executor.layers.fused_moe.activation import MoEActivation
+from vllm.model_executor.layers.fused_moe.config import FusedMoEQuantConfig
+from vllm.model_executor.layers.fused_moe.fused_moe_method_base import (
+    FusedMoEMethodBase,
+)
+from vllm.sm80.kernels.exl3.utils import block_shard
+from vllm.sm80.kernels.k31q.codec import BLOCK, IN_LATENT, VqGeometry, vq_unpack
+from vllm.sm80.kernels.k31q.manifest import (
+    CODEBOOK_PREFIX,
+    EXL3,
+    PROJECTIONS,
+    VQ,
+    ExpertProjection,
+    read_rows,
+)
+
+logger = init_logger(__name__)
+
+# (routed expert hidden, per-part intermediate) of moe_out_k31 and
+# moe_out_prefill_k31 (ops.MOE_K31_CONFIG), their matrix bitrates and the
+# most (row, expert) assignments one decode launch takes.
+K31_KERNEL_SHAPE = (3584, 1536)
+K31_KERNEL_BITS_X2 = (2, 4, 6)
+K31_KERNEL_CODEBOOK = 2
+K31_MAX_ASSIGNMENTS = 1024
+# Views of the EXL3 expert buffers start at multiples of this many bytes
+# (vllm.sm80.kernels.exl3.quant.EXPERT_VIEW_ALIGN_BYTES); the kernels need
+# 16-byte aligned trellises.
+VIEW_ALIGN_BYTES = 512
+VQ_BACKENDS = ("native", "reference")
+# The native VQ ops (csrc/k31_vq): moe_out_vq takes 1 to 64 rows per launch,
+# moe_out_prefill_vq up to 2,048; scales come in groups of 128 inputs.
+VQ_DECODE_MAX_ROWS = 64
+VQ_PREFILL_MAX_ROWS = 2048
+VQ_GROUP_SIZE = 128
+# K31Experts.dequant refuses to stack more than this many bytes of FP32
+# matrices (all 896 real experts of one projection are about 20 GiB).
+DEQUANT_LIMIT_BYTES = 1 << 30
+
+
+def situ_and_mul(
+    gate: torch.Tensor, up: torch.Tensor, beta: float, linear_beta: float | None
+) -> torch.Tensor:
+    """SituAndMul of Kimi K3 (vllm.model_executor.layers.activation.SituAndMul):
+    beta * tanh(gate / beta) * sigmoid(gate) times the up branch, softly
+    clipped to linear_beta * tanh(up / linear_beta) when linear_beta is set."""
+    gate = beta * torch.tanh(gate / beta) * torch.sigmoid(gate)
+    if linear_beta is not None:
+        up = linear_beta * torch.tanh(up / linear_beta)
+    return gate * up
+
+
+def expert_tp_closed_reason(parallel) -> str | None:
+    """Why the routed experts cannot be split across the tensor-parallel
+    ranks of ``parallel``, or None."""
+    if (
+        parallel.use_ep
+        or parallel.dp_size != 1
+        or parallel.pcp_size != 1
+        or parallel.is_sequence_parallel
+        or parallel.enable_eplb
+        or parallel.use_all2all_kernels
+    ):
+        return (
+            "k31q routed experts support tensor parallelism only: no expert, "
+            "data, context or sequence parallelism, EPLB or all-to-all dispatch"
+        )
+    return None
+
+
+def expert_split(moe, layer_index: int) -> tuple[int, slice]:
+    """(whole intermediate, this rank's columns) of every routed expert of
+    decoder layer ``layer_index``: whole 128 blocks, chunk (rank + layer) mod
+    the tensor parallel size."""
+    parallel = moe.moe_parallel_config
+    reason = expert_tp_closed_reason(parallel)
+    if reason is not None:
+        raise ValueError(reason)
+    unpadded_per_part = getattr(moe, "intermediate_size_per_partition_unpadded", None)
+    intermediate = (
+        unpadded_per_part * parallel.tp_size
+        if unpadded_per_part is not None
+        else moe.intermediate_size
+    )
+    if intermediate % BLOCK:
+        raise ValueError(f"k31q expert intermediate {intermediate} is not whole blocks")
+    columns = block_shard(
+        intermediate, intermediate, parallel.tp_rank, parallel.tp_size, layer_index
+    )
+    return intermediate, columns
+
+
+def _aligned(count: int, itemsize: int) -> int:
+    step = VIEW_ALIGN_BYTES // itemsize
+    return -(-count // step) * step
+
+
+def vq_backend() -> str:
+    """VLLM_K31Q_VQ_BACKEND, checked."""
+    backend = envs.VLLM_K31Q_VQ_BACKEND
+    if backend not in VQ_BACKENDS:
+        raise ValueError(
+            f"VLLM_K31Q_VQ_BACKEND must be one of {VQ_BACKENDS}, not {backend!r}"
+        )
+    return backend
+
+
+def moe_launch_rows(max_rows: int, limit: int | None = None) -> int:
+    """Most rows one launch takes for MoE calls of up to ``max_rows`` rows:
+    the operator's own ``limit`` and VLLM_K31Q_MOE_CHUNK_ROWS when it is set
+    (larger calls then run as several launches)."""
+    chunk_rows = envs.VLLM_K31Q_MOE_CHUNK_ROWS
+    if chunk_rows < 0:
+        raise ValueError(
+            f"VLLM_K31Q_MOE_CHUNK_ROWS must be 0 or positive, not {chunk_rows}"
+        )
+    rows = max_rows if limit is None else min(max_rows, limit)
+    return min(rows, chunk_rows) if chunk_rows else rows
+
+
+def vq_pack_experts(experts: int) -> int:
+    """Experts one vq_pack call takes at load (VLLM_K31Q_VQ_PACK_EXPERTS;
+    0: the whole projection)."""
+    step = envs.VLLM_K31Q_VQ_PACK_EXPERTS
+    if step < 0:
+        raise ValueError(f"VLLM_K31Q_VQ_PACK_EXPERTS must be 0 or positive, not {step}")
+    return min(step, experts) if step else experts
+
+
+def moe_max_topk() -> int:
+    """VLLM_K31Q_MOE_MAX_TOPK: cap routed experts per row (0 = disabled)."""
+    name = "VLLM_K31Q_MOE_MAX_TOPK"
+    env_dict = vars(envs)
+    if name in env_dict and env_dict[name] is not None:
+        val = int(env_dict[name])
+    elif name in os.environ and os.environ[name].strip() != "":
+        val = int(os.environ[name].strip())
+    else:
+        raw = getattr(envs, name, None)
+        val = 0 if raw is None else int(raw)
+    if val < 0:
+        raise ValueError(f"{name} must be >= 0, got {val}")
+    return val
+
+
+def moe_rel_thresh() -> float:
+    """VLLM_K31Q_MOE_REL_THRESH: drop experts below thresh * row_max_w (0.0 = disabled)."""
+    name = "VLLM_K31Q_MOE_REL_THRESH"
+    env_dict = vars(envs)
+    if name in env_dict and env_dict[name] is not None:
+        val = float(env_dict[name])
+    elif name in os.environ and os.environ[name].strip() != "":
+        val = float(os.environ[name].strip())
+    else:
+        raw = getattr(envs, name, None)
+        val = 0.0 if raw is None else float(raw)
+    if val < 0.0:
+        raise ValueError(f"{name} must be >= 0.0, got {val}")
+    return val
+
+
+def prune_moe_topk(
+    topk_weights: torch.Tensor,
+    topk_ids: torch.Tensor,
+    max_topk: int,
+    rel_thresh: float,
+    *,
+    renormalize: bool = True,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """CUDA-Graph-safe single-launch adaptive MoE tail-expert pruning.
+
+    Ranks each row's top-k slots by ``topk_weights`` (tie-broken by smaller
+    column index), keeps at most ``max_topk`` (when > 0) and drops slots with
+    ``w < rel_thresh * row_max_w`` while always keeping at least 4 valid slots
+    (or ``min(max_topk, 4)`` when ``max_topk < 4``). Dropped slots get
+    ``topk_ids = -1`` and ``topk_weights = 0.0``; kept weights are rescaled by
+    ``orig_sum / kept_sum`` when ``renormalize`` is True and at least one valid
+    slot was dropped.
+    """
+    if topk_weights.dim() != 2 or topk_ids.dim() != 2:
+        raise ValueError(
+            f"prune_moe_topk expects 2D [rows, K] tensors, got "
+            f"weights={tuple(topk_weights.shape)} ids={tuple(topk_ids.shape)}"
+        )
+    rows, K = topk_weights.shape
+    if rows == 0 or K == 0:
+        return topk_weights, topk_ids
+    if (max_topk <= 0 or max_topk >= K) and rel_thresh <= 0.0:
+        return topk_weights, topk_ids
+
+    from vllm.sm80.kernels.k31q import glue as k31_glue
+
+    if k31_glue.can_use_moe_prune_topk(topk_weights, topk_ids):
+        return k31_glue.moe_prune_topk(
+            topk_weights, topk_ids, int(max_topk), float(rel_thresh), bool(renormalize)
+        )
+
+    valid = topk_ids >= 0
+    w = torch.where(valid, topk_weights, torch.zeros_like(topk_weights))
+    orig_sum = w.sum(dim=-1, keepdim=True)
+    row_max = torch.where(
+        valid, topk_weights, torch.full_like(topk_weights, float("-inf"))
+    ).amax(dim=-1, keepdim=True)
+
+    col_idx = torch.arange(K, device=w.device).unsqueeze(0)
+    w_i = w.unsqueeze(2)
+    w_j = w.unsqueeze(1)
+    v_i = valid.unsqueeze(2)
+    v_j = valid.unsqueeze(1)
+    tie_j_before_i = col_idx.unsqueeze(1) < col_idx.unsqueeze(2)
+    better = v_j & ((~v_i) | (w_j > w_i) | ((w_j == w_i) & tie_j_before_i))
+    rank = better.sum(dim=-1)
+
+    k_cap = max_topk if (0 < max_topk < K) else K
+    min_keep = min(k_cap, 4)
+    keep = valid & (rank < k_cap)
+    if rel_thresh > 0.0:
+        keep = keep & ((rank < min_keep) | (w >= float(rel_thresh) * row_max))
+
+    any_dropped = (valid & ~keep).any(dim=-1, keepdim=True)
+    kept_w = torch.where(keep, w, torch.zeros_like(w))
+    kept_sum = kept_w.sum(dim=-1, keepdim=True)
+    if renormalize:
+        scale = torch.where(
+            kept_sum > 0.0,
+            orig_sum / torch.where(kept_sum > 0.0, kept_sum, torch.ones_like(kept_sum)),
+            torch.ones_like(kept_sum),
+        )
+        renorm_w = kept_w * scale
+    else:
+        renorm_w = kept_w
+
+    out_weights = torch.where(any_dropped, renorm_w, w)
+    out_ids = torch.where(keep, topk_ids, torch.full_like(topk_ids, -1))
+    return out_weights, out_ids
+
+
+def maybe_prune_moe_topk(
+    topk_weights: torch.Tensor,
+    topk_ids: torch.Tensor,
+    *,
+    renormalize: bool = True,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Apply switch-gated tail-expert pruning; zero-overhead no-op when off."""
+    max_topk = moe_max_topk()
+    rel_thresh = moe_rel_thresh()
+    if max_topk <= 0 and rel_thresh <= 0.0:
+        return topk_weights, topk_ids
+    return prune_moe_topk(
+        topk_weights, topk_ids, max_topk, rel_thresh, renormalize=renormalize
+    )
+
+
+def _device_copy(tensor: torch.Tensor, device) -> torch.Tensor:
+    """The one place canonical VQ data (records, scales, codebooks) reaches
+    the device. Tests account for every tensor it returns."""
+    return tensor.to(device)
+
+
+# One device copy of each codebook per process: (device, codebook tensor
+# name, sha256 of its bytes) -> F16 [entries, dim]. A layer keeps a
+# reference and its pointer table the address; a second checkpoint with other
+# bytes under the same name gets its own copy.
+_VQ_CODEBOOKS: dict[tuple[str, str, bytes], torch.Tensor] = {}
+
+
+def device_codebook(header, device) -> tuple[torch.Tensor, int]:
+    """The process-wide device copy of the codebook ``header`` names, and the
+    bytes read from the file for it."""
+    book, count = read_rows(header)
+    key = (str(device), header.name, hashlib.sha256(book.numpy().tobytes()).digest())
+    held = _VQ_CODEBOOKS.get(key)
+    if held is None:
+        held = _VQ_CODEBOOKS[key] = _device_copy(book, device).contiguous()
+    return held, count
+
+
+class K31Experts(nn.Module):
+    """Every routed-expert tensor of one MoE layer that this rank holds.
+
+    VQ layers, reference backend (``vq_native`` None): per projection the
+    parameters ``<w>_idx`` U8 [experts, blocks, record bytes], ``<w>_scale``
+    F16 [experts, blocks, scales] (the canonical records of this rank's
+    I-blocks) and ``<w>_codebook`` F16 [entries, dim].
+    VQ layers, native backend (``vq_native``: the ops module): no canonical
+    tensor is ever registered. Per projection the buffers ``<w>_packed_idx``
+    and ``<w>_packed_scale`` that ``vq_pack`` returns, the tables
+    ``packed_ptrs`` int64 [experts, 9] and ``packed_meta`` int64 [experts,
+    12] the ops read, and in ``vq_codebooks`` a reference to the process's
+    one device copy of each codebook. :meth:`load` packs projection by
+    projection: at most one projection's canonical records are on the device
+    at a time, beside what is already packed.
+    EXL3 layers: one buffer per tensor kind (``trellis`` I16, ``suh`` and
+    ``svh`` F16) holding every (part, expert, projection) matrix as a
+    contiguous view; :meth:`exl3_tables` gives their addresses.
+    """
+
+    def __init__(
+        self,
+        prefix: str,
+        layer_index: int,
+        projections: dict[str, ExpertProjection],
+        experts: int,
+        latent: int,
+        intermediate: int,
+        columns: slice,
+        part_width: int | None = None,
+        vq_native=None,
+    ):
+        super().__init__()
+        methods = {projections[name].method for name in PROJECTIONS}
+        if len(methods) != 1:
+            raise ValueError(f"k31q {prefix}: one expert method per layer")
+        (self.method,) = methods
+        self.prefix = prefix
+        self.layer_index = layer_index
+        self.projections = dict(projections)
+        self.experts = experts
+        self.latent = latent
+        self.intermediate = intermediate
+        if (
+            columns.start % BLOCK
+            or columns.stop % BLOCK
+            or not 0 <= columns.start < columns.stop <= intermediate
+        ):
+            raise ValueError(f"k31q {prefix}: expert columns must be whole 128 blocks")
+        self.columns = columns
+        self.blocks = slice(columns.start // BLOCK, columns.stop // BLOCK)
+        self.local_intermediate = columns.stop - columns.start
+        for projection in self.projections.values():
+            projection.validate(experts, latent, intermediate)
+        self.loaded = False
+        # Bytes read from the layer file for this rank's experts, and from
+        # the codebook file (each projection reads its codebook).
+        self.bytes_read = 0
+        self.codebook_bytes = 0
+        self.vq_native = None
+        self.part_width = part_width
+        # Column ranges of the parts one kernel call takes each.
+        width = self.local_intermediate
+        if part_width and width % part_width == 0:
+            width = part_width
+        self.parts = [
+            slice(start, start + width)
+            for start in range(columns.start, columns.stop, width)
+        ]
+        part_cols = self.parts[0].stop - self.parts[0].start
+        # TP=4 EXL3 readiness: when local_intermediate < part_width (e.g. 768 < 1536)
+        # on a matching latent shape, zero-pad each part buffer to part_width.
+        if (
+            self.method == EXL3
+            and part_width is not None
+            and part_cols < part_width
+            and part_width % BLOCK == 0
+            and self.latent == K31_KERNEL_SHAPE[0]
+        ):
+            self.padded_part_intermediate = part_width
+        else:
+            self.padded_part_intermediate = part_cols
+        if self.method == VQ:
+            self.geometry: dict[str, VqGeometry] = {
+                name: self.projections[name].geometry(self.latent)
+                for name in PROJECTIONS
+            }
+            if vq_native is None:
+                self._create_vq_reference()
+            else:
+                self._create_vq_native(vq_native)
+        else:
+            self._create_exl3()
+
+    # -- VQ, reference backend -------------------------------------------------
+
+    def _create_vq_reference(self) -> None:
+        blocks = self.blocks.stop - self.blocks.start
+        for name in PROJECTIONS:
+            geometry = self.geometry[name]
+            for suffix, dtype, last in (
+                ("idx", torch.uint8, geometry.record_bytes),
+                ("scale", torch.float16, geometry.record_scales),
+            ):
+                self.register_parameter(
+                    f"{name}_{suffix}",
+                    nn.Parameter(
+                        torch.empty((self.experts, blocks, last), dtype=dtype),
+                        requires_grad=False,
+                    ),
+                )
+            self.register_parameter(
+                f"{name}_codebook",
+                nn.Parameter(
+                    torch.empty(
+                        (1 << geometry.index_bits, geometry.dim), dtype=torch.float16
+                    ),
+                    requires_grad=False,
+                ),
+            )
+
+    def _load_vq_reference(self, manifest, ledger) -> None:
+        for name in PROJECTIONS:
+            projection = self.projections[name]
+            for suffix, header in (
+                ("idx", projection.idx),
+                ("scale", projection.scale),
+            ):
+                # Only this rank's I-blocks: one byte range per expert.
+                data, count = read_rows(header, inner=self.blocks)
+                getattr(self, f"{name}_{suffix}").data.copy_(data)
+                self.bytes_read += count
+                ledger.mark(header.name, "consumed", self.prefix)
+            book, count = read_rows(manifest.codebooks[projection.codebook])
+            getattr(self, f"{name}_codebook").data.copy_(book)
+            self.codebook_bytes += count
+
+    # -- VQ, native backend ------------------------------------------------------
+
+    def vq_native_closed_reason(self, native) -> str | None:
+        """Why the native VQ ops cannot serve this layer, or None."""
+        if self.latent % BLOCK:
+            return f"the routed expert hidden size {self.latent} is not whole blocks"
+        for name in PROJECTIONS:
+            geometry = self.geometry[name]
+            if geometry.group_size != VQ_GROUP_SIZE:
+                return (
+                    f"{name} has scale groups of {geometry.group_size} inputs, "
+                    f"the native VQ ops take {VQ_GROUP_SIZE}"
+                )
+            if native.vq_rate_id(geometry.dim, geometry.index_bits) < 0:
+                return (
+                    f"{name} is stored with vectors of {geometry.dim} and "
+                    f"{geometry.index_bits} index bits, a rate the native VQ ops "
+                    "do not have"
+                )
+        return None
+
+    def _create_vq_native(self, native) -> None:
+        reason = self.vq_native_closed_reason(native)
+        if reason is not None:
+            raise ValueError(
+                f"k31q VQ routed experts of {self.prefix}: {reason}. "
+                "VLLM_K31Q_VQ_BACKEND=reference serves any rate (an oracle, not "
+                "a serving path)."
+            )
+        self.vq_native = native
+        self.vq_codebooks: dict[str, torch.Tensor] = {}
+        # The tables are created with the module, on its device; the meta
+        # rows are static, the pointers are filled when the experts load.
+        metadata = []
+        for name in PROJECTIONS:
+            geometry = self.geometry[name]
+            out_f, in_f = geometry.matrix_shape(self.local_intermediate // BLOCK)
+            metadata += [in_f, out_f, geometry.dim, geometry.index_bits]
+        self.register_buffer(
+            "packed_ptrs",
+            torch.zeros((self.experts, 3 * len(PROJECTIONS)), dtype=torch.int64),
+            persistent=False,
+        )
+        self.register_buffer(
+            "packed_meta",
+            torch.tensor(metadata, dtype=torch.int64).repeat(self.experts, 1),
+            persistent=False,
+        )
+
+    def _pack(self, idx, scale, codebook, geometry: VqGeometry, device):
+        """One projection's canonical host records -> the packed device
+        tensors. The records are on the device only inside this call: whole
+        (the default) or VLLM_K31Q_VQ_PACK_EXPERTS experts at a time, each
+        part packed and copied into the preallocated result."""
+        native = self.vq_native
+        arguments = (
+            0 if geometry.role == IN_LATENT else 1,
+            self.latent,
+            geometry.dim,
+            geometry.index_bits,
+            geometry.group_size,
+        )
+        step = vq_pack_experts(self.experts)
+        if step >= self.experts:
+            records = (_device_copy(idx, device), _device_copy(scale, device))
+            packed = native.vq_pack(*records, codebook, *arguments)
+            del records
+            return packed
+        packed_idx = packed_scale = None
+        for start in range(0, self.experts, step):
+            stop = min(start + step, self.experts)
+            records = (
+                _device_copy(idx[start:stop], device),
+                _device_copy(scale[start:stop], device),
+            )
+            part_idx, part_scale = native.vq_pack(*records, codebook, *arguments)
+            del records
+            if packed_idx is None:
+                packed_idx = part_idx.new_empty((self.experts, *part_idx.shape[1:]))
+                packed_scale = part_scale.new_empty(
+                    (self.experts, *part_scale.shape[1:])
+                )
+            packed_idx[start:stop].copy_(part_idx)
+            packed_scale[start:stop].copy_(part_scale)
+            del part_idx, part_scale
+        return packed_idx, packed_scale
+
+    def _check_packed(self, name: str, packed_idx, packed_scale) -> None:
+        """The packed tensors as the ops' interface describes them: int32
+        [experts, out / 16, in / 128, words, 32] and F16 [experts, out / 16,
+        in / 128, 16], contiguous and 16-byte aligned."""
+        geometry = self.geometry[name]
+        out_f, in_f = geometry.matrix_shape(self.local_intermediate // BLOCK)
+        lead = (self.experts, out_f // 16, in_f // BLOCK)
+        if (
+            packed_idx.dtype != torch.int32
+            or packed_idx.dim() != 5
+            or tuple(packed_idx.shape[:3]) != lead
+            or packed_idx.shape[4] != 32
+            or packed_scale.dtype != torch.float16
+            or tuple(packed_scale.shape) != (*lead, 16)
+            or not packed_idx.is_contiguous()
+            or not packed_scale.is_contiguous()
+            or packed_idx.data_ptr() % 16
+            or packed_scale.data_ptr() % 16
+        ):
+            raise ValueError(
+                f"k31q {self.prefix} {name}: vq_pack returned "
+                f"{packed_idx.dtype} {tuple(packed_idx.shape)} and "
+                f"{packed_scale.dtype} {tuple(packed_scale.shape)}, not the "
+                f"packed layout of a [{out_f}, {in_f}] matrix per expert"
+            )
+
+    def _load_vq_native(self, manifest, ledger) -> None:
+        device = self.packed_ptrs.device
+        pointers = torch.empty(tuple(self.packed_ptrs.shape), dtype=torch.int64)
+        experts = torch.arange(self.experts, dtype=torch.int64)
+        for slot, name in enumerate(PROJECTIONS):
+            projection = self.projections[name]
+            codebook, count = device_codebook(
+                manifest.codebooks[projection.codebook], device
+            )
+            self.codebook_bytes += count
+            # Only this rank's I-blocks, on the host: one byte range per expert.
+            idx, idx_bytes = read_rows(projection.idx, inner=self.blocks)
+            scale, scale_bytes = read_rows(projection.scale, inner=self.blocks)
+            packed_idx, packed_scale = self._pack(
+                idx, scale, codebook, self.geometry[name], device
+            )
+            # Nothing canonical outlives its projection, on either side.
+            del idx, scale
+            self._check_packed(name, packed_idx, packed_scale)
+            self.register_buffer(f"{name}_packed_idx", packed_idx, persistent=False)
+            self.register_buffer(f"{name}_packed_scale", packed_scale, persistent=False)
+            self.vq_codebooks[name] = codebook
+            # packed_ptrs[e, 3 q + 0 / 1 / 2]: expert e's packed indices, its
+            # packed scales, the codebook (q: 0 = w1, 1 = w3, 2 = w2).
+            for kind, packed in enumerate((packed_idx, packed_scale)):
+                stride = packed[0].numel() * packed.element_size()
+                pointers[:, 3 * slot + kind] = packed.data_ptr() + experts * stride
+            pointers[:, 3 * slot + 2] = codebook.data_ptr()
+            self.bytes_read += idx_bytes + scale_bytes
+            ledger.mark(projection.idx.name, "consumed", self.prefix)
+            ledger.mark(projection.scale.name, "consumed", self.prefix)
+        self.packed_ptrs.copy_(pointers)
+
+    def vq_rate_ids(self) -> tuple[int, int]:
+        """(rate_id_gu, rate_id_dn) of the native ops: the layer's static
+        rates from the manifest, so each launch runs one kernel. Gate and up
+        share one id; when w1 and w3 differ in rate it is -1 and the ops read
+        the rates from packed_meta on the device."""
+        ids = {
+            name: self.vq_native.vq_rate_id(geometry.dim, geometry.index_bits)
+            for name, geometry in self.geometry.items()
+        }
+        return (ids["w1"] if ids["w1"] == ids["w3"] else -1), ids["w2"]
+
+    def packed_dequant(self, name: str, expert: int) -> torch.Tensor:
+        """FP32 matrix of one expert's projection decoded from the packed
+        buffers by the native reference op (``vq_dequant_reference``): what
+        the kernels read, to compare with :func:`codec.vq_unpack` of the
+        canonical records."""
+        if self.vq_native is None:
+            raise ValueError(f"k31q {self.prefix}: no packed buffers (reference)")
+        geometry = self.geometry[name]
+        out_f, in_f = geometry.matrix_shape(self.local_intermediate // BLOCK)
+        return self.vq_native.vq_dequant_reference(
+            getattr(self, f"{name}_packed_idx")[expert : expert + 1],
+            getattr(self, f"{name}_packed_scale")[expert : expert + 1],
+            self.vq_codebooks[name],
+            out_f,
+            in_f,
+            geometry.dim,
+            geometry.index_bits,
+            geometry.group_size,
+        )[0]
+
+    @property
+    def codebook_keys(self) -> set[str]:
+        """Checkpoint codebook tensors this layer reads (shared by layers, so
+        the loader marks them, once)."""
+        if self.method != VQ:
+            return set()
+        return {
+            f"{CODEBOOK_PREFIX}{self.projections[name].codebook}"
+            for name in PROJECTIONS
+        }
+
+    def dequant(self, name: str, expert: int | None = None) -> torch.Tensor:
+        """FP32 matrix of projection ``name`` (w1, w3: [local intermediate,
+        latent]; w2: [latent, local intermediate]) of one expert, by the
+        canonical definition, from the records the reference backend keeps.
+        Without ``expert`` every expert is stacked on a leading dimension,
+        which is refused above DEQUANT_LIMIT_BYTES (tiny models only: the 896
+        real experts of one projection are about 20 GiB)."""
+        if self.method != VQ or self.vq_native is not None:
+            raise ValueError(
+                f"k31q {self.prefix}: dequant reads the canonical VQ records, "
+                "which only the reference backend keeps"
+            )
+        geometry = self.geometry[name]
+        idx = getattr(self, f"{name}_idx")
+        scale = getattr(self, f"{name}_scale")
+        if expert is not None:
+            idx, scale = idx[expert], scale[expert]
+        else:
+            out_f, in_f = geometry.matrix_shape(self.local_intermediate // BLOCK)
+            size = 4 * self.experts * out_f * in_f
+            if size > DEQUANT_LIMIT_BYTES:
+                raise ValueError(
+                    f"k31q {self.prefix}: all {self.experts} {name} matrices are "
+                    f"{size / 2**30:.1f} GiB in FP32; pass an expert"
+                )
+        return vq_unpack(idx, scale, getattr(self, f"{name}_codebook"), geometry)
+
+    # -- EXL3 ----------------------------------------------------------------
+
+    def _create_exl3(self) -> None:
+        # (part, expert, projection) -> matrix, input slice, output slice and
+        # the element offsets of its trellis, suh and svh views.
+        self.entries = []
+        totals = [0, 0, 0]
+        pad_inter = self.padded_part_intermediate
+        is_zero_padded = pad_inter > (self.parts[0].stop - self.parts[0].start)
+        for part in self.parts:
+            for expert in range(self.experts):
+                for name in PROJECTIONS:
+                    projection = self.projections[name]
+                    matrix = projection.matrices[expert]
+                    whole_in = slice(0, matrix.padded_in)
+                    whole_out = slice(0, matrix.padded_out)
+                    if projection.role == IN_LATENT:
+                        rows, cols = whole_in, part  # every input, the part's outputs
+                        alloc_k, alloc_n = rows.stop - rows.start, pad_inter
+                    else:
+                        rows, cols = part, whole_out  # the part's inputs, every output
+                        alloc_k, alloc_n = pad_inter, cols.stop - cols.start
+                    shapes = (
+                        (alloc_k // 16, alloc_n // 16, 8 * matrix.bits_x2),
+                        (alloc_k,),
+                        (alloc_n,),
+                    )
+                    offsets = tuple(totals)
+                    for kind, shape in enumerate(shapes):
+                        totals[kind] += _aligned(math.prod(shape), 2)
+                    self.entries.append((matrix, rows, cols, shapes, offsets))
+        alloc_fn = torch.zeros if is_zero_padded else torch.empty
+        for kind, (attr, dtype) in enumerate(
+            (("trellis", torch.int16), ("suh", torch.float16), ("svh", torch.float16))
+        ):
+            self.register_parameter(
+                attr,
+                nn.Parameter(
+                    alloc_fn(totals[kind], dtype=dtype), requires_grad=False
+                ),
+            )
+
+    def _view(self, kind: int, entry) -> torch.Tensor:
+        _, _, _, shapes, offsets = entry
+        buffer = (self.trellis, self.suh, self.svh)[kind]
+        count = math.prod(shapes[kind])
+        return buffer.data[offsets[kind] : offsets[kind] + count].view(shapes[kind])
+
+    def _load_exl3(self, files, ledger) -> None:
+        manifest = ledger.manifest
+        marked = set()
+        for entry in self.entries:
+            matrix, rows, cols, _, _ = entry
+            header = manifest.tensors[f"{matrix.prefix}.trellis"]
+            packed = files[header.path].get_slice(header.name)
+            block = packed[
+                rows.start // 16 : rows.stop // 16,
+                cols.start // 16 : cols.stop // 16,
+                :,
+            ]
+            self._view(0, entry)[: block.shape[0], : block.shape[1], :].copy_(block)
+            self.bytes_read += block.numel() * 2
+            for kind, suffix, part in ((1, "suh", rows), (2, "svh", cols)):
+                header = manifest.tensors[f"{matrix.prefix}.{suffix}"]
+                data = files[header.path].get_slice(header.name)[part]
+                self._view(kind, entry)[: data.shape[0]].copy_(data)
+                self.bytes_read += data.numel() * 2
+            if matrix.prefix not in marked:
+                # A matrix read as several parts is one source.
+                marked.add(matrix.prefix)
+                for key in matrix.keys:
+                    ledger.mark(key, "consumed", self.prefix)
+
+    def exl3_tables(self, part: int) -> tuple[torch.Tensor, torch.Tensor]:
+        """Pointer table int64 [experts, 3, 3] (gate, up, down by trellis,
+        suh, svh address) and meta table int64 [experts, 3, 4] (padded in,
+        padded out, bits_x2, codebook) of one part, in the layout
+        moe_out_k31 reads (vllm/sm80/kernels/exl3/quant.py builds the same
+        for moe_out). Addresses are those of the buffers where they are now:
+        build the tables after the model is on its device."""
+        if self.method != EXL3:
+            raise ValueError(f"k31q {self.prefix}: tables are defined for EXL3 experts")
+        bases = (self.trellis.data_ptr(), self.suh.data_ptr(), self.svh.data_ptr())
+        per_part = self.experts * len(PROJECTIONS)
+        entries = self.entries[part * per_part : (part + 1) * per_part]
+        pointers, metadata = [], []
+        for expert in range(self.experts):
+            ptrs, meta = [], []
+            for matrix, _, _, shapes, offsets in entries[3 * expert : 3 * expert + 3]:
+                ptrs.append([base + 2 * offset for base, offset in zip(bases, offsets)])
+                meta.append(
+                    [
+                        shapes[1][0],
+                        shapes[2][0],
+                        matrix.bits_x2,
+                        matrix.codebook,
+                    ]
+                )
+            pointers.append(ptrs)
+            metadata.append(meta)
+        device = self.trellis.device
+        return (
+            torch.tensor(pointers, dtype=torch.int64, device=device),
+            torch.tensor(metadata, dtype=torch.int64, device=device),
+        )
+
+    def exl3_kernel_closed_reason(self) -> str | None:
+        """Why moe_out_k31 must not read these experts, or None."""
+        latent, width = K31_KERNEL_SHAPE
+        part = self.padded_part_intermediate
+        if (self.latent, part) != (latent, width):
+            return (
+                f"the K3.1 EXL3 kernels take (hidden, intermediate) = "
+                f"({latent}, {width}); this rank holds parts of ({self.latent}, {part})"
+            )
+        base = self.trellis.data_ptr()
+        for matrix, _, _, _, offsets in self.entries:
+            if matrix.bits_x2 not in K31_KERNEL_BITS_X2:
+                return f"{matrix.prefix} has bits_x2 {matrix.bits_x2}, not 2, 4 or 6"
+            if matrix.codebook != K31_KERNEL_CODEBOOK:
+                return f"{matrix.prefix} does not use the mul1 codebook"
+            if (base + 2 * offsets[0]) % 16:
+                return f"{matrix.prefix} trellis is not 16-byte aligned"
+        return None
+
+    # -- common --------------------------------------------------------------
+
+    @property
+    def keys(self) -> tuple[str, ...]:
+        return tuple(k for name in PROJECTIONS for k in self.projections[name].keys)
+
+    def load(self, files, ledger) -> None:
+        """Read this rank's share of the layer's routed experts and mark the
+        source tensors in the ledger (codebooks excepted)."""
+        if self.loaded:
+            raise ValueError(f"k31q {self.prefix}: routed experts loaded twice")
+        if self.method != VQ:
+            self._load_exl3(files, ledger)
+        elif self.vq_native is None:
+            self._load_vq_reference(ledger.manifest, ledger)
+        else:
+            self._load_vq_native(ledger.manifest, ledger)
+        self.loaded = True
+
+    def held(self) -> list[torch.Tensor]:
+        """Every tensor this module keeps for its kernels."""
+        tensors = [*self.parameters(), *self.buffers()]
+        if self.vq_native is not None:
+            tensors += self.vq_codebooks.values()
+        return tensors
+
+    @property
+    def device(self) -> torch.device:
+        return self.held()[0].device
+
+    def require_loaded(self, cuda: bool = True) -> None:
+        if not self.loaded:
+            raise ValueError(f"Unloaded k31q routed experts: {self.prefix}")
+        if cuda and not all(tensor.is_cuda for tensor in self.held()):
+            raise ValueError(f"k31q routed experts must be on CUDA: {self.prefix}")
+
+
+class _K31ExpertsKernel(mk.FusedMoEExpertsModular):
+    """Shared traits of the routed-expert kernels: BF16 rows in, weighted
+    and summed BF16 partial out, nothing left to the finalize step."""
+
+    def __init__(self, moe, quant, experts: K31Experts):
+        super().__init__(moe, quant)
+        self.experts = experts
+
+    @staticmethod
+    def activation_format():
+        return mk.FusedMoEActivationFormat.Standard
+
+    @staticmethod
+    def _supports_no_act_and_mul():
+        return False
+
+    @staticmethod
+    def _supports_quant_scheme(weight_key, activation_key):
+        return weight_key is None and activation_key is None
+
+    @staticmethod
+    def _supports_activation(activation):
+        return activation == MoEActivation.SITU
+
+    @staticmethod
+    def _supports_parallel_config(moe_parallel_config):
+        return expert_tp_closed_reason(moe_parallel_config) is None
+
+    def moe_problem_size(self, a1, w1, w2, topk_ids):
+        return (
+            self.experts.experts,
+            a1.shape[0],
+            2 * self.experts.local_intermediate,
+            a1.shape[-1],
+            topk_ids.shape[1],
+        )
+
+    def finalize_weight_and_reduce_impl(self):
+        from vllm.model_executor.layers.fused_moe.topk_weight_and_reduce import (
+            TopKWeightAndReduceNoOP,
+        )
+
+        return TopKWeightAndReduceNoOP()
+
+    @staticmethod
+    def _check_inputs(apply_router_weight_on_input, a1q_scale, a2_scale) -> None:
+        if (
+            apply_router_weight_on_input
+            or a1q_scale is not None
+            or a2_scale is not None
+        ):
+            raise ValueError("k31q MoE takes unquantized, unweighted BF16 inputs")
+
+
+def vq_reference_forward(
+    experts: K31Experts,
+    hidden_states: torch.Tensor,
+    topk_ids: torch.Tensor,
+    topk_weights: torch.Tensor,
+    situ_beta: float,
+    situ_linear_beta: float | None,
+    expert_map: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Torch reference of the VQ routed experts of one rank, on any device,
+    over the canonical records the reference backend keeps; needs no model.
+
+    For every expert the call routes rows to it dequantizes the expert's
+    three matrices (this rank's I-blocks) to FP32 and computes
+        out[row] += weight[row, slot] * W2 @ SituAndMul(W1 @ x[row], W3 @ x[row])
+    in FP32. Expert ids below 0 (masked rows) and ids the expert map sends to
+    -1 are skipped, as the native kernels do. Returns this rank's partial
+    latent output [rows, latent] in FP32."""
+    x = hidden_states.to(torch.float32)
+    ids = topk_ids.to(torch.int64)
+    weights = topk_weights.to(torch.float32)
+    out = torch.zeros_like(x)
+    for expert in torch.unique(ids).tolist():
+        if expert < 0:
+            continue
+        local = expert if expert_map is None else int(expert_map[expert])
+        if local < 0:
+            continue
+        rows, slots = (ids == expert).nonzero(as_tuple=True)
+        w1, w3, w2 = (experts.dequant(name, local) for name in PROJECTIONS)
+        rows_x = x[rows]
+        hidden = situ_and_mul(
+            rows_x @ w1.t(), rows_x @ w3.t(), situ_beta, situ_linear_beta
+        )
+        out.index_add_(0, rows, (hidden @ w2.t()) * weights[rows, slots].unsqueeze(1))
+    return out
+
+
+class K31VqReferenceExperts(_K31ExpertsKernel):
+    """:func:`vq_reference_forward` behind upstream's modular MoE kernel; the
+    FP32 sum is rounded once to the output dtype. Not a serving path: it is
+    the oracle the native VQ ops are compared with.
+    """
+
+    def __init__(
+        self,
+        moe,
+        quant,
+        experts,
+        situ_beta,
+        situ_linear_beta,
+        renormalize: bool | None = None,
+    ):
+        super().__init__(moe, quant, experts)
+        self.situ_beta = float(situ_beta)
+        self.situ_linear_beta = (
+            None if situ_linear_beta is None else float(situ_linear_beta)
+        )
+        self.renormalize = (
+            bool(getattr(moe, "renormalize", True))
+            if renormalize is None
+            else bool(renormalize)
+        )
+
+    @staticmethod
+    def _supports_current_device():
+        return True
+
+    def workspace_shapes(
+        self,
+        M,
+        N,
+        K,
+        topk,
+        global_num_experts,
+        local_num_experts,
+        expert_tokens_meta,
+        activation,
+    ):
+        return (0,), (0,), (M, K)
+
+    def forward_fp32(
+        self,
+        hidden_states: torch.Tensor,
+        topk_ids: torch.Tensor,
+        topk_weights: torch.Tensor,
+        expert_map: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        """This rank's partial latent output [rows, latent] in FP32."""
+        return vq_reference_forward(
+            self.experts,
+            hidden_states,
+            topk_ids,
+            topk_weights,
+            self.situ_beta,
+            self.situ_linear_beta,
+            expert_map,
+        )
+
+    def apply(
+        self,
+        output,
+        hidden_states,
+        w1,
+        w2,
+        topk_weights,
+        topk_ids,
+        activation,
+        global_num_experts,
+        expert_map,
+        a1q_scale,
+        a2_scale,
+        workspace13,
+        workspace2,
+        expert_tokens_meta,
+        apply_router_weight_on_input,
+    ):
+        self._check_inputs(apply_router_weight_on_input, a1q_scale, a2_scale)
+        topk_weights, topk_ids = maybe_prune_moe_topk(
+            topk_weights, topk_ids, renormalize=self.renormalize
+        )
+        result = self.forward_fp32(hidden_states, topk_ids, topk_weights, expert_map)
+        output.copy_(result.to(output.dtype))
+
+
+class K31VqNativeUnavailable(RuntimeError):
+    """The native VQ routed-expert ops are not in this build."""
+
+
+def load_vq_native():
+    """The native VQ ops, loaded and checked: the module
+    vllm/sm80/kernels/k31q/vq_ops.py over the library ``vllm/_k31_vq_C``
+    (``vq_pack``, ``vq_dequant_reference``, ``moe_workspace_size_vq``,
+    ``moe_out_vq``, ``moe_out_prefill_vq``, ``vq_rate_id``). A build without
+    the library stops here, when the first VQ layer is constructed, with the
+    command that builds it."""
+    from vllm.sm80.kernels.k31q import vq_ops
+
+    try:
+        vq_ops.ensure_vq_extension()
+    except RuntimeError as exc:
+        raise K31VqNativeUnavailable(
+            f"k31q VQ routed experts: {exc} Or set VLLM_K31Q_VQ_BACKEND=reference "
+            "for the torch reference path (an oracle, not a serving path)."
+        ) from exc
+    return vq_ops
+
+
+class K31VqLauncher:
+    """The native VQ launches of one layer on one rank; needs no model.
+
+    A call of up to ``launch_rows`` rows is one launch: ``moe_out_vq`` for 1
+    to VQ_DECODE_MAX_ROWS rows, ``moe_out_prefill_vq`` above. ``launch_rows``
+    is the most rows a call can have, capped by the prefill op's
+    VQ_PREFILL_MAX_ROWS and by VLLM_K31Q_MOE_CHUNK_ROWS; a larger call runs
+    as consecutive row chunks (every row is computed from its own input and
+    routes). The workspace is sized once, for one launch of ``launch_rows``
+    rows. Every launch gets the layer's static rate ids, so it runs one
+    kernel per stage. Nothing here reads a tensor's value: the launches are
+    safe inside a CUDA graph.
+    """
+
+    def __init__(
+        self,
+        experts: K31Experts,
+        max_rows: int,
+        top_k: int,
+        situ_beta: float,
+        situ_linear_beta: float,
+        swiglu_limit: float = 0.0,
+    ):
+        native = experts.vq_native
+        if native is None:
+            raise ValueError(f"k31q {experts.prefix}: no packed VQ experts to launch")
+        self.native = native
+        self.pointers = experts.packed_ptrs
+        self.metadata = experts.packed_meta
+        self.intermediate = experts.local_intermediate
+        self.max_rows = max_rows
+        self.launch_rows = moe_launch_rows(max_rows, VQ_PREFILL_MAX_ROWS)
+        self.workspace_elements = native.moe_workspace_size_vq(
+            self.launch_rows,
+            experts.latent,
+            experts.local_intermediate,
+            top_k,
+            experts.experts,
+        )
+        self.rate_gate_up, self.rate_down = experts.vq_rate_ids()
+        self.situ_beta = float(situ_beta)
+        self.situ_linear_beta = float(situ_linear_beta)
+        self.swiglu_limit = float(swiglu_limit)
+        self.renormalize = True
+
+    def __call__(self, x, topk_ids, topk_weights, expert_map, out, workspace) -> None:
+        """``workspace``: FP32, at least ``workspace_elements`` elements."""
+        topk_weights, topk_ids = maybe_prune_moe_topk(
+            topk_weights, topk_ids, renormalize=self.renormalize
+        )
+        native, rows, step = self.native, x.shape[0], self.launch_rows
+        for start in range(0, rows, step):
+            stop = min(start + step, rows)
+            operator = (
+                native.moe_out_vq
+                if stop - start <= VQ_DECODE_MAX_ROWS
+                else native.moe_out_prefill_vq
+            )
+            operator(
+                x[start:stop],
+                topk_ids[start:stop],
+                topk_weights[start:stop],
+                self.pointers,
+                self.metadata,
+                expert_map,
+                self.intermediate,
+                out[start:stop],
+                workspace,
+                self.situ_beta,
+                self.situ_linear_beta,
+                self.swiglu_limit,
+                self.rate_gate_up,
+                self.rate_down,
+            )
+
+
+class K31VqNativeExperts(_K31ExpertsKernel):
+    """The native VQ ops behind upstream's modular MoE kernel: a
+    :class:`K31VqLauncher` fed with upstream's workspace."""
+
+    def __init__(
+        self, moe, quant, experts: K31Experts, launcher: K31VqLauncher, expert_map
+    ):
+        super().__init__(moe, quant, experts)
+        self.launcher = launcher
+        self.expert_map = expert_map
+        self.workspace_elements = launcher.workspace_elements
+        self.max_rows = launcher.max_rows
+
+    @staticmethod
+    def _supports_current_device():
+        from vllm.platforms import current_platform
+
+        return current_platform.is_cuda()
+
+    def workspace_shapes(
+        self,
+        M,
+        N,
+        K,
+        topk,
+        global_num_experts,
+        local_num_experts,
+        expert_tokens_meta,
+        activation,
+    ):
+        # workspace2 is BF16 storage the native operator views as FP32. It
+        # comes from upstream's workspace manager: one allocation per process,
+        # grown to the largest request and then locked, so the layers share
+        # it and a captured graph keeps its address.
+        return (0,), (2 * self.workspace_elements,), (M, K)
+
+    def apply(
+        self,
+        output,
+        hidden_states,
+        w1,
+        w2,
+        topk_weights,
+        topk_ids,
+        activation,
+        global_num_experts,
+        expert_map,
+        a1q_scale,
+        a2_scale,
+        workspace13,
+        workspace2,
+        expert_tokens_meta,
+        apply_router_weight_on_input,
+    ):
+        self._check_inputs(apply_router_weight_on_input, a1q_scale, a2_scale)
+        rows = hidden_states.shape[0]
+        if rows > self.max_rows:
+            raise ValueError("k31q MoE exceeds the configured row capacity")
+        if rows == 0:
+            return
+        self.launcher(
+            hidden_states,
+            topk_ids,
+            topk_weights,
+            self.expert_map if expert_map is None else expert_map,
+            output,
+            workspace2.view(torch.float32),
+        )
+
+
+class K31Exl3Launcher:
+    """The K3.1 EXL3 launches of one layer on one rank; needs no model.
+
+    ``tables``: per part the (pointer, meta) tables of K31Experts.exl3_tables.
+    A launch of up to K31_MAX_ASSIGNMENTS / top-k rows takes moe_out_k31, a
+    larger one moe_out_prefill_k31. A call of more than ``launch_rows`` rows
+    (VLLM_K31Q_MOE_CHUNK_ROWS; unset: whole calls, the prefill operator
+    chunks its rows itself) runs as consecutive row chunks, and the workspace
+    is sized for one launch. With more than one part (tensor parallel size 1:
+    two halves of the intermediate) each part is one launch into its own
+    buffer and the partial outputs are added in BF16, as the tensor-parallel
+    all-reduce adds the ranks'.
+    """
+
+    def __init__(
+        self,
+        experts: K31Experts,
+        tables,
+        max_rows: int,
+        top_k: int,
+        situ_beta: float,
+        situ_linear_beta: float,
+        swiglu_limit: float = 0.0,
+    ):
+        from vllm.sm80.kernels.exl3 import ops as exl3_ops
+
+        self.tables = list(tables)
+        self.max_rows = max_rows
+        self.launch_rows = moe_launch_rows(max_rows)
+        self.part_intermediate = experts.padded_part_intermediate
+        self.decode_rows = max(1, K31_MAX_ASSIGNMENTS // top_k)
+        sizes = (experts.latent, self.part_intermediate, top_k, experts.experts)
+        workspace = exl3_ops.moe_workspace_size_k31(
+            min(self.launch_rows, self.decode_rows), *sizes
+        )
+        if self.launch_rows > self.decode_rows:
+            workspace = max(
+                workspace,
+                exl3_ops.moe_workspace_size_prefill_k31(self.launch_rows, *sizes),
+            )
+        self.workspace_elements = workspace
+        self.situ_beta = float(situ_beta)
+        self.situ_linear_beta = float(situ_linear_beta)
+        self.swiglu_limit = float(swiglu_limit)
+        self.renormalize = True
+
+    def storage_elements(self, rows: int, hidden: int) -> int:
+        """BF16 elements :meth:`__call__` needs for a call of ``rows`` rows:
+        the operator's FP32 workspace, then one [launch rows, hidden] partial
+        per part after the first."""
+        extra = (len(self.tables) - 1) * min(rows, self.launch_rows) * hidden
+        return 2 * self.workspace_elements + extra
+
+    def __call__(self, x, topk_ids, topk_weights, expert_map, out, storage) -> None:
+        """``storage``: BF16, at least ``storage_elements(rows, hidden)``."""
+        from vllm.sm80.kernels.exl3 import ops as exl3_ops
+
+        topk_weights, topk_ids = maybe_prune_moe_topk(
+            topk_weights, topk_ids, renormalize=self.renormalize
+        )
+        rows, hidden = x.shape
+        scratch = 2 * self.workspace_elements
+        workspace = storage[:scratch].view(torch.float32)
+        partials = storage[scratch:]
+        step = self.launch_rows
+        for start in range(0, rows, step):
+            stop = min(start + step, rows)
+            count = stop - start
+            operator = (
+                exl3_ops.moe_out_k31
+                if count <= self.decode_rows
+                else exl3_ops.moe_out_prefill_k31
+            )
+            for part, (pointers, metadata) in enumerate(self.tables):
+                if part == 0:
+                    target = out[start:stop]
+                else:
+                    first = (part - 1) * count * hidden
+                    target = partials[first : first + count * hidden].view(
+                        count, hidden
+                    )
+                operator(
+                    x[start:stop],
+                    topk_ids[start:stop],
+                    topk_weights[start:stop],
+                    pointers,
+                    metadata,
+                    expert_map,
+                    self.part_intermediate,
+                    target,
+                    workspace,
+                    situ_beta=self.situ_beta,
+                    situ_linear_beta=self.situ_linear_beta,
+                    swiglu_limit=self.swiglu_limit,
+                )
+                if part:
+                    out[start:stop].add_(target)
+
+
+class K31Exl3Experts(_K31ExpertsKernel):
+    """EXL3 routed experts through the K3.1 kernels behind upstream's modular
+    MoE kernel: a :class:`K31Exl3Launcher` fed with upstream's workspace."""
+
+    def __init__(
+        self, moe, quant, experts: K31Experts, launcher: K31Exl3Launcher, expert_map
+    ):
+        super().__init__(moe, quant, experts)
+        self.launcher = launcher
+        self.tables = launcher.tables
+        self.expert_map = expert_map
+        self.workspace_elements = launcher.workspace_elements
+        self.max_rows = launcher.max_rows
+        self.part_intermediate = launcher.part_intermediate
+
+    @staticmethod
+    def _supports_current_device():
+        from vllm.platforms import current_platform
+
+        return current_platform.is_cuda()
+
+    def workspace_shapes(
+        self,
+        M,
+        N,
+        K,
+        topk,
+        global_num_experts,
+        local_num_experts,
+        expert_tokens_meta,
+        activation,
+    ):
+        # workspace2: the operator's FP32 workspace as BF16 storage, then one
+        # BF16 partial of a launch's rows per part after the first.
+        return (0,), (self.launcher.storage_elements(M, K),), (M, K)
+
+    def apply(
+        self,
+        output,
+        hidden_states,
+        w1,
+        w2,
+        topk_weights,
+        topk_ids,
+        activation,
+        global_num_experts,
+        expert_map,
+        a1q_scale,
+        a2_scale,
+        workspace13,
+        workspace2,
+        expert_tokens_meta,
+        apply_router_weight_on_input,
+    ):
+        self._check_inputs(apply_router_weight_on_input, a1q_scale, a2_scale)
+        rows = hidden_states.shape[0]
+        if rows > self.max_rows:
+            raise ValueError("k31q MoE exceeds the configured row capacity")
+        if rows == 0:
+            return
+        self.launcher(
+            hidden_states,
+            topk_ids,
+            topk_weights,
+            self.expert_map if expert_map is None else expert_map,
+            output,
+            workspace2,
+        )
+
+
+class K31MoEMethod(FusedMoEMethodBase):
+    """Common part of the two routed-expert methods."""
+
+    expert_method = ""
+
+    def __init__(self, config, prefix: str, moe):
+        from vllm.model_executor.models.utils import extract_layer_index
+
+        super().__init__(moe)
+        self.config = config
+        self.prefix = prefix
+        self.layer_index = extract_layer_index(prefix)
+        if moe.has_bias or moe.activation != MoEActivation.SITU:
+            raise ValueError(
+                "k31q routed experts are bias-free SituAndMul gate/up/down"
+            )
+        if moe.is_lora_enabled:
+            raise ValueError("k31q routed experts do not support LoRA")
+        if moe.activation_situ_beta is None:
+            raise ValueError("k31q routed experts need activation_situ_beta")
+        self.situ_beta = float(moe.activation_situ_beta)
+        self.situ_linear_beta = (
+            None
+            if moe.activation_situ_linear_beta is None
+            else float(moe.activation_situ_linear_beta)
+        )
+        self.swiglu_limit = 0.0 if moe.swiglu_limit is None else float(moe.swiglu_limit)
+        self.intermediate, self.columns = expert_split(moe, self.layer_index)
+        # Other ranks hold other I-blocks of the same tensors, never other
+        # tensors: nothing is left to another rank.
+        self.nonlocal_keys: list[str] = []
+
+    part_width: int | None = None
+    # The native VQ ops module of a VQ layer served by them (K31VqMoEMethod).
+    native = None
+
+    def maybe_roundup_sizes(
+        self,
+        hidden_size,
+        intermediate_size_per_partition,
+        act_dtype,
+        moe_parallel_config,
+    ):
+        hidden_size, _ = super().maybe_roundup_sizes(
+            hidden_size, intermediate_size_per_partition, act_dtype, moe_parallel_config
+        )
+        return hidden_size, self.columns.stop - self.columns.start
+
+    def create_weights(
+        self,
+        layer,
+        num_experts,
+        hidden_size,
+        intermediate_size_per_partition,
+        params_dtype,
+        **extra_weight_attrs,
+    ):
+        if params_dtype != torch.bfloat16 or layer.apply_router_weight_on_input:
+            raise ValueError("k31q MoE requires BF16 and routing weights after down")
+        if num_experts != layer.global_num_experts:
+            raise ValueError("k31q routed experts: every rank holds every expert")
+        width = self.columns.stop - self.columns.start
+        if intermediate_size_per_partition != width:
+            raise ValueError(
+                f"k31q routed experts need this rank's intermediate {width}, "
+                f"not {intermediate_size_per_partition}"
+            )
+        manifest = self.config.manifest
+        assert manifest is not None, "k31q manifest must precede model construction"
+        projections = {
+            name: manifest.expert_projections[self.layer_index, name]
+            for name in PROJECTIONS
+        }
+        if any(p.method != self.expert_method for p in projections.values()):
+            raise ValueError(f"k31q {self.prefix}: not {self.expert_method} experts")
+        self.hidden_size = hidden_size
+        self.local_experts = num_experts
+        layer.k31_experts = K31Experts(
+            self.prefix,
+            self.layer_index,
+            projections,
+            num_experts,
+            hidden_size,
+            self.intermediate,
+            self.columns,
+            part_width=self.part_width,
+            vq_native=self.native,
+        )
+        logger.debug(
+            "k31q routed experts of %s (%s): rank holds intermediate columns "
+            "[%d, %d) of %d in %d part(s)",
+            self.prefix,
+            self.expert_method,
+            self.columns.start,
+            self.columns.stop,
+            self.intermediate,
+            len(layer.k31_experts.parts),
+        )
+
+    def get_fused_moe_quant_config(self, layer):
+        return FusedMoEQuantConfig.make()
+
+    def _prepare_finalize(self, layer):
+        from vllm.model_executor.layers.fused_moe.all2all_utils import (
+            maybe_make_prepare_finalize,
+        )
+
+        self.moe_quant_config = self.get_fused_moe_quant_config(layer)
+        return maybe_make_prepare_finalize(
+            moe=self.moe,
+            quant_config=self.moe_quant_config,
+            routing_tables=layer._expert_routing_tables(),
+            allow_new_interface=True,
+        )
+
+    def _expert_map(self, layer, device) -> torch.Tensor:
+        if layer.expert_map is not None:
+            return layer.expert_map
+        return torch.arange(layer.global_num_experts, dtype=torch.int32, device=device)
+
+    def _weights(self, layer) -> tuple[torch.Tensor, torch.Tensor]:
+        """Tensors handed to the modular kernel as w1 and w2: only their
+        first dimension (local experts) is read."""
+        raise NotImplementedError
+
+    def apply(
+        self, layer, x, topk_weights, topk_ids, shared_experts, shared_experts_input
+    ):
+        assert self.moe_kernel is not None
+        w1, w2 = self._weights(layer)
+        return self.moe_kernel.apply(
+            hidden_states=x,
+            w1=w1,
+            w2=w2,
+            topk_weights=topk_weights,
+            topk_ids=topk_ids,
+            activation=layer.activation,
+            apply_router_weight_on_input=False,
+            global_num_experts=layer.global_num_experts,
+            expert_map=layer.k31_expert_map,
+            shared_experts=shared_experts,
+            shared_experts_input=shared_experts_input,
+        )
+
+
+class K31VqMoEMethod(K31MoEMethod):
+    """VQ codebook routed experts (the primary format)."""
+
+    expert_method = VQ
+
+    def __init__(self, config, prefix, moe):
+        super().__init__(config, prefix, moe)
+        # The backend decides what the layer holds, so it is fixed here. A
+        # build without the native library says so before anything is
+        # allocated or read.
+        self.backend = vq_backend()
+        self.native = load_vq_native() if self.backend == "native" else None
+
+    def reference_experts(self, layer) -> K31VqReferenceExperts:
+        """The torch reference kernel over the layer's canonical records."""
+        renorm = bool(
+            getattr(layer, "renormalize", getattr(self.moe, "renormalize", True))
+        )
+        return K31VqReferenceExperts(
+            self.moe,
+            self.get_fused_moe_quant_config(layer),
+            layer.k31_experts,
+            self.situ_beta,
+            self.situ_linear_beta,
+            renormalize=renorm,
+        )
+
+    def build_native_kernel(self, layer, max_rows: int) -> K31VqNativeExperts:
+        """The launcher (workspace size, static rate ids, launch rows) and
+        the experts kernel of a loaded layer for the native VQ ops (no
+        prepare/finalize object needed). The packed buffers and the tables
+        are the experts module's own, made when it loaded."""
+        experts = layer.k31_experts
+        if self.situ_linear_beta is None:
+            raise ValueError("The native k31q VQ ops need activation_situ_linear_beta")
+        launcher = K31VqLauncher(
+            experts,
+            max_rows,
+            layer.top_k,
+            self.situ_beta,
+            self.situ_linear_beta,
+            self.swiglu_limit,
+        )
+        launcher.renormalize = bool(
+            getattr(layer, "renormalize", getattr(self.moe, "renormalize", True))
+        )
+        if launcher.launch_rows < max_rows:
+            logger.info_once(
+                "k31q VQ routed experts run MoE calls of more than %d rows as "
+                "launches of at most %d rows (the prefill operator takes %d; "
+                "VLLM_K31Q_MOE_CHUNK_ROWS); the workspace holds %d rows "
+                "instead of %d.",
+                launcher.launch_rows,
+                launcher.launch_rows,
+                VQ_PREFILL_MAX_ROWS,
+                launcher.launch_rows,
+                max_rows,
+            )
+        return K31VqNativeExperts(
+            self.moe,
+            self.get_fused_moe_quant_config(layer),
+            experts,
+            launcher,
+            layer.k31_expert_map,
+        )
+
+    def process_weights_after_loading(self, layer):
+        from vllm.sm80.kernels.exl3.quant import dispatched_rows
+
+        experts = layer.k31_experts
+        experts.require_loaded(cuda=self.native is not None)
+        layer.register_buffer("k31_expert_map", self._expert_map(layer, experts.device))
+        prepare = self._prepare_finalize(layer)
+        if self.native is None:
+            logger.warning_once(
+                "k31q VQ routed experts run the torch reference path "
+                "(VLLM_K31Q_VQ_BACKEND=reference): an oracle, not a serving path."
+            )
+            self.moe_kernel = mk.FusedMoEKernel(prepare, self.reference_experts(layer))
+            return
+        kernel = self.build_native_kernel(layer, dispatched_rows(prepare, self.moe))
+        self.moe_kernel = mk.FusedMoEKernel(prepare, kernel)
+
+    def _weights(self, layer):
+        experts = layer.k31_experts
+        if self.native is not None:
+            return experts.packed_ptrs, experts.packed_meta
+        return experts.w1_idx, experts.w2_idx
+
+
+class K31Exl3MoEMethod(K31MoEMethod):
+    """EXL3 routed experts (the fallback format) through moe_out_k31."""
+
+    expert_method = EXL3
+
+    def __init__(self, config, prefix, moe):
+        super().__init__(config, prefix, moe)
+        # The kernels take one intermediate: a rank holding a multiple of it
+        # (tensor parallel size 1) loads that many parts.
+        self.part_width = K31_KERNEL_SHAPE[1]
+
+    def build_kernel(self, layer, max_rows: int) -> K31Exl3Experts:
+        """Tables, launcher (workspace size, launch rows) and the experts
+        kernel of a loaded layer (the part of process_weights_after_loading
+        that needs no prepare/finalize object)."""
+        experts = layer.k31_experts
+        reason = experts.exl3_kernel_closed_reason()
+        if reason is not None:
+            raise ValueError(f"k31q EXL3 routed experts of {self.prefix}: {reason}")
+        if self.situ_linear_beta is None:
+            raise ValueError("The K3.1 EXL3 kernels need activation_situ_linear_beta")
+        tables = []
+        for part in range(len(experts.parts)):
+            pointers, metadata = experts.exl3_tables(part)
+            layer.register_buffer(f"k31_ptrs_{part}", pointers)
+            layer.register_buffer(f"k31_meta_{part}", metadata)
+            tables.append((pointers, metadata))
+        device = experts.trellis.device
+        layer.register_buffer("k31_expert_map", self._expert_map(layer, device))
+        launcher = K31Exl3Launcher(
+            experts,
+            tables,
+            max_rows,
+            layer.top_k,
+            self.situ_beta,
+            self.situ_linear_beta,
+            self.swiglu_limit,
+        )
+        launcher.renormalize = bool(
+            getattr(layer, "renormalize", getattr(self.moe, "renormalize", True))
+        )
+        if len(tables) > 1:
+            logger.info_once(
+                "k31q EXL3 routed experts run %d launches per MoE call on this "
+                "rank (it holds %d intermediate columns, the kernels take %d).",
+                len(tables),
+                experts.local_intermediate,
+                launcher.part_intermediate,
+            )
+        if launcher.launch_rows < max_rows:
+            logger.info_once(
+                "k31q EXL3 routed experts run MoE calls of more than %d rows as "
+                "launches of at most %d rows (VLLM_K31Q_MOE_CHUNK_ROWS); the "
+                "workspace holds %d rows instead of %d.",
+                launcher.launch_rows,
+                launcher.launch_rows,
+                launcher.launch_rows,
+                max_rows,
+            )
+        return K31Exl3Experts(
+            self.moe,
+            self.get_fused_moe_quant_config(layer),
+            experts,
+            launcher,
+            layer.k31_expert_map,
+        )
+
+    def process_weights_after_loading(self, layer):
+        from vllm.sm80.kernels.exl3.quant import dispatched_rows
+
+        layer.k31_experts.require_loaded(cuda=True)
+        prepare = self._prepare_finalize(layer)
+        kernel = self.build_kernel(layer, dispatched_rows(prepare, self.moe))
+        self.moe_kernel = mk.FusedMoEKernel(prepare, kernel)
+
+    def _weights(self, layer):
+        return layer.k31_ptrs_0, layer.k31_meta_0
