+def make_checkpoint(directory: str, files: dict[str, str] | None = None) -> str:
+    files = dict(CHECKPOINT_FILES if files is None else files)
+    index = {"weight_map": {"a": "model-00001-of-00002.safetensors",
+                            "b": "model-00002-of-00002.safetensors"}}
+    files.setdefault("model.safetensors.index.json", json.dumps(index))
+    for rel, text in files.items():
+        write(os.path.join(directory, rel), text)
