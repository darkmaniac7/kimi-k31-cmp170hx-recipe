+def _big_written():
+    rng = np.random.default_rng(0)
+    rows = [rng.integers(0, BIG_ROWS, 4000)]
+    boundary = [
+        0,
+        1,
+        2**23 - 1,
+        2**23,
+        2**23 + 1,
+        2**24 - 1,
+        2**24,
+        2**24 + 1,
+        BIG_ROWS - 1,
+    ]
+    for _, _, lo, hi in _owner_ranges(BIG_HEADS):
+        boundary += [lo, lo + 1, hi - 1]
+    return np.concatenate([np.concatenate(rows), np.asarray(boundary)])
