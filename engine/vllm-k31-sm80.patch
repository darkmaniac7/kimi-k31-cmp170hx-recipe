+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Shared parts of the K3.1 tests that need a CUDA device (test_*_gpu.py).
+
+Those tests are marked ``cuda``: they run only under the GPU lock
+(tests/sm80/gpu_lock_guard.py; set GPU_LOCK_TOKENS on a machine without one)
+and skip without a CUDA device, without the built library they exercise
+(``vllm/_k31_vq_C``, ``vllm/_k31_dense_C``, ``vllm/_exl3_C``) or, where they
+read real weights, without the mini checkpoint (K31Q_MINI_CHECKPOINT, a
+directory with a file DONE beside the manifest).
+"""
+
+import json
+import os
+from contextlib import ExitStack
+from pathlib import Path
+
+import pytest
+import torch
+from safetensors import safe_open
+
+MINI = Path(
+    os.environ.get(
+        "K31Q_MINI_CHECKPOINT", "/tmp/k31q-mini-checkpoint"
+    )
+)
+CUDA_MARKS = [
+    pytest.mark.cuda,
+    pytest.mark.skipif(not torch.cuda.is_available(), reason="needs CUDA"),
+]
+# Decoder layer of the mini checkpoint whose MoE the reference activations
+# cover (ref_acts.safetensors, tensors "L1.moe.*").
+REF_LAYER = 1
+
+
+def require_mini() -> Path:
+    if not (MINI / "DONE").is_file():
+        pytest.skip(f"no finished mini checkpoint at {MINI}")
+    return MINI
+
+
+def require_library(ensure, name: str):
+    """Load a native library through its ``ensure`` function or skip."""
+    try:
+        ensure()
+    except RuntimeError as exc:
+        pytest.skip(f"vllm/{name} is not usable here: {exc}")
+
+
+def tensors(path: Path, *names: str, device="cuda") -> list[torch.Tensor]:
+    """Named tensors of one safetensors file on ``device``; a missing name
+    fails with the names the file does hold."""
+    with safe_open(str(path), framework="pt") as file:
+        held = set(file.keys())
+        missing = [name for name in names if name not in held]
+        assert not missing, f"{path.name} lacks {missing}; it holds {sorted(held)[:40]}"
+        return [file.get_tensor(name).to(device) for name in names]
+
+
+def reference_moe(layer: int = REF_LAYER, variant: str = "q"):
+    """(x BF16 [rows, latent], top-k ids int64, top-k weights FP32, routed
+    output) of the reference activations: the latent input of the routed
+    experts of ``layer`` and their output summed over the whole intermediate,
+    of the quantized model (``q``) or the original (``orig``)."""
+    names = [
+        f"L{layer}.moe.{part}.{variant}"
+        for part in ("z", "topk_ids", "topk_weights", "routed_out")
+    ]
+    x, ids, weights, out = tensors(require_mini() / "ref_acts.safetensors", *names)
+    return (
+        x.to(torch.bfloat16).contiguous(),
+        ids.to(torch.int64).contiguous(),
+        weights.to(torch.float32).contiguous(),
+        out.to(torch.float32),
+    )
+
+
+def rel_l2(got: torch.Tensor, want: torch.Tensor) -> float:
+    return (got.float() - want.float()).norm().item() / want.float().norm().item()
+
+
+def text_config(directory: Path) -> dict:
+    """The text model's config of a checkpoint directory, as written."""
+    return json.loads((directory / "config.json").read_text())["text_config"]
+
+
+def load_experts(
+    directory: Path,
+    layer: int,
+    tp_size: int = 1,
+    tp_rank: int = 0,
+    native=None,
+    device="cuda:0",
+    part_width: int | None = None,
+):
+    """The routed experts of one layer for one tensor-parallel rank, built
+    on ``device`` and loaded by the engine's own K31Experts, without a model:
+    the manifest gives the projections, the config the sizes, and the rank's
+    columns are the engine's cut (chunk (rank + layer) mod TP). ``native``:
+    the VQ ops module for the native backend, None for the reference backend
+    (or an EXL3 layer). Returns (experts module, manifest)."""
+    from vllm.sm80.kernels.exl3.utils import Exl3LoadLedger, block_shard
+    from vllm.sm80.kernels.k31q.manifest import PROJECTIONS, K31QManifest
+    from vllm.sm80.kernels.k31q.moe import K31Experts
+
+    manifest = K31QManifest(directory)
+    text = text_config(directory)
+    intermediate = text["moe_intermediate_size"]
+    columns = block_shard(intermediate, intermediate, tp_rank, tp_size, layer)
+    projections = {w: manifest.expert_projections[layer, w] for w in PROJECTIONS}
+    with torch.device(device):
+        experts = K31Experts(
+            f"{manifest.layer_prefix(layer)}block_sparse_moe.experts",
+            layer,
+            projections,
+            text["num_experts"],
+            text["routed_expert_hidden_size"],
+            intermediate,
+            columns,
+            part_width=part_width,
+            vq_native=native,
+        )
+    paths = sorted({manifest.tensors[key].path for key in experts.keys})
+    with ExitStack() as stack:
+        files = {
+            path: stack.enter_context(
+                safe_open(str(path), framework="pt", device="cpu")
+            )
+            for path in paths
+        }
+        experts.load(files, Exl3LoadLedger(manifest))
+    return experts, manifest
