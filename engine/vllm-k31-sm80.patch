+// ============================================================================
+// 4. Bitwise-Deterministic Narrow-N BF16 GEMV Split-2 (KDA f_a+b, MLA wkv_index)
+// ============================================================================
+
+// Tensor Core m16n8k16 narrow-N BF16 GEMV split-2 (KDA f_a+b, MLA wkv_index).
+// 1 CTA per n8 tile, 16 warps (512 threads), 18 KB SMEM (0 bank conflicts with +4 stride),
+// 2-stage register prefetch on coalesced 128-bit W loads, X via L1 __ldg.
+// 100% batch-invariant across M = 1..16, zero workspace, zero cross-CTA sync.
+__global__ void __launch_bounds__(512, 2) k31_bf16_gemv_split2_mma_kernel(
+    const __nv_bfloat16* __restrict__ x_ptr,
+    const __nv_bfloat16* __restrict__ w_ptr,
+    int M,
+    int K,
+    int N_total,
+    int n0,
+    __nv_bfloat16* __restrict__ out0_ptr,
+    __nv_bfloat16* __restrict__ out1_ptr) {
+  constexpr int kWarps = 16;
+  __shared__ union {
+    uint32_t w_tile[kWarps][8][36];  // 18432 B (0 bank conflicts!)
+    float s_part[kWarps][16][8];     // 8192 B
+  } smem;
+
+  const int tid = threadIdx.x;
+  const int warp = tid >> 5;
+  const int lane = tid & 31;
+  const int g = lane >> 2;
+  const int t = lane & 3;
+  const int lr = lane >> 3;
+  const int lv = lane & 7;
+  const int n_base = blockIdx.x * 8;
+
+  const bool r0_ok = (g < M);
+  const bool r1_ok = ((g + 8) < M);
+  const uint32_t* x0_u32 = reinterpret_cast<const uint32_t*>(
+      x_ptr + static_cast<int64_t>(r0_ok ? g : 0) * K);
+  const uint32_t* x1_u32 = reinterpret_cast<const uint32_t*>(
+      x_ptr + static_cast<int64_t>(r1_ok ? (g + 8) : 0) * K);
+
+  float c0 = 0.0f, c1 = 0.0f, c2 = 0.0f, c3 = 0.0f;
+
+  const int num_k64 = (K + 63) >> 6;
+  const int num_vecs = K >> 3;
+  const int k_u32_limit = K >> 1;
+
+  const int nr0 = n_base + lr;
+  const int nr1 = n_base + lr + 4;
+  const uint4* w_row0 = reinterpret_cast<const uint4*>(
+      w_ptr + static_cast<int64_t>(nr0 < N_total ? nr0 : 0) * K);
+  const uint4* w_row1 = reinterpret_cast<const uint4*>(
+      w_ptr + static_cast<int64_t>(nr1 < N_total ? nr1 : 0) * K);
+
+  int kt = warp;
+  uint4 pref_w0 = make_uint4(0u, 0u, 0u, 0u);
+  uint4 pref_w1 = make_uint4(0u, 0u, 0u, 0u);
+  if (kt < num_k64) {
+    const int vb = kt * 8;
+    const bool ok = (vb + lv) < num_vecs;
+    if (nr0 < N_total && ok) pref_w0 = w_row0[vb + lv];
+    if (nr1 < N_total && ok) pref_w1 = w_row1[vb + lv];
+  }
+
+  for (; kt < num_k64; kt += kWarps) {
+    reinterpret_cast<uint4*>(smem.w_tile[warp][lr])[lv] = pref_w0;
+    reinterpret_cast<uint4*>(smem.w_tile[warp][lr + 4])[lv] = pref_w1;
+
+    const int kt_next = kt + kWarps;
+    if (kt_next < num_k64) {
+      const int vb_n = kt_next * 8;
+      const bool ok_n = (vb_n + lv) < num_vecs;
+      pref_w0 = (nr0 < N_total && ok_n) ? w_row0[vb_n + lv] : make_uint4(0u, 0u, 0u, 0u);
+      pref_w1 = (nr1 < N_total && ok_n) ? w_row1[vb_n + lv] : make_uint4(0u, 0u, 0u, 0u);
+    }
+    __syncwarp();
+
+    const int k_u32_base = kt * 32;
+#pragma unroll
+    for (int s = 0; s < 4; ++s) {
+      const int col0 = s * 8 + t;
+      const int col1 = col0 + 4;
+      const int xu0 = k_u32_base + col0;
+      const int xu1 = k_u32_base + col1;
+      const bool lo_ok = xu0 < k_u32_limit;
+      const bool hi_ok = xu1 < k_u32_limit;
+      uint32_t a0 = (r0_ok && lo_ok) ? __ldg(&x0_u32[xu0]) : 0u;
+      uint32_t a2 = (r0_ok && hi_ok) ? __ldg(&x0_u32[xu1]) : 0u;
+      uint32_t a1 = (r1_ok && lo_ok) ? __ldg(&x1_u32[xu0]) : 0u;
+      uint32_t a3 = (r1_ok && hi_ok) ? __ldg(&x1_u32[xu1]) : 0u;
+      uint32_t b0 = smem.w_tile[warp][g][col0];
+      uint32_t b1 = smem.w_tile[warp][g][col1];
+      mma_m16n8k16_bf16_f32(c0, c1, c2, c3, a0, a1, a2, a3, b0, b1);
+    }
+    __syncwarp();
+  }
+
+  __syncthreads();
+  smem.s_part[warp][g][2 * t] = c0;
+  smem.s_part[warp][g][2 * t + 1] = c1;
+  smem.s_part[warp][g + 8][2 * t] = c2;
+  smem.s_part[warp][g + 8][2 * t + 1] = c3;
+  __syncthreads();
+
+  if (tid < 128) {
+    const int m = tid >> 3;
+    const int n = tid & 7;
+    const int out_r = n_base + n;
+    if (m < M && out_r < N_total) {
+      float tot = 0.0f;
+#pragma unroll
+      for (int w = 0; w < kWarps; ++w) {
+        tot += smem.s_part[w][m][n];
+      }
+      __nv_bfloat16 y = f32_to_bf16(tot);
+      if (out_r < n0) {
+        out0_ptr[static_cast<int64_t>(m) * n0 + out_r] = y;
+      } else {
+        int n1 = N_total - n0;
+        out1_ptr[static_cast<int64_t>(m) * n1 + (out_r - n0)] = y;
+      }
+    }
+  }
+}
