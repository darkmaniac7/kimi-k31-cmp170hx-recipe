+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Quantization method "k31q": Kimi K3.1 checkpoints in the k31q v1 format.
+
+:class:`K31QConfig` extends the fork's EXL3 config: dense matrices the
+checkpoint stores as EXL3 take :class:`K31DenseLinearMethod` (the EXL3 linear
+method's weights and loader, launched through the K3.1 dense library of
+vllm/sm80/kernels/k31q/dense.py where it serves them), matrices it stores
+plain load as unquantized linears, and the routed experts take one of the two
+methods of vllm/sm80/kernels/k31q/moe.py, chosen per layer from the manifest.
+:class:`K31Layout` names the checkpoint sources of the K3.1 modules, and
+:class:`K31FusedLinearMethod` serves the one projection the EXL3 method
+cannot: the KDA in-projection, whose members are four EXL3 matrices cut by
+heads (q, k, v, g), one plain matrix replicated on every rank (f_a) and one
+plain matrix cut by heads (b), followed by zero padding rows.
+"""
+
+from contextlib import contextmanager
+from functools import cache
+from pathlib import Path
+from typing import Any, Literal
+
+import torch
+from torch import nn
+
+from vllm.logger import init_logger
+from vllm.model_executor.layers.fused_moe import RoutedExperts
+from vllm.model_executor.layers.linear import (
+    LinearBase,
+    LinearMethodBase,
+    UnquantizedLinearMethod,
+)
+from vllm.model_executor.layers.vocab_parallel_embedding import ParallelLMHead
+from vllm.sm80.kernels.exl3.layout import Exl3Layout
+from vllm.sm80.kernels.exl3.quant import (
+    Exl3Config,
+    Exl3LinearMethod,
+    Exl3PackedWeight,
+    _head_partition,
+    _linear_out_dtype,
+)
+from vllm.sm80.kernels.exl3.utils import aligned_shard
+from vllm.sm80.kernels.k31q import dense
+from vllm.sm80.kernels.k31q.manifest import (
+    EXL3,
+    PLAIN,
+    VISION_FILE,
+    VQ,
+    K31QManifest,
+)
+from vllm.sm80.kernels.k31q.moe import K31Exl3MoEMethod, K31VqMoEMethod
+
+logger = init_logger(__name__)
+
+LOAD_FORMAT = "k31q"
+# GPU architectures the engine may serve this format on. The native
+# extension is built for SM 8.0 today; the SM 12.0 stage needs its own build.
+SUPPORTED_CAPABILITIES = (80, 120)
+# Checkpoint members of the fused KDA in-projection in the model's shard
+# order (vllm/models/kimi_k3/nvidia/model.py load_weights: q 0, k 1, v 2,
+# g 3, f_a 4, b 5). The model's packed_modules_mapping lists five of them in
+# another order.
+KDA_IN_PROJ = "in_proj_qkvgfab"
+KDA_IN_PROJ_MEMBERS = ("q_proj", "k_proj", "v_proj", "g_proj", "f_a_proj", "b_proj")
+# Module name -> checkpoint name of the projections the model renames.
+MODULE_RENAMES = ((".self_attn.dsa_indexer.wq_index", ".self_attn.indexer.wq_b"),)
+# Top-level modules of the K3.1 wrapper; the text model sits under the first.
+TEXT_ROOT = "language_model."
+VISION_ROOTS = ("vision_tower.", "mm_projector.")
+ROOTS = (TEXT_ROOT, *VISION_ROOTS)
+# The launch option that makes the vision tower a placeholder on every rank
+# (vllm.config.multimodal.MultiModalConfig.language_model_only).
+TEXT_ONLY_OPTION = "--language-model-only"
+
+
+def no_vision_message(directory, what: str) -> str:
+    """The one outcome of a checkpoint without the vision file on a rank that
+    builds the tower for real: an error that names the way to serve it."""
+    return (
+        f"k31q checkpoint {directory} lists no {VISION_FILE} (the vision tower "
+        f"and the projector), but this rank builds {what}. Serve the "
+        f"checkpoint text-only with {TEXT_ONLY_OPTION}: the tower and the "
+        "projector are then placeholders on every pipeline stage and take no "
+        f"memory. To serve images, add {VISION_FILE} to the checkpoint and "
+        'list it under "other" in k31q_manifest.json.'
+    )
+
+
+class K31Layout(Exl3Layout):
+    """Checkpoint names of the Kimi K3.1 modules."""
+
+    def check_manifest(self, manifest) -> None:
+        if not isinstance(manifest, K31QManifest):
+            raise ValueError("The K3.1 layout reads k31q manifests")
+
+    def source_prefix(self, config, prefix: str) -> str:
+        for module, source in MODULE_RENAMES:
+            if prefix.endswith(module):
+                prefix = prefix.removesuffix(module) + source
+        # A text model built on its own names its modules without the root.
+        if not prefix.startswith(ROOTS):
+            prefix = TEXT_ROOT + prefix
+        return prefix
+
+    def members(self, config, leaf: str, source: str, outputs: int):
+        if leaf == KDA_IN_PROJ:
+            return list(KDA_IN_PROJ_MEMBERS)
+        return None
+
+    def expert_matrix(self, config, experts_prefix: str, expert: int, role: str) -> str:
+        name = {"gate_proj": "w1", "up_proj": "w3", "down_proj": "w2"}[role]
+        return f"{config.source_prefix(experts_prefix)}.{expert}.{name}"
+
+
+def _verify_launch_options(vllm_config) -> None:
+    """Refuse a model built without --load-format k31q (a layer built outside
+    a model, as in unit tests, has no config to check)."""
+    if vllm_config is None:
+        return
+    load_format = vllm_config.load_config.load_format
+    if load_format != LOAD_FORMAT:
+        raise ValueError(
+            f"k31q checkpoints need --load-format {LOAD_FORMAT}, not {load_format!r}"
+        )
+
+
+@cache
+def _require_supported_gpu() -> None:
+    from vllm.platforms import current_platform
+
+    capability = current_platform.get_device_capability()
+    if capability is not None and capability.to_int() not in SUPPORTED_CAPABILITIES:
+        raise ValueError(
+            "k31q kernels are built for SM 8.0 and SM 12.0; this GPU is SM "
+            f"{capability.major}.{capability.minor}"
+        )
+
+
+class K31QConfig(Exl3Config):
+    """Registered as "k31q" by vllm/sm80/plugin.py."""
+
+    def __init__(self):
+        super().__init__(None)
+        self.layout = K31Layout()
+
+    @classmethod
+    def get_name(cls) -> Literal["k31q"]:
+        return "k31q"
+
+    @classmethod
+    def override_quantization_method(cls, hf_quant_cfg, user_quant, hf_config=None):
+        if hf_quant_cfg.get("quant_method") == "k31q" or user_quant == "k31q":
+            from vllm.platforms import current_platform
+
+            if not current_platform.is_cuda():
+                raise ValueError("k31q execution requires the NVIDIA CUDA platform")
+        return None
+
+    @classmethod
+    def from_config(cls, config: dict[str, Any]) -> "K31QConfig":
+        version = config.get("version", 1)
+        if version != 1:
+            raise ValueError(f"Unsupported k31q quantization version: {version!r}")
+        return cls()
+
+    def maybe_update_config(self, model_name, hf_config=None, revision=None):
+        if not Path(model_name).is_dir():
+            raise ValueError("Download the k31q checkpoint directory before loading")
+        self.layout = K31Layout(hf_config)
+        self.manifest = K31QManifest(model_name)
+        self.layout.check_manifest(self.manifest)
+
+    def get_quant_method(self, layer: nn.Module, prefix: str):
+        from vllm.config import get_current_vllm_config_or_none
+
+        _verify_launch_options(get_current_vllm_config_or_none())
+        _require_supported_gpu()
+        # Only a layer that holds checkpoint weights reads the manifest. Other
+        # layers ask too, and some ask after the load, when the loader has
+        # released it: upstream's MLA attention layer resolves a method of
+        # its own in process_weights_after_loading (KV-cache scales,
+        # vllm/model_executor/layers/attention/mla_attention.py).
+        if not isinstance(layer, (RoutedExperts, LinearBase, ParallelLMHead)):
+            return None
+        assert self.manifest is not None, (
+            "k31q manifest must precede model construction"
+        )
+        if isinstance(layer, RoutedExperts):
+            return self._moe_method(layer, prefix)
+        return self._linear_method(layer, prefix)
+
+    def _moe_method(self, layer: RoutedExperts, prefix: str):
+        from vllm.model_executor.models.utils import extract_layer_index
+
+        method = self.manifest.expert_method(extract_layer_index(prefix))
+        cls = {VQ: K31VqMoEMethod, EXL3: K31Exl3MoEMethod}[method]
+        return cls(self, prefix, layer.moe_config)
+
+    def _require_vision_source(self, prefix: str) -> None:
+        """Stop the construction of a vision module that would hold weights
+        the checkpoint cannot give, at its first linear, before the tower
+        takes device memory. A placeholder tower is built on the meta device
+        (vllm.model_executor.models.utils.no_init_weights) and needs none;
+        the loader repeats the check on what the model really built."""
+        if self.manifest.has_vision or torch.empty(0).device.type == "meta":
+            return
+        raise ValueError(no_vision_message(self.manifest.directory, prefix))
+
+    def _source_kind(self, source: str) -> str | None:
+        if source in self.manifest.matrices:
+            return EXL3
+        if f"{source}.weight" in self.manifest.tensors:
+            return PLAIN
+        return None
+
+    def _linear_method(self, layer: nn.Module, prefix: str):
+        """EXL3 for a projection stored as EXL3, an unquantized linear for one
+        stored plain, the fused method for the KDA in-projection. A linear of
+        the text model that the checkpoint has no source for is an error
+        here, at construction, where the missing name is known.
+
+        The vision tower and the projector are never quantized: the format
+        stores them plain in vision.safetensors under the released names,
+        which differ from the module names (``mm_projector.proj.0`` is
+        ``mm_projector.linear_1``; the model's own load_weights maps them).
+        Their linears are unquantized whatever the checkpoint holds, also
+        when the tower is only built as a placeholder (text-only serving,
+        pipeline stages after the first); the loader reports a tensor that
+        is missing (vllm/sm80/kernels/k31q/loader.py)."""
+        source = self.source_prefix(prefix)
+        unquantized = (
+            UnquantizedLinearMethod() if isinstance(layer, LinearBase) else None
+        )
+        if not source.startswith(TEXT_ROOT):
+            self._require_vision_source(prefix)
+            return unquantized
+        kind = self._source_kind(source)
+        if kind == EXL3:
+            return K31DenseLinearMethod([self.manifest.matrices[source]])
+        if kind == PLAIN:
+            if isinstance(layer, LinearBase) and source.endswith(".self_attn.f_b_proj"):
+                return K31PlainLinearMethod()
+            return unquantized
+        outputs = len(getattr(layer, "output_sizes", ()))
+        members = self._member_names(source, outputs)
+        kinds = [self._source_kind(member) for member in members]
+        if None in kinds:
+            missing = [m for m, k in zip(members, kinds) if k is None]
+            raise ValueError(
+                f"k31q checkpoint holds no source of {prefix}: no EXL3 matrix "
+                f"and no .weight tensor named {missing}"
+            )
+        fused = (
+            getattr(layer, "replicated_shard_id", None) is not None
+            or getattr(layer, "padding_size", 0)
+            or len(set(kinds)) > 1
+        )
+        if fused:
+            if not isinstance(layer, LinearBase):
+                raise ValueError(f"k31q fused members need a linear layer: {prefix}")
+            return K31FusedLinearMethod(self, source, members, kinds)
+        if kinds[0] == EXL3:
+            return K31DenseLinearMethod([self.manifest.matrices[m] for m in members])
+        return unquantized
+
+
+def _exl3_linear(x, weight: Exl3PackedWeight, row_chunk: int, out_dtype):
+    """One EXL3 matrix applied to ``x`` (the native op; tests replace it)."""
+    return torch.ops.vllm.exl3_linear(
+        x,
+        weight.trellis,
+        weight.suh,
+        weight.svh,
+        weight.matrix.bits_x2,
+        weight.matrix.codebook,
+        weight.logical_out,
+        row_chunk,
+        out_dtype,
+    )
+
+
+class K31DenseLinearMethod(Exl3LinearMethod):
+    """The EXL3 linear method of a K3.1 dense module (one matrix, or the
+    members of a merged projection that share its input), launched through
+    ``linear_out_k31_multi`` of the K3.1 dense library when it serves the
+    members (vllm/sm80/kernels/k31q/dense.py: VLLM_K31Q_DENSE_BACKEND, the
+    library built, codebook mul1 and 5 to 7 bits), through ``exl3_linear``
+    otherwise. Weights, shards, loader, LM head columns and output dtype are
+    the EXL3 method's; only the launches differ. The choice is made once the
+    weights are on the device."""
+
+    def __init__(self, matrices, uneven: bool = False):
+        super().__init__(matrices, uneven)
+        self.launch_rows = dense.configured_launch_rows()
+        self.launcher: dense.K31DenseLauncher | None = None
+        self.backend_reason: str | None = "weights not processed"
+        self.members: list[str] = [matrix.prefix for matrix in matrices]
+
+    def process_weights_after_loading(self, layer):
+        super().process_weights_after_loading(layer)
+        weights = list(layer.exl3_weights)
+        self.members = [weight.matrix.prefix for weight in weights]
+        self.launcher, self.backend_reason = dense.select_launcher(
+            weights, self.out_dtype, self.launch_rows
+        )
+
+    def k31_dense_state(self):
+        """(launcher or None, why the EXL3 path, EXL3 members)."""
+        return self.launcher, self.backend_reason, self.members
+
+    def apply(self, layer, x, bias=None, out_dtype: torch.dtype | None = None):
+        dtype = self.out_dtype if out_dtype is None else _linear_out_dtype(out_dtype)
+        rows = x.numel() // x.shape[-1] if x.shape[-1] else 0
+        if (
+            self.launcher is None
+            or not self.launcher.takes(rows)
+            or dtype not in dense.OUT_DTYPES
+        ):
+            return super().apply(layer, x, bias, out_dtype=dtype)
+        shape = x.shape[:-1]
+        x = x.reshape(-1, x.shape[-1]).contiguous()
+        output = self.launcher(x, dtype)
+        if self.head_columns is not None:
+            output = _head_partition(output, *self.head_columns)
+        if bias is not None:
+            output.add_(bias)
+        return output.reshape(*shape, output.shape[-1])
+
+
+@contextmanager
+def fp32_gemm_reduction():
+    """Inside, cuBLAS reduces the partial sums of a BF16 GEMM in FP32.
+
+    By torch's default (torch.backends.cuda.matmul
+    .allow_bf16_reduced_precision_reduction) it may reduce them in BF16, and
+    it picks its kernel and its split of the 7168 inputs from the number of
+    rows in the call. A row's result then depends on how many rows share its
+    call. Measured on a CMP 170HX for [224, 7168] (f_a and b at tensor
+    parallel size 1), 15 row counts from 1 to 320, 8 seeds: by default row 0
+    takes 5 or 6 different values, up to 131 of its 224 elements differ
+    between two row counts and the worst rel_l2 is 0.0038, which reaches the
+    KDA output at 0.001 to 0.002 and tips near-tie expert routes (seen first
+    as a difference between a prompt resumed from the prefix cache and the
+    same prompt run whole). With FP32 reductions row 0 takes 1 or 2 values,
+    at most one element differs by one BF16 step and the worst rel_l2 is
+    0.000003.
+
+    This reduces the dependence; it does not remove it. cuBLAS still picks
+    its kernel from the row count, and two FP32 summation orders round a few
+    elements to neighbouring BF16 values. A result that is bit-identical at
+    every row count needs a kernel that computes each row in one fixed order,
+    as the EXL3 members' kernels do. Upstream sets the same switch for its
+    batch-invariant linears (vllm/models/flint/ops/linear.py)."""
+    matmul = torch.backends.cuda.matmul
+    previous = matmul.allow_bf16_reduced_precision_reduction
+    matmul.allow_bf16_reduced_precision_reduction = False
+    try:
+        yield
+    finally:
+        matmul.allow_bf16_reduced_precision_reduction = previous
+
+
+class K31PlainLinearMethod(UnquantizedLinearMethod):
+    """Plain BF16 linear for KDA ``f_b_proj`` routed through the bit-exact
+    row-count-invariant ``linear_plain_invariant_k31`` kernel (0-ULP across
+    M = 1..2048). Falls back to ``fp32_gemm_reduction`` + ``F.linear`` on CPU
+    or when ``_k31_dense_C`` api_version >= 3 is unavailable.
+    """
+
+    def apply(self, layer, x, bias=None):
+        if (
+            x.is_cuda
+            and layer.weight.is_cuda
+            and x.dtype == torch.bfloat16
+            and layer.weight.dtype == torch.bfloat16
+        ):
+            return dense.linear_plain_invariant_k31(x, layer.weight, bias)
+        return super().apply(layer, x, bias)
+
+
+class K31FusedLinearMethod(LinearMethodBase):
+    """A merged column-parallel projection whose members differ in storage
+    and sharding (the KDA in-projection ``in_proj_qkvgfab``).
+
+    Each member is an EXL3 matrix or a plain BF16 weight, cut by the layer's
+    tensor-parallel rank or, for the layer's ``replicated_shard_id``, held
+    whole on every rank. The output is the members' outputs in shard order
+    followed by the layer's zero padding columns, which is the layout of the
+    merged weight upstream's forward slices. The layer gets no ``weight``
+    parameter: EXL3 members are ``layer.exl3_weights`` and the plain members
+    are stacked in ``layer.plain_weight`` (one GEMM for all of them).
+    The loader fills both through :meth:`load`.
+
+    The EXL3 members run as one launch of the K3.1 dense library when it
+    serves them (vllm/sm80/kernels/k31q/dense.py; the KDA in-projection's q,
+    k, v and g), else one ``exl3_linear`` each; the plain members run through ``linear_plain_invariant_k31`` (bit-exact
+    across all row counts; falls back to a torch linear on CPU or without
+    api_version >= 3).
+    """
+
+    def __init__(self, config: K31QConfig, source: str, members, kinds):
+        self.config = config
+        self.source = source
+        self.members = list(members)
+        self.kinds = list(kinds)
+        self.out_dtype = torch.bfloat16
+        self.nonlocal_keys: list[str] = []
+        self.loaded = False
+        self.launch_rows = dense.configured_launch_rows()
+        self.launcher: dense.K31DenseLauncher | None = None
+        self.backend_reason: str | None = "weights not processed"
+        self.exl3_members: list[str] = [
+            m for m, k in zip(self.members, self.kinds) if k == EXL3
+        ]
+
+    def create_weights(
+        self,
+        layer,
+        input_size_per_partition,
+        output_partition_sizes,
+        input_size,
+        output_size,
+        params_dtype,
+        **extra_weight_attrs,
+    ):
+        if params_dtype != torch.bfloat16:
+            raise ValueError("k31q requires BF16 activations")
+        manifest = self.config.manifest
+        assert manifest is not None
+        parts = list(output_partition_sizes)
+        self.padding = int(getattr(layer, "padding_size", 0) or 0)
+        if self.padding:
+            if parts[-1] != self.padding:
+                raise ValueError(f"k31q {self.source}: unexpected padding partition")
+            parts = parts[:-1]
+        if len(parts) != len(self.members):
+            raise ValueError(
+                f"k31q {self.source}: {len(self.members)} checkpoint members for "
+                f"{len(parts)} output partitions"
+            )
+        rank, size = layer.tp_rank, layer.tp_size
+        replicated = getattr(layer, "replicated_shard_id", None)
+        # Per member: ("exl3", index into exl3_weights) or ("plain", (row
+        # offset in plain_weight, rows, source key, row slice in the file)).
+        self.segments: list[tuple[str, Any]] = []
+        weights, plain_rows = [], 0
+        for index, (member, kind, local) in enumerate(
+            zip(self.members, self.kinds, parts)
+        ):
+            whole = size == 1 or index == replicated
+            full = local if whole else local * size
+            if kind == EXL3:
+                matrix = manifest.matrices[member]
+                matrix.validate_logical(input_size, full)
+                if whole:
+                    columns = slice(0, matrix.padded_out)
+                else:
+                    try:
+                        columns = aligned_shard(full, matrix.padded_out, rank, size)
+                    except ValueError as exc:
+                        raise ValueError(
+                            f"k31q {member}: {full} outputs cannot be cut for "
+                            f"{size} ranks at whole 128 blocks; store it plain"
+                        ) from exc
+                self.segments.append((EXL3, len(weights)))
+                weights.append(
+                    Exl3PackedWeight(
+                        matrix,
+                        input_size,
+                        local,
+                        slice(0, matrix.padded_in),
+                        [columns],
+                    )
+                )
+                continue
+            key = f"{member}.weight"
+            header = manifest.tensors[key]
+            if header.dtype != "BF16" or header.shape != (full, input_size):
+                raise ValueError(
+                    f"k31q plain member {key}: {header.dtype} {header.shape}, "
+                    f"expected BF16 {(full, input_size)}"
+                )
+            rows = slice(0, full) if whole else slice(rank * local, (rank + 1) * local)
+            self.segments.append((PLAIN, (plain_rows, local, key, rows)))
+            plain_rows += local
+        layer.exl3_weights = nn.ModuleList(weights)
+        layer.plain_weight = nn.Parameter(
+            torch.empty((plain_rows, input_size), dtype=params_dtype),
+            requires_grad=False,
+        )
+        if self.padding:
+            # MergedColumnParallelLinear zeroes the padding rows of
+            # ``layer.weight`` when it is built with padding
+            # (vllm/model_executor/layers/linear.py, after create_weights).
+            # A weight of zero columns satisfies it without the merged
+            # matrix this method exists to avoid. The real model has no
+            # padding at tensor parallel size 1 or 2 (24,752 and 49,376
+            # local rows are multiples of 16).
+            layer.weight = nn.Parameter(
+                torch.empty((sum(output_partition_sizes), 0), dtype=params_dtype),
+                requires_grad=False,
+            )
+
+    def load(self, layer, files, ledger) -> None:
+        """Fill the EXL3 members and the plain rows of this rank from the
+        checkpoint and mark their tensors in the ledger."""
+        manifest = ledger.manifest
+        for kind, segment in self.segments:
+            if kind == EXL3:
+                layer.exl3_weights[segment].load(files, ledger)
+                continue
+            offset, rows, key, part = segment
+            header = manifest.tensors[key]
+            data = files[header.path].get_slice(key)[part.start : part.stop]
+            layer.plain_weight.data[offset : offset + rows].copy_(data)
+            ledger.mark(key, "consumed", self.source)
+        self.loaded = True
+
+    def process_weights_after_loading(self, layer):
+        from vllm.sm80.kernels.exl3 import ops as exl3_ops
+
+        if not self.loaded:
+            raise ValueError(f"Unloaded k31q fused projection: {self.source}")
+        self.row_chunks = []
+        for weight in layer.exl3_weights:
+            if not weight.loaded or not all(p.is_cuda for p in weight.parameters()):
+                raise ValueError("k31q packed weights and scales must be on CUDA")
+            self.row_chunks.append(
+                exl3_ops.linear_row_chunk(weight.padded_in, weight.padded_out)
+            )
+        weights = list(layer.exl3_weights)
+        self.exl3_members = [weight.matrix.prefix for weight in weights]
+        self.exl3_widths = [int(weight.logical_out) for weight in weights]
+        if weights:
+            self.launcher, self.backend_reason = dense.select_launcher(
+                weights, self.out_dtype, self.launch_rows
+            )
+        else:
+            self.launcher, self.backend_reason = None, "no EXL3 member"
+
+    def k31_dense_state(self):
+        """(launcher or None, why the EXL3 path, EXL3 members)."""
+        return self.launcher, self.backend_reason, self.exl3_members
+
+    def apply_kda_parts(
+        self,
+        layer,
+        x: torch.Tensor,
+        split_sizes: tuple[int, int, int, int],
+        bias: torch.Tensor | None = None,
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor] | None:
+        """Return ``(mixed_qkv, g_proj_states, f_a, beta)`` directly without the
+        redundant full-width ``torch.cat`` and immediate ``.split()`` in KDA.
+
+        Returns ``None`` if the projection layout or batch size does not match
+        the fast path so the caller falls back to the standard ``forward()``.
+        """
+        if bias is not None or len(split_sizes) != 4:
+            return None
+        if self.launcher is None or len(self.segments) != 6:
+            return None
+        qkv_w, g_w, fa_w, b_w = split_sizes
+        widths = getattr(self, "exl3_widths", ())
+        if (
+            len(widths) != 4
+            or (widths[0] + widths[1] + widths[2]) != qkv_w
+            or widths[3] != g_w
+        ):
+            return None
+        for idx in range(4):
+            kind, seg = self.segments[idx]
+            if kind != EXL3 or seg != idx:
+                return None
+        kind4, seg4 = self.segments[4]
+        kind5, seg5 = self.segments[5]
+        if kind4 != PLAIN or kind5 != PLAIN:
+            return None
+        off4, rows4, _, _ = seg4
+        off5, rows5, _, _ = seg5
+        if off4 != 0 or rows4 != fa_w or off5 != fa_w or rows5 != b_w:
+            return None
+
+        shape = x.shape[:-1]
+        x2d = x.reshape(-1, x.shape[-1]).contiguous()
+        if x2d.shape[0] == 0 or not self.launcher.takes(x2d.shape[0]):
+            return None
+
+        from vllm.sm80.kernels.k31q import glue as k31_glue
+
+        qkvg = self.launcher(x2d, self.out_dtype)
+        mixed_qkv, g_proj_states = qkvg.split([qkv_w, g_w], dim=-1)
+
+        w_pair = layer.plain_weight[: fa_w + b_w]
+        if k31_glue.gemv_enabled() and k31_glue.can_use_bf16_gemv_split2(
+            x2d, w_pair, fa_w
+        ):
+            f_a, beta = k31_glue.bf16_gemv_split2(x2d, w_pair, fa_w)
+        else:
+            plain_inv_fn = getattr(dense, "linear_plain_invariant_k31", None)
+            if plain_inv_fn is not None:
+                plain_out = plain_inv_fn(x2d, w_pair)
+            else:
+                with fp32_gemm_reduction():
+                    plain_out = torch.nn.functional.linear(x2d, w_pair)
+            f_a, beta = plain_out.split([fa_w, b_w], dim=-1)
+
+        if len(shape) != 1:
+            mixed_qkv = mixed_qkv.reshape(*shape, qkv_w)
+            g_proj_states = g_proj_states.reshape(*shape, g_w)
+            f_a = f_a.reshape(*shape, fa_w)
+            beta = beta.reshape(*shape, b_w)
+        return mixed_qkv, g_proj_states, f_a, beta
+
+    def _apply_with_glue_gemv(self, layer, x, bias=None):
+        from vllm.sm80.kernels.k31q import glue as k31_glue
+
+        shape = x.shape[:-1]
+        x = x.reshape(-1, x.shape[-1]).contiguous()
+        row_chunks = getattr(self, "row_chunks", [0] * len(layer.exl3_weights))
+        launched = None
+        if self.launcher is not None and self.launcher.takes(x.shape[0]):
+            launched = self.launcher(x, self.out_dtype).split(self.exl3_widths, dim=-1)
+        plain_inv_fn = getattr(dense, "linear_plain_invariant_k31", None)
+        outputs = []
+        idx = 0
+        n_segments = len(self.segments)
+        while idx < n_segments:
+            kind, segment = self.segments[idx]
+            if kind == EXL3:
+                if launched is not None:
+                    outputs.append(launched[segment])
+                else:
+                    outputs.append(
+                        _exl3_linear(
+                            x,
+                            layer.exl3_weights[segment],
+                            row_chunks[segment],
+                            self.out_dtype,
+                        )
+                    )
+                idx += 1
+                continue
+            offset, rows, _, _ = segment
+            if idx + 1 < n_segments and self.segments[idx + 1][0] == PLAIN:
+                next_offset, next_rows, _, _ = self.segments[idx + 1][1]
+                if next_offset == offset + rows:
+                    w_pair = layer.plain_weight[offset : offset + rows + next_rows]
+                    if k31_glue.can_use_bf16_gemv_split2(x, w_pair, rows):
+                        o0, o1 = k31_glue.bf16_gemv_split2(x, w_pair, rows)
+                        outputs.append(o0)
+                        outputs.append(o1)
+                        idx += 2
+                        continue
+            if plain_inv_fn is not None:
+                end = offset + rows
+                idx += 1
+                while idx < n_segments and self.segments[idx][0] == PLAIN:
+                    next_offset, next_rows, _, _ = self.segments[idx][1]
+                    if next_offset != end:
+                        break
+                    end += next_rows
+                    idx += 1
+                outputs.append(plain_inv_fn(x, layer.plain_weight[offset:end]))
+                continue
+            with fp32_gemm_reduction():
+                outputs.append(
+                    torch.nn.functional.linear(
+                        x, layer.plain_weight[offset : offset + rows]
+                    )
+                )
+            idx += 1
+        if self.padding:
+            outputs.append(x.new_zeros((x.shape[0], self.padding)))
+        output = torch.cat(outputs, dim=-1)
+        if bias is not None:
+            output = output + bias
+        return output.reshape(*shape, output.shape[-1])
+
+    def apply(self, layer, x, bias=None):
+        from vllm.sm80.kernels.k31q import glue as k31_glue
+
+        if k31_glue.gemv_enabled():
+            return self._apply_with_glue_gemv(layer, x, bias)
+        shape = x.shape[:-1]
+        x = x.reshape(-1, x.shape[-1]).contiguous()
+        row_chunks = getattr(self, "row_chunks", [0] * len(layer.exl3_weights))
+        launched = None
+        if self.launcher is not None and self.launcher.takes(x.shape[0]):
+            # All EXL3 members in one launch, split back into member views.
+            launched = self.launcher(x, self.out_dtype).split(self.exl3_widths, dim=-1)
+        outputs = []
+        idx = 0
+        n_segments = len(self.segments)
+        while idx < n_segments:
+            kind, segment = self.segments[idx]
+            if kind == EXL3:
+                if launched is not None:
+                    outputs.append(launched[segment])
+                else:
+                    outputs.append(
+                        _exl3_linear(
+                            x,
+                            layer.exl3_weights[segment],
+                            row_chunks[segment],
+                            self.out_dtype,
+                        )
+                    )
+                idx += 1
+                continue
+            offset, rows, _, _ = segment
+            end = offset + rows
+            idx += 1
+            while idx < n_segments and self.segments[idx][0] == PLAIN:
+                next_offset, next_rows, _, _ = self.segments[idx][1]
+                if next_offset != end:
+                    break
+                end += next_rows
+                idx += 1
+            outputs.append(
+                dense.linear_plain_invariant_k31(x, layer.plain_weight[offset:end])
+            )
+        if self.padding:
+            outputs.append(x.new_zeros((x.shape[0], self.padding)))
+        output = torch.cat(outputs, dim=-1)
+        if bias is not None:
+            output = output + bias
+        return output.reshape(*shape, output.shape[-1])
