+// ---------------------------------------------------------------------------
+// Kernel 2a: p2p_moe_dual_reduce_rmsnorm (decode register-cached fast path)
+// ---------------------------------------------------------------------------
+
+template <int RANK, bool IS_SHM, bool HAS_RES, bool WEIGHT_FP32>
+__global__ __launch_bounds__(kBlockThreads, 2)
+void p2p_moe_dual_fast_kernel(
+    const uint4* routed_partial,
+    const uint4* shared_partial,
+    const void* __restrict__ rms_weight,
+    const uint4* residual,
+    uint4* out_routed_normed,
+    uint4* out_shared_sum,
+    uint4* out_shared_res,
+    uint8_t* __restrict__ my_inbox,
+    FlagLine* __restrict__ my_flags,
+    uint8_t* __restrict__ peer_inbox,
+    FlagLine* __restrict__ peer_flags,
+    DeviceControlState* __restrict__ dev_ctrl,
+    HostMappedControl* __restrict__ host_ctrl,
+    uint64_t slot_bytes,
+    uint32_t expected_gen,
+    int M,
+    int r_vecs,
+    int s_vecs,
+    int routed_ctas,
+    int shared_ctas,
+    float eps,
+    bool write_shared_sum) {
+  __shared__ uint64_t s_base_seq;
+  __shared__ uint32_t s_err;
+  __shared__ float s_warp_sq[kBlockThreads / 32];
+  static_assert(sizeof(s_base_seq) + sizeof(s_err) + sizeof(s_warp_sq) <= 48 * 1024, "SMEM cap");
+
+  const int bid = blockIdx.x;
+  const int tid = threadIdx.x;
+
+  if (tid == 0) {
+    s_base_seq = ld_acquire_gpu_u64(&dev_ctrl->ar_op_seq);
+    s_err = check_entry_status(dev_ctrl, host_ctrl, expected_gen);
+  }
+  __syncthreads();
+  const uint64_t seq = s_base_seq + 1ull;
+
+  if (bid < routed_ctas) {
+    const int base_rows = M / routed_ctas;
+    const int rem_rows = M % routed_ctas;
+    const int r_begin = bid * base_rows + (bid < rem_rows ? bid : rem_rows);
+    const int r_count = base_rows + (bid < rem_rows ? 1 : 0);
+    const int row_off0 = r_begin * r_vecs;
+    const int total_r_vecs = r_count * r_vecs;
+
+    if (s_err != 0u) {
+      poison_v4_stripe(out_routed_normed, row_off0, total_r_vecs, tid);
+    } else {
+      const int slot = static_cast<int>(seq & kSlotMask);
+      const uint64_t flag_val = pack_flag(seq, kOpKindMoeFast);
+      uint4* peer_slot = reinterpret_cast<uint4*>(peer_inbox + static_cast<size_t>(slot) * slot_bytes);
+      const uint4* my_slot = reinterpret_cast<const uint4*>(my_inbox + static_cast<size_t>(slot) * slot_bytes);
+
+      const bool has0 = (tid < r_vecs);
+      const bool has1 = (tid + kBlockThreads < r_vecs);
+      uint4 loc0 = {}, loc1 = {};
+
+      if (r_count == 1) {
+        if (has0) loc0 = ld_local_v4(routed_partial + row_off0 + tid);
+        if (has1) loc1 = ld_local_v4(routed_partial + row_off0 + tid + kBlockThreads);
+        if (has0) st_peer_v4<IS_SHM>(peer_slot + row_off0 + tid, loc0);
+        if (has1) st_peer_v4<IS_SHM>(peer_slot + row_off0 + tid + kBlockThreads, loc1);
+      } else {
+        int i = tid;
+        for (; i + kBlockThreads < total_r_vecs; i += 2 * kBlockThreads) {
+          uint4 v0 = ld_local_v4(routed_partial + row_off0 + i);
+          uint4 v1 = ld_local_v4(routed_partial + row_off0 + i + kBlockThreads);
+          st_peer_v4<IS_SHM>(peer_slot + row_off0 + i, v0);
+          st_peer_v4<IS_SHM>(peer_slot + row_off0 + i + kBlockThreads, v1);
+        }
+        if (i < total_r_vecs) {
+          uint4 v0 = ld_local_v4(routed_partial + row_off0 + i);
+          st_peer_v4<IS_SHM>(peer_slot + row_off0 + i, v0);
+        }
+      }
+
+      __syncthreads();
+      if (tid == 0) {
+        st_release_sys_u64(&peer_flags[slot * kFixedGrid + bid].val, flag_val);
+      }
+
+      uint4 w_raw0 = {}, w_raw1 = {};
+      float w_f0[8], w_f1[8];
+      if constexpr (!WEIGHT_FP32) {
+        const uint4* wb = reinterpret_cast<const uint4*>(rms_weight);
+        if (has0) w_raw0 = ld_local_v4(wb + tid);
+        if (has1) w_raw1 = ld_local_v4(wb + tid + kBlockThreads);
+      } else {
+        if (has0) load_rms_weight_8<true>(rms_weight, tid, w_f0);
+        if (has1) load_rms_weight_8<true>(rms_weight, tid + kBlockThreads, w_f1);
+      }
+
+      if (tid == 0) {
+        s_err = wait_for_peer_flag(my_flags, slot, bid, flag_val, dev_ctrl, host_ctrl, expected_gen);
+      }
+      __syncthreads();
+      if (s_err != 0u) {
+        poison_v4_stripe(out_routed_normed, row_off0, total_r_vecs, tid);
+      } else {
+        if constexpr (!WEIGHT_FP32) {
+          if (has0) {
+            float2 wp0 = bf16x2_to_f32x2(w_raw0.x);
+            float2 wp1 = bf16x2_to_f32x2(w_raw0.y);
+            float2 wp2 = bf16x2_to_f32x2(w_raw0.z);
+            float2 wp3 = bf16x2_to_f32x2(w_raw0.w);
+            w_f0[0] = wp0.x; w_f0[1] = wp0.y; w_f0[2] = wp1.x; w_f0[3] = wp1.y;
+            w_f0[4] = wp2.x; w_f0[5] = wp2.y; w_f0[6] = wp3.x; w_f0[7] = wp3.y;
+          }
+          if (has1) {
+            float2 wp0 = bf16x2_to_f32x2(w_raw1.x);
+            float2 wp1 = bf16x2_to_f32x2(w_raw1.y);
+            float2 wp2 = bf16x2_to_f32x2(w_raw1.z);
+            float2 wp3 = bf16x2_to_f32x2(w_raw1.w);
+            w_f1[0] = wp0.x; w_f1[1] = wp0.y; w_f1[2] = wp1.x; w_f1[3] = wp1.y;
+            w_f1[4] = wp2.x; w_f1[5] = wp2.y; w_f1[6] = wp3.x; w_f1[7] = wp3.y;
+          }
+        }
+
+        for (int rr = 0; rr < r_count; ++rr) {
+          const int cur_off = row_off0 + rr * r_vecs;
+          uint4 c_loc0 = loc0;
+          uint4 c_loc1 = loc1;
+          if (r_count > 1) {
+            if (has0) c_loc0 = ld_local_v4(routed_partial + cur_off + tid);
+            if (has1) c_loc1 = ld_local_v4(routed_partial + cur_off + tid + kBlockThreads);
+          }
+
+          float sq = 0.0f;
+          float s0[8], s1[8];
+          uint4 p0 = {}, p1 = {};
+          if (has0) p0 = ld_peer_v4<IS_SHM>(my_slot + cur_off + tid);
+          if (has1) p1 = ld_peer_v4<IS_SHM>(my_slot + cur_off + tid + kBlockThreads);
+          if (has0) {
+            float2 a0 = fixed_add_pair<RANK>(c_loc0.x, p0.x);
+            float2 a1 = fixed_add_pair<RANK>(c_loc0.y, p0.y);
+            float2 a2 = fixed_add_pair<RANK>(c_loc0.z, p0.z);
+            float2 a3 = fixed_add_pair<RANK>(c_loc0.w, p0.w);
+            s0[0] = a0.x; s0[1] = a0.y; s0[2] = a1.x; s0[3] = a1.y;
+            s0[4] = a2.x; s0[5] = a2.y; s0[6] = a3.x; s0[7] = a3.y;
+#pragma unroll
+            for (int k = 0; k < 8; ++k) sq += s0[k] * s0[k];
+          }
+          if (has1) {
+            float2 b0 = fixed_add_pair<RANK>(c_loc1.x, p1.x);
+            float2 b1 = fixed_add_pair<RANK>(c_loc1.y, p1.y);
+            float2 b2 = fixed_add_pair<RANK>(c_loc1.z, p1.z);
+            float2 b3 = fixed_add_pair<RANK>(c_loc1.w, p1.w);
+            s1[0] = b0.x; s1[1] = b0.y; s1[2] = b1.x; s1[3] = b1.y;
+            s1[4] = b2.x; s1[5] = b2.y; s1[6] = b3.x; s1[7] = b3.y;
+#pragma unroll
+            for (int k = 0; k < 8; ++k) sq += s1[k] * s1[k];
+          }
+
+          const float total_sq = block_reduce_sum_deterministic(sq, s_warp_sq);
+          const float inv_rms = rsqrtf(total_sq / static_cast<float>(r_vecs * 8) + eps);
+
+          if (has0) {
+            uint4 out0;
+            out0.x = f32x2_to_bf16x2((s0[0] * inv_rms) * w_f0[0], (s0[1] * inv_rms) * w_f0[1]);
+            out0.y = f32x2_to_bf16x2((s0[2] * inv_rms) * w_f0[2], (s0[3] * inv_rms) * w_f0[3]);
+            out0.z = f32x2_to_bf16x2((s0[4] * inv_rms) * w_f0[4], (s0[5] * inv_rms) * w_f0[5]);
+            out0.w = f32x2_to_bf16x2((s0[6] * inv_rms) * w_f0[6], (s0[7] * inv_rms) * w_f0[7]);
+            st_local_v4(out_routed_normed + cur_off + tid, out0);
+          }
+          if (has1) {
+            uint4 out1;
+            out1.x = f32x2_to_bf16x2((s1[0] * inv_rms) * w_f1[0], (s1[1] * inv_rms) * w_f1[1]);
+            out1.y = f32x2_to_bf16x2((s1[2] * inv_rms) * w_f1[2], (s1[3] * inv_rms) * w_f1[3]);
+            out1.z = f32x2_to_bf16x2((s1[4] * inv_rms) * w_f1[4], (s1[5] * inv_rms) * w_f1[5]);
+            out1.w = f32x2_to_bf16x2((s1[6] * inv_rms) * w_f1[6], (s1[7] * inv_rms) * w_f1[7]);
+            st_local_v4(out_routed_normed + cur_off + tid + kBlockThreads, out1);
+          }
+          if (rr + 1 < r_count) {
+            __syncthreads();
+          }
+        }
+      }
+    }
+  } else if (bid < routed_ctas + shared_ctas) {
+    const int sbid = bid - routed_ctas;
+    const int shared_total_vecs = M * s_vecs;
+    const int shared_base_in_slot = (M * r_vecs + 7) & ~7;
+    int v_start = 0, v_count = 0;
+    partition_aligned_128b(shared_total_vecs, shared_ctas, sbid, v_start, v_count);
+
+    if (s_err != 0u) {
+      if (write_shared_sum) poison_v4_stripe(out_shared_sum, v_start, v_count, tid);
+      if constexpr (HAS_RES) poison_v4_stripe(out_shared_res, v_start, v_count, tid);
+    } else {
+      const int slot = static_cast<int>(seq & kSlotMask);
+      const uint64_t flag_val = pack_flag(seq, kOpKindMoeFast);
+      uint4* peer_slot = reinterpret_cast<uint4*>(peer_inbox + static_cast<size_t>(slot) * slot_bytes);
+      const uint4* my_slot = reinterpret_cast<const uint4*>(my_inbox + static_cast<size_t>(slot) * slot_bytes);
+
+      if (v_count <= 4 * kBlockThreads) {
+        uint4 loc_reg[4];
+#pragma unroll
+        for (int k = 0; k < 4; k += 2) {
+          const int idx0 = tid + k * kBlockThreads;
+          const int idx1 = tid + (k + 1) * kBlockThreads;
+          const bool h0 = (idx0 < v_count);
+          const bool h1 = (idx1 < v_count);
+          if (h0) loc_reg[k] = ld_local_v4(shared_partial + v_start + idx0);
+          if (h1) loc_reg[k + 1] = ld_local_v4(shared_partial + v_start + idx1);
+          if (h0) st_peer_v4<IS_SHM>(peer_slot + shared_base_in_slot + v_start + idx0, loc_reg[k]);
+          if (h1) st_peer_v4<IS_SHM>(peer_slot + shared_base_in_slot + v_start + idx1, loc_reg[k + 1]);
+        }
+
+        __syncthreads();
+        if (tid == 0) {
+          st_release_sys_u64(&peer_flags[slot * kFixedGrid + bid].val, flag_val);
+          s_err = wait_for_peer_flag(my_flags, slot, bid, flag_val, dev_ctrl, host_ctrl, expected_gen);
+        }
+        __syncthreads();
+        if (s_err != 0u) {
+          if (write_shared_sum) poison_v4_stripe(out_shared_sum, v_start, v_count, tid);
+          if constexpr (HAS_RES) poison_v4_stripe(out_shared_res, v_start, v_count, tid);
+        } else {
+#pragma unroll
+          for (int k = 0; k < 4; k += 2) {
+            const int idx0 = tid + k * kBlockThreads;
+            const int idx1 = tid + (k + 1) * kBlockThreads;
+            const bool h0 = (idx0 < v_count);
+            const bool h1 = (idx1 < v_count);
+            uint4 p0 = {}, p1 = {};
+            uint4 r0 = {}, r1 = {};
+            if (h0) p0 = ld_peer_v4<IS_SHM>(my_slot + shared_base_in_slot + v_start + idx0);
+            if (h1) p1 = ld_peer_v4<IS_SHM>(my_slot + shared_base_in_slot + v_start + idx1);
+            if constexpr (HAS_RES) {
+              if (h0) r0 = ld_local_v4(residual + v_start + idx0);
+              if (h1) r1 = ld_local_v4(residual + v_start + idx1);
+            }
+            if (h0) {
+              reduce_and_store_v4<RANK, HAS_RES>(
+                  loc_reg[k], p0, r0,
+                  out_shared_sum + v_start + idx0,
+                  HAS_RES ? (out_shared_res + v_start + idx0) : nullptr,
+                  write_shared_sum);
+            }
+            if (h1) {
+              reduce_and_store_v4<RANK, HAS_RES>(
+                  loc_reg[k + 1], p1, r1,
+                  out_shared_sum + v_start + idx1,
+                  HAS_RES ? (out_shared_res + v_start + idx1) : nullptr,
+                  write_shared_sum);
+            }
+          }
+        }
+      } else {
+        int i = tid;
+        for (; i + kBlockThreads < v_count; i += 2 * kBlockThreads) {
+          uint4 v0 = ld_local_v4(shared_partial + v_start + i);
+          uint4 v1 = ld_local_v4(shared_partial + v_start + i + kBlockThreads);
+          st_peer_v4<IS_SHM>(peer_slot + shared_base_in_slot + v_start + i, v0);
+          st_peer_v4<IS_SHM>(peer_slot + shared_base_in_slot + v_start + i + kBlockThreads, v1);
+        }
+        if (i < v_count) {
+          uint4 v0 = ld_local_v4(shared_partial + v_start + i);
+          st_peer_v4<IS_SHM>(peer_slot + shared_base_in_slot + v_start + i, v0);
+        }
+        __syncthreads();
+        if (tid == 0) {
+          st_release_sys_u64(&peer_flags[slot * kFixedGrid + bid].val, flag_val);
+          s_err = wait_for_peer_flag(my_flags, slot, bid, flag_val, dev_ctrl, host_ctrl, expected_gen);
+        }
+        __syncthreads();
+        if (s_err != 0u) {
+          if (write_shared_sum) poison_v4_stripe(out_shared_sum, v_start, v_count, tid);
+          if constexpr (HAS_RES) poison_v4_stripe(out_shared_res, v_start, v_count, tid);
+        } else {
+          int j = tid;
+          for (; j + kBlockThreads < v_count; j += 2 * kBlockThreads) {
+            uint4 loc0 = ld_local_v4(shared_partial + v_start + j);
+            uint4 loc1 = ld_local_v4(shared_partial + v_start + j + kBlockThreads);
+            uint4 p0 = ld_peer_v4<IS_SHM>(my_slot + shared_base_in_slot + v_start + j);
+            uint4 p1 = ld_peer_v4<IS_SHM>(my_slot + shared_base_in_slot + v_start + j + kBlockThreads);
+            uint4 r0 = {}, r1 = {};
+            if constexpr (HAS_RES) {
+              r0 = ld_local_v4(residual + v_start + j);
+              r1 = ld_local_v4(residual + v_start + j + kBlockThreads);
+            }
+            reduce_and_store_v4<RANK, HAS_RES>(
+                loc0, p0, r0,
+                out_shared_sum + v_start + j,
+                HAS_RES ? (out_shared_res + v_start + j) : nullptr,
+                write_shared_sum);
+            reduce_and_store_v4<RANK, HAS_RES>(
+                loc1, p1, r1,
+                out_shared_sum + v_start + j + kBlockThreads,
+                HAS_RES ? (out_shared_res + v_start + j + kBlockThreads) : nullptr,
+                write_shared_sum);
+          }
+          if (j < v_count) {
+            uint4 loc_v = ld_local_v4(shared_partial + v_start + j);
+            uint4 peer_v = ld_peer_v4<IS_SHM>(my_slot + shared_base_in_slot + v_start + j);
+            uint4 r_v = {};
+            if constexpr (HAS_RES) r_v = ld_local_v4(residual + v_start + j);
+            reduce_and_store_v4<RANK, HAS_RES>(
+                loc_v, peer_v, r_v,
+                out_shared_sum + v_start + j,
+                HAS_RES ? (out_shared_res + v_start + j) : nullptr,
+                write_shared_sum);
+          }
+        }
+      }
+    }
+  }
+
+  ar_grid_commit(dev_ctrl, seq, tid);
+}
