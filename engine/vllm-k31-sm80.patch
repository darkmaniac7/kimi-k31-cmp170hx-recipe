+def _synthetic_dump(path, *, anchors, first_pos, seed, depth=8, beam=8):
+    """A dump in dspark_tree_rank_dump.py's format from a toy drafter whose
+    probabilities are exact: the true token is candidate r of the true parent
+    with that candidate's probability."""
+    import numpy as np
+
+    rng = np.random.default_rng(seed)
+    keys = ("truth actual consistent tf_rank tf_q_truth tf_topq tf_conf n_par par_prev "
+            "par_tok par_pathq par_conf child_tok child_q").split()
+    rows = {k: [] for k in keys}
+    fresh = iter(range(10, 10**9))
+    for _ in range(anchors):
+        r = dict(
+            truth=np.zeros(depth, np.int64), actual=np.zeros(depth, np.int64),
+            consistent=np.ones(depth, np.bool_), tf_rank=np.zeros(depth, np.int32),
+            tf_q_truth=np.zeros(depth, np.float32), tf_topq=np.zeros((depth, 8), np.float32),
+            tf_conf=np.zeros(depth, np.float32), n_par=np.zeros(depth, np.int32),
+            par_prev=np.full((depth, beam), -1, np.int32),
+            par_tok=np.full((depth, beam), -1, np.int64),
+            par_pathq=np.zeros((depth, beam), np.float32),
+            par_conf=np.zeros((depth, beam), np.float32),
+            child_tok=np.full((depth, beam, 3), -1, np.int64),
+            child_q=np.zeros((depth, beam, 3), np.float32),
+        )
+        beam_tok, beam_pathq, beam_prev = [next(fresh)], [1.0], [-1]
+        true_slot = 0  # beam slot of the true path's node, or -1
+        for j in range(depth):
+            nb = len(beam_tok)
+            q0 = rng.uniform(0.35, 0.97, nb)
+            q1 = (1 - q0) * rng.uniform(0.2, 0.8, nb)
+            q2 = (1 - q0 - q1) * rng.uniform(0.2, 0.8, nb)
+            cq = np.stack([q0, q1, q2], axis=1)
+            ct = np.asarray([[next(fresh) for _ in range(3)] for _ in range(nb)])
+            r["n_par"][j] = nb
+            r["par_prev"][j, :nb] = beam_prev
+            r["par_tok"][j, :nb] = beam_tok
+            r["par_pathq"][j, :nb] = beam_pathq
+            r["par_conf"][j, :nb] = q0
+            r["child_tok"][j, :nb] = ct
+            r["child_q"][j, :nb] = cq
+            if true_slot >= 0:
+                probs = list(cq[true_slot]) + [1 - cq[true_slot].sum()]
+                rank = int(rng.choice(4, p=np.asarray(probs) / sum(probs)))
+                tok = int(ct[true_slot, rank]) if rank < 3 else next(fresh)
+                r["tf_conf"][j] = q0[true_slot]
+                r["tf_q_truth"][j] = probs[rank]
+                flat = true_slot * 3 + rank if rank < 3 else -1
+            else:
+                rank = 0 if rng.random() < 0.7 else 4
+                tok, flat = next(fresh), -1
+            r["tf_rank"][j] = rank if rank < 3 else 5
+            r["truth"][j] = r["actual"][j] = tok
+            cand = sorted(
+                ((beam_pathq[b] * cq[b, c], b * 3 + c, int(ct[b, c]))
+                 for b in range(nb) for c in range(3) if (b, c) != (0, 0)),
+                key=lambda x: -x[0],
+            )
+            nxt = [(beam_pathq[0] * cq[0, 0], 0, int(ct[0, 0]))] + cand[: beam - 1]
+            beam_pathq = [x[0] for x in nxt]
+            beam_prev = [x[1] for x in nxt]
+            beam_tok = [x[2] for x in nxt]
+            true_slot = beam_prev.index(flat) if flat in beam_prev else -1
+        for k in keys:
+            rows[k].append(r[k])
+    packed = {k: np.stack(v) for k, v in rows.items()}
+    packed["meta"] = np.asarray(
+        [(0, first_pos + i, 0, 1, seed) for i in range(anchors)], dtype=np.int64
+    )
+    np.savez_compressed(path, **packed)
+
