+def test_m12_single_corrupted_row_with_passing_cos_mean_fails_cos_min() -> None:
+    """One garbage row in 64 hides behind cos_mean >= 0.85 but must FAIL cos_min floor."""
+    ref_dump, cand_dump = _make_synthetic_93_layer_pair(n_tokens=64, hidden=64)
+    # Negate a single token row at L40: 63 healthy rows (~0.93) + 1 negated row (-0.93)
+    # yields cos_mean ~ 0.90 (passing >= 0.85!) while cos_min ~ -0.93 (< 0.60 floor!).
+    t = cand_dump.tensors["L40.out"].clone()
+    t[17] = -t[17]
+    cand_dump.tensors["L40.out"] = t
+
+    pr = cmp_mod.compare_prompt_dumps(ref_dump, cand_dump)
+    l40 = next(r for r in pr["layer_results"] if r["layer"] == 40)
+    assert l40["metrics"]["cos_mean"] >= cmp_mod.TOLERANCES_V1["layer_out_cosine"]["L16_92"]["pass_min"]
+    assert l40["metrics"]["cos_min"] < cmp_mod.TOLERANCES_V1["layer_out_cosine"]["L16_92"]["cos_min_floor"]
+    assert l40["status"] == "FAIL"
+    assert any("cos_min=" in reason for reason in l40["reasons"])
+    assert pr["status"] == "FAIL"
+
