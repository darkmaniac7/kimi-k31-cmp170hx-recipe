+def test_stages_load_from_the_whole_directory(monkeypatch, meta_platform, checkpoint):
+    """Without views a stage marks every other stage's tensors unused, and
+    across the stages every tensor has exactly one consumer."""
+    directory, _ = checkpoint
+    consumers: dict[str, list[int]] = {}
+    for stage in range(len(PARTITION)):
+        model, config, report, names = _stage_case(monkeypatch, directory, stage, 1, 0)
+        _check_stage_model(model, stage)
+        assert set(report.ledger) == names
+        first = sum(PARTITION[:stage])
+        for name, (use, reason) in report.ledger.items():
+            if use == "consumed":
+                consumers.setdefault(name, []).append(stage)
+                continue
+            if name.startswith("vq."):
+                assert reason == "no VQ layer of this stage uses this codebook"
+            elif ".layers." in name:
+                layer = int(name.split(".layers.")[1].split(".")[0])
+                assert not first <= layer < first + PARTITION[stage]
+                assert reason == "layer of another pipeline stage"
+            else:
+                assert reason == "module is not built on this pipeline stage"
+                assert (stage != 0) if "embed_tokens" in name else (stage != 2)
+    books = {n for n in names if n.startswith("vq.")}
+    assert set(consumers) == names
+    assert all(len(stages) == 1 for n, stages in consumers.items() if n not in books)
+
