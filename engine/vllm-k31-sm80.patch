+void fused_kda_decode(
+    const at::Tensor& mixed_qkv,
+    at::Tensor conv_state,
+    const at::Tensor& conv_weight,
+    const std::optional<at::Tensor>& conv_bias,
+    const at::Tensor& raw_g,
+    const at::Tensor& raw_beta,
+    const at::Tensor& A_log,
+    const at::Tensor& dt_bias,
+    const at::Tensor& g2,
+    const at::Tensor& norm_weight,
+    at::Tensor recurrent_state,
+    const at::Tensor& state_indices,
+    double lower_bound,
+    double norm_eps,
+    at::Tensor out) {
+  TORCH_CHECK(mixed_qkv.is_cuda() && mixed_qkv.scalar_type() == at::kBFloat16 &&
+                  mixed_qkv.dim() == 2 && mixed_qkv.stride(1) == 1,
+              "mixed_qkv must be CUDA BF16 [B, 3*H*128] with stride(-1)==1");
+  const int64_t B = mixed_qkv.size(0);
+  if (B == 0) return;
+
+  TORCH_CHECK(recurrent_state.is_cuda() && recurrent_state.scalar_type() == at::kFloat &&
+                  recurrent_state.dim() == 4,
+              "recurrent_state must be CUDA FP32 [cache, H, 128, 128]");
+  const int64_t H = recurrent_state.size(1);
+  const int64_t D = recurrent_state.size(2);
+  TORCH_CHECK(D == 128 && recurrent_state.size(3) == 128, "fused_kda_decode requires head_dim==128");
+  TORCH_CHECK(recurrent_state.stride(3) == 1 && recurrent_state.stride(2) == 128 &&
+                  recurrent_state.stride(1) == 128 * 128,
+              "recurrent_state must be contiguous within each slot");
+  const int64_t C = 3 * H * D;
+  TORCH_CHECK(mixed_qkv.size(1) == C, "mixed_qkv dim 1 must equal 3*H*128");
+
+  // Support both dim-first [cache, C, 3] and step-first [cache, 3, C] conv_state layouts.
+  TORCH_CHECK(conv_state.is_cuda() && conv_state.scalar_type() == at::kBFloat16 &&
+                  conv_state.dim() == 3,
+              "conv_state must be CUDA BF16 3D");
+  int64_t stride_cs_slot = conv_state.stride(0);
+  int64_t stride_cs_c = 0;
+  int64_t stride_cs_t = 0;
+  if (conv_state.size(1) == C && conv_state.size(2) == 3) {
+    stride_cs_c = conv_state.stride(1);
+    stride_cs_t = conv_state.stride(2);
+  } else if (conv_state.size(1) == 3 && conv_state.size(2) == C) {
+    stride_cs_t = conv_state.stride(1);
+    stride_cs_c = conv_state.stride(2);
+  } else {
+    TORCH_CHECK(false, "conv_state must have shape [cache, 3*H*128, 3] or [cache, 3, 3*H*128]");
+  }
+
+  TORCH_CHECK(conv_weight.is_cuda() &&
+                  (conv_weight.scalar_type() == at::kBFloat16 || conv_weight.scalar_type() == at::kFloat) &&
+                  conv_weight.dim() == 2 && conv_weight.size(0) == C &&
+                  conv_weight.size(1) == 4 && conv_weight.stride(1) == 1,
+              "conv_weight must be CUDA BF16/FP32 [3*H*128, 4] with stride(-1)==1");
+  const bool conv_w_fp32 = (conv_weight.scalar_type() == at::kFloat);
+
+  const void* cb_ptr = nullptr;
+  bool conv_b_fp32 = false;
+  if (conv_bias.has_value() && conv_bias->defined()) {
+    TORCH_CHECK(conv_bias->is_cuda() &&
+                    (conv_bias->scalar_type() == at::kBFloat16 || conv_bias->scalar_type() == at::kFloat) &&
+                    conv_bias->numel() == C && conv_bias->is_contiguous(),
+                "conv_bias shape/dtype mismatch");
+    cb_ptr = conv_bias->data_ptr();
+    conv_b_fp32 = (conv_bias->scalar_type() == at::kFloat);
+  }
+
+  TORCH_CHECK(raw_g.is_cuda() && raw_g.scalar_type() == at::kBFloat16 &&
+                  raw_g.dim() == 3 && raw_g.size(0) == B && raw_g.size(1) == H &&
+                  raw_g.size(2) == D && raw_g.stride(2) == 1 && raw_g.stride(1) == D,
+              "raw_g must be CUDA BF16 [B, H, 128]");
+  TORCH_CHECK(raw_beta.is_cuda() && raw_beta.scalar_type() == at::kBFloat16 &&
+                  raw_beta.dim() == 2 && raw_beta.size(0) == B && raw_beta.size(1) == H &&
+                  raw_beta.stride(1) == 1,
+              "raw_beta must be CUDA BF16 [B, H]");
+  TORCH_CHECK(g2.is_cuda() && g2.scalar_type() == at::kBFloat16 &&
+                  g2.dim() == 3 && g2.size(0) == B && g2.size(1) == H &&
+                  g2.size(2) == D && g2.stride(2) == 1 && g2.stride(1) == D,
+              "g2 must be CUDA BF16 [B, H, 128]");
+  TORCH_CHECK(out.is_cuda() && out.scalar_type() == at::kBFloat16 &&
+                  out.dim() == 3 && out.size(0) == B && out.size(1) == H &&
+                  out.size(2) == D && out.stride(2) == 1 && out.stride(1) == D,
+              "out must be CUDA BF16 [B, H, 128]");
+
+  TORCH_CHECK(A_log.is_cuda() && A_log.is_contiguous() && A_log.numel() == H &&
+                  (A_log.scalar_type() == at::kFloat || A_log.scalar_type() == at::kBFloat16),
+              "A_log must be CUDA FP32/BF16 [H]");
+  TORCH_CHECK(dt_bias.is_cuda() && dt_bias.is_contiguous() && dt_bias.numel() == H * D &&
+                  (dt_bias.scalar_type() == at::kFloat || dt_bias.scalar_type() == at::kBFloat16),
+              "dt_bias must be CUDA FP32/BF16 [H*128]");
+  TORCH_CHECK(norm_weight.is_cuda() && norm_weight.is_contiguous() && norm_weight.numel() == D &&
+                  (norm_weight.scalar_type() == at::kFloat ||
+                   norm_weight.scalar_type() == at::kBFloat16),
+              "norm_weight must be CUDA FP32/BF16 [128]");
+  TORCH_CHECK(state_indices.is_cuda() && state_indices.is_contiguous() &&
+                  state_indices.dim() == 1 && state_indices.size(0) == B &&
+                  (state_indices.scalar_type() == at::kInt ||
+                   state_indices.scalar_type() == at::kLong),
+              "state_indices must be CUDA INT32/INT64 [B]");
+
+  const c10::cuda::CUDAGuard device_guard(mixed_qkv.device());
+  cudaStream_t stream = at::cuda::getCurrentCUDAStream();
+
+  TORCH_CHECK(is_aligned_16(recurrent_state.data_ptr()) && (recurrent_state.stride(0) % 4 == 0),
+              "recurrent_state must be 16-byte aligned with slot stride multiple of 4 floats");
+  TORCH_CHECK(B * H <= 2147483647LL, "B * H exceeds CUDA gridDim.x limit");
+  const int grid_x = static_cast<int>(B * H);
+  k31_fused_kda_decode_d128_kernel<<<grid_x, 256, 0, stream>>>(
+      reinterpret_cast<const __nv_bfloat16*>(mixed_qkv.data_ptr()),
+      reinterpret_cast<__nv_bfloat16*>(conv_state.data_ptr()),
+      conv_weight.data_ptr(),
+      cb_ptr,
+      reinterpret_cast<const __nv_bfloat16*>(raw_g.data_ptr()),
+      reinterpret_cast<const __nv_bfloat16*>(raw_beta.data_ptr()),
+      A_log.data_ptr(),
+      dt_bias.data_ptr(),
+      reinterpret_cast<const __nv_bfloat16*>(g2.data_ptr()),
+      norm_weight.data_ptr(),
+      recurrent_state.data_ptr<float>(),
+      state_indices.data_ptr(),
+      mixed_qkv.stride(0),
+      stride_cs_slot,
+      stride_cs_c,
+      stride_cs_t,
+      conv_weight.stride(0),
+      raw_g.stride(0),
+      raw_beta.stride(0),
+      g2.stride(0),
+      recurrent_state.stride(0),
+      out.stride(0),
+      static_cast<int>(H),
+      conv_w_fp32,
+      conv_b_fp32,
+      A_log.scalar_type() == at::kFloat,
+      dt_bias.scalar_type() == at::kFloat,
+      norm_weight.scalar_type() == at::kFloat,
+      state_indices.scalar_type() == at::kLong,
+      lower_bound < 0.0,
+      static_cast<float>(lower_bound),
+      static_cast<float>(norm_eps),
+      reinterpret_cast<__nv_bfloat16*>(out.data_ptr()));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void fused_kda_spec_verify(
+    const at::Tensor& mixed_qkv,
+    at::Tensor conv_state,
+    const at::Tensor& conv_weight,
+    const std::optional<at::Tensor>& conv_bias,
+    const at::Tensor& raw_g,
+    const at::Tensor& raw_beta,
+    const at::Tensor& A_log,
+    const at::Tensor& dt_bias,
+    const at::Tensor& g2,
+    const at::Tensor& norm_weight,
+    at::Tensor recurrent_state,
+    const at::Tensor& spec_state_indices,
+    const at::Tensor& query_start_loc,
+    const at::Tensor& num_accepted_tokens,
+    double lower_bound,
+    double norm_eps,
+    at::Tensor out) {
+  TORCH_CHECK(mixed_qkv.is_cuda() && mixed_qkv.scalar_type() == at::kBFloat16 &&
+                  mixed_qkv.dim() == 2 && mixed_qkv.stride(1) == 1,
+              "mixed_qkv must be CUDA BF16 [T, 3*H*128] with stride(-1)==1");
+  TORCH_CHECK(query_start_loc.is_cuda() && query_start_loc.is_contiguous() &&
+                  query_start_loc.dim() == 1 && query_start_loc.size(0) >= 1 &&
+                  (query_start_loc.scalar_type() == at::kInt ||
+                   query_start_loc.scalar_type() == at::kLong),
+              "query_start_loc must be contiguous CUDA INT32/INT64 [N+1]");
+  const int64_t T = mixed_qkv.size(0);
+  const int64_t N = query_start_loc.size(0) - 1;
+  if (N == 0 || T == 0) return;
+
+  TORCH_CHECK(recurrent_state.is_cuda() && recurrent_state.scalar_type() == at::kFloat &&
+                  recurrent_state.dim() == 4,
+              "recurrent_state must be CUDA FP32 [cache, H, 128, 128]");
+  const int64_t H = recurrent_state.size(1);
+  const int64_t D = recurrent_state.size(2);
+  TORCH_CHECK(D == 128 && recurrent_state.size(3) == 128,
+              "fused_kda_spec_verify requires head_dim==128");
+  TORCH_CHECK(recurrent_state.stride(3) == 1 && recurrent_state.stride(2) == 128 &&
+                  recurrent_state.stride(1) == 128 * 128,
+              "recurrent_state must be contiguous within each slot");
+  const int64_t C = 3 * H * D;
+  TORCH_CHECK(mixed_qkv.size(1) == C, "mixed_qkv dim 1 must equal 3*H*128");
+
+  TORCH_CHECK(spec_state_indices.is_cuda() && spec_state_indices.dim() == 2 &&
+                  spec_state_indices.size(0) >= N && spec_state_indices.size(1) >= 1 &&
+                  spec_state_indices.stride(1) == 1 &&
+                  (spec_state_indices.scalar_type() == at::kInt ||
+                   spec_state_indices.scalar_type() == at::kLong),
+              "spec_state_indices must be CUDA INT32/INT64 [>=N, S_cols>=1] with stride(1)==1");
+  const int64_t S_cols = spec_state_indices.size(1);
+  const int64_t min_cs_len = 2 + S_cols;
+
+  TORCH_CHECK(num_accepted_tokens.is_cuda() && num_accepted_tokens.is_contiguous() &&
+                  num_accepted_tokens.dim() == 1 && num_accepted_tokens.size(0) >= N &&
+                  (num_accepted_tokens.scalar_type() == at::kInt ||
+                   num_accepted_tokens.scalar_type() == at::kLong),
+              "num_accepted_tokens must be contiguous CUDA INT32/INT64 [>=N]");
+
+  // Support both dim-first [cache, C, state_len] and step-first [cache, state_len, C].
+  TORCH_CHECK(conv_state.is_cuda() && conv_state.scalar_type() == at::kBFloat16 &&
+                  conv_state.dim() == 3,
+              "conv_state must be CUDA BF16 3D");
+  int64_t stride_cs_slot = conv_state.stride(0);
+  int64_t stride_cs_c = 0;
+  int64_t stride_cs_t = 0;
+  int64_t conv_state_len = 0;
+  if (conv_state.size(1) == C && conv_state.size(2) >= min_cs_len) {
+    stride_cs_c = conv_state.stride(1);
+    stride_cs_t = conv_state.stride(2);
+    conv_state_len = conv_state.size(2);
+  } else if (conv_state.size(2) == C && conv_state.size(1) >= min_cs_len) {
+    stride_cs_t = conv_state.stride(1);
+    stride_cs_c = conv_state.stride(2);
+    conv_state_len = conv_state.size(1);
+  } else {
+    TORCH_CHECK(false,
+                "conv_state must have shape [cache, 3*H*128, >=2+S_cols] or "
+                "[cache, >=2+S_cols, 3*H*128]");
+  }
+
+  TORCH_CHECK(conv_weight.is_cuda() &&
+                  (conv_weight.scalar_type() == at::kBFloat16 || conv_weight.scalar_type() == at::kFloat) &&
+                  conv_weight.dim() == 2 && conv_weight.size(0) == C &&
+                  conv_weight.size(1) == 4 && conv_weight.stride(1) == 1,
+              "conv_weight must be CUDA BF16/FP32 [3*H*128, 4] with stride(-1)==1");
+  const bool conv_w_fp32 = (conv_weight.scalar_type() == at::kFloat);
+
+  const void* cb_ptr = nullptr;
+  bool conv_b_fp32 = false;
+  if (conv_bias.has_value() && conv_bias->defined()) {
+    TORCH_CHECK(conv_bias->is_cuda() &&
+                    (conv_bias->scalar_type() == at::kBFloat16 || conv_bias->scalar_type() == at::kFloat) &&
+                    conv_bias->numel() == C && conv_bias->is_contiguous(),
+                "conv_bias shape/dtype mismatch");
+    cb_ptr = conv_bias->data_ptr();
+    conv_b_fp32 = (conv_bias->scalar_type() == at::kFloat);
+  }
+
+  TORCH_CHECK(raw_g.is_cuda() && raw_g.scalar_type() == at::kBFloat16 &&
+                  raw_g.dim() == 3 && raw_g.size(0) == T && raw_g.size(1) == H &&
+                  raw_g.size(2) == D && raw_g.stride(2) == 1 && raw_g.stride(1) == D,
+              "raw_g must be CUDA BF16 [T, H, 128]");
+  TORCH_CHECK(raw_beta.is_cuda() && raw_beta.scalar_type() == at::kBFloat16 &&
+                  raw_beta.dim() == 2 && raw_beta.size(0) == T && raw_beta.size(1) == H &&
+                  raw_beta.stride(1) == 1,
+              "raw_beta must be CUDA BF16 [T, H]");
+  TORCH_CHECK(g2.is_cuda() && g2.scalar_type() == at::kBFloat16 &&
+                  g2.dim() == 3 && g2.size(0) == T && g2.size(1) == H &&
+                  g2.size(2) == D && g2.stride(2) == 1 && g2.stride(1) == D,
+              "g2 must be CUDA BF16 [T, H, 128]");
+  TORCH_CHECK(out.is_cuda() && out.scalar_type() == at::kBFloat16 &&
+                  out.dim() == 3 && out.size(0) == T && out.size(1) == H &&
+                  out.size(2) == D && out.stride(2) == 1 && out.stride(1) == D,
+              "out must be CUDA BF16 [T, H, 128]");
+
+  TORCH_CHECK(A_log.is_cuda() && A_log.is_contiguous() && A_log.numel() == H &&
+                  (A_log.scalar_type() == at::kFloat || A_log.scalar_type() == at::kBFloat16),
+              "A_log must be CUDA FP32/BF16 [H]");
+  TORCH_CHECK(dt_bias.is_cuda() && dt_bias.is_contiguous() && dt_bias.numel() == H * D &&
+                  (dt_bias.scalar_type() == at::kFloat || dt_bias.scalar_type() == at::kBFloat16),
+              "dt_bias must be CUDA FP32/BF16 [H*128]");
+  TORCH_CHECK(norm_weight.is_cuda() && norm_weight.is_contiguous() && norm_weight.numel() == D &&
+                  (norm_weight.scalar_type() == at::kFloat ||
+                   norm_weight.scalar_type() == at::kBFloat16),
+              "norm_weight must be CUDA FP32/BF16 [128]");
+
+  const c10::cuda::CUDAGuard device_guard(mixed_qkv.device());
+  cudaStream_t stream = at::cuda::getCurrentCUDAStream();
+
+  TORCH_CHECK(is_aligned_16(recurrent_state.data_ptr()) && (recurrent_state.stride(0) % 4 == 0),
+              "recurrent_state must be 16-byte aligned with slot stride multiple of 4 floats");
+  TORCH_CHECK(N * H <= 2147483647LL, "N * H exceeds CUDA gridDim.x limit");
+  const int64_t bh_total = N * H;
+  const int64_t th_total = T * H;
+  const bool a_log_fp32 = (A_log.scalar_type() == at::kFloat);
+  const bool dt_bias_fp32 = (dt_bias.scalar_type() == at::kFloat);
+  const bool norm_w_fp32 = (norm_weight.scalar_type() == at::kFloat);
+  const bool ssi_i64 = (spec_state_indices.scalar_type() == at::kLong);
+  const bool qsl_i64 = (query_start_loc.scalar_type() == at::kLong);
+  const bool acc_i64 = (num_accepted_tokens.scalar_type() == at::kLong);
+  const bool use_lower_bound = (lower_bound < 0.0);
+
+  constexpr int kSplitV = 8;
+  if (bh_total <= 128 && th_total <= 2048) {
+    const int64_t qkv_elems = th_total * D;
+    const int64_t beta_elems = (th_total + 3) & ~3LL;
+    const int64_t arrive_elems = (bh_total + 3) & ~3LL;
+    const int64_t ws_floats = 4 * qkv_elems + beta_elems + arrive_elems;
+    at::Tensor ws = at::empty(
+        {ws_floats},
+        at::TensorOptions().dtype(at::kFloat).device(mixed_qkv.device()));
+    if (is_aligned_16(ws.data_ptr())) {
+      float* ws_q = ws.data_ptr<float>();
+      float* ws_k = ws_q + qkv_elems;
+      float* ws_v = ws_k + qkv_elems;
+      float* ws_decay = ws_v + qkv_elems;
+      float* ws_beta = ws_decay + qkv_elems;
+      int* arrive_ptr = reinterpret_cast<int*>(ws_beta + beta_elems);
+
+      k31_kda_spec_prep_d128_kernel<<<static_cast<int>(bh_total), 512, 0, stream>>>(
+          reinterpret_cast<const __nv_bfloat16*>(mixed_qkv.data_ptr()),
+          reinterpret_cast<__nv_bfloat16*>(conv_state.data_ptr()),
+          conv_weight.data_ptr(),
+          cb_ptr,
+          reinterpret_cast<const __nv_bfloat16*>(raw_g.data_ptr()),
+          reinterpret_cast<const __nv_bfloat16*>(raw_beta.data_ptr()),
+          A_log.data_ptr(),
+          dt_bias.data_ptr(),
+          spec_state_indices.data_ptr(),
+          query_start_loc.data_ptr(),
+          num_accepted_tokens.data_ptr(),
+          mixed_qkv.stride(0),
+          stride_cs_slot,
+          stride_cs_c,
+          stride_cs_t,
+          conv_weight.stride(0),
+          raw_g.stride(0),
+          raw_beta.stride(0),
+          spec_state_indices.stride(0),
+          T,
+          static_cast<int>(H),
+          static_cast<int>(S_cols),
+          static_cast<int>(conv_state_len),
+          conv_w_fp32,
+          conv_b_fp32,
+          a_log_fp32,
+          dt_bias_fp32,
+          ssi_i64,
+          qsl_i64,
+          acc_i64,
+          use_lower_bound,
+          static_cast<float>(lower_bound),
+          ws_q,
+          ws_k,
+          ws_v,
+          ws_decay,
+          ws_beta,
+          arrive_ptr);
+      C10_CUDA_KERNEL_LAUNCH_CHECK();
+
+      k31_kda_spec_recur_norm_splitv_d128_kernel<kSplitV>
+          <<<static_cast<int>(bh_total * kSplitV), 128, 0, stream>>>(
+              ws_q,
+              ws_k,
+              ws_v,
+              ws_decay,
+              ws_beta,
+              reinterpret_cast<const __nv_bfloat16*>(g2.data_ptr()),
+              norm_weight.data_ptr(),
+              recurrent_state.data_ptr<float>(),
+              spec_state_indices.data_ptr(),
+              query_start_loc.data_ptr(),
+              num_accepted_tokens.data_ptr(),
+              arrive_ptr,
