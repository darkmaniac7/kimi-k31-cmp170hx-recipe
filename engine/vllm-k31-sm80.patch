+
+def test_mla_glue_fused_q_kv_rmsnorm_and_sigmoid_mul(monkeypatch):
+    from vllm.model_executor.layers.mla import MultiHeadLatentAttentionWrapper
+    from vllm.models.kimi_k3.nvidia import mla as kimi_mla
+
+    _clear_env(monkeypatch)
+    fake = FakeGlueOps().install(monkeypatch)
+
+    class _RefRMSNorm(nn.Module):
+        def __init__(self, dim: int, eps: float = 1e-6):
+            super().__init__()
+            self.weight = nn.Parameter(torch.randn(dim, dtype=torch.bfloat16))
+            self.variance_epsilon = eps
+            self.calls = 0
+
+        def forward(self, x: torch.Tensor) -> torch.Tensor:
+            self.calls += 1
+            xf = x.float()
+            rstd = torch.rsqrt(xf.square().mean(dim=-1, keepdim=True) + self.variance_epsilon)
+            return (xf * rstd * self.weight.float()).to(torch.bfloat16)
+
+    M, H, q_rank, kv_rank, rope_dim, n_heads, v_dim = 8, 64, 32, 16, 8, 2, 16
+    w = MultiHeadLatentAttentionWrapper.__new__(MultiHeadLatentAttentionWrapper)
+    nn.Module.__init__(w)
+    w.q_lora_rank = q_rank
+    w.kv_lora_rank = kv_rank
+    w.qk_rope_head_dim = rope_dim
+    w.qk_nope_head_dim = 8
+    w.qk_head_dim = 16
+    w.v_head_dim = v_dim
+    w.num_heads = n_heads
+    w.fuse_qkv_rmsnorm = False
+    w.dcp_q_replicate = False
+    w.rotary_emb = None
+    w.indexer = None
+    w.is_sparse = False
+    w.skip_topk = True
+    w._k31_fused_qkv_a_g_launcher = None
+    w._k31_fused_qkv_a_g_prepared = True
+
+    qkv_out = torch.randn(M, q_rank + kv_rank + rope_dim, dtype=torch.bfloat16)
+    gate_out = torch.randn(M, n_heads * v_dim, dtype=torch.bfloat16)
+    attn_val = torch.randn(M, n_heads * v_dim, dtype=torch.bfloat16)
+
+    w.fused_qkv_a_proj = lambda x: (qkv_out, None)
+    w.q_a_layernorm = _RefRMSNorm(q_rank)
+    w.kv_a_layernorm = _RefRMSNorm(kv_rank)
+    w.q_b_proj = lambda x: (
+        torch.zeros((x.shape[0], n_heads * 16), dtype=torch.bfloat16),
+        None,
+    )
+    seen_kv = []
+
+    def _fake_mla_attn(q, kv_c_normed, k_pe, output_shape, q_dcp_replicated=None):
+        seen_kv.append(kv_c_normed.clone())
+        return attn_val.clone()
+
+    w.mla_attn = _fake_mla_attn
+    w.g_proj = lambda x: (gate_out, None)
+    w.o_proj = lambda x: (x, None)
+
+    x = torch.randn(M, H, dtype=torch.bfloat16)
+    pos = torch.arange(M)
+
+    # Switches OFF: stock RMSNorms + PyTorch sigmoid*mul run.
+    out_off = w.forward(pos, x)
+    assert w.q_a_layernorm.calls == 1
+    assert w.kv_a_layernorm.calls == 1
+    assert len(fake.calls_for("fused_q_kv_rmsnorm")) == 0
+    assert len(fake.calls_for("sigmoid_mul")) == 0
+
+    # VLLM_K31_GLUE_MLA=1: both CUDA glue ops engage with matching output.
+    monkeypatch.setenv("VLLM_K31_GLUE_MLA", "1")
+    out_on = w.forward(pos, x)
+    assert w.q_a_layernorm.calls == 1
+    assert w.kv_a_layernorm.calls == 1
+    assert len(fake.calls_for("fused_q_kv_rmsnorm")) == 1
+    assert len(fake.calls_for("sigmoid_mul")) == 1
+    torch.testing.assert_close(seen_kv[1], seen_kv[0], rtol=1e-2, atol=1e-2)
+    torch.testing.assert_close(out_on, out_off, rtol=1e-2, atol=1e-2)
+
+    # kimi_k3/nvidia/mla._gate_sigmoid_mul also dispatches cleanly.
+    out_km = kimi_mla._gate_sigmoid_mul(attn_val, gate_out)
+    assert len(fake.calls_for("sigmoid_mul")) == 2
+    torch.testing.assert_close(out_km, out_off, rtol=1e-2, atol=1e-2)
+
+    # FakeTensor tracing for both MLA custom ops on non-contiguous slices.
+    with FakeTensorMode():
+        packed = torch.empty((M, q_rank + kv_rank + rope_dim + n_heads * v_dim), dtype=torch.bfloat16)
+        fq, fkv, _, fgate = packed.split([q_rank, kv_rank, rope_dim, n_heads * v_dim], dim=-1)
+        fq_o, fkv_o = torch.ops.vllm.k31_glue_fused_q_kv_rmsnorm(
+            fq,
+            fkv,
+            torch.empty((q_rank,), dtype=torch.bfloat16),
+            torch.empty((kv_rank,), dtype=torch.bfloat16),
+            1e-6,
+            1e-6,
+        )
+        assert fq_o.shape == (M, q_rank) and fq_o.is_contiguous()
+        assert fkv_o.shape == (M, kv_rank) and fkv_o.is_contiguous()
+        fsm = torch.ops.vllm.k31_glue_sigmoid_mul(
+            torch.empty((M, n_heads * v_dim), dtype=torch.bfloat16),
+            fgate,
+        )
+        assert fsm.shape == (M, n_heads * v_dim) and fsm.is_contiguous()
+
+
+# ---------------------------------------------------------------------------
+# 4. KDA in_proj_qkvgfab zero-cat fast path (quant.py + kda.py)
+# ---------------------------------------------------------------------------
+
+
+def test_kda_in_proj_apply_parts_matches_apply_with_zero_cat(monkeypatch):
+    from vllm.sm80.kernels.k31q.quant import EXL3, PLAIN, K31FusedLinearMethod
+
+    _clear_env(monkeypatch)
+    fake = FakeGlueOps().install(monkeypatch)
+    monkeypatch.setenv("VLLM_K31_GLUE_ALL", "1")
+
+    M, H = 8, 64
+    local_proj = 32
+    head_dim = 16
+    local_heads = 8
+    split_sizes = (3 * local_proj, local_proj, head_dim, local_heads)
+
+    qkvg_w = torch.randn(4 * local_proj, H, dtype=torch.bfloat16)
+    plain_w = torch.randn(head_dim + local_heads, H, dtype=torch.bfloat16)
+
+    class _FakeLauncher:
+        def takes(self, rows: int) -> bool:
+            return rows <= 16
+
+        def __call__(self, x: torch.Tensor, out_dtype: torch.dtype) -> torch.Tensor:
+            return F.linear(x.float(), qkvg_w.float()).to(out_dtype)
+
+    method = K31FusedLinearMethod.__new__(K31FusedLinearMethod)
+    method.out_dtype = torch.bfloat16
+    method.padding = 8  # verify padding zeros are skipped cleanly on parts path
+    method.launcher = _FakeLauncher()
+    method.exl3_widths = [local_proj, local_proj, local_proj, local_proj]
+    method.segments = [
+        (EXL3, 0),
+        (EXL3, 1),
+        (EXL3, 2),
+        (EXL3, 3),
+        (PLAIN, (0, head_dim, "f_a.weight", slice(0, head_dim))),
+        (PLAIN, (head_dim, local_heads, "b.weight", slice(0, local_heads))),
+    ]
+    layer = SimpleNamespace(exl3_weights=[None] * 4, plain_weight=plain_w)
+    x = torch.randn(M, H, dtype=torch.bfloat16)
+
+    # Stock apply() + split() reference.
+    full = method.apply(layer, x)
+    ref_parts = full.split([*split_sizes, method.padding], dim=-1)[:4]
+
+    # Zero-cat apply_kda_parts() must NOT call torch.cat.
+    orig_cat = torch.cat
+    cat_calls = []
+
+    def _forbid_cat(*args, **kwargs):
+        cat_calls.append(1)
+        return orig_cat(*args, **kwargs)
+
+    monkeypatch.setattr(torch, "cat", _forbid_cat)
+    parts = method.apply_kda_parts(layer, x, split_sizes)
+    assert parts is not None
+    assert len(cat_calls) == 0
+    assert len(fake.calls_for("bf16_gemv_split2")) == 2
+    for got, ref in zip(parts, ref_parts, strict=True):
+        assert torch.equal(got, ref)
+
+    # When launcher declines (M > 16), apply_kda_parts returns None for clean fallback.
+    big_x = torch.randn(20, H, dtype=torch.bfloat16)
+    assert method.apply_kda_parts(layer, big_x, split_sizes) is None
+
