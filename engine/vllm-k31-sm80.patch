+def test_deferred_pp_request_keeps_all_drafts_and_tier_intact():
+    """Regression for P0 #4: pp_decode_cap deferral must not truncate a
+    deferred request's 12 drafts or mutate its hysteresis tier."""
+    scheduler = _scheduler(
+        _raw(hysteresis=0.5, accept_weight=0.0), async_scheduling=True, pp=4
+    )
+    scheduler.pp_spread_decodes = True
+    r1 = create_requests(num_requests=1, num_tokens=4, max_tokens=200)[0]
+    r2 = create_requests(num_requests=1, num_tokens=4, max_tokens=200)[0]
+    r2.request_id = "req_2"
+    for r in (r1, r2):
+        scheduler.add_request(r)
+    # Prefill both requests so both become running decodes.
+    so0 = scheduler.schedule()
+    assert set(so0.num_scheduled_tokens) == {r1.request_id, r2.request_id}
+    assert scheduler.adaptive_k is not None
+
+    # Set both eligible now with 12 drafts each; r1 asks for tier 3 (conf 0.5),
+    # r2 asks for tier 12 (conf 6.0). With 2 decodes and PP=4, pp_decode_cap=1.
+    r1.next_decode_eligible_step = scheduler.current_step + 1
+    r2.next_decode_eligible_step = scheduler.current_step + 1
+    r1.spec_token_ids = list(range(100, 100 + KMAX))
+    r2.spec_token_ids = list(range(200, 200 + KMAX))
+    step_stamp = scheduler.adaptive_k._steps[r1.request_id]
+    scheduler.adaptive_k.observe_confidence(r1.request_id, step_stamp, _block(0.5))
+    scheduler.adaptive_k.observe_confidence(r2.request_id, step_stamp, _block(6.0))
+    scheduler.adaptive_k._tier.clear()
+
+    # Micro-batch 1: takes only r1 at tier 3; r2 is deferred by pp_decode_cap=1.
+    so1 = scheduler.schedule()
+    assert list(so1.num_scheduled_tokens) == [r1.request_id]
+    assert len(so1.scheduled_spec_decode_tokens[r1.request_id]) == 3
+    # r2 was deferred: all 12 drafts and untouched _tier state!
+    assert len(r2.spec_token_ids) == KMAX
+    assert r2.spec_token_ids == list(range(200, 200 + KMAX))
+    assert r2.request_id not in scheduler.adaptive_k._tier
+
+    # Micro-batch 2: takes r2 and verifies all 12 drafts!
+    so2 = scheduler.schedule()
+    assert list(so2.num_scheduled_tokens) == [r2.request_id]
+    assert len(so2.scheduled_spec_decode_tokens[r2.request_id]) == 12
+
+
+def test_budget_deferred_request_keeps_drafts_and_tier_intact():
+    """Regression for P0 #4: token_budget deferral leaves drafts and _tier intact."""
+    scheduler = _scheduler(
+        _raw(hysteresis=0.5, accept_weight=0.0), async_scheduling=False, pp=1
+    )
+    r1 = create_requests(num_requests=1, num_tokens=4, max_tokens=200)[0]
+    r2 = create_requests(num_requests=1, num_tokens=4, max_tokens=200)[0]
+    r2.request_id = "req_2"
+    for r in (r1, r2):
+        scheduler.add_request(r)
+    so0 = scheduler.schedule()
+    scheduler.update_from_output(
+        so0,
+        ModelRunnerOutput(
+            req_ids=[r1.request_id, r2.request_id],
+            sampled_token_ids=[[7], [7]],
+            draft_confidences=[_block(0.5), _block(0.5)],
+        ),
+    )
+    r1.spec_token_ids = list(range(10, 10 + KMAX))
+    r2.spec_token_ids = list(range(20, 20 + KMAX))
+    scheduler.adaptive_k._tier.clear()
+    # Tight budget: fits r1 (1 + 3 = 4 tokens), defers r2.
+    scheduler.max_num_scheduled_tokens = 4
+    so1 = scheduler.schedule()
+    assert list(so1.num_scheduled_tokens) == [r1.request_id]
+    assert len(so1.scheduled_spec_decode_tokens[r1.request_id]) == 3
+    assert r2.spec_token_ids == list(range(20, 20 + KMAX))
+    assert r2.request_id not in scheduler.adaptive_k._tier
+
+
+def test_stale_preemption_output_does_not_pollute_adaptive_k():
+    """Regression for P1 #5: stale outputs after preemption must not call
+    adaptive_k.observe()."""
+    scheduler = _scheduler(
+        _raw(accept_weight=0.5), async_scheduling=True, pp=1
+    )
+    r = create_requests(num_requests=1, num_tokens=4, max_tokens=200)[0]
+    scheduler.add_request(r)
+    so0 = scheduler.schedule()
+    scheduler.update_from_output(
+        so0,
+        ModelRunnerOutput(
+            req_ids=[r.request_id],
+            sampled_token_ids=[[7]],
+            draft_confidences=[_block(4.0)],
+        ),
+    )
+    so1 = scheduler.schedule()
+    assert r.request_id in so1.scheduled_spec_decode_tokens
+    # Mark output as stale (as happens after preemption before in-flight drain).
+    r.num_stale_output_tokens = so1.num_scheduled_tokens[r.request_id]
+    r.drop_stale_output = False
+    acc_s_before = dict(scheduler.adaptive_k._acc_s)
+    acc_f_before = dict(scheduler.adaptive_k._acc_f)
+    scheduler.update_from_output(
+        so1,
+        ModelRunnerOutput(
+            req_ids=[r.request_id],
+            sampled_token_ids=[[9]],
+            draft_confidences=[_block(0.1)],
+        ),
+    )
+    assert scheduler.adaptive_k._acc_s == acc_s_before
+    assert scheduler.adaptive_k._acc_f == acc_f_before
+
+
+def test_empty_pp_steps_do_not_inflate_histogram_or_log_counter():
+    """Regression for P1 #6: empty PP steps must not call record_choice."""
+    raw = _raw()
+    raw["log_interval"] = 10
+    scheduler = _scheduler(raw, async_scheduling=True, pp=4)
+    r = create_requests(num_requests=1, num_tokens=4, max_tokens=200)[0]
+    scheduler.add_request(r)
+    # Step 1: schedules prefill of r (eligible non-empty).
+    so1 = scheduler.schedule()
+    assert r.request_id in so1.num_scheduled_tokens
+    # Steps 2, 3, 4: PP cadence idle steps (eligible == []).
+    for _ in range(3):
+        so = scheduler.schedule()
+        assert not so.num_scheduled_tokens
+    # Step 5: schedules decode of r (eligible non-empty).
+    so5 = scheduler.schedule()
+    assert r.request_id in so5.num_scheduled_tokens
+    assert sum(scheduler.adaptive_k._k_counts.values()) == 1
+    assert scheduler.adaptive_k._steps_since_log == 1
