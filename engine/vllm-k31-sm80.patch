+# ----------------------------------------------------------- scheduler
+
+
+def _scheduler(raw, *, async_scheduling=False, pp=1):
+    base = create_scheduler(
+        max_num_seqs=16,
+        max_num_batched_tokens=8192,
+        num_speculative_tokens=KMAX,
+        async_scheduling=async_scheduling,
+        pipeline_parallel_size=pp,
+    )
+    spec = base.vllm_config.speculative_config
+    assert spec is not None
+    if raw is not None:
+        spec.adaptive_k = raw
+        spec.adaptive_k_config = AdaptiveKConfig.from_dict(raw, KMAX)
+    cls = AsyncScheduler if async_scheduling else Scheduler
+    return cls(
+        vllm_config=base.vllm_config,
+        kv_cache_config=base.kv_cache_config,
+        block_size=base.block_size,
+        log_stats=True,
+        structured_output_manager=StructuredOutputManager(base.vllm_config),
+    )
+
+
+class _Engine:
+    """EngineCore's order of schedule() and update_from_output(): a batch
+    queue of ``queue_size`` (1: synchronous scheduling, drafts handed back
+    after each step; pp + depth - 1 under async + PP). Each sampling output
+    carries, for its request, ``conf(req, n)``: n is the request's count of
+    scheduled steps, kept here independently of the policy's stamps."""
+
+    def __init__(self, scheduler, conf, queue_size, accepted=lambda r, n: 0):
+        self.s = scheduler
+        self.conf = conf
+        self.accepted = accepted
+        self.queue_size = queue_size
+        self.queue: deque = deque()
+        self.count: dict[str, int] = {}
+        self.step_n: dict[int, dict[str, int]] = {}
+        # req -> newest n whose sampling output was processed.
+        self.processed: dict[str, int] = {}
+        # (req, n, verified drafts, newest processed n at schedule time).
+        self.decisions: list[tuple[str, int, int, int | None]] = []
+        self.outputs: list = []
+
+    def step(self):
+        snapshot = dict(self.processed)
+        so = self.s.schedule()
+        self.outputs.append(so)
+        ns = {}
+        for req_id in so.num_scheduled_tokens:
+            self.count[req_id] = n = self.count.get(req_id, 0) + 1
+            ns[req_id] = n
+            spec = so.scheduled_spec_decode_tokens.get(req_id)
+            if spec:
+                self.decisions.append((req_id, n, len(spec), snapshot.get(req_id)))
+        self.step_n[id(so)] = ns
+        self.queue.append(so)
+        if len(self.queue) >= self.queue_size:
+            self._finish(self.queue.popleft())
+
+    def _finish(self, so):
+        ns = self.step_n.pop(id(so))
+        req_ids, sampled, confs = [], [], []
+        for req_id in so.num_scheduled_tokens:
+            spec = so.scheduled_spec_decode_tokens.get(req_id) or []
+            acc = min(self.accepted(req_id, ns[req_id]), len(spec))
+            req_ids.append(req_id)
+            sampled.append([7] * (1 + acc))
+            confs.append(self.conf(req_id, ns[req_id]))
+            self.processed[req_id] = ns[req_id]
+        out = ModelRunnerOutput(
+            req_ids=req_ids, sampled_token_ids=sampled, draft_confidences=confs
+        )
+        self.s.update_from_output(so, out)
+        if self.queue_size == 1 and req_ids:
+            self.s.update_draft_token_ids(
+                DraftTokenIds(req_ids, [[5] * KMAX for _ in req_ids])
+            )
+
+
+# Confidence of the block a request's n-th step proposes: distinct tiers in
+# a pattern no constant age offset other than the right one reproduces.
+PATTERN = [6.0, 0.5, 2.0, 4.0, 3.0, 0.5, 6.0, 2.0, 0.5, 4.0, 6.0, 3.0]
+
+
+def _conf(req, n):
+    return _block(PATTERN[n % len(PATTERN)])
+
+
+@pytest.mark.parametrize(
+    "async_scheduling, pp, queue_size, age",
+    [(False, 1, 1, 0), (True, 1, 2, 1), (True, 4, 5, 1)],
+)
+def test_the_scheduler_verifies_the_tier_of_the_newest_confidence_on_the_host(
+    async_scheduling, pp, queue_size, age
+):
+    scheduler = _scheduler(_raw(), async_scheduling=async_scheduling, pp=pp)
+    (request,) = create_requests(num_requests=1, num_tokens=8, max_tokens=4000)
+    scheduler.add_request(request)
+    engine = _Engine(scheduler, _conf, queue_size)
+    for _ in range(80):
+        engine.step()
+    decisions = engine.decisions
+    assert len(decisions) >= 15
+    checked = 0
+    for req_id, n, verified, newest in decisions:
+        if newest is None:
+            # No output of this request on the host yet: acceptance prior.
+            assert verified == 7
+            continue
+        # The newest confidence on the host is `age` rounds old...
+        assert n - 1 - newest == age
+        # ...and the step verifies exactly its tier.
+        assert verified == _tier_of(PATTERN[newest % len(PATTERN)])
+        checked += 1
+    assert checked >= 12
+    for so in engine.outputs:
+        if so.scheduled_spec_decode_tokens:
+            # The drafter always drafts the widest tier: the draft broadcast to
+            # earlier stages keeps one width whatever the step verifies.
+            assert so.num_spec_tokens_to_schedule == KMAX
+            (req_id,) = so.scheduled_spec_decode_tokens
+            k = len(so.scheduled_spec_decode_tokens[req_id])
+            assert so.num_scheduled_tokens[req_id] == 1 + k
+
+
+def test_stale_confidences_past_max_age_fall_back_to_acceptance():
+    # Async + PP: every confidence is one round old, max_age 0 drops them all.
+    scheduler = _scheduler(_raw(max_age=0), async_scheduling=True, pp=4)
+    (request,) = create_requests(num_requests=1, num_tokens=8, max_tokens=4000)
+    scheduler.add_request(request)
+    engine = _Engine(scheduler, _conf, 5, accepted=lambda r, n: 12)
+    for _ in range(60):
+        engine.step()
+    verified = [v for _, _, v, _ in engine.decisions]
+    # Starts at the prior's tier and climbs on full acceptance, never the
+    # pattern's tiers 3 / 5.
+    assert verified[0] == 7 and verified[-1] == 12
+    assert set(verified) <= {7, 9, 12}
+    assert verified == sorted(verified)
+
+
+def test_under_pp_a_step_counts_only_the_requests_its_micro_batch_takes():
+    scheduler = _scheduler(_raw(), async_scheduling=True, pp=4)
+    a, b = create_requests(num_requests=2, num_tokens=8, max_tokens=4000)
+    conf = lambda req, n: _block(6.0 if req == a.request_id else 0.5)  # noqa: E731
+    engine = _Engine(scheduler, conf, 5)
+    scheduler.add_request(a)
+    engine.step()
+    scheduler.add_request(b)
+    for _ in range(60):
+        engine.step()
+    for so in engine.outputs:
+        reqs = set(so.scheduled_spec_decode_tokens)
+        if not reqs:
+            continue
+        # One width per step (uniform decode batch).
+        assert len({len(v) for v in so.scheduled_spec_decode_tokens.values()}) == 1
+    widths_b = [v for r, _, v, newest in engine.decisions if r == b.request_id and newest]
+    widths_a = [v for r, _, v, newest in engine.decisions if r == a.request_id and newest]
+    # b's micro-batches are not widened by a, which they do not hold.
+    assert widths_b and set(widths_b) == {3}
+    assert widths_a and set(widths_a) == {12}
+
+
+def _trace(scheduler, conf):
+    (request,) = create_requests(num_requests=1, num_tokens=8, max_tokens=300)
+    scheduler.add_request(request)
+    engine = _Engine(scheduler, conf, 5, accepted=lambda r, n: n % 4)
+    for _ in range(40):
+        engine.step()
+    return [
+        (
+            dict(so.num_scheduled_tokens),
+            {k: list(v) for k, v in so.scheduled_spec_decode_tokens.items()},
+            so.num_spec_tokens_to_schedule,
+        )
+        for so in engine.outputs
+    ]
+
