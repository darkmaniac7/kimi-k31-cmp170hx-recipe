+def _gpu_ok():
+    if not torch.cuda.is_available():
+        return False
+    if torch.cuda.get_device_capability(0) != (8, 0):
+        return False
+    free, _ = torch.cuda.mem_get_info(0)
+    return free > 12 * 2**30
