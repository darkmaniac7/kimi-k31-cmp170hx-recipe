+# ---------------------------------------------------------------------------
+# 2. P0 ragged padded DSA decode OOB fix
+# ---------------------------------------------------------------------------
+
+
+def _cpu_pack_seq(x: torch.Tensor, lens: torch.Tensor, pad_value: int = 0) -> torch.Tensor:
+    b = int(lens.shape[0])
+    max_len = int(lens.max().item())
+    out = torch.full((b, max_len, *x.shape[1:]), pad_value, dtype=x.dtype, device=x.device)
+    offset = 0
+    for i in range(b):
+        n = int(lens[i].item())
+        out[i, :n] = x[offset : offset + n]
+        offset += n
+    return out
+
+
+def _cpu_unpack_seq(x: torch.Tensor, lens: torch.Tensor) -> torch.Tensor:
+    pieces = [x[i, : int(lens[i].item())] for i in range(int(lens.shape[0]))]
+    return torch.cat(pieces, dim=0)
+
+
+def test_score_decode_ragged_padded_exceeds_buffer_rows(monkeypatch):
+    """Ragged decode_lens=[1, 4] packs to num_rows=8 > buffer.shape[0]=5:
+    get_indexer_topk must receive an (8, topk) buffer and unpack the 5 real rows."""
+    decode_lens = torch.tensor([1, 4], dtype=torch.int32)
+    num_decode_tokens = int(decode_lens.sum().item())  # 5
+    batch_size = int(decode_lens.shape[0])  # 2
+    next_n = int(decode_lens.max().item())  # 4
+    num_rows = batch_size * next_n  # 8 > 5
+    topk_tokens = 4
+    max_model_len = 16
+
+    q = torch.arange(num_decode_tokens * 2 * 4, dtype=torch.uint8).reshape(
+        num_decode_tokens, 2, 4
+    )
+    weights = torch.ones((num_decode_tokens, 2), dtype=torch.float32)
+    kv_cache = torch.zeros((1,), dtype=torch.uint8)
+    topk_indices_buffer = torch.full((num_decode_tokens, topk_tokens), -1, dtype=torch.int32)
+    seq_lens = torch.tensor([10, 12], dtype=torch.int32)
+    metadata = SimpleNamespace(
+        num_decode_tokens=num_decode_tokens,
+        max_seq_len=max_model_len,
+        decode=SimpleNamespace(
+            global_seq_lens=None,
+            indices=None,
+            decode_lens=decode_lens,
+            requires_padding=True,
+            seq_lens=seq_lens,
+            block_table=torch.zeros((batch_size, 2), dtype=torch.int32),
+        ),
+    )
+
+    seen_shapes: list[tuple[int, ...]] = []
+
+    def fake_paged_logits(q_rows, kv, rw, sl, bt, mml, *, max_seq_len):
+        assert q_rows.shape[:2] == (batch_size, next_n)
+        assert rw.shape[0] == num_rows
+        return torch.zeros((num_rows, max_model_len), dtype=torch.float32)
+
+    def fake_topk(logits, sl, nn_, out_indices, k, max_sl):
+        seen_shapes.append(tuple(out_indices.shape))
+        assert logits.shape[0] == num_rows
+        assert out_indices.shape == (num_rows, topk_tokens)
+        assert nn_ == next_n
+        # Write unique values into every packed row; clamping to 5 would OOB here.
+        rows = torch.arange(num_rows, dtype=torch.int32).unsqueeze(1) * 100
+        cols = torch.arange(topk_tokens, dtype=torch.int32).unsqueeze(0)
+        out_indices.copy_(rows + cols)
+
+    def fake_tiefix(logits, out_indices, sl, nn_):
+        assert out_indices.shape == (num_rows, topk_tokens)
+
+    monkeypatch.setattr(sm80_dsa, "pack_seq_triton", _cpu_pack_seq)
+    monkeypatch.setattr(sm80_dsa, "unpack_seq_triton", _cpu_unpack_seq)
+    monkeypatch.setattr(sm80_dsa, "sm80_paged_mqa_logits", fake_paged_logits)
+    monkeypatch.setattr(sm80_dsa, "get_indexer_topk", lambda backend: fake_topk)
+    monkeypatch.setattr(sm80_dsa, "tiefix_decode_topk_", fake_tiefix)
+
+    sm80_dsa._score_decode(
+        metadata,
+        kv_cache,
+        q,
+        weights,
+        topk_tokens,
+        max_model_len,
+        topk_indices_buffer,
+        "auto",
+    )
+
+    assert seen_shapes == [(num_rows, topk_tokens)]
+    # Packed rows kept by unpack for decode_lens=[1, 4]: row 0 (batch 0) and rows 4..7 (batch 1).
+    expected_rows = torch.tensor([0, 4, 5, 6, 7], dtype=torch.int32).unsqueeze(1) * 100
+    expected = expected_rows + torch.arange(topk_tokens, dtype=torch.int32).unsqueeze(0)
+    assert torch.equal(topk_indices_buffer, expected)
+
