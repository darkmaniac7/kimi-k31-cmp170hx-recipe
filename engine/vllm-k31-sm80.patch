+  const __half2 s1_h2 = *reinterpret_cast<const __half2*>(&s1_u);
+  const float s1_lo = __half2float(__low2half(s1_h2)), s1_hi = __half2float(__high2half(s1_h2));
+  acc_g[0] = fmaf(s1_lo, ga1[0], acc_g[0]);
+  acc_g[1] = fmaf(s1_lo, ga1[1], acc_g[1]);
+  acc_g[2] = fmaf(s1_hi, ga1[2], acc_g[2]);
+  acc_g[3] = fmaf(s1_hi, ga1[3], acc_g[3]);
