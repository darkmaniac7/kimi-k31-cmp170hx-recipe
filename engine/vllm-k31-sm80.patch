+def test_accept_walk_follows_the_drafted_branch():
+    tree = _example()
+    # nodes: a=11, aa=12, aaa=13, ab=22, b=21
+    drafts = [11, 12, 13, 22, 21]
+    # Chain fully accepted: targets after rows 0..3 are a, aa, aaa, then 99.
+    res = dt.accept_walk(tree, drafts, [11, 12, 13, 99, 0, 0])
+    assert res.rows == (1, 2, 3) and res.tokens == (11, 12, 13, 99)
+    assert res.last_row == 3 and res.num_accepted == 3
+    # First guess wrong, the runner-up right: one accepted token, then stop.
+    res = dt.accept_walk(tree, drafts, [21, 0, 0, 0, 0, 77])
+    assert res.rows == (5,) and res.tokens == (21, 77) and res.last_row == 5
+    # a right, then the runner-up under a.
+    res = dt.accept_walk(tree, drafts, [11, 22, 0, 0, 55, 0])
+    assert res.rows == (1, 4) and res.tokens == (11, 22, 55) and res.last_row == 4
+    # Nothing matches: the step still emits the target's own token.
+    res = dt.accept_walk(tree, drafts, [5, 0, 0, 0, 0, 0])
+    assert res.rows == () and res.tokens == (5,) and res.last_row == 0
