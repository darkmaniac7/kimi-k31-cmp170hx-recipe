+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The kernel owner's accuracy check of ``_k31_dense_C`` (csrc/k31_dense), as
+pytest.
+
+Ported from the package's ``test_dense_k31.py`` (its test 1; the timing table
+of test 2 is a benchmark and stays with the package). What changed: the
+library is the tree's ``vllm/_k31_dense_C`` instead of a build in the test,
+the mini checkpoint comes from K31Q_MINI_CHECKPOINT, and the reference is the
+tree's ``_exl3_C.linear_out`` (in this tree the tensor-core blocks run only
+inside ``linear_out_splitk``, so ``linear_out`` is the scalar path the
+package compared with after switching its tensor-core path off). The checks
+and their thresholds are the package's.
+
+On real mini layer 1 weights and activations, against ``linear_out`` in FP32:
+  1. the four KDA members q, k, v, g of one rank of two fused in one launch,
+     at 1, 4, 8 and 256 rows;
+  2. the latent down-projection [3584, 7168] on the MLP input, at 1, 8 and
+     256 rows;
+  3. a member whose logical width is not a multiple of 128 (MLA kv_a, 576
+     padded to 640) fused with q_a, on random trellises.
+
+Release 2 of the package adds checks that :func:`test_release_2` ports: the
+decode path at 16 and 32 rows, a workspace filled with garbage before every
+call, CUDA graph capture and replay, FP32 output at 5, 6 and 7 bits, and
+bitwise equal outputs over 20 eager calls and 20 graph replays.
+
+Needs a CUDA device, both built libraries and the mini checkpoint.
+"""
+
+import pytest
+import torch
+
+from tests.models.kimi_k3.sm80 import gpu
+
+pytestmark = gpu.CUDA_MARKS
+
+LAYER = "language_model.model.layers.1"
+
+
+@pytest.fixture(scope="module")
+def dops():
+    from vllm.sm80.kernels.exl3 import ops as exl3_ops
+    from vllm.sm80.kernels.k31q import dense_k31_ops
+
+    gpu.require_library(dense_k31_ops.ensure_dense_k31_extension, "_k31_dense_C")
+    gpu.require_library(exl3_ops.ensure_extension, "_exl3_C")
+    return dense_k31_ops
+
+
+def _reference(x, trellis, suh, svh, logical_out):
+    """One EXL3 matrix through the EXL3 extension's linear_out, FP32."""
+    exl3 = torch.ops._exl3_C
+    rows, logical_in = x.shape
+    workspace = torch.empty(
+        exl3.linear_workspace_size(rows, suh.numel(), svh.numel()),
+        dtype=torch.float32,
+        device=x.device,
+    )
+    out = torch.empty((rows, logical_out), dtype=torch.float32, device=x.device)
+    exl3.linear_out(
+        x, trellis, suh, svh, 12, 2, logical_in, logical_out, out, workspace
+    )
+    return out
+
+
+def _fused(dops, x, members, logical_outs):
+    trellises, suhs, svhs = (list(part) for part in zip(*members))
+    rows = x.shape[0]
+    padded = sum(svh.numel() for svh in svhs)
+    workspace = torch.empty(
+        dops.linear_workspace_size_k31(rows, x.shape[1], padded, len(members)),
+        dtype=torch.float32,
+        device=x.device,
+    )
+    out = torch.empty((rows, sum(logical_outs)), dtype=torch.bfloat16, device=x.device)
+    dops.linear_out_k31_multi(
+        x, trellises, suhs, svhs, [12] * len(members), logical_outs, out, workspace
+    )
+    return out
+
+
+def test_accuracy_against_the_exl3_reference(dops):
+    device = torch.device("cuda:0")
+    mini = gpu.require_mini()
+    x_attn, x_mlp = gpu.tensors(
+        mini / "ref_acts.safetensors", "L1.attn_in.q", "L1.mlp_in.q"
+    )
+    x_attn = x_attn.to(torch.bfloat16).contiguous()
+    x_mlp = x_mlp.to(torch.bfloat16).contiguous()
+    layer = mini / "layer-001.safetensors"
+
+    # 1) Four KDA members of TP2 rank 0: [6144, 7168] each.
+    members = []
+    for name in ("q_proj", "k_proj", "v_proj", "g_proj"):
+        trellis, suh, svh = gpu.tensors(
+            layer,
+            *(f"{LAYER}.self_attn.{name}.{part}" for part in ("trellis", "suh", "svh")),
+        )
+        members.append(
+            (
+                trellis[:, : 6144 // 16, :].contiguous(),
+                suh.contiguous(),
+                svh[:6144].contiguous(),
+            )
+        )
+    for rows in (1, 4, 8, 256):
+        x = x_attn[:rows].contiguous()
+        out = _fused(dops, x, members, [6144] * 4)
+        ref = torch.cat([_reference(x, *member, 6144) for member in members], dim=-1)
+        rel = gpu.rel_l2(out, ref)
+        assert rel < 0.004, f"KDA qkvg M={rows} rel_l2={rel}"
+        print(f"real L1 KDA q, k, v, g fused (M={rows}): rel_l2={rel:.5f}")
+
+    # 2) routed_expert_down_proj [3584, 7168] on the real MLP input.
+    down = tuple(
+        t.contiguous()
+        for t in gpu.tensors(
+            layer,
+            *(
+                f"{LAYER}.block_sparse_moe.routed_expert_down_proj.{part}"
+                for part in ("trellis", "suh", "svh")
+            ),
+        )
+    )
+    for rows in (1, 8, 256):
+        x = x_mlp[:rows].contiguous()
+        out = _fused(dops, x, [down], [3584])
+        rel = gpu.rel_l2(out, _reference(x, *down, 3584))
+        assert rel < 0.004, f"Latent down M={rows} rel_l2={rel}"
+        print(f"real L1 latent down (M={rows}): rel_l2={rel:.5f}")
+
+    # 3) Logical width below the padding: MLA kv_a [576 padded to 640, 7168]
+    # fused with q_a [1536, 7168].
+    t_qa = torch.randint(
+        -32768, 32767, (7168 // 16, 1536 // 16, 96), dtype=torch.int16, device=device
+    )
+    t_kva = torch.randint(
+        -32768, 32767, (7168 // 16, 640 // 16, 96), dtype=torch.int16, device=device
+    )
+    su1 = torch.ones(7168, dtype=torch.float16, device=device)
+    sv_qa = torch.ones(1536, dtype=torch.float16, device=device) * 0.02
+    sv_kva = torch.ones(640, dtype=torch.float16, device=device) * 0.02
+    for rows in (1, 8, 256):
+        x = x_attn[:rows].contiguous()
+        out = _fused(dops, x, [(t_qa, su1, sv_qa), (t_kva, su1, sv_kva)], [1536, 576])
+        ref = torch.cat(
+            [
+                _reference(x, t_qa, su1, sv_qa, 1536),
+                _reference(x, t_kva, su1, sv_kva, 576),
+            ],
+            dim=-1,
+        )
+        rel = gpu.rel_l2(out, ref)
+        assert rel < 0.004, f"MLA q_a+kv_a M={rows} rel={rel}"
+        print(f"MLA q_a + kv_a [1536 + 576 (640 padded)] (M={rows}): rel_l2={rel:.5f}")
+
+
+def _layer1_kda_rank0():
+    layer = gpu.require_mini() / "layer-001.safetensors"
+    members = []
+    for name in ("q_proj", "k_proj", "v_proj", "g_proj"):
+        trellis, suh, svh = gpu.tensors(
+            layer,
+            *(f"{LAYER}.self_attn.{name}.{part}" for part in ("trellis", "suh", "svh")),
+        )
+        members.append(
+            (
+                trellis[:, : 6144 // 16, :].contiguous(),
+                suh.contiguous(),
+                svh[:6144].contiguous(),
+            )
+        )
+    return members
+
+
+def test_release_2(dops):
+    """The package's release 2 checks (its test 1 and 1b) on the tree's
+    library; thresholds are the package's (rel_l2 0.004 against linear_out,
+    bitwise equality between runs)."""
+    device = torch.device("cuda:0")
+    mini = gpu.require_mini()
+    assert dops.build_info()["api_version"] >= 3
+    (x_attn,) = gpu.tensors(mini / "ref_acts.safetensors", "L1.attn_in.q")
+    x_attn = x_attn.to(torch.bfloat16).contiguous()
+    members = _layer1_kda_rank0()
+    trellises, suhs, svhs = (list(part) for part in zip(*members))
+    bits, louts = [12] * 4, [6144] * 4
+
+    def launch(x, out, workspace):
+        dops.linear_out_k31_multi(x, trellises, suhs, svhs, bits, louts, out, workspace)
+
+    for rows in (16, 32):
+        x = x_attn[:rows].contiguous()
+        workspace = torch.full(
+            (dops.linear_workspace_size_k31(rows, 7168, 4 * 6144, 4),),
+            12345.67,
+            dtype=torch.float32,
+            device=device,
+        )
+        out = torch.empty((rows, 4 * 6144), dtype=torch.bfloat16, device=device)
+        launch(x, out, workspace)
+        ref = torch.cat([_reference(x, *m, 6144) for m in members], dim=-1)
+        rel = gpu.rel_l2(out, ref)
+        assert rel < 0.004, f"KDA qkvg M={rows} with a dirty workspace: rel_l2={rel}"
+        print(f"release 2: KDA q, k, v, g (M={rows}, dirty workspace): {rel:.5f}")
+
+    # Bitwise: 20 eager calls with a refilled workspace and 20 graph replays
+    # give the first call's bits.
+    for rows in (1, 4, 8, 12, 16):
+        x = x_attn[:rows].contiguous()
+        workspace = torch.empty(
+            dops.linear_workspace_size_k31(rows, 7168, 4 * 6144, 4),
+            dtype=torch.float32,
+            device=device,
+        )
+        first = torch.empty((rows, 4 * 6144), dtype=torch.bfloat16, device=device)
+        launch(x, first, workspace)
+        again = torch.empty_like(first)
+        for rep in range(20):
+            workspace.fill_(float(rep + 1) * 7.25)
+            again.zero_()
+            launch(x, again, workspace)
+            assert torch.equal(first, again), f"eager M={rows} call {rep}"
+        graphed = torch.zeros_like(first)
+        torch.cuda.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            launch(x, graphed, workspace)
+        for rep in range(20):
+            graphed.zero_()
+            graph.replay()
+            torch.cuda.synchronize()
+            assert torch.equal(first, graphed), f"graph M={rows} replay {rep}"
+    print("release 2: KDA q, k, v, g bitwise equal over 20 calls and 20 replays")
+
+    # FP32 output at 5, 6 and 7 bits: [7168, 3584] on random trellises, 4 rows.
+    x = x_attn[:4, :3584].contiguous()
+    for bits_x2 in (10, 12, 14):
+        trellis = torch.randint(
+            -32768,
+            32767,
+            (3584 // 16, 7168 // 16, 8 * bits_x2),
+            dtype=torch.int16,
+            device=device,
+        )
+        suh = torch.ones(3584, dtype=torch.float16, device=device)
+        svh = torch.full((7168,), 0.02, dtype=torch.float16, device=device)
+        workspace = torch.empty(
+            dops.linear_workspace_size_k31(4, 3584, 7168, 1),
+            dtype=torch.float32,
+            device=device,
+        )
+        out = torch.empty((4, 7168), dtype=torch.float32, device=device)
+        dops.linear_out_k31_multi(
+            x, [trellis], [suh], [svh], [bits_x2], [7168], out, workspace
+        )
+        exl3 = torch.ops._exl3_C
+        ref = torch.empty((4, 7168), dtype=torch.float32, device=device)
+        exl3.linear_out(
+            x,
+            trellis,
+            suh,
+            svh,
+            bits_x2,
+            2,
+            3584,
+            7168,
+            ref,
+            torch.empty(
+                exl3.linear_workspace_size(4, 3584, 7168),
+                dtype=torch.float32,
+                device=device,
+            ),
+        )
+        rel = gpu.rel_l2(out, ref)
+        assert rel < 0.004, f"FP32 out bits_x2={bits_x2}: rel_l2={rel}"
+        print(f"release 2: FP32 output, bits_x2 {bits_x2}: {rel:.5f}")
+
+
