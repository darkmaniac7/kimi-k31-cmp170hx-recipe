+def _ensure_static_device_name(monkeypatch) -> None:
+    from vllm.platforms import current_platform
+    from vllm.platforms.interface import UnspecifiedPlatform
+
+    if isinstance(current_platform, UnspecifiedPlatform):
+        monkeypatch.setattr(
+            type(current_platform),
+            "get_device_name",
+            classmethod(lambda cls, device_id=0: "Static SM80 meta-construction device"),
+            raising=False,
+        )
+
+
+@pytest.mark.parametrize("rank", [0, 1, 2, 3])
+def test_exl3_moe_method_tp4_zero_pads_intermediate_cleanly(
+    monkeypatch, meta_platform, tmp_path, rank
+):
+    """At TP=4, when local_intermediate < part_width (here 128 < 256 on mini
+    fixture, mirroring 768 < 1536 on K3.1), K31Exl3MoEMethod zero-pads each
+    expert's intermediate columns to part_width without reading out-of-bounds
+    checkpoint slices or failing exl3_kernel_closed_reason."""
+    from tests.models.kimi_k3.sm80 import construct
+    from tests.models.kimi_k3.sm80 import k31q_fixture as fixture
+    from vllm.sm80.kernels.exl3 import ops as exl3_ops
+
+    _ensure_static_device_name(monkeypatch)
+
+    directory = tmp_path / f"mini_tp4_r{rank}"
+    cfg = fixture.tiny_config()
+    cfg["text_config"]["linear_attn_config"]["num_heads"] = 4
+    cfg["text_config"]["num_attention_heads"] = 8
+    cfg["text_config"]["num_key_value_heads"] = 8
+    fixture.write_checkpoint(directory, config=cfg)
+
+    text = cfg["text_config"]
+    latent = text["routed_expert_hidden_size"]
+    num_experts = text["num_experts"]
+    topk = text["num_experts_per_token"]
+    exl3_layer = fixture.EXL3_EXPERT_LAYERS[0]
+
+    tiny_kernel = (latent, 256)  # INTER=512 -> at TP=4 local_inter=128 < 256
+    monkeypatch.setattr(moe, "K31_KERNEL_SHAPE", tiny_kernel)
+
+    calls = []
+    monkeypatch.setattr(
+        exl3_ops,
+        "moe_workspace_size_k31",
+        lambda m, h, i, k, e: 1000 + m,
+    )
+    monkeypatch.setattr(
+        exl3_ops,
+        "moe_workspace_size_prefill_k31",
+        lambda m, h, i, k, e: 5000 + m,
+    )
+    monkeypatch.setattr(
+        exl3_ops,
+        "moe_out_k31",
+        lambda x, ids, weights, ptrs, meta, emap, inter, out, ws, **kw: (
+            calls.append({"inter": inter, "meta": meta.clone()}) or out.fill_(2.0)
+        ),
+    )
+
+    model, _, ledger, _ = construct.build_and_load(
+        monkeypatch, directory, tp_size=4, tp_rank=rank
+    )
+    routed = model.model.layers[exl3_layer].block_sparse_moe.experts.routed_experts
+    experts = routed.k31_experts
+
+    assert experts.local_intermediate == 128
+    assert experts.padded_part_intermediate == 256
+    assert len(experts.parts) == 1
+    assert experts.exl3_kernel_closed_reason() is None
+
+    # Verify padded slices [128:256] of trellis, suh (for w2), and svh (for w1/w3) are 0!
+    for entry in experts.entries:
+        matrix, rows, cols, shapes, _ = entry
+        real_k = rows.stop - rows.start
+        real_n = cols.stop - cols.start
+        t_view = experts._view(0, entry)
+        suh_view = experts._view(1, entry)
+        svh_view = experts._view(2, entry)
+        if real_n < shapes[2][0]:
+            # IN_LATENT (w1, w3): padded along output columns [real_n : 256]
+            assert torch.all(t_view[:, real_n // 16 :, :] == 0)
+            assert torch.all(svh_view[real_n:] == 0)
+        else:
+            # OUT_LATENT (w2): padded along input rows [real_k : 256]
+            assert real_k < shapes[1][0]
+            assert torch.all(t_view[real_k // 16 :, :, :] == 0)
+            assert torch.all(suh_view[real_k:] == 0)
+
+    kernel = routed.quant_method.build_kernel(routed, max_rows=32)
+    assert kernel.part_intermediate == 256
+    (ptrs, meta) = kernel.tables[0]
+    bits_x2 = 2 * fixture.EXL3_EXPERT_BITS
+    assert meta[0, 0].tolist() == [latent, 256, bits_x2, 2]
+    assert meta[0, 1].tolist() == [latent, 256, bits_x2, 2]
+    assert meta[0, 2].tolist() == [256, latent, bits_x2, 2]
+
+    x = torch.randn((4, latent), dtype=torch.bfloat16)
+    ids = torch.arange(4 * topk, dtype=torch.int32).view(4, topk) % num_experts
+    weights = torch.full((4, topk), 1.0 / topk, dtype=torch.float32)
+    out = torch.empty_like(x)
+    ws2 = torch.empty((kernel.launcher.storage_elements(4, latent),), dtype=torch.bfloat16)
+    kernel.apply(
+        out, x, ptrs, meta, weights, ids, routed.activation,
+        num_experts, routed.k31_expert_map, None, None, torch.empty(0), ws2, None, False,
+    )
+    assert len(calls) == 1
+    assert calls[0]["inter"] == 256
+    assert torch.all(out == 2.0)
+
