+def _randomize_head(head: torch.nn.Module, seed: int = 7) -> None:
+    g = torch.Generator().manual_seed(seed)
+    with torch.no_grad():
+        for p in head.parameters():
+            p.copy_(
+                torch.randn(p.shape, generator=g, dtype=torch.float32).to(p.dtype)
+                * 0.08
+            )
