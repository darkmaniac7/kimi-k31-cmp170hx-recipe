+        "float lower_bound, float norm_eps, Tensor(c!) out, "
+        "Tensor(d!) state_mode, Tensor? fold_src_indices, Tensor? fold_counts) -> ()");
+  m.def("kda_records_materialize(Tensor(a!) recurrent_state, Tensor(b!) state_mode, "
+        "Tensor spec_state_indices, Tensor num_accepted_tokens) -> ()");
+  m.def("moe_prune_topk(Tensor topk_weights, Tensor topk_ids, int max_topk, "
+        "float rel_thresh, bool renormalize, Tensor(a!) out_weights, Tensor(b!) out_ids) -> ()");
