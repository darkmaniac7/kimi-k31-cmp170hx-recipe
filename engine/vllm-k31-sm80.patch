+def test_gpu_kda_records_invariant3_mode_transitions_bitwise_exact():
+    """Spec Invariant 3: legacy -> records (with mode=0 acc>1 copy) -> records
+    -> materialize -> legacy -> records, all bitwise identical to legacy."""
+    _require_sm80_or_sm120_glue()
+    H, D, M = 48, 128, 6
+    C = 3 * H * D
+    cw, cb, A_log, dt_bias, norm_w = _make_gpu_kda_weights(H, D, 801)
+    g = torch.Generator(device="cuda").manual_seed(802)
+    conv_leg = (torch.randn((20, C, 12), device="cuda", generator=g) * 0.2).to(
+        torch.bfloat16
+    )
+    rec_leg = torch.randn((20, H, D, D), device="cuda", generator=g) * 0.05
+    conv_rec, rec_rec = conv_leg.clone(), rec_leg.clone()
+    sm = torch.zeros((20,), device="cuda", dtype=torch.int32)
+
+    ssi = torch.arange(2, 2 + M, device="cuda", dtype=torch.int32).unsqueeze(0)
+    qsl = torch.tensor([0, M], device="cuda", dtype=torch.int32)
+
+    schedule = [
+        ("legacy", 1),
+        ("records", 4),      # mode==0 with acc=4 > 1 -> copies ssi[3] to ssi[0]
+        ("records", 5),      # mode==1 fold 4 records
+        ("materialize", 4),  # materializes into ssi[3], resets state_mode[2]=0
+        ("legacy", 4),       # reads materialized ssi[3]
+        ("records", 3),      # mode==0 -> mode==1 again
+        ("records", 6),      # mode==1 fold 5 records
+        ("materialize", 1),  # nfold=0 materialize (base already full, resets mode=0)
+        ("legacy", 1),
+    ]
+
+    for step_idx, (op, acc_val) in enumerate(schedule):
+        acc = torch.tensor([acc_val], device="cuda", dtype=torch.int32)
+        if op == "materialize":
+            glue_ops.kda_records_materialize(rec_rec, sm, ssi, acc)
+            assert int(sm[2]) == 0
+            assert torch.equal(
+                rec_rec[int(ssi[0, acc_val - 1])],
+                rec_leg[int(ssi[0, acc_val - 1])],
+            ), f"step {step_idx} materialized state mismatch"
+            continue
+
+        mqkv, rg, rb, g2 = _make_gpu_step_inputs(M, H, D, 900 + step_idx)
+        out_leg = torch.empty((M, H, D), device="cuda", dtype=torch.bfloat16)
+        out_rec = torch.empty((M, H, D), device="cuda", dtype=torch.bfloat16)
+
+        glue_ops.fused_kda_spec_verify(
+            mqkv, conv_leg, cw, cb, rg, rb, A_log, dt_bias, g2, norm_w,
+            rec_leg, ssi, qsl, acc, -5.0, 1e-6, out_leg,
+        )
+        if op == "legacy":
+            glue_ops.fused_kda_spec_verify(
+                mqkv, conv_rec, cw, cb, rg, rb, A_log, dt_bias, g2, norm_w,
+                rec_rec, ssi, qsl, acc, -5.0, 1e-6, out_rec,
+            )
+        else:
+            glue_ops.fused_kda_spec_verify_records(
+                mqkv, conv_rec, cw, cb, rg, rb, A_log, dt_bias, g2, norm_w,
+                rec_rec, ssi, qsl, acc, -5.0, 1e-6, out_rec, sm,
+            )
+            assert int(sm[2]) == 1
+
+        assert torch.equal(out_rec, out_leg), f"step {step_idx} ({op}) out mismatch"
