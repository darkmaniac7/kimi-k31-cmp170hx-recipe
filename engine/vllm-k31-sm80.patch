+def _get_router_workspace(device: torch.device) -> torch.Tensor | None:
+    ws = _ROUTER_WORKSPACES.get(device)
+    if ws is not None:
+        return ws
+    if (
+        not _is_mocked()
+        and device.type == "cuda"
+        and torch.cuda.is_current_stream_capturing()
+    ):
+        return None
+    ops = load_glue_native()
+    ws = ops.allocate_router_workspace(16, FUSED_ROUTER_MAX_EXPERTS, device)
+    _ROUTER_WORKSPACES[device] = ws
+    return ws
+
