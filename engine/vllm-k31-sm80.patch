+def test_exl3_head_logits_processor_cross_dtype_and_rejects_unsupported(monkeypatch):
+    seen: list[tuple[torch.dtype | None, bool]] = []
+
+    class _StubExl3Method(Exl3LinearMethod):
+        def __init__(self, out_dtype: torch.dtype):
+            self.out_dtype = out_dtype
+
+        def apply(self, layer, x, bias=None, out_dtype=None):
+            seen.append((out_dtype, bias is not None))
+            dtype = self.out_dtype if out_dtype is None else out_dtype
+            return torch.zeros((x.shape[0], 16), dtype=dtype)
+
+    x = torch.randn((3, 32), dtype=torch.bfloat16)
+
+    # method.out_dtype=bf16, processor.head_dtype=fp32 -> passes out_dtype=fp32
+    head_bf16 = SimpleNamespace(quant_method=_StubExl3Method(torch.bfloat16))
+    lp_fp32 = _make_processor(monkeypatch, torch.float32)
+    out = lp_fp32._apply_head(head_bf16, x, None)
+    assert out.dtype == torch.float32
+    assert seen[-1] == (torch.float32, False)
+
+    # method.out_dtype=fp32, processor.head_dtype=bf16 -> passes out_dtype=bf16
+    head_fp32 = SimpleNamespace(quant_method=_StubExl3Method(torch.float32))
+    lp_bf16 = _make_processor(monkeypatch, torch.bfloat16)
+    out2 = lp_bf16._apply_head(head_fp32, x, None)
+    assert out2.dtype == torch.bfloat16
+    assert seen[-1] == (torch.bfloat16, False)
+
+    # Matching dtype: calls apply without overriding out_dtype
+    out3 = lp_fp32._apply_head(head_fp32, x, None)
+    assert out3.dtype == torch.float32
+    assert seen[-1] == (None, False)
+
+    # Unsupported dtype (float16) -> raises ValueError
+    lp_fp16 = _make_processor(monkeypatch, torch.float16)
+    with pytest.raises(ValueError, match="float16"):
+        lp_fp16._apply_head(head_bf16, x, None)
+
