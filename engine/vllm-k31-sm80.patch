+@pytest.fixture(scope="module", params=h5120.BITS, ids=lambda b: f"bits_x2={b}")
+def synthetic(request):
+    _require("moe_out_v2_try", "moe_workspace_size_v2_try")
+    experts = h5120._synthetic(request.param)
+    yield experts
+    experts.release()
