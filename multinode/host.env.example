# Copy to multinode/host.env on EVERY host and adjust for your topology.
# Example addresses below use RFC 5737 TEST-NET-1 (192.0.2.0/24).

# Shared paths (must exist at the same path inside containers on each host)
RUNTIME_DIR="/srv/k31-runtime"
WEIGHTS_ROOT="/srv/models"
DSPARK_DIR="/srv/models/Kimi-K3.1-Pro-DSpark-EXL3-K6"
VIEWS_ROOT="/srv/views"
STATE_DIR="/srv/k31-state"

# Container image built against UPSTREAM_COMMIT
IMG="vllm/vllm-openai:nightly-647a76866b4559a74e27d1c6b55fbffe85c07ce4"

# Master (stage 0) 100 GbE / RoCE address and ports
MASTER_IP="192.0.2.10"
MASTER_PORT="29541"
API_BIND_HOST="127.0.0.1"
API_PORT="8041"
SERVED_MODEL_NAME="kimi-k3.1"

# Per-rank placement: "<link-ip>:<nic-ifname>:<comma-gpu-indices>"
# Keep each TP2 pair on the same CPU socket / PCIe root complex.
# Place the NUMA node attached to the 100 GbE NIC as stage 1 so inter-host
# RoCE traffic lands directly on that socket.
NODES=(
  "192.0.2.10:ens0:0,1"   # stage 0: 2x RTX PRO 6000 Blackwell (96 GB)
  "192.0.2.11:ens0:6,7"   # stage 1: 2x 80 GB CMP 170HX (NUMA 1, Gen4 x16)
  "192.0.2.11:ens0:0,2"   # stage 2: 2x 80 GB CMP 170HX (NUMA 0, Gen4 x16)
  "192.0.2.11:ens0:1,4"   # stage 3: 2x 80 GB CMP 170HX (Gen4 x16)
)

# Optional per-container NVMe read cap (recommended on consumer NVMe drives, e.g. "/dev/nvme0n1:450mb")
NVME_READ_CAP=""

# SSH user/options when up.sh / down.sh launches remote ranks (used when rank IP != MASTER_IP)
SSH_USER="root"
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=10"
