+def test_a_bias_without_a_source_fails_the_load(monkeypatch, meta_platform, checkpoint):
+    """No packed projection of K3.1 has a bias and the loader reads none: a
+    module that has one must not come out of the load uninitialized."""
+    from vllm.sm80.kernels.k31q.quant import (
+        K31DenseLinearMethod,
+        K31FusedLinearMethod,
+    )
+
+    for case in ("exl3", "fused"):
+        construct.set_groups(monkeypatch, 1, 0)
+        config = construct.vllm_config(checkpoint[0])
+        model = construct.build_model(config)
+        attention = _layer(model, 1).self_attn
+        module = attention.o_proj if case == "exl3" else attention.in_proj_qkvgfab
+        wanted = K31DenseLinearMethod if case == "exl3" else K31FusedLinearMethod
+        assert type(module.quant_method) is wanted and module.bias is None
+        module.bias = torch.nn.Parameter(torch.empty(4, dtype=torch.bfloat16))
