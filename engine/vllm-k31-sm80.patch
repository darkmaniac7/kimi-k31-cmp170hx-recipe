+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Packed PP hop (VLLM_PP_PACKED_HOP / VLLM_PP_HOP_NO_METADATA), CPU only.
+
+The transport is an in-memory stand-in for the pipeline group and
+torch.distributed, so the tests check the protocol: one device transfer per
+hop, metadata every step or only on the first hop, the receiver's layout
+check, Kimi K3.1 AttnRes boundary shapes across varying token counts,
+Worker.execute_model integration (TP=2, PP=4), and the sm80 switch guard.
+"""
+
+from collections import deque
+import inspect
+from contextlib import nullcontext
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.sequence import IntermediateTensors
+from vllm.sm80 import guard as sm80_guard
+from vllm.sm80.worker.pp_hop import HopLayout, PackedHop
+from vllm.v1.worker.gpu.model_runner import GPUModelRunner
+
+T, N, H = 7, 4, 16
+# K3.1 PP4 partition PART=27,23,23,20 with attn_res_block_size=12:
+# boundary block counts = cdiv(start_layer, 12) for stages 1, 2, 3.
+K31_BOUNDARY_BLOCKS = (3, 5, 7)
+K31_HIDDEN_SIZE = 7168
+
+
+def _boundary(rows=T, with_partial=False):
+    torch.manual_seed(0)
+    tensors = {
+        "hidden_states": torch.randn(rows, N, H).to(torch.bfloat16),
+        "aux_hidden_states_1": torch.randn(rows, H).to(torch.bfloat16),
+        "aux_hidden_states_0": torch.randn(rows, H).to(torch.bfloat16),
+    }
+    if with_partial:
+        tensors["aux_fc_partial"] = torch.randn(rows, H, dtype=torch.float32)
+    return tensors
+
+
+def _k31_boundary(rows: int, num_blocks: int, hidden_size: int = 64, seed: int = 0):
+    gen = torch.Generator().manual_seed(seed)
+    return {
+        "hidden_states": torch.randn(
+            rows, hidden_size, generator=gen, dtype=torch.float32
+        ).to(torch.bfloat16),
+        "residual": torch.randn(
+            rows, num_blocks, hidden_size, generator=gen, dtype=torch.float32
+        ).to(torch.bfloat16),
+    }
+
+
+def test_layout_round_trip_mixed_dtypes_and_row_slice():
+    tensors = _boundary(rows=10, with_partial=True)
+    layout = HopLayout.from_tensors(tensors)
+    # Order is by key, independent of dict order.
+    assert [e.key for e in layout.entries] == sorted(tensors)
+    flat = layout.pack(tensors, rows=T)
+    assert flat.dtype == torch.uint8 and flat.numel() == layout.nbytes(T)
+    for _, offset, _ in layout.segments(T):
+        assert offset % 16 == 0
+    out = layout.unpack(flat, T)
+    for k, v in tensors.items():
+        assert out[k].dtype == v.dtype
+        assert torch.equal(out[k], v[:T])
+
+
+def test_layout_rejects_other_keys():
+    layout = HopLayout.from_tensors(_boundary())
+    bad = _boundary()
+    bad.pop("aux_hidden_states_1")
+    with pytest.raises(AssertionError):
+        layout.pack(bad, T)
+
+
+class _Wire:
+    """In-memory pipeline group + torch.distributed for N pipeline ranks."""
+
+    def __init__(self, world_size: int = 2):
+        self.world_size = world_size
+        self.meta: dict[tuple[int, int], deque] = {
+            (i, (i + 1) % world_size): deque() for i in range(world_size)
+        }
+        self.data: dict[tuple[int, int], deque] = {
+            (i, (i + 1) % world_size): deque() for i in range(world_size)
+        }
+        self.n_isend = 0
+        self.n_isend_object = 0
+        self.n_recv_waits = 0
+
+    def group(self, rank: int):
+        wire = self
+
+        class _Handle:
+            def __init__(self, is_recv: bool = False):
+                self._is_recv = is_recv
+                self.waited = False
+
+            def is_completed(self):
+                return True
+
+            def wait(self):
+                self.waited = True
+                if self._is_recv:
+                    wire.n_recv_waits += 1
+
+        def isend_object(obj, dst):
+            wire.n_isend_object += 1
+            wire.meta[(rank, dst)].append(obj)
+            return _Handle()
+
+        def recv_object(src):
+            return wire.meta[(src, rank)].popleft()
+
+        def isend(t, dst, group):
+            wire.n_isend += 1
+            wire.data[(rank, dst)].append(t.clone())
+            return _Handle()
+
+        def irecv(t, src, group):
+            t.copy_(wire.data[(src, rank)].popleft())
+            return _Handle(is_recv=True)
+
+        return SimpleNamespace(
+            ranks=list(range(self.world_size)),
+            rank_in_group=rank,
+            world_size=self.world_size,
+            is_first_rank=(rank == 0),
+            is_last_rank=(rank == self.world_size - 1),
+            device_group=None,
+            isend_object=isend_object,
+            recv_object=recv_object,
+        ), SimpleNamespace(isend=isend, irecv=irecv)
+
+
+@pytest.mark.parametrize("no_metadata", [False, True])
+def test_one_device_op_per_hop_and_metadata_policy(no_metadata):
+    wire = _Wire()
+    g0, d0 = wire.group(0)
+    g1, d1 = wire.group(1)
+    sender = PackedHop(g0, no_metadata=no_metadata, dist=d0)
+    receiver = PackedHop(g1, no_metadata=no_metadata, dist=d1)
+    layout = HopLayout.from_tensors(_boundary())
+    steps = 4
+    for _ in range(steps):
+        tensors = _boundary(rows=9)  # padded rows beyond the scheduled T
+        handles = sender.send(tensors, rows=T)
+        assert len(handles) == 1
+        got, rh = receiver.recv(layout, rows=T)
+        assert len(rh) == 1
+        for k, v in tensors.items():
+            assert got[k].shape == v[:T].shape
+            assert torch.equal(got[k], v[:T])
+    assert wire.n_isend == steps  # one device transfer per hop
+    # Metadata every step, or only the first-hop handshake.
+    assert wire.n_isend_object == (1 if no_metadata else steps)
+    assert not wire.meta[(0, 1)] and not wire.data[(0, 1)]
+
+
+@pytest.mark.parametrize("num_blocks", K31_BOUNDARY_BLOCKS)
+@pytest.mark.parametrize("no_metadata", [False, True])
+def test_k31_attnres_boundary_varying_decode_and_prefill_shapes(
+    num_blocks, no_metadata
+):
+    wire = _Wire()
+    g0, d0 = wire.group(0)
+    g1, d1 = wire.group(1)
+    sender = PackedHop(g0, no_metadata=no_metadata, dist=d0)
+    receiver = PackedHop(g1, no_metadata=no_metadata, dist=d1)
+    # Persistent receive buffer allocated at max_num_tokens.
+    recv_layout = HopLayout.from_tensors(
+        _k31_boundary(rows=512, num_blocks=num_blocks, hidden_size=64)
+    )
+    token_counts = [1, 2, 3, 4, 5, 6, 7, 8, 12, 16, 64, 256, 8, 1]
+    for step, m in enumerate(token_counts):
+        # Include CUDA-graph padded source tensors and non-contiguous slices.
+        padded = m + (step % 4)
+        src = _k31_boundary(
+            rows=padded, num_blocks=num_blocks, hidden_size=64, seed=step + 1
+        )
+        if step % 2 == 1:
+            # Make residual non-contiguous via transpose round-trip check.
+            src["residual"] = src["residual"].transpose(0, 1).contiguous().transpose(0, 1)
+            assert not src["residual"].is_contiguous()
+        handles = sender.send(src, rows=m)
+        assert len(handles) == 1
+        got, rh = receiver.recv(recv_layout, rows=m)
+        assert len(rh) == 1
+        assert set(got.keys()) == {"hidden_states", "residual"}
+        assert got["hidden_states"].shape == (m, 64)
+        assert got["residual"].shape == (m, num_blocks, 64)
+        assert torch.equal(got["hidden_states"], src["hidden_states"][:m])
+        assert torch.equal(got["residual"], src["residual"][:m])
+    assert wire.n_isend == len(token_counts)
+    assert wire.n_isend_object == (1 if no_metadata else len(token_counts))
+    assert not wire.meta[(0, 1)] and not wire.data[(0, 1)]
+
+
+@pytest.mark.parametrize("num_blocks", K31_BOUNDARY_BLOCKS)
+def test_k31_exact_hidden_size_7168_round_trip(num_blocks):
+    # Exact K3.1 bf16 geometry: hidden_states (M, 7168) + residual (M, B, 7168).
+    # Each row is (1 + B) * 7168 * 2 bytes (56 / 84 / 112 KiB per token).
+    wire = _Wire()
+    g0, d0 = wire.group(0)
+    g1, d1 = wire.group(1)
+    sender = PackedHop(g0, no_metadata=True, dist=d0)
+    receiver = PackedHop(g1, no_metadata=True, dist=d1)
+    recv_layout = HopLayout.from_tensors(
+        _k31_boundary(rows=64, num_blocks=num_blocks, hidden_size=K31_HIDDEN_SIZE)
+    )
+    for m in (1, 4, 8, 16, 64):
+        expected_bytes = m * (1 + num_blocks) * K31_HIDDEN_SIZE * 2
+        assert recv_layout.nbytes(m) == expected_bytes
+        src = _k31_boundary(
+            rows=m, num_blocks=num_blocks, hidden_size=K31_HIDDEN_SIZE, seed=m
+        )
+        sender.send(src, rows=m)
+        got, _ = receiver.recv(recv_layout, rows=m)
+        assert torch.equal(got["hidden_states"], src["hidden_states"])
+        assert torch.equal(got["residual"], src["residual"])
+    assert wire.n_isend == 5
+    assert wire.n_isend_object == 1
+
