+
+    base = _runner([SamplingParams(temperature=0.0)], masked_token_ids=None)
+    batch = _batch(1)
+    batch.num_draft_tokens = 3
+
+    with ta.step(base, batch, None):
+        assert ta.active() and ta.direct_active()
