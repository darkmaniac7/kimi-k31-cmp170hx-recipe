+def test_api_version_validation(monkeypatch):
+    monkeypatch.setattr(
+        torch._C, "_dispatch_find_schema_or_throw", lambda name, overload: None
+    )
+    info = native.runtime_build_info(abi_version=1)
+
+    good_v1 = types.SimpleNamespace(build_info=lambda: {**info, "api_version": 1})
+    good_v2 = types.SimpleNamespace(build_info=lambda: {**info, "api_version": 2})
+    native.validate(good_v1, "_k31_glue_C", 1, glue_ops._OPERATORS, api_version=1)
+    native.validate(good_v2, "_k31_glue_C", 1, glue_ops._OPERATORS, api_version=1)
+
+    missing_api = types.SimpleNamespace(build_info=lambda: dict(info))
+    with pytest.raises(ValueError, match="api_version"):
+        native.validate(
+            missing_api, "_k31_glue_C", 1, glue_ops._OPERATORS, api_version=1
+        )
+
+    stale_api = types.SimpleNamespace(build_info=lambda: {**info, "api_version": 0})
+    with pytest.raises(ValueError, match="api_version"):
+        native.validate(
+            stale_api, "_k31_glue_C", 1, glue_ops._OPERATORS, api_version=1
+        )
+
+    bad_abi = types.SimpleNamespace(
+        build_info=lambda: {**info, "abi_version": 0, "api_version": 1}
+    )
+    with pytest.raises(ValueError, match="abi_version"):
+        native.validate(bad_abi, "_k31_glue_C", 1, glue_ops._OPERATORS, api_version=1)
