+def test_native_loader_refuses_a_foreign_build(monkeypatch):
+    from vllm.sm80.kernels.k31q import native
+
+    info = native.runtime_build_info(3)
+    assert set(info) == {"abi_version", "torch_version", "cuda_version", "cxx11_abi"}
+    library = types.ModuleType("vllm._k31_test_C")
+    monkeypatch.setitem(sys.modules, "vllm._k31_test_C", library)
+    for key, wrong in (
+        ("abi_version", 4),
+        ("torch_version", "0.0.1"),
+        ("cuda_version", info["cuda_version"] + 1000),
+        ("cxx11_abi", 1 - info["cxx11_abi"]),
+    ):
+        library.build_info = lambda key=key, wrong=wrong: info | {key: wrong}
+        with pytest.raises(RuntimeError, match=f"{key} mismatch") as error:
+            native.load("_k31_test_C", 3, (), "BUILD-COMMAND")
+        assert "BUILD-COMMAND" in str(error.value)
+    # A newer minor toolkit of the same CUDA major is the same runtime ABI.
+    library.build_info = lambda: info | {"cuda_version": info["cuda_version"] + 20}
+    assert native.load("_k31_test_C", 3, (), "BUILD-COMMAND") is library
+    # An operator this tree calls that the library does not register.
+    with pytest.raises(RuntimeError, match="BUILD-COMMAND"):
+        native.load("_k31_test_C", 3, ("missing_operator",), "BUILD-COMMAND")
+    # No library at all.
+    with pytest.raises(RuntimeError, match="vllm._k31_absent_C.*BUILD-COMMAND"):
+        native.load("_k31_absent_C", 1, (), "BUILD-COMMAND")
+
