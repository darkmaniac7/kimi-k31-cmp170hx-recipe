+def test_replay_agrees_with_accept_walk():
+    """The rank replay used offline and the token walk used online accept the
+    same number of drafts."""
+    rng = random.Random(23)
+    for _ in range(200):
+        paths = {(0,)}
+        for _ in range(rng.randint(0, 7)):
+            base = rng.choice(sorted(paths) + [()])
+            r = 0
+            while base + (r,) in paths:
+                r += 1
+            if r < 3:
+                paths.add(base + (r,))
+        tree = dt.DraftTree.from_paths(sorted(paths))
+        depth = max(len(p) for p in tree.paths) + 1
+        true_ranks = [rng.randint(0, 2) for _ in range(depth)]
+        # Token of the candidate with rank r after a path: unique per (path, r).
+        ids: dict[tuple[tuple[int, ...], int], int] = {}
+
+        def cand(path, r, ids=ids):
+            return ids.setdefault((path, r), len(ids))
+
+        drafts = [cand(p[:-1], p[-1]) for p in tree.paths]
+        true_path = tuple(true_ranks)
+        targets = []
+        for row_path in ((),) + tree.paths:
+            d = len(row_path)
+            if row_path == true_path[:d] and d < depth:
+                targets.append(cand(row_path, true_ranks[d]))
+            else:
+                targets.append(-1)
+        res = dt.accept_walk(tree, drafts, targets)
+        assert res.num_accepted == dt.replay_accept_depth(tree.paths, true_ranks)
