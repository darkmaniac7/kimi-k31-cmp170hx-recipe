+SCENARIOS = [
+    *(("uniform", rows, 1.0) for rows in GRAPH_ROWS),
+    *(("local", rows, 1.0) for rows in (1, 2, 4, 5, 8, 9, 16, 17, 33, 64)),
+    *(("hot", rows, 1.0) for rows in (5, 13, 16, 40, 64)),
+    ("masked", 9, 1.0),
+    ("single", 2, 1.0),
+    ("int64", 7, 1.0),
+    ("uniform", 40, 16.0),  # the gate/up clamp at 10 is reached
+    ("local", 64, 16.0),
+]
