--- /dev/null
+++ b/vllm/sm80/spec_decode/dspark_row_mask_kernel.py
@@ -0,0 +1,331 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""DSpark adaptive depth: the per-step decision kernel.
+
+Before the target forward of a uniform speculative decode step (every request
+verifies K > 0 drafts in K + 1 rows, no prefill rows), one Triton program per
+request turns its draft-step features, the policy weights and the cost table
+into ``live_len`` and ``row_live`` (see ``dspark_row_mask``). For request r of
+a b-request step, slot ``s = idx_mapping[r]``, in FP32::
+
+    x_i       = [1, logit(c_i), logit(t_i), e_i]
+    p_i       = 1 / (1 + exp(-(sum_f w[i-1][f] * x_i[f])))      (f in order)
+    E(k)      = 1 + sum_{i <= k} prod_{j <= i} p_j
+    cost_r(k) = T_b(K) - (T_b(K) - T_b(k)) / b
+    live_len  = argmax_{k = 0 .. K} E(k) / cost_r(k)     (ties: larger k)
+    or, when tau_b > 0 (b >= 2 with a "tau" in the policy):
+    live_len  = max {k <= K : prod_{j <= k} p_j >= tau_b}   (0 if none)
+
+with ``c_i`` the confidence head's output, ``t_i`` and ``e_i`` the draft
+logits' top-1 probability and entropy (read only when the policy uses them),
+``logit(q) = log(q') - log(1 - q')`` for ``q' = clamp(q, 1e-6, 1 - 1e-6)``.
+K is this step's verified width (it may change every step); the cost row is
+this step's b. Rows ``r*(K+1) + j`` are live iff ``j <= live_len``. Rows past
+the step's ``b*(K+1)`` up to the widest step the state can mask are set live
+(an earlier wider step may have masked them); rows past that are never
+written.
+
+With ``p_hat`` (a policy with a ``host_width`` block, ``dspark_host_width``)
+the kernel also writes each request's ``p_i`` for positions ``1 .. W``,
+``W = p_hat.shape[1]``, whatever K is: positions past K read the features of
+the drafted block (0 past the drafted width), and they change nothing in the
+decision. The host reads them a step later to choose a later step's K.
+
+Any other step leaves every row live (``RowMaskState.reset_live``). The kernel
+runs eagerly on the current stream, after the previous step's draft (which
+wrote the features on the same stream) and before the target forward or
+graph replay that reads ``row_live`` in place. No host synchronisation.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+
+from vllm.sm80.spec_decode.dspark_row_mask import (
+    FEATURES,
+    PROB_EPS,
+    RowMaskState,
+    get_row_mask_state,
+)
+from vllm.triton_utils import tl, triton
+
+__all__ = [
+    "MAX_DRAFTS",
+    "begin_step",
+    "begin_target_step",
+    "compute_row_mask",
+    "reference_row_mask",
+    "uniform_num_drafts",
+]
+
+# Drafts per request the kernel serves (its unrolled loop).
+MAX_DRAFTS = 8
+_BLOCK_ROWS = triton.next_power_of_2(MAX_DRAFTS + 1)
+_NF = len(FEATURES)
+# The Triton interpreter (CPU tests) runs the kernel on CPU tensors and
+# launches without the CUDA compile options.
+_INTERPRET = os.environ.get("TRITON_INTERPRET", "0") == "1"
+
+
+def _mask_span(state: RowMaskState) -> int:
+    """Rows any step can mask: max_num_reqs requests of max_draft + 1 rows."""
+    return min(state.max_num_reqs * (state.max_draft + 1), state.max_num_tokens)
+
+
+@triton.jit
+def _log_odds(q, EPS: tl.constexpr):
+    q = tl.minimum(tl.maximum(q, EPS), 1.0 - EPS)
+    return tl.log(q) - tl.log(1.0 - q)
+
+
+@triton.jit(do_not_specialize=["num_reqs", "num_drafts", "p_width"])
+def _row_mask_kernel(
+    conf_ptr,
+    conf_stride,
+    stats_ptr,
+    stats_stride,
+    w_ptr,
+    tau_ptr,
+    cost_ptr,
+    cost_stride,
+    idx_ptr,
+    live_len_ptr,
+    row_live_ptr,
+    p_hat_ptr,
+    p_hat_stride,
+    num_reqs,
+    num_drafts,
+    p_width,
+    span,
+    MAX_K: tl.constexpr,
+    NF: tl.constexpr,
+    USE_STATS: tl.constexpr,
+    EPS: tl.constexpr,
+    BLOCK_ROWS: tl.constexpr,
+    BLOCK_TAIL: tl.constexpr,
+):
+    r = tl.program_id(0)
+    rows_per_req = num_drafts + 1
+    if r < num_reqs:
+        slot = tl.load(idx_ptr + r).to(tl.int64)
+        conf_row = conf_ptr + slot * conf_stride
+        stats_row = stats_ptr + slot * stats_stride
+        cost_row = cost_ptr + num_reqs * cost_stride
+        tau = tl.load(tau_ptr + num_reqs)
+        use_tau = (tau > 0.0) & (num_reqs > 1)
+        b = num_reqs.to(tl.float32)
+        t_full = tl.load(cost_row + num_drafts)
+        t_zero = tl.load(cost_row)
+        best = tl.math.div_rn(1.0, t_full - tl.math.div_rn(t_full - t_zero, b))
+        best_k = tl.zeros((), dtype=tl.int32)
+        prod = tl.full((), 1.0, dtype=tl.float32)
+        expected = tl.full((), 1.0, dtype=tl.float32)
+        for k in tl.static_range(1, MAX_K + 1):
+            ok = k <= num_drafts
+            # Positions past K only feed p_hat: the decision takes k <= K.
+            out = k <= p_width
+            need = ok | out
+            w = w_ptr + (k - 1) * NF
+            c = tl.load(conf_row + (k - 1), mask=need, other=0.5)
+            z = tl.load(w, mask=need, other=0.0)
+            z = z + tl.load(w + 1, mask=need, other=0.0) * _log_odds(c, EPS)
+            if USE_STATS:
+                top1 = tl.load(stats_row + (k - 1), mask=need, other=0.5)
+                ent = tl.load(stats_row + MAX_K + (k - 1), mask=need, other=0.0)
+                z = z + tl.load(w + 2, mask=need, other=0.0) * _log_odds(top1, EPS)
+                z = z + tl.load(w + 3, mask=need, other=0.0) * ent
+            p = tl.math.div_rn(1.0, 1.0 + tl.exp(-z))
+            tl.store(p_hat_ptr + r * p_hat_stride + (k - 1), p, mask=out)
+            t_k = tl.load(cost_row + k, mask=ok, other=1.0)
+            prod = prod * p
+            expected = expected + prod
+            cost = t_full - tl.math.div_rn(t_full - t_k, b)
+            score = tl.math.div_rn(expected, cost)
+            take = ok & tl.where(use_tau, prod >= tau, score >= best)
+            best = tl.where(take, score, best)
+            best_k = tl.where(take, k, best_k)
+        tl.store(live_len_ptr + r, best_k)
+        j = tl.arange(0, BLOCK_ROWS)
+        live = (j <= best_k).to(tl.int8)
+        tl.store(row_live_ptr + r * rows_per_req + j, live, mask=j < rows_per_req)
+    else:
+        # Rows past this step that a wider earlier step may have masked.
+        offs = num_reqs * rows_per_req + tl.arange(0, BLOCK_TAIL)
+        ones = tl.full((BLOCK_TAIL,), 1, dtype=tl.int8)
+        tl.store(row_live_ptr + offs, ones, mask=offs < span)
+
+
+def _check(
+    state: RowMaskState,
+    idx_mapping: torch.Tensor,
+    num_reqs: int,
+    num_drafts: int,
+    p_hat: torch.Tensor | None,
+):
+    assert 0 < num_reqs <= state.max_num_reqs, (num_reqs, state.max_num_reqs)
+    assert 0 < num_drafts <= min(state.max_draft, MAX_DRAFTS), (num_drafts, state.max_draft)
+    assert num_reqs * (num_drafts + 1) <= state.max_num_tokens
+    assert idx_mapping.dim() == 1 and idx_mapping.shape[0] >= num_reqs, idx_mapping.shape
+    if p_hat is not None:
+        assert p_hat.dtype == torch.float32 and p_hat.dim() == 2, (p_hat.dtype, p_hat.shape)
+        assert p_hat.shape[0] >= num_reqs and p_hat.stride(1) == 1, p_hat.shape
+        assert 0 < p_hat.shape[1] <= state.max_draft, (p_hat.shape, state.max_draft)
+
+
+def _log_odds_torch(q: torch.Tensor) -> torch.Tensor:
+    q = q.clamp(PROB_EPS, 1.0 - PROB_EPS)
+    return torch.log(q) - torch.log(1.0 - q)
+
+
+def reference_row_mask(
+    state: RowMaskState,
+    idx_mapping: torch.Tensor,
+    num_reqs: int,
+    num_drafts: int,
+    p_hat: torch.Tensor | None = None,
+) -> None:
+    """:func:`compute_row_mask` in torch, the same FP32 operations in the same
+    order."""
+    _check(state, idx_mapping, num_reqs, num_drafts, p_hat)
+    n, k_full = num_reqs, num_drafts
+    p_width = 0 if p_hat is None else p_hat.shape[1]
+    slots = idx_mapping[:n].long()
+    conf = state.conf_by_slot[slots, : max(k_full, p_width)]
+    stats = state.stats_by_slot[slots, :, : max(k_full, p_width)]
+    w = state.weights
+    tau = state.tau[n]
+    use_tau = bool(tau > 0) and n > 1
+    row = state.cost[n]
+    b = torch.tensor(float(n), dtype=torch.float32, device=row.device)
+    t_full = row[k_full]
+    one = torch.ones(n, dtype=torch.float32, device=row.device)
+    best = torch.div(one, t_full - torch.div(t_full - row[0], b))
+    best_k = torch.zeros(n, dtype=torch.int32, device=row.device)
+    prod = one.clone()
+    expected = one.clone()
+    for k in range(1, max(k_full, p_width) + 1):
+        wk = w[k - 1]
+        z = wk[0] + wk[1] * _log_odds_torch(conf[:, k - 1])
+        if state.uses_stats:
+            z = z + wk[2] * _log_odds_torch(stats[:, 0, k - 1])
+            z = z + wk[3] * stats[:, 1, k - 1]
+        p = torch.div(one, 1.0 + torch.exp(-z))
+        if k <= p_width:
+            assert p_hat is not None
+            p_hat[:n, k - 1] = p
+        if k > k_full:
+            continue
+        prod = prod * p
+        expected = expected + prod
+        cost = t_full - torch.div(t_full - row[k], b)
+        score = torch.div(expected, cost)
+        take = (prod >= tau) if use_tau else (score >= best)
+        best = torch.where(take, score, best)
+        best_k = torch.where(take, torch.full_like(best_k, k), best_k)
+    state.live_len[:n] = best_k
+    j = torch.arange(k_full + 1, device=best_k.device, dtype=torch.int32)
+    end = n * (k_full + 1)
+    state.row_live[:end] = (j[None, :] <= best_k[:, None]).to(torch.int8).reshape(-1)
+    state.row_live[end : _mask_span(state)] = 1
+    state.active = True
+
+
+def compute_row_mask(
+    state: RowMaskState,
+    idx_mapping: torch.Tensor,
+    num_reqs: int,
+    num_drafts: int,
+    p_hat: torch.Tensor | None = None,
+) -> None:
+    """Write ``live_len[:num_reqs]`` and ``row_live`` for a uniform step of
+    ``num_reqs`` requests verifying ``num_drafts`` drafts each; ``idx_mapping``
+    gives each request's state slot (device, batch order); with ``p_hat``
+    ([>= num_reqs, W] float32, rows contiguous) also each request's ``p_i``
+    for i = 1 .. W. One launch, no host synchronisation; the torch reference
+    on CPU tensors."""
+    if not (state.row_live.is_cuda or _INTERPRET):
+        reference_row_mask(state, idx_mapping, num_reqs, num_drafts, p_hat)
+        return
+    _check(state, idx_mapping, num_reqs, num_drafts, p_hat)
+    span = _mask_span(state)
+    options = {} if _INTERPRET else {"enable_fp_fusion": False}
+    _row_mask_kernel[(num_reqs + 1,)](
+        state.conf_by_slot,
+        state.conf_by_slot.stride(0),
+        state.stats_by_slot,
+        state.stats_by_slot.stride(0),
+        state.weights,
+        state.tau,
+        state.cost,
+        state.cost.stride(0),
+        idx_mapping,
+        state.live_len,
+        state.row_live,
+        state.weights if p_hat is None else p_hat,  # never written without p_hat
+        0 if p_hat is None else p_hat.stride(0),
+        num_reqs,
+        num_drafts,
+        0 if p_hat is None else p_hat.shape[1],
+        span,
+        MAX_K=state.max_draft,
+        NF=_NF,
+        USE_STATS=state.uses_stats,
+        EPS=PROB_EPS,
+        BLOCK_ROWS=_BLOCK_ROWS,
+        BLOCK_TAIL=triton.next_power_of_2(span),
+        num_warps=1,
+        **options,
+    )
+    state.active = True
+
+
+def uniform_num_drafts(state: RowMaskState, input_batch, dummy_run: bool) -> int:
+    """K when the step is a uniform speculative decode the mask serves (every
+    request verifies the same K > 0 drafts in K + 1 rows, no prefill rows,
+    no GPU-side draft reallocation), else 0. Host facts only."""
+    if dummy_run or input_batch.has_prefill or input_batch.max_query_len is not None:
+        # max_query_len is set only when drafts are reallocated on the GPU.
+        return 0
+    drafts = input_batch.num_draft_tokens_per_req
+    num_reqs = input_batch.num_reqs
+    if drafts is None or not 0 < num_reqs <= state.max_num_reqs:
+        return 0
+    k = int(drafts[0])
+    if not 0 < k <= min(state.max_draft, MAX_DRAFTS):
+        return 0
+    if input_batch.num_tokens != num_reqs * (k + 1) or not (drafts[:num_reqs] == k).all():
+        return 0
+    return k
+
+
+def begin_step(state: RowMaskState, input_batch, dummy_run: bool) -> None:
+    """The mask for this step's target forward: computed on a uniform
+    speculative decode step, every row live on any other. With the host
+    width on, ``state.p_hat_step`` is the step's new ``p_hat`` (batch order)
+    on a uniform step and None on any other."""
+    k = uniform_num_drafts(state, input_batch, dummy_run)
+    state.p_hat_step = None
+    if k:
+        p_hat = None
+        if state.p_hat_width:
+            p_hat = torch.empty(
+                input_batch.num_reqs,
+                state.p_hat_width,
+                dtype=torch.float32,
+                device=state.row_live.device,
+            )
+        compute_row_mask(state, input_batch.idx_mapping, input_batch.num_reqs, k, p_hat)
+        state.p_hat_step = p_hat
+    else:
+        state.reset_live()
+
+
+def begin_target_step(input_batch, dummy_run: bool) -> None:
+    """Runner entry, right before the target forward: :func:`begin_step` on
+    the shared state; nothing when adaptive depth is off."""
+    state = get_row_mask_state()
+    if state is not None:
+        begin_step(state, input_batch, dummy_run)
+
diff --git a/vllm/sm80/spec_decode/dspark_row_mask_reject.py b/vllm/sm80/spec_decode/dspark_row_mask_reject.py
new file mode 100644
index 0000000000..0fac1fc92a
--- /dev/null
+++ b/vllm/sm80/spec_decode/dspark_row_mask_reject.py
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""DSpark row mask: reject the drafts on masked verify rows.
+
+A logits row's draft is the input token of that row (row j of a request
+holds draft j). When the step's target forward ran with the row mask
+(``dspark_row_mask.py``), the rows past a request's ``live_len`` took no
+routed expert, so their drafts must not be verified: ``cap_drafts`` adds
+them to the rejection sampler's ``invalid_drafts`` mask, which verifies them
+as -1 proposals (``RejectionSampler.__call__``: only the verification copy of
+the draft ids is changed; sampling params, watermarking and the forward's
+input ids keep the real drafts).
+
+A -1 draft at row j + 1 stops verification at row j: greedy stores the
+target argmax of row j, probabilistic samples row j's target distribution
+with the request's seed at row j's position (no residual), exactly as for a
+step that proposed only drafts 1..j. Rows 0..live_len are live, so every
+emitted token comes from a live row, and greedy output is the unmasked
+output truncated at ``live_len`` accepted drafts. The masked drafts count as
+proposed and rejected: ``num_rejected`` (and so the drafter's next context
+and the scheduler's rollback) covers them.
+"""
+
+from __future__ import annotations
+
+import torch
+
+from vllm.sm80.spec_decode.dspark_row_mask import get_row_mask_state
+
+
+def cap_drafts(
+    logits_indices: torch.Tensor, invalid_drafts: torch.Tensor | None
+) -> torch.Tensor | None:
+    """``invalid_drafts`` with the drafts on masked rows added.
+
+    ``logits_indices`` [num_logits]: the token row of each logits row of the
+    sampler's batch (with batch-sharded sampling, the local rows, which still
+    index the forward's tokens). ``invalid_drafts``: None or bool
+    [num_logits]. Returns the input unchanged (no kernel) unless this step's
+    forward applied a mask.
+    """
+    state = get_row_mask_state()
+    if state is None or not state.active:
+        return invalid_drafts
+    masked = state.row_live.index_select(0, logits_indices).eq(0)
+    if invalid_drafts is None:
+        return masked
+    return masked.logical_or_(invalid_drafts)
diff --git a/vllm/sm80/spec_decode/dspark_suffix_hybrid.py b/vllm/sm80/spec_decode/dspark_suffix_hybrid.py
new file mode 100644
index 0000000000..951fef1318
--- /dev/null
+++ b/vllm/sm80/spec_decode/dspark_suffix_hybrid.py
@@ -0,0 +1,776 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Switch-gated DSpark + Suffix/N-Gram hybrid proposer (K3.1 Lever 3).
+
+Applied through ``wrap_dspark_speculator_cls`` when
+``VLLM_DSPARK_SUFFIX_HYBRID=1`` (default off: returns DSpark unchanged).
+
+Runs DSpark as usual (keeping DSpark context K/V synchronized on every step),
+then runs upstream's device-resident ``SuffixSpeculator`` on the same GPU
+batch without any host synchronization. When a request has a strong suffix
+match (``match_len >= min_match_len`` and ``num_valid > 0``) whose acceptance
+confidence beats DSpark or extends coherently past DSpark's low-confidence
+tail, those draft slots are replaced with the suffix continuation and
+``draft_token_confidence_probs`` is updated so host Adaptive-K width tiers
+automatically widen to K=9..12 on repetitive code, refactors, JSON, or
+copy-paste passages.
+
+Optional ``match_len == 4`` gates (active only when ``min_match_len > 4``,
+default off so unset behavior is unchanged):
+  - ``VLLM_DSPARK_SUFFIX_LOWCONF_LEN4`` (float, default ``0.0``): admit
+    ``match_len == 4`` when DSpark step-0 confidence is below this threshold
+    (or for coherent prefix-agreed tail extension where slot 0 already agrees).
+  - ``VLLM_DSPARK_SUFFIX_LEN4_MIN_SCORE`` (int, default ``0``; alias
+    ``VLLM_DSPARK_SUFFIX_MIN_SCORE``): admit ``match_len == 4`` when the
+    on-device repeat/prompt score (distinct 256-token history blocks with a
+    >=4-gram match plus +1 when the match originates in the prompt) is at
+    least ``min_score``, with calibrated ``len==4`` prior confidence capped by
+    ``VLLM_DSPARK_SUFFIX_LEN4_CONF_CAP`` (default ``0.70``) so prose never
+    suffers spurious high-confidence 4-gram overrides.
+"""
+
+from __future__ import annotations
+
+import inspect
+import math
+import os
+from functools import cache
+from typing import TYPE_CHECKING, Any
+
+import torch
+
+import vllm.envs as envs
+from vllm.logger import init_logger
+
+_NUM_LEN_BUCKETS = 9
+
+if TYPE_CHECKING:
+    from collections.abc import Iterable
+
+    from vllm.config import VllmConfig
+    from vllm.v1.core.sched.output import NewRequestData
+    from vllm.v1.worker.gpu.states import RequestState
+
+logger = init_logger(__name__)
+
+# Lower bound of match length for each of SuffixSpeculator's 9 length buckets
+# (lengths 1..6 map to buckets 0..5; 7..10 -> 6; 11..20 -> 7; 21+ -> 8).
+_BUCKET_MIN_LEN = (1, 2, 3, 4, 5, 6, 7, 11, 21)
+_DEFAULT_DSPARK_CONF = 0.5
+_PRIOR_STRENGTH = 4.0
+_VALID_MODES = frozenset({"hybrid", "replace"})
+_DEFAULT_LOG_INTERVAL = 64
+_DEFAULT_LEN4_CONF_CAP = 0.70
+_LEN4_DECAY = 0.88
+
+
+def _resolve_log_interval(vllm_config: Any) -> int:
+    """Resolve periodic suffix telemetry interval without adding new env vars."""
+    spec = getattr(vllm_config, "speculative_config", None)
+    if spec is None:
+        return _DEFAULT_LOG_INTERVAL
+    ak_cfg = getattr(spec, "adaptive_k_config", None)
+    interval = getattr(ak_cfg, "log_interval", 0) if ak_cfg is not None else 0
+    if not interval:
+        ak_raw = getattr(spec, "adaptive_k", None)
+        if isinstance(ak_raw, dict):
+            interval = ak_raw.get("log_interval", 0)
+        elif ak_raw is not None:
+            interval = getattr(ak_raw, "log_interval", 0)
+    try:
+        interval_int = int(interval)
+    except (TypeError, ValueError):
+        return _DEFAULT_LOG_INTERVAL
+    return interval_int if interval_int > 0 else _DEFAULT_LOG_INTERVAL
+
+
+def _resolve_lowconf_len4() -> float:
+    raw = os.environ.get("VLLM_DSPARK_SUFFIX_LOWCONF_LEN4", "").strip()
+    if not raw:
+        return 0.0
+    val = float(raw)
+    if not (0.0 <= val <= 1.0):
+        raise ValueError(
+            f"VLLM_DSPARK_SUFFIX_LOWCONF_LEN4 must be in [0.0, 1.0], got {val!r}."
+        )
+    return val
+
+
+def _resolve_len4_min_score() -> int:
+    raw = (
+        os.environ.get("VLLM_DSPARK_SUFFIX_LEN4_MIN_SCORE", "").strip()
+        or os.environ.get("VLLM_DSPARK_SUFFIX_MIN_SCORE", "").strip()
+    )
+    if not raw:
+        return 0
+    val = int(raw)
+    if val < 0:
+        raise ValueError(
+            f"VLLM_DSPARK_SUFFIX_LEN4_MIN_SCORE must be >= 0, got {val!r}."
+        )
+    return val
+
+
+def _resolve_len4_conf_cap() -> float:
+    raw = os.environ.get("VLLM_DSPARK_SUFFIX_LEN4_CONF_CAP", "").strip()
+    if not raw:
+        return _DEFAULT_LEN4_CONF_CAP
+    val = float(raw)
+    if not (0.0 < val <= 0.99):
+        raise ValueError(
+            f"VLLM_DSPARK_SUFFIX_LEN4_CONF_CAP must be in (0.0, 0.99], got {val!r}."
+        )
+    return val
+
+
+def _bucket_min_len_on_device(len_bucket: torch.Tensor) -> torch.Tensor:
+    # Pure on-device mapping (0..5 -> 1..6, 6 -> 7, 7 -> 11, 8 -> 21): CUDA-graph safe.
+    val = len_bucket + 1
+    val = torch.where(len_bucket == 7, torch.full_like(val, 11), val)
+    val = torch.where(len_bucket >= 8, torch.full_like(val, 21), val)
+    return val
+
+
+def extract_suffix_match_len(
+    suffix_spec: Any,
+    idx_mapping: torch.Tensor,
+    num_reqs: int,
+) -> torch.Tensor:
+    """Compute per-request suffix match length on device with zero host sync.
+
+    Combines the exact local-history match length packed in
+    ``suffix_spec.scratch`` (``match_len * (max_model_len + 1) + end_pos``)
+    with the lower bound implied by ``suffix_spec.last_bucket`` for
+    cross-request corpus matches.
+    """
+    device = idx_mapping.device
+    lp1 = int(getattr(suffix_spec, "max_model_len", 0)) + 1
+    scratch = getattr(suffix_spec, "scratch", None)
+    if scratch is not None and lp1 > 0:
+        local_scores = scratch[:num_reqs].amax(dim=1)
+        local_len = torch.div(local_scores, lp1, rounding_mode="floor")
+    else:
+        local_len = torch.zeros(num_reqs, dtype=torch.int64, device=device)
+
+    last_bucket = getattr(suffix_spec, "last_bucket", None)
+    if last_bucket is None:
+        return local_len
+
+    buckets = last_bucket[idx_mapping[:num_reqs].long()].to(torch.int64)
+    n_buckets = int(_NUM_LEN_BUCKETS)
+    len_bucket = torch.remainder(buckets.clamp(min=0), n_buckets)
+    bucket_len = torch.where(
+        buckets >= 0, _bucket_min_len_on_device(len_bucket), torch.zeros_like(local_len)
+    )
+    return torch.maximum(local_len, bucket_len)
+
+
+def extract_suffix_len4_score(
+    suffix_spec: Any,
+    idx_mapping: torch.Tensor,
+    num_reqs: int,
+) -> torch.Tensor:
+    """Compute per-request ``match_len >= 4`` frequency/prompt score on device.
+
+    Score = (number of 256-token history blocks in ``scratch`` with a >=4-token
+    match) + (1 if the winning local >=4-gram match lies within the request's
+    prompt tokens ``end_pos <= prefill_len``, else 0) + (2 if the match came
+    from the cross-request corpus bucket ``source == 1`` with ``len >= 4``).
+    Zero host sync, CUDA-graph safe.
+    """
+    device = idx_mapping.device
+    lp1 = int(getattr(suffix_spec, "max_model_len", 0)) + 1
+    scratch = getattr(suffix_spec, "scratch", None)
+    if scratch is None or lp1 <= 0:
+        return torch.zeros(num_reqs, dtype=torch.int64, device=device)
+
+    rows = scratch[:num_reqs]
+    block_lens = torch.div(rows, lp1, rounding_mode="floor")
+    block_hits_ge4 = (block_lens >= 4).to(torch.int64).sum(dim=1)
+
+    local_scores = rows.amax(dim=1)
+    local_len = torch.div(local_scores, lp1, rounding_mode="floor")
+    local_end_pos = local_scores - local_len * lp1
+
+    req_states = getattr(suffix_spec, "req_states", None)
+    prefill_buf = getattr(getattr(req_states, "prefill_len", None), "gpu", None)
+    if prefill_buf is not None:
+        prefill_len = prefill_buf[idx_mapping[:num_reqs].long()].to(torch.int64)
+        in_prompt = (
+            (local_len >= 4) & (local_end_pos > 0) & (local_end_pos <= prefill_len)
+        ).to(torch.int64)
+    else:
+        in_prompt = torch.zeros_like(block_hits_ge4)
+
+    last_bucket = getattr(suffix_spec, "last_bucket", None)
+    if last_bucket is not None:
+        buckets = last_bucket[idx_mapping[:num_reqs].long()].to(torch.int64)
+        corpus_ge4 = (
+            (buckets >= _NUM_LEN_BUCKETS)
+            & (torch.remainder(buckets.clamp(min=0), _NUM_LEN_BUCKETS) >= 3)
+        ).to(torch.int64) * 2
+    else:
+        corpus_ge4 = torch.zeros_like(block_hits_ge4)
+
+    return block_hits_ge4 + in_prompt + corpus_ge4
+
+
+def compute_suffix_confidence(
+    suffix_match_len: torch.Tensor,
+    suffix_num_valid: torch.Tensor,
+    width: int,
+    *,
+    min_match_len: int = 4,
+    conf_floor: float = 0.85,
+    accept_stats: torch.Tensor | None = None,
+    buckets: torch.Tensor | None = None,
+    prior_strength: float = _PRIOR_STRENGTH,
+    allow_len4: bool = False,
+    len4_conf_cap: float = _DEFAULT_LEN4_CONF_CAP,
+) -> torch.Tensor:
+    """Per-slot suffix acceptance probability ``[num_reqs, width]`` on device.
+
+    Cold start follows a match-length prior (>= ``conf_floor`` for strong
+    matches, mild 0.99^pos decay). When ``allow_len4`` admits ``match_len == 4``
+    below ``min_match_len``, those rows receive a calibrated conservative prior
+    (``len4_conf_cap * 0.88^pos``) so a 4-gram match never over-inflates
+    expected acceptance above confident prose DSpark prefixes.
+    """
+    device = suffix_match_len.device
+    pos = torch.arange(width, dtype=torch.float32, device=device).unsqueeze(0)
+    extra = (suffix_match_len.to(torch.float32) - float(min_match_len)).clamp(min=0.0)
+    base = (float(conf_floor) + 0.02 * extra).clamp(min=0.0, max=0.98)
+    decay = torch.exp(pos * math.log(0.99))
+    strong_prior = (base.unsqueeze(1) * decay).clamp(min=0.0, max=0.99)
+
+    is_sub_len4 = allow_len4 & (suffix_match_len == 4) & (int(min_match_len) > 4)
+    if allow_len4 and int(min_match_len) > 4:
+        len4_decay = torch.exp(pos * math.log(_LEN4_DECAY))
+        len4_prior = (float(len4_conf_cap) * len4_decay).clamp(min=0.0, max=0.99)
+        prior = torch.where(is_sub_len4.unsqueeze(1), len4_prior, strong_prior)
+    else:
+        prior = strong_prior
+
+    slot_valid = (
+        torch.arange(width, dtype=torch.int64, device=device).unsqueeze(0)
+        < suffix_num_valid.to(torch.int64).unsqueeze(1)
+    )
+    eff_min = 4 if (allow_len4 and int(min_match_len) > 4) else int(min_match_len)
+    row_ok = suffix_match_len >= eff_min
+    valid_mask = slot_valid & row_ok.unsqueeze(1)
+
+    conf = prior
+    if accept_stats is not None and buckets is not None and accept_stats.shape[1] >= width:
+        b_idx = buckets.to(torch.int64).clamp(min=0, max=accept_stats.shape[0] - 1)
+        stats_rows = accept_stats[b_idx, :width]  # [num_reqs, width, 2]
+        acc = stats_rows[..., 0].to(torch.float32)
+        obs = stats_rows[..., 1].to(torch.float32)
+        shrunk = (acc + float(prior_strength) * prior) / (obs + float(prior_strength))
+        if allow_len4 and int(min_match_len) > 4:
+            shrunk = torch.where(
+                is_sub_len4.unsqueeze(1),
+                shrunk.clamp(max=float(len4_conf_cap)),
+                shrunk,
+            )
+        has_bucket = (buckets >= 0).unsqueeze(1)
+        conf = torch.where(has_bucket, shrunk, prior)
+
+    return torch.where(valid_mask, conf, torch.zeros_like(conf))
+
+
+def blend_dspark_and_suffix(
+    dspark_drafts: torch.Tensor,
+    dspark_conf: torch.Tensor,
+    suffix_drafts: torch.Tensor,
+    suffix_num_valid: torch.Tensor,
+    suffix_match_len: torch.Tensor,
+    suffix_conf: torch.Tensor,
+    *,
+    min_match_len: int = 4,
+    mode: str = "hybrid",
+    lowconf_len4: float = 0.0,
+    len4_score: torch.Tensor | None = None,
+    len4_min_score: int = 0,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Blend DSpark and Suffix proposals per request on device (zero host sync).
+
+    Args:
+        dspark_drafts: ``[num_reqs, width]`` int64 DSpark draft tokens.
+        dspark_conf: ``[num_reqs, width]`` float32 DSpark confidences.
+        suffix_drafts: ``[num_reqs, width]`` int64 Suffix draft tokens.
+        suffix_num_valid: ``[num_reqs]`` int32/int64 valid suffix token counts.
+        suffix_match_len: ``[num_reqs]`` int64 longest suffix match lengths.
+        suffix_conf: ``[num_reqs, width]`` float32 suffix per-slot confidences.
+        min_match_len: minimum match length to admit suffix overrides.
+        mode: ``"hybrid"`` (expected-accepted + coherent tail extension) or
+            ``"replace"`` (override all valid suffix slots when eligible).
+        lowconf_len4: if > 0 and ``min_match_len > 4``, allow ``match_len == 4``
+            when ``dspark_conf[:, 0] < lowconf_len4`` (plus coherent tail
+            extension when slot 0 agrees).
+        len4_score: optional ``[num_reqs]`` int64 repeat/prompt score for
+            ``match_len == 4`` gating.
+        len4_min_score: if > 0 and ``min_match_len > 4``, allow ``match_len == 4``
+            when ``len4_score >= len4_min_score``.
+
+    Returns:
+        ``(blended_drafts, blended_conf, override_mask, used_suffix_row)``.
+    """
+    if mode not in _VALID_MODES:
+        raise ValueError(
+            f"VLLM_DSPARK_SUFFIX_MODE must be one of {sorted(_VALID_MODES)}, got {mode!r}."
+        )
+    device = dspark_drafts.device
+    num_reqs, width = dspark_drafts.shape
+    pos = torch.arange(width, dtype=torch.int64, device=device).unsqueeze(0)
+    slot_valid = pos < suffix_num_valid.to(torch.int64).unsqueeze(1)
+    has_valid = suffix_num_valid > 0
+    strong_row = (suffix_match_len >= int(min_match_len)) & has_valid
+
+    is_len4 = (
+        (suffix_match_len == 4) & has_valid
+        if int(min_match_len) > 4
+        else torch.zeros_like(strong_row)
+    )
+    len4_gated = torch.zeros_like(strong_row)
+    len4_tail_only = torch.zeros_like(strong_row)
+    if int(min_match_len) > 4 and width > 0:
+        if float(lowconf_len4) > 0.0:
+            d0 = dspark_conf[:, 0].clamp(0.0, 1.0)
+            len4_gated = len4_gated | (is_len4 & (d0 < float(lowconf_len4)))
+            len4_tail_only = len4_tail_only | is_len4
+        if int(len4_min_score) > 0 and len4_score is not None:
+            len4_gated = len4_gated | (is_len4 & (len4_score >= int(len4_min_score)))
+            len4_tail_only = len4_tail_only | is_len4
+
+    row_eligible = strong_row | len4_gated
+
+    if mode == "replace":
+        override_mask = row_eligible.unsqueeze(1) & slot_valid
+    else:
+        # Expected accepted drafts per request: sum_i prod_{j<=i} p_j.
+        e_dspark = torch.cumprod(dspark_conf.clamp(0.0, 1.0), dim=1).sum(dim=1)
+        e_suffix = torch.cumprod(suffix_conf.clamp(0.0, 1.0), dim=1).sum(dim=1)
+        take_whole = row_eligible & (e_suffix >= e_dspark)
+
+        # Coherent tail extension: if DSpark and Suffix agree on all slots
+        # before position j and Suffix beats DSpark at j, switch to Suffix's
+        # continuation from j through suffix_num_valid - 1. For tail-only
+        # len==4 rows (where step-0 DSpark was confident and score < min_score),
+        # require agreement on slot 0 (pos >= 1) so slot 0 is never replaced.
+        agree = (suffix_drafts == dspark_drafts) & slot_valid
+        if width > 1:
+            ones = torch.ones((num_reqs, 1), dtype=torch.int32, device=device)
+            prior_agree = torch.cat([ones, agree[:, :-1].to(torch.int32)], dim=1)
+            prefix_agrees_before = torch.cumprod(prior_agree, dim=1).bool()
+        else:
+            prefix_agrees_before = torch.ones_like(agree, dtype=torch.bool)
+
+        tail_slot_allowed = row_eligible.unsqueeze(1) | (
+            len4_tail_only.unsqueeze(1) & (pos >= 1)
+        )
+        switch_point = (
+            tail_slot_allowed
+            & slot_valid
+            & prefix_agrees_before
+            & (suffix_conf > dspark_conf)
+        )
+        take_tail = (
+            torch.cummax(switch_point.to(torch.int8), dim=1).values.bool() & slot_valid
+        )
+        override_mask = (take_whole.unsqueeze(1) & slot_valid) | take_tail
+
+    blended_drafts = torch.where(override_mask, suffix_drafts, dspark_drafts)
+    # Slots past suffix_num_valid keep DSpark tokens conditioned on DSpark's
+    # original prefix. When suffix replaces any prefix slot with a different
+    # token, zero tail confidences past suffix_num_valid so Adaptive-K and
+    # confidence dumps never see overstated tail confidence.
+    prefix_diverged = (override_mask & (suffix_drafts != dspark_drafts)).any(dim=1)
+    stale_tail = prefix_diverged.unsqueeze(1) & (~slot_valid)
+    blended_conf = torch.where(override_mask, suffix_conf, dspark_conf)
+    blended_conf = torch.where(
+        stale_tail, torch.zeros_like(blended_conf), blended_conf
+    )
+    used_suffix_row = override_mask.any(dim=1)
+    return blended_drafts, blended_conf, override_mask, used_suffix_row
+
+
+def update_draft_logits_for_suffix(
+    draft_logits: Any,
+    idx_mapping: torch.Tensor,
+    blended_drafts: torch.Tensor,
+    override_mask: torch.Tensor,
+) -> None:
+    """Write one-hot draft logits on suffix-overridden slots (zero host sync).
+
+    For probabilistic rejection sampling (when ``draft_logits`` is active), a
+    deterministic suffix token corresponds to ``q(d) = 1`` (0.0 at ``d``,
+    -1e4 elsewhere), preserving lossless target distribution sampling while
+    leaving untouched DSpark slots bit-identical.
+    """
+    if draft_logits is None:
+        return
+    values = getattr(draft_logits, "values", draft_logits)
+    row_mapping = getattr(draft_logits, "row_mapping", None)
+    num_rows, num_steps, vocab_size = values.shape
+    num_reqs, width = blended_drafts.shape
+    w = min(width, num_steps)
+    if num_reqs == 0 or w == 0 or num_rows == 0 or vocab_size == 0:
+        return
+
+    req_idx = idx_mapping[:num_reqs].to(torch.int64)
+    rows = row_mapping[req_idx].to(torch.int64) if row_mapping is not None else req_idx
+    valid_row = (rows >= 0) & (rows < num_rows)
+    safe_rows = rows.clamp(min=0, max=num_rows - 1)
+    eff_mask = override_mask[:, :w] & valid_row.unsqueeze(1)
+
+    # Order-independent merge by cache row so clamped invalid rows (-1 -> 0)
+    # can never overwrite a valid row 0 in the same batch.
+    row_override = torch.zeros((num_rows, w), dtype=torch.int32, device=values.device)
+    row_override.index_put_((safe_rows,), eff_mask.to(torch.int32), accumulate=True)
+    row_toks = torch.zeros((num_rows, w), dtype=torch.int64, device=values.device)
+    masked_toks = torch.where(
+        eff_mask,
+        blended_drafts[:, :w].clamp(min=0, max=vocab_size - 1),
+        torch.zeros_like(blended_drafts[:, :w]),
+    )
+    row_toks.index_put_((safe_rows,), masked_toks, accumulate=True)
+
+    # In-place masked fill + 1-column gather/scatter on a zero-copy view:
+    # allocates ZERO [B, W, V] temporaries and performs ZERO host syncs
+    # (safe inside CUDA Graph capture).
+    row_override_bool = row_override.bool()
+    values_view = values[:, :w, :]
+    values_view.masked_fill_(row_override_bool.unsqueeze(-1), -1e4)
+    tok_idx = row_toks.unsqueeze(-1)
+    cur_at_tok = values_view.gather(-1, tok_idx)
+    new_at_tok = torch.where(
+        row_override_bool.unsqueeze(-1),
+        torch.zeros_like(cur_at_tok),
+        cur_at_tok,
+    )
+    values_view.scatter_(-1, tok_idx, new_at_tok)
+
+
+class DSparkSuffixHybridMixin:
+    """Mixed in front of a DSpark speculator class by ``suffix_hybrid_class``."""
+
+    _suffix: Any = None
+    _suffix_min_match_len: int = 4
+    _suffix_conf_floor: float = 0.85
+    _suffix_mode: str = "hybrid"
+    _suffix_lowconf_len4: float = 0.0
+    _suffix_len4_min_score: int = 0
+    _suffix_len4_conf_cap: float = _DEFAULT_LEN4_CONF_CAP
+    _suffix_log_interval: int = _DEFAULT_LOG_INTERVAL
+    _suffix_stats: torch.Tensor | None = None
+    _suffix_stat_steps: torch.Tensor | None = None
+    _suffix_stat_hits: torch.Tensor | None = None
+    _suffix_stat_slots: torch.Tensor | None = None
+    _suffix_stat_max_len: torch.Tensor | None = None
+    _suffix_stats_host: torch.Tensor | None = None
+    _suffix_stats_event: Any = None
+    _suffix_copy_pending: bool = False
+    _suffix_steps_since_stage: int = 0
+    _last_suffix_used: torch.Tensor | None = None
+    _last_suffix_match_len: torch.Tensor | None = None
+
+    def __init__(
+        self,
+        vllm_config: VllmConfig,
+        device: torch.device,
+        req_states: RequestState | None = None,
+    ) -> None:
+        super().__init__(vllm_config, device)  # type: ignore[call-arg]
+        self._suffix_min_match_len = int(envs.VLLM_DSPARK_SUFFIX_MIN_MATCH_LEN)
+        self._suffix_conf_floor = float(envs.VLLM_DSPARK_SUFFIX_CONF_FLOOR)
+        self._suffix_mode = str(envs.VLLM_DSPARK_SUFFIX_MODE)
+        if self._suffix_mode not in _VALID_MODES:
+            raise ValueError(
+                f"VLLM_DSPARK_SUFFIX_MODE must be one of {sorted(_VALID_MODES)}, "
+                f"got {self._suffix_mode!r}."
+            )
+        self._suffix_lowconf_len4 = _resolve_lowconf_len4()
+        self._suffix_len4_min_score = _resolve_len4_min_score()
+        self._suffix_len4_conf_cap = _resolve_len4_conf_cap()
+        self._suffix_log_interval = _resolve_log_interval(vllm_config)
+        self._suffix = None
+        self._suffix_stats = None
+        self._suffix_stat_steps = None
+        self._suffix_stat_hits = None
+        self._suffix_stat_slots = None
+        self._suffix_stat_max_len = None
+        self._suffix_stats_host = None
+        self._suffix_stats_event = None
+        self._suffix_copy_pending = False
+        self._suffix_steps_since_stage = 0
+        if req_states is not None:
+            self._suffix = self._build_suffix_speculator(vllm_config, device, req_states)
+            self._init_suffix_stats(device)
+            logger.info(
+                "DSpark Suffix Hybrid active (VLLM_DSPARK_SUFFIX_HYBRID=1): "
+                "mode=%s, min_match_len=%d, conf_floor=%.2f, "
+                "lowconf_len4=%.2f, len4_min_score=%d",
+                self._suffix_mode,
+                self._suffix_min_match_len,
+                self._suffix_conf_floor,
+                self._suffix_lowconf_len4,
+                self._suffix_len4_min_score,
+            )
+        else:
+            logger.warning(
+                "VLLM_DSPARK_SUFFIX_HYBRID=1 but req_states was not provided; "
+                "running DSpark without suffix matching."
+            )
+
+    def _init_suffix_stats(self, device: torch.device) -> None:
+        dev = torch.device(device)
+        self._suffix_stats = torch.zeros(4, dtype=torch.int64, device=dev)
+        self._suffix_stat_steps = self._suffix_stats[0]
+        self._suffix_stat_hits = self._suffix_stats[1]
+        self._suffix_stat_slots = self._suffix_stats[2]
+        self._suffix_stat_max_len = self._suffix_stats[3]
+        self._suffix_copy_pending = False
+        self._suffix_steps_since_stage = 0
+        if dev.type == "cuda":
+            self._suffix_stats_host = torch.empty(
+                4, dtype=torch.int64, pin_memory=True
+            )
+            self._suffix_stats_event = torch.cuda.Event()
+        else:
+            self._suffix_stats_host = None
+            self._suffix_stats_event = None
+
+    def _emit_suffix_stats(self, buf: torch.Tensor) -> None:
+        logger.info(
+            "DSpark Suffix Hybrid: %d steps, %d req-hits, "
+            "%d draft slots overridden, max_match_len=%d",
+            int(buf[0]),
+            int(buf[1]),
+            int(buf[2]),
+            int(buf[3]),
+        )
+
+    def _record_suffix_telemetry(
+        self,
+        used_suffix_row: torch.Tensor,
+        override_mask: torch.Tensor,
+        match_len: torch.Tensor,
+    ) -> None:
+        if self._suffix_stats is None:
+            return
+        dev = used_suffix_row.device
+        is_cuda = dev.type == "cuda"
+        capturing = is_cuda and torch.cuda.is_current_stream_capturing()
+        if self._suffix_stats.device != dev:
+            if capturing:
+                return
+            self._init_suffix_stats(dev)
+
+        assert self._suffix_stat_steps is not None
+        assert self._suffix_stat_hits is not None
+        assert self._suffix_stat_slots is not None
+        assert self._suffix_stat_max_len is not None
+
+        # Pure on-device accumulator updates: zero host sync, CUDA-Graph safe.
+        self._suffix_stat_steps += 1
+        self._suffix_stat_hits += used_suffix_row.to(torch.int64).sum()
+        self._suffix_stat_slots += override_mask.to(torch.int64).sum()
+        torch.maximum(
+            self._suffix_stat_max_len,
+            match_len.to(torch.int64).amax(),
+            out=self._suffix_stat_max_len,
+        )
+
+        if capturing:
+            return
+
+        self._suffix_steps_since_stage += 1
+        if is_cuda:
+            if (
+                self._suffix_copy_pending
+                and self._suffix_stats_event is not None
+                and self._suffix_stats_host is not None
+                and self._suffix_stats_event.query()
+            ):
+                self._emit_suffix_stats(self._suffix_stats_host)
+                self._suffix_copy_pending = False
+
+            if (
+                self._suffix_steps_since_stage >= self._suffix_log_interval
+                and not self._suffix_copy_pending
+                and self._suffix_stats_host is not None
+                and self._suffix_stats_event is not None
+            ):
+                self._suffix_stats_host.copy_(self._suffix_stats, non_blocking=True)
+                self._suffix_stats_event.record()
+                self._suffix_stats.zero_()
+                self._suffix_copy_pending = True
+                self._suffix_steps_since_stage = 0
+        elif self._suffix_steps_since_stage >= self._suffix_log_interval:
+            self._emit_suffix_stats(self._suffix_stats)
+            self._suffix_stats.zero_()
+            self._suffix_steps_since_stage = 0
+
+    def _build_suffix_speculator(
+        self,
+        vllm_config: VllmConfig,
+        device: torch.device,
+        req_states: RequestState,
+    ) -> Any:
+        from vllm.v1.worker.gpu.spec_decode.suffix.speculator import SuffixSpeculator
+
+        suffix = SuffixSpeculator(vllm_config, device, req_states)
+        # Always keep online suffix acceptance tracking enabled so hybrid
+        # arbitration calibrates suffix confidence against real acceptances.
+        suffix.enable_adaptive_verification = True
+        return suffix
+
+    def add_request(self, req_index: int, new_req_data: NewRequestData) -> None:
+        super().add_request(req_index, new_req_data)  # type: ignore[misc]
+        if self._suffix is not None:
+            self._suffix.add_request(req_index, new_req_data)
+
+    def on_requests_finished(self, finished_req_ids: Iterable[str]) -> None:
+        req_ids = list(finished_req_ids)
+        super().on_requests_finished(req_ids)  # type: ignore[misc]
+        if self._suffix is not None:
+            self._suffix.on_requests_finished(req_ids)
+
+    def reset_state(self) -> None:
+        if hasattr(super(), "reset_state"):
+            super().reset_state()  # type: ignore[misc]
+        if self._suffix is not None:
+            self._suffix.reset_state()
+        if self._suffix_stats is not None:
+            is_cuda = self._suffix_stats.device.type == "cuda"
+            if not (is_cuda and torch.cuda.is_current_stream_capturing()):
+                self._suffix_stats.zero_()
+                self._suffix_steps_since_stage = 0
+
+    def propose(self, input_batch, *args, **kwargs):
+        dspark_out = super().propose(input_batch, *args, **kwargs)  # type: ignore[misc]
+        if self._suffix is None:
+            return dspark_out
+
+        bound = _propose_signature().bind(self, input_batch, *args, **kwargs)
+        arguments = bound.arguments
+        if (
+            arguments.get("dummy_run")
+            or arguments.get("is_profile")
+            or getattr(self, "context_kv_only", False)
+            or arguments.get("num_speculative_tokens") == 0
+        ):
+            return dspark_out
+
+        num_reqs = input_batch.num_reqs
+        if num_reqs <= 0 or dspark_out.shape[1] == 0:
+            return dspark_out
+
+        suffix_drafts = self._suffix.propose(input_batch, *args, **kwargs)
+        w = min(dspark_out.shape[1], suffix_drafts.shape[1])
+        if w <= 0:
+            return dspark_out
+
+        idx_mapping = input_batch.idx_mapping[:num_reqs]
+        suffix_num_valid = self._suffix.num_valid[:num_reqs]
+        match_len = extract_suffix_match_len(self._suffix, idx_mapping, num_reqs)
+
+        use_len4_gates = (
+            self._suffix_min_match_len > 4
+            and (self._suffix_lowconf_len4 > 0.0 or self._suffix_len4_min_score > 0)
+        )
+        len4_score = (
+            extract_suffix_len4_score(self._suffix, idx_mapping, num_reqs)
+            if (self._suffix_min_match_len > 4 and self._suffix_len4_min_score > 0)
+            else None
+        )
+
+        last_bucket_buf = getattr(self._suffix, "last_bucket", None)
+        buckets = (
+            last_bucket_buf[idx_mapping.long()] if last_bucket_buf is not None else None
+        )
+        accept_stats = getattr(self._suffix, "accept_stats", None)
+        suffix_conf = compute_suffix_confidence(
+            match_len,
+            suffix_num_valid,
+            w,
+            min_match_len=self._suffix_min_match_len,
+            conf_floor=self._suffix_conf_floor,
+            accept_stats=accept_stats,
+            buckets=buckets,
+            allow_len4=use_len4_gates,
+            len4_conf_cap=self._suffix_len4_conf_cap,
+        )
+
+        conf_buf = getattr(self, "draft_token_confidence_probs", None)
+        has_conf = (
+            conf_buf is not None
+            and getattr(self, "use_confidence_head", False)
+            and conf_buf.shape[1] >= w
+        )
+        if has_conf:
+            dspark_conf = conf_buf[:num_reqs, :w]
+        else:
+            dspark_conf = torch.full(
+                (num_reqs, w),
+                _DEFAULT_DSPARK_CONF,
+                dtype=torch.float32,
+                device=dspark_out.device,
+            )
+
+        blended_drafts, blended_conf, override_mask, used_suffix_row = (
+            blend_dspark_and_suffix(
+                dspark_out[:num_reqs, :w],
+                dspark_conf,
+                suffix_drafts[:num_reqs, :w],
+                suffix_num_valid,
+                match_len,
+                suffix_conf,
+                min_match_len=self._suffix_min_match_len,
+                mode=self._suffix_mode,
+                lowconf_len4=self._suffix_lowconf_len4,
+                len4_score=len4_score,
+                len4_min_score=self._suffix_len4_min_score,
+            )
+        )
+
+        dspark_out[:num_reqs, :w].copy_(blended_drafts)
+        if has_conf and conf_buf is not None:
+            conf_buf[:num_reqs, :w].copy_(blended_conf)
+
+        # Keep suffix online stats pure: clear last_bucket for rows that stayed
+        # on DSpark so DSpark acceptances never pollute suffix bucket counters.
+        if last_bucket_buf is not None and buckets is not None:
+            neg_one = torch.full_like(buckets, -1)
+            last_bucket_buf.index_put_(
+                (idx_mapping.long(),),
+                torch.where(used_suffix_row, buckets, neg_one),
+            )
+
+        draft_logits = getattr(self, "draft_logits", None)
+        if draft_logits is not None:
+            update_draft_logits_for_suffix(
+                draft_logits, idx_mapping, blended_drafts, override_mask
+            )
+
+        self._last_suffix_used = used_suffix_row
+        self._last_suffix_match_len = match_len
+        self._record_suffix_telemetry(used_suffix_row, override_mask, match_len)
+        return dspark_out
+
+
+@cache
+def _propose_signature() -> inspect.Signature:
+    from vllm.v1.worker.gpu.spec_decode.dflash.speculator import DFlashSpeculator
+
+    return inspect.signature(DFlashSpeculator.propose)
+
+
+@cache
+def suffix_hybrid_class(base: type) -> type:
+    """Return a subclass of ``base`` with ``DSparkSuffixHybridMixin`` ahead of it."""
+    return type(
+        f"SuffixHybrid{base.__name__}",
+        (DSparkSuffixHybridMixin, base),
+        {"__module__": __name__},
+    )
diff --git a/vllm/sm80/spec_decode/dspark_width.py b/vllm/sm80/spec_decode/dspark_width.py
