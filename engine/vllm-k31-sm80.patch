+        "float q_eps, float kv_eps, Tensor(a!) q_out, Tensor(b!) kv_out) -> ()");
+  m.def("sigmoid_mul(Tensor attn_out, Tensor gate, Tensor(a!) out) -> ()");
+  m.def("fused_kda_spec_verify_records(Tensor mixed_qkv, Tensor(a!) conv_state, Tensor conv_weight, "
+        "Tensor? conv_bias, Tensor raw_g, Tensor raw_beta, Tensor A_log, Tensor dt_bias, "
+        "Tensor g2, Tensor norm_weight, Tensor(b!) recurrent_state, Tensor spec_state_indices, "
