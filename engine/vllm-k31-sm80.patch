+        out_leg = torch.empty((T, H, D), device="cuda", dtype=torch.bfloat16)
+        out_rec = torch.empty((T, H, D), device="cuda", dtype=torch.bfloat16)
+
+        glue_ops.fused_kda_spec_verify(
+            mqkv, conv_leg, cw, cb, rg, rb, A_log, dt_bias, g2, norm_w,
+            rec_leg, ssi, qsl, acc, -5.0, 1e-6, out_leg,
