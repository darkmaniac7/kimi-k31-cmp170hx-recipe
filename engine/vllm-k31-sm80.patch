+                "__version__ = version = '0.1.0.dev1+g0123456'\n"
+                "__commit_id__ = commit_id = 'g0123456'\n")
+BUILD = {"vllm/_C.abi3.so": "native-lib", "vllm/third_party/kern/compaction.py": "x = 1\n",
+         "vllm/_version.py": VERSION_TEXT}
+
+
+def git(tree: str, *args: str) -> str:
+    return subprocess.run(["git", "-C", tree, *args], check=True, capture_output=True,
+                          text=True, env=GIT_ENV).stdout
+
+
+def write(path: str, text: str) -> str:
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "w", encoding="utf-8") as f:
+        f.write(text)
+    return path
+
+
+def envs_py(names: list[str], defaults: dict[str, str] | None = None) -> str:
+    defaults = defaults or {}
+    rows = "\n".join(f'    "{n}": lambda: os.getenv("{n}", "{defaults.get(n, "")}"),' for n in names)
+    return f"import os\n\nenvironment_variables: dict = {{\n{rows}\n}}\n"
+
+
+def sm80_envs_py(fork: dict[str, str], retired: dict[str, str]) -> str:
+    rows = "\n".join(f'    "{n}": lambda: os.getenv("{n}", "{d}"),' for n, d in fork.items())
+    rrows = "\n".join(f'    "{n}": ("{t}"),' for n, t in retired.items())
+    return ("import os\n\nFORK_ENV_VARS: dict = {\n" + rows + "\n}\n\n"
+            "RETIRED_ENV_VARS: dict[str, str] = {\n" + rrows + "\n}\n")
+
+
+# The engine options the synthetic model protects, declared as the tree's
+# argument file declares them (the launcher reads option names from it).
+ARG_UTILS = """\
+def add_cli_args(parser):
+    parser.add_argument("--max-model-len", type=int)
+    parser.add_argument("--gpu-memory-utilization", "--device-memory-utilization", type=float)
+    parser.add_argument("--max-num-seqs", type=int)
+"""
+
+
+def make_tree(root: str, *, sm80: bool = True, fork: dict | None = None,
+              retired: dict | None = None, upstream: list[str] | None = None,
+              extra_files: dict[str, str] | None = None) -> str:
+    os.makedirs(root, exist_ok=True)
+    write(os.path.join(root, "vllm", "envs.py"), envs_py(upstream or UPSTREAM_VARS))
+    write(os.path.join(root, "vllm", "__init__.py"), "")
+    if sm80:
+        write(os.path.join(root, "vllm", "sm80", "envs.py"),
+              sm80_envs_py(fork if fork is not None else FORK_VARS,
+                           retired if retired is not None else RETIRED))
+    write(os.path.join(root, "csrc", "kernel.cu"), "// kernel\n")
+    write(os.path.join(root, "vllm", "engine", "arg_utils.py"), ARG_UTILS)
+    write(os.path.join(root, ".gitignore"), "*.so\nbuild/\n")
+    for rel, text in (extra_files or {}).items():
+        write(os.path.join(root, rel), text)
+    git(root, "init", "-q", "-b", "main")
+    git(root, "add", "-A")
+    git(root, "commit", "-q", "-m", "base")
+    return root
+
+
+def head(tree: str) -> str:
+    return git(tree, "rev-parse", "HEAD").strip()
+
+
+def add_build(tree: str, files: dict[str, str] | None = None, *, source: str = "built_in_place",
+              natives: str = "natives-1", stamp: bool = True, record: bool = True,
+              commit: str | None = None) -> dict:
+    """Build artefacts plus their provenance: owned files, a native manifest
+    and a retained build record (both outside the tree), the build-owned
+    manifest and the build stamp."""
+    from canon import sha256_file
+    from treestate import MANIFEST, build_owned_sha256
+    files = BUILD if files is None else files
+    for rel, text in files.items():
+        write(os.path.join(tree, rel), text)
+    owned = {rel: sha256_file(os.path.join(tree, rel)) for rel in files}
+    side = os.path.join(os.path.dirname(tree), "build-" + os.path.basename(tree))
+    native = write(os.path.join(side, "native-manifest.json"),
+                   json.dumps({"artefacts": {}, "natives": natives}))
+    man = {"schema": "build-owned/1", "source": source, "commit": commit or head(tree),
+           "files": owned, "native_manifest_sha256": sha256_file(native),
+           "native_manifest_path": native, "build_owned_sha256": build_owned_sha256(owned)}
+    if record and source == "built_in_place":
+        rec = write(os.path.join(side, "build-record.json"),
+                    json.dumps({"schema": "build-record/1", "files": owned}))
+        man["build_record"] = {"path": rec, "sha256": sha256_file(rec)}
+    if source == "adopted":
+        man["adopted"] = {"artefact_commit_source": "HEAD", "natives_checked": {}}
+    write(os.path.join(tree, MANIFEST), json.dumps(man))
+    if stamp:
+        write_stamp(tree, man)
+    return man
+
+
+def write_stamp(tree: str, man: dict) -> None:
+    """The build stamp of a tree at its HEAD, naming its manifest's hashes."""
+    from treestate import STAMP
+    write(os.path.join(tree, STAMP), json.dumps(
+        {"schema": "build-stamp/1", "commit": head(tree),
+         "native_manifest_sha256": man["native_manifest_sha256"],
+         "build_owned_sha256": man["build_owned_sha256"]}))
+
+
+STUB = """#!{python} -I
+import os
+import sys
+rec = {rec!r}
+with open(rec + ".argv", "wb") as f:
+    f.write(b"".join(a.encode() + b"\\0" for a in sys.argv))
+with open("/proc/self/environ", "rb") as src, open(rec + ".environ", "wb") as f:
+    f.write(src.read())
+fds = []
+for fd in sorted(os.listdir("/proc/self/fd")):
+    try:
+        fds.append(fd + " " + os.readlink("/proc/self/fd/" + fd))
+    except OSError:
+        pass
+with open(rec + ".fds", "w") as f:
+    f.write("\\n".join(fds) + "\\n")
+"""
+
+
+def make_venv(root: str) -> str:
+    """A venv whose bin/vllm records its argv, environment and open file
+    descriptors, then exits. It is a Python script, so it adds nothing to
+    its own environment."""
+    rec = os.path.join(root, "record")
+    stub = write(os.path.join(root, "bin", "vllm"), STUB.format(python=sys.executable, rec=rec))
+    os.chmod(stub, 0o755)
+    return root
+
+
+def read_record(venv: str) -> tuple[list[str], dict[str, str]]:
+    rec = os.path.join(venv, "record")
+    with open(rec + ".argv", "rb") as f:
+        argv = [a.decode() for a in f.read().split(b"\0") if a]
+    with open(rec + ".environ", "rb") as f:
+        env = dict(e.decode().split("=", 1) for e in f.read().split(b"\0") if e)
+    return argv, env
+
+
+# -- a synthetic model ---------------------------------------------------------
+
+MODEL_TOML = """\
