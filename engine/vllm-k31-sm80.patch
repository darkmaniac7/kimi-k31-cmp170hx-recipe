@@ -0,0 +1,137 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Row-count invariance of the KDA plain BF16 projections (f_a, b, f_b).
+
+``linear_plain_invariant_k31`` in ``vllm/_k31_dense_C`` (api_version >= 3)
+uses a fixed K-reduction tree depending only on K (never M, N, or SM count),
+so the same input row placed at any row index in any batch of 1 to 2,048 rows
+produces 0-ULP bitwise-identical BF16 output (``torch.equal``), both eager and
+inside CUDA graph replay.
+
+Needs a CUDA device and the built ``_k31_dense_C`` library; no checkpoint.
+"""
+
+import pytest
+import torch
+
+from tests.models.kimi_k3.sm80 import gpu
+from vllm.sm80.kernels.k31q import dense, dense_k31_ops
+from vllm.sm80.kernels.k31q.quant import fp32_gemm_reduction
+
+pytestmark = gpu.CUDA_MARKS
+
+ROW_COUNTS = (
+    1,
+    2,
+    3,
+    4,
+    7,
+    8,
+    15,
+    16,
+    17,
+    32,
+    33,
+    63,
+    64,
+    96,
+    97,
+    128,
+    129,
+    192,
+    193,
+    200,
+    256,
+    257,
+    263,
+    320,
+    512,
+    2048,
+)
+KDA_PLAIN_SHAPES = (
+    pytest.param(128, 7168, id="f_a"),
+    pytest.param(96, 7168, id="b_tp1"),
+    pytest.param(48, 7168, id="b_tp2"),
+    pytest.param(224, 7168, id="f_a+b_tp1"),
+    pytest.param(176, 7168, id="f_a+b_tp2"),
+    pytest.param(12288, 128, id="f_b_tp1"),
+    pytest.param(6144, 128, id="f_b_tp2"),
+)
+
+
+@pytest.fixture(scope="module")
+def dops():
+    gpu.require_library(dense_k31_ops.ensure_dense_k31_extension, "_k31_dense_C")
+    assert dense_k31_ops.build_info()["api_version"] >= 3
+    return dense_k31_ops
+
+
+@pytest.mark.parametrize(("out_features", "in_features"), KDA_PLAIN_SHAPES)
+def test_row_is_bit_exact_across_all_row_counts_and_positions(
+    dops, out_features, in_features
+):
+    """0-ULP bit-exactness across M = 1..2048, arbitrary row placement,
+    prefix-cache tail slice, and CUDA graph replay."""
+    torch.manual_seed(0)
+    weight = (torch.randn(out_features, in_features, device="cuda:0") * 0.02).to(
+        torch.bfloat16
+    )
+    x = torch.randn(max(ROW_COUNTS), in_features, device="cuda:0").to(torch.bfloat16)
+
+    # 1) Row 0 is 0-ULP identical across all 26 batch sizes from 1 to 2,048.
+    ref_row0 = dense.linear_plain_invariant_k31(x[:1].contiguous(), weight)[0].clone()
+    for count in ROW_COUNTS:
+        y = dense.linear_plain_invariant_k31(x[:count].contiguous(), weight)
+        assert torch.equal(y[0], ref_row0), (
+            f"[{out_features}, {in_features}] row 0 differs at M={count}"
+        )
+
+    # 2) Same probe vector placed at arbitrary positions across batches.
+    probe = x[0:1].contiguous()
+    for count, pos in ((1, 0), (8, 5), (17, 16), (33, 32), (200, 199), (2048, 1023)):
+        batch = x[:count].clone()
+        batch[pos] = probe[0]
+        y = dense.linear_plain_invariant_k31(batch, weight)
+        assert torch.equal(y[pos], ref_row0), (
+            f"[{out_features}, {in_features}] row {pos} of M={count} differs from M=1"
+        )
+
+    # 3) Prefix-cache resume: tail of a 200-row prefill matches standalone 8-row launch.
+    whole = dense.linear_plain_invariant_k31(x[:200].contiguous(), weight)
+    tail = dense.linear_plain_invariant_k31(x[192:200].contiguous(), weight)
+    assert torch.equal(whole[192:200], tail), (
+        f"[{out_features}, {in_features}] prefix-cache tail differs from full prefill"
+    )
+
+    # 4) Accuracy sanity check against FP32 matmul.
+    ref_f32 = x[:32].float() @ weight.float().T
+    rel = gpu.rel_l2(whole[:32], ref_f32)
+    assert rel < 0.005, f"[{out_features}, {in_features}] rel_l2={rel}"
+
+    # 5) CUDA Graph capture + replay matches eager bits at decode (M=1, 8) and prefill (M=200).
+    for count in (1, 8, 200):
+        static_x = x[:count].contiguous().clone()
+        eager = dense.linear_plain_invariant_k31(static_x, weight)
+        torch.cuda.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            graphed = dense.linear_plain_invariant_k31(static_x, weight)
+        for rep in range(5):
+            graphed.zero_()
+            graph.replay()
+            torch.cuda.synchronize()
+            assert torch.equal(graphed, eager), (
+                f"[{out_features}, {in_features}] graph M={count} rep={rep} differs"
+            )
+            assert torch.equal(graphed[0], ref_row0)
+
+
+def test_the_setting_is_restored():
+    matmul = torch.backends.cuda.matmul
+    before = matmul.allow_bf16_reduced_precision_reduction
+    with fp32_gemm_reduction():
+        assert not matmul.allow_bf16_reduced_precision_reduction
+    assert matmul.allow_bf16_reduced_precision_reduction == before
+    with pytest.raises(RuntimeError, match="stop"), fp32_gemm_reduction():
+        raise RuntimeError("stop")
+    assert matmul.allow_bf16_reduced_precision_reduction == before
