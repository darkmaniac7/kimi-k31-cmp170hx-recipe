+def test_commit_moves_never_overwrite_a_later_source():
+    rng = random.Random(11)
+    for _ in range(200):
+        paths = {(0,)}
+        for _ in range(rng.randint(1, 10)):
+            base = rng.choice(sorted(paths) + [()])
+            r = 0
+            while base + (r,) in paths:
+                r += 1
+            paths.add(base + (r,))
+        tree = dt.DraftTree.from_paths(sorted(paths))
+        lay = dt.layout(tree)
+        leaf = rng.choice(tree.paths)
+        rows = [1 + tree.paths.index(leaf[: d + 1]) for d in range(len(leaf))]
+        plan = dt.commit_plan(lay, rows)
+        assert plan.state_row == rows[-1]
+        written: set[int] = set()
+        for src, dst in plan.kv_moves:
+            assert src not in written and dst < src
+            written.add(dst)
+        final = {dst: src for src, dst in plan.kv_moves}
+        for depth, row in enumerate(rows, start=1):
+            assert final.get(depth, depth) == row
