+template <int RID>
+__device__ __forceinline__ void lockstep_kg_mma(
+    const RegCodebook<RID>& cb1, const RegCodebook<RID>& cb3,
+    const uint32_t (&w1)[RateTraits<RID>::WPL], const uint32_t (&w3)[RateTraits<RID>::WPL],
