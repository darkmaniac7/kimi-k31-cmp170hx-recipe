new file mode 100644
index 0000000000..9ed091327e
--- /dev/null
+++ b/tests/sm80/test_plugin_guard.py
@@ -0,0 +1,299 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The fork's plugin entry point and the startup guard (vllm/sm80/guard.py)."""
+
+import json
+import os
+import pathlib
+import site
+import subprocess
+import sys
+import tomllib
+
+import pytest
+
+import vllm.plugins
+from vllm.sm80 import guard, plugin
+
+REPO = pathlib.Path(__file__).resolve().parents[2]
+PYPROJECT = REPO / "plugins" / "sm80" / "pyproject.toml"
+
+
+def _entry_point(group: str = vllm.plugins.DEFAULT_PLUGINS_GROUP) -> str:
+    data = tomllib.loads(PYPROJECT.read_text())
+    return data["project"]["entry-points"][group][guard.PLUGIN_NAME]
+
+
+def test_distribution_declares_the_register_entry_point():
+    data = tomllib.loads(PYPROJECT.read_text())
+    assert data["project"]["name"] == guard.DISTRIBUTION
+    assert _entry_point() == "vllm.sm80.plugin:register"
+
+
+def test_distribution_declares_the_platform_entry_point():
+    assert (
+        _entry_point(vllm.plugins.PLATFORM_PLUGINS_GROUP)
+        == "vllm.sm80.plugin:platform_plugin"
+    )
+
+
+@pytest.fixture
+def fork_platform(monkeypatch):
+    """Make ``current_platform`` an instance of the fork's CUDA platform."""
+    from vllm.sm80 import platform as sm80_platform
+
+    monkeypatch.setattr(
+        "vllm.platforms._current_platform", sm80_platform.Sm80CudaPlatform()
+    )
+
+
+def test_guard_ignores_a_process_without_plugins(monkeypatch):
+    monkeypatch.setattr(vllm.plugins, "plugins_loaded", False)
+    monkeypatch.setattr(plugin, "_registered", False)
+    guard.check_plugin_loaded()
+
+
+def test_guard_passes_when_the_plugin_ran(monkeypatch, fork_platform):
+    monkeypatch.setattr(vllm.plugins, "plugins_loaded", True)
+    monkeypatch.setattr(plugin, "_registered", False)
+    plugin.register()
+    plugin.register()
+    guard.check_plugin_loaded()
+
+
+def test_guard_raises_when_plugins_loaded_without_ours(monkeypatch):
+    monkeypatch.setattr(vllm.plugins, "plugins_loaded", True)
+    monkeypatch.setattr(plugin, "_registered", False)
+    with pytest.raises(RuntimeError, match="not the fork's plugin 'sm80'"):
+        guard.check_plugin_loaded()
+
+
+def test_guard_raises_on_cuda_without_the_fork_platform(monkeypatch):
+    from vllm.platforms.cuda import CudaPlatform
+
+    monkeypatch.setattr(vllm.plugins, "plugins_loaded", True)
+    monkeypatch.setattr(plugin, "_registered", True)
+    monkeypatch.setattr("vllm.platforms._current_platform", CudaPlatform())
+    with pytest.raises(RuntimeError, match="not the fork's platform"):
+        guard.check_plugin_loaded()
+
+
+def test_guard_ignores_the_platform_off_cuda(monkeypatch):
+    from vllm.platforms.cpu import CpuPlatform
+
+    monkeypatch.setattr(vllm.plugins, "plugins_loaded", True)
+    monkeypatch.setattr(plugin, "_registered", True)
+    monkeypatch.setattr("vllm.platforms._current_platform", CpuPlatform())
+    guard.check_plugin_loaded()
+
+
+def test_platform_plugin_follows_the_builtin_cuda_plugin(monkeypatch):
+    import vllm.platforms
+
+    monkeypatch.setattr(vllm.platforms, "cuda_platform_plugin", lambda: None)
+    assert plugin.platform_plugin() is None
+    builtin = "vllm.platforms.cuda.CudaPlatform"
+    monkeypatch.setattr(vllm.platforms, "cuda_platform_plugin", lambda: builtin)
+    assert plugin.platform_plugin() == plugin.PLATFORM_QUALNAME
+
+
+def test_fork_platform_is_chosen_like_upstreams():
+    """Same NVML choice as ``vllm.platforms.cuda.CudaPlatform``, and the fork
+    class subclasses exactly the upstream class that would be chosen."""
+    from vllm.platforms import cuda as cuda_platform
+    from vllm.sm80 import platform as sm80_platform
+    from vllm.utils.import_utils import resolve_obj_by_qualname
+
+    cls = resolve_obj_by_qualname(plugin.PLATFORM_QUALNAME)
+    assert cls is sm80_platform.Sm80CudaPlatform
+    assert cls.__mro__[2] is cuda_platform.CudaPlatform
+    assert cls in sm80_platform.PLATFORM_CLASSES
+
+
+def _write_metadata(site: pathlib.Path, platform: bool = True) -> None:
+    """The metadata pip writes for plugins/sm80, without running pip.
+
+    ``platform=False`` writes the general entry point only, as an install
+    made from an older plugins/sm80 would.
+    """
+    info = site / "vllm_sm80_plugin-0.1.0.dist-info"
+    info.mkdir(parents=True)
+    (info / "METADATA").write_text(
+        f"Metadata-Version: 2.1\nName: {guard.DISTRIBUTION}\nVersion: 0.1.0\n"
+    )
+    text = f"[{vllm.plugins.DEFAULT_PLUGINS_GROUP}]\n"
+    text += f"{guard.PLUGIN_NAME} = {_entry_point()}\n"
+    if platform:
+        group = vllm.plugins.PLATFORM_PLUGINS_GROUP
+        text += f"\n[{group}]\n{guard.PLUGIN_NAME} = {_entry_point(group)}\n"
+    (info / "entry_points.txt").write_text(text)
+
+
+CHILD = """
+import vllm.plugins
+from vllm.config import VllmConfig
+vllm.plugins.load_general_plugins()
+VllmConfig()
+from vllm.platforms import current_platform
+print("PLATFORM", type(current_platform).__name__)
+print("STARTED")
+"""
+
+
+def _cuda_detected() -> bool:
+    """Whether vLLM's builtin CUDA platform plugin activates on this host."""
+    from vllm.platforms import cuda_platform_plugin
+
+    return cuda_platform_plugin() is not None
+
+
+def _has_metadata(path: str) -> bool:
+    return any(pathlib.Path(path or ".").glob("vllm_sm80_plugin-*.dist-info"))
+
+
+def _metadata_always_visible() -> bool:
+    """Metadata in site-packages or next to the vllm package (a source tree
+    on PYTHONPATH) cannot be hidden from the child process."""
+    if any(map(_has_metadata, site.getsitepackages())):
+        return True
+    return any(_has_metadata(p) and _is_source_tree(p) for p in sys.path)
+
+
+def _is_source_tree(path: str) -> bool:
+    return (pathlib.Path(path or ".") / "vllm" / "__init__.py").exists()
+
+
+def _start(
+    tmp_path,
+    with_metadata: bool,
+    plugins: str | None = None,
+    platform: bool = True,
+    child: str = CHILD,
+    args: tuple[str, ...] = (),
+):
+    site_dir = tmp_path / "site"
+    site_dir.mkdir()
+    if with_metadata:
+        _write_metadata(site_dir, platform=platform)
+    env = {
+        k: v for k, v in os.environ.items() if k not in ("VLLM_PLUGINS", "PYTHONPATH")
+    }
+    # The child sees the plugin metadata only when this test writes it, except
+    # where the metadata sits next to the vllm package (a source tree with the
+    # metadata installed into it): that entry must stay, or the child would
+    # import another vllm.
+    paths = [p for p in sys.path if not _has_metadata(p) or _is_source_tree(p)]
+    env["PYTHONPATH"] = os.pathsep.join([str(site_dir), *paths])
+    env["CUDA_VISIBLE_DEVICES"] = ""
+    if plugins is not None:
+        env["VLLM_PLUGINS"] = plugins
+    return subprocess.run(
+        [sys.executable, "-c", child, *args],
+        env=env,
+        cwd=tmp_path,
+        capture_output=True,
+        text=True,
+        timeout=600,
+    )
+
+
+def test_config_starts_with_the_plugin_installed(tmp_path):
+    proc = _start(tmp_path, with_metadata=True)
+    assert proc.returncode == 0, proc.stdout + proc.stderr
+    assert "STARTED" in proc.stdout
+    if _cuda_detected():
+        assert "PLATFORM Sm80" in proc.stdout, proc.stdout
+
+
+def test_config_fails_loudly_without_the_platform_plugin(tmp_path):
+    if not _cuda_detected():
+        pytest.skip("no CUDA platform on this host, so no platform to check")
+    if _metadata_always_visible():
+        pytest.skip("the plugin metadata is installed where the child must look")
+    proc = _start(tmp_path, with_metadata=True, platform=False)
+    out = proc.stdout + proc.stderr
+    assert proc.returncode != 0, out
+    assert "STARTED" not in proc.stdout
+    assert "not the fork's platform" in out
+
+
+@pytest.mark.parametrize(
+    "with_metadata,plugins",
+    [(False, None), (True, "some_other_plugin")],
+    ids=["not-installed", "filtered-by-VLLM_PLUGINS"],
+)
+def test_config_fails_loudly_without_the_plugin(tmp_path, with_metadata, plugins):
+    if not with_metadata and _metadata_always_visible():
+        pytest.skip("the plugin metadata is installed where the child must look")
+    proc = _start(tmp_path, with_metadata=with_metadata, plugins=plugins)
+    out = proc.stdout + proc.stderr
+    assert proc.returncode != 0, out
+    assert "STARTED" not in proc.stdout
+    assert "not the fork's plugin 'sm80'" in out
+
+
+# A text-only checkpoint config whose quantization method is EXL3. Model
+# config verification needs no weights and no EXL3 extension.
+EXL3_CONFIG = {
+    "architectures": ["Qwen3ForCausalLM"],
+    "model_type": "qwen3",
+    "hidden_size": 64,
+    "intermediate_size": 128,
+    "num_hidden_layers": 1,
+    "num_attention_heads": 2,
+    "num_key_value_heads": 1,
+    "head_dim": 32,
+    "vocab_size": 1024,
+    "max_position_embeddings": 256,
+    "torch_dtype": "bfloat16",
+    "quantization_config": {"quant_method": "exl3"},
+}
+
+EXL3_CHILD = """
+import sys
+import vllm.plugins
+from vllm.config import ModelConfig
+vllm.plugins.load_general_plugins()
+config = ModelConfig(
+    model=sys.argv[1], skip_tokenizer_init=True, max_model_len=128, dtype="bfloat16"
+)
+print("QUANTIZATION", config.quantization)
+"""
+
+
+def _start_exl3(tmp_path, with_metadata: bool, plugins: str | None = None):
+    checkpoint = tmp_path / "checkpoint"
+    checkpoint.mkdir()
+    (checkpoint / "config.json").write_text(json.dumps(EXL3_CONFIG))
+    proc = _start(
+        tmp_path, with_metadata, plugins, child=EXL3_CHILD, args=(str(checkpoint),)
+    )
+    return proc, proc.stdout + proc.stderr
+
+
+def test_exl3_checkpoint_selects_the_registered_method(tmp_path):
+    proc, out = _start_exl3(tmp_path, with_metadata=True)
+    # EXL3 was selected: verification passes on CUDA hosts and refuses the
+    # checkpoint where vLLM resolved another platform.
+    assert "QUANTIZATION exl3" in proc.stdout or (
+        "EXL3 execution requires the NVIDIA CUDA platform" in out
+    ), out
+    assert "Unknown quantization method" not in out
+
+
+@pytest.mark.parametrize(
+    "with_metadata,plugins",
+    [(False, None), (True, "some_other_plugin")],
+    ids=["not-installed", "filtered-by-VLLM_PLUGINS"],
+)
+def test_exl3_checkpoint_fails_at_startup_without_the_plugin(
+    tmp_path, with_metadata, plugins
+):
+    if not with_metadata and _metadata_always_visible():
+        pytest.skip("the plugin metadata is installed where the child must look")
+    proc, out = _start_exl3(tmp_path, with_metadata, plugins)
+    assert proc.returncode != 0, out
+    # No fallback to an unquantized model: the method is unknown without the
+    # plugin, so the model config itself fails.
+    assert "QUANTIZATION" not in proc.stdout
+    assert "Unknown quantization method: exl3" in out
diff --git a/tests/sm80/test_registrations.py b/tests/sm80/test_registrations.py
new file mode 100644
index 0000000000..860895fc03
--- /dev/null
+++ b/tests/sm80/test_registrations.py
@@ -0,0 +1,141 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The fork's registrations reach the upstream objects they replace.
+
+Each override is looked up by an upstream name (a platform plugin, a backend
+enum slot, a layer class name). An upstream rename would silently disable
+it, so every test here asks upstream's own lookup and checks that it lands on
+the fork's class.
+"""
+
+import pytest
+
+import vllm.platforms as platforms
+from vllm.sm80 import plugin
+
+
+def test_platform_resolution_picks_the_fork_platform(monkeypatch):
+    builtin = "vllm.platforms.cuda.CudaPlatform"
+    monkeypatch.delenv("VLLM_TARGET_DEVICE", raising=False)
+    for name in platforms.builtin_platform_plugins:
+        monkeypatch.setitem(platforms.builtin_platform_plugins, name, lambda: None)
+    monkeypatch.setitem(platforms.builtin_platform_plugins, "cuda", lambda: builtin)
+    monkeypatch.setattr(platforms, "cuda_platform_plugin", lambda: builtin)
+    monkeypatch.setattr(
+        platforms,
+        "load_plugins_by_group",
+        lambda group: {"sm80": plugin.platform_plugin}
+        if group == platforms.PLATFORM_PLUGINS_GROUP
+        else {},
+    )
+    assert platforms.resolve_current_platform_cls_qualname() == (
+        plugin.PLATFORM_QUALNAME
+    )
+
+
+@pytest.mark.parametrize("nvml", [True, False])
+def test_fork_platform_subclasses_the_upstream_variant(nvml):
+    from vllm.platforms import cuda as cuda_platform
+    from vllm.sm80 import platform as sm80_platform
+
+    fork_cls = (
+        sm80_platform.Sm80NvmlCudaPlatform
+        if nvml
+        else sm80_platform.Sm80NonNvmlCudaPlatform
+    )
+    upstream_cls = (
+        cuda_platform.NvmlCudaPlatform if nvml else cuda_platform.NonNvmlCudaPlatform
+    )
+    assert issubclass(fork_cls, upstream_cls)
+    assert fork_cls.__mro__[2] is upstream_cls
+    assert fork_cls._enum == upstream_cls._enum
+    assert fork_cls.device_name == upstream_cls.device_name
+
+
+def test_custom_backend_slot_holds_triton_mla_sparse():
+    from vllm.v1.attention.backends.registry import AttentionBackendEnum
+
+    plugin.register()
+    plugin.register()
+    assert AttentionBackendEnum.CUSTOM.get_path() == plugin.TRITON_MLA_SPARSE_BACKEND
+    assert AttentionBackendEnum.CUSTOM.get_class().get_name() == "TRITON_MLA_SPARSE"
+
+
+@pytest.mark.parametrize(
+    "major,expected", [(8, True), (9, True), (10, False), (12, True)]
+)
+def test_fork_platform_offers_triton_mla_sparse_last(monkeypatch, major, expected):
+    from unittest.mock import MagicMock
+
+    import torch
+
+    from vllm.platforms.interface import DeviceCapability
+    from vllm.sm80 import platform as sm80_platform
+    from vllm.v1.attention.backends.registry import AttentionBackendEnum
+    from vllm.v1.attention.selector import AttentionSelectorConfig
+
+    ok = MagicMock()
+    ok.validate_configuration.return_value = ["rejected"]
+    monkeypatch.setattr("vllm.platforms.cuda._get_attn_backend_class", lambda b: ok)
+    config = AttentionSelectorConfig(
+        head_size=576, dtype=torch.bfloat16, kv_cache_dtype=None, block_size=64,
+        use_mla=True, use_sparse=True,
+    )
+    cap = DeviceCapability(major=major, minor=0)
+    valid, invalid = sm80_platform.Sm80CudaPlatform.get_valid_backends(
+        device_capability=cap, attn_selector_config=config, num_heads=64
+    )
+    upstream_valid, upstream_invalid = sm80_platform.Sm80CudaPlatform.__mro__[
+        2
+    ].get_valid_backends(device_capability=cap, attn_selector_config=config, num_heads=64)
+    assert (AttentionBackendEnum.CUSTOM in invalid) is expected
+    if expected:
+        assert invalid[AttentionBackendEnum.CUSTOM][0] == len(upstream_invalid)
+    assert len(invalid) == len(upstream_invalid) + int(expected)
+
+
+@pytest.mark.parametrize(
+    "switch",
+    [
+        None,
+        "VLLM_HOST_ALLREDUCE",
+        "VLLM_CUSTOM_ALLREDUCE_FLAGS",
+        "VLLM_CUSTOM_ALLREDUCE_PCIE_P2P",
+    ],
+)
+def test_communicator_class_follows_the_switches(monkeypatch, switch):
+    from vllm.distributed.device_communicators.cuda_communicator import (
+        CudaCommunicator,
+    )
+    from vllm.sm80 import platform as sm80_platform
+    from vllm.sm80.distributed import communicator as comm
+    from vllm.utils.import_utils import resolve_obj_by_qualname
+
+    for name in (
+        "VLLM_HOST_ALLREDUCE",
+        "VLLM_CUSTOM_ALLREDUCE_FLAGS",
+        "VLLM_CUSTOM_ALLREDUCE_PCIE_P2P",
+    ):
+        monkeypatch.delenv(name, raising=False)
+    if switch is not None:
+        monkeypatch.setenv(switch, "1")
+    cls = resolve_obj_by_qualname(
+        sm80_platform.Sm80CudaPlatform.get_device_communicator_cls()
+    )
+    if switch is None:
+        # stateless_coordinator asserts exactly this for elastic EP groups.
+        assert cls == CudaCommunicator
+    else:
+        assert cls is comm.Sm80CudaCommunicator
+        assert issubclass(cls, CudaCommunicator)
+
+
+def test_stateless_coordinator_still_asserts_upstreams_class():
+    """The limitation the fork communicator documents: if this assertion goes
+    away upstream, the switch-off restriction can go too."""
+    import inspect
+
+    from vllm.distributed import stateless_coordinator
+
+    src = inspect.getsource(stateless_coordinator)
+    assert "assert device_comm_cls == CudaCommunicator" in src
diff --git a/tests/sm80/test_round_once_all_reduce.py b/tests/sm80/test_round_once_all_reduce.py
new file mode 100644
index 0000000000..64ff1e2462
--- /dev/null
+++ b/tests/sm80/test_round_once_all_reduce.py
@@ -0,0 +1,203 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The round-once all-reduce over gloo (CPU): every element is the exact sum of
+the ranks' partials correctly rounded to the message dtype, on every rank, for
+TP 2, 4 and 8 and odd sizes (vllm/sm80/distributed/round_once_all_reduce.py).
+
+The reference rounding here is independent of the module's: the two
+neighbours of the exact FP64 sum in the target format and round to nearest,
+ties to even, decided on exact FP64 differences.
+
+    pytest -q tests/sm80/test_round_once_all_reduce.py
+"""
+
+import os
+
+import pytest
+import torch
+import torch.distributed as dist
+import torch.multiprocessing as mp
+
+from vllm.sm80.distributed import round_once_all_reduce as R
+
+BF16, FP16 = torch.bfloat16, torch.float16
+_INT = {BF16: torch.int16, FP16: torch.int16}
+
+
+def _step(v: torch.Tensor, up: bool) -> torch.Tensor:
+    """The next representable value of v's format above (``up``) or below."""
+    i = v.view(_INT[v.dtype]).long()
+    width = 8 * v.element_size()
+    neg = i < 0
+    mag = torch.where(neg, i + (1 << (width - 1)), i)  # magnitude bits
+    signed = torch.where(neg, -mag, mag)  # ordered integer: -0 -> 0
+    signed = signed + (1 if up else -1)
+    sign = signed < 0
+    mag = signed.abs()
+    i = torch.where(sign, mag - (1 << (width - 1)), mag)
+    return i.to(_INT[v.dtype]).view(v.dtype)
+
+
+def reference_round(x: torch.Tensor, dtype: torch.dtype) -> torch.Tensor:
+    """FP64 ``x`` rounded to nearest, ties to even, in ``dtype``."""
+    b = x.to(dtype)
+    lo = torch.where(b.double() > x, _step(b, up=False), b)
+    hi = _step(lo, up=True)
+    d_lo = x - lo.double()
+    d_hi = hi.double() - x
+    even_lo = (lo.view(_INT[dtype]) & 1) == 0
+    pick_lo = (d_lo < d_hi) | ((d_lo == d_hi) & even_lo)
+    out = torch.where(pick_lo, lo, hi)
+    # a nonzero sum that rounds to zero keeps its sign (IEEE), an exact zero
+    # is the FP64 sum's own zero
+    signed_zero = torch.where(x < 0, torch.zeros_like(out).neg(), torch.zeros_like(out))
+    zero = torch.where(x == 0, x.to(dtype), signed_zero)
+    return torch.where(out == 0, zero, out)
+
+
+def exact_sum(parts: torch.Tensor) -> torch.Tensor:
+    """The FP64 sum of the ranks' partials (exact for these inputs), added
+    from the first partial on so that -0 + -0 stays -0 as IEEE says (a
+    reduction from a +0 identity would give +0)."""
+    acc = parts[0].double()
+    for p in parts[1:]:
+        acc = acc + p.double()
+    return acc
+
+
+def _partials(case: str, world: int, shape, dtype, seed: int) -> torch.Tensor:
+    """[world, *shape] partials of every rank (each rank builds them all)."""
+    orig = tuple(shape)
+    g = torch.Generator().manual_seed(seed)
+    rows = shape[0] if len(shape) > 1 else 1
+    if len(shape) == 1:
+        shape = (1, shape[0])
+    p = torch.randn((world, *shape), generator=g, dtype=torch.float64)
+    if case == "row_scales":  # A2-like: per-rank, per-row scales 2^[-6, 3]
+        s = torch.randint(-6, 4, (world, rows), generator=g).double()
+        p = p * torch.exp2(s.reshape((world, rows) + (1,) * (len(shape) - 1)))
+    elif case == "wide":  # magnitudes [1, 2) * 2^[-span, span] per element
+        span = 6 if dtype == FP16 else 15
+        e = torch.randint(-span, span + 1, p.shape, generator=g).double()
+        sign = torch.where(torch.rand(p.shape, generator=g) < 0.5, -1.0, 1.0)
+        p = sign * (1 + torch.rand(p.shape, generator=g, dtype=torch.float64))
+        p = p * torch.exp2(e)
+    elif case == "cancel":  # rank pairs nearly cancel, leaving a small remainder
+        n = p[1::2].shape[0]
+        eps = torch.randn(p[1::2].shape, generator=g, dtype=torch.float64)
+        p[1::2] = -p[0::2][:n] * (1 + 2.0**-6 * eps)
+    elif case == "tiny" and dtype == BF16:  # BF16 subnormals and their sums
+        p = p * 2.0**-130
+    elif case == "zeros":
+        p[torch.rand(p.shape, generator=g) < 0.5] = 0
+    return p.to(dtype).reshape((world, *orig))
+
+
+CASES = ["row_scales", "wide", "cancel", "tiny", "zeros"]
+SHAPES = [(1,), (7,), (3, 333), (1023, 13), (5, 512)]
+
+
+def _worker(rank, world, init_file, jobs, failures):
+    dist.init_process_group(
+        "gloo", init_method=f"file://{init_file}", rank=rank, world_size=world
+    )
+    try:
+        for case, shape, dtype, seed in jobs:
+            parts = _partials(case, world, shape, dtype, seed)
+
+            def exchange(sends, recvs):
+                ops = []
+                for j in range(world):
+                    if j != rank:
+                        ops.append(dist.P2POp(dist.isend, sends[j].contiguous(), j))
+                        ops.append(dist.P2POp(dist.irecv, recvs[j], j))
+                for w in dist.batch_isend_irecv(ops):
+                    w.wait()
+
+            def all_gather(out, chunk):
+                pieces = list(out.view(world, -1).unbind(0))
+                dist.all_gather(pieces, chunk.contiguous())
+                out.copy_(torch.cat(pieces))
+
+            mine = parts[rank].clone()
+            got = R.round_once_all_reduce_with(mine, rank, world, exchange, all_gather)
+            exact = exact_sum(parts)
+            want = reference_round(exact, dtype)
+            same = got.view(_INT[dtype]) == want.view(_INT[dtype])
+            if got.shape != parts.shape[1:] or not bool(same.all()):
+                failures.put((rank, case, shape, str(dtype), int((~same).sum())))
+            if not torch.equal(mine, parts[rank]):
+                failures.put((rank, case, shape, str(dtype), "input modified"))
+            # every rank holds the same bits
+            bits = got.view(_INT[dtype]).int().contiguous()
+            all_bits = [torch.empty_like(bits) for _ in range(world)]
+            dist.all_gather(all_bits, bits)
+            if any(not torch.equal(b, all_bits[0]) for b in all_bits):
+                failures.put((rank, case, shape, str(dtype), "ranks differ"))
+    finally:
+        dist.destroy_process_group()
+
+
+@pytest.mark.parametrize("world", [2, 4, 8])
+@pytest.mark.parametrize("dtype", [BF16, FP16])
+def test_round_once_is_the_correctly_rounded_exact_sum(tmp_path, world, dtype):
+    jobs = [
+        (case, shape, dtype, 1000 * i + j)
+        for i, case in enumerate(CASES)
+        for j, shape in enumerate(SHAPES)
+    ]
+    ctx = mp.get_context("spawn")
+    failures = ctx.Queue()
+    mp.start_processes(
+        _worker,
+        args=(world, str(tmp_path / "init"), jobs, failures),
+        nprocs=world,
+        join=True,
+        start_method="spawn",
+    )
+    found = []
+    while not failures.empty():
+        found.append(failures.get())
+    assert not found, found
+
+
+@pytest.mark.parametrize("dtype", [BF16, FP16])
+def test_round_from_fp64_matches_the_reference(dtype) -> None:
+    g = torch.Generator().manual_seed(7)
+    x = torch.randn(1 << 16, generator=g, dtype=torch.float64)
+    x = x * torch.exp2(torch.randint(-20, 21, x.shape, generator=g).double())
+    if dtype == FP16:
+        x = x.clamp(-60000, 60000)
+    # exact ties and values on the format's grid
+    on_grid = x.to(dtype).double()
+    tie = (on_grid + _step(x.to(dtype), up=True).double()) / 2
+    for v in (x, on_grid, tie, -tie):
+        got = R.round_from_fp64(v, dtype)
+        want = reference_round(v, dtype)
+        assert torch.equal(got.view(_INT[dtype]), want.view(_INT[dtype]))
+
+
+def test_ring_rounding_differs_where_round_once_does_not() -> None:
+    """The reason for the module: a TP4 BF16 ring (each hop stored in BF16)
+    misses the correctly rounded sum on many elements; round-once never does."""
+    world = 4
+    parts = _partials("row_scales", world, (64, 512), BF16, 3)
+    acc = parts[0]
+    for j in range(1, world):
+        acc = (acc.float() + parts[j].float()).to(BF16)
+    want = reference_round(exact_sum(parts), BF16)
+    assert (acc.view(torch.int16) != want.view(torch.int16)).float().mean() > 0.1
+
+
+def test_single_rank_and_unsupported_dtype() -> None:
+    t = torch.randn(5, 3).to(BF16)
+    got = R.round_once_all_reduce_with(t, 0, 1, None, None)
+    assert torch.equal(got, t) and got.data_ptr() != t.data_ptr()
+    for dtype in (torch.float32, torch.int32):
+        with pytest.raises(TypeError):
+            R.round_once_all_reduce_with(torch.zeros(4, dtype=dtype), 0, 1, None, None)
+
+
+def test_grouped_takes_needs_a_cuda_tensor() -> None:
+    comm = type("C", (), {"pynccl_comm": None})()
+    assert R.grouped_round_once_takes(torch.zeros(8, dtype=BF16), comm) is False
