+  TORCH_CHECK(spec_state_indices.is_cuda() && spec_state_indices.dim() == 2 &&
+                  spec_state_indices.size(0) >= N && spec_state_indices.size(1) >= 1 &&
+                  spec_state_indices.stride(1) == 1 &&
+                  (spec_state_indices.scalar_type() == at::kInt ||
+                   spec_state_indices.scalar_type() == at::kLong),
+              "spec_state_indices must be CUDA INT32/INT64 [>=N, S_cols>=1] with stride(1)==1");
+  const int64_t S_cols = spec_state_indices.size(1);
+  const int64_t min_cs_len = 2 + S_cols;
+
+  const void* fsrc_ptr = spec_state_indices.data_ptr();
+  int64_t stride_fsrc_n = spec_state_indices.stride(0);
+  int64_t F_cols = S_cols;
+  bool fsrc_i64 = (spec_state_indices.scalar_type() == at::kLong);
+  if (fold_src_indices.has_value() && fold_src_indices->defined()) {
+    TORCH_CHECK(fold_src_indices->is_cuda() && fold_src_indices->dim() == 2 &&
+                    fold_src_indices->size(0) >= N && fold_src_indices->size(1) >= 1 &&
+                    fold_src_indices->stride(1) == 1 &&
+                    (fold_src_indices->scalar_type() == at::kInt ||
+                     fold_src_indices->scalar_type() == at::kLong),
+                "fold_src_indices must be CUDA INT32/INT64 [>=N, F_cols>=1] with stride(1)==1");
+    fsrc_ptr = fold_src_indices->data_ptr();
+    stride_fsrc_n = fold_src_indices->stride(0);
+    F_cols = fold_src_indices->size(1);
+    fsrc_i64 = (fold_src_indices->scalar_type() == at::kLong);
+  }
+
+  const void* fc_ptr = nullptr;
+  bool fc_i64 = false;
+  if (fold_counts.has_value() && fold_counts->defined()) {
+    TORCH_CHECK(fold_counts->is_cuda() && fold_counts->is_contiguous() &&
+                    fold_counts->dim() == 1 && fold_counts->size(0) >= N &&
+                    (fold_counts->scalar_type() == at::kInt ||
+                     fold_counts->scalar_type() == at::kLong),
+                "fold_counts must be contiguous CUDA INT32/INT64 [>=N]");
+    fc_ptr = fold_counts->data_ptr();
+    fc_i64 = (fold_counts->scalar_type() == at::kLong);
+  }
+
+  TORCH_CHECK(num_accepted_tokens.is_cuda() && num_accepted_tokens.is_contiguous() &&
+                  num_accepted_tokens.dim() == 1 && num_accepted_tokens.size(0) >= N &&
+                  (num_accepted_tokens.scalar_type() == at::kInt ||
+                   num_accepted_tokens.scalar_type() == at::kLong),
+              "num_accepted_tokens must be contiguous CUDA INT32/INT64 [>=N]");
+
+  TORCH_CHECK(conv_state.is_cuda() && conv_state.scalar_type() == at::kBFloat16 &&
+                  conv_state.dim() == 3,
+              "conv_state must be CUDA BF16 3D");
+  int64_t stride_cs_slot = conv_state.stride(0);
+  int64_t stride_cs_c = 0;
+  int64_t stride_cs_t = 0;
+  int64_t conv_state_len = 0;
+  if (conv_state.size(1) == C && conv_state.size(2) >= min_cs_len) {
+    stride_cs_c = conv_state.stride(1);
+    stride_cs_t = conv_state.stride(2);
+    conv_state_len = conv_state.size(2);
+  } else if (conv_state.size(2) == C && conv_state.size(1) >= min_cs_len) {
+    stride_cs_t = conv_state.stride(1);
+    stride_cs_c = conv_state.stride(2);
+    conv_state_len = conv_state.size(1);
+  } else {
