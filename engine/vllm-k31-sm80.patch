+
+
+# ---------------------------------------------------------------------------
+# Cache geometry
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class IndexCacheGeometry:
+    """Byte layout of a bound indexer key cache.
+
+    A key at slot ``s`` lives on page ``s // block_size`` at offset
+    ``s % block_size``; see :meth:`value_byte` and :meth:`scale_byte`.
+    """
+
+    num_pages: int
+    block_size: int
+    head_dim: int
+    # Bytes between the first bytes of consecutive pages.
+    page_stride: int
+
+    @property
+    def page_bytes(self) -> int:
+        """Bytes a page occupies: values, then one fp32 scale per key."""
+        return self.block_size * (self.head_dim + SCALE_BYTES)
+
+    @property
+    def span_bytes(self) -> int:
+        """Bytes from the first page's first byte to the last page's end."""
+        if self.num_pages == 0:
+            return 0
+        return (self.num_pages - 1) * self.page_stride + self.page_bytes
+
+    @property
+    def packed(self) -> bool:
+        return self.page_stride != self.page_bytes
+
+    def value_byte(self, slot: int) -> int:
+        """Offset of the first value byte of ``slot``."""
+        page, offset = divmod(slot, self.block_size)
+        return page * self.page_stride + offset * self.head_dim
+
+    def scale_byte(self, slot: int) -> int:
+        """Offset of the fp32 scale of ``slot``."""
+        page, offset = divmod(slot, self.block_size)
+        return (
+            page * self.page_stride
+            + self.block_size * self.head_dim
+            + offset * SCALE_BYTES
+        )
+
