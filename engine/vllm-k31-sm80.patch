+# ------------------------------------------------- pipeline broadcast
+
+
+class _Wire:
+    """torch.distributed.broadcast between one last rank and one earlier rank
+    run in sequence: the sender's tensors queue up; a receiver must allocate
+    exactly the shape and dtype sent."""
+
+    def __init__(self):
+        self.sent: deque = deque()
+
+    def broadcast(self, tensor, src, group):
+        if group.is_last:
+            self.sent.append(tensor.clone())
+            return
+        got = self.sent.popleft()
+        if got.shape != tensor.shape or got.dtype != tensor.dtype:
+            raise AssertionError(f"sent {tuple(got.shape)}, received {tuple(tensor.shape)}")
+        tensor.copy_(got)
+
+
+class _Stream:
+    def wait_stream(self, other):
+        pass
+
+    def record_event(self):
+        return object()
+
+
+def _handler(monkeypatch, pp_utils, is_last):
+    group = SimpleNamespace(
+        is_last_rank=is_last,
+        last_rank=1,
+        world_size=2,
+        make_sibling_device_group=lambda group_desc: SimpleNamespace(is_last=is_last),
+    )
+    monkeypatch.setattr(pp_utils, "get_pp_group", lambda: group)
+    return pp_utils.PPHandler(max_num_reqs=4, num_speculative_steps=KMAX, device="cpu")
+
+
+def _decode_batch(num_reqs, k):
+    return SimpleNamespace(
+        num_reqs=num_reqs,
+        num_draft_tokens=num_reqs * k,
+        num_computed_tokens_np=np.full(num_reqs, 100, dtype=np.int32),
+        prefill_len_np=np.full(num_reqs, 8, dtype=np.int32),
+        num_scheduled_tokens=np.full(num_reqs, 1 + k, dtype=np.int32),
+        is_prefilling_np=np.zeros(num_reqs, dtype=np.bool_),
+        max_seq_len_np=None,
+        idx_mapping=torch.arange(num_reqs),
+        idx_mapping_np=np.arange(num_reqs),
+    )
+
+
+@pytest.fixture
+def pp_pair(monkeypatch):
+    from vllm.v1.worker.gpu import pp_utils
+
+    wire = _Wire()
+    monkeypatch.setattr(torch.cuda, "current_stream", lambda device=None: _Stream())
+    monkeypatch.setattr(torch.cuda, "Stream", lambda device=None: _Stream())
+    monkeypatch.setattr(torch.cuda, "stream", lambda s: nullcontext())
+    monkeypatch.setattr(torch.distributed, "broadcast", wire.broadcast)
+    monkeypatch.setattr(torch.Tensor, "record_stream", lambda self, s: None)
+    last = _handler(monkeypatch, pp_utils, True)
+    other = _handler(monkeypatch, pp_utils, False)
+    return last, other
+
+
+def _one_step(last, other, num_reqs, k, narrow=False):
+    batch = _decode_batch(num_reqs, k)
+    sampled = torch.arange(num_reqs * (KMAX + 1), dtype=torch.int64).view(
+        num_reqs, KMAX + 1
+    )
+    last.broadcast(
+        sampled,
+        torch.full((num_reqs,), 1, dtype=torch.int32),
+        torch.full((num_reqs,), k, dtype=torch.int32),
+        batch,
+    )
+    # The runner hands the full-width draft buffer, -1 past the drafted count.
+    drafts = torch.arange(num_reqs * KMAX, dtype=torch.int64).view(num_reqs, KMAX)
+    last.broadcast_drafts(drafts[:, :k] if narrow else drafts)
+    other.receive(batch, recv_drafts=True)
+    entry = other.queue[-1]
+    assert torch.equal(entry.sampled_tokens, sampled)
+    assert torch.equal(entry.draft_tokens, drafts)
+
+
+def test_pp_broadcast_shapes_do_not_depend_on_the_tier(pp_pair):
+    last, other = pp_pair
+    for num_reqs, k in [(1, 3), (1, 12), (2, 5), (1, 9), (3, 7), (1, 3)]:
+        _one_step(last, other, num_reqs, k)
+
+
+def test_pp_wire_catches_a_tier_wide_draft_broadcast(pp_pair):
+    # Control: had the last rank sent only the verified columns, the earlier
+    # rank would receive a different shape.
+    last, other = pp_pair
+    with pytest.raises(AssertionError, match="sent"):
+        _one_step(last, other, 1, 5, narrow=True)
