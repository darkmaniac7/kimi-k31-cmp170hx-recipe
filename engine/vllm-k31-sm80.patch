@@ -0,0 +1,162 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU tests of the sm_80 Kimi K3.1 indexer's FP8 path
+(vllm/models/kimi_k3/nvidia/sm80_dsa.py): the software float8_e4m3fn
+conversion and the two kernels that use it.
+
+The Triton code runs in Triton's interpreter (a child pytest process, see
+tests/kernels/interpreter_child.py), so these are the kernels themselves, not
+a copy. The interpreter does not round to bfloat16 as the hardware does, so
+the key insert runs on fp32 keys here; its bfloat16 rounding step is covered
+on a card (test_sm80_dsa_gpu.py).
+
+Definition under test. The fork helper ``f32_to_e4m3_bits`` is what the
+sm_80 path uses where upstream's kernels store through ``tl.float8e4nv``
+(Triton's hardware ``cvt.rn.satfinite``): round to nearest, ties to even,
+subnormals kept, every magnitude above 448 (infinity too) saturated to
++-448, the sign bit kept. Upstream's kernels never hand it a value outside
+[-448, 448]: the key path scales by the row maximum and the query path
+clamps. A NaN input stays a NaN pattern here; upstream's kernels do not
+define it (a NaN key or query is already a broken state).
+"""
+
+import pytest
+import torch
+
+from tests.kernels.interpreter_child import run_in_interpreter_child
+from tests.models.kimi_k3.sm80 import sm80_dsa_cases as cases
+from vllm.models.kimi_k3.nvidia import sm80_dsa
+
+DEVICE = "cpu"
+
+
+def _torch_cast(x: torch.Tensor) -> torch.Tensor:
+    return x.to(torch.float8_e4m3fn).view(torch.uint8)
+
+
+@pytest.mark.parametrize("low_bits", cases.SWEEP_LOW_BITS)
+def test_reference_equals_torch_cast(low_bits):
+    """The nearest-value reference of sm80_dsa equals torch's own cast on
+    every swept fp32 pattern: zeros, subnormals, ties, saturation, NaN."""
+    x = cases.fp32_sweep(low_bits)
+    got, want = sm80_dsa.e4m3_bits_reference(x), _torch_cast(x)
+    assert torch.equal(got, want), cases.first_mismatches(x, got, want)
+
+
+def test_reference_named_values():
+    """The definition, value by value (independent of torch's cast)."""
+    nan = float("nan")
+    table = [
+        (0.0, 0x00),
+        (-0.0, 0x80),
+        (2.0**-9, 0x01),
+        (-(2.0**-9), 0x81),  # smallest subnormal
+        (2.0**-10, 0x00),  # half of it: tie, to the even code 0
+        (1.5 * 2.0**-9, 0x02),  # tie between codes 1 and 2: even
+        (2.5 * 2.0**-9, 0x02),  # tie between codes 2 and 3: even
+        (7 * 2.0**-9, 0x07),
+        (7.5 * 2.0**-9, 0x08),  # largest subnormal, tie up
+        (2.0**-6, 0x08),  # smallest normal
+        (1.0, 0x38),
+        (1.0625, 0x38),
+        (1.1875, 0x3A),  # ties at 1 + 1/16, 1 + 3/16
+        (25.0, 0x5C),
+        (27.0, 0x5E),  # ties between 24|26 and 26|28
+        (448.0, 0x7E),
+        (-448.0, 0xFE),
+        (463.9, 0x7E),
+        (464.0, 0x7E),
+        (479.9, 0x7E),
+        (480.0, 0x7E),
+        (3.0e38, 0x7E),
+        (float("inf"), 0x7E),
+        (float("-inf"), 0xFE),
+        (nan, 0x7F),
+    ]
+    x = torch.tensor([value for value, _ in table], dtype=torch.float32)
+    want = torch.tensor([code for _, code in table], dtype=torch.uint8)
+    got = sm80_dsa.e4m3_bits_reference(x)
+    assert torch.equal(got, want), cases.first_mismatches(x, got, want)
+
+
+def test_reference_decode_all_codes():
+    codes = torch.arange(256, dtype=torch.uint8)
+    got = sm80_dsa.e4m3_values_reference(codes)
+    want = codes.view(torch.float8_e4m3fn).float()
+    finite = (codes & 0x7F) != 0x7F
+    assert torch.equal(got[finite], want[finite])
+    assert got[~finite].isnan().all() and want[~finite].isnan().all()
+    assert got[0x7E] == 448.0 and got[0x01] == 2.0**-9 and got[0x08] == 2.0**-6
+
+
+@pytest.mark.parametrize("low_bits", cases.SWEEP_LOW_BITS)
+def test_triton_encode_equals_torch_cast(low_bits):
+    """The helper the kernels call, over the same sweep."""
+    x = cases.fp32_sweep(low_bits, DEVICE)
+    got, want = cases.triton_encode(x).cpu(), _torch_cast(x.cpu())
+    assert torch.equal(got, want), cases.first_mismatches(x.cpu(), got, want)
+
+
+def test_triton_decode_all_codes():
+    """The helper the logits kernels dequantize with: exact on the 254
+    finite codes; the two NaN patterns come out as +-480 (documented in
+    triton_e4m3.py), which the cache never holds for finite keys."""
+    codes = torch.arange(256, dtype=torch.uint8, device=DEVICE)
+    got = cases.triton_decode(codes).cpu()
+    want = sm80_dsa.e4m3_values_reference(codes.cpu())
+    finite = (codes.cpu() & 0x7F) != 0x7F
+    assert torch.equal(got[finite], want[finite])
+    assert got[0x7F] == 480.0 and got[0xFF] == -480.0
+
+
+def test_triton_round_trip_is_identity_on_codes():
+    codes = torch.arange(256, dtype=torch.uint8, device=DEVICE)
+    finite = (codes & 0x7F) != 0x7F
+    again = cases.triton_encode(cases.triton_decode(codes))
+    assert torch.equal(again[finite], codes[finite])
+
+
+@pytest.mark.parametrize("num_heads", [cases.NUM_HEADS, 20])
+@pytest.mark.parametrize("num_tokens", [1, 33])
+def test_q_quant_kernel(num_heads, num_tokens):
+    cases.check_q_quant(num_heads, num_tokens, DEVICE)
+
+
+@pytest.mark.parametrize("packed", [False, True])
+@pytest.mark.parametrize("num_tokens", [1, 7, 150])
+def test_k_insert_kernel(packed, num_tokens):
+    cases.check_k_insert(packed, num_tokens, DEVICE, torch.float32)
+
+
+def test_k_insert_kernel_fp8_ds_mla_row():
+    """The packed row of upstream's default cache dtype (50,512 B)."""
+    cases.check_k_insert(
+        True, 70, DEVICE, torch.float32, mla_bytes=cases.MLA_BYTES_FP8_DS
+    )
+
+
+def test_k_insert_zero_key_takes_the_scale_floor():
+    """A zero key: the scale is the floor's power of two, the bytes zero."""
+    k = torch.zeros(3, cases.HEAD_DIM, dtype=torch.float32, device=DEVICE)
+    zeros = torch.zeros(cases.HEAD_DIM, dtype=torch.float32, device=DEVICE)
+    raw, view = cases.make_index_cache(False, 1, DEVICE, fill=0x5A)
+    topk = torch.zeros((3, cases.TOPK), dtype=torch.int32, device=DEVICE)
+    slots = torch.tensor([5, 0, 63], dtype=torch.int64, device=DEVICE)
+    sm80_dsa.sm80_indexer_k_norm_quant_insert(
+        k, zeros, zeros, 1e-5, slots, view, topk, 3
+    )
+    bits, scale = cases.keys_by_page_view(view.cpu())
+    assert torch.count_nonzero(bits[[0, 5, 63]]) == 0
+    # 1e-4 / 448 lies between 2^-23 and 2^-22.
+    assert (scale[[0, 5, 63]] == 2.0**-22).all()
+    assert (bits[1] == 0x5A).all()
+
+
+def test_reference_mode_runs_the_torch_forms(monkeypatch):
+    """VLLM_INDEXER_DSA_REF=1 writes the same cache through the references."""
+    monkeypatch.setenv("VLLM_INDEXER_DSA_REF", "1")
+    cases.check_k_insert(True, 9, DEVICE, torch.float32, allowed_fraction=0.0)
+    cases.check_q_quant(20, 5, DEVICE)
+
+
+run_in_interpreter_child(globals())
diff --git a/tests/models/kimi_k3/sm80/test_sm80_dsa_gpu.py b/tests/models/kimi_k3/sm80/test_sm80_dsa_gpu.py
