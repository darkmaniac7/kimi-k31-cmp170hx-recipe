+def test_fake_tensor_mode_dspark_k6_shapes():
+    """Verify vllm::k31_dense_linear traces cleanly under FakeTensorMode for all DSpark shapes."""
+    shapes = [
+        ("fc", 4, 35840, [7168]),
+        ("qkv_tp2", 7, 7168, [3072, 512, 512]),
+        ("o_tp2", 7, 3072, [7168]),
+        ("gate_up_tp2", 7, 7168, [7168, 7168]),
+        ("down_tp2", 7, 7168, [7168]),
+        ("ctx_kv_4mem_tp2", 4, 7168, [512, 512, 512, 512]),
+        ("markov_w2", 1, 512, [163840]),
+        ("shared_lm_head_tp2", 12, 7168, [81920]),
+    ]
+    with FakeTensorMode():
+        for _, rows, in_dim, outs in shapes:
+            x = torch.empty((rows, in_dim), dtype=torch.bfloat16)
+            trellises = [
+                torch.empty((in_dim // 16, o // 16, 96), dtype=torch.int16) for o in outs
+            ]
+            suhs = [torch.empty((in_dim,), dtype=torch.float16) for _ in outs]
+            svhs = [torch.empty((o,), dtype=torch.float16) for o in outs]
+            y = torch.ops.vllm.k31_dense_linear(
+                x, trellises, suhs, svhs, [12] * len(outs), outs, 32, torch.bfloat16
+            )
+            assert tuple(y.shape) == (rows, sum(outs))
+            assert y.dtype == torch.bfloat16
