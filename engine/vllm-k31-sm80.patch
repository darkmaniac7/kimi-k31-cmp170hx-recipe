+def test_pp_stage_isolation_distinct_shm_names_and_handles(
+    monkeypatch, meta_platform
+):
+    """pp_rank=0..3 each create distinct shm_names and independent handles."""
+    from vllm.sm80.kernels.k31q import p2p
+
+    monkeypatch.setenv("VLLM_K31_P2P_ALLREDUCE", "1")
+    ops = fake_p2p.FakeP2POps().install(monkeypatch)
+
+    stage_comms = []
+    shm_names = []
+    handles = set()
+    for pp_rank in range(4):
+        ranks = (pp_rank * 2, pp_rank * 2 + 1)
+        c0, c1, ok = _run_pair_init(ops, pp_rank=pp_rank, ranks=ranks)
+        assert ok == [True, True]
+        expected_shm = f"k31_p2p_pp{pp_rank}_tp{ranks[0]}_{ranks[1]}"
+        assert c0.shm_name == expected_shm
+        assert c1.shm_name == expected_shm
+        assert c0.handle != c1.handle
+        shm_names.append(expected_shm)
+        handles.update([c0.handle, c1.handle])
+        # Register rank 0 communicator in module registry to test close_all.
+        p2p._COMMUNICATORS[(pp_rank, c0.tp_group_id)] = c0
+        stage_comms.append((c0, c1))
+
+    assert len(set(shm_names)) == 4
+    assert len(handles) == 8
+
+    # Verify independent exchanges across two different stages produce distinct sums.
+    x_s0_r0 = torch.full((2, 16), 1.0, dtype=torch.bfloat16)
+    x_s0_r1 = torch.full((2, 16), 2.0, dtype=torch.bfloat16)
+    x_s3_r0 = torch.full((2, 16), 10.0, dtype=torch.bfloat16)
+    x_s3_r1 = torch.full((2, 16), 20.0, dtype=torch.bfloat16)
+
+    with ThreadPoolExecutor(max_workers=4) as pool:
+        f_s0_0 = pool.submit(stage_comms[0][0].allreduce, x_s0_r0)
+        f_s0_1 = pool.submit(stage_comms[0][1].allreduce, x_s0_r1)
+        f_s3_0 = pool.submit(stage_comms[3][0].allreduce, x_s3_r0)
+        f_s3_1 = pool.submit(stage_comms[3][1].allreduce, x_s3_r1)
+        assert torch.equal(
+            f_s0_0.result(timeout=10), torch.full((2, 16), 3.0, dtype=torch.bfloat16)
+        )
+        assert torch.equal(
+            f_s0_1.result(timeout=10), torch.full((2, 16), 3.0, dtype=torch.bfloat16)
+        )
+        assert torch.equal(
+            f_s3_0.result(timeout=10), torch.full((2, 16), 30.0, dtype=torch.bfloat16)
+        )
+        assert torch.equal(
+            f_s3_1.result(timeout=10), torch.full((2, 16), 30.0, dtype=torch.bfloat16)
+        )
+
+    p2p.close_all_communicators()
+    for c0, c1 in stage_comms:
+        assert not c0.active
+        c1.close()
+    assert set(ops.destroy_calls) == handles
+
