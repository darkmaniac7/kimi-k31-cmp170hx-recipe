+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU recording stand-in tests and CUDA smoke test for K3.1 ``_k31_glue_C`` wiring.
+
+Verifies:
+  - All 4 switches default OFF (0 glue calls, exact k31-main path).
+  - Independent toggling of each switch and ``VLLM_K31_GLUE_ALL=1`` with
+    per-switch ``=0`` overrides.
+  - AttnRes + RMSNorm across all ``num_blocks = 0..8``, block-write vs
+    non-block-write layers, optional ``output_norm_weight``, and ``delta2``
+    folding without corrupting ``aux_hidden_states`` (DSpark taps) or forward
+    hooks (``g3taps.py``).
+  - Fused KDA decode interception for ``M <= 16`` (both dim-first and step-first
+    conv_state layouts, negative padding slot) and clean fallback on prefill,
+    speculative decode, or ``M > 16``.
+  - Top-16 sigmoid router interception for ``E=896, top_k=16`` (including
+    ``is_padding`` masking) and clean fallback for other shapes/activations.
+  - Row-invariant ``f_a+b`` split-2 GEMV interception in ``K31FusedLinearMethod``
+    for ``M <= 16`` and clean fallback for ``M > 16`` (including Item 2
+    ``linear_plain_invariant_k31`` interop when present).
+  - ``api_version >= 1`` & ``abi_version == 1`` enforcement, ``FakeTensorMode``
+    tracing for all custom ops, and zero CUDA lazy init at import time.
+"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+import types
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
