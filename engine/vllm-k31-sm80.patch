+def test_dispatch_sends_exactly_the_table(g, monkeypatch):
+    monkeypatch.setattr(envs, "VLLM_THIN_GEMM_MAX_TOKENS", 64, raising=False)
+    fn, calls = _route(g, monkeypatch)
+    for n, kk in NK:
