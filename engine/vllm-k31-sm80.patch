+__device__ __forceinline__ uint64_t ld_acquire_sys_u64(const uint64_t* ptr) {
+  uint64_t val;
+  asm volatile("ld.acquire.sys.global.u64 %0, [%1];" : "=l"(val) : "l"(ptr) : "memory");
+  return val;
