+def test_tp2_sharded_sequential_allgathers_and_uninterleaves_draft_stats(
+    make, monkeypatch, tmp_path
+):
+    """Regression for P0 #6: TP2 _sample_sequential_sharded must all-gather and
+    un-interleave _draft_stats (top1/ent) across ranks for batch > 1."""
+    num_reqs = 3
+    n_spec = 4
+    tp_size = 2
+    capacity = 2  # cdiv(3, 2)
+
+    # Distinct per-request logits so top1 and ent uniquely identify each req & step.
+    # Req 0: sharp at col 0; Req 1: flat; Req 2: medium peak at col 0.
+    req_logits = [
+        torch.tensor([[10.0, 0.0, 0.0, 0.0]] * n_spec),
+        torch.tensor([[0.0, 0.0, 0.0, 0.0]] * n_spec),
+        torch.tensor([[2.0, 0.0, 0.0, 0.0]] * n_spec),
+    ]
+    # Expected per-req (top1, ent) via write_draft_stats directly.
+    expected = torch.full((num_reqs, 2, n_spec), float("nan"))
+    for step in range(n_spec):
+        step_logits = torch.stack([req_logits[r][step] for r in range(num_reqs)], dim=0)
+        dump_module.write_draft_stats(expected, step_logits, step)
+
+    # Simulate rank 0 owning interleaved reqs [0, 2] and rank 1 owning [1, pad=0].
+    rank1_stats = torch.full((capacity, 2, n_spec), float("nan"))
+    for step in range(n_spec):
+        r1_logits = torch.stack([req_logits[1][step], req_logits[0][step]], dim=0)
+        dump_module.write_draft_stats(rank1_stats, r1_logits, step)
+
+    class _FakeShardedComm:
+        def all_gather(self, dst, src):
+            # src is rank 0's [capacity, 2*n_spec]; rank 1 contributes rank1_stats.
+            dst[:capacity].copy_(src)
+            dst[capacity:].copy_(rank1_stats.view(capacity, 2 * n_spec))
+
+    def fake_super_sharded(self, n_reqs, head_hidden):
+        # Rank 0 runs _sample_logits only on its interleaved shard: reqs [0, 2].
+        for step in range(n_spec):
+            r0_logits = torch.stack([req_logits[0][step], req_logits[2][step]], dim=0)
+            self._sample_logits(r0_logits, None, None, step)
+
+    monkeypatch.setattr(
+        upstream.DSparkSpeculator,
+        "_sample_logits",
+        lambda self, logits, idx_map, sample_pos, step, bias=None: logits.argmax(dim=-1),
+        raising=False,
+    )
+    monkeypatch.setattr(
+        upstream.DSparkSpeculator,
+        "_sample_sequential_sharded",
+        fake_super_sharded,
+        raising=False,
+    )
+    import vllm.distributed.parallel_state as ps
+
+    monkeypatch.setattr(
+        ps, "get_tp_group", lambda: type("G", (), {"world_size": tp_size, "rank_in_group": 0})()
+    )
+
+    drafter = make()
+    drafter.load_draft_model(None, set())
+    drafter.num_speculative_steps = n_spec
+    drafter._sharded_sequential_comm = _FakeShardedComm()
+
+    drafter._sample_sequential_sharded(num_reqs, torch.zeros(1))
+
+    got = drafter._draft_stats[:num_reqs, :, :n_spec]
+    assert torch.isfinite(got).all(), f"NaN in gathered _draft_stats: {got}"
+    assert torch.allclose(got, expected, atol=1e-6), (got, expected)
