+# -------------------------------------------- PP2 & PP4 EngineCore emulation
+
+
+class _PipeSpecEngine:
+    """Multi-stage EngineCore emulation for PP=2 / PP=4 PipeSpec verification.
+
+    Maintains a ground-truth target token oracle (token at position pos is
+    ``oracle(pos)``) and replays EngineCore's async batch queue of depth
+    ``pp + 1`` with exact PipeSpec Chunk A / B verification, P1/P2 handoff,
+    rollback on dropped B, and optional confidences.
+    """
+
+    def __init__(self, sched, *, pp: int, draft_fn, conf_fn=None):
+        self.s = sched
+        self.pp = pp
+        self.queue_size = pp + 1
+        self.draft_fn = draft_fn  # (pos, K) -> list[int] of len K
+        self.conf_fn = conf_fn
+        self.queue: deque = deque()
+        # Last-rank PipeSpec state mirror for verification.
+        self.last_p1: dict[str, list[int]] = {}
+        self.last_p2: dict[str, list[int]] = {}
+        self.last_b_valid: dict[str, bool] = {}
+        self.committed_pos: dict[str, int] = {}
+        self.emitted_tokens: dict[str, list[int]] = {}
+        self.step_marks: list[tuple[str, int]] = []
+
+    @staticmethod
+    def oracle(pos: int) -> int:
+        # Deterministic target token for position `pos` (1000 + pos).
+        return 1000 + pos
+
+    def step(self):
+        so = self.s.schedule()
+        marks = ps.markers(so)
+        for rid, m in marks.items():
+            self.step_marks.append((m, so.num_scheduled_tokens[rid]))
+        self.queue.append(so)
+        if len(self.queue) >= self.queue_size:
+            self._finish(self.queue.popleft())
+        return so
+
+    def drain(self):
+        while self.queue:
+            self._finish(self.queue.popleft())
+
+    def _finish(self, so):
+        if not so.num_scheduled_tokens:
+            return
+        marks = ps.markers(so)
+        chunk_k = ps.chunk_k_of(so)
+        req_ids, sampled, confs = [], [], []
+        for rid, n_sched in so.num_scheduled_tokens.items():
+            mark = marks.get(rid, "N")
+            spec = so.scheduled_spec_decode_tokens.get(rid) or []
+            if rid not in self.committed_pos:
+                # Prefill finished -> sample 1st output token at prompt_len.
+                req = self.s.requests[rid]
+                pos = req.num_prompt_tokens
+                tok = self.oracle(pos)
+                self.committed_pos[rid] = pos + 1
+                self.emitted_tokens[rid] = [tok]
+                drafts = self.draft_fn(pos + 1, self.s.num_spec_tokens)
+                self.last_p1[rid] = drafts
+                req_ids.append(rid)
+                sampled.append([tok])
+                confs.append(
+                    self.conf_fn(pos + 1)
+                    if self.conf_fn is not None
+                    else [0.95] * self.s.num_spec_tokens
+                )
+                continue
+
+            if mark == "B":
+                if not self.last_b_valid.pop(rid, False):
+                    # Dropped B: emit empty sampled list; P1/P2 already prepared on A.
+                    req_ids.append(rid)
+                    sampled.append([])
+                    confs.append([0.0] * self.s.num_spec_tokens)
+                    continue
+                # Valid B: verify P2[1 : chunk_k + 1] at current committed_pos.
+                pos = self.committed_pos[rid]
+                p2 = self.last_p2.pop(rid)
+                b_drafts = p2[1 : chunk_k + 1]
+                out_toks = []
+                for d in b_drafts:
+                    t = self.oracle(pos)
+                    out_toks.append(t)
+                    pos += 1
+                    if d != t:
+                        break
+                else:
+                    # All chunk_k drafts accepted -> bonus token.
+                    out_toks.append(self.oracle(pos))
+                    pos += 1
+                self.committed_pos[rid] = pos
+                self.emitted_tokens[rid].extend(out_toks)
+                block = self.draft_fn(pos, self.s.num_spec_tokens)
+                self.last_p1[rid] = block[:chunk_k]
+                self.last_p2[rid] = block[chunk_k : 2 * chunk_k + 1]
+                req_ids.append(rid)
+                sampled.append(out_toks)
+                confs.append(
+                    self.conf_fn(pos)
+                    if self.conf_fn is not None
+                    else [0.95] * self.s.num_spec_tokens
+                )
+                continue
+
+            # Normal "N" or Chunk "A": verify `len(spec)` drafts from last_p1.
+            pos = self.committed_pos[rid]
+            k_ver = len(spec)
+            a_drafts = self.last_p1.get(rid, [-1] * k_ver)[:k_ver]
+            out_toks = []
+            all_acc = True
+            for d in a_drafts:
+                t = self.oracle(pos)
+                out_toks.append(t)
+                pos += 1
+                if d != t:
+                    all_acc = False
+                    break
+            if all_acc:
+                out_toks.append(self.oracle(pos))
+                pos += 1
+            self.committed_pos[rid] = pos
+            self.emitted_tokens[rid].extend(out_toks)
+
+            if mark == "A":
+                p2_prev = self.last_p2.get(rid)
+                b_valid = (
+                    all_acc
+                    and p2_prev is not None
+                    and len(p2_prev) >= chunk_k + 1
+                    and out_toks[-1] == p2_prev[0]
+                )
+                self.last_b_valid[rid] = b_valid
+                if not b_valid:
+                    # Failed A: draft next epoch's P1/P2 immediately.
+                    block = self.draft_fn(pos, self.s.num_spec_tokens)
+                    self.last_p1[rid] = block[:chunk_k]
+                    self.last_p2[rid] = block[chunk_k : 2 * chunk_k + 1]
+            else:
+                block = self.draft_fn(pos, self.s.num_spec_tokens)
+                self.last_p1[rid] = block
+                self.last_p2.pop(rid, None)
+
+            req_ids.append(rid)
+            sampled.append(out_toks)
+            confs.append(
+                self.conf_fn(pos)
+                if self.conf_fn is not None
+                else [0.95] * self.s.num_spec_tokens
+            )
+
+        out = ModelRunnerOutput(
+            req_ids=req_ids,
+            sampled_token_ids=sampled,
+            draft_confidences=confs,
+        )
+        self.s.update_from_output(so, out)
+
