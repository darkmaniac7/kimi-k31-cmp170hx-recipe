+@pytest.mark.parametrize("drafts", [1, 3, 7])
+@torch.inference_mode()
+def test_layer_verify_rows_of_a_drafted_step(
+    drafts, tmp_path, dist_init, workspace_init
+):
+    """Decode steps of 1 + drafts rows per request, as a speculative verify
+    step has them, on two requests past the top-k. With one draft the
+    indexer's builder keeps two rows per request; with more it flattens the
+    step to single-token rows with their own context lengths (no DeepGEMM:
+    vllm/v1/attention/backends/mla/indexer.py ``_supports_native_decode``)."""
+    harness = _Harness(tmp_path, packed=True, drafts=drafts)
+    try:
+        for chunk in range(5):
+            _check_step(harness, harness.step({0: 512, 1: 440}, seed=40 + chunk))
+        width = 1 + drafts
+        for step, batch in enumerate(
+            ({0: width, 1: width}, {0: width, 1: 1}, {0: 1, 1: width}, {0: 1, 1: 1})
+        ):
+            record = harness.step(batch, seed=50 + step)
+            index_metadata = record["index_metadata"]
+            decode = index_metadata.decode
+            uniform = len(set(batch.values())) == 1
+            if drafts > 1:
+                # Flattened: every row is a decode of its own.
+                assert index_metadata.num_prefills == 0
+                assert index_metadata.num_decode_tokens == sum(batch.values())
+                assert not decode.requires_padding
+                assert (decode.decode_lens[: sum(batch.values())] == 1).all()
+            elif uniform:
+                # Native: one context length per row of a request.
+                assert index_metadata.num_prefills == 0
+                assert decode.seq_lens.shape == (2, max(batch.values()))
+            # A ragged batch at one draft: upstream's builder splits it into
+            # decodes and prefill rows; the result is checked all the same.
+            stats = _check_step(harness, record)
+            assert stats["scored"] and stats["selected_rows"] == sum(batch.values())
+    finally:
+        harness.close()
+
+
+def _chunks(length: int, most: int = 700) -> list[int]:
+    """``length`` in near-equal chunks of at most ``most`` tokens, each above
+    the sparse backend's decode threshold (256)."""
+    count = -(-length // most)
+    sizes = [length // count] * count
+    sizes[0] += length - sum(sizes)
+    assert min(sizes) > 256
+    return sizes
+
+
+@torch.inference_mode()
+def test_layer_decode_eight_rows_past_the_topk(harness):
+    """Eight requests of different lengths past the top-k, prefilled in
+    batches of four requests, then decode batches of eight rows (one token
+    per request)."""
+    lengths = [2100, 2304, 2049, 2600, 2048, 2240, 2500, 2177]
+    plans = [_chunks(n) for n in lengths]
+    for round_ in range(max(len(plan) for plan in plans)):
+        for group in (range(0, 4), range(4, 8)):
+            batch = {i: plans[i][round_] for i in group if round_ < len(plans[i])}
+            if batch:
+                _check_step(
+                    harness, harness.step(batch, seed=100 + 10 * round_ + group[0])
+                )
+    assert [r.length for r in harness.requests] == lengths
+    for token in range(2):
+        record = harness.step({i: 1 for i in range(8)}, seed=200 + token)
+        index_metadata = record["index_metadata"]
+        assert index_metadata.num_decodes == 8 and index_metadata.num_prefills == 0
+        assert record["out"].shape[0] == 8
+        stats = _check_step(harness, record)
+        assert stats["scored"] and stats["selected_rows"] == 8
+
