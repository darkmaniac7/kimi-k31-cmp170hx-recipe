@@ -0,0 +1,467 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Recording CPU stand-in for _k31_p2p_C (vllm/sm80/kernels/k31q/p2p_ops.py).
+
+Simulates a connected TP=2 pair on the CPU with exact fixed-order FP32
+``rank0 + rank1`` reduction, optional fused residual add, and fused FP32
+``RMSNorm`` matching ``csrc/k31_p2p/p2p_k31.cu``. Supports both single-rank
+preset peer partials and true 2-thread concurrent TP=2 handshakes and
+exchanges, plus injectable ``verify_peer_transport`` failure modes.
+"""
+
+from __future__ import annotations
+
+import json
+import threading
+from dataclasses import dataclass, field
+from typing import Any
+
+import torch
+
+
+def _fp32_rmsnorm_bf16(
+    x_fp32: torch.Tensor, weight: torch.Tensor, eps: float
+) -> torch.Tensor:
+    inv_rms = torch.rsqrt(x_fp32.pow(2).mean(dim=-1, keepdim=True) + float(eps))
+    return (x_fp32 * inv_rms * weight.float()).to(torch.bfloat16)
+
+
+@dataclass
+class _FakeHandle:
+    handle_id: int
+    rank: int
+    device_ordinal: int
+    max_bytes: int
+    shm_name: str
+    connected: bool = False
+    peer_handle_id: int | None = None
+    peer_device_ordinal: int = -1
+    transport: str = "unconnected"
+    timeout_ms: int = 5000
+    error_code: int = 0
+    aborted: int = 0
+    generation: int = 1
+    proc_nonce: int = 0x123456789ABCDEF0
+    imports_closed: bool = False
+    destroyed: bool = False
+
+
+class FakeTP2Group:
+    """Thread-synchronized TP=2 group stand-in supporting ``all_gather_object``."""
+
+    def __init__(
+        self,
+        ranks: tuple[int, int] = (0, 1),
+        unique_name: str | None = None,
+    ) -> None:
+        self.ranks = tuple(ranks)
+        self.world_size = len(self.ranks)
+        self.unique_name = unique_name or f"tp_{self.ranks[0]}_{self.ranks[1]}"
+        self._barrier = threading.Barrier(self.world_size)
+        self._lock = threading.Lock()
+        self._slots: list[Any] = [None] * self.world_size
+
+    def view(self, rank_in_group: int, device_index: int | None = None) -> "_RankView":
+        return _RankView(
+            group=self,
+            rank_in_group=rank_in_group,
+            device_index=rank_in_group if device_index is None else device_index,
+        )
+
+    def gather_from(self, rank_in_group: int, obj: Any) -> list[Any]:
+        with self._lock:
+            self._slots[rank_in_group] = obj
+        self._barrier.wait(timeout=5.0)
+        with self._lock:
+            out = list(self._slots)
+        self._barrier.wait(timeout=5.0)
+        return out
+
+
+class _RankView:
+    def __init__(
+        self, group: FakeTP2Group, rank_in_group: int, device_index: int
+    ) -> None:
+        self._group = group
+        self.ranks = group.ranks
+        self.world_size = group.world_size
+        self.rank_in_group = rank_in_group
+        self.rank = group.ranks[rank_in_group]
+        self.local_rank = device_index
+        self.device_index = device_index
+        self.unique_name = group.unique_name
+
+    def all_gather_object(self, obj: Any) -> list[Any]:
+        return self._group.gather_from(self.rank_in_group, obj)
+
+
+@dataclass
+class _PairChannel:
+    """Two-thread rendezvous for paired rank0/rank1 P2P kernel calls."""
+
+    barrier: threading.Barrier = field(default_factory=lambda: threading.Barrier(2))
+    lock: threading.Lock = field(default_factory=threading.Lock)
+    payloads: dict[int, Any] = field(default_factory=dict)
+
+    def exchange(self, rank: int, payload: Any) -> tuple[Any, Any]:
+        with self.lock:
+            self.payloads[rank] = payload
+        self.barrier.wait(timeout=5.0)
+        with self.lock:
+            r0 = self.payloads[0]
+            r1 = self.payloads[1]
+        self.barrier.wait(timeout=5.0)
+        return r0, r1
+
+
+class FakeP2POps:
+    """Recording stand-in for ``vllm.sm80.kernels.k31q.p2p_ops``."""
+
+    def __init__(
+        self,
+        *,
+        probe_outcomes: dict[tuple[bool, int], bool] | None = None,
+        connect_failures: set[tuple[bool, int]] | None = None,
+        capability: tuple[int, int] = (8, 0),
+    ) -> None:
+        # Optional map: (force_shm, rank) -> verify_peer_transport ok bool.
+        self.probe_outcomes = dict(probe_outcomes or {})
+        self.connect_failures = set(connect_failures or set())
+        self.capability = capability
+
+        self._lock = threading.Lock()
+        self._next_handle = 100
+        self.handles: dict[int, _FakeHandle] = {}
+        self._channels: dict[tuple[int, int], _PairChannel] = {}
+        # Single-rank mode: optional preset peer tensor queue keyed by handle.
+        self._preset_peer: dict[int, list[Any]] = {}
+
+        # Call logs
+        self.create_calls: list[dict[str, Any]] = []
+        self.connect_calls: list[dict[str, Any]] = []
+        self.verify_calls: list[dict[str, Any]] = []
+        self.close_imports_calls: list[int] = []
+        self.destroy_calls: list[int] = []
+        self.teardown_events: list[tuple[str, int, int]] = []
+        self.abort_calls: list[int] = []
+        self.timeout_calls: list[tuple[int, int]] = []
+        self.allreduce_calls: list[dict[str, Any]] = []
+        self.moe_dual_calls: list[dict[str, Any]] = []
+        self.pp_send_calls: list[dict[str, Any]] = []
+        self.pp_recv_calls: list[dict[str, Any]] = []
+        self.pp_drain_calls: list[int] = []
+
+    def install(self, monkeypatch) -> "FakeP2POps":
+        """Install this stand-in into ``vllm.sm80.kernels.k31q.p2p`` for CPU tests."""
+        from vllm.sm80.kernels.k31q import p2p
+
+        p2p.reset_communicators()
+        monkeypatch.setattr(p2p, "library_built", lambda: True)
+        monkeypatch.setattr(p2p, "load_p2p_native", lambda: self)
+        monkeypatch.setattr(p2p, "_device_capability", lambda: self.capability)
+        monkeypatch.setattr(p2p, "_p2p_allreduce", p2p._allreduce_impl)
+        monkeypatch.setattr(
+            p2p, "_p2p_allreduce_residual", p2p._allreduce_residual_impl
+        )
+        monkeypatch.setattr(
+            p2p, "_p2p_moe_dual_reduce_rmsnorm", p2p._moe_dual_reduce_rmsnorm_impl
+        )
+        return self
+
+    def enqueue_peer_payload(self, handle: int, payload: Any) -> None:
+        """Supply peer partial(s) for single-rank unit tests."""
+        self._preset_peer.setdefault(int(handle), []).append(payload)
+
+    def build_info(self) -> dict[str, Any]:
+        return {
+            "abi_version": 1,
+            "api_version": 3,
+            "torch_version": torch.__version__.split("+")[0],
+            "cuda_version": 13000,
+            "cxx11_abi": int(torch._C._GLIBCXX_USE_CXX11_ABI),
+        }
+
+    def create_local(
+        self,
+        rank: int,
+        device_ordinal: int = 0,
+        max_bytes: int = 4 * 1024 * 1024,
+        shm_name: str = "",
+    ) -> tuple[int, bytes]:
+        with self._lock:
+            hid = self._next_handle
+            self._next_handle += 1
+            h = _FakeHandle(
+                handle_id=hid,
+                rank=int(rank),
+                device_ordinal=int(device_ordinal),
+                max_bytes=int(max_bytes),
+                shm_name=str(shm_name),
+            )
+            self.handles[hid] = h
+            self.create_calls.append(
+                dict(
+                    handle=hid,
+                    rank=h.rank,
+                    device_ordinal=h.device_ordinal,
+                    max_bytes=h.max_bytes,
+                    shm_name=h.shm_name,
+                )
+            )
+        meta = json.dumps(
+            {
+                "handle_id": hid,
+                "rank": h.rank,
+                "device_ordinal": h.device_ordinal,
+                "shm_name": h.shm_name,
+            }
+        ).encode("utf-8")
+        return hid, meta
+
+    def connect_peer(
+        self, local_handle: int, peer_meta: bytes, force_shm: bool = False
+    ) -> int:
+        peer = json.loads(bytes(peer_meta).decode("utf-8"))
+        with self._lock:
+            h = self.handles[int(local_handle)]
+            self.connect_calls.append(
+                dict(
+                    handle=h.handle_id,
+                    rank=h.rank,
+                    peer_handle=int(peer["handle_id"]),
+                    force_shm=bool(force_shm),
+                )
+            )
+            if (bool(force_shm), h.rank) in self.connect_failures:
+                raise RuntimeError(
+                    f"injected connect_peer failure rank={h.rank} force_shm={force_shm}"
+                )
+            h.peer_handle_id = int(peer["handle_id"])
+            h.peer_device_ordinal = int(peer["device_ordinal"])
+            h.transport = "shm_zero_copy" if force_shm else "p2p_ipc"
+            h.connected = True
+            pair_key = (
+                min(h.handle_id, h.peer_handle_id),
+                max(h.handle_id, h.peer_handle_id),
+            )
+            self._channels.setdefault(pair_key, _PairChannel())
+        return int(local_handle)
+
+    def verify_peer_transport(
+        self, handle: int, timeout_ms: int = 2000
+    ) -> tuple[bool, float, str]:
+        with self._lock:
+            h = self.handles[int(handle)]
+            is_shm = h.transport == "shm_zero_copy"
+            ok = self.probe_outcomes.get((is_shm, h.rank), True)
+            transport = h.transport
+            self.verify_calls.append(
+                dict(
+                    handle=h.handle_id,
+                    rank=h.rank,
+                    transport=transport,
+                    timeout_ms=int(timeout_ms),
+                    ok=bool(ok),
+                )
+            )
+        return bool(ok), (8.5 if not is_shm else 14.0), transport
+
+    def handle_info(self, handle: int) -> dict[str, Any]:
+        with self._lock:
+            h = self.handles[int(handle)]
+            return {
+                "rank": h.rank,
+                "device_ordinal": h.device_ordinal,
+                "peer_device_ordinal": h.peer_device_ordinal,
+                "slot_bytes": h.max_bytes,
+                "timeout_ms": h.timeout_ms,
+                "error": h.error_code,
+                "aborted": h.aborted,
+                "generation": h.generation,
+                "proc_nonce": h.proc_nonce,
+                "connected": h.connected and not h.destroyed,
+                "transport": h.transport,
+            }
+
+    def transport_info(self, handle: int) -> dict[str, Any]:
+        return self.handle_info(handle)
+
+    def set_timeout_ms(self, handle: int, timeout_ms: int) -> None:
+        with self._lock:
+            self.handles[int(handle)].timeout_ms = int(timeout_ms)
+            self.timeout_calls.append((int(handle), int(timeout_ms)))
+
+    def set_abort(self, handle: int) -> None:
+        with self._lock:
+            if int(handle) in self.handles:
+                self.handles[int(handle)].aborted = 1
+                self.handles[int(handle)].error_code = 2
+                self.abort_calls.append(int(handle))
+
+    def clear_abort(self, handle: int) -> None:
+        with self._lock:
+            self.handles[int(handle)].aborted = 0
+
+    def check_error(self, handle: int) -> int:
+        with self._lock:
+            return int(self.handles[int(handle)].error_code)
+
+    def clear_error(self, handle: int) -> None:
+        with self._lock:
+            self.handles[int(handle)].error_code = 0
+
+    def close_peer_imports(self, handle: int) -> None:
+        with self._lock:
+            h = self.handles.get(int(handle))
+            if h is not None and not h.imports_closed:
+                h.imports_closed = True
+                self.close_imports_calls.append(int(handle))
+                self.teardown_events.append(("close_imports", h.rank, int(handle)))
+
+    def destroy(self, handle: int) -> None:
+        with self._lock:
+            h = self.handles.get(int(handle))
+            if h is not None and not h.destroyed:
+                h.destroyed = True
+                h.connected = False
+                self.destroy_calls.append(int(handle))
+                self.teardown_events.append(("destroy", h.rank, int(handle)))
+
+    def destroy_handle(self, handle: int) -> None:
+        self.destroy(handle)
+
+    def _pair_exchange(self, handle: int, payload: Any) -> tuple[Any, Any]:
+        with self._lock:
+            h = self.handles[int(handle)]
+            assert h.connected and not h.destroyed, f"handle {handle} not connected"
+            queue = self._preset_peer.get(h.handle_id)
+            if queue:
+                peer_payload = queue.pop(0)
+                return (
+                    (payload, peer_payload) if h.rank == 0 else (peer_payload, payload)
+                )
+            assert h.peer_handle_id is not None
+            pair_key = (
+                min(h.handle_id, h.peer_handle_id),
+                max(h.handle_id, h.peer_handle_id),
+            )
+            channel = self._channels[pair_key]
+            rank = h.rank
+        return channel.exchange(rank, payload)
+
+    def p2p_allreduce_residual(
+        self,
+        handle: int,
+        x_partial: torch.Tensor,
+        out_sum: torch.Tensor,
+        residual: torch.Tensor | None = None,
+        out_res: torch.Tensor | None = None,
+    ) -> None:
+        assert x_partial.dtype == torch.bfloat16 and x_partial.dim() == 2
+        assert x_partial.is_contiguous() and out_sum.is_contiguous()
+        assert x_partial.shape[1] % 8 == 0
+        assert out_sum.shape == x_partial.shape
+
+        with self._lock:
+            err = self.handles[int(handle)].error_code
+        if err != 0:
+            out_sum.fill_(float("nan"))
+            if residual is not None and out_res is not None:
+                out_res.fill_(float("nan"))
+            return
+
+        r0, r1 = self._pair_exchange(handle, x_partial.detach().clone())
+        sum_fp32 = r0.float() + r1.float()
+        out_sum.copy_(sum_fp32.to(torch.bfloat16))
+        has_res = residual is not None and out_res is not None
+        if has_res:
+            assert residual is not None and out_res is not None
+            assert residual.shape == x_partial.shape and out_res.shape == x_partial.shape
+            out_res.copy_((sum_fp32 + residual.float()).to(torch.bfloat16))
+
+        with self._lock:
+            h = self.handles[int(handle)]
+            self.allreduce_calls.append(
+                dict(
+                    handle=h.handle_id,
+                    rank=h.rank,
+                    rows=int(x_partial.shape[0]),
+                    cols=int(x_partial.shape[1]),
+                    has_residual=has_res,
+                )
+            )
+
+    def p2p_moe_dual_reduce_rmsnorm(
+        self,
+        handle: int,
+        routed_partial: torch.Tensor,
+        shared_partial: torch.Tensor,
+        rms_weight: torch.Tensor,
+        eps: float,
+        out_routed_normed: torch.Tensor,
+        out_shared_sum: torch.Tensor,
+        residual: torch.Tensor | None = None,
+        out_shared_res: torch.Tensor | None = None,
+    ) -> None:
+        assert routed_partial.dtype == torch.bfloat16 and routed_partial.dim() == 2
+        assert shared_partial.dtype == torch.bfloat16 and shared_partial.dim() == 2
+        assert rms_weight.dtype in (torch.bfloat16, torch.float32)
+        assert routed_partial.shape[0] == shared_partial.shape[0]
+        assert routed_partial.shape[1] % 8 == 0 and shared_partial.shape[1] % 8 == 0
+        assert rms_weight.shape == (routed_partial.shape[1],)
+
+        with self._lock:
+            err = self.handles[int(handle)].error_code
+        if err != 0:
+            out_routed_normed.fill_(float("nan"))
+            out_shared_sum.fill_(float("nan"))
+            if residual is not None and out_shared_res is not None:
+                out_shared_res.fill_(float("nan"))
+            return
+
+        (r0_routed, r0_shared), (r1_routed, r1_shared) = self._pair_exchange(
+            handle,
+            (routed_partial.detach().clone(), shared_partial.detach().clone()),
+        )
+        routed_sum_fp32 = r0_routed.float() + r1_routed.float()
+        out_routed_normed.copy_(_fp32_rmsnorm_bf16(routed_sum_fp32, rms_weight, eps))
+        shared_sum_fp32 = r0_shared.float() + r1_shared.float()
+        out_shared_sum.copy_(shared_sum_fp32.to(torch.bfloat16))
+        if residual is not None and out_shared_res is not None:
+            out_shared_res.copy_((shared_sum_fp32 + residual.float()).to(torch.bfloat16))
+
+        with self._lock:
+            h = self.handles[int(handle)]
+            self.moe_dual_calls.append(
+                dict(
+                    handle=h.handle_id,
+                    rank=h.rank,
+                    rows=int(routed_partial.shape[0]),
+                    routed_cols=int(routed_partial.shape[1]),
+                    shared_cols=int(shared_partial.shape[1]),
+                    eps=float(eps),
+                )
+            )
+
+    def p2p_pp_send(self, handle: int, src: torch.Tensor, tag: int = 0) -> None:
+        assert src.is_contiguous()
+        with self._lock:
+            h = self.handles[int(handle)]
+            self.pp_send_calls.append(
+                dict(handle=h.handle_id, rank=h.rank, nbytes=src.numel() * src.element_size(), tag=int(tag))
+            )
+
+    def p2p_pp_recv(self, handle: int, dst: torch.Tensor, tag: int = 0) -> None:
+        assert dst.is_contiguous()
+        with self._lock:
+            h = self.handles[int(handle)]
+            if h.error_code != 0:
+                dst.fill_(float("nan"))
+                return
+            self.pp_recv_calls.append(
+                dict(handle=h.handle_id, rank=h.rank, nbytes=dst.numel() * dst.element_size(), tag=int(tag))
+            )
+
+    def p2p_pp_drain(self, handle: int) -> None:
+        with self._lock:
+            self.pp_drain_calls.append(int(handle))
