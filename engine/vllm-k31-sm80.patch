+# ---------------------------------------------------------------------------
+# 3. DSparkSuffixHybridMixin startup + periodic telemetry logging
+# ---------------------------------------------------------------------------
+
+
+class _FakeSuffix:
+    def __init__(self, max_num_reqs: int = 8, k: int = 12, max_model_len: int = 4096):
+        self.max_num_reqs = max_num_reqs
+        self.num_speculative_steps = k
+        self.max_model_len = max_model_len
+        self.enable_adaptive_verification = True
+        self.drafts = torch.zeros((max_num_reqs, k), dtype=torch.int64)
+        self.num_valid = torch.zeros(max_num_reqs, dtype=torch.int32)
+        self.scratch = torch.zeros((max_num_reqs, 4), dtype=torch.int64)
+        self.last_bucket = torch.full((max_num_reqs,), -1, dtype=torch.int32)
+        self.accept_stats = torch.zeros((18, k, 2), dtype=torch.int64)
+
+    def set_match(
+        self, batch_row: int, req_slot: int, tokens: list[int], match_len: int
+    ) -> None:
+        k = self.num_speculative_steps
+        self.drafts[batch_row].zero_()
+        n = min(len(tokens), k)
+        if n > 0:
+            self.drafts[batch_row, :n] = torch.tensor(tokens[:n], dtype=torch.int64)
+        self.num_valid[batch_row] = n
+        self.scratch[batch_row].zero_()
+        if match_len > 0:
+            self.scratch[batch_row, 0] = match_len * (self.max_model_len + 1) + 5
+        self.last_bucket[req_slot] = -1
+
+    def propose(self, input_batch, *args, **kwargs):
+        return self.drafts[: input_batch.num_reqs]
+
+    def reset_state(self) -> None:
+        return None
+
+
+class _FakeDSparkBase:
+    def __init__(self, vllm_config, device):
+        self.vllm_config = vllm_config
+        self.device = device
+        self.max_num_reqs = 8
+        self.max_width = 12
+        self.num_speculative_steps = 12
+        self.use_confidence_head = True
+        self.context_kv_only = False
+        self.draft_tokens = torch.zeros((8, 12), dtype=torch.int64)
+        self.draft_token_confidence_probs = torch.full((8, 12), 0.3, dtype=torch.float32)
+        self.draft_logits = None
+
+    def propose(
+        self,
+        input_batch,
+        attn_metadata,
+        slot_mappings,
+        last_hidden_states,
+        aux_hidden_states,
+        num_sampled,
+        num_rejected,
+        last_sampled,
+        next_prefill_tokens,
+        temperature,
+        seeds,
+        dp_sync_state=None,
+        dummy_run=False,
+        skip_attn_for_dummy_run=False,
+        mm_inputs=None,
+        is_profile=False,
+        num_speculative_tokens=None,
+    ):
+        return self.draft_tokens[: input_batch.num_reqs]
+
+
+def _make_hybrid(
+    monkeypatch,
+    *,
+    vllm_config=None,
+    req_states=...,
+    min_match_len=4,
+    conf_floor=0.85,
+    mode="hybrid",
+):
+    monkeypatch.setenv("VLLM_DSPARK_SUFFIX_HYBRID", "1")
+    monkeypatch.setenv("VLLM_DSPARK_SUFFIX_MIN_MATCH_LEN", str(min_match_len))
+    monkeypatch.setenv("VLLM_DSPARK_SUFFIX_CONF_FLOOR", str(conf_floor))
+    monkeypatch.setenv("VLLM_DSPARK_SUFFIX_MODE", mode)
+
+    fake_suffix = _FakeSuffix()
+    cls = suffix_hybrid_class(_FakeDSparkBase)
+    monkeypatch.setattr(
+        cls,
+        "_build_suffix_speculator",
+        lambda self, cfg, dev, rs: fake_suffix,
+    )
+    cfg = SimpleNamespace() if vllm_config is None else vllm_config
+    rs = SimpleNamespace() if req_states is ... else req_states
+    inst = cls(cfg, torch.device("cpu"), req_states=rs)
+    return inst, fake_suffix
+
+
+def _call_propose(inst, idx_mapping, **extra):
+    batch = SimpleNamespace(
+        num_reqs=len(idx_mapping),
+        idx_mapping=torch.tensor(idx_mapping, dtype=torch.int32),
+    )
+    z = torch.zeros(len(idx_mapping), dtype=torch.int32)
+    return inst.propose(batch, None, None, z, None, z, z, z, z, z, z, **extra)
+
+
+def test_suffix_hybrid_startup_and_periodic_telemetry_logs(monkeypatch, caplog):
+    caplog.set_level(logging.INFO, logger="vllm.sm80.spec_decode.dspark_suffix_hybrid")
+
+    # Default interval is 64 when adaptive_k is absent.
+    inst_default, _ = _make_hybrid(
+        monkeypatch, min_match_len=5, conf_floor=0.9, mode="replace"
+    )
+    assert inst_default._suffix_log_interval == _DEFAULT_LOG_INTERVAL
+    assert any(
+        "DSpark Suffix Hybrid active (VLLM_DSPARK_SUFFIX_HYBRID=1): "
+        "mode=replace, min_match_len=5, conf_floor=0.90" in rec.getMessage()
+        for rec in caplog.records
+    )
+
+    # Without req_states, active startup log is not emitted (warning only).
+    caplog.clear()
+    inst_no_rs, _ = _make_hybrid(monkeypatch, req_states=None)
+    assert inst_no_rs._suffix is None
+    assert not any(
+        "DSpark Suffix Hybrid active" in rec.getMessage() for rec in caplog.records
+    )
+
+    # Configured adaptive_k.log_interval=4 emits periodic telemetry every 4 real steps.
+    caplog.clear()
+    cfg = SimpleNamespace(
+        speculative_config=SimpleNamespace(adaptive_k={"log_interval": 4})
+    )
+    inst, suffix = _make_hybrid(
+        monkeypatch, vllm_config=cfg, min_match_len=4, conf_floor=0.85
+    )
+    assert inst._suffix_log_interval == 4
+
+    # Step 1: 2 requests, row 0 hits (12 slots, match_len=9), row 1 misses (match_len=2).
+    inst.draft_token_confidence_probs.fill_(0.3)
+    suffix.set_match(0, 0, list(range(100, 112)), match_len=9)
+    suffix.set_match(1, 1, [1, 2], match_len=2)
+    _call_propose(inst, [0, 1])
+
+    # Dummy and profile runs must NOT count toward telemetry steps.
+    _call_propose(inst, [0, 1], dummy_run=True)
+    _call_propose(inst, [0, 1], is_profile=True)
+
+    # Step 2: 1 request, misses completely (match_len=3).
+    inst.draft_token_confidence_probs.fill_(0.3)
+    suffix.set_match(0, 0, [5, 6, 7], match_len=3)
+    _call_propose(inst, [0])
+
+    # Step 3: 2 requests, both hit (6 slots match_len=11, and 4 slots match_len=6).
+    inst.draft_token_confidence_probs.fill_(0.3)
+    suffix.set_match(0, 0, list(range(200, 206)), match_len=11)
+    suffix.set_match(1, 1, list(range(300, 304)), match_len=6)
+    _call_propose(inst, [0, 1])
+
+    # Still only 3 steps: no periodic telemetry emitted yet.
+    periodic_msgs = [
+        rec.getMessage()
+        for rec in caplog.records
+        if "draft slots overridden" in rec.getMessage()
+    ]
+    assert periodic_msgs == []
+
+    # Step 4: 1 request hits (8 slots, match_len=7) -> triggers log for steps 1..4!
+    inst.draft_token_confidence_probs.fill_(0.3)
+    suffix.set_match(0, 0, list(range(400, 408)), match_len=7)
+    _call_propose(inst, [0])
+
+    periodic_msgs = [
+        rec.getMessage()
+        for rec in caplog.records
+        if "draft slots overridden" in rec.getMessage()
+    ]
+    # Totals: steps=4, req-hits=1+0+2+1=4, slots=12+0+6+4+8=30, max_match_len=11.
+    assert periodic_msgs == [
+        "DSpark Suffix Hybrid: 4 steps, 4 req-hits, "
+        "30 draft slots overridden, max_match_len=11"
+    ]
+    # Accumulators were zeroed for the next window.
+    assert inst._suffix_stats.tolist() == [0, 0, 0, 0]
+
