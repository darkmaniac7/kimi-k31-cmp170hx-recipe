+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Qwen QSA canonical top-k on the real kernel, under exact ties.
+
+Shapes follow prefill chunk 4 of the doc32768 repro (positions 12800-15999:
+3200 rows, 3200-4000 visible compressed blocks, 4032 logits columns, block
+top-k 512) plus a 4-row decode batch over the same width. Scores are
+ReLU-floored on a coarse grid, so each row's k-th score is an exact tie that
+straddles the selection boundary (at the 0.0 floor or at a positive level).
+
+These two shapes reach two of the ``persistent_topk`` branches Qwen uses:
+FilteredTopK (more than 32 rows) and histogram_2048 (at most 8,192 visible
+blocks). Long-context decode batches of at most 32 rows reach the other two,
+by each row's visible count: histogram_256 up to 32,768 and the multi-CTA
+radix path above it. They run as 4-row decode batches at 16,384 and 40,000
+columns.
+
+``persistent_topk`` alone may return a different set for identical scores;
+the count of distinct native outputs is printed, not asserted (it depends on
+timing). With VLLM_QWEN4_QSA_TOPK_CANONICAL the set must be identical on
+every call and equal to the (score descending, block index ascending) choice.
+Without ties the tie fix must leave the native output byte for byte.
+Needs a CUDA device and the compiled _C ops; skipped otherwise.
+"""
+
+import pytest
+import torch
+
+from vllm.models.qwen4_exp.nvidia.ops import qsa_indexer as qsa_indexer_ops
+from vllm.sm80.kernels.indexer import qsa_topk_gate
+
+COMPRESS_RATIO = 4
+BLOCK_TOPK = 512
+WIDTH = 4032
+REPEATS = 20
+
+# persistent_topk branch -> (logits columns, visible blocks of the 4 rows).
+LONG_DECODE = {
+    "histogram_256": (16384, (16384, 15000, 12289, 8193)),
+    "radix": (40000, (40000, 38000, 35000, 32769)),
+}
+
+
+def _has_persistent_topk() -> bool:
+    if not torch.cuda.is_available():
+        return False
+    try:
+        import vllm._custom_ops  # noqa: F401
+
+        torch.ops._C.persistent_topk  # noqa: B018
+    except (AttributeError, ImportError, RuntimeError):
+        return False
+    return True
+
+
+pytestmark = [
+    pytest.mark.cuda,
+    pytest.mark.skipif(
+        not _has_persistent_topk(),
+        reason="needs a CUDA device and torch.ops._C.persistent_topk",
+    ),
+]
+
+
+def _tied_logits(visible: torch.Tensor, width: int, seed: int) -> torch.Tensor:
+    g = torch.Generator(device="cuda").manual_seed(seed)
+    rows = visible.shape[0]
+    logits = torch.zeros(rows, width, device="cuda")
+    # 256..767 positive blocks per row on 8 levels; the rest is the 0.0 floor.
+    positives = torch.randint(256, 768, (rows, 1), device="cuda", generator=g)
+    rank = torch.rand(rows, width, device="cuda", generator=g).argsort(dim=1)
+    level = torch.randint(1, 9, (rows, width), device="cuda", generator=g)
+    logits = torch.where(rank < positives, level.float() / 8, logits)
+    return _mask_unwritten(logits, visible)
+
+
+def _mask_unwritten(logits: torch.Tensor, visible: torch.Tensor) -> torch.Tensor:
+    # Never written by the score kernels: must never be selected.
+    columns = torch.arange(logits.shape[1], device="cuda")
+    logits.masked_fill_(columns >= visible[:, None].long(), 1e30)
+    return logits.contiguous()
+
+
+def _chunk4_case(rows: int, seed: int) -> tuple[torch.Tensor, torch.Tensor]:
+    if rows == 3200:
+        positions = torch.arange(12800, 16000, device="cuda")
+        visible = ((positions + 1) // COMPRESS_RATIO).to(torch.int32)
+    else:
+        visible = torch.full((rows,), 4000, dtype=torch.int32, device="cuda")
+    return _tied_logits(visible, WIDTH, seed), visible
+
+
+def _long_decode_visible(branch: str) -> tuple[int, torch.Tensor]:
+    width, counts = LONG_DECODE[branch]
+    return width, torch.tensor(counts, dtype=torch.int32, device="cuda")
+
+
+def _reference(logits: torch.Tensor, visible: torch.Tensor) -> torch.Tensor:
+    """Canonical set, ascending: a stable descending sort keeps equal scores
+    in index order, so its first k are (score desc, index asc)."""
+    columns = torch.arange(logits.shape[1], device=logits.device)
+    masked = logits.masked_fill(columns >= visible[:, None].long(), float("-inf"))
+    order = torch.sort(masked, dim=1, descending=True, stable=True).indices
+    return order[:, :BLOCK_TOPK].sort(dim=1).values.to(torch.int32)
+
+
+def _workspace() -> torch.Tensor:
+    return torch.empty(
+        qsa_indexer_ops._TOPK_WORKSPACE_BYTES, dtype=torch.uint8, device="cuda"
+    )
+
+
+def _native(logits, visible, workspace) -> torch.Tensor:
+    out = torch.empty(logits.shape[0], BLOCK_TOPK, dtype=torch.int32, device="cuda")
+    torch.ops._C.persistent_topk(
+        logits, visible, out, workspace, BLOCK_TOPK, logits.shape[1]
+    )
+    return out
+
+
+def _qsa_topk(logits, visible, workspace) -> torch.Tensor:
+    out = torch.empty(logits.shape[0], BLOCK_TOPK, dtype=torch.int32, device="cuda")
+    qsa_indexer_ops._topk(
+        logits,
+        visible,
+        BLOCK_TOPK * COMPRESS_RATIO,
+        COMPRESS_RATIO,
+        out,
+        workspace,
+    )
+    return out
+
+
+def _row_sets_sorted(x: torch.Tensor) -> torch.Tensor:
+    # Every row here has > k visible blocks, so no -1 fill.
+    return x.sort(dim=1).values
+
+
+def _time_ms(fn, *args) -> float:
+    start, end = torch.cuda.Event(enable_timing=True), torch.cuda.Event(
+        enable_timing=True
+    )
+    fn(*args)
+    torch.cuda.synchronize()
+    start.record()
+    for _ in range(10):
+        fn(*args)
+    end.record()
+    torch.cuda.synchronize()
+    return start.elapsed_time(end) / 10
+
+
+def _check_canonical_every_call(monkeypatch, logits, visible, sort, label) -> None:
+    workspace = _workspace()
+    want = _reference(logits, visible)
+
+    native_variants = set()
+    for _ in range(REPEATS):
+        native = _row_sets_sorted(_native(logits, visible, workspace))
+        assert (native >= 0).all() and (native < visible[:, None]).all()
+        native_variants.add(native.cpu().numpy().tobytes())
+
+    monkeypatch.setattr(qsa_indexer_ops, "_QSA_TOPK_SORTED", sort)
+    monkeypatch.setattr(qsa_topk_gate, "_QSA_TOPK_CANONICAL", True)
+    first = None
+    for _ in range(REPEATS):
+        got = _qsa_topk(logits, visible, workspace)
+        if sort:
+            assert torch.equal(got, want)
+        else:
+            assert torch.equal(_row_sets_sorted(got), want)
+        if first is None:
+            first = got.clone()
+        elif sort:
+            assert torch.equal(got, first)
+    canonical_ms = _time_ms(_qsa_topk, logits, visible, workspace)
+    monkeypatch.setattr(qsa_topk_gate, "_QSA_TOPK_CANONICAL", False)
+    stock_ms = _time_ms(_qsa_topk, logits, visible, workspace)
+    print(
+        f"QSA_TIE {label} sort={int(sort)} k={BLOCK_TOPK} width={logits.shape[1]} "
+        f"repeats={REPEATS} native_set_variants={len(native_variants)} "
+        f"canonical_set_variants=1 stock_ms={stock_ms:.3f} "
+        f"canonical_ms={canonical_ms:.3f}"
+    )
+
+
+@pytest.mark.parametrize("sort", [True, False])
+@pytest.mark.parametrize("rows", [3200, 4])
+def test_canonical_set_is_identical_every_call(monkeypatch, rows, sort):
+    logits, visible = _chunk4_case(rows, seed=rows)
+    _check_canonical_every_call(monkeypatch, logits, visible, sort, f"rows={rows}")
+
+
+@pytest.mark.parametrize("sort", [True, False])
+@pytest.mark.parametrize("branch", sorted(LONG_DECODE))
+def test_long_decode_canonical_set_is_identical_every_call(monkeypatch, branch, sort):
+    width, visible = _long_decode_visible(branch)
+    logits = _tied_logits(visible, width, seed=width)
+    _check_canonical_every_call(
+        monkeypatch, logits, visible, sort, f"rows=4 branch={branch}"
+    )
+
+
+@pytest.mark.parametrize("branch", sorted(LONG_DECODE))
+def test_long_decode_without_ties_is_a_no_op(monkeypatch, branch):
+    """Distinct scores: the native output is already the canonical set, and
+    the tie fix keeps every byte of it (sort off) or only sorts it (sort on)."""
+    width, visible = _long_decode_visible(branch)
+    g = torch.Generator(device="cuda").manual_seed(width + 1)
+    # A permutation of 0..width-1 per row: exact in fp32, no two scores equal.
+    distinct = torch.rand(4, width, device="cuda", generator=g).argsort(dim=1)
+    logits = _mask_unwritten(distinct.float(), visible)
+    native = _native(logits, visible, _workspace())
+    assert torch.equal(_row_sets_sorted(native), _reference(logits, visible))
+
+    monkeypatch.setattr(qsa_topk_gate, "_QSA_TOPK_CANONICAL", True)
+    for sort in (False, True):
+        got = native.clone()
+        ran = qsa_topk_gate.canonical_qsa_topk_(
+            logits, got, row_ends=visible, sort=sort
+        )
+        assert ran
+        assert torch.equal(got, _row_sets_sorted(native) if sort else native)
diff --git a/tests/models/qwen4_exp/test_qsa_sorted_selection.py b/tests/models/qwen4_exp/test_qsa_sorted_selection.py
new file mode 100644
index 0000000000..1d322248ca
--- /dev/null
+++ b/tests/models/qwen4_exp/test_qsa_sorted_selection.py
@@ -0,0 +1,165 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Qwen QSA selected-index order: the sorted selection, the
+VLLM_QWEN_QSA_TOPK_SORTED switch and the native top-k contract."""
+
+import importlib
+
+import pytest
+import torch
+
+from vllm.models.qwen4_exp.nvidia.ops import qsa_indexer as qsa_indexer_ops
+
+from .test_qsa_reference import _expand_qsa_indices_reference, requires_qsa_kernels
+
+
+requires_cuda_device = pytest.mark.skipif(
+    not torch.cuda.is_available(), reason="needs a visible CUDA device"
+)
+
+
+@requires_qsa_kernels
+@pytest.mark.parametrize("block_topk", [3, 512])
+def test_qsa_sorted_selection_preserves_packed_expansion(block_topk: int) -> None:
+    """Sorted padded/strided selections keep the causal tail and count ABI."""
+    storage = torch.full(
+        (5, 2 * block_topk + 3), -99, device="cuda", dtype=torch.int32
+    )
+    blocks = storage[1:4, 1 : 2 * block_topk + 1 : 2]
+    blocks.fill_(-1)
+    blocks[1, 0], blocks[1, -1] = 1, 0
+    blocks[2] = torch.arange(block_topk - 1, -1, -1, device="cuda") + 3
+    expected_blocks = torch.full_like(blocks, -1)
+    expected_blocks[1, :2] = torch.arange(2, device="cuda")
+    expected_blocks[2] = torch.arange(block_topk, device="cuda") + 3
+    expected_storage = storage.clone()
+    expected_storage[1:4, 1 : 2 * block_topk + 1 : 2] = expected_blocks
+
+    qsa_indexer_ops._sort_qsa_selected_indices_(blocks)
+
+    torch.testing.assert_close(storage, expected_storage)
+    positions = torch.tensor([2, 10, 4 * (block_topk + 5) + 2], device="cuda")
+    visible_blocks = ((positions + 1) // 4).to(torch.int32)
+    token_topk = 4 * block_topk
+    packed_width = token_topk + 4
+    packed_storage = torch.full(
+        (5, 2 * packed_width + 3), -99, device="cuda", dtype=torch.int32
+    )
+    packed = packed_storage[1:4, 1 : 2 * packed_width + 1 : 2]
+    expected_packed_storage = packed_storage.clone()
+    expected = _expand_qsa_indices_reference(
+        expected_blocks, positions, positions + 1, 4, token_topk
+    )
+    counts = torch.tensor([3, 11, token_topk + 3], device="cuda")
+    expected_packed_storage[1:4, 1 : 2 * packed_width + 1 : 2] = torch.cat(
+        (expected, counts[:, None]), dim=1
+    )
+
+    qsa_indexer_ops.expand_qsa_block_indices(
+        blocks, positions, visible_blocks, 4, token_topk, packed
+    )
+
+    torch.testing.assert_close(packed_storage, expected_packed_storage)
+
+
+@pytest.mark.parametrize("value,expected", [(None, True), ("1", True), ("0", False)])
+def test_qsa_sort_switch_is_read_from_the_environment(
+    monkeypatch: pytest.MonkeyPatch, value: str | None, expected: bool
+) -> None:
+    if value is None:
+        monkeypatch.delenv("VLLM_QWEN_QSA_TOPK_SORTED", raising=False)
+    else:
+        monkeypatch.setenv("VLLM_QWEN_QSA_TOPK_SORTED", value)
+    try:
+        assert importlib.reload(qsa_indexer_ops)._QSA_TOPK_SORTED is expected
+    finally:
+        monkeypatch.undo()
+        importlib.reload(qsa_indexer_ops)
+
+
+def _native_topk_case(width: int) -> tuple[torch.Tensor, torch.Tensor]:
+    """Rows with 0, 1, K-1, K, K+1 and all visible blocks, plus a tied row."""
+    visible = sorted(v for v in {0, 1, 511, 512, 513, width} if v <= width)
+    generator = torch.Generator(device="cuda").manual_seed(width)
+    logits = torch.randn(len(visible) + 1, width, device="cuda", generator=generator)
+    visible.append(width)
+    logits[-1] = 0.0
+    lengths = torch.tensor(visible, dtype=torch.int32, device="cuda")
+    # Blocks past the visible count must never be read.
+    columns = torch.arange(width, device="cuda")
+    logits.masked_fill_(columns >= lengths[:, None], 1e30)
+    return logits, lengths
+
+
+def _topk_workspace() -> torch.Tensor:
+    return torch.empty(
+        qsa_indexer_ops._TOPK_WORKSPACE_BYTES, dtype=torch.uint8, device="cuda"
+    )
+
+
+@requires_qsa_kernels
+@requires_cuda_device
+@pytest.mark.parametrize("width", [600, 4096, 65536])
+def test_qsa_native_topk_fills_exactly_min_visible_k_leading_slots(
+    monkeypatch: pytest.MonkeyPatch, width: int
+) -> None:
+    """Sorting keeps membership only if the native top-k writes exactly
+    min(visible, K) distinct valid ids into the leading slots, -1 after."""
+    monkeypatch.setattr(qsa_indexer_ops, "_QSA_TOPK_SORTED", False)
+    logits, lengths = _native_topk_case(width)
+    block_topk = 512
+    out = torch.full(
+        (logits.shape[0], block_topk), -7, dtype=torch.int32, device="cuda"
+    )
+    qsa_indexer_ops._topk(logits, lengths, 4 * block_topk, 4, out, _topk_workspace())
+    for row, visible in enumerate(lengths.tolist()):
+        count = min(visible, block_topk)
+        assert (out[row, :count] >= 0).all() and (out[row, count:] == -1).all()
+        chosen = out[row, :count].long()
+        assert chosen.unique().numel() == count
+        assert (chosen < visible).all()
+        if row < logits.shape[0] - 1 and count:
+            expected = torch.topk(logits[row, :visible], count).indices
+            assert set(chosen.tolist()) == set(expected.tolist())
+
+
+@requires_qsa_kernels
+@requires_cuda_device
+def test_qsa_sort_kill_switch_keeps_native_order(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    # The native top-k order is not repeatable between calls (the reason for
+    # the sort), so compare membership and whether the sort ran.
+    logits, lengths = _native_topk_case(4096)
+    shape = (logits.shape[0], 512)
+    native = torch.full(shape, -7, dtype=torch.int32, device="cuda")
+    workspace = _topk_workspace()
+    torch.ops._C.persistent_topk(
+        logits, lengths, native, workspace, 512, logits.shape[1]
+    )
+    sort = qsa_indexer_ops._sort_qsa_selected_indices_
+    calls = []
+
+    def counted_sort(block_indices: torch.Tensor) -> None:
+        calls.append(block_indices.data_ptr())
+        sort(block_indices)
+
+    monkeypatch.setattr(qsa_indexer_ops, "_sort_qsa_selected_indices_", counted_sort)
+    outputs = {}
+    for flag in (False, True):
+        monkeypatch.setattr(qsa_indexer_ops, "_QSA_TOPK_SORTED", flag)
+        calls.clear()
+        outputs[flag] = torch.full(shape, -7, dtype=torch.int32, device="cuda")
+        qsa_indexer_ops._topk(logits, lengths, 2048, 4, outputs[flag], workspace)
+        assert calls == ([outputs[flag].data_ptr()] if flag else [])
+
+    def ordered(blocks: torch.Tensor) -> torch.Tensor:
+        # Ascending with -1 last: the order of the selected ids as uint32.
+        key = torch.where(blocks < 0, 2**32 - 1, blocks.long())
+        return blocks.gather(1, key.argsort(dim=1))
+
+    assert torch.equal(outputs[True], ordered(outputs[True]))
+    # Membership matches a separate native call except on the tied last row,
+    # where any 512 of the equal scores are a valid selection.
+    for output in outputs.values():
+        assert torch.equal(ordered(output)[:-1], ordered(native)[:-1])
