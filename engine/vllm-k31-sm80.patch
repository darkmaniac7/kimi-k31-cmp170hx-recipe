+@gpu_only
+def test_gpu_vq_tp4_four_768_shards_match_two_tp2_1536_shards():
+    """Sum of 4 TP=4 shards (I=768 each) equals sum of 2 TP=2 shards (I=1536 each)."""
+    _require_gpu_vq_and_glue()
+    E, H, I_full, dim, bits = 8, 3584, 3072, 2, 4
+    rate_id = vq_ops.vq_rate_id(dim, bits)
+    _, idx1, sc1, cb1 = _synth_vq_projection(E, H, I_full, IN_LATENT, dim, bits, 501)
+    _, idx3, sc3, cb3 = _synth_vq_projection(E, H, I_full, IN_LATENT, dim, bits, 502)
+    _, idx2, sc2, cb2 = _synth_vq_projection(E, H, I_full, OUT_LATENT, dim, bits, 503)
+
+    gen = torch.Generator(device="cuda").manual_seed(510)
+    M, topk = 6, 8
+    x = (torch.randn((M, H), device="cuda", generator=gen) * 0.25).to(torch.bfloat16)
+    ids = (
+        torch.argsort(torch.rand((M, E), device="cuda", generator=gen), dim=-1)[:, :topk]
+        .to(torch.int32)
+        .contiguous()
+    )
+    w = torch.softmax(torch.randn((M, topk), device="cuda", generator=gen), dim=-1)
+    emap = torch.arange(E, dtype=torch.int32, device="cuda")
+    ex = torch.arange(E, dtype=torch.int64, device="cuda")
+
+    def run_sharded(tp_size: int) -> torch.Tensor:
+        I_part = I_full // tp_size
+        blocks_part = I_part // BLOCK
+        acc = torch.zeros((M, H), dtype=torch.float32, device="cuda")
+        ws = torch.empty(
+            (vq_ops.moe_workspace_size_vq(M, H, I_part, topk, E),),
+            dtype=torch.float32,
+            device="cuda",
+        )
+        for r in range(tp_size):
+            sl = slice(r * blocks_part, (r + 1) * blocks_part)
+            pi1, ps1 = vq_ops.vq_pack(
+                idx1[:, sl].contiguous(), sc1[:, sl].contiguous(), cb1, 0, H, dim, bits, 128
+            )
+            pi3, ps3 = vq_ops.vq_pack(
+                idx3[:, sl].contiguous(), sc3[:, sl].contiguous(), cb3, 0, H, dim, bits, 128
+            )
+            pi2, ps2 = vq_ops.vq_pack(
+                idx2[:, sl].contiguous(), sc2[:, sl].contiguous(), cb2, 1, H, dim, bits, 128
+            )
+            ptrs = torch.zeros((E, 9), dtype=torch.int64, device="cuda")
+            for slot, (pi, ps, cb) in enumerate(
+                ((pi1, ps1, cb1), (pi3, ps3, cb3), (pi2, ps2, cb2))
+            ):
+                ptrs[:, 3 * slot + 0] = pi.data_ptr() + ex * (
+                    pi[0].numel() * pi.element_size()
+                )
+                ptrs[:, 3 * slot + 1] = ps.data_ptr() + ex * (
+                    ps[0].numel() * ps.element_size()
+                )
+                ptrs[:, 3 * slot + 2] = cb.data_ptr()
+            meta = (
+                torch.tensor(
+                    [H, I_part, dim, bits, H, I_part, dim, bits, I_part, H, dim, bits],
+                    dtype=torch.int64,
+                    device="cuda",
+                )
+                .repeat(E, 1)
+                .contiguous()
+            )
+            out_r = torch.empty_like(x)
+            vq_ops.moe_out_vq(
+                x, ids, w, ptrs, meta, emap, I_part, out_r, ws,
+                1.0, 2.0, 0.0, rate_id, rate_id,
+            )
+            acc += out_r.float()
+        return acc
+
+    sum_tp2 = run_sharded(2)
+    sum_tp4 = run_sharded(4)
+    cos = torch.nn.functional.cosine_similarity(
+        sum_tp2.flatten(), sum_tp4.flatten(), dim=0
+    ).item()
+    assert cos > 0.99999
+    assert (sum_tp2 - sum_tp4).abs().max().item() < 0.02
