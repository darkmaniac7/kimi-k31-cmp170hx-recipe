+class DSparkAR1Head(nn.Module):
+    """Block-Causal EAGLE Refiner (`ar1_markov`, `ar1_cand_embed`, `ar1_fulllm`)."""
+
+    def __init__(
+        self,
+        mode: str = "ar1_cand_embed",
+        hidden_size: int = 7168,
+        markov_rank: int = 512,
+        d_model: int = 1024,
+        num_layers: int = 2,
+        num_heads: int = 16,
+        intermediate_size: int = 2048,
+        trained_k: int = 7,
+        max_steps: int = 16,
+        eps: float = 1e-5,
+    ) -> None:
+        super().__init__()
+        assert mode in ("ar1_markov", "ar1_cand_embed", "ar1_fulllm")
+        self.mode = mode
+        self.hidden_size = hidden_size
+        self.markov_rank = markov_rank
+        self.d_model = d_model
+        self.num_layers = num_layers
+        self.num_heads = num_heads
+        self.head_dim = d_model // num_heads
+        self.intermediate_size = intermediate_size
+        self.trained_k = trained_k
+        self.max_steps = max_steps
+
+        self.h_norm = HeadRMSNorm(hidden_size, eps=eps)
+        self.h_in_proj = nn.Linear(hidden_size, d_model, bias=False)
+        self.e_in_proj = nn.Linear(markov_rank, d_model, bias=False)
+        self.e_norm = HeadRMSNorm(d_model, eps=eps)
+        self.step_emb = nn.Embedding(max_steps, d_model)
+
+        self.layers = nn.ModuleList(
+            [
+                CausalBlockRefinerLayer(
+                    d_model=d_model,
+                    num_heads=num_heads,
+                    intermediate_size=intermediate_size,
+                    eps=eps,
+                )
+                for _ in range(num_layers)
+            ]
+        )
+        self.final_norm = HeadRMSNorm(d_model, eps=eps)
+        self.out_m_proj = nn.Linear(2 * d_model, markov_rank, bias=False)
+        if mode in ("ar1_cand_embed", "ar1_fulllm"):
+            self.out_vec_proj: nn.Linear | None = nn.Linear(
+                d_model, hidden_size, bias=False
+            )
+        else:
+            self.out_vec_proj = None
+
+        self._reset_parameters()
+
+    def _reset_parameters(self) -> None:
+        nn.init.normal_(self.step_emb.weight, mean=0.0, std=0.02)
+        nn.init.zeros_(self.out_m_proj.weight)
+        if self.out_vec_proj is not None:
+            nn.init.zeros_(self.out_vec_proj.weight)
+
+    def precompute_hidden(self, draft_hidden: torch.Tensor) -> torch.Tensor:
+        dtype = self.h_in_proj.weight.dtype
+        dh = draft_hidden.to(dtype)
+        k_steps = dh.shape[1]
+        step_ids = torch.arange(k_steps, device=dh.device).clamp(
+            max=self.trained_k - 1
+        )
+        return self.h_in_proj(self.h_norm(dh)) + self.step_emb(step_ids).to(
+            dtype
+        ).unsqueeze(0)
+
+    def forward_parallel(
+        self,
+        e_seq: torch.Tensor,
+        draft_hidden: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor | None]:
+        dtype = self.h_in_proj.weight.dtype
+        e_cast = e_seq.to(dtype)
+        h_base = self.precompute_hidden(draft_hidden)
+        x = h_base + self.e_norm(self.e_in_proj(e_cast))
+        for layer in self.layers:
+            x = layer.forward_parallel(x)
+        u = self.final_norm(x)
+        delta_m = self.out_m_proj(torch.cat([u, F.silu(h_base)], dim=-1))
+        m_seq = e_cast + delta_m
+        vec_seq = self.out_vec_proj(u) if self.out_vec_proj is not None else None
+        return m_seq, vec_seq
+
+    def init_kv_cache(
+        self, batch_size: int, max_k: int, device: torch.device
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        dtype = self.h_in_proj.weight.dtype
+        k_cache = torch.zeros(
+            self.num_layers,
+            batch_size,
+            self.num_heads,
+            max_k,
+            self.head_dim,
+            dtype=dtype,
+            device=device,
+        )
+        v_cache = torch.zeros_like(k_cache)
+        return k_cache, v_cache
+
+    def step_precomputed(
+        self,
+        e_t: torch.Tensor,
+        h_base_t: torch.Tensor,
+        kv_cache: tuple[torch.Tensor, torch.Tensor],
+        step: int,
+    ) -> tuple[torch.Tensor, torch.Tensor | None]:
+        dtype = self.h_in_proj.weight.dtype
+        e_cast = e_t.to(dtype)
+        x_t = h_base_t + self.e_norm(self.e_in_proj(e_cast))
+        k_all, v_all = kv_cache
+        for idx, layer in enumerate(self.layers):
+            x_t = layer.forward_step(x_t, k_all[idx], v_all[idx], step)
+        u_t = self.final_norm(x_t)
+        delta_m = self.out_m_proj(torch.cat([u_t, F.silu(h_base_t)], dim=-1))
+        m_t = e_cast + delta_m
+        vec_t = self.out_vec_proj(u_t) if self.out_vec_proj is not None else None
+        return m_t, vec_t
+
 
