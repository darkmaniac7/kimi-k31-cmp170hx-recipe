+def _load_ev_tool():
+    import importlib.util
+    import sys
+    from pathlib import Path
+
+    path = Path(__file__).resolve().parents[3] / "tools/sm80/dspark_tree_ev.py"
+    spec = importlib.util.spec_from_file_location("dspark_tree_ev", path)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules["dspark_tree_ev"] = mod
+    spec.loader.exec_module(mod)
+    return mod, path.parents[2]
