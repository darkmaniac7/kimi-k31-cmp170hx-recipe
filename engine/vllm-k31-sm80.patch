+    _print_info_once.cache_clear()  # each case must log its own once-banner
+    cfg = SimpleNamespace(n_routed_experts=288, num_experts_per_tok=8,
+                          moe_intermediate_size=2048)
+    tp = 2048 // width
+    worker = SimpleNamespace(
