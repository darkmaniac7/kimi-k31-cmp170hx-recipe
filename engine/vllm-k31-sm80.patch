+    monkeypatch.setattr(
+        kda_mod,
+        "get_forward_context",
+        lambda: SimpleNamespace(attn_metadata={attn.prefix: meta}),
+    )
+
+    fallback_hit = []
+
+    class _FallbackSentinel(RuntimeError):
+        pass
+
+    def _trip_fallback(*args, **kwargs):
+        fallback_hit.append(True)
+        raise _FallbackSentinel()
+
+    monkeypatch.setattr(kda_mod, "causal_conv1d_update", _trip_fallback)
+    monkeypatch.setattr(kda_mod, "causal_conv1d_fn", _trip_fallback)
+    monkeypatch.setattr(kda_mod, "packed_causal_conv1d_supported", lambda *a, **k: False)
+
+    mixed = torch.randn((B, 3 * H * D), dtype=torch.bfloat16)
+    g1 = torch.randn((1, B, H, D), dtype=torch.bfloat16)
+    g2 = torch.randn((B, H, D), dtype=torch.bfloat16)
+    beta = torch.randn((1, B, H), dtype=torch.bfloat16)
+    out = torch.empty((1, B, H, D), dtype=torch.bfloat16)
+
+    with pytest.raises(_FallbackSentinel):
+        attn._forward(mixed, g1, g2, beta, out)
+
+    assert fake.calls_for("fused_kda_decode") == []
+    assert fallback_hit == [True]
