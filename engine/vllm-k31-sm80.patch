+    def forward_sequence(
+        self,
+        e_seq: torch.Tensor,
+        draft_hidden: torch.Tensor,
+    ) -> torch.Tensor:
+        hz, hr, hn, hctx = self.precompute_hidden(draft_hidden)
+        k_steps = draft_hidden.shape[1]
+        state: torch.Tensor | None = None
+        m_list: list[torch.Tensor] = []
+        for t in range(k_steps):
+            m_t, state = self.step_precomputed(
+                e_seq[:, t], hz[:, t], hr[:, t], hn[:, t], hctx[:, t], state
+            )
+            m_list.append(m_t)
