+# Every configuration the gate opens with every expert local (the routed
+# experts split across the tensor-parallel ranks): (intermediate, top_k,
+# experts, bits_x2).
+SPLIT_CONFIGS = sorted(
+    (i, k, local, bits)
+    for h, i, k, local, total, bits in _v2_configs()
