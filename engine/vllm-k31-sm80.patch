+def test_m12_truncated_8_layer_candidate_fails_by_default(tmp_path: Path) -> None:
+    """A candidate dropping L8..L92 must FAIL by default and only pass with --allow-partial-layers."""
+    ref_dump, cand_dump = _make_synthetic_93_layer_pair()
+    cand_dump.tensors = {
+        k: v for k, v in cand_dump.tensors.items()
+        if not k.startswith("L") or int(k.split(".")[0][1:]) < 8
+    }
+
+    pr_strict = cmp_mod.compare_prompt_dumps(ref_dump, cand_dump)
+    assert pr_strict["status"] == "FAIL"
+    assert any("incomplete layer coverage" in e for e in pr_strict["hard_errors"])
+
+    ref_dir = tmp_path / "ref"
+    cand_dir = tmp_path / "cand_8l"
+    _save_canonical_dump(ref_dir, ref_dump)
+    _save_canonical_dump(cand_dir, cand_dump)
+
+    rc_default = cmp_mod.main(["--ref", str(ref_dir), "--cand", str(cand_dir), "--quiet"])
+    assert rc_default == 1
+
+    rc_partial = cmp_mod.main([
+        "--ref", str(ref_dir),
+        "--cand", str(cand_dir),
+        "--allow-partial-layers",
+        "--quiet",
+    ])
+    assert rc_partial == 0
