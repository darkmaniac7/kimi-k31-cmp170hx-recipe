+def _file_residency(path):
+    from vllm.models.qwen4_exp.nvidia.exl3_ple import page_cache_residency
+
+    fd = os.open(path, os.O_RDONLY)
+    try:
+        return page_cache_residency(fd, 0, os.path.getsize(path))
+    finally:
+        os.close(fd)
