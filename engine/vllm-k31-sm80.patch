+    w.refused("--overlay", bad)
+    ok = overlay(tmp_path, 'class = "harness"\n[args]\nprofiler-config = { profiler = "torch" }\n', "ok.toml")
+    d = w.resolve("--overlay", ok)
+    assert d["validated"]["state"] == "VALIDATED" and d["harness"][0] == "--profiler-config"
