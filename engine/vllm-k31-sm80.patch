+        vllm_config=SimpleNamespace(
+            model_config=SimpleNamespace(hf_text_config=cfg, hf_config=cfg),
+            parallel_config=SimpleNamespace(tensor_parallel_size=tp)))
+    handler = _Capture()
+    lg = logging.getLogger(decode.logger.name)
