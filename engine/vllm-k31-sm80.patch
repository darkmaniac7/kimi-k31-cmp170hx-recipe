+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU tests for VLLM_SM80_TARGET_SHARD_ARGMAX on Kimi K3 / K3.1."""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+import torch.nn as nn
+
+from vllm.models.kimi_k3.nvidia.sm80_model import (
+    KimiK3ForConditionalGeneration,
+    KimiLinearForCausalLM,
+)
+from vllm.sm80.worker import target_argmax
+
+
+class _FakeNorm(nn.Module):
+    def __init__(self, scale: float = 2.0) -> None:
+        super().__init__()
+        self.scale = scale
+        self.calls = 0
+
+    def forward(self, x: torch.Tensor, residual=None) -> torch.Tensor:
+        self.calls += 1
+        return x * self.scale
+
+
+class _FakeLogitsProcessor(nn.Module):
+    def __init__(self, org_vocab_size: int) -> None:
+        super().__init__()
+        self.org_vocab_size = org_vocab_size
+        self.logits_as_input = False
+        self.calls: list[bool] = []
+
+    def forward(
+        self,
+        lm_head,
+        hidden_states: torch.Tensor,
+        embedding_bias=None,
+        skip_gather: bool = False,
+    ) -> torch.Tensor:
+        self.calls.append(bool(skip_gather))
+        if skip_gather:
+            return hidden_states @ lm_head.weight_shard.t()
+        return hidden_states @ lm_head.weight_full.t()
+
+
+def _make_kimi_text_stub(
+    *,
+    needs_norm: bool = True,
+    vocab: int = 16,
+    hidden: int = 8,
+    tp_rank: int = 0,
+    tp_size: int = 2,
+    dtype: torch.dtype = torch.bfloat16,
+) -> KimiLinearForCausalLM:
+    m = KimiLinearForCausalLM.__new__(KimiLinearForCausalLM)
+    nn.Module.__init__(m)
+    m.needs_norm_in_logits = needs_norm
+    norm = _FakeNorm(scale=1.5)
+    m.model = SimpleNamespace(norm=norm)
+    w_full = torch.randn(vocab, hidden, dtype=dtype)
+    shard_w = vocab // tp_size
+    lm_head = SimpleNamespace(
+        tp_rank=tp_rank,
+        tp_size=tp_size,
+        weight_full=w_full,
+        weight_shard=w_full[tp_rank * shard_w : (tp_rank + 1) * shard_w],
+    )
+    m.lm_head = lm_head
+    m.logits_processor = _FakeLogitsProcessor(vocab)
+    return m
+
+
+def _make_kimi_vlm_stub(**kwargs) -> KimiK3ForConditionalGeneration:
+    vlm = KimiK3ForConditionalGeneration.__new__(KimiK3ForConditionalGeneration)
+    nn.Module.__init__(vlm)
+    vlm.language_model = _make_kimi_text_stub(**kwargs)
+    return vlm
+
+
+@pytest.mark.parametrize("use_vlm", [False, True])
+@pytest.mark.parametrize("needs_norm", [True, False])
+def test_kimi_compute_logits_local_matches_shard_and_norm(use_vlm, needs_norm):
+    model = (
+        _make_kimi_vlm_stub(needs_norm=needs_norm, tp_rank=1, tp_size=2)
+        if use_vlm
+        else _make_kimi_text_stub(needs_norm=needs_norm, tp_rank=1, tp_size=2)
+    )
+    lm = model.language_model if use_vlm else model
+    x = torch.randn(4, 8, dtype=torch.bfloat16)
+
+    full = model.compute_logits(x)
+    local = model.compute_logits_local(x)
+
+    assert lm.logits_processor.calls == [False, True]
+    assert lm.model.norm.calls == (2 if needs_norm else 0)
+    assert local.shape == (4, 8)
+    torch.testing.assert_close(local, full[:, 8:16])
+
+
+@pytest.mark.parametrize("use_vlm", [False, True])
+def test_kimi_target_argmax_refusal_passes_and_routes_when_active(monkeypatch, use_vlm):
+    model = _make_kimi_vlm_stub() if use_vlm else _make_kimi_text_stub()
+    runner = SimpleNamespace(
+        target_argmax_steps=True,
+        is_last_pp_rank=True,
+        model=model,
+        lora_config=None,
+        batch_sharder=None,
+    )
+    assert target_argmax.refusal(runner) is None
+
+    captured = {}
+
+    def _fake_argmax_rows(m, hidden_states):
+        captured["model"] = m
+        captured["shape"] = tuple(hidden_states.shape)
+        return torch.full((hidden_states.shape[0], 16), float("-inf"), dtype=hidden_states.dtype)
+
+    monkeypatch.setattr(target_argmax, "argmax_rows", _fake_argmax_rows)
+
+    x = torch.randn(3, 8, dtype=torch.bfloat16)
+    monkeypatch.setattr(target_argmax, "_active", False)
+    out_off = model.compute_logits(x)
+    assert "model" not in captured
+    assert out_off.shape == (3, 16)
+
+    monkeypatch.setattr(target_argmax, "_active", True)
+    out_on = model.compute_logits(x)
+    assert captured["model"] is model
+    assert captured["shape"] == (3, 8)
+    assert torch.isneginf(out_on).all()
