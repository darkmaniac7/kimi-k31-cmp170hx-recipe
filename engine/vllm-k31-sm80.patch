diff --git a/csrc/k31_glue/build_glue_standalone.py b/csrc/k31_glue/build_glue_standalone.py
new file mode 100755
index 0000000000..0dc87b0f02
--- /dev/null
+++ b/csrc/k31_glue/build_glue_standalone.py
@@ -0,0 +1,171 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Standalone fat-binary builder for _k31_glue_C.abi3.so (sm_80 and sm_120)."""
+
+import argparse
+import os
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+
+def nvcc_major_version() -> int:
+    out = subprocess.check_output(["nvcc", "--version"], text=True)
+    for tok in out.split():
+        if tok.startswith("V") and "." in tok:
+            return int(tok[1:].split(".")[0])
+    return 12
+
+
+def parse_arch_flags(arch_list: str | None, include_ptx: bool) -> list[str]:
+    """Turn an arch list such as "8.0;12.0" into nvcc -gencode flags."""
+    if arch_list is None:
+        ver = nvcc_major_version()
+        arches = [
+            "-gencode=arch=compute_80,code=sm_80",
+            "-gencode=arch=compute_80,code=compute_80",
+        ]
+        if ver >= 13 or os.environ.get("GLUE_FORCE_SM120", "1") == "1":
+            arches.append("-gencode=arch=compute_120,code=sm_120")
+        return arches
+
+    tokens = [t.strip() for t in re.split(r"[;,\s]+", arch_list) if t.strip()]
+    if not tokens:
+        raise ValueError("Empty --arch-list")
+
+    flags: list[str] = []
+    seen: set[str] = set()
+    for raw in tokens:
+        want_ptx = include_ptx or raw.upper().endswith("+PTX")
+        clean = raw[:-4] if raw.upper().endswith("+PTX") else raw
+        m = re.fullmatch(r"(\d+)\.(\d+)", clean)
+        if m is None:
+            raise ValueError(
+                f"Invalid CUDA arch {raw!r} in --arch-list (expected e.g. 8.0 or 12.0)"
+            )
+        cc = f"{m.group(1)}{m.group(2)}"
+        sass = f"-gencode=arch=compute_{cc},code=sm_{cc}"
+        if sass not in seen:
+            flags.append(sass)
+            seen.add(sass)
+        if want_ptx:
+            ptx = f"-gencode=arch=compute_{cc},code=compute_{cc}"
+            if ptx not in seen:
+                flags.append(ptx)
+                seen.add(ptx)
+    return flags
+
+
+def main() -> int:
+    # Never infer architectures from visible devices or initialize CUDA.
+    os.environ["CUDA_VISIBLE_DEVICES"] = ""
+
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--src-dir", default=str(Path(__file__).resolve().parent))
+    ap.add_argument("--out-dir", default=str(Path(__file__).resolve().parent))
+    ap.add_argument(
+        "--arch-list",
+        default=None,
+        help="Semicolon-separated CUDA arch list, e.g. \"8.0;12.0\" "
+        "(default: sm_80 + PTX + sm_120 on CUDA >= 13)",
+    )
+    ap.add_argument(
+        "--ptx",
+        action="store_true",
+        default=False,
+        help="Also emit compute_XX PTX alongside each sm_XX entry in --arch-list",
+    )
+    ap.add_argument("--ptxas-verbose", action="store_true", default=False)
+    args = ap.parse_args()
+
+    import torch
+    from torch.utils.cpp_extension import include_paths, library_paths
+
+    src_dir = Path(args.src_dir).resolve()
+    out_dir = Path(args.out_dir).resolve()
+    out_dir.mkdir(parents=True, exist_ok=True)
+    build_dir = out_dir / "obj"
+    build_dir.mkdir(parents=True, exist_ok=True)
+
+    arches = parse_arch_flags(args.arch_list, args.ptx)
+
+    inc_flags = [f"-I{p}" for p in include_paths(device_type="cuda")] + [
+        f"-I{src_dir}"
+    ]
+    py_inc = subprocess.check_output(
+        [
+            sys.executable,
+            "-c",
+            "import sysconfig; print(sysconfig.get_path(\"include\"))",
+        ],
+        text=True,
+    ).strip()
+    inc_flags.append(f"-I{py_inc}")
+    lib_flags = [f"-L{p}" for p in library_paths(device_type="cuda")]
+    abi_val = int(
+        os.environ.get("TORCH_CXX11_ABI", int(torch._C._GLIBCXX_USE_CXX11_ABI))
+    )
+    abi_flag = f"-D_GLIBCXX_USE_CXX11_ABI={abi_val}"
+
+    cu_obj = build_dir / "glue_k31.o"
+    cpp_obj = build_dir / "glue_module.o"
+    so_out = out_dir / "_k31_glue_C.abi3.so"
+
+    # Strict IEEE FP32 (no --use_fast_math) for exact RMSNorm/softmax/sigmoid/KDA decay.
+    nvcc_cmd = [
+        "nvcc",
+        "-O3",
+        "--expt-relaxed-constexpr",
+        "-std=c++20",
+        "-Xcompiler",
+        "-fPIC",
+        abi_flag,
+        "-DTORCH_EXTENSION_NAME=_k31_glue_C",
+        *arches,
+        *inc_flags,
+        *(["--ptxas-options=-v"] if args.ptxas_verbose else []),
+        "-c",
+        str(src_dir / "glue_k31.cu"),
+        "-o",
+        str(cu_obj),
+    ]
+    cxx_cmd = [
+        "g++",
+        "-O3",
+        "-std=c++20",
+        "-fPIC",
+        abi_flag,
+        "-DTORCH_EXTENSION_NAME=_k31_glue_C",
+        *inc_flags,
+        "-c",
+        str(src_dir / "glue_module.cpp"),
+        "-o",
+        str(cpp_obj),
+    ]
+    link_cmd = [
+        "g++",
+        "-shared",
+        "-fPIC",
+        str(cu_obj),
+        str(cpp_obj),
+        *lib_flags,
+        "-lc10",
+        "-lc10_cuda",
+        "-ltorch",
+        "-ltorch_cpu",
+        "-ltorch_cuda",
+        "-lcudart",
+        "-o",
+        str(so_out),
+    ]
+    print("Building _k31_glue_C.abi3.so with arches:", arches, flush=True)
+    for cmd in (nvcc_cmd, cxx_cmd, link_cmd):
+        subprocess.run(cmd, check=True)
+    print(f"Built {so_out} ({so_out.stat().st_size / 1e6:.2f} MB)", flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/csrc/k31_glue/glue_k31.cu b/csrc/k31_glue/glue_k31.cu
new file mode 100644
index 0000000000..38e223aada
--- /dev/null
+++ b/csrc/k31_glue/glue_k31.cu
@@ -0,0 +1,4087 @@
+#include "glue_k31.h"
+
+#include <ATen/ATen.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <c10/util/Exception.h>
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+
+#include <cmath>
+#include <cstdint>
+
+namespace k31_glue {
+namespace {
+
+constexpr int kWarpSize = 32;
+constexpr uint32_t kFullMask = 0xffffffffu;
+constexpr int kRouterHeaderFloats = 32;  // 128 B cacheline-aligned counter header
+constexpr int kMaxRouterExperts = 1024;
+constexpr int kMaxAttnResBlocks = 8;
+
+struct alignas(16) Bf16x8 {
+  __nv_bfloat162 h[4];
+};
+
+__device__ __forceinline__ float bf16_to_f32(__nv_bfloat16 x) {
+  return __bfloat162float(x);
+}
+
+__device__ __forceinline__ __nv_bfloat16 f32_to_bf16(float x) {
+  return __float2bfloat16(x);
+}
+
+__device__ __forceinline__ float sigmoid_f32(float x) {
+  return 1.0f / (1.0f + expf(-x));
+}
+
+__device__ __forceinline__ float silu_f32(float x) {
+  return x / (1.0f + expf(-x));
+}
+
+__device__ __forceinline__ float warp_sum_f32(float v) {
+  // Fixed butterfly order for bitwise determinism.
+  v += __shfl_xor_sync(kFullMask, v, 16);
+  v += __shfl_xor_sync(kFullMask, v, 8);
+  v += __shfl_xor_sync(kFullMask, v, 4);
+  v += __shfl_xor_sync(kFullMask, v, 2);
+  v += __shfl_xor_sync(kFullMask, v, 1);
+  return v;
+}
+
+__device__ __forceinline__ void unpack_bf16x8(const uint4& raw, float out[8]) {
+  Bf16x8 u;
+  *reinterpret_cast<uint4*>(&u) = raw;
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    float2 f = __bfloat1622float2(u.h[i]);
+    out[2 * i] = f.x;
+    out[2 * i + 1] = f.y;
+  }
+}
+
+__device__ __forceinline__ uint4 pack_bf16x8(const float in[8]) {
+  Bf16x8 u;
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    u.h[i] = __float22bfloat162_rn(make_float2(in[2 * i], in[2 * i + 1]));
+  }
+  return *reinterpret_cast<uint4*>(&u);
+}
+
+__device__ __forceinline__ float load_f32_or_bf16(const void* ptr, int64_t idx, bool is_fp32) {
+  if (is_fp32) {
+    return reinterpret_cast<const float*>(ptr)[idx];
+  }
+  return __bfloat162float(reinterpret_cast<const __nv_bfloat16*>(ptr)[idx]);
+}
+
+__device__ __forceinline__ void st_global_cs_f4(float* ptr, const float4& v) {
+  __stcs(reinterpret_cast<float4*>(ptr), v);
+}
+
+__device__ __forceinline__ void st_global_cg_bf16(__nv_bfloat16* ptr, __nv_bfloat16 v) {
+  __stcg(reinterpret_cast<unsigned short*>(ptr), __bfloat16_as_ushort(v));
+}
+
+__device__ __forceinline__ __nv_bfloat16 ld_global_cg_bf16(const __nv_bfloat16* ptr) {
+  return __ushort_as_bfloat16(__ldcg(reinterpret_cast<const unsigned short*>(ptr)));
+}
+
+__device__ __forceinline__ int64_t load_index_i32_or_i64(const void* ptr, int64_t idx, bool is_i64) {
+  return is_i64 ? reinterpret_cast<const int64_t*>(ptr)[idx]
+                : static_cast<int64_t>(reinterpret_cast<const int32_t*>(ptr)[idx]);
+}
+
+// ============================================================================
+// 1. Fused AttnRes + RMSNorm (Kimi-K3.1 H=7168 specialized + generic H%8==0)
+// ============================================================================
+
+// Specialized H = 7168: 448 threads (14 warps), each thread owns exactly 2 uint4
+// vectors (16 BF16 elements -> 448 * 16 = 7168). Zero bounds checks, < 512 B SMEM,
+// ~52 regs/thread (zero local-memory spills). On sm_80 with 0 SMEM carveout,
+// 164 KB L1 keeps all 8 historical blocks (112 KB) hot between Pass 1 and Pass 2.
+template <bool HAS_DELTA, bool HAS_DELTA2, bool WRITE_BLOCK, bool APPLY_OUT_NORM>
+__global__ void __launch_bounds__(448, 2) k31_attn_res_7168_kernel(
+    __nv_bfloat16* __restrict__ prefix_ptr,
+    const __nv_bfloat16* __restrict__ delta_ptr,
+    const __nv_bfloat16* __restrict__ delta2_ptr,
+    __nv_bfloat16* __restrict__ blocks_ptr,
+    const __nv_bfloat16* __restrict__ norm_w_ptr,
+    const __nv_bfloat16* __restrict__ qk_w_ptr,
+    const __nv_bfloat16* __restrict__ out_norm_w_ptr,
+    __nv_bfloat16* __restrict__ out_ptr,
+    int64_t stride_prefix_m,
+    int64_t stride_delta_m,
+    int64_t stride_delta2_m,
+    int64_t stride_block_m,
+    int64_t stride_block_r,
+    int64_t stride_out_m,
+    int num_blocks,
+    int block_write_idx,
+    float eps,
+    float out_norm_eps) {
+  constexpr int kWarps = 14;
+  constexpr int kH = 7168;
+  constexpr float kInvH = 1.0f / static_cast<float>(kH);
+
+  const int row = blockIdx.x;
+  const int tid = threadIdx.x;
+  const int warp = tid >> 5;
+  const int lane = tid & 31;
+
+  // Each thread handles vec0 = tid and vec1 = tid + 448 (each uint4 = 8 BF16).
+  const int v0 = tid;
+  const int v1 = tid + 448;
+
+  __shared__ float s_sq[kWarps][kMaxAttnResBlocks + 1];
+  __shared__ float s_dot[kWarps][kMaxAttnResBlocks + 1];
+  __shared__ float s_logits[kMaxAttnResBlocks + 1];
+  __shared__ float s_probs[kMaxAttnResBlocks + 1];
+
+  uint4* pref_v = reinterpret_cast<uint4*>(prefix_ptr + static_cast<int64_t>(row) * stride_prefix_m);
+  uint4 p0 = pref_v[v0];
+  uint4 p1 = pref_v[v1];
+
+  float upd0[8], upd1[8];
+  unpack_bf16x8(p0, upd0);
+  unpack_bf16x8(p1, upd1);
+
+  uint4 upd_raw0 = p0;
+  uint4 upd_raw1 = p1;
+
+  if constexpr (HAS_DELTA) {
+    const uint4* del_v =
+        reinterpret_cast<const uint4*>(delta_ptr + static_cast<int64_t>(row) * stride_delta_m);
+    float d0[8], d1[8];
+    unpack_bf16x8(del_v[v0], d0);
+    unpack_bf16x8(del_v[v1], d1);
+
+    if constexpr (HAS_DELTA2) {
+      const uint4* del2_v =
+          reinterpret_cast<const uint4*>(delta2_ptr + static_cast<int64_t>(row) * stride_delta2_m);
+      float d2_0[8], d2_1[8];
+      unpack_bf16x8(del2_v[v0], d2_0);
+      unpack_bf16x8(del2_v[v1], d2_1);
+#pragma unroll
+      for (int i = 0; i < 8; ++i) {
+        // Match bf16(delta + delta2) before adding to prefix for bit-exact parity.
+        d0[i] = bf16_to_f32(f32_to_bf16(d0[i] + d2_0[i]));
+        d1[i] = bf16_to_f32(f32_to_bf16(d1[i] + d2_1[i]));
+      }
+    }
+
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+      upd0[i] += d0[i];
+      upd1[i] += d1[i];
+    }
+    // Match Triton attn_res BF16 round-before-use contract.
+    upd_raw0 = pack_bf16x8(upd0);
+    upd_raw1 = pack_bf16x8(upd1);
+    pref_v[v0] = upd_raw0;
+    pref_v[v1] = upd_raw1;
+    unpack_bf16x8(upd_raw0, upd0);
+    unpack_bf16x8(upd_raw1, upd1);
+  }
+
+  if constexpr (WRITE_BLOCK) {
+    uint4* blk_dst = reinterpret_cast<uint4*>(
+        blocks_ptr + static_cast<int64_t>(row) * stride_block_m +
+        static_cast<int64_t>(block_write_idx) * stride_block_r);
+    blk_dst[v0] = upd_raw0;
+    blk_dst[v1] = upd_raw1;
+  }
+
+  float mix0[8], mix1[8];
+
+  if (num_blocks == 0) {
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+      mix0[i] = upd0[i];
+      mix1[i] = upd1[i];
+    }
+  } else {
+    const uint4* nw_v = reinterpret_cast<const uint4*>(norm_w_ptr);
+    const uint4* qk_v = reinterpret_cast<const uint4*>(qk_w_ptr);
+    float nw0[8], nw1[8], qk0[8], qk1[8];
+    unpack_bf16x8(__ldg(&nw_v[v0]), nw0);
+    unpack_bf16x8(__ldg(&nw_v[v1]), nw1);
+    unpack_bf16x8(__ldg(&qk_v[v0]), qk0);
+    unpack_bf16x8(__ldg(&qk_v[v1]), qk1);
+    float w0[8], w1[8];
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+      w0[i] = nw0[i] * qk0[i];
+      w1[i] = nw1[i] * qk1[i];
+    }
+
+    // Pass 1: score all historical blocks + register-resident prefix with ONE barrier total!
+    for (int s = 0; s < num_blocks; ++s) {
+      const uint4* blk_v = reinterpret_cast<const uint4*>(
+          blocks_ptr + static_cast<int64_t>(row) * stride_block_m +
+          static_cast<int64_t>(s) * stride_block_r);
+      float x0[8], x1[8];
+      unpack_bf16x8(blk_v[v0], x0);
+      unpack_bf16x8(blk_v[v1], x1);
+
+      float sq = 0.0f;
+      float dt = 0.0f;
+#pragma unroll
+      for (int i = 0; i < 8; ++i) {
+        sq = fmaf(x0[i], x0[i], sq);
+        sq = fmaf(x1[i], x1[i], sq);
+        dt = fmaf(x0[i], w0[i], dt);
+        dt = fmaf(x1[i], w1[i], dt);
+      }
+      sq = warp_sum_f32(sq);
+      dt = warp_sum_f32(dt);
+      if (lane == 0) {
+        s_sq[warp][s] = sq;
+        s_dot[warp][s] = dt;
+      }
+    }
+
+    // Updated prefix directly from registers (zero global reload).
+    {
+      float sq = 0.0f;
+      float dt = 0.0f;
+#pragma unroll
+      for (int i = 0; i < 8; ++i) {
+        sq = fmaf(upd0[i], upd0[i], sq);
+        sq = fmaf(upd1[i], upd1[i], sq);
+        dt = fmaf(upd0[i], w0[i], dt);
+        dt = fmaf(upd1[i], w1[i], dt);
+      }
+      sq = warp_sum_f32(sq);
+      dt = warp_sum_f32(dt);
+      if (lane == 0) {
+        s_sq[warp][num_blocks] = sq;
+        s_dot[warp][num_blocks] = dt;
+      }
+    }
+
+    __syncthreads();
+    if (tid == 0) {
+      const int n_src = num_blocks + 1;
+      for (int s = 0; s < n_src; ++s) {
+        float tot_sq = 0.0f;
+        float tot_dt = 0.0f;
+#pragma unroll
+        for (int k = 0; k < kWarps; ++k) {
+          tot_sq += s_sq[k][s];
+          tot_dt += s_dot[k][s];
+        }
+        s_logits[s] = tot_dt * rsqrtf(tot_sq * kInvH + eps);
+      }
+      float max_l = s_logits[0];
+      for (int s = 1; s < n_src; ++s) {
+        max_l = fmaxf(max_l, s_logits[s]);
+      }
+      float denom = 0.0f;
+      for (int s = 0; s < n_src; ++s) {
+        float p = expf(s_logits[s] - max_l);
+        s_probs[s] = p;
+        denom += p;
+      }
+      float inv_denom = 1.0f / denom;
+      for (int s = 0; s < n_src; ++s) {
+        s_probs[s] *= inv_denom;
+      }
+    }
+    __syncthreads();
+
+    // Pass 2: weighted mix (blocks stay hot in SM80 L1 cache).
+    const float p_pref = s_probs[num_blocks];
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+      mix0[i] = p_pref * upd0[i];
+      mix1[i] = p_pref * upd1[i];
+    }
+    for (int s = 0; s < num_blocks; ++s) {
+      const float p_s = s_probs[s];
+      const uint4* blk_v = reinterpret_cast<const uint4*>(
+          blocks_ptr + static_cast<int64_t>(row) * stride_block_m +
+          static_cast<int64_t>(s) * stride_block_r);
+      float x0[8], x1[8];
+      unpack_bf16x8(blk_v[v0], x0);
+      unpack_bf16x8(blk_v[v1], x1);
+#pragma unroll
+      for (int i = 0; i < 8; ++i) {
+        mix0[i] = fmaf(p_s, x0[i], mix0[i]);
+        mix1[i] = fmaf(p_s, x1[i], mix1[i]);
+      }
+    }
+  }
+
+  uint4* out_v = reinterpret_cast<uint4*>(out_ptr + static_cast<int64_t>(row) * stride_out_m);
+  if constexpr (APPLY_OUT_NORM) {
+    float sq = 0.0f;
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+      sq = fmaf(mix0[i], mix0[i], sq);
+      sq = fmaf(mix1[i], mix1[i], sq);
+    }
+    sq = warp_sum_f32(sq);
+    if (lane == 0) {
+      s_sq[warp][0] = sq;
+    }
+    __syncthreads();
+    if (tid == 0) {
+      float tot_sq = 0.0f;
+#pragma unroll
+      for (int k = 0; k < kWarps; ++k) {
+        tot_sq += s_sq[k][0];
+      }
+      s_sq[0][0] = rsqrtf(tot_sq * kInvH + out_norm_eps);
+    }
+    __syncthreads();
+    const float inv_rms = s_sq[0][0];
+    const uint4* ow_v = reinterpret_cast<const uint4*>(out_norm_w_ptr);
+    float ow0[8], ow1[8];
+    unpack_bf16x8(__ldg(&ow_v[v0]), ow0);
+    unpack_bf16x8(__ldg(&ow_v[v1]), ow1);
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+      mix0[i] = mix0[i] * inv_rms * ow0[i];
+      mix1[i] = mix1[i] * inv_rms * ow1[i];
+    }
+  }
+  out_v[v0] = pack_bf16x8(mix0);
+  out_v[v1] = pack_bf16x8(mix1);
+}
+
+// Generic H % 8 == 0 fallback (256 threads = 8 warps).
+template <bool HAS_DELTA, bool HAS_DELTA2, bool WRITE_BLOCK, bool APPLY_OUT_NORM>
+__global__ void k31_attn_res_generic_kernel(
+    __nv_bfloat16* __restrict__ prefix_ptr,
+    const __nv_bfloat16* __restrict__ delta_ptr,
+    const __nv_bfloat16* __restrict__ delta2_ptr,
+    __nv_bfloat16* __restrict__ blocks_ptr,
+    const __nv_bfloat16* __restrict__ norm_w_ptr,
+    const __nv_bfloat16* __restrict__ qk_w_ptr,
+    const __nv_bfloat16* __restrict__ out_norm_w_ptr,
+    __nv_bfloat16* __restrict__ out_ptr,
+    int64_t stride_prefix_m,
+    int64_t stride_delta_m,
+    int64_t stride_delta2_m,
+    int64_t stride_block_m,
+    int64_t stride_block_r,
+    int64_t stride_out_m,
+    int hidden_size,
+    int num_blocks,
+    int block_write_idx,
+    float eps,
+    float out_norm_eps) {
+  constexpr int kWarps = 8;
+  const int row = blockIdx.x;
+  const int tid = threadIdx.x;
+  const int warp = tid >> 5;
+  const int lane = tid & 31;
+  const int n_vec = hidden_size >> 3;
+  const float inv_h = 1.0f / static_cast<float>(hidden_size);
+
+  __shared__ float s_sq[kWarps];
+  __shared__ float s_dot[kWarps];
+  __shared__ float s_logits[kMaxAttnResBlocks + 1];
+  __shared__ float s_probs[kMaxAttnResBlocks + 1];
+
+  uint4* pref_v = reinterpret_cast<uint4*>(prefix_ptr + static_cast<int64_t>(row) * stride_prefix_m);
+
+  // Update prefix and optionally write block.
+  if constexpr (HAS_DELTA || WRITE_BLOCK) {
+    for (int v = tid; v < n_vec; v += blockDim.x) {
+      uint4 raw = pref_v[v];
+      if constexpr (HAS_DELTA) {
+        const uint4* del_v =
+            reinterpret_cast<const uint4*>(delta_ptr + static_cast<int64_t>(row) * stride_delta_m);
+        float p[8], d[8];
+        unpack_bf16x8(raw, p);
+        unpack_bf16x8(del_v[v], d);
+        if constexpr (HAS_DELTA2) {
+          const uint4* del2_v = reinterpret_cast<const uint4*>(
+              delta2_ptr + static_cast<int64_t>(row) * stride_delta2_m);
+          float d2[8];
+          unpack_bf16x8(del2_v[v], d2);
+#pragma unroll
+          for (int i = 0; i < 8; ++i) {
+            d[i] = bf16_to_f32(f32_to_bf16(d[i] + d2[i]));
+          }
+        }
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+          p[i] += d[i];
+        }
+        raw = pack_bf16x8(p);
+        pref_v[v] = raw;
+      }
+      if constexpr (WRITE_BLOCK) {
+        uint4* blk_dst = reinterpret_cast<uint4*>(
+            blocks_ptr + static_cast<int64_t>(row) * stride_block_m +
+            static_cast<int64_t>(block_write_idx) * stride_block_r);
+        blk_dst[v] = raw;
+      }
+    }
+    __syncthreads();
+  }
+
+  if (num_blocks > 0) {
+    const uint4* nw_v = reinterpret_cast<const uint4*>(norm_w_ptr);
+    const uint4* qk_v = reinterpret_cast<const uint4*>(qk_w_ptr);
+    const int n_src = num_blocks + 1;
+    for (int s = 0; s < n_src; ++s) {
+      const uint4* src_v = (s == num_blocks)
+                               ? pref_v
+                               : reinterpret_cast<const uint4*>(
+                                     blocks_ptr + static_cast<int64_t>(row) * stride_block_m +
+                                     static_cast<int64_t>(s) * stride_block_r);
+      float sq = 0.0f;
+      float dt = 0.0f;
+      for (int v = tid; v < n_vec; v += blockDim.x) {
+        float x[8], nw[8], qk[8];
+        unpack_bf16x8(src_v[v], x);
+        unpack_bf16x8(__ldg(&nw_v[v]), nw);
+        unpack_bf16x8(__ldg(&qk_v[v]), qk);
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+          sq = fmaf(x[i], x[i], sq);
+          dt = fmaf(x[i], nw[i] * qk[i], dt);
+        }
+      }
+      sq = warp_sum_f32(sq);
+      dt = warp_sum_f32(dt);
+      if (lane == 0) {
+        s_sq[warp] = sq;
+        s_dot[warp] = dt;
+      }
+      __syncthreads();
+      if (tid == 0) {
+        float tot_sq = 0.0f, tot_dt = 0.0f;
+#pragma unroll
+        for (int k = 0; k < kWarps; ++k) {
+          tot_sq += s_sq[k];
+          tot_dt += s_dot[k];
+        }
+        s_logits[s] = tot_dt * rsqrtf(tot_sq * inv_h + eps);
+      }
+      __syncthreads();
+    }
+    if (tid == 0) {
+      float max_l = s_logits[0];
+      for (int s = 1; s < n_src; ++s) {
+        max_l = fmaxf(max_l, s_logits[s]);
+      }
+      float denom = 0.0f;
+      for (int s = 0; s < n_src; ++s) {
+        float p = expf(s_logits[s] - max_l);
+        s_probs[s] = p;
+        denom += p;
+      }
+      float inv_denom = 1.0f / denom;
+      for (int s = 0; s < n_src; ++s) {
+        s_probs[s] *= inv_denom;
+      }
+    }
+    __syncthreads();
+  }
+
+  uint4* out_v = reinterpret_cast<uint4*>(out_ptr + static_cast<int64_t>(row) * stride_out_m);
+  if constexpr (APPLY_OUT_NORM) {
+    // Pass 2a: compute output variance of mixed vector.
+    float sq = 0.0f;
+    for (int v = tid; v < n_vec; v += blockDim.x) {
+      float mix[8];
+      if (num_blocks == 0) {
+        unpack_bf16x8(pref_v[v], mix);
+      } else {
+        float p_pref = s_probs[num_blocks];
+        unpack_bf16x8(pref_v[v], mix);
+#pragma unroll
+        for (int i = 0; i < 8; ++i) mix[i] *= p_pref;
+        for (int s = 0; s < num_blocks; ++s) {
+          float p_s = s_probs[s];
+          const uint4* blk_v = reinterpret_cast<const uint4*>(
+              blocks_ptr + static_cast<int64_t>(row) * stride_block_m +
+              static_cast<int64_t>(s) * stride_block_r);
+          float x[8];
+          unpack_bf16x8(blk_v[v], x);
+#pragma unroll
+          for (int i = 0; i < 8; ++i) mix[i] = fmaf(p_s, x[i], mix[i]);
+        }
+      }
+#pragma unroll
+      for (int i = 0; i < 8; ++i) sq = fmaf(mix[i], mix[i], sq);
+    }
+    sq = warp_sum_f32(sq);
+    if (lane == 0) s_sq[warp] = sq;
+    __syncthreads();
+    if (tid == 0) {
+      float tot_sq = 0.0f;
+#pragma unroll
+      for (int k = 0; k < kWarps; ++k) tot_sq += s_sq[k];
+      s_sq[0] = rsqrtf(tot_sq * inv_h + out_norm_eps);
+    }
+    __syncthreads();
+    const float inv_rms = s_sq[0];
+    const uint4* ow_v = reinterpret_cast<const uint4*>(out_norm_w_ptr);
+    for (int v = tid; v < n_vec; v += blockDim.x) {
+      float mix[8], ow[8];
+      if (num_blocks == 0) {
+        unpack_bf16x8(pref_v[v], mix);
+      } else {
+        float p_pref = s_probs[num_blocks];
+        unpack_bf16x8(pref_v[v], mix);
+#pragma unroll
+        for (int i = 0; i < 8; ++i) mix[i] *= p_pref;
+        for (int s = 0; s < num_blocks; ++s) {
+          float p_s = s_probs[s];
+          const uint4* blk_v = reinterpret_cast<const uint4*>(
+              blocks_ptr + static_cast<int64_t>(row) * stride_block_m +
+              static_cast<int64_t>(s) * stride_block_r);
+          float x[8];
+          unpack_bf16x8(blk_v[v], x);
+#pragma unroll
+          for (int i = 0; i < 8; ++i) mix[i] = fmaf(p_s, x[i], mix[i]);
+        }
+      }
+      unpack_bf16x8(__ldg(&ow_v[v]), ow);
+#pragma unroll
+      for (int i = 0; i < 8; ++i) mix[i] = mix[i] * inv_rms * ow[i];
+      out_v[v] = pack_bf16x8(mix);
+    }
+  } else {
+    for (int v = tid; v < n_vec; v += blockDim.x) {
+      float mix[8];
+      if (num_blocks == 0) {
+        unpack_bf16x8(pref_v[v], mix);
+      } else {
+        float p_pref = s_probs[num_blocks];
+        unpack_bf16x8(pref_v[v], mix);
+#pragma unroll
+        for (int i = 0; i < 8; ++i) mix[i] *= p_pref;
+        for (int s = 0; s < num_blocks; ++s) {
+          float p_s = s_probs[s];
+          const uint4* blk_v = reinterpret_cast<const uint4*>(
+              blocks_ptr + static_cast<int64_t>(row) * stride_block_m +
+              static_cast<int64_t>(s) * stride_block_r);
+          float x[8];
+          unpack_bf16x8(blk_v[v], x);
+#pragma unroll
+          for (int i = 0; i < 8; ++i) mix[i] = fmaf(p_s, x[i], mix[i]);
+        }
+      }
+      out_v[v] = pack_bf16x8(mix);
+    }
+  }
+}
+
+template <bool HD, bool HD2, bool WB, bool AON>
+void launch_attn_res_impl(
+    __nv_bfloat16* prefix_ptr,
+    const __nv_bfloat16* delta_ptr,
+    const __nv_bfloat16* delta2_ptr,
+    __nv_bfloat16* blocks_ptr,
+    const __nv_bfloat16* norm_w_ptr,
+    const __nv_bfloat16* qk_w_ptr,
+    const __nv_bfloat16* out_norm_w_ptr,
+    __nv_bfloat16* out_ptr,
+    int num_tokens,
+    int hidden_size,
+    int64_t sp,
+    int64_t sd,
+    int64_t sd2,
+    int64_t sbm,
+    int64_t sbr,
+    int64_t so,
+    int num_blocks,
+    int block_write_idx,
+    float eps,
+    float out_norm_eps,
+    cudaStream_t stream) {
+  if (hidden_size == 7168) {
+    // Prefer L1 cache over SMEM so all 8 blocks (112 KB) stay L1-resident on sm_80.
+    static bool carveout_set = false;
+    if (!carveout_set) {
+      cudaFuncSetAttribute(
+          k31_attn_res_7168_kernel<HD, HD2, WB, AON>,
+          cudaFuncAttributePreferredSharedMemoryCarveout,
+          0);
+      carveout_set = true;
+    }
+    k31_attn_res_7168_kernel<HD, HD2, WB, AON><<<num_tokens, 448, 0, stream>>>(
+        prefix_ptr, delta_ptr, delta2_ptr, blocks_ptr,
+        norm_w_ptr, qk_w_ptr, out_norm_w_ptr, out_ptr,
+        sp, sd, sd2, sbm, sbr, so,
+        num_blocks, block_write_idx, eps, out_norm_eps);
+  } else {
+    k31_attn_res_generic_kernel<HD, HD2, WB, AON><<<num_tokens, 256, 0, stream>>>(
+        prefix_ptr, delta_ptr, delta2_ptr, blocks_ptr,
+        norm_w_ptr, qk_w_ptr, out_norm_w_ptr, out_ptr,
+        sp, sd, sd2, sbm, sbr, so, hidden_size,
+        num_blocks, block_write_idx, eps, out_norm_eps);
+  }
+}
+
+// ============================================================================
+// 2. Fused MoE Router GEMV + Sigmoid + Bias + Deterministic Top-K (1 Launch)
+// ============================================================================
+
+constexpr int kRouterSentinelId = 0x7fffffff;
+
+__device__ __forceinline__ bool better_score(float av, int ai, float bv, int bi) {
+  // Real expert indices (< kRouterSentinelId) always beat exhausted/padding sentinels,
+  // even when a real expert has score -inf (e.g. sanitized NaN).
+  if (ai == kRouterSentinelId) return false;
+  if (bi == kRouterSentinelId) return true;
+  return (av > bv) || (av == bv && ai < bi);
+}
+
+__device__ __forceinline__ void warp_cmp_swap(
+    float& v, int& id, int lane, int mask, bool dir_desc) {
+  float ov = __shfl_xor_sync(kFullMask, v, mask);
+  int oi = __shfl_xor_sync(kFullMask, id, mask);
+  bool is_hi = (lane & mask) != 0;
+  bool want_better = (is_hi != dir_desc);
+  bool take_other = want_better ? better_score(ov, oi, v, id)
+                                : better_score(v, id, ov, oi);
+  if (take_other) {
+    v = ov;
+    id = oi;
+  }
+}
+
+// Full 32-lane Batcher bitonic sort descending (smaller expert index wins ties).
+__device__ __forceinline__ void warp_bitonic_sort32_desc(float& v, int& id, int lane) {
+  warp_cmp_swap(v, id, lane, 1, (lane & 2) == 0);
+  warp_cmp_swap(v, id, lane, 2, (lane & 4) == 0);
+  warp_cmp_swap(v, id, lane, 1, (lane & 4) == 0);
+  warp_cmp_swap(v, id, lane, 4, (lane & 8) == 0);
+  warp_cmp_swap(v, id, lane, 2, (lane & 8) == 0);
+  warp_cmp_swap(v, id, lane, 1, (lane & 8) == 0);
+  warp_cmp_swap(v, id, lane, 8, (lane & 16) == 0);
+  warp_cmp_swap(v, id, lane, 4, (lane & 16) == 0);
+  warp_cmp_swap(v, id, lane, 2, (lane & 16) == 0);
+  warp_cmp_swap(v, id, lane, 1, (lane & 16) == 0);
+  warp_cmp_swap(v, id, lane, 16, true);
+  warp_cmp_swap(v, id, lane, 8, true);
+  warp_cmp_swap(v, id, lane, 4, true);
+  warp_cmp_swap(v, id, lane, 2, true);
+  warp_cmp_swap(v, id, lane, 1, true);
+}
+
+struct BlockTopkSmem {
+  int hist[256];       // 1024 B
+  float cand_v[32];    // 128 B
+  int cand_i[32];      // 128 B
+  float wmax[8];       // 32 B
+  float wmin[8];       // 32 B
+  int widx[8];         // 32 B
+  int b_cut;
+  int cand_cnt;
+  int use_fast;
+  float min_v;
+  float inv_span;
+  int picked_id[32];   // 128 B
+  float picked_w[32];  // 128 B
+};
+
+// Cooperative 256-thread (8-warp) exact deterministic Top-K over E <= 1024.
+// Holds all <= 4 elements/thread in registers, uses 256-bin histogram filter (4 syncs)
+// + single 32-lane bitonic sort on the <= 32 survivors, with exact register fallback.
+// kFromWs=true: reads precomputed biased/sig from L2-coherent workspace (__ldcg).
+// kFromWs=false: computes sigmoid(logits) + bias on the fly (__ldg).
+template <bool kFromWs>
+__device__ __forceinline__ void block256_topk_exact(
+    BlockTopkSmem& st,
+    const float* __restrict__ primary_row,
+    const float* __restrict__ secondary_row,
+    int E,
+    int top_k,
+    bool renormalize,
+    float routed_scale,
+    float* __restrict__ out_weights,
+    int32_t* __restrict__ out_ids) {
+  const float kNegInf = -__int_as_float(0x7f800000);
+  const float kPosInf = __int_as_float(0x7f800000);
+  const int tid = threadIdx.x;
+  const int warp = tid >> 5;
+  const int lane = tid & 31;
+
+  float rv[4];
+  int ri[4];
+  float lmax = kNegInf;
+  float lmin = kPosInf;
+
+#pragma unroll
+  for (int j = 0; j < 4; ++j) {
+    const int e = tid + j * 256;
+    if (e < E) {
+      float v;
+      if constexpr (kFromWs) {
+        v = __ldcg(&primary_row[e]);
+      } else {
+        v = sigmoid_f32(__ldg(&primary_row[e])) + __ldg(&secondary_row[e]);
+      }
+      if (isnan(v)) {
+        v = kNegInf;
+      }
+      rv[j] = v;
+      ri[j] = e;
+      if (v > lmax) lmax = v;
+      if (v < lmin) lmin = v;
+    } else {
+      rv[j] = kNegInf;
+      ri[j] = kRouterSentinelId;
+    }
+  }
+
+  // Warp + block min/max + zero histogram in parallel.
+  st.hist[tid] = 0;
+  float wm = lmax;
+  float wn = lmin;
+#pragma unroll
+  for (int offset = 16; offset > 0; offset >>= 1) {
+    wm = fmaxf(wm, __shfl_xor_sync(kFullMask, wm, offset));
+    wn = fminf(wn, __shfl_xor_sync(kFullMask, wn, offset));
+  }
+  if (lane == 0) {
+    st.wmax[warp] = wm;
+    st.wmin[warp] = wn;
+  }
+  __syncthreads();
+
+  if (tid == 0) {
+    float gmax = st.wmax[0];
+    float gmin = st.wmin[0];
+#pragma unroll
+    for (int w = 1; w < 8; ++w) {
+      gmax = fmaxf(gmax, st.wmax[w]);
+      gmin = fminf(gmin, st.wmin[w]);
+    }
+    float span = gmax - gmin;
+    bool span_ok = isfinite(gmax) && isfinite(gmin) && isfinite(span) && (span > 1e-12f);
+    st.min_v = gmin;
+    st.inv_span = span_ok ? (255.0f / span) : 0.0f;
+    st.cand_cnt = 0;
+    st.use_fast = span_ok ? 1 : 0;
+  }
+  __syncthreads();
+
+  if (st.use_fast) {
+    const float min_v = st.min_v;
+    const float inv_span = st.inv_span;
+    int rb[4];
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+      if (ri[j] < E) {
+        int b = __float2int_rd((rv[j] - min_v) * inv_span);
+        b = (b < 0) ? 0 : ((b > 255) ? 255 : b);
+        rb[j] = b;
+        atomicAdd(&st.hist[b], 1);
+      } else {
+        rb[j] = -1;
+      }
+    }
+    __syncthreads();
+
+    // Warp 0 finds exact descending cutoff bucket across 256 bins (8 bins/lane).
+    if (warp == 0) {
+      int sum8 = 0;
+      const int hi_base = 255 - lane * 8;
+#pragma unroll
+      for (int i = 0; i < 8; ++i) {
+        sum8 += st.hist[hi_base - i];
+      }
+      int pref = sum8;
+#pragma unroll
+      for (int off = 1; off < 32; off <<= 1) {
+        int n = __shfl_up_sync(kFullMask, pref, off);
+        if (lane >= off) pref += n;
+      }
+      unsigned ge_mask = __ballot_sync(kFullMask, pref >= top_k);
+      int win_lane = __ffs(ge_mask) - 1;
+      if (lane == win_lane) {
+        int acc = pref - sum8;
+        int cut = hi_base;
+        int tot = acc;
+        for (int i = 0; i < 8; ++i) {
+          int c = st.hist[hi_base - i];
+          tot += c;
+          if (tot >= top_k) {
+            cut = hi_base - i;
+            break;
+          }
+        }
+        st.b_cut = cut;
+        st.use_fast = (tot <= 32) ? 1 : 0;
+      }
+    }
+    __syncthreads();
+
+    if (st.use_fast) {
+      const int b_cut = st.b_cut;
+#pragma unroll
+      for (int j = 0; j < 4; ++j) {
+        if (rb[j] >= b_cut) {
+          int pos = atomicAdd(&st.cand_cnt, 1);
+          if (pos < 32) {
+            st.cand_v[pos] = rv[j];
+            st.cand_i[pos] = ri[j];
+          }
+        }
+      }
+      __syncthreads();
+
+      if (warp == 0) {
+        const int cnt = st.cand_cnt;
+        float v = (lane < cnt) ? st.cand_v[lane] : kNegInf;
+        int id = (lane < cnt) ? st.cand_i[lane] : kRouterSentinelId;
+        warp_bitonic_sort32_desc(v, id, lane);
+
+        const int safe_id = (id >= 0 && id < E) ? id : (id < 0 ? 0 : (E - 1));
+        float picked_w = 0.0f;
+        if (lane < top_k) {
+          if constexpr (kFromWs) {
+            picked_w = __ldcg(&secondary_row[safe_id]);
+          } else {
+            picked_w = sigmoid_f32(__ldg(&primary_row[safe_id]));
+          }
+        }
+        float w_sum = warp_sum_f32(picked_w);
+        if (lane < top_k) {
+          float w = renormalize ? ((w_sum > 0.0f) ? (picked_w / w_sum) : 0.0f) : picked_w;
+          out_weights[lane] = w * routed_scale;
+          out_ids[lane] = safe_id;
+        }
+      }
+      return;
+    }
+  }
+
+  // Exact register-only fallback (handles constant arrays or >32 values in cutoff bucket).
+  for (int k = 0; k < top_k; ++k) {
+    float mv = rv[0];
+    int mi = ri[0];
+#pragma unroll
+    for (int j = 1; j < 4; ++j) {
+      if (better_score(rv[j], ri[j], mv, mi)) {
+        mv = rv[j];
+        mi = ri[j];
+      }
+    }
+#pragma unroll
+    for (int offset = 16; offset > 0; offset >>= 1) {
+      float ov = __shfl_xor_sync(kFullMask, mv, offset);
+      int oi = __shfl_xor_sync(kFullMask, mi, offset);
+      if (better_score(ov, oi, mv, mi)) {
+        mv = ov;
+        mi = oi;
+      }
+    }
+    if (lane == 0) {
+      st.wmax[warp] = mv;
+      st.widx[warp] = mi;
+    }
+    __syncthreads();
+    if (tid == 0) {
+      float bv = st.wmax[0];
+      int bi = st.widx[0];
+#pragma unroll
+      for (int w = 1; w < 8; ++w) {
+        if (better_score(st.wmax[w], st.widx[w], bv, bi)) {
+          bv = st.wmax[w];
+          bi = st.widx[w];
+        }
+      }
+      const int safe_bi = (bi >= 0 && bi < E) ? bi : (bi < 0 ? 0 : (E - 1));
+      st.picked_id[k] = safe_bi;
+      if constexpr (kFromWs) {
+        st.picked_w[k] = __ldcg(&secondary_row[safe_bi]);
+      } else {
+        st.picked_w[k] = sigmoid_f32(__ldg(&primary_row[safe_bi]));
+      }
+      st.widx[0] = safe_bi;
+    }
+    __syncthreads();
+    const int win_id = st.widx[0];
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+      if (ri[j] == win_id) {
+        rv[j] = kNegInf;
+        ri[j] = kRouterSentinelId;
+      }
+    }
+  }
+
+  if (warp == 0) {
+    float pw = (lane < top_k) ? st.picked_w[lane] : 0.0f;
+    float w_sum = warp_sum_f32(pw);
+    if (lane < top_k) {
+      float w = renormalize ? ((w_sum > 0.0f) ? (pw / w_sum) : 0.0f) : pw;
+      out_weights[lane] = w * routed_scale;
+      out_ids[lane] = st.picked_id[lane];
+    }
+  }
+}
