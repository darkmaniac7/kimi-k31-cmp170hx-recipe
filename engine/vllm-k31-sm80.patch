+
+    # Low confidence for pos < 30 (prod < 0.5 -> tier 3, no PipeSpec),
+    # High confidence for pos >= 30 (prod = 0.98^5 = 0.90 >= 0.5 -> PipeSpec A/B!).
+    def conf_fn(pos):
