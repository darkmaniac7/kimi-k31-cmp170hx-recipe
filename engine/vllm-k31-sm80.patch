+def _save_canonical_dump(dump_dir: Path, dump: cmp_mod.PromptDump) -> None:
+    dump_dir.mkdir(parents=True, exist_ok=True)
+    payload = dict(dump.tensors)
+    if dump.prompt_token_ids is not None:
+        payload["prompt_token_ids"] = torch.tensor(dump.prompt_token_ids, dtype=torch.int32)
+    if dump.generated_ids is not None:
+        payload["generated_ids"] = torch.tensor(dump.generated_ids, dtype=torch.int32)
+    if dump.topk_ids is not None:
+        payload["topk_ids"] = torch.from_numpy(dump.topk_ids)
+    if dump.topk_logits is not None:
+        payload["topk_logits"] = torch.from_numpy(dump.topk_logits)
+    if dump.logsumexp is not None:
+        payload["logsumexp"] = torch.from_numpy(dump.logsumexp)
+
+    pid = dump.prompt_id
+    save_file(
+        payload,
+        str(dump_dir / f"{pid}.safetensors"),
+        metadata={"schema": cmp_mod.SCHEMA_VERSION, "engine": dump.engine, "prompt_id": pid},
+    )
+    (dump_dir / f"{pid}.meta.json").write_text(
+        json.dumps(
+            {
+                "schema": cmp_mod.SCHEMA_VERSION,
+                "engine": dump.engine,
+                "prompt_id": pid,
+                "prompt_token_ids": dump.prompt_token_ids,
+                "generated_ids": dump.generated_ids,
+                "generated_text": dump.generated_text,
+            },
+            indent=2,
+        )
+    )
+    (dump_dir / "manifest.json").write_text(
+        json.dumps({"schema": cmp_mod.SCHEMA_VERSION, "engine": dump.engine, "prompts": [pid]}, indent=2)
+    )
