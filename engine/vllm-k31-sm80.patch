+// ============================================================================
+// SM-Count-Driven Stream-K / Exact-Split Grid Selector (74/106/108/122/126/188 SMs)
+// ============================================================================
+int choose_fused_grid(int64_t padded_in, int64_t total_padded_out, int64_t rows, int sms, int64_t avail_partial_floats) {
+  const int64_t n_blk = total_padded_out / 128;
+  const int64_t halves_k = (padded_in / 128) * 2;
+  const int64_t W = n_blk * halves_k;
+
+  // Large-N regime (e.g., lm_head_TP2 with 640 blocks) or exceeds arrival table: zero splits!
+  if (n_blk >= 3LL * sms || n_blk > kMaxArrivalBlocks) {
+    return static_cast<int>(n_blk);
+  }
+
+  const int64_t max_slots = avail_partial_floats / (rows * 128);
+  const int64_t max_g_ws = max_slots - n_blk;
+  if (max_g_ws < sms) {
+    return static_cast<int>(n_blk);
+  }
+
+  // Small-matrix regime (W <= 3600, e.g. Latent down/up, Shared down on 106-188 SM GPUs):
+  // halving the split count at 1 CTA/SM cuts __threadfence() + partial_buf traffic while
+  // keeping >= 85% SM occupancy and exact_splits determinism across M = 1..16.
+  if (W <= 3600 && sms >= 96) {
+    const int64_t sp1 = static_cast<int64_t>(sms) / n_blk;
+    if (sp1 >= 1 && halves_k / sp1 >= 8) {
+      const int64_t g1 = sp1 * n_blk;
+      if (g1 * 100 >= static_cast<int64_t>(sms) * 85) {
+        int64_t G1 = std::min(g1, W);
+        G1 = std::min(G1, max_g_ws);
+        return static_cast<int>(G1 < 1 ? 1 : G1);
+      }
+    }
+  }
+
+  const int64_t target_g2 = 2LL * sms;
+  int64_t G = target_g2;
+
+  // Prefer exact-multiple split count at 2 CTAs/SM (ZERO boundary crossings -> 1 epilogue/CTA!)
+  // when SM fill meets threshold (and >= 4 half-bk per split so kw=4 has >= 4 K-tiles/warp):
+  //   - sp2 == 1 (zero split traffic at all): >= 80% fill
+  //   - sp2 >= 2, short/medium K (<= 6144, halves_k <= 96): >= 75% fill (avoids Stream-K boundary tax)
+  //   - sp2 >= 2, long K (> 6144): >= 85% fill (prioritizes SM balance over boundary cost)
+  // Otherwise use Stream-K G = 2 * sms for balanced SM occupancy with zero wave-tail imbalance.
+  const int64_t sp2 = target_g2 / n_blk;
+  if (sp2 >= 1 && halves_k / sp2 >= 4) {
+    const int64_t g2 = sp2 * n_blk;
+    const int64_t min_pct = (sp2 == 1) ? 80 : ((halves_k <= 96) ? 75 : 85);
+    if (g2 * 100 >= target_g2 * min_pct) {
+      G = g2;
+    }
+  }
+
+  G = std::min(G, W);
+  G = std::min(G, max_g_ws);
+  if (G < 1) G = 1;
+  return static_cast<int>(G);
+}
+
+template <int kBitsX2, int NT, typename OutT>
+void launch_fused_inst(
+    const MultiDecodeParams& p,
+    int* arrival_buf,
+    const uint2* act,
+    const float* sc,
+    float* partial_buf,
+    OutT* out,
+    cudaStream_t stream
+) {
+  constexpr int smem = k31_fused_smem_bytes<kBitsX2, NT>();
+  static_assert(smem <= 48 * 1024, "SMEM must stay <= 48 KB for sm_80 & sm_120 occupancy");
+  k31_decode_streamk_fused_kernel<kBitsX2, NT, OutT>
+      <<<static_cast<unsigned int>(p.grid_ctas), 32 * kFusedWarps, smem, stream>>>(
+          p, arrival_buf, act, sc, partial_buf, out);
+}
+
+template <int kBitsX2, typename OutT>
+void dispatch_fused_nt(
+    const MultiDecodeParams& p, int* arrival_buf, const uint2* act, const float* sc,
+    float* partial_buf, OutT* out, cudaStream_t stream) {
+  switch ((p.rows + 7) / 8) {
+    case 1: launch_fused_inst<kBitsX2, 1, OutT>(p, arrival_buf, act, sc, partial_buf, out, stream); break;
+    case 2: launch_fused_inst<kBitsX2, 2, OutT>(p, arrival_buf, act, sc, partial_buf, out, stream); break;
+    case 3: launch_fused_inst<kBitsX2, 3, OutT>(p, arrival_buf, act, sc, partial_buf, out, stream); break;
+    default: launch_fused_inst<kBitsX2, 4, OutT>(p, arrival_buf, act, sc, partial_buf, out, stream); break;
+  }
+}
+
+template <typename OutT>
+void launch_fused_all(
+    int bits_x2, const MultiDecodeParams& p, int* arrival_buf, const uint2* act, const float* sc,
+    float* partial_buf, OutT* out, cudaStream_t stream) {
+  switch (bits_x2) {
+    case 10: dispatch_fused_nt<10, OutT>(p, arrival_buf, act, sc, partial_buf, out, stream); break;
+    case 12: dispatch_fused_nt<12, OutT>(p, arrival_buf, act, sc, partial_buf, out, stream); break;
+    case 14: dispatch_fused_nt<14, OutT>(p, arrival_buf, act, sc, partial_buf, out, stream); break;
+    default: TORCH_CHECK(false, "dense_k31 supports bits_x2 in {10, 12, 14}");
+  }
+}
