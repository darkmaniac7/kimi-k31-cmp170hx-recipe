+      }
+    }
+  }
+  const __nv_bfloat162 b0 = __floats2bfloat162_rn(sx, sy);
+  out_bf16_v2[static_cast<int64_t>(row) * H_v2 + col_v2] = *reinterpret_cast<const uint32_t*>(&b0);
+}
