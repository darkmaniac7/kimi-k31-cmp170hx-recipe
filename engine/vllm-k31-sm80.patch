+def make_settings(root: str, *, commit: str = "0" * 40, checkpoint_dir: str | None = None,
+                  model_toml: str = MODEL_TOML) -> str:
+    write(os.path.join(root, "model.toml"), model_toml)
+    write(os.path.join(root, "hardware", "two-card.toml"), HARDWARE_TOML)
+    for name, text in LAYOUTS.items():
+        write(os.path.join(root, "layouts", f"{name}.toml"), text)
+    for name, text in VARIANTS.items():
+        write(os.path.join(root, "variants", f"{name}.toml"), text)
+    write(os.path.join(root, "pins.env"), PINS.format(commit=commit))
+    os.makedirs(os.path.join(root, "validated"), exist_ok=True)
+    if checkpoint_dir:
+        import checkpoint as ck
+        from model import load_model_settings
+        from settings_dir import SettingsDir
+        sd = SettingsDir(root)
+        ms = load_model_settings(sd)
+        pins = sd.pins()
+        m = ck.make_manifest(pins["TARGET_REPO"], pins["TARGET_REVISION"],
+                             ms.checkpoints["target"], checkpoint_dir)
+        write(os.path.join(root, "checkpoints", "synth-dense-1b.manifest.json"),
+              json.dumps(m, indent=1, sort_keys=True) + "\n")
