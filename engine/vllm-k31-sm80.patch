+
+// Pure CPU workspace size (in FP32 elements) for linear_out_k31_multi.
+// Returns decode-only size when max_rows <= 32 (no prefill dequant buffer reserved).
+// Includes per-workspace split-arrival counters (4096 ints = 16 KB, 128B aligned)
+// so concurrent streams with distinct workspaces are 100% isolated (zero device globals).
+int64_t linear_workspace_size_k31(
+    int64_t max_rows,
+    int64_t padded_in,
+    int64_t total_padded_out,
+    int64_t num_members);
+
+// Override reference SM count used by choose_fused_grid for EXL3 decode splits.
+//   ref_sms > 0 : pin split planning to ref_sms (bit-exact across unequal TP cards)
+//   ref_sms == 0: use current device's hardware SM count (default)
+//   ref_sms < 0 : clear cache and re-read VLLM_K31_DENSE_REF_SMS on next launch
+void set_ref_sms_k31(int64_t ref_sms);
+
+// Return active reference SM override (0 when using device hardware SM count).
+int64_t get_ref_sms_k31();
+
+// Fused multi-member EXL3 dense linear for K3.1 shapes on sm_80 (74-126 SMs) and sm_120 (Blackwell).
+//   - Works under any TP / PP layout (SM-count-driven or VLLM_K31_DENSE_REF_SMS-pinned plans,
+//     zero FP64, <= 48 KB SMEM, zero device-global mutable state).
+//   - Accepts 1 to 4 EXL3 members sharing input x (e.g. KDA q/k/v/g, Shared gate+up,
+//     Shared gate+up+Latent_down, MLA q_a+kv_a) and writes concatenated outputs directly into `out`.
+//   - Decode (rows <= 32): 2-launch fused pipeline (input H128 + arrival zeroing, then Stream-K/
+//     Exact-Split MMA with fused H128 + svh epilogue, per-workspace arrival counters, 100% CUDA
+//     Graph safe and concurrent-stream safe). Identical summation order across M = 1..16 (kKW=4);
+//     kKW switches 4 -> 2 at M = 17..32.
+//   - Prefill (rows > 32): H128(x*suh) -> tiled trellis core dequant (BF16) -> cuBLAS Tensor Core
+//     BF16 GEMM (FP32 reduction enforced) -> H128(Y)*svh directly into `out`.
+void linear_out_k31_multi(
+    const at::Tensor& x,
+    const std::vector<at::Tensor>& trellises,
+    const std::vector<at::Tensor>& suhs,
+    const std::vector<at::Tensor>& svhs,
+    const std::vector<int64_t>& bits_x2s,
+    const std::vector<int64_t>& logical_outs,
+    at::Tensor& out,
+    at::Tensor& workspace);
+
+// Bit-exact row-count-invariant BF16 plain linear (0-ULP identical across all M and row positions).
+//   - Fixed K-reduction tree depending ONLY on K (never M, N, or SM count), zero workspace,
+//     zero atomics, CUDA-Graph safe, <= 48 KB SMEM, zero FP64 (sm_80 + sm_120).
+//   - Supports arbitrary M >= 0, N >= 1, K >= 1, optional BF16/FP32 bias, BF16 or FP32 output.
+void linear_plain_invariant_k31(
+    const at::Tensor& x,
+    const at::Tensor& weight,
+    const c10::optional<at::Tensor>& bias_opt,
+    at::Tensor& out);
+
+// Multi-member fused variant (1..4 BF16 weights sharing x) producing 0-ULP identical bits
+// to calling linear_plain_invariant_k31 on each member separately or on their row-concatenation.
+void linear_plain_invariant_k31_multi(
+    const at::Tensor& x,
+    const std::vector<at::Tensor>& weights,
+    at::Tensor& out);
+
+}  // namespace k31_dense
