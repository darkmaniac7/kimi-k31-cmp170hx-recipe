+    with set_current_vllm_config(target_cfg):
+        target_lp = LogitsProcessor(vocab_size=128)
+        Exl3HeadLogitsProcessor.adopt(target_lp)
+    assert target_lp.head_dtype == torch.float32
+
+    with set_current_vllm_config(draft_cfg):
+        draft_lp = LogitsProcessor(vocab_size=128)
+        Exl3HeadLogitsProcessor.adopt(draft_lp)
+    assert draft_lp.head_dtype is None
+
+    script = """
+import json, os
+from types import SimpleNamespace
+import torch
+from vllm.config import set_current_vllm_config
+from vllm.model_executor.layers.logits_processor import LogitsProcessor
+from vllm.sm80.kernels.exl3.quant import Exl3HeadLogitsProcessor, Exl3LinearMethod
+from vllm.sm80.worker import target_argmax as ta
+
+os.environ["VLLM_K31_FP32_HEAD"] = "1"
+t_cfg = SimpleNamespace(model_config=SimpleNamespace(head_dtype=None, hf_config=SimpleNamespace(model_type="kimi_k3")))
+d_cfg = SimpleNamespace(model_config=SimpleNamespace(head_dtype=None, hf_config=SimpleNamespace(model_type="qwen3_dspark")))
+
+with set_current_vllm_config(t_cfg):
+    t_lp = LogitsProcessor(vocab_size=128)
+    Exl3HeadLogitsProcessor.adopt(t_lp)
+with set_current_vllm_config(d_cfg):
+    d_lp = LogitsProcessor(vocab_size=128)
+    Exl3HeadLogitsProcessor.adopt(d_lp)
+
+exact_fp32_row = torch.full((1, 128), -10.0, dtype=torch.float32)
+exact_fp32_row[0, 40] = 20.99  # 'I' (CoT)
+exact_fp32_row[0, 48] = 21.05  # 'Q' (direct answer)
+
+class _SharedExl3Method(Exl3LinearMethod):
+    def __init__(self):
+        self.out_dtype = torch.bfloat16
+    def apply(self, layer, x, bias=None, out_dtype=None):
+        dt = self.out_dtype if out_dtype is None else out_dtype
+        return exact_fp32_row.to(dt)
+
+shared_head = SimpleNamespace(tp_rank=0, tp_size=1, quant_method=_SharedExl3Method())
+x = torch.zeros((1, 16), dtype=torch.bfloat16)
+
+bf16_model = SimpleNamespace(
+    lm_head=shared_head,
+    logits_processor=SimpleNamespace(org_vocab_size=128, logits_as_input=False),
+    compute_logits_local=lambda h: d_lp._apply_head(shared_head, h, None),
+)
+fp32_model = SimpleNamespace(
+    lm_head=shared_head,
+    logits_processor=SimpleNamespace(org_vocab_size=128, logits_as_input=False),
+    compute_logits_local=lambda h: t_lp._apply_head(shared_head, h, None),
+)
+
+bf16_win = int(ta.argmax_token_ids(bf16_model, x)[0].item())
+fp32_win = int(ta.argmax_token_ids(fp32_model, x)[0].item())
+print("RESULT " + json.dumps({"bf16": bf16_win, "fp32": fp32_win}))
