+# ---------------------------------------------------------------------------
+# 2. Deliverable 3: Switch-Gated Adaptive MoE Router Tail-Expert Pruning
+# ---------------------------------------------------------------------------
+
+
+def test_moe_prune_switches_default_off_and_zero_overhead_identity(monkeypatch):
+    _clear_prune_env(monkeypatch)
+    assert moe.moe_max_topk() == 0
+    assert moe.moe_rel_thresh() == 0.0
+
+    w = torch.rand((6, 16), dtype=torch.float32)
+    ids = torch.arange(96, dtype=torch.int32).view(6, 16) % 896
+    out_w, out_ids = moe.maybe_prune_moe_topk(w, ids)
+    assert out_w is w
+    assert out_ids is ids
+
+
+def test_moe_prune_topk_unsorted_weights_rel_thresh_min4_and_renorm(monkeypatch):
+    _clear_prune_env(monkeypatch)
+
+    # Row 0: unsorted weights (as produced by sigmoid(logit) + bias selection).
+    # Row 1: 1 dominant expert + 15 tiny experts -> rel_thresh keeps min 4!
+    # Row 2: DSpark all-masked row (-1 ids) -> stays -1 / 0.0 without NaN!
+    w = torch.tensor(
+        [
+            [0.02, 0.30, 0.01, 0.25, 0.04, 0.20, 0.03, 0.15,
+             0.005, 0.08, 0.002, 0.07, 0.001, 0.06, 0.004, 0.05],
+            [0.90] + [0.001] * 15,
+            [0.10] * 16,
+        ],
+        dtype=torch.float32,
+    )
+    ids = torch.tensor(
+        [
+            list(range(100, 116)),
+            list(range(200, 216)),
+            [-1] * 16,
+        ],
+        dtype=torch.int32,
+    )
+
+    # 1. MAX_TOPK = 8, REL_THRESH = 0.0, renormalize = True
+    monkeypatch.setenv("VLLM_K31Q_MOE_MAX_TOPK", "8")
+    pw, pids = moe.maybe_prune_moe_topk(w, ids, renormalize=True)
+    # Row 0 top-8 weights are at columns [1, 3, 5, 7, 9, 11, 13, 15]
+    expected_r0_kept = {1, 3, 5, 7, 9, 11, 13, 15}
+    for c in range(16):
+        if c in expected_r0_kept:
+            assert int(pids[0, c]) == 100 + c
+            assert float(pw[0, c]) > 0.0
+        else:
+            assert int(pids[0, c]) == -1
+            assert float(pw[0, c]) == 0.0
+    assert torch.isclose(pw[0].sum(), w[0].sum(), rtol=1e-6, atol=1e-6)
+
+    # Row 2 all-masked stays -1 and 0.0 without NaN
+    assert torch.all(pids[2] == -1)
+    assert torch.all(pw[2] == 0.0)
+    assert not torch.isnan(pw).any()
+
+    # 2. REL_THRESH = 0.10 on Row 1 (where only col 0 >= 0.09): must still keep 4 experts!
+    monkeypatch.setenv("VLLM_K31Q_MOE_MAX_TOPK", "12")
+    monkeypatch.setenv("VLLM_K31Q_MOE_REL_THRESH", "0.10")
+    pw2, pids2 = moe.maybe_prune_moe_topk(w, ids, renormalize=True)
+    assert int((pids2[1] >= 0).sum()) == 4
+    # Tie-breaking keeps earliest columns [0, 1, 2, 3]
+    assert pids2[1, :4].tolist() == [200, 201, 202, 203]
+    assert torch.all(pids2[1, 4:] == -1)
+    assert torch.isclose(pw2[1].sum(), w[1].sum(), rtol=1e-6, atol=1e-6)
+
+    # 3. renormalize = False leaves kept weights unscaled
+    pw_noren, _ = moe.maybe_prune_moe_topk(w, ids, renormalize=False)
+    assert torch.equal(pw_noren[1, :4], w[1, :4])
+    assert torch.all(pw_noren[1, 4:] == 0.0)
+
+
+def test_moe_prune_topk_faketensor_and_vq_reference_integration(
+    monkeypatch, meta_platform, tmp_path
+):
+    from tests.models.kimi_k3.sm80 import construct
+    from tests.models.kimi_k3.sm80 import k31q_fixture as fixture
+
+    _ensure_static_device_name(monkeypatch)
+    _clear_prune_env(monkeypatch)
+    with FakeTensorMode():
+        fw = torch.empty((5, 16), dtype=torch.float32)
+        fids = torch.empty((5, 16), dtype=torch.int32)
+        ow, oids = glue.moe_prune_topk(fw, fids, 12, 0.025, True)
+        assert ow.shape == (5, 16) and ow.dtype == torch.float32
+        assert oids.shape == (5, 16) and oids.dtype == torch.int32
+
+    directory = tmp_path / "mini_vq_prune"
+    fixture.write_checkpoint(directory)
+    text = fixture.TEXT
+    latent = text["routed_expert_hidden_size"]
+    num_experts = text["num_experts"]
+    topk = text["num_experts_per_token"]
+
