+@pytest.mark.parametrize("name", ["vq_ops", "dense_k31_ops"])
+def test_ops_modules_name_their_library_and_build_command(name):
+    module = importlib.import_module(f"vllm.sm80.kernels.k31q.{name}")
+    script = re.search(r"python (csrc/\S+\.py)", module.BUILD_COMMAND).group(1)
+    assert (REPO / script).is_file()
+    library = re.search(r"cp \S+/(_k31_\w+_C)\.abi3\.so vllm/", module.BUILD_COMMAND)
+    source = (REPO / script).read_text()
+    assert f'"{library.group(1)}.abi3.so"' in source
+    # Every operator the module requires is defined by the package's module file.
+    registration = "".join(
+        path.read_text() for path in (REPO / script).parent.glob("*module.cpp")
+    )
+    for operator in module._OPERATORS:
+        assert f'm.def("{operator}(' in registration
+    assert f'"abi_version", {module._ABI_VERSION}' in registration
+    # The tree asks for the interface release its sources are.
+    expected_api = {"vq_ops": 2, "dense_k31_ops": 4}[name]
+    assert module._API_VERSION == expected_api
+    assert f'"api_version", {module._API_VERSION}' in registration
