+def test_exl3_kernel_shape_gate(monkeypatch, meta_platform, checkpoint):
+    """The real kernels take (3584, 1536) only: the tiny shapes are refused
+    with the reason, before any pointer reaches an operator."""
+    _recorders(monkeypatch)
+    model, _, _, _ = construct.build_and_load(monkeypatch, checkpoint[0])
+    routed = _routed(model, EXL3_LAYER)
+    assert len(routed.k31_experts.parts) == 1
+    with pytest.raises(ValueError, match=r"\(3584, 1536\)"):
+        routed.quant_method.build_kernel(routed, max_rows=8)
+    with pytest.raises(ValueError, match="must be on CUDA"):
+        routed.quant_method.process_weights_after_loading(routed)
+
+
+def test_fused_in_projection_output_layout(monkeypatch, meta_platform, checkpoint):
+    """q, k, v, g from the EXL3 operator, then f_a and b from the plain rows,
+    then the zero padding: the layout of upstream's merged weight."""
+    from vllm.sm80.kernels.k31q import quant
+
+    directory, _ = checkpoint
+    rank = 1
+    model, _, _, _ = construct.build_and_load(
+        monkeypatch, directory, tp_size=2, tp_rank=rank
+    )
+    layer = model.model.layers[1].self_attn.in_proj_qkvgfab
+    order = {"q_proj": 1.0, "k_proj": 2.0, "v_proj": 3.0, "g_proj": 4.0}
+
+    def exl3_linear(x, weight, row_chunk, out_dtype):
+        value = order[weight.matrix.prefix.rsplit(".", 1)[1]]
+        assert weight.logical_out == 128 and out_dtype == torch.bfloat16
+        return torch.full((x.shape[0], weight.logical_out), value, dtype=out_dtype)
+
+    monkeypatch.setattr(quant, "_exl3_linear", exl3_linear)
+    x = (torch.randn((3, 2, 256), generator=torch.Generator().manual_seed(1))).to(
+        torch.bfloat16
+    )
+    out = layer.quant_method.apply(layer, x)
+    assert out.shape == (3, 2, 4 * 128 + 128 + 1 + 15) and out.dtype == torch.bfloat16
+    for index in range(4):
+        assert (out[..., 128 * index : 128 * (index + 1)] == index + 1.0).all()
+    prefix = f"{fixture.P}layers.1.self_attn."
+    path = directory / "layer-001.safetensors"
+    f_a = torch.from_numpy(
+        fixture.st_read(path, prefix + "f_a_proj.weight").view(np.int16).copy()
+    )
+    b = torch.from_numpy(
+        fixture.st_read(path, prefix + "b_proj.weight").view(np.int16).copy()
+    )
+    f_a, b = f_a.view(torch.bfloat16), b.view(torch.bfloat16)
+    assert torch.equal(out[..., 512:640], torch.nn.functional.linear(x, f_a))
+    assert torch.equal(
+        out[..., 640:641], torch.nn.functional.linear(x, b[rank : rank + 1])
+    )
+    assert not out[..., 641:].any()
+
+
+def test_dequant_of_every_expert_is_bounded(monkeypatch, meta_platform, checkpoint):
+    """Stacking every expert of a projection is for tiny models: above the
+    limit (the 896 real experts are about 20 GiB) it is refused; one expert
+    is always served."""
+    from vllm.sm80.kernels.k31q import moe
+
+    model, _, _, _ = construct.build_and_load(monkeypatch, checkpoint[0])
+    experts = _routed(model, VQ_LAYER).k31_experts
+    whole = experts.dequant("w2")
+    assert whole.shape == (EXPERTS, LATENT, INTER) and whole.dtype == torch.float32
+    monkeypatch.setattr(moe, "DEQUANT_LIMIT_BYTES", whole.nbytes - 1)
+    with pytest.raises(ValueError, match=r"all 8 w2 matrices are .* pass an expert"):
+        experts.dequant("w2")
+    assert torch.equal(experts.dequant("w2", 3), whole[3])
+
+
+def test_exl3_through_the_modular_kernel(monkeypatch, meta_platform, checkpoint):
+    """The EXL3 kernel object behind upstream's FusedMoEKernel: its
+    workspace comes from upstream's workspace manager as BF16 storage, the
+    operator's FP32 view at its start and the second part's partial behind
+    it (tensor parallel size 1: two parts)."""
+    from vllm.config import set_current_vllm_config
+    from vllm.sm80.kernels.k31q import moe
+    from vllm.v1.worker import workspace
+
+    monkeypatch.setattr(moe, "K31_KERNEL_SHAPE", TINY_KERNEL)
+    calls = _recorders(monkeypatch)
+    model, config, _, _ = construct.build_and_load(monkeypatch, checkpoint[0])
+    routed = _routed(model, EXL3_LAYER)
+    method = routed.quant_method
+    # A serving process holds the expert buffers on CUDA; here they are host
+    # memory, which process_weights_after_loading refuses.
+    monkeypatch.setattr(moe.K31Experts, "require_loaded", lambda self, cuda=True: None)
+    monkeypatch.setattr(workspace, "_manager", None)
+    x, ids, weights = _inputs(6)
+    with set_current_vllm_config(config):
+        method.process_weights_after_loading(routed)
+        kernel = method.moe_kernel.fused_experts
+        assert type(kernel) is moe.K31Exl3Experts and not method.is_monolithic
+        assert len(kernel.tables) == 2 and kernel.max_rows == method.moe.max_num_tokens
+        workspace.init_workspace_manager(torch.device("cpu"))
+        out = method.apply(routed, x, weights, ids, None, None)
+    assert out.shape == (6, LATENT) and out.dtype == torch.bfloat16
+    # Recorder k fills its target with k + 1; the second part's partial was added.
+    assert torch.equal(out, torch.full_like(out, 3.0))
+    first, second = calls
+    assert [call["name"] for call in calls] == ["decode", "decode"]
+    for part, call in enumerate(calls):
+        assert call["pointers"] is getattr(routed, f"k31_ptrs_{part}")
+        assert call["expert_map"] is routed.k31_expert_map
+        assert call["workspace"].dtype == torch.float32
+        assert call["workspace"].numel() == kernel.workspace_elements
+        assert call["workspace"].data_ptr() % 16 == 0
+    assert first["workspace"].data_ptr() == second["workspace"].data_ptr()
+    assert (
+        second["out"] == first["workspace"].data_ptr() + 4 * kernel.workspace_elements
+    )
+
+
+def test_exl3_row_chunks(monkeypatch, meta_platform, checkpoint):
+    """VLLM_K31Q_MOE_CHUNK_ROWS caps a launch's rows: the workspace is sized
+    for one launch (the prefill operator's is 0.81 GiB at 2,048 real rows),
+    larger calls run as consecutive chunks, each part of each chunk one
+    launch."""
+    from vllm.sm80.kernels.k31q import moe
+
+    monkeypatch.setattr(moe, "K31_KERNEL_SHAPE", TINY_KERNEL)
+    calls = _recorders(monkeypatch)
+    model, _, _, _ = construct.build_and_load(monkeypatch, checkpoint[0])
+    routed = _routed(model, EXL3_LAYER)
+    decode_rows = moe.K31_MAX_ASSIGNMENTS // TOPK
+    whole = routed.quant_method.build_kernel(routed, max_rows=1500)
+    assert whole.launcher.launch_rows == 1500
+    assert whole.workspace_elements == 5000 + 1500
+    monkeypatch.setenv("VLLM_K31Q_MOE_CHUNK_ROWS", "600")
+    kernel = routed.quant_method.build_kernel(routed, max_rows=1500)
+    assert kernel.launcher.launch_rows == 600
+    assert kernel.workspace_elements == max(1000 + decode_rows, 5000 + 600)
+    x, ids, weights = _inputs(1300)
+    output, workspace2 = _apply(kernel, x, ids, weights)
+    # 600, 600 and 100 rows, two parts each; 100 rows are within the decode
+    # operator's assignments.
+    assert workspace2.numel() == 2 * kernel.workspace_elements + 600 * LATENT
+    assert [call["name"] for call in calls] == ["prefill"] * 4 + ["decode"] * 2
+    partial = workspace2.data_ptr() + 4 * kernel.workspace_elements
+    starts = (0, 0, 600, 600, 1200, 1200)
+    for index, (call, start) in enumerate(zip(calls, starts)):
+        part = index % 2
+        assert call["pointers"] is kernel.tables[part][0]
+        assert call["out"] == (
+            partial if part else output.data_ptr() + start * LATENT * 2
+        )
+        assert call["workspace"].data_ptr() == workspace2.data_ptr()
+    # Recorder k fills with k + 1: each chunk is its two parts' sum.
+    assert torch.equal(output[:600], torch.full_like(output[:600], 1.0 + 2.0))
+    assert torch.equal(output[600:1200], torch.full_like(output[:600], 3.0 + 4.0))
+    assert torch.equal(output[1200:], torch.full_like(output[1200:], 5.0 + 6.0))
+    monkeypatch.setenv("VLLM_K31Q_MOE_CHUNK_ROWS", "8")
+    small = routed.quant_method.build_kernel(routed, max_rows=1500)
+    assert small.workspace_elements == 1000 + 8
