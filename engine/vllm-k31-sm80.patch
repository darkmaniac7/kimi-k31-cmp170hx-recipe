+# ---------------------------------------------------------------------------
+# 2. Fused router GEMV + top-k wiring & LatentMoERunner hand-off
+# ---------------------------------------------------------------------------
+
+
+def test_fused_router_gemv_topk_fake_tensor_and_numerical_parity(monkeypatch):
+    _clear_env(monkeypatch)
+    fake = FakeGlueOps().install(monkeypatch)
+    monkeypatch.setenv("VLLM_K31_GLUE_FUSED_ROUTER", "1")
+
+    M, K, E, top_k = 8, 64, 32, 4
+    x = torch.randn(M, K, dtype=torch.bfloat16)
+    w = torch.randn(E, K, dtype=torch.bfloat16)
+    bias = torch.randn(E, dtype=torch.float32)
+
+    assert glue.can_use_fused_router_gemv_topk(x, w, bias, top_k, 1, 1, "sigmoid")
+    tw, ti = glue.fused_router_gemv_topk(x, w, bias, top_k, True, 2.5)
+    ref_w, ref_i = ref_moe_topk_sigmoid(
+        F.linear(x.float(), w.float()), bias, top_k, True, 2.5
+    )
+    torch.testing.assert_close(tw, ref_w)
+    torch.testing.assert_close(ti, ref_i)
+    assert len(fake.calls_for("fused_router_gemv_topk")) == 1
+
+    # Row cap declines M > 16 cleanly.
+    big_x = torch.randn(17, K, dtype=torch.bfloat16)
+    assert not glue.can_use_fused_router_gemv_topk(big_x, w, bias, top_k, 1, 1, "sigmoid")
+
+    # FakeTensor tracing for torch.compile.
+    with FakeTensorMode():
+        fx = torch.empty((M, K), dtype=torch.bfloat16)
+        fw = torch.empty((E, K), dtype=torch.bfloat16)
+        fb = torch.empty((E,), dtype=torch.float32)
+        ftw, fti = torch.ops.vllm.k31_glue_fused_router_gemv_topk(
+            fx, fw, fb, top_k, True, 1.0
+        )
+        assert ftw.shape == (M, top_k) and ftw.dtype == torch.float32
+        assert fti.shape == (M, top_k) and fti.dtype == torch.int32
