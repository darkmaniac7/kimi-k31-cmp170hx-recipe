@@ -0,0 +1,155 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The engine's torch codec of the k31q VQ records against the format's numpy
+definition (tests/models/kimi_k3/sm80/k31q_fixture.py): two implementations
+of the same layout must agree bit for bit."""
+
+import numpy as np
+import pytest
+import torch
+
+from tests.models.kimi_k3.sm80 import k31q_fixture as fixture
+from vllm.sm80.kernels.k31q import codec
+
+# (role, latent, intermediate, dim, index_bits, group_size)
+CASES = [
+    # The real rate classes: d = 2 codebooks of 3, 4 and 5 index bits.
+    ("in_latent", 128, 256, 2, 3, 128),
+    ("in_latent", 256, 384, 2, 4, 128),
+    ("in_latent", 128, 256, 2, 5, 128),
+    ("out_latent", 128, 256, 2, 3, 128),
+    ("out_latent", 256, 384, 2, 4, 128),
+    ("out_latent", 128, 256, 2, 5, 128),
+    ("in_latent", 128, 256, 4, 8, 128),
+    ("in_latent", 128, 256, 4, 6, 128),
+    ("in_latent", 256, 384, 4, 10, 128),
+    ("in_latent", 128, 128, 2, 5, 32),
+    ("out_latent", 128, 256, 4, 8, 128),
+    ("out_latent", 128, 256, 4, 6, 128),
+    ("out_latent", 256, 384, 8, 13, 64),
+    ("out_latent", 384, 128, 16, 16, 128),
+]
+
+
+@pytest.mark.parametrize("bits", [1, 3, 5, 6, 8, 10, 13, 16])
+def test_index_bitstream_matches_the_definition(bits):
+    rng = np.random.default_rng(bits)
+    values = rng.integers(0, 1 << bits, size=1003)
+    record = fixture.pack_bits(values, bits)
+    assert record.size % 16 == 0
+    packed = codec.pack_indices(torch.from_numpy(values), bits, record.size)
+    assert np.array_equal(packed.numpy(), record)
+    unpacked = codec.unpack_indices(torch.from_numpy(record), bits, values.size)
+    assert np.array_equal(unpacked.numpy(), values)
+    # Leading dimensions (experts, blocks) are carried through.
+    stacked = torch.from_numpy(np.stack([record, record[::-1].copy()]))
+    both = codec.unpack_indices(stacked, bits, values.size)
+    assert np.array_equal(both[0].numpy(), values)
+    assert np.array_equal(
+        both[1].numpy(), fixture.unpack_bits(record[::-1].copy(), bits, values.size)
+    )
+
+
+@pytest.mark.parametrize("role,latent,inter,dim,bits,group", CASES)
+def test_records_match_the_definition(role, latent, inter, dim, bits, group):
+    rng = np.random.default_rng(latent + inter + bits)
+    out_f, in_f = (inter, latent) if role == "in_latent" else (latent, inter)
+    idx = rng.integers(0, 1 << bits, size=(out_f, in_f // dim))
+    scale = (0.02 + 0.01 * rng.random((out_f, in_f // group))).astype(np.float16)
+    book = rng.standard_normal((1 << bits, dim)).astype(np.float16)
+    records, scales = fixture.vq_pack_matrix(idx, scale, role, inter, dim, bits, group)
+    want = fixture.vq_unpack_matrix(
+        records, scales, book, role, latent, dim, bits, group
+    )
+    # The definition's own closed form.
+    direct = book.astype(np.float32)[idx].reshape(out_f, in_f) * np.repeat(
+        scale.astype(np.float32), group, 1
+    )
+    assert np.array_equal(want, direct)
+
+    geometry = codec.VqGeometry(role, latent, dim, bits, group)
+    assert geometry.record_bytes == records.shape[1]
+    assert geometry.record_bytes == fixture.vq_record_bytes(
+        role, latent, dim, bits, group
+    )
+    assert geometry.record_scales == scales.shape[1]
+    assert geometry.matrix_shape(inter // 128) == (out_f, in_f)
+    packed, packed_scales = codec.vq_pack(
+        torch.from_numpy(idx), torch.from_numpy(scale), geometry
+    )
+    assert np.array_equal(packed.numpy(), records)
+    assert np.array_equal(packed_scales.numpy().view(np.uint16), scales.view(np.uint16))
+
+    t_records, t_scales = torch.from_numpy(records), torch.from_numpy(scales)
+    t_book = torch.from_numpy(book)
+    whole = codec.vq_unpack(t_records, t_scales, t_book, geometry)
+    assert whole.dtype == torch.float32 and np.array_equal(whole.numpy(), want)
+    # Any range of I-blocks decodes to the matching rows or columns: the
+    # property a tensor-parallel rank's byte range relies on.
+    blocks = inter // 128
+    for start, stop in [(0, 1), (blocks - 1, blocks), (0, blocks)]:
+        part = codec.vq_unpack(
+            t_records[start:stop], t_scales[start:stop], t_book, geometry
+        )
+        cut = slice(128 * start, 128 * stop)
+        assert np.array_equal(
+            part.numpy(), want[cut] if role == "in_latent" else want[:, cut]
+        )
+    # Experts stacked on a leading dimension decode together.
+    stacked = codec.vq_unpack(
+        torch.stack([t_records, t_records]),
+        torch.stack([t_scales, t_scales]),
+        t_book,
+        geometry,
+    )
+    assert stacked.shape == (2, out_f, in_f) and np.array_equal(
+        stacked[1].numpy(), want
+    )
+
+
+def test_geometry_refuses_layouts_the_format_does_not_define():
+    with pytest.raises(ValueError, match="must divide 16"):
+        codec.VqGeometry("in_latent", 128, 3, 8, 128)
+    with pytest.raises(ValueError, match="index bits"):
+        codec.VqGeometry("in_latent", 128, 4, 17, 128)
+    with pytest.raises(ValueError, match="role"):
+        codec.VqGeometry("sideways", 128, 4, 8, 128)
+    geometry = codec.VqGeometry("in_latent", 128, 4, 8, 128)
+    records = torch.zeros((2, geometry.record_bytes), dtype=torch.uint8)
+    scales = torch.zeros((2, geometry.record_scales), dtype=torch.float16)
+    book = torch.zeros((256, 4), dtype=torch.float16)
+    with pytest.raises(ValueError, match="codebook"):
+        codec.vq_unpack(records, scales, book[:128], geometry)
+    with pytest.raises(ValueError, match="does not match"):
+        codec.vq_unpack(records[:, :-16], scales, book, geometry)
+    with pytest.raises(ValueError, match="out of range"):
+        codec.pack_indices(torch.tensor([256]), 8, 16)
+
+
+def test_record_sizes_at_the_real_geometry():
+    """Pins of the real checkpoint (latent 3584, groups of 128): the record
+    bytes its manifest gives per rate, 3,584 scales per record for both
+    roles, and the sizes of the stacked tensors of 896 experts."""
+    real = {  # (dim, index_bits) -> record_bytes in the mini checkpoint's manifest
+        (2, 3): 86016,
+        (2, 4): 114688,
+        (2, 5): 143360,
+        (4, 6): 86016,
+    }
+    for (dim, bits), record in real.items():
+        for role in (codec.IN_LATENT, codec.OUT_LATENT):
+            geometry = codec.VqGeometry(role, 3584, dim, bits, 128)
+            assert geometry.record_bytes == record
+            assert geometry.record_scales == 3584
+            assert geometry.record_bytes % codec.RECORD_ALIGN == 0
+        gate = codec.VqGeometry(codec.IN_LATENT, 3584, dim, bits, 128)
+        down = codec.VqGeometry(codec.OUT_LATENT, 3584, dim, bits, 128)
+        assert (gate.rows, gate.vectors, gate.groups) == (128, 3584 // dim, 28)
+        assert (down.rows, down.vectors, down.groups) == (3584, 128 // dim, 1)
+        assert gate.matrix_shape(12) == (1536, 3584)
+        assert down.matrix_shape(24) == (3584, 3072)
+    # vq_d2_b3, 896 experts, 24 I-blocks: 1.85 GB of records and 154 MB of
+    # scales per projection; a rank of two reads half.
+    geometry = codec.VqGeometry(codec.IN_LATENT, 3584, 2, 3, 128)
+    assert 896 * 24 * geometry.record_bytes == 1_849_688_064
+    assert 896 * 24 * geometry.record_scales * 2 == 154_140_672
