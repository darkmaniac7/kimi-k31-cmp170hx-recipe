+class CausalBlockRefinerLayer(nn.Module):
+    """Compact causal self-attention + SwiGLU layer over draft block positions 0..K-1."""
+
+    def __init__(
+        self,
+        d_model: int = 1024,
+        num_heads: int = 16,
+        intermediate_size: int = 2048,
+        eps: float = 1e-5,
+    ) -> None:
+        super().__init__()
+        assert d_model % num_heads == 0
+        self.d_model = d_model
+        self.num_heads = num_heads
+        self.head_dim = d_model // num_heads
+        self.scale = self.head_dim ** -0.5
+
+        self.input_layernorm = HeadRMSNorm(d_model, eps=eps)
+        self.qkv_proj = nn.Linear(d_model, 3 * d_model, bias=False)
+        self.q_norm = HeadRMSNorm(self.head_dim, eps=eps)
+        self.k_norm = HeadRMSNorm(self.head_dim, eps=eps)
+        self.o_proj = nn.Linear(d_model, d_model, bias=False)
+
+        self.post_attention_layernorm = HeadRMSNorm(d_model, eps=eps)
+        self.gate_up_proj = nn.Linear(d_model, 2 * intermediate_size, bias=False)
+        self.down_proj = nn.Linear(intermediate_size, d_model, bias=False)
+
+    def forward_parallel(self, x: torch.Tensor) -> torch.Tensor:
+        bsz, k_len, _ = x.shape
+        h = self.input_layernorm(x)
+        qkv = self.qkv_proj(h).view(bsz, k_len, 3, self.num_heads, self.head_dim)
+        q = self.q_norm(qkv[:, :, 0]).transpose(1, 2)
+        k = self.k_norm(qkv[:, :, 1]).transpose(1, 2)
+        v = qkv[:, :, 2].transpose(1, 2)
+        attn = F.scaled_dot_product_attention(
+            q, k, v, dropout_p=0.0, is_causal=True, scale=self.scale
+        )
+        x = x + self.o_proj(
+            attn.transpose(1, 2).contiguous().view(bsz, k_len, self.d_model)
+        )
+        gu = self.gate_up_proj(self.post_attention_layernorm(x))
+        gate, up = gu.chunk(2, dim=-1)
+        return x + self.down_proj(F.silu(gate) * up)
+
+    def forward_step(
+        self,
+        x_t: torch.Tensor,
+        k_cache: torch.Tensor,
+        v_cache: torch.Tensor,
+        step: int,
+    ) -> torch.Tensor:
+        bsz = x_t.shape[0]
+        if (
+            x_t.is_cuda
+            and not self.training
+            and bsz > 0
+            and triton.next_power_of_2(self.head_dim) == self.head_dim
+        ):
+            qkv = self.qkv_proj(self.input_layernorm(x_t)).contiguous()
+            attn = torch.empty(bsz, self.d_model, dtype=x_t.dtype, device=x_t.device)
+            _ar1_qknorm_attn_kernel[(bsz, self.num_heads)](
+                qkv,
+                self.q_norm.weight,
+                self.k_norm.weight,
+                k_cache,
+                v_cache,
+                attn,
+                self.q_norm.eps,
+                self.scale,
+                H=self.num_heads,
+                D=self.head_dim,
+                MAX_K=k_cache.shape[2],
+                STEP=step,
+                STEP_P2=max(16, triton.next_power_of_2(step + 1)),
+                num_warps=2,
+            )
+            x_t = x_t + self.o_proj(attn)
+            gu = self.gate_up_proj(self.post_attention_layernorm(x_t)).contiguous()
+            inter = gu.shape[-1] // 2
+            act = torch.empty(bsz, inter, dtype=x_t.dtype, device=x_t.device)
+            blk = 256
+            _silu_mul_kernel[(bsz, triton.cdiv(inter, blk))](
+                gu, act, I=inter, BLOCK=blk, num_warps=4
+            )
+            return x_t + self.down_proj(act)
+
+        h = self.input_layernorm(x_t)
+        qkv = self.qkv_proj(h).view(bsz, 3, self.num_heads, self.head_dim)
+        q = self.q_norm(qkv[:, 0]).unsqueeze(2)
+        k = self.k_norm(qkv[:, 1])
+        v = qkv[:, 2]
+        k_cache[:, :, step, :] = k
+        v_cache[:, :, step, :] = v
+        k_past = k_cache[:, :, : step + 1, :]
+        v_past = v_cache[:, :, : step + 1, :]
+        scores = torch.matmul(q.float(), k_past.float().transpose(-1, -2)) * self.scale
+        probs = F.softmax(scores, dim=-1).to(x_t.dtype)
+        attn = torch.matmul(probs, v_past).squeeze(2).reshape(bsz, self.d_model)
+        x_t = x_t + self.o_proj(attn)
+        gu = self.gate_up_proj(self.post_attention_layernorm(x_t))
+        gate, up = gu.chunk(2, dim=-1)
+        return x_t + self.down_proj(F.silu(gate) * up)
+
