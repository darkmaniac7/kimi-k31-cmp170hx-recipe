+def test_runner_rewrites_input_ids_after_the_late_scatter(monkeypatch):
+    calls = []
+    monkeypatch.setattr(
+        mr, "combine_sampled_and_draft_tokens", lambda *a: calls.append(a)
+    )
+    applied = []
+    handler = SimpleNamespace(
+        has_pending_drafts=lambda: not applied,
+        apply_pending_drafts=lambda state, after_wait=None: applied.append(state),
+    )
+    runner = SimpleNamespace(
+        pp_handler=handler,
+        req_states=SimpleNamespace(draft_tokens="state"),
+        _late_combine_args=("args",),
+        stage_timer=None,
+    )
+    GPUModelRunner.apply_late_drafts(runner)
+    assert applied == ["state"] and calls == [("args",)]
+    assert runner._late_combine_args is None
+    GPUModelRunner.apply_late_drafts(runner)  # nothing pending: no-op
+    assert applied == ["state"] and calls == [("args",)]
+
+
+def test_runner_scatters_without_rewriting_when_no_inputs_were_prepared(monkeypatch):
+    calls = []
+    monkeypatch.setattr(
+        mr, "combine_sampled_and_draft_tokens", lambda *a: calls.append(a)
+    )
+    applied = []
+    marks = []
+    runner = SimpleNamespace(
+        pp_handler=SimpleNamespace(
+            has_pending_drafts=lambda: True,
+            apply_pending_drafts=lambda state, after_wait=None: (
+                applied.append(state),
+                after_wait(),
+            ),
+        ),
+        req_states=SimpleNamespace(draft_tokens="state"),
+        _late_combine_args=None,
+        stage_timer=SimpleNamespace(mark=marks.append),
+    )
+    GPUModelRunner.apply_late_drafts(runner)
+    assert applied == ["state"] and not calls
+    assert marks == ["dr"]  # the step timing marks the arrival of the drafts
+    # Without a PP handler (PP off) or with stale arguments and nothing
+    # pending, nothing runs and the arguments are dropped.
+    runner = SimpleNamespace(pp_handler=None, _late_combine_args=("args",))
+    GPUModelRunner.apply_late_drafts(runner)
+    assert runner._late_combine_args is None and not calls
+
