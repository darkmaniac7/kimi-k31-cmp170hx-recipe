+def require_moe_k31() -> None:
+    """Refuse a library without the K3.1 EXL3 MoE operators and register fakes once."""
+    global _moe_k31_fake_registered
+    ensure_extension()
+    for name in (
+        "moe_out_k31",
+        "moe_workspace_size_k31",
+        "moe_out_prefill_k31",
+        "moe_workspace_size_prefill_k31",
+    ):
+        try:
+            torch._C._dispatch_find_schema_or_throw(f"_exl3_C::{name}", "")
+        except RuntimeError as exc:
+            raise RuntimeError(
+                f"K3.1 EXL3 MoE needs _exl3_C::{name}: rebuild the EXL3 extension "
+                "from this tree (python csrc/exl3/build_standalone.py --out vllm). "
+                f"Detail: {exc}"
+            ) from exc
+    if not _moe_k31_fake_registered:
+        torch.library.register_fake("_exl3_C::moe_out_k31")(_moe_k31_fake)
+        torch.library.register_fake("_exl3_C::moe_out_prefill_k31")(_moe_k31_fake)
+        _moe_k31_fake_registered = True
+
+
+@lru_cache(maxsize=None)
+def moe_workspace_size_k31(
+    max_rows: int,
+    hidden_size: int,
+    intermediate_size: int,
+    topk: int,
+    local_experts: int,
+) -> int:
