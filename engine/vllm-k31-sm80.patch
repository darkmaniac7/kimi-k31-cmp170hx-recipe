+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The engine's native VQ path on a CUDA device, on the real mini checkpoint.
+
+The experts are built and loaded by the engine's own ``K31Experts`` (packed
+projection by projection through ``vq_pack``) and launched by its
+``K31VqLauncher``, without a model (tests/models/kimi_k3/sm80/gpu.py).
+
+  1. Record order on real data. For every VQ layer of the mini checkpoint
+     (its rates: vq_d2_b3, vq_d4_b6, vq_d2_b4, vq_d2_b5) and every rank cut
+     (both ranks of two, and the whole): what the kernels read, decoded from
+     the packed buffers by ``vq_dequant_reference``, equals bit for bit what
+     the format defines, ``codec.vq_unpack`` of the canonical records of the
+     same I-block range, for w1, w3 and w2. The synthetic fixture cannot
+     catch a w2 or scale order disagreement between the op and the codec:
+     this can.
+  2. The engine's tables equal the kernel owner's builder on the same
+     buffers, and packing in expert chunks (VLLM_K31Q_VQ_PACK_EXPERTS) gives
+     the same buffers as packing a projection whole.
+  3. Mini layer 1 routed-expert output against the reference activations
+     (``L1.moe.*.q``): at tensor parallel size 1 with the reference backend
+     (torch, FP32) and with the native ops (decode launch, prefill launch,
+     row chunks), and at size 2 as rank 0 plus rank 1.
+
+Needs a CUDA device with about 20 GiB free, the built ``vllm/_k31_vq_C`` and
+the mini checkpoint (K31Q_MINI_CHECKPOINT).
+"""
+
+import pytest
+import torch
+
+from tests.models.kimi_k3.sm80 import gpu
+
+pytestmark = gpu.CUDA_MARKS
+
+DEVICE = "cuda:0"
+VQ_LAYERS = (1, 3, 46, 92)
+CUTS = ((2, 0), (2, 1), (1, 0))
+SAMPLE = (0, 1, 255, 448, 894, 895)
+# rel_l2 against the reference activations: the kernel owner's bound.
+REF_BOUND = 0.005
+
+
+@pytest.fixture(scope="module")
+def vq_ops():
+    from vllm.sm80.kernels.k31q import vq_ops
+
+    gpu.require_library(vq_ops.ensure_vq_extension, "_k31_vq_C")
+    return vq_ops
+
+
+@pytest.fixture(autouse=True)
+def _free():
+    yield
+    torch.cuda.empty_cache()
+
+
+def _canonical(experts, manifest, name, expert):
+    """FP32 matrix of one expert's projection for this rank's I-blocks by the
+    format's definition, on the host, from the checkpoint file."""
+    from vllm.sm80.kernels.k31q.codec import vq_unpack
+    from vllm.sm80.kernels.k31q.manifest import read_rows
+
+    projection = experts.projections[name]
+    one = slice(expert, expert + 1)
+    idx, _ = read_rows(projection.idx, rows=one)
+    scale, _ = read_rows(projection.scale, rows=one)
+    book, _ = read_rows(manifest.codebooks[projection.codebook])
+    return vq_unpack(
+        idx[0, experts.blocks], scale[0, experts.blocks], book, experts.geometry[name]
+    )
+
+
+@pytest.mark.parametrize("layer", VQ_LAYERS)
+@pytest.mark.parametrize("tp,rank", CUTS)
+def test_packed_buffers_decode_to_the_canonical_matrices(vq_ops, layer, tp, rank):
+    mini = gpu.require_mini()
+    experts, manifest = gpu.load_experts(mini, layer, tp, rank, native=vq_ops)
+    assert experts.vq_native is vq_ops and list(experts.parameters()) == []
+    assert experts.local_intermediate == 3072 // tp
+    rates = {(g.dim, g.index_bits, g.group_size) for g in experts.geometry.values()}
+    print(f"layer {layer} TP {tp} rank {rank}: blocks {experts.blocks}, rates {rates}")
+    for name in ("w1", "w3", "w2"):
+        for expert in SAMPLE:
+            got = experts.packed_dequant(name, expert).cpu()
+            want = _canonical(experts, manifest, name, expert)
+            assert got.shape == want.shape and got.dtype == want.dtype
+            assert torch.equal(got, want), (
+                f"layer {layer} {name} expert {expert}: max diff "
+                f"{(got - want).abs().max().item()}"
+            )
+
+    # The engine's tables against the kernel owner's builder.
+    held = []
+    for name in ("w1", "w3", "w2"):
+        geometry = experts.geometry[name]
+        held += [
+            getattr(experts, f"{name}_packed_idx"),
+            getattr(experts, f"{name}_packed_scale"),
+            experts.vq_codebooks[name],
+            geometry.dim,
+            geometry.index_bits,
+        ]
+    pointers, metadata = vq_ops.build_vq_expert_tables(
+        *held, experts.latent, experts.local_intermediate
+    )
+    assert torch.equal(experts.packed_ptrs, pointers)
+    assert torch.equal(experts.packed_meta, metadata)
+    assert experts.packed_ptrs.is_cuda and experts.packed_meta.is_cuda
+
+
+def test_packing_in_expert_chunks_gives_the_same_buffers(vq_ops, monkeypatch):
+    mini = gpu.require_mini()
+    whole, _ = gpu.load_experts(mini, 1, 2, 0, native=vq_ops)
+    monkeypatch.setenv("VLLM_K31Q_VQ_PACK_EXPERTS", "100")
+    parts, _ = gpu.load_experts(mini, 1, 2, 0, native=vq_ops)
+    for name, tensor in whole.named_buffers():
+        if "_packed_" in name:
+            assert torch.equal(tensor, getattr(parts, name)), name
+    assert torch.equal(whole.packed_meta, parts.packed_meta)
+
+
+def _launcher(experts, max_rows):
+    from vllm.sm80.kernels.k31q.moe import K31VqLauncher
+
+    text = gpu.text_config(gpu.require_mini())
+    launcher = K31VqLauncher(
+        experts,
+        max_rows,
+        text["num_experts_per_token"],
+        text["activation_situ_beta"],
+        text["activation_situ_linear_beta"],
+    )
+    workspace = torch.empty(
+        launcher.workspace_elements, dtype=torch.float32, device=DEVICE
+    )
+    return launcher, workspace
+
+
+def _run(launcher, workspace, x, ids, weights, expert_map):
+    out = torch.empty_like(x)
+    launcher(x, ids, weights, expert_map, out, workspace)
+    return out
+
+
+def test_layer1_routed_output_against_the_reference_activations(vq_ops, monkeypatch):
+    from vllm.sm80.kernels.k31q.moe import vq_reference_forward
+
+    mini = gpu.require_mini()
+    text = gpu.text_config(mini)
+    x, ids, weights, want = gpu.reference_moe(gpu.REF_LAYER)
+    rows = x.shape[0]
+    assert (rows, x.shape[1], ids.shape[1]) == (512, 3584, 16)
+    expert_map = torch.arange(text["num_experts"], dtype=torch.int32, device=DEVICE)
+
+    # Reference backend at TP 1: the canonical records on the device, FP32.
+    reference, _ = gpu.load_experts(mini, gpu.REF_LAYER, native=None)
+    oracle = vq_reference_forward(
+        reference,
+        x[:64],
+        ids[:64],
+        weights[:64],
+        text["activation_situ_beta"],
+        text["activation_situ_linear_beta"],
+    )
+    rel = gpu.rel_l2(oracle, want[:64])
+    print(f"reference backend, TP 1, 64 rows against ref_acts.q: rel_l2={rel:.5f}")
+    assert rel < REF_BOUND
+    del reference
+    torch.cuda.empty_cache()
+
+    # Native ops at TP 1.
+    experts, _ = gpu.load_experts(mini, gpu.REF_LAYER, native=vq_ops)
+    assert experts.vq_rate_ids() == (0, 0)  # vq_d2_b3 on all three
+    launcher, workspace = _launcher(experts, rows)
+    assert launcher.launch_rows == rows
+    decode = _run(launcher, workspace, x[:64], ids[:64], weights[:64], expert_map)
+    rel = gpu.rel_l2(decode, want[:64])
+    print(f"native decode, TP 1, 64 rows against ref_acts.q: rel_l2={rel:.5f}")
+    assert rel < REF_BOUND
+    rel = gpu.rel_l2(decode, oracle)
+    print(f"native decode against the reference backend: rel_l2={rel:.5f}")
+    assert rel < REF_BOUND
+    prefill = _run(launcher, workspace, x, ids, weights, expert_map)
+    rel = gpu.rel_l2(prefill, want)
+    print(f"native prefill, TP 1, 512 rows against ref_acts.q: rel_l2={rel:.5f}")
+    assert rel < REF_BOUND
+    # Masked slots and a fully masked row are skipped.
+    masked = ids[:8].clone()
+    masked[2] = -1
+    masked[5, :8] = -1
+    out = _run(launcher, workspace, x[:8], masked, weights[:8], expert_map)
+    assert out[2].abs().max().item() == 0.0
+    assert gpu.rel_l2(out[0], decode[0]) < 1e-4
+    # Row chunks: launches of 200, 200 and 112 rows (prefill) give the
+    # prefill result up to the summation order inside a launch.
+    monkeypatch.setenv("VLLM_K31Q_MOE_CHUNK_ROWS", "200")
+    chunked, small = _launcher(experts, rows)
+    assert chunked.launch_rows == 200
+    assert chunked.workspace_elements < launcher.workspace_elements
+    out = _run(chunked, small, x, ids, weights, expert_map)
+    rel = gpu.rel_l2(out, prefill)
+    print(f"native prefill in chunks of 200 against one launch: rel_l2={rel:.6f}")
+    assert rel < 1e-3
+    monkeypatch.delenv("VLLM_K31Q_MOE_CHUNK_ROWS")
+    del experts, launcher, chunked
+    torch.cuda.empty_cache()
+
+    # TP 2: the ranks' partial outputs sum to the whole (the MoE all-reduce).
+    total = torch.zeros((64, x.shape[1]), dtype=torch.float32, device=DEVICE)
+    for rank in (0, 1):
+        experts, _ = gpu.load_experts(mini, gpu.REF_LAYER, 2, rank, native=vq_ops)
+        launcher, workspace = _launcher(experts, 64)
+        total += _run(
+            launcher, workspace, x[:64], ids[:64], weights[:64], expert_map
+        ).float()
+        del experts, launcher
+    rel = gpu.rel_l2(total, want[:64])
+    print(f"native decode, TP 2 rank 0 + rank 1 against ref_acts.q: rel_l2={rel:.5f}")
+    assert rel < REF_BOUND
