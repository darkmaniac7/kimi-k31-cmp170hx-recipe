+def test_from_paths_orders_depth_first_with_the_chain_in_front():
+    tree = _example()
+    assert tree.paths == ((0,), (0, 0), (0, 0, 0), (0, 1), (1,))
+    assert tree.parent == (-1, 0, 1, 0, -1)
+    assert tree.rank == (0, 0, 0, 1, 1)
+    assert tree.depth == (1, 2, 3, 2, 1)
+    assert tree.num_nodes == 5 and tree.num_rows == 6
