+# -- the seam of a Blackwell stage, as far as an sm_80 card can show it ---------
+#
+# A pipeline of sm_80 and sm_120 stages shares one KV cache dtype, bfloat16
+# (the Triton backend reads no FP8 cache, upstream's SM 12.x backend reads
+# nothing else). With it a Blackwell rank reaches this same path through the
+# platform's candidate rule. The tests below answer the capability queries as
+# an SM 12.0 device would, so every host-side gate takes its Blackwell
+# branch, while the kernels are still compiled for and run on this card.
+# DeepGEMM is switched off for them: on a real Blackwell the indexer's
+# metadata builder also builds DeepGEMM's (unused) decode schedule, which
+# only a Blackwell can run.
+
+
+@pytest.fixture
+def as_capability(monkeypatch):
+    from vllm.model_executor.layers.indexer_topk import get_indexer_topk
+    from vllm.platforms import current_platform
+    from vllm.platforms.interface import DeviceCapability
+    from vllm.utils import deep_gemm
+
+    cached = (
+        deep_gemm.is_deep_gemm_supported,
+        deep_gemm.mqa_logits_use_mx_scales,
+        get_indexer_topk,
+    )
+
+    def answer(major: int, minor: int = 0) -> None:
+        monkeypatch.setattr(
+            type(current_platform),
+            "get_device_capability",
+            classmethod(lambda cls, device_id=0: DeviceCapability(major, minor)),
+        )
+        monkeypatch.setenv("VLLM_USE_DEEP_GEMM", "0")
+        for function in cached:
+            function.cache_clear()
+
+    yield answer
+    monkeypatch.undo()
+    for function in cached:
+        function.cache_clear()
+
+
+@pytest.mark.parametrize(
+    ("major", "cache_dtype", "expected"),
+    [
+        (8, "auto", "TRITON_MLA_SPARSE"),
+        (8, "bfloat16", "TRITON_MLA_SPARSE"),
+        (8, "fp8_ds_mla", None),
+        (12, "fp8_ds_mla", "FLASHINFER_MLA_SPARSE_SM120"),
+        (12, "bfloat16", "TRITON_MLA_SPARSE"),
+        (10, "bfloat16", "not TRITON_MLA_SPARSE"),
+    ],
+)
+def test_sparse_mla_backend_by_capability_and_cache_dtype(
+    major, cache_dtype, expected, as_capability, tmp_path, default_vllm_config
+):
+    """The platform's selection for a K3.1 MLA layer (576 = 512 + 64, 48
+    heads, top-k 2048), by the device's capability and the KV cache dtype."""
+    from vllm.config import set_current_vllm_config
+    from vllm.platforms import current_platform
+    from vllm.utils.import_utils import resolve_obj_by_qualname
+    from vllm.v1.attention.selector import AttentionSelectorConfig
+
+    assert type(current_platform).__module__ == "vllm.sm80.platform"
+    as_capability(major)
+    config = cases.vllm_config(cases.write_config(tmp_path / "k31", cases.RANK_TEXT))
+    selector = AttentionSelectorConfig(
+        head_size=576,
+        dtype=torch.bfloat16,
+        kv_cache_dtype=cache_dtype,
+        block_size=BLOCK,
+        use_mla=True,
+        use_sparse=True,
+    )
+    with set_current_vllm_config(config):
+        if expected is None:
+            with pytest.raises(ValueError, match="No valid attention backend"):
+                current_platform.get_attn_backend_cls(None, selector, num_heads=48)
+            return
+        path = current_platform.get_attn_backend_cls(None, selector, num_heads=48)
+    name = resolve_obj_by_qualname(path).get_name()
+    if expected.startswith("not "):
