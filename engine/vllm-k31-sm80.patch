+
+__device__ __forceinline__ uint32_t ld_acquire_gpu_u32(const uint32_t* ptr) {
+  uint32_t val;
+  asm volatile("ld.acquire.gpu.global.u32 %0, [%1];" : "=r"(val) : "l"(ptr) : "memory");
