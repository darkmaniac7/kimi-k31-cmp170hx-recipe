+namespace {
+
+using exl3::TileRing;
+using exl3::LaneWindow;
+using exl3::window_state;
+using exl3::kH128Scale;
+using exl3::hadamard128_warp;
+using exl3::swiglu_clamp;
+using exl3::check_tensor;
