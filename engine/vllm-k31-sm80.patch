+void bf16_gemv_split2(
+    const at::Tensor& x,
+    const at::Tensor& w,
+    int64_t n0,
+    at::Tensor out0,
+    at::Tensor out1) {
+  TORCH_CHECK(x.is_cuda() && x.scalar_type() == at::kBFloat16 && x.dim() == 2 && x.is_contiguous(),
+              "x must be contiguous CUDA BF16 [M, K]");
+  TORCH_CHECK(w.is_cuda() && w.scalar_type() == at::kBFloat16 && w.dim() == 2 && w.is_contiguous(),
+              "w must be contiguous CUDA BF16 [N, K]");
+  const int64_t M_total = x.size(0);
+  const int64_t K = x.size(1);
+  const int64_t N = w.size(0);
+  if (M_total == 0) return;
+  TORCH_CHECK(w.size(1) == K && (K % 8 == 0), "K mismatch or not multiple of 8");
+  TORCH_CHECK(n0 > 0 && n0 < N, "n0 must satisfy 0 < n0 < N");
+  const int64_t n1 = N - n0;
+  TORCH_CHECK(out0.is_cuda() && out0.scalar_type() == at::kBFloat16 &&
+                  out0.size(0) == M_total && out0.size(1) == n0 && out0.is_contiguous(),
+              "out0 shape/dtype mismatch");
+  TORCH_CHECK(out1.is_cuda() && out1.scalar_type() == at::kBFloat16 &&
+                  out1.size(0) == M_total && out1.size(1) == n1 && out1.is_contiguous(),
+              "out1 shape/dtype mismatch");
+
+  const c10::cuda::CUDAGuard device_guard(x.device());
+  cudaStream_t stream = at::cuda::getCurrentCUDAStream();
+
+  const int grid_x = static_cast<int>((N + 7) / 8);
+  const auto* x_base = reinterpret_cast<const __nv_bfloat16*>(x.data_ptr());
+  const auto* w_base = reinterpret_cast<const __nv_bfloat16*>(w.data_ptr());
+  auto* o0_base = reinterpret_cast<__nv_bfloat16*>(out0.data_ptr());
+  auto* o1_base = reinterpret_cast<__nv_bfloat16*>(out1.data_ptr());
+  TORCH_CHECK(is_aligned_16(x_base) && is_aligned_16(w_base),
+              "x and w must be 16-byte aligned for vectorized GEMV loads");
+
+  for (int64_t m0 = 0; m0 < M_total; m0 += 16) {
+    const int M = static_cast<int>(std::min<int64_t>(16, M_total - m0));
+    const auto* xm = x_base + m0 * K;
+    auto* o0m = o0_base + m0 * n0;
+    auto* o1m = o1_base + m0 * n1;
+    k31_bf16_gemv_split2_mma_kernel<<<grid_x, 512, 0, stream>>>(
+        xm, w_base, M, static_cast<int>(K), static_cast<int>(N), static_cast<int>(n0), o0m, o1m);
+  }
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
