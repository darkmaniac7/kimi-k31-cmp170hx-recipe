+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Fit the adaptive_k confidence-tier thresholds from a DSpark confidence dump.
+
+Input: the JSONL rows of ``VLLM_DSPARK_CONFIDENCE_DUMP`` (dspark_confidence.py)
+from a fixed-width run, best at the widest tier (``num_speculative_tokens``):
+each row is one verified block of one request with the drafter's per-position
+confidences (``conf``), the drafts the target verified (``verified``) and
+accepted (``accepted``). Acceptance is a prefix, so a block verified at width
+V with A accepted would have given ``min(A, k) + 1`` tokens at any tier
+``k <= V``, and also at ``k > V`` when ``A < V``; a block with ``A == V < k``
+is censored at k and left out of the objective.
+
+Step cost per tier (``--costs``, JSON ``{"3": ms, ...}``) comes from the GPU
+window (step ms by verified width at one request). The objective is tokens per
+second of one request: total tokens over total step time.
+
+The summary a decision sees is the online one (``adaptive_k.width_summary``
+through ``AdaptiveKPolicy``): the confidence of the block ``age`` rounds older
+than the one being verified (1 under async scheduling with or without PP, 0
+with synchronous scheduling) blended with the acceptance of the blocks before
+that. For each acceptance weight the thresholds are fitted by Dinkelbach's
+method: the best monotone tier assignment over the blocks sorted by summary,
+for a fixed price per millisecond, is an exact dynamic program; the price is
+iterated to the ratio. The result is then replayed through the online policy
+itself (hysteresis, acceptance from the tiers actually verified) and compared
+with every fixed tier.
+
+    python -m vllm.sm80.spec_decode.tier_fit DUMP.jsonl [...] \\
+        --tiers 3,5,7,9,12 --costs costs.json --age 1 --out tiers.json
+
+Only blocks verified at the widest tier count by default (``--min-verified``).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import sys
+from collections.abc import Iterable, Sequence
+from dataclasses import dataclass
+from pathlib import Path
+from types import SimpleNamespace
+
+from vllm.sm80.spec_decode.adaptive_k import AdaptiveKConfig, AdaptiveKPolicy
+
+WARMUP_PREFIXES = ("_warmup", "_v2_mixed_warmup")
+
+
+@dataclass(frozen=True)
+class Block:
+    conf: tuple[float, ...]
+    verified: int
+    accepted: int
+
+    def tokens(self, k: int) -> int | None:
+        """Tokens a step verifying k drafts of this block commits, or None
+        when the dump cannot tell (censored)."""
+        if k <= self.verified or self.accepted < self.verified:
+            return min(self.accepted, k) + 1
+        return None
+
+
+def load_dump(
+    paths: Iterable[str | Path], min_verified: int = 0
+) -> dict[str, list[Block]]:
+    """Per request (file-qualified id), its blocks in verification order.
+    Blocks verified at fewer than ``min_verified`` drafts are dropped: a run
+    that also steps through narrower forced widths (cost passes) would
+    otherwise bias the fit toward early rejections."""
+    out: dict[str, list[tuple[int, Block]]] = {}
+    for path in paths:
+        with open(path) as f:
+            for line in f:
+                line = line.strip()
+                if not line:
+                    continue
+                row = json.loads(line)
+                req = str(row["req"])
+                if req.startswith(WARMUP_PREFIXES):
+                    continue
+                block = Block(
+                    tuple(float(x) for x in row["conf"]),
+                    int(row["verified"]),
+                    int(row["accepted"]),
+                )
+                if block.verified < min_verified:
+                    continue
+                out.setdefault(f"{path}:{req}", []).append((int(row["step"]), block))
+    return {r: [b for _, b in sorted(rows, key=lambda x: x[0])] for r, rows in out.items()}
+
+
+def _policy(
+    tiers: Sequence[int],
+    width: int,
+    thresholds: Sequence[float],
+    accept_weight: float,
+    hysteresis: float,
+    max_age: int,
+    prior: float,
+    decay: float,
+    strength: float,
+) -> AdaptiveKPolicy:
+    raw = {
+        "tiers": list(tiers),
+        "confidence": {
+            "thresholds": list(thresholds),
+            "accept_weight": accept_weight,
+            "hysteresis": hysteresis,
+            "max_age": max_age,
+            "prior": prior,
+            "decay": decay,
+            "strength": strength,
+        },
+    }
+    return AdaptiveKPolicy(AdaptiveKConfig.from_dict(raw, width))
+
+
+def replay(
+    blocks: Sequence[Block],
+    policy: AdaptiveKPolicy,
+    age: int,
+    record: list[float] | None = None,
+    fixed_full_width: bool = False,
+) -> list[int]:
+    """Run the online policy over one request's blocks. The decision for
+    block t sees the outputs of the steps up to t - age: the output of step u
+    carries the confidence of block u and the verification of block u - 1
+    (step 0 is the prefill). Returns the verified count chosen per block.
+    ``record`` receives each decision's summary; ``fixed_full_width`` feeds
+    acceptance as verified in the dump (summary independent of the choices,
+    for the fit) instead of at the chosen tier."""
+    req = "r"
+    cfg = policy.config
+    width = cfg.confidence.width
+    stamps: list[int] = []
+
+    def schedule() -> None:
+        so = SimpleNamespace(num_scheduled_tokens={req: 1})
+        policy.note_scheduled(so)
+        stamps.append(policy.take_stamps(so)[req])
+
+    chosen: list[int] = []
+    processed = -1
+    schedule()  # step 0, the prefill
+    for t in range(len(blocks)):
+        while processed < t - age:
+            processed += 1
+            u = processed
+            if u >= 1:
+                prev = blocks[u - 1]
+                if fixed_full_width:
+                    policy.observe(req, prev.verified, prev.accepted)
+                else:
+                    k = chosen[u - 1]
+                    policy.observe(req, k, min(prev.accepted, k))
+            policy.observe_confidence(req, stamps[u], blocks[u].conf)
+        if record is not None:
+            record.append(policy.summary_for(req)[0])
+        chosen.append(policy.select_by_confidence([req], width))
+        schedule()
+    return chosen
+
+
+def ratio(blocks: Sequence[Block], ks: Sequence[int], costs: dict[int, float]) -> tuple[float, float]:
+    """Total tokens and total ms over the uncensored blocks."""
+    tokens = 0.0
+    ms = 0.0
+    for b, k in zip(blocks, ks):
+        n = b.tokens(k)
+        if n is None:
+            continue
+        tokens += n
+        ms += costs[k]
+    return tokens, ms
+
+
+def fit_thresholds(
+    items: Sequence[tuple[float, Block]],
+    tiers: Sequence[int],
+    costs: dict[int, float],
+    iterations: int = 60,
+) -> tuple[list[float], float]:
+    """Thresholds maximising tokens per ms over ``items`` (summary, block)
+    among policies whose tier is nondecreasing in the summary. Returns the
+    thresholds and the in-sample tokens per ms."""
+    usable = [(s, b) for s, b in items if all(b.tokens(k) is not None for k in tiers)]
+    if not usable:
+        raise ValueError("no uncensored block covers every tier")
+    usable.sort(key=lambda x: x[0])
+    groups: list[tuple[float, list[Block]]] = []
+    for s, b in usable:
+        if groups and groups[-1][0] == s:
+            groups[-1][1].append(b)
+        else:
+            groups.append((s, [b]))
+    m = len(tiers)
+    tok = [[sum(b.tokens(k) for b in g) for k in tiers] for _, g in groups]
+    cnt = [len(g) for _, g in groups]
+
+    def solve(price: float) -> list[int]:
+        n = len(groups)
+        best = [[-math.inf] * m for _ in range(n)]
+        back = [[0] * m for _ in range(n)]
+        for j in range(m):
+            best[0][j] = tok[0][j] - price * cnt[0] * costs[tiers[j]]
+        for i in range(1, n):
+            run, arg = -math.inf, 0
+            for j in range(m):
+                if best[i - 1][j] > run:
+                    run, arg = best[i - 1][j], j
+                best[i][j] = run + tok[i][j] - price * cnt[i] * costs[tiers[j]]
+                back[i][j] = arg
+        j = max(range(m), key=lambda x: best[n - 1][x])
+        assign = [0] * n
+        for i in range(n - 1, -1, -1):
+            assign[i] = j
+            j = back[i][j]
+        return assign
+
+    def value(assign: list[int]) -> float:
+        t = sum(tok[i][j] for i, j in enumerate(assign))
+        c = sum(cnt[i] * costs[tiers[j]] for i, j in enumerate(assign))
+        return t / c
+
+    price = 0.0
+    assign = solve(price)
+    for _ in range(iterations):
+        new_price = value(assign)
+        if abs(new_price - price) <= 1e-12 * max(1.0, new_price):
+            break
+        price = new_price
+        assign = solve(price)
+    lo, hi = groups[0][0], groups[-1][0]
+    thresholds = []
+    for boundary in range(1, m):
+        below = [groups[i][0] for i, j in enumerate(assign) if j < boundary]
+        above = [groups[i][0] for i, j in enumerate(assign) if j >= boundary]
+        if not above:
+            thresholds.append(hi + 1.0)
+        elif not below:
+            thresholds.append(lo - 1.0)
+        else:
+            thresholds.append(0.5 * (max(below) + min(above)))
+    return thresholds, value(assign)
+
+
+@dataclass
+class FitResult:
+    accept_weight: float
+    thresholds: list[float]
+    in_sample: float
+    replayed: float
+    chosen: dict[int, int]
+
+
+def fit(
+    requests: dict[str, list[Block]],
+    tiers: Sequence[int],
+    costs: dict[int, float],
+    age: int,
+    accept_weights: Sequence[float] = (0.0, 0.25, 0.5, 0.75, 1.0),
+    hysteresis: float = 0.0,
+    prior: float = 0.75,
+    decay: float = 0.9,
+    strength: float = 2.0,
+) -> tuple[FitResult, list[FitResult], dict[int, float]]:
+    """Fit thresholds per acceptance weight, replay each with the online
+    policy; returns the best (by replayed tokens per ms), all of them, and
+    the fixed-tier tokens per ms."""
+    tiers = sorted(tiers)
+    width = max(len(b.conf) for bl in requests.values() for b in bl)
+    if tiers[-1] > width:
+        raise ValueError(f"tier {tiers[-1]} wider than the dumped blocks ({width})")
+    missing = [k for k in tiers if k not in costs]
+    if missing:
+        raise ValueError(f"no step cost for tiers {missing}")
+    max_age = age + 1
+    dummy = [0.0] * (len(tiers) - 1)
+    results = []
+    for w in accept_weights:
+        items: list[tuple[float, Block]] = []
+        for blocks in requests.values():
+            summaries: list[float] = []
+            pol = _policy(tiers, width, dummy, w, 0.0, max_age, prior, decay, strength)
+            replay(blocks, pol, age, record=summaries, fixed_full_width=True)
+            items.extend(zip(summaries, blocks))
+        thresholds, in_sample = fit_thresholds(items, tiers, costs)
+        tokens = ms = 0.0
+        chosen: dict[int, int] = {}
+        for blocks in requests.values():
+            pol = _policy(
+                tiers, width, thresholds, w, hysteresis, max_age, prior, decay, strength
+            )
+            ks = replay(blocks, pol, age)
+            t, c = ratio(blocks, ks, costs)
+            tokens += t
+            ms += c
+            for k in ks:
+                chosen[k] = chosen.get(k, 0) + 1
+        results.append(FitResult(w, thresholds, in_sample, tokens / ms if ms else 0.0, chosen))
+    fixed = {}
+    for k in tiers:
+        tokens = ms = 0.0
+        for blocks in requests.values():
+            t, c = ratio(blocks, [k] * len(blocks), costs)
+            tokens += t
+            ms += c
+        fixed[k] = tokens / ms if ms else 0.0
+    best = max(results, key=lambda r: r.replayed)
+    return best, results, fixed
+
+
+def snippet(best: FitResult, tiers: Sequence[int], age: int, hysteresis: float) -> dict:
+    return {
+        "tiers": sorted(tiers),
+        "confidence": {
+            "thresholds": [round(t, 6) for t in best.thresholds],
+            "hysteresis": hysteresis,
+            "accept_weight": best.accept_weight,
+            "max_age": age + 1,
+        },
+    }
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    ap.add_argument("dumps", nargs="+", help="dspark-confidence.*.jsonl files")
+    ap.add_argument("--tiers", default="3,5,7,9,12")
+    ap.add_argument("--costs", required=True, help='JSON file {"3": ms, ...}')
+    ap.add_argument("--age", type=int, default=1, help="1: async scheduling, 0: sync")
+    ap.add_argument("--accept-weights", default="0,0.25,0.5,0.75,1")
+    ap.add_argument("--hysteresis", type=float, default=0.25)
+    ap.add_argument(
+        "--min-verified",
+        type=int,
+        default=None,
+        help="drop blocks verified at fewer drafts (default: the widest tier)",
+    )
+    ap.add_argument("--out", help="write the adaptive_k JSON here")
+    args = ap.parse_args(argv)
+    tiers = [int(x) for x in args.tiers.split(",")]
+    costs = {int(k): float(v) for k, v in json.loads(Path(args.costs).read_text()).items()}
+    weights = [float(x) for x in args.accept_weights.split(",")]
+    min_verified = max(tiers) if args.min_verified is None else args.min_verified
+    requests = load_dump(args.dumps, min_verified)
+    n_blocks = sum(len(b) for b in requests.values())
+    best, results, fixed = fit(
+        requests, tiers, costs, args.age, weights, hysteresis=args.hysteresis
+    )
+    print(f"{len(requests)} requests, {n_blocks} blocks, age {args.age}")
+    print("| policy | tok/s | tiers used |")
+    print("|---|---:|---|")
+    for k, r in fixed.items():
+        print(f"| fixed {k} | {1000 * r:.2f} | |")
+    for r in results:
+        used = ", ".join(f"{k}:{n}" for k, n in sorted(r.chosen.items()))
+        print(
+            f"| accept_weight {r.accept_weight} | {1000 * r.replayed:.2f} "
+            f"(fit {1000 * r.in_sample:.2f}) | {used} |"
+        )
+    out = snippet(best, tiers, args.age, args.hysteresis)
+    print(json.dumps(out))
+    if args.out:
+        Path(args.out).write_text(json.dumps(out, indent=1) + "\n")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
