+# ------------------------------------------------------ PPHandler wire formats
+
+
+class _Wire:
+    def __init__(self):
+        self.sent: deque[torch.Tensor] = deque()
+
+    def broadcast(self, tensor, src, group):
+        if group.is_last:
+            self.sent.append(tensor.clone())
+            return
+        got = self.sent.popleft()
+        assert got.shape == tensor.shape and got.dtype == tensor.dtype, (
+            f"wire mismatch: sent {tuple(got.shape)}/{got.dtype}, "
+            f"recv {tuple(tensor.shape)}/{tensor.dtype}"
+        )
+        tensor.copy_(got)
+
+
+class _FakeStream:
+    def wait_stream(self, other):
+        pass
+
+    def wait_event(self, ev):
+        pass
+
+    def record_event(self):
+        return object()
+
+
+def _make_pp_pair(monkeypatch, pp_size=2, k_max=KMAX):
+    from vllm.v1.worker.gpu import pp_utils
+
+    wire = _Wire()
+    monkeypatch.setattr(torch.cuda, "current_stream", lambda device=None: _FakeStream())
+    monkeypatch.setattr(torch.cuda, "Stream", lambda device=None: _FakeStream())
+    monkeypatch.setattr(torch.cuda, "stream", lambda s: nullcontext())
+    monkeypatch.setattr(torch.distributed, "broadcast", wire.broadcast)
+    monkeypatch.setattr(torch.Tensor, "record_stream", lambda self, s: None)
+
+    def _build(is_last):
+        group = SimpleNamespace(
+            is_last_rank=is_last,
+            last_rank=pp_size - 1,
+            world_size=pp_size,
+            make_sibling_device_group=lambda group_desc: SimpleNamespace(
+                is_last=is_last
+            ),
+        )
+        monkeypatch.setattr(pp_utils, "get_pp_group", lambda: group)
+        return pp_utils.PPHandler(
+            max_num_reqs=4, num_speculative_steps=k_max, device="cpu"
+        )
+
+    return _build(True), _build(False), wire
+
