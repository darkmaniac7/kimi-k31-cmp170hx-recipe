+    assert lat_us >= 0.0
+    assert transport == "p2p_ipc"
+    assert calls["requested_dev"] == ["cuda:2"]
+    assert calls["timeouts"] == [1234, 5000]
+    assert len(calls["shapes"]) == 2
+    assert calls["shapes"][1][0] * calls["shapes"][1][1] * 2 > slot_bytes
