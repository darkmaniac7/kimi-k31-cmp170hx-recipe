+@torch.inference_mode()
+def test_layer_prefill_of_a_few_hundred_tokens(harness):
+    """Two requests of 320 and 300 tokens in one prefill batch (every
+    context is below the top-k: the sparse path attends to all of it), then
+    a second chunk of each on top of the cached context."""
+    record = harness.step({0: 320, 1: 300}, seed=1)
+    out = record["out"]
+    assert out.shape == (620, harness.text.hidden_size) and out.dtype == torch.bfloat16
+    stats = _check_step(harness, record)
+    assert stats["selected_rows"] == 0
+    _check_step(harness, harness.step({0: 300, 1: 320}, seed=2))
+
+
+@torch.inference_mode()
+def test_layer_decode_one_row_past_the_topk(harness):
+    """One request prefilled to 2,560 tokens in chunks (the last chunk
+    selects 2,048 of more keys per row), then three single-token decodes and
+    one extend of eight tokens."""
+    selected = 0
+    for chunk in range(5):
+        stats = _check_step(harness, harness.step({0: 512}, seed=10 + chunk))
+        selected += stats["selected_rows"]
+        assert stats["scored"] is (chunk == 4)
+    assert selected == 512  # rows at positions 2048 .. 2559
+    for token in range(3):
+        record = harness.step({0: 1}, seed=20 + token)
+        index_metadata = record["index_metadata"]
+        assert index_metadata.num_decodes == 1 and index_metadata.num_prefills == 0
+        assert record["out"].shape[0] == 1
+        stats = _check_step(harness, record)
+        assert stats["scored"] and stats["selected_rows"] == 1
+    stats = _check_step(harness, harness.step({0: 8}, seed=30))
+    assert stats["scored"] and stats["selected_rows"] == 8
+
