+// ============================================================================
+// 4. ZERO-SPILL PURE-SHFL PREFILL KERNELS (4Nx2M gate_up, <= 17.7 KB SMEM)
+// ============================================================================
+template <int RID, int NT>
+__device__ __forceinline__ void prefill_one_mat_kg(
+    const RegCodebook<RID>& cb,
+    const uint32_t (&w)[RateTraits<RID>::WPL],
+    uint32_t s_u,
+    const half (*sh_cur)[136], int m_base_row, int lane,
+    float (&acc)[NT][4]
+) {
+  float ga[NT][4];
+#pragma unroll
+  for (int m = 0; m < NT; ++m) ga[m][0] = ga[m][1] = ga[m][2] = ga[m][3] = 0.0f;
+
+  const int l_m_base = m_base_row + (lane >> 4) * 8 + (lane & 7);
+  const int l_k_sub = ((lane >> 3) & 1) * 8;
+  uint32_t a[4];
+
+  auto run_kt = [&](int k_off) {
+    uint32_t b0, b1, b2, b3;
+    ldmatrix_x4(b0, b1, b2, b3, &sh_cur[l_m_base][k_off + l_k_sub]);
+    mma_m16n8k16(a, b0, b1, ga[0]);
+    mma_m16n8k16(a, b2, b3, ga[1]);
+    if constexpr (NT == 4) {
+      ldmatrix_x4(b0, b1, b2, b3, &sh_cur[16 + l_m_base][k_off + l_k_sub]);
+      mma_m16n8k16(a, b0, b1, ga[2]);
+      mma_m16n8k16(a, b2, b3, ga[3]);
+    }
+  };
+  cb.template decode_kt<0>(w, lane, a); run_kt(0);
+  cb.template decode_kt<1>(w, lane, a); run_kt(16);
+  cb.template decode_kt<2>(w, lane, a); run_kt(32);
+  cb.template decode_kt<3>(w, lane, a); run_kt(48);
+  cb.template decode_kt<4>(w, lane, a); run_kt(64);
+  cb.template decode_kt<5>(w, lane, a); run_kt(80);
+  cb.template decode_kt<6>(w, lane, a); run_kt(96);
+  cb.template decode_kt<7>(w, lane, a); run_kt(112);
+
+  const __half2 sh2 = *reinterpret_cast<const __half2*>(&s_u);
+  const float slo = __half2float(__low2half(sh2)), shi = __half2float(__high2half(sh2));
+#pragma unroll
+  for (int m = 0; m < NT; ++m) {
+    acc[m][0] = fmaf(slo, ga[m][0], acc[m][0]); acc[m][1] = fmaf(slo, ga[m][1], acc[m][1]);
+    acc[m][2] = fmaf(shi, ga[m][2], acc[m][2]); acc[m][3] = fmaf(shi, ga[m][3], acc[m][3]);
+  }
+}
+
+// 8 N-tiles x 1 M-tile (NT=4 per warp, 128 N-cols x 32 M-rows/CTA) with single-kg loop body:
+// Only 2 prefill_one_mat_kg calls per iteration (zero code bloat) while preserving pair-vectorized uint4/uint2 loads
+// -> 0 bytes stack frame on BOTH sm_80 & sm_120 across ALL 5 rates, <= 17.6 KB SMEM, ~10.2 ms at M=2048!
+template <int RID>
+__global__ void __launch_bounds__(256, 2) vq_moe_gate_up_prefill_kernel(
+    const half* __restrict__ x_f16,
+    const TileTask* __restrict__ tasks,
+    const int32_t* __restrict__ header,
+    const int32_t* __restrict__ sorted_rows,
+    const int64_t* __restrict__ packed_ptrs,
+    half* __restrict__ mid_out,
+    int H, int I, float situ_beta, float situ_lin_beta, float swiglu_limit
+) {
+  if ((header[1] & (1 << RID)) == 0) return;
+  constexpr int NT = 4, TILE_M = 32;
+  const int num_tasks = header[0], n_blocks = I / 128;
+  if (blockIdx.x >= num_tasks * n_blocks) return;
+
+  const int task_id = blockIdx.x / n_blocks, nb_id = blockIdx.x % n_blocks;
+  const TileTask task = tasks[task_id];
+  if ((task.rids & 0xffffu) != static_cast<uint32_t>(RID | (RID << 8))) return;
+
+  using T = RateTraits<RID>;
+  const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31, g = lane >> 2, t = lane & 3;
+  const int nt = nb_id * 8 + warp;
+
+  __shared__ __align__(16) half sh_x[2][TILE_M][136];
+  __shared__ int32_t sh_rows[TILE_M];
+
+  if (threadIdx.x < TILE_M) sh_rows[threadIdx.x] = (threadIdx.x < task.count) ? sorted_rows[task.start + threadIdx.x] : -1;
+  __syncthreads();
+
+  auto issue_x_stage = [&](int stage, int kg) {
+    const int k_base = kg * 128;
+#pragma unroll
+    for (int iter = 0; iter < 2; ++iter) {
+      const int idx = iter * 256 + threadIdx.x;
+      const int tm = idx >> 4, kc = (idx & 15) << 3, r = sh_rows[tm];
+      cp_async_ca_16(&sh_x[stage][tm][kc], x_f16 + static_cast<int64_t>(r >= 0 ? r : 0) * H + k_base + kc, r >= 0);
+    }
+    cp_async_commit();
+  };
+
+  const int64_t* eptrs = packed_ptrs + static_cast<int64_t>(task.expert) * 9;
+  const int K_groups = H >> 7;
+  const int32_t nt_base = nt * K_groups;
+  RegCodebook<RID> cb1, cb3;
+  if constexpr (T::D == 2) {
+    cb1.load(reinterpret_cast<const half*>(eptrs[2]), lane);
+    cb3.load(reinterpret_cast<const half*>(eptrs[5]), lane);
+  }
+
+  float acc_g[NT][4], acc_u[NT][4];
+#pragma unroll
+  for (int m = 0; m < NT; ++m) for (int i = 0; i < 4; ++i) { acc_g[m][i] = 0.0f; acc_u[m][i] = 0.0f; }
+
+  issue_x_stage(0, 0);
+  cp_async_wait<0>();
+  __syncthreads();
+
+  uint32_t w1_carry = 0u, w3_carry = 0u;
+#pragma unroll 1
+  for (int kg = 0; kg < K_groups; ++kg) {
+    const int cur = kg & 1, nxt = cur ^ 1;
+    if (kg + 1 < K_groups) issue_x_stage(nxt, kg + 1);
+
+    const int32_t pair_grp = nt_base + (kg & ~1);
+    const uint32_t* p1 = reinterpret_cast<const uint32_t*>(eptrs[0]) + static_cast<int64_t>(pair_grp) * (T::WPL * 32);
+    const uint32_t* p3 = reinterpret_cast<const uint32_t*>(eptrs[3]) + static_cast<int64_t>(pair_grp) * (T::WPL * 32);
+    const uint32_t s1_cur = ld_cs_u32(reinterpret_cast<const uint32_t*>(eptrs[1]) + static_cast<int64_t>(pair_grp) * 8 + g * 2 + cur);
+    const uint32_t s3_cur = ld_cs_u32(reinterpret_cast<const uint32_t*>(eptrs[4]) + static_cast<int64_t>(pair_grp) * 8 + g * 2 + cur);
+
+    uint32_t w_cur[T::WPL];
+    // w1
+    if constexpr (T::WPL == 4) {
+      const uint4 v = ld_cs_v4(reinterpret_cast<const uint4*>(p1 + cur * 128) + lane);
+      w_cur[0] = v.x; w_cur[1] = v.y; w_cur[2] = v.z; w_cur[3] = v.w;
+    } else if constexpr (T::WPL == 3) {
+      if (cur == 0) {
+        const uint4 v = ld_cs_v4(reinterpret_cast<const uint4*>(p1) + lane);
+        w_cur[0] = v.x; w_cur[1] = v.y; w_cur[2] = v.z; w1_carry = v.w;
+      } else {
+        const uint2 v = ld_cs_v2(reinterpret_cast<const uint2*>(p1 + 128) + lane);
+        w_cur[0] = w1_carry; w_cur[1] = v.x; w_cur[2] = v.y;
+      }
+    } else {
+      if (cur == 0) {
+        const uint4 va = ld_cs_v4(reinterpret_cast<const uint4*>(p1) + lane);
+        const uint4 vb = ld_cs_v4(reinterpret_cast<const uint4*>(p1 + 128) + lane);
+        w_cur[0] = va.x; w_cur[1] = va.y; w_cur[2] = va.z; w_cur[3] = va.w; w_cur[4] = vb.x;
+      } else {
+        const uint4 vb = ld_cs_v4(reinterpret_cast<const uint4*>(p1 + 128) + lane);
+        const uint2 vc = ld_cs_v2(reinterpret_cast<const uint2*>(p1 + 256) + lane);
+        w_cur[0] = vb.y; w_cur[1] = vb.z; w_cur[2] = vb.w; w_cur[3] = vc.x; w_cur[4] = vc.y;
+      }
+    }
+    if constexpr (T::D == 2) {
+      prefill_one_mat_kg<RID, NT>(cb1, w_cur, s1_cur, sh_x[cur], 0, lane, acc_g);
+    } else {
+      RegCodebook<RID> cb; cb.load(reinterpret_cast<const half*>(eptrs[2]), lane);
+      prefill_one_mat_kg<RID, NT>(cb, w_cur, s1_cur, sh_x[cur], 0, lane, acc_g);
+    }
+
+    // w3
+    if constexpr (T::WPL == 4) {
+      const uint4 v = ld_cs_v4(reinterpret_cast<const uint4*>(p3 + cur * 128) + lane);
+      w_cur[0] = v.x; w_cur[1] = v.y; w_cur[2] = v.z; w_cur[3] = v.w;
+    } else if constexpr (T::WPL == 3) {
+      if (cur == 0) {
+        const uint4 v = ld_cs_v4(reinterpret_cast<const uint4*>(p3) + lane);
+        w_cur[0] = v.x; w_cur[1] = v.y; w_cur[2] = v.z; w3_carry = v.w;
+      } else {
+        const uint2 v = ld_cs_v2(reinterpret_cast<const uint2*>(p3 + 128) + lane);
+        w_cur[0] = w3_carry; w_cur[1] = v.x; w_cur[2] = v.y;
+      }
+    } else {
+      if (cur == 0) {
+        const uint4 va = ld_cs_v4(reinterpret_cast<const uint4*>(p3) + lane);
+        const uint4 vb = ld_cs_v4(reinterpret_cast<const uint4*>(p3 + 128) + lane);
+        w_cur[0] = va.x; w_cur[1] = va.y; w_cur[2] = va.z; w_cur[3] = va.w; w_cur[4] = vb.x;
+      } else {
+        const uint4 vb = ld_cs_v4(reinterpret_cast<const uint4*>(p3 + 128) + lane);
+        const uint2 vc = ld_cs_v2(reinterpret_cast<const uint2*>(p3 + 256) + lane);
+        w_cur[0] = vb.y; w_cur[1] = vb.z; w_cur[2] = vb.w; w_cur[3] = vc.x; w_cur[4] = vc.y;
+      }
+    }
+    if constexpr (T::D == 2) {
+      prefill_one_mat_kg<RID, NT>(cb3, w_cur, s3_cur, sh_x[cur], 0, lane, acc_u);
+    } else {
+      RegCodebook<RID> cb; cb.load(reinterpret_cast<const half*>(eptrs[5]), lane);
+      prefill_one_mat_kg<RID, NT>(cb, w_cur, s3_cur, sh_x[cur], 0, lane, acc_u);
+    }
+
+    if (kg + 1 < K_groups) { cp_async_wait<0>(); __syncthreads(); }
+  }
+
+  const int row0 = nt * 16;
+  const float inv_sb = (situ_beta > 0.0f) ? __frcp_rn(situ_beta) : 0.0f;
+  const float inv_slb = (situ_lin_beta > 0.0f) ? __frcp_rn(situ_lin_beta) : 0.0f;
+#pragma unroll
+  for (int m = 0; m < NT; ++m) {
+    const int tm0 = m * 8 + 2 * t, tm1 = tm0 + 1;
+    if (tm0 < task.count) {
+      const int64_t pos0 = static_cast<int64_t>(task.start + tm0) * I;
+      mid_out[pos0 + row0 + g]     = __float2half_rn(apply_act_fast(acc_g[m][0], acc_u[m][0], situ_beta, inv_sb, situ_lin_beta, inv_slb, swiglu_limit));
+      mid_out[pos0 + row0 + g + 8] = __float2half_rn(apply_act_fast(acc_g[m][2], acc_u[m][2], situ_beta, inv_sb, situ_lin_beta, inv_slb, swiglu_limit));
+    }
+    if (tm1 < task.count) {
+      const int64_t pos1 = static_cast<int64_t>(task.start + tm1) * I;
+      mid_out[pos1 + row0 + g]     = __float2half_rn(apply_act_fast(acc_g[m][1], acc_u[m][1], situ_beta, inv_sb, situ_lin_beta, inv_slb, swiglu_limit));
+      mid_out[pos1 + row0 + g + 8] = __float2half_rn(apply_act_fast(acc_g[m][3], acc_u[m][3], situ_beta, inv_sb, situ_lin_beta, inv_slb, swiglu_limit));
+    }
+  }
+}
+
+template <int RID>
+__device__ __forceinline__ void prefill_step_generic(
+    const uint32_t* __restrict__ w_idx, const uint32_t* __restrict__ w_sc, const half* __restrict__ w_cb,
+    int64_t nt_base, int kg, int K_groups, const half (*sh_cur)[136], int lane, int g, float (&acc)[4][4]
+) {
+  using T = RateTraits<RID>;
+  RegCodebook<RID> cb; cb.load(w_cb, lane);
+  uint32_t w[T::WPL]; uint32_t s_u = 0u;
+  load_single_kg<RID>(w_idx, w_sc, nt_base, kg, K_groups, lane, g, w, s_u);
+  float ga[4][4];
+#pragma unroll
+  for (int m = 0; m < 4; ++m) ga[m][0] = ga[m][1] = ga[m][2] = ga[m][3] = 0.0f;
+  const int l_m_base = (lane >> 4) * 8 + (lane & 7);
+  const int l_k_sub = ((lane >> 3) & 1) * 8;
+  uint32_t a[4];
+  auto run_kt = [&](int k_off) {
+    uint32_t b00, b01, b10, b11, b20, b21, b30, b31;
+    ldmatrix_x4(b00, b01, b10, b11, &sh_cur[l_m_base][k_off + l_k_sub]);
+    ldmatrix_x4(b20, b21, b30, b31, &sh_cur[16 + l_m_base][k_off + l_k_sub]);
