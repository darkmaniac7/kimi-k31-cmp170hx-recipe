+void fused_kda_spec_verify_records(
+    const at::Tensor& mixed_qkv,
+    at::Tensor conv_state,
+    const at::Tensor& conv_weight,
+    const std::optional<at::Tensor>& conv_bias,
+    const at::Tensor& raw_g,
+    const at::Tensor& raw_beta,
+    const at::Tensor& A_log,
+    const at::Tensor& dt_bias,
+    const at::Tensor& g2,
+    const at::Tensor& norm_weight,
+    at::Tensor recurrent_state,
+    const at::Tensor& spec_state_indices,
+    const at::Tensor& query_start_loc,
+    const at::Tensor& num_accepted_tokens,
+    double lower_bound,
+    double norm_eps,
+    at::Tensor out,
+    at::Tensor state_mode,
+    const std::optional<at::Tensor>& fold_src_indices,
+    const std::optional<at::Tensor>& fold_counts) {
+  TORCH_CHECK(mixed_qkv.is_cuda() && mixed_qkv.scalar_type() == at::kBFloat16 &&
+                  mixed_qkv.dim() == 2 && mixed_qkv.stride(1) == 1,
+              "mixed_qkv must be CUDA BF16 [T, 3*H*128] with stride(-1)==1");
+  TORCH_CHECK(query_start_loc.is_cuda() && query_start_loc.is_contiguous() &&
+                  query_start_loc.dim() == 1 && query_start_loc.size(0) >= 1 &&
+                  (query_start_loc.scalar_type() == at::kInt ||
+                   query_start_loc.scalar_type() == at::kLong),
+              "query_start_loc must be contiguous CUDA INT32/INT64 [N+1]");
+  const int64_t T = mixed_qkv.size(0);
+  const int64_t N = query_start_loc.size(0) - 1;
+  if (N == 0 || T == 0) return;
+
+  TORCH_CHECK(recurrent_state.is_cuda() && recurrent_state.scalar_type() == at::kFloat &&
+                  recurrent_state.dim() == 4,
+              "recurrent_state must be CUDA FP32 [cache, H, 128, 128]");
+  const int64_t num_blocks = recurrent_state.size(0);
+  const int64_t H = recurrent_state.size(1);
+  const int64_t D = recurrent_state.size(2);
+  TORCH_CHECK(D == 128 && recurrent_state.size(3) == 128,
+              "fused_kda_spec_verify_records requires head_dim==128");
