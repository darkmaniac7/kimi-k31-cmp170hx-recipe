@@ -0,0 +1,68 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""A rank whose successful output is discarded must still observe device errors."""
+from queue import Queue
+from types import SimpleNamespace
+
+import pytest
+
+from vllm.v1.executor.multiproc_executor import WorkerProc
+from vllm.v1.outputs import AsyncModelRunnerOutput
+
+
+class CheckedOutput(AsyncModelRunnerOutput):
+    _sm80_step_errors = True
+
+    def __init__(self, fail):
+        self.fail = fail
+        self.reads = 0
+
+    def get_output(self):
+        self.reads += 1
+        if self.fail:
+            raise ValueError("round-once requires a finite exponent span")
+        return "valid output"
+
+
+def _worker(output, rank=3):
+    worker = object.__new__(WorkerProc)
+    worker.rank = rank
+    worker.worker = SimpleNamespace(sample_tokens=lambda: output)
+    worker.use_async_scheduling = True
+    worker.async_output_queue = Queue()
+    replies = []
+    worker.worker_response_mq = SimpleNamespace(enqueue=replies.append)
+    return worker, replies
+
+
+@pytest.mark.parametrize("fail", [False, True])
+def test_non_output_rank_consumes_existing_async_output(fail):
+    output = CheckedOutput(fail)
+    worker, replies = _worker(output)
+    worker._execute_worker_rpc(("sample_tokens", (), {}, 0))
+    assert not worker.async_output_queue.empty(), "the non-output rank dropped its device error check"
+    assert output.reads == 0, "the RPC thread must not wait for the output copy"
+    queued = worker.async_output_queue.get_nowait()
+    if fail:
+        with pytest.raises(ValueError, match="finite exponent span"):
+            worker.enqueue_output(queued)
+    else:
+        worker.enqueue_output(queued)
+    assert output.reads == 1
+    assert replies == [], "a discarded result must not corrupt the next RPC response"
+
+
+def test_default_non_output_behavior_is_unchanged():
+    worker, replies = _worker(object())
+    worker._execute_worker_rpc(("sample_tokens", (), {}, 0))
+    assert worker.async_output_queue.empty()
+    assert replies == []
+
+
+def test_reply_rank_keeps_the_normal_failure_response():
+    output = CheckedOutput(True)
+    worker, replies = _worker(output, rank=0)
+    worker._execute_worker_rpc(("sample_tokens", (), {}, 0))
+    worker.enqueue_output(worker.async_output_queue.get_nowait())
+    assert output.reads == 1
+    assert replies == [(WorkerProc.ResponseStatus.FAILURE, "round-once requires a finite exponent span")]
diff --git a/tests/sm80/test_triton_mla_sparse_block_stride.py b/tests/sm80/test_triton_mla_sparse_block_stride.py
new file mode 100644
index 0000000000..07cc6523fe
--- /dev/null
+++ b/tests/sm80/test_triton_mla_sparse_block_stride.py
@@ -0,0 +1,151 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The sm80 Triton sparse MLA backend reads the cache as flat rows, so packed
+KV blocks must sit a whole number of rows apart.
+
+With a block-outermost layout every layer's page shares one physical block,
+and the block stride is rounded only to the alignments the backends publish
+through ``customize_spec``. The cache view must then pass
+``flat_kv_row_view``. The geometry is GLM-5.3-Flash's TP4 rank-0 target, built
+on meta from the deployed checkpoint config, with the hybrid block geometry
+the platform sets at engine start for it (1152-token blocks, KDA pages padded
+to the attention page).
+
+Run in a fresh process with CUDA_VISIBLE_DEVICES='' HF_HUB_OFFLINE=1.
+"""
+import pytest
+import torch
+
+from tests.models.test_native_checkpoint_config_meta import (  # noqa: F401
+    _parallel_groups,
+    _registered_model_cls,
+    _vllm_config,
+    meta_platform,
+)
+from vllm.config import set_current_vllm_config
+from vllm.utils.torch_utils import set_default_torch_dtype
+from vllm.v1.attention.backend import AttentionBackend
+from vllm.v1.attention.backends.mla.sparse_utils import flat_kv_row_view
+from vllm.v1.kv_cache_interface import MLAAttentionSpec
+
+# Platform._align_hybrid_block_size for this model: the smallest multiple of
+# 128 tokens whose MLA page holds a KDA state.
+_BLOCK_SIZE = 1152
+_HEAD_DIM = 512  # the latent row GLM-5.3-Flash caches per token
+_ROW_BYTES = _HEAD_DIM * torch.tensor([], dtype=torch.bfloat16).element_size()
+
+
+def _served_glm_tp4_specs(monkeypatch):
+    from vllm.v1.worker.gpu.attn_utils import get_kv_cache_spec
+
+    _parallel_groups(monkeypatch, 4, 0)
+    config = _vllm_config("glm53_flash", 4, with_dflash=True)
+    cache = config.cache_config
+    cache.kv_cache_layout = "BLHNC"
+    cache.mamba_cache_mode = "align"
+    cache.block_size = cache.mamba_block_size = _BLOCK_SIZE
+    cache.mamba_page_size_padded = _BLOCK_SIZE * _ROW_BYTES
+    Glm5NextForCausalLM = _registered_model_cls("Glm5NextForCausalLM")
+    with set_current_vllm_config(config), set_default_torch_dtype(torch.bfloat16):
+        with torch.device("meta"):
+            Glm5NextForCausalLM(vllm_config=config)
+        specs = get_kv_cache_spec(config)
+    return config, specs
+
+
+def _block_stride_bytes(config, specs):
+    from vllm.v1.core import kv_cache_planning
+
+    groups = kv_cache_planning.get_kv_cache_groups(config, specs)
+    layout = config.cache_config.get_resolved_kv_cache_layout()
+    assert layout.is_block_outermost
+    return kv_cache_planning._get_kv_cache_bytes_per_block(groups, layout)
+
+
+def _mla_specs(specs):
+    mla = {
+        name: spec
+        for name, spec in specs.items()
+        if isinstance(spec, MLAAttentionSpec) and spec.dtype == torch.bfloat16
+    }
+    assert mla, "no MLA attention layer in the served GLM target"
+    assert {spec.head_size for spec in mla.values()} == {_HEAD_DIM}
+    assert {spec.block_size for spec in mla.values()} == {_BLOCK_SIZE}
+    return mla
+
+
+def _view_of_packed_cache(stride_bytes):
+    """A two-block cache view with the packed block stride, as the runner binds
+    it to an MLA layer (bf16 latent rows)."""
+    elem = torch.tensor([], dtype=torch.bfloat16).element_size()
+    assert stride_bytes % elem == 0
+    stride = stride_bytes // elem
+    storage = torch.zeros(stride + _BLOCK_SIZE * _HEAD_DIM, dtype=torch.bfloat16)
+    return storage.as_strided((2, _BLOCK_SIZE, _HEAD_DIM), (stride, _HEAD_DIM, 1))
+
+
+def test_served_glm_mla_layers_ask_for_whole_row_blocks(monkeypatch, meta_platform):
+    from vllm.sm80.attention.triton_mla_sparse import TritonMLASparseBackend
+
+    config, specs = _served_glm_tp4_specs(monkeypatch)
+    from vllm.v1.worker.gpu.attn_utils import get_layers_from_vllm_config
+    from vllm.model_executor.layers.attention_layer_base import AttentionLayerBase
+
+    layers = get_layers_from_vllm_config(config, AttentionLayerBase)
+    for name, spec in _mla_specs(specs).items():
+        assert layers[name].get_attn_backend() is TritonMLASparseBackend
+        assert spec.get_block_stride_alignment() == _ROW_BYTES
+
+
+def test_packed_block_stride_is_whole_rows(monkeypatch, meta_platform):
+    config, specs = _served_glm_tp4_specs(monkeypatch)
+    _mla_specs(specs)
+    stride = _block_stride_bytes(config, specs)
+    assert stride % _ROW_BYTES == 0
+    rows, stride_rows = flat_kv_row_view(_view_of_packed_cache(stride), _BLOCK_SIZE)
+    assert stride_rows == stride // _ROW_BYTES
+    assert rows.shape == (stride_rows + _BLOCK_SIZE, _HEAD_DIM)
+
+
+def test_without_the_alignment_the_packed_stride_misaddresses(
+    monkeypatch, meta_platform
+):
+    """The served failure: without ``customize_spec`` the packed stride is not
+    a whole number of rows and ``flat_kv_row_view`` refuses the cache."""
+    from vllm.sm80.attention.triton_mla_sparse import TritonMLASparseBackend
+
+    monkeypatch.setattr(
+        TritonMLASparseBackend,
+        "customize_spec",
+        classmethod(AttentionBackend.customize_spec.__func__),
+    )
+    config, specs = _served_glm_tp4_specs(monkeypatch)
+    _mla_specs(specs)
+    stride = _block_stride_bytes(config, specs)
+    assert stride % _ROW_BYTES != 0
+    with pytest.raises(AssertionError, match="not a whole number of rows"):
+        flat_kv_row_view(_view_of_packed_cache(stride), _BLOCK_SIZE)
+
+
+def test_qwen_layers_do_not_use_the_sm80_triton_mla_backend(
+    monkeypatch, meta_platform
+):
+    """Qwen3.8-Flash-Next's caches (QSA included) are served by other
+    backends, so the alignment above does not change its KV layout."""
+    from vllm.model_executor.layers.attention_layer_base import AttentionLayerBase
+    from vllm.models.qwen4_exp.nvidia.model import Qwen4ExpForCausalLM
+    from vllm.sm80.attention.triton_mla_sparse import TritonMLASparseBackend
+    from vllm.v1.worker.gpu.attn_utils import get_layers_from_vllm_config
+
+    _parallel_groups(monkeypatch, 2, 0)
+    config = _vllm_config("qwen38_flash_next", 2)
+    with set_current_vllm_config(config), set_default_torch_dtype(torch.bfloat16):
+        with torch.device("meta"):
+            Qwen4ExpForCausalLM(vllm_config=config)
+    layers = get_layers_from_vllm_config(config, AttentionLayerBase)
+    assert layers
+    assert not [
+        name
+        for name, layer in layers.items()
+        if layer.get_attn_backend() is TritonMLASparseBackend
+    ]
diff --git a/tests/sm80/update_seams.py b/tests/sm80/update_seams.py
new file mode 100644
index 0000000000..84ee2a1177
--- /dev/null
+++ b/tests/sm80/update_seams.py
@@ -0,0 +1,173 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Measure and rewrite the upstream seam pins in seams.yaml.
+
+A seam is an upstream object the sm80 fork code relies on without editing
+it. seams.yaml records a fingerprint of each one; test_seams.py fails when
+an upstream change moves a fingerprint. After checking that change against
+the row's `why`, run this script to record the new fingerprints:
+
+    python tests/sm80/update_seams.py            # rewrite every row
+    python tests/sm80/update_seams.py ID [ID..]  # rewrite only these rows
+
+Run it with the repository root importable (for example PYTHONPATH=.).
+"""
+
+import argparse
+import hashlib
+import importlib
+import inspect
+import sys
+import textwrap
+from pathlib import Path
+from typing import Any
+
+import yaml
+
+SEAMS_PATH = Path(__file__).with_name("seams.yaml")
+
+CODE_KINDS = ("function", "method")
+ATTR_KINDS = ("module_attr", "class_attr")
+KINDS = CODE_KINDS + ATTR_KINDS + ("dict_contract",)
+
+FIELD_ORDER = ("id", "kind", "target", "why", "sha256", "signature", "type", "value")
+
+HEADER = """\
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+#
+# Upstream seams the sm80 fork code relies on without editing them.
+# Checked by tests/sm80/test_seams.py. After checking an upstream change to
+# a seam, rewrite the pins with: python tests/sm80/update_seams.py [ID ...]
+#
+# Fields:
+#   id         unique row name
+#   kind       function | method | class_attr | module_attr | dict_contract
+#   target     'module:qualname'
+#   why        what the fork code depends on
+#   sha256     sha256 of textwrap.dedent(inspect.getsource(obj)) (code kinds)
+#   signature  str(inspect.signature(obj)) (code kinds)
+#   type       type name of the value (attr kinds and dict_contract)
+#   value      exact value, for constants only (attr kinds, optional)
+#   dict_contract rows also require every value to be a zero-arg callable.
+"""
+
+
+def load_rows(path: Path = SEAMS_PATH) -> list[dict[str, Any]]:
+    with open(path) as f:
+        data = yaml.safe_load(f)
+    rows = data["seams"]
+    ids = [row["id"] for row in rows]
+    duplicates = sorted({i for i in ids if ids.count(i) > 1})
+    if duplicates:
+        raise ValueError(f"duplicate seam ids in {path}: {duplicates}")
+    for row in rows:
+        if row["kind"] not in KINDS:
+            raise ValueError(f"seam {row['id']}: unknown kind {row['kind']!r}")
+    return rows
+
+
+def resolve(target: str) -> Any:
+    """Import 'module:qualname' and return the object it names."""
+    module_name, _, qualname = target.partition(":")
+    obj: Any = importlib.import_module(module_name)
+    for part in qualname.split("."):
+        obj = getattr(obj, part)
+    return obj
+
+
+def source_sha256(obj: Any) -> str:
+    source = textwrap.dedent(inspect.getsource(obj))
+    return hashlib.sha256(source.encode()).hexdigest()
+
+
+def zero_arg_callable(value: Any) -> bool:
+    if not callable(value):
+        return False
+    try:
+        signature = inspect.signature(value)
+    except (TypeError, ValueError):
+        return False
+    return all(
+        p.default is not p.empty or p.kind in (p.VAR_POSITIONAL, p.VAR_KEYWORD)
+        for p in signature.parameters.values()
+    )
+
+
+def measure(row: dict[str, Any]) -> dict[str, Any]:
+    """Return the pinned fields of `row` as found in the importable tree.
+
+    Raises whatever import or attribute lookup raises for a missing target.
+    """
+    obj = resolve(row["target"])
+    kind = row["kind"]
+    if kind in CODE_KINDS:
+        return {
+            "sha256": source_sha256(obj),
+            "signature": str(inspect.signature(obj)),
+        }
+    measured: dict[str, Any] = {"type": type(obj).__name__}
+    if kind in ATTR_KINDS:
+        if "value" in row:
+            measured["value"] = obj
+    else:  # dict_contract
+        items = obj.items() if isinstance(obj, dict) else ()
+        bad = sorted(str(k) for k, v in items if not zero_arg_callable(v))
+        if bad:
+            raise TypeError(
+                f"{row['target']} values must be zero-arg callables; "
+                f"offending keys: {bad}"
+            )
+    return measured
+
+
+def dump_rows(rows: list[dict[str, Any]], path: Path = SEAMS_PATH) -> None:
+    ordered = []
+    for row in rows:
+        known = [k for k in FIELD_ORDER if k in row]
+        extra = [k for k in row if k not in FIELD_ORDER]
+        ordered.append({k: row[k] for k in known + extra})
+    body = yaml.safe_dump(
+        {"seams": ordered}, sort_keys=False, width=4096, default_flow_style=False
+    )
+    path.write_text(HEADER + "\n" + body.replace("\n- id:", "\n\n- id:"))
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("ids", nargs="*", help="seam ids to rewrite (default: all)")
+    parser.add_argument("--file", type=Path, default=SEAMS_PATH)
+    args = parser.parse_args(argv)
+
+    rows = load_rows(args.file)
+    known_ids = {row["id"] for row in rows}
+    unknown = sorted(set(args.ids) - known_ids)
+    if unknown:
+        parser.error(f"unknown seam ids: {unknown}")
+    selected = set(args.ids) or known_ids
+
+    failed = 0
+    for row in rows:
+        if row["id"] not in selected:
+            continue
+        try:
+            measured = measure(row)
+        except Exception as exc:
+            failed += 1
+            print(f"FAILED {row['id']}: {type(exc).__name__}: {exc}", file=sys.stderr)
+            continue
+        changed = [k for k, v in measured.items() if row.get(k) != v]
+        row.update(measured)
+        status = f"updated ({', '.join(changed)})" if changed else "same"
+        print(f"{row['id']}: {status}")
+
+    if failed:
+        print(f"{failed} seam(s) could not be measured; file left unchanged",
+              file=sys.stderr)
+        return 1
+    dump_rows(rows, args.file)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
