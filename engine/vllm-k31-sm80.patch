+@pytest.mark.parametrize("num_blocks", list(range(9)))
+def test_attn_res_all_num_blocks_0_to_8(monkeypatch, num_blocks):
+    import importlib; ar_mod = importlib.import_module('vllm.models.kimi_k3.nvidia.ops.attn_res')
+
+    _clear_glue_env(monkeypatch)
+    fake = FakeGlueOps().install(monkeypatch)
+    monkeypatch.setenv("VLLM_K31_GLUE_ATTNRES", "1")
+
+    torch.manual_seed(100 + num_blocks)
+    M, H = 4, 64
+    prefix = torch.randn((M, H), dtype=torch.bfloat16) * 0.5
+    delta = torch.randn((M, H), dtype=torch.bfloat16) * 0.2 if num_blocks > 0 else None
+    delta2 = (
+        torch.randn((M, H), dtype=torch.bfloat16) * 0.2 if num_blocks >= 2 else None
+    )
+    blocks = torch.randn((M, 8, H), dtype=torch.bfloat16) * 0.5
+    nw = torch.randn((H,), dtype=torch.bfloat16) * 0.2 + 1.0
+    qkw = torch.randn((H,), dtype=torch.bfloat16) * 0.1
+    onw = (
+        torch.randn((H,), dtype=torch.bfloat16) * 0.2 + 1.0
+        if num_blocks < 8
+        else None
+    )
+    wb = num_blocks if num_blocks in (0, 1, 7) else -1
+
+    ref_out, ref_p, ref_b = ref_attn_res_rmsnorm(
+        prefix, delta, delta2, blocks, nw, qkw, onw, num_blocks, wb, 1e-5, 1e-5
+    )
+
+    p_got = prefix.clone()
+    b_got = blocks.clone()
+    out = ar_mod.attn_res(
+        p_got,
+        delta,
+        b_got,
+        nw,
+        qkw,
+        onw,
+        num_blocks=num_blocks,
+        block_write_idx=wb,
+        eps=1e-5,
+        output_norm_eps=1e-5,
+        delta2=delta2,
+    )
+
+    calls = fake.calls_for("attn_res_rmsnorm")
+    assert len(calls) == 1
+    assert calls[0]["num_blocks"] == num_blocks
+    assert calls[0]["block_write_idx"] == wb
+    assert calls[0]["has_delta"] == (delta is not None)
+    assert calls[0]["has_delta2"] == (delta2 is not None)
+    assert calls[0]["apply_out_norm"] == (onw is not None)
+    assert torch.equal(out, ref_out)
+    assert torch.equal(p_got, ref_p)
+    assert torch.equal(b_got, ref_b)
