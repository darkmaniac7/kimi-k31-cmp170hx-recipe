+def test_worker_execute_model_pp4_tp2_packed_no_metadata_and_early_return(
+    monkeypatch,
+):
+    import vllm.v1.worker.gpu_worker as gw
+
+    monkeypatch.setenv("VLLM_PP_PACKED_HOP", "1")
+    monkeypatch.setenv("VLLM_PP_HOP_NO_METADATA", "1")
+
+    wire = _Wire(world_size=4)
+    groups_and_dists = [wire.group(r) for r in range(4)]
+    tp_group = SimpleNamespace(world_size=2)
+    monkeypatch.setattr(gw, "get_tp_group", lambda: tp_group)
+
+    stage_received: list[dict[str, torch.Tensor]] = []
+    stage_expected_final: list[dict[str, torch.Tensor]] = []
+    drop_last_stage = {"active": False}
+
+    class _StageRunner:
+        is_pooling_model = False
+
+        def __init__(self, rank: int):
+            self.rank = rank
+            self.adaptive_verification = None
+            self.pcp_manager = None
+            self.ubatch_runner = None
+            self.intermediate_tensors = (
+                None
+                if rank == 0
+                else IntermediateTensors(
+                    _k31_boundary(
+                        rows=128,
+                        num_blocks=K31_BOUNDARY_BLOCKS[rank - 1],
+                        hidden_size=32,
+                    )
+                )
+            )
+
+        def pp_hop_rows(self, sched):
+            return GPUModelRunner.pp_hop_rows(self, sched)
+
+        def execute_model(self, sched, intermediate_tensors):
+            m = sched.total_num_scheduled_tokens
+            if self.rank == 3 and drop_last_stage["active"]:
+                # Simulate PipeSpec dropped Chunk B returning before reading
+                # intermediate_tensors; Worker must still drain the irecv.
+                return None
+            if self.rank > 0:
+                got = intermediate_tensors.tensors
+                if self.rank == 3:
+                    stage_received.append({k: v.clone() for k, v in got.items()})
+                    return gw.ModelRunnerOutput.__new__(gw.ModelRunnerOutput)
+                out_blocks = K31_BOUNDARY_BLOCKS[self.rank]
+                # Carry received hidden_states forward and extend residual blocks.
+                next_res = torch.zeros(
+                    m, out_blocks, 32, dtype=torch.bfloat16
+                )
+                next_res[:, : got["residual"].shape[1], :].copy_(got["residual"])
+                next_res[:, -1, :].copy_(got["hidden_states"])
+                out = {"hidden_states": got["hidden_states"] + 1.0, "residual": next_res}
+                if self.rank == 2:
+                    stage_expected_final.append({k: v.clone() for k, v in out.items()})
+                return IntermediateTensors(out)
+            return IntermediateTensors(
+                _k31_boundary(rows=m, num_blocks=K31_BOUNDARY_BLOCKS[0], hidden_size=32, seed=m)
+            )
+
+    workers = [
+        _make_mock_worker(gw, rank=r, world_size=4, runner=_StageRunner(r))
+        for r in range(4)
+    ]
+    # Bind each worker's PackedHop to the in-memory wire dist for its stage.
+    for r, w in enumerate(workers):
+        g, d = groups_and_dists[r]
+        monkeypatch.setattr(gw, "get_pp_group", lambda _g=g: _g)
+        hop = gw._resolve_pp_hop(w)
+        assert isinstance(hop, PackedHop) and hop.no_metadata
+        hop.dist = d
+
+    exec_fn = inspect.unwrap(gw.Worker.execute_model)
+    token_counts = [8, 4, 1, 16, 64, 7]
+    for m in token_counts:
+        sched = SimpleNamespace(total_num_scheduled_tokens=m)
+        for r, w in enumerate(workers):
+            g, _ = groups_and_dists[r]
+            monkeypatch.setattr(gw, "get_pp_group", lambda _g=g: _g)
+            exec_fn(w, sched)
+
+    assert len(stage_received) == len(token_counts)
+    for got, exp in zip(stage_received, stage_expected_final):
+        assert torch.equal(got["hidden_states"], exp["hidden_states"])
+        assert torch.equal(got["residual"], exp["residual"])
+
+    # 3 hops x 6 steps = 18 packed device sends; only 3 handshake metadata sends!
+    assert wire.n_isend == 3 * len(token_counts)
+    assert wire.n_isend_object == 3
+
+    # Verify early-return path drains unwaited irecv handles.
+    waits_before = wire.n_recv_waits
+    drop_last_stage["active"] = True
+    sched = SimpleNamespace(total_num_scheduled_tokens=4)
+    for r, w in enumerate(workers):
+        g, _ = groups_and_dists[r]
+        monkeypatch.setattr(gw, "get_pp_group", lambda _g=g: _g)
+        res = exec_fn(w, sched)
+        if r == 3:
+            assert res is None
+    assert wire.n_recv_waits == waits_before + 3
+
