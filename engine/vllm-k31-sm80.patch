+def test_k31_dense_lm_head_fp32_override_and_unsupported_reason(
+    monkeypatch, meta_platform, k31q_checkpoint, cpu_workspace_manager
+):
+    ops = fake_dense.FakeDenseOps().install(monkeypatch)
+    exl3_calls = _patch_exl3_linear(monkeypatch)
+    model, _, _, _ = construct.build_and_load(monkeypatch, k31q_checkpoint)
+    _cpu_post_load(monkeypatch)
+    ops.name(model)
+
+    lm_head = model.lm_head
+    method = lm_head.quant_method
+    assert isinstance(method, K31DenseLinearMethod)
+    assert method.out_dtype == torch.bfloat16
+    assert dense.unsupported_reason(list(lm_head.exl3_weights), torch.float32) is None
+
+    method.process_weights_after_loading(lm_head)
+    assert method.launcher is not None
+
+    torch.manual_seed(7)
+    x_dec = torch.randn((4, fixture.TEXT["hidden_size"]), dtype=torch.bfloat16)
+
+    # 1. Direct K31DenseLinearMethod.apply(..., out_dtype=torch.float32) on decode path
+    ops.calls.clear()
+    exl3_calls.clear()
+    out_k31 = method.apply(lm_head, x_dec, out_dtype=torch.float32)
+    assert out_k31.dtype == torch.float32
+    assert len(ops.calls) == 1
+    assert ops.calls[0]["out_dtype"] == torch.float32
+    assert len(exl3_calls) == 0
+
+    # Compare against Exl3HeadLogitsProcessor._apply_head with head_dtype=float32
+    lp_fp32 = _make_processor(monkeypatch, torch.float32)
+    out_lp = lp_fp32._apply_head(lm_head, x_dec, None)
+    assert out_lp.dtype == torch.float32
+    assert torch.equal(out_lp, out_k31)
+
+    # 2. Above DECODE_MAX_ROWS -> falls back to Exl3LinearMethod.apply with out_dtype=float32
+    x_pre = torch.randn(
+        (dense.DECODE_MAX_ROWS + 4, fixture.TEXT["hidden_size"]),
+        dtype=torch.bfloat16,
+    )
+    ops.calls.clear()
+    exl3_calls.clear()
+    out_pre = lp_fp32._apply_head(lm_head, x_pre, None)
+    assert out_pre.dtype == torch.float32
+    assert len(ops.calls) == 0
+    assert exl3_calls == [(dense.DECODE_MAX_ROWS + 4, torch.float32)]
+
+    # 3. Unsupported dtype rejected by K31DenseLinearMethod.apply
+    with pytest.raises(ValueError, match="float16"):
+        method.apply(lm_head, x_dec, out_dtype=torch.float16)
