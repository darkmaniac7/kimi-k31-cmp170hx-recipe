+    from vllm.models.kimi_k3.nvidia import sm80_dsa
+    from vllm.sm80.attention.triton_mla_sparse import TritonMLASparseBackend
+
+    model = _build(monkeypatch, checkpoint)
+    assert type(model).__module__ == "vllm.models.kimi_k3.nvidia.sm80_model"
+    assert model.sm80_dsa_layers == 1
+    (layer,) = _dsa_layers(model)
+    assert layer is model.model.layers[3].self_attn
+    assert type(layer) is sm80_dsa.KimiK3DSAAttention
+    assert type(layer.dsa_indexer) is sm80_dsa.KimiK3DSAIndexer
+    assert type(layer.mla_attn) is sm80_mla.MultiHeadLatentAttentionWrapper
+    assert type(layer.mla_attn.mla_attn) is sm80_mla.MLAAttention
+    assert layer.mla_attn.mla_attn.get_attn_backend() is TritonMLASparseBackend
+    assert layer.mla_attn.indexer is layer.dsa_indexer
+    # The fused forward (fp8_ds_mla, float8e4nv prologue) is never packed.
+    layer.pack_projections()
+    assert layer._packed is None
+
+    # Parameters and buffers are upstream's, name for name.
+    reference = _build(monkeypatch, checkpoint, cls=upstream.KimiLinearForCausalLM)
+    assert type(reference) is upstream.KimiLinearForCausalLM
+
+    def shapes(m):
+        return {name: tuple(p.shape) for name, p in m.named_parameters()}
+
+    assert shapes(model) == shapes(reference)
+    assert [n for n, _ in model.named_modules()] == [
+        n for n, _ in reference.named_modules()
+    ]
