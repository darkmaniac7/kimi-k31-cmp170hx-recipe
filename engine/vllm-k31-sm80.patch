+
+
+def p2p_moe_dual_reduce_rmsnorm(
+    handle: int,
+    routed_partial: torch.Tensor,
+    shared_partial: torch.Tensor,
+    rms_weight: torch.Tensor,
+    eps: float,
+    out_routed_normed: torch.Tensor,
+    out_shared_sum: torch.Tensor,
+    residual: torch.Tensor | None = None,
+    out_shared_res: torch.Tensor | None = None,
+) -> None:
+    ensure_p2p_extension()
+    torch.ops._k31_p2p_C.p2p_moe_dual_reduce_rmsnorm(
+        int(handle),
+        routed_partial,
+        shared_partial,
+        rms_weight,
+        float(eps),
+        out_routed_normed,
+        out_shared_sum,
+        residual,
+        out_shared_res,
+    )
+
+
+def p2p_pp_send(handle: int, src: torch.Tensor, tag: int = 0) -> None:
+    ensure_p2p_extension()
+    torch.ops._k31_p2p_C.p2p_pp_send(int(handle), src, int(tag))
+
+
+def p2p_pp_recv(handle: int, dst: torch.Tensor, tag: int = 0) -> None:
+    ensure_p2p_extension()
+    torch.ops._k31_p2p_C.p2p_pp_recv(int(handle), dst, int(tag))
+
+
