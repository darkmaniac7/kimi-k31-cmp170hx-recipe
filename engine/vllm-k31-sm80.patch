+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Switch-gated engine wrappers and custom ops for ``_k31_glue_C``.
+
+All four Kimi K3.1 decode glue fusions are off by default and gated behind
+individual switches (plus an optional master convenience switch):
+  - ``VLLM_K31_GLUE_ATTNRES``: fused AttnRes + RMSNorm (0..8 blocks + delta2)
+  - ``VLLM_K31_GLUE_KDA``: 1-launch SM80/SM120 KDA decode (M <= 16)
+  - ``VLLM_K31_GLUE_ROUTER``: 256-thread histogram sigmoid top-16 router (E=896)
+  - ``VLLM_K31_GLUE_GEMV``: row-0 invariant BF16 split-2 GEMV for f_a+b (M <= 16)
+  - ``VLLM_K31_GLUE_ALL``: enables all four unless individually forced to ``0``
+
+Importing this module performs zero CUDA initialization. All custom ops are
+registered under ``torch.ops.vllm.k31_glue_*`` with FakeTensor implementations
+for ``torch.compile`` and CUDA-Graph compatibility.
+"""
+
+import importlib.util
+import os
+from typing import Any
+
+import torch
+
+from vllm import envs
+from vllm.logger import init_logger
+from vllm.utils.torch_utils import direct_register_custom_op
+
+logger = init_logger(__name__)
+
+LIBRARY = "_k31_glue_C"
+SUPPORTED_CAPABILITIES = ((8, 0), (12, 0))
+ATTNRES_MAX_BLOCKS = 8
+# 0 means unlimited: k31_fused_kda_decode_d128_kernel launches 1 independent CTA
+# per (batch, head) and k31_bf16_gemv_split2 chunks arbitrary M in strips of 16
+# in C++ with identical row-invariant math. Override via VLLM_K31_GLUE_*_MAX_ROWS.
+KDA_MAX_ROWS = 0
+GEMV_MAX_ROWS = 0
+ROUTER_NUM_EXPERTS = 896
+ROUTER_TOP_K = 16
+FUSED_ROUTER_MAX_EXPERTS = 1024
+FUSED_ROUTER_MAX_TOPK = 32
+FUSED_ROUTER_MAX_ROWS = 16
+
+_LOGGED_DECLINES: set[tuple[str, str]] = set()
+_ROUTER_WORKSPACES: dict[torch.device, torch.Tensor] = {}
+
+
+def kda_max_rows() -> int:
+    return int(getattr(envs, "VLLM_K31_GLUE_KDA_MAX_ROWS", KDA_MAX_ROWS))
+
+
+def gemv_max_rows() -> int:
+    return int(getattr(envs, "VLLM_K31_GLUE_GEMV_MAX_ROWS", GEMV_MAX_ROWS))
+
+
+def log_decline_once(op_name: str, reason: str) -> None:
+    """Log once with the exact reason when an enabled glue op declines to engage."""
+    key = (op_name, reason)
+    if key in _LOGGED_DECLINES:
+        return
+    _LOGGED_DECLINES.add(key)
+    logger.info_once(
+        "K3.1 glue %s enabled but declined to engage (%s); falling back to stock path.",
+        op_name,
+        reason,
+    )
+
+
+def _switch_enabled(name: str) -> bool:
+    """Resolve an individual glue switch with VLLM_K31_GLUE_ALL fallback."""
+    if name in os.environ:
+        return bool(getattr(envs, name, False))
+    return bool(getattr(envs, name, False)) or bool(
+        getattr(envs, "VLLM_K31_GLUE_ALL", False)
+    )
+
+
+def attnres_enabled() -> bool:
+    return _switch_enabled("VLLM_K31_GLUE_ATTNRES")
+
+
+def kda_enabled() -> bool:
+    return _switch_enabled("VLLM_K31_GLUE_KDA")
+
+
+def _opt_bool_env(name: str, default: bool = False) -> bool:
+    """Read an opt-in boolean switch without requiring registration in envs.py."""
+    env_dict = vars(envs)
+    if name in env_dict:
+        return bool(env_dict[name])
+    if name in os.environ:
+        raw = os.environ[name].strip().lower()
+        if raw in ("1", "true", "yes", "on"):
+            return True
+        if raw in ("0", "false", "no", "off", ""):
+            return False
+        raise ValueError(f"{name} must be a boolean value, got {os.environ[name]!r}")
+    val = getattr(envs, name, None)
+    if val is not None:
+        return bool(val)
+    return default
+
+
+def kda_spec_enabled() -> bool:
+    # Independent of VLLM_K31_GLUE_ALL so Arm B stays compatible with api_version=1.
+    return bool(getattr(envs, "VLLM_K31_GLUE_KDA_SPEC", False))
+
+
+def kda_records_enabled() -> bool:
+    # Independent of VLLM_K31_GLUE_ALL; falls back cleanly to fused_kda_spec_verify
+    # when _k31_glue_C lacks api_version >= 3.
+    return _opt_bool_env("VLLM_K31_GLUE_KDA_RECORDS", False)
+
+
+def router_enabled() -> bool:
+    return _switch_enabled("VLLM_K31_GLUE_ROUTER")
+
+
+def fused_router_enabled() -> bool:
+    # Opt-in, independent of VLLM_K31_GLUE_ALL for clean A/B.
+    return bool(getattr(envs, "VLLM_K31_GLUE_FUSED_ROUTER", False))
+
+
+def fused_router_max_rows() -> int:
+    return int(
+        getattr(envs, "VLLM_K31_GLUE_FUSED_ROUTER_MAX_ROWS", FUSED_ROUTER_MAX_ROWS)
+    )
+
+
+def gemv_enabled() -> bool:
+    return _switch_enabled("VLLM_K31_GLUE_GEMV")
+
+
+def _mla_switch_enabled(name: str) -> bool:
+    if name in os.environ:
+        return bool(getattr(envs, name, False))
+    if "VLLM_K31_GLUE_MLA" in os.environ:
+        return bool(getattr(envs, "VLLM_K31_GLUE_MLA", False))
+    return bool(getattr(envs, name, False)) or bool(
+        getattr(envs, "VLLM_K31_GLUE_ALL", False)
+    )
+
+
+def mla_norm_enabled() -> bool:
+    return _mla_switch_enabled("VLLM_K31_GLUE_MLA_NORM")
+
+
+def sigmoid_mul_enabled() -> bool:
+    return _mla_switch_enabled("VLLM_K31_GLUE_SIGMOID_MUL")
+
+
+def kda_no_cat_enabled() -> bool:
+    return _switch_enabled("VLLM_K31_GLUE_KDA_NO_CAT")
+
+
+def library_built() -> bool:
+    """Whether the compiled ``vllm._k31_glue_C`` extension is present on disk."""
+    return importlib.util.find_spec(f"vllm.{LIBRARY}") is not None
+
+
+def load_glue_native() -> Any:
+    """Import and validate ``vllm._k31_glue_C`` (requiring api_version >= 1)."""
+    from vllm.sm80.kernels.k31q import glue_ops
+
+    glue_ops.ensure_glue_extension()
+    return glue_ops
+
+
+def load_glue_native_v2() -> Any:
+    """Import and validate ``vllm._k31_glue_C`` (requiring api_version >= 2)."""
+    from vllm.sm80.kernels.k31q import glue_ops
+
+    if _is_mocked():
+        mod = load_glue_native()
+        info = dict(mod.build_info()) if hasattr(mod, "build_info") else {}
+        actual = info.get("api_version")
+        if (
+            not isinstance(actual, int)
+            or actual < 2
+            or not hasattr(mod, "fused_kda_spec_verify")
+        ):
+            raise RuntimeError(
+                f"K3.1 glue fused_kda_spec_verify requires vllm.{LIBRARY} "
+                f"api_version >= 2 (found api_version={actual!r}). "
+                f"Rebuild with: {glue_ops.BUILD_COMMAND}"
+            )
+        return mod
+    glue_ops.ensure_glue_v2_extension()
+    return glue_ops
+
+
+def load_glue_native_v3() -> Any:
+    """Import and validate ``vllm._k31_glue_C`` (requiring api_version >= 3)."""
+    from vllm.sm80.kernels.k31q import glue_ops
+
+    if _is_mocked():
+        mod = load_glue_native()
+        info = dict(mod.build_info()) if hasattr(mod, "build_info") else {}
+        actual = info.get("api_version")
+        if (
+            not isinstance(actual, int)
+            or actual < 3
+            or not hasattr(mod, "fused_kda_spec_verify_records")
+            or not hasattr(mod, "kda_records_materialize")
+        ):
+            raise RuntimeError(
+                f"K3.1 glue KDA records requires vllm.{LIBRARY} "
+                f"api_version >= 3 (found api_version={actual!r}). "
+                f"Rebuild with: {glue_ops.BUILD_COMMAND}"
+            )
+        return mod
+    glue_ops.ensure_glue_v3_extension()
+    return glue_ops
+
+
+_DEFAULT_LOAD_GLUE_NATIVE = load_glue_native
+_DEFAULT_LOAD_GLUE_NATIVE_V2 = load_glue_native_v2
+_DEFAULT_LOAD_GLUE_NATIVE_V3 = load_glue_native_v3
+_AVAILABILITY_CACHE: bool | None = None
+_AVAILABILITY_V2_CACHE: bool | None = None
+_AVAILABILITY_V3_CACHE: bool | None = None
+
+
+def _reset_state() -> None:
+    """Reset cached native availability and decline-log state (for tests)."""
+    global _AVAILABILITY_CACHE, _AVAILABILITY_V2_CACHE, _AVAILABILITY_V3_CACHE
+    _AVAILABILITY_CACHE = None
+    _AVAILABILITY_V2_CACHE = None
+    _AVAILABILITY_V3_CACHE = None
+    _LOGGED_DECLINES.clear()
+    _ROUTER_WORKSPACES.clear()
+
+
+def _device_capability() -> tuple[int, int] | None:
+    from vllm.platforms import current_platform
+
+    cap = current_platform.get_device_capability()
+    if cap is None:
+        return None
+    if hasattr(cap, "major") and hasattr(cap, "minor"):
+        return (int(cap.major), int(cap.minor))
+    return (int(cap[0]), int(cap[1]))
+
+
+def _is_mocked() -> bool:
+    return load_glue_native is not _DEFAULT_LOAD_GLUE_NATIVE
+
+
+def _is_v2_mocked() -> bool:
+    return load_glue_native_v2 is not _DEFAULT_LOAD_GLUE_NATIVE_V2 or _is_mocked()
+
+
+def _is_v3_mocked() -> bool:
+    return load_glue_native_v3 is not _DEFAULT_LOAD_GLUE_NATIVE_V3 or _is_mocked()
+
+
+def is_available() -> bool:
+    """Whether ``_k31_glue_C`` is usable on this host and device.
+
+    If the extension is absent on disk, logs a warning once and returns False
+    so callers fall back cleanly. If a compiled extension is present but fails
+    ABI or ``api_version >= 1`` validation, raises ``RuntimeError`` with the
+    build command so stale binaries cannot silently misbehave.
+    """
+    global _AVAILABILITY_CACHE
+    if _is_mocked():
+        return True
+    if _AVAILABILITY_CACHE is not None:
+        return _AVAILABILITY_CACHE
+    cap = _device_capability()
+    if cap not in SUPPORTED_CAPABILITIES:
+        _AVAILABILITY_CACHE = False
+        return False
+    if not library_built():
+        from vllm.sm80.kernels.k31q.glue_ops import BUILD_COMMAND
+
+        logger.warning_once(
+            "K3.1 glue switch enabled, but vllm.%s is not built; falling back "
+            "to stock paths. Build it with: %s",
+            LIBRARY,
+            BUILD_COMMAND,
+        )
+        _AVAILABILITY_CACHE = False
+        return False
+    # Present on disk: validate abi_version=1 and api_version>=1 loudly.
+    load_glue_native()
+    _AVAILABILITY_CACHE = True
+    return True
+
+
+def is_kda_spec_available() -> bool:
+    """Whether ``_k31_glue_C`` api_version >= 2 (fused_kda_spec_verify) is usable.
+
+    Falls back with a one-time warning when the extension is unbuilt. When a
+    compiled extension (or mocked stand-in) is present with ``api_version < 2``,
+    raises ``RuntimeError`` loudly with the rebuild command.
+    """
+    global _AVAILABILITY_V2_CACHE
+    if load_glue_native_v2 is not _DEFAULT_LOAD_GLUE_NATIVE_V2:
+        return True
+    if _is_mocked():
+        load_glue_native_v2()
+        return True
+    if _AVAILABILITY_V2_CACHE is not None:
+        return _AVAILABILITY_V2_CACHE
+    cap = _device_capability()
+    if cap not in SUPPORTED_CAPABILITIES:
+        _AVAILABILITY_V2_CACHE = False
+        return False
+    if not library_built():
+        from vllm.sm80.kernels.k31q.glue_ops import BUILD_COMMAND
+
+        logger.warning_once(
+            "K3.1 glue VLLM_K31_GLUE_KDA_SPEC enabled, but vllm.%s is not built; "
+            "falling back to stock path. Build it with: %s",
+            LIBRARY,
+            BUILD_COMMAND,
+        )
+        _AVAILABILITY_V2_CACHE = False
+        return False
+    # Present on disk: validate abi_version=1 and api_version>=2 loudly.
+    load_glue_native_v2()
+    _AVAILABILITY_V2_CACHE = True
+    return True
+
+
+def is_kda_records_available() -> bool:
+    """Whether ``_k31_glue_C`` api_version >= 3 (KDA records) is usable.
+
+    Gracefully logs a one-time warning and returns False (never raising on old
+    api_version < 3 or unbuilt extension) so callers fall back cleanly to
+    ``fused_kda_spec_verify`` or stock Triton.
+    """
+    global _AVAILABILITY_V3_CACHE
+    if load_glue_native_v3 is not _DEFAULT_LOAD_GLUE_NATIVE_V3:
+        return True
+    if _is_mocked():
+        try:
+            load_glue_native_v3()
+        except RuntimeError as exc:
+            logger.warning_once(
+                "K3.1 glue VLLM_K31_GLUE_KDA_RECORDS enabled, but mocked glue "
+                "lacks v3 ops (%s); falling back.",
+                exc,
+            )
+            return False
+        return True
+    if _AVAILABILITY_V3_CACHE is not None:
+        return _AVAILABILITY_V3_CACHE
+    cap = _device_capability()
+    if cap not in SUPPORTED_CAPABILITIES:
+        _AVAILABILITY_V3_CACHE = False
+        return False
+    if not library_built():
+        from vllm.sm80.kernels.k31q.glue_ops import BUILD_COMMAND
+
+        logger.warning_once(
+            "K3.1 glue VLLM_K31_GLUE_KDA_RECORDS enabled, but vllm.%s is not built; "
+            "falling back. Build it with: %s",
+            LIBRARY,
+            BUILD_COMMAND,
+        )
+        _AVAILABILITY_V3_CACHE = False
+        return False
+    try:
+        load_glue_native_v3()
+    except RuntimeError as exc:
+        msg = str(exc)
+        if (
+            "api_version mismatch" in msg
+            or "fused_kda_spec_verify_records" in msg
+            or "kda_records_materialize" in msg
+            or "moe_prune_topk" in msg
+        ):
+            logger.warning_once(
+                "K3.1 glue VLLM_K31_GLUE_KDA_RECORDS enabled, but vllm.%s "
+                "lacks api_version >= 3 (%s); falling back to fused_kda_spec_verify.",
+                LIBRARY,
+                msg,
+            )
+            _AVAILABILITY_V3_CACHE = False
+            return False
+        raise
+    _AVAILABILITY_V3_CACHE = True
+    return True
+
+
+def is_glue_v3_available() -> bool:
+    """Whether ``_k31_glue_C`` api_version >= 3 operators (incl. moe_prune_topk) exist."""
+    if load_glue_native_v3 is not _DEFAULT_LOAD_GLUE_NATIVE_V3:
+        mod = load_glue_native_v3()
+        return hasattr(mod, "moe_prune_topk")
+    if _is_mocked():
+        mod = load_glue_native()
+        info = dict(mod.build_info()) if hasattr(mod, "build_info") else {}
+        actual = info.get("api_version")
+        return isinstance(actual, int) and actual >= 3 and hasattr(mod, "moe_prune_topk")
+    return is_kda_records_available()
+
+
+# -- Registered vllm::k31_glue_* custom ops (FakeTensor & CUDA-Graph safe) ----
+
+
+def _attn_res_rmsnorm_impl(
+    prefix: torch.Tensor,
+    delta: torch.Tensor | None,
+    delta2: torch.Tensor | None,
+    blocks: torch.Tensor,
+    norm_weight: torch.Tensor,
+    qk_weight: torch.Tensor,
+    output_norm_weight: torch.Tensor | None,
+    num_blocks: int,
+    block_write_idx: int,
+    eps: float,
+    output_norm_eps: float,
+) -> torch.Tensor:
+    ops = load_glue_native()
+    out = torch.empty_like(prefix)
+    ops.attn_res_rmsnorm(
+        prefix,
+        delta,
+        blocks,
+        norm_weight,
+        qk_weight,
+        output_norm_weight,
+        int(num_blocks),
+        int(block_write_idx),
+        float(eps),
+        float(output_norm_eps),
+        delta2=delta2,
+        out=out,
+    )
+    return out
+
+
+def _attn_res_rmsnorm_fake(
+    prefix: torch.Tensor,
+    delta: torch.Tensor | None,
+    delta2: torch.Tensor | None,
+    blocks: torch.Tensor,
+    norm_weight: torch.Tensor,
+    qk_weight: torch.Tensor,
+    output_norm_weight: torch.Tensor | None,
+    num_blocks: int,
+    block_write_idx: int,
+    eps: float,
+    output_norm_eps: float,
+) -> torch.Tensor:
+    torch._check(prefix.dtype == torch.bfloat16)
+    torch._check(prefix.dim() == 2)
+    return torch.empty_like(prefix)
+
+
+direct_register_custom_op(
+    op_name="k31_glue_attn_res_rmsnorm",
+    op_func=_attn_res_rmsnorm_impl,
+    mutates_args=["prefix", "blocks"],
+    fake_impl=_attn_res_rmsnorm_fake,
+)
+
+
+def _attn_res_rmsnorm_op(
+    prefix: torch.Tensor,
+    delta: torch.Tensor | None,
+    delta2: torch.Tensor | None,
+    blocks: torch.Tensor,
+    norm_weight: torch.Tensor,
+    qk_weight: torch.Tensor,
+    output_norm_weight: torch.Tensor | None,
+    num_blocks: int,
+    block_write_idx: int,
+    eps: float,
+    output_norm_eps: float,
+) -> torch.Tensor:
+    return torch.ops.vllm.k31_glue_attn_res_rmsnorm(
+        prefix,
+        delta,
+        delta2,
+        blocks,
+        norm_weight,
+        qk_weight,
+        output_norm_weight,
+        int(num_blocks),
+        int(block_write_idx),
+        float(eps),
+        float(output_norm_eps),
+    )
+
+
+def _fused_kda_decode_impl(
+    mixed_qkv: torch.Tensor,
+    conv_state: torch.Tensor,
+    conv_weight: torch.Tensor,
+    conv_bias: torch.Tensor | None,
+    raw_g: torch.Tensor,
+    raw_beta: torch.Tensor,
+    A_log: torch.Tensor,
+    dt_bias: torch.Tensor,
+    g2: torch.Tensor,
+    norm_weight: torch.Tensor,
+    recurrent_state: torch.Tensor,
+    state_indices: torch.Tensor,
+    lower_bound: float,
+    norm_eps: float,
+    out: torch.Tensor,
+) -> None:
+    ops = load_glue_native()
+    ops.fused_kda_decode(
+        mixed_qkv,
+        conv_state,
+        conv_weight,
+        conv_bias,
+        raw_g,
+        raw_beta,
+        A_log,
+        dt_bias,
+        g2,
+        norm_weight,
+        recurrent_state,
+        state_indices,
+        float(lower_bound),
+        float(norm_eps),
+        out,
+    )
+
+
+def _fused_kda_decode_fake(
+    mixed_qkv: torch.Tensor,
+    conv_state: torch.Tensor,
+    conv_weight: torch.Tensor,
+    conv_bias: torch.Tensor | None,
+    raw_g: torch.Tensor,
+    raw_beta: torch.Tensor,
+    A_log: torch.Tensor,
+    dt_bias: torch.Tensor,
+    g2: torch.Tensor,
+    norm_weight: torch.Tensor,
+    recurrent_state: torch.Tensor,
+    state_indices: torch.Tensor,
+    lower_bound: float,
+    norm_eps: float,
+    out: torch.Tensor,
+) -> None:
+    torch._check(mixed_qkv.dtype == torch.bfloat16)
+    torch._check(recurrent_state.dtype == torch.float32)
+    torch._check(out.dtype == torch.bfloat16)
+    return None
+
+
+direct_register_custom_op(
+    op_name="k31_glue_fused_kda_decode",
+    op_func=_fused_kda_decode_impl,
+    mutates_args=["conv_state", "recurrent_state", "out"],
+    fake_impl=_fused_kda_decode_fake,
+)
+
+
+def _fused_kda_decode_op(
+    mixed_qkv: torch.Tensor,
+    conv_state: torch.Tensor,
+    conv_weight: torch.Tensor,
+    conv_bias: torch.Tensor | None,
+    raw_g: torch.Tensor,
+    raw_beta: torch.Tensor,
+    A_log: torch.Tensor,
+    dt_bias: torch.Tensor,
+    g2: torch.Tensor,
+    norm_weight: torch.Tensor,
+    recurrent_state: torch.Tensor,
+    state_indices: torch.Tensor,
+    lower_bound: float,
+    norm_eps: float,
+    out: torch.Tensor,
+) -> None:
+    torch.ops.vllm.k31_glue_fused_kda_decode(
+        mixed_qkv,
+        conv_state,
+        conv_weight,
+        conv_bias,
+        raw_g,
+        raw_beta,
+        A_log,
+        dt_bias,
+        g2,
+        norm_weight,
+        recurrent_state,
+        state_indices,
+        float(lower_bound),
+        float(norm_eps),
+        out,
+    )
+
+
+def _fused_kda_spec_verify_impl(
+    mixed_qkv: torch.Tensor,
+    conv_state: torch.Tensor,
+    conv_weight: torch.Tensor,
+    conv_bias: torch.Tensor | None,
+    raw_g: torch.Tensor,
+    raw_beta: torch.Tensor,
+    A_log: torch.Tensor,
+    dt_bias: torch.Tensor,
+    g2: torch.Tensor,
+    norm_weight: torch.Tensor,
+    recurrent_state: torch.Tensor,
+    spec_state_indices: torch.Tensor,
+    query_start_loc: torch.Tensor,
+    num_accepted_tokens: torch.Tensor,
