+++ b/tests/v1/spec_decode/test_k31_tier_fit.py
@@ -0,0 +1,181 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""K3.1 lever 3: the offline threshold fit (vllm/sm80/spec_decode/tier_fit.py)
+on synthetic dumps. CPU only."""
+
+import json
+import random
+from itertools import combinations_with_replacement
+
+import pytest
+
+from vllm.sm80.spec_decode import tier_fit as tf
+from vllm.sm80.spec_decode.adaptive_k import AdaptiveKConfig
+
+pytestmark = pytest.mark.cpu_test
+
+TIERS = [3, 5, 7, 9, 12]
+KMAX = 12
+# Step ms by verified drafts at one request (the shape of PLAN section 10).
+COSTS = {3: 51.0, 5: 55.0, 7: 60.0, 9: 66.0, 12: 76.0}
+
+
+def synth(n_req, n_blocks, rho, informative, seed):
+    """Blocks whose per-draft acceptance follows a persistent difficulty (kept
+    from block to block with probability ``rho``, else drawn anew, uniform);
+    the drafter's confidence is that acceptance plus noise (informative) or
+    uniform noise."""
+    rnd = random.Random(seed)
+    requests = {}
+    for r in range(n_req):
+        x = rnd.random()
+        blocks = []
+        for _ in range(n_blocks):
+            if rnd.random() >= rho:
+                x = rnd.random()
+            p = 0.35 + 0.6 * x
+            a = 0
+            while a < KMAX and rnd.random() < p:
+                a += 1
+            q = min(0.99, max(0.01, p + rnd.gauss(0, 0.05))) if informative else rnd.random()
+            blocks.append(tf.Block(tuple([q] * KMAX), KMAX, a))
+        requests[f"r{r}"] = blocks
+    return requests
+
+
+def evaluate(requests, best, age):
+    tokens = ms = 0.0
+    for blocks in requests.values():
+        pol = tf._policy(TIERS, KMAX, best.thresholds, best.accept_weight, 0.25,
+                         age + 1, 0.75, 0.9, 2.0)
+        t, c = tf.ratio(blocks, tf.replay(blocks, pol, age), COSTS)
+        tokens += t
+        ms += c
+    return tokens / ms
+
+
+def best_fixed(requests):
+    out = {}
+    for k in TIERS:
+        tokens = ms = 0.0
+        for blocks in requests.values():
+            t, c = tf.ratio(blocks, [k] * len(blocks), COSTS)
+            tokens += t
+            ms += c
+        out[k] = tokens / ms
+    return max(out.values())
+
+
+def test_the_threshold_dp_is_exact_against_brute_force():
+    rnd = random.Random(7)
+    tiers = [3, 7, 12]
+    costs = {3: 50.0, 7: 58.0, 12: 75.0}
+    for trial in range(20):
+        items = []
+        for _ in range(7):
+            s = round(rnd.uniform(0, 6), 1)
+            a = rnd.randint(0, KMAX)
+            items.append((s, tf.Block((0.5,) * KMAX, KMAX, a)))
+        thresholds, value = tf.fit_thresholds(items, tiers, costs)
+        groups = sorted({s for s, _ in items})
+        brute = 0.0
+        for assign in combinations_with_replacement(range(len(tiers)), len(groups)):
+            tier_of = dict(zip(groups, assign))
+            tok = sum(b.tokens(tiers[tier_of[s]]) for s, b in items)
+            ms = sum(costs[tiers[tier_of[s]]] for s, _ in items)
+            brute = max(brute, tok / ms)
+        assert value == pytest.approx(brute, rel=1e-12), trial
+        # The thresholds reproduce that value on the same items.
+        ks = [tiers[sum(1 for t in thresholds if s >= t)] for s, _ in items]
+        tok = sum(b.tokens(k) for (_, b), k in zip(items, ks))
+        ms = sum(costs[k] for k in ks)
+        assert tok / ms == pytest.approx(brute, rel=1e-12)
+        assert thresholds == sorted(thresholds)
+
+
+def test_an_informative_confidence_beats_every_fixed_tier_out_of_sample():
+    train = synth(30, 150, rho=0.9, informative=True, seed=1)
+    test = synth(30, 150, rho=0.9, informative=True, seed=2)
+    best, results, fixed = tf.fit(train, TIERS, COSTS, age=0, hysteresis=0.25)
+    assert len(results) == 5 and best.replayed >= max(fixed.values())
+    gain = evaluate(test, best, age=0) / best_fixed(test)
+    assert gain > 1.05, gain
+
+
+def test_noise_buys_nothing_out_of_sample():
+    # Uniform-noise confidences and i.i.d. difficulty: neither the head nor
+    # the acceptance history says anything about the next block.
+    train = synth(30, 150, rho=0.0, informative=False, seed=3)
+    test = synth(30, 150, rho=0.0, informative=False, seed=4)
+    best, _, _ = tf.fit(train, TIERS, COSTS, age=0, hysteresis=0.25)
+    gain = evaluate(test, best, age=0) / best_fixed(test)
+    assert 0.95 < gain < 1.01, gain
+
+
+@pytest.mark.parametrize("rho, low, high", [(0.95, 1.03, 10.0), (0.0, 0.95, 1.01)])
+def test_a_one_round_stale_signal_helps_only_as_far_as_the_text_persists(rho, low, high):
+    train = synth(30, 150, rho=rho, informative=True, seed=5)
+    test = synth(30, 150, rho=rho, informative=True, seed=6)
+    best, _, _ = tf.fit(train, TIERS, COSTS, age=1, hysteresis=0.25)
+    gain = evaluate(test, best, age=1) / best_fixed(test)
+    assert low < gain < high, gain
+
+
+@pytest.mark.parametrize("age", [0, 1, 2])
+def test_replay_reads_the_confidence_exactly_age_rounds_old(age):
+    # Each block's confidence encodes a tier outright (accept_weight 0, no
+    # hysteresis): the decision for block t must be the tier of block t - age.
+    rnd = random.Random(age)
+    summaries = [rnd.choice([0.5, 2.0, 3.0, 4.0, 6.0]) for _ in range(40)]
+    blocks = [
+        tf.Block(tuple([1.0] * int(s) + [s - int(s)] + [0.0] * (KMAX - int(s) - 1)), KMAX, 0)
+        for s in summaries
+    ]
+    pol = tf._policy(TIERS, KMAX, [1.5, 2.5, 3.5, 4.5], 0.0, 0.0, age, 0.75, 0.9, 2.0)
+    ks = tf.replay(blocks, pol, age)
+    tier = lambda s: TIERS[sum(1 for t in (1.5, 2.5, 3.5, 4.5) if s >= t)]  # noqa: E731
+    assert ks[age:] == [tier(s) for s in summaries[: len(summaries) - age]]
+    # Before any output is on the host, the acceptance prior (tier 7).
+    assert ks[:age] == [7] * age
+
+
+def test_censored_blocks_are_left_out():
+    b = tf.Block((0.9,) * KMAX, 5, 5)
+    assert b.tokens(5) == 6 and b.tokens(3) == 4 and b.tokens(7) is None
+    assert tf.Block((0.9,) * KMAX, 5, 2).tokens(12) == 3
+
+
+def test_cli_writes_a_snippet_the_config_accepts(tmp_path, capsys):
+    requests = synth(6, 60, rho=0.9, informative=True, seed=9)
+    dump = tmp_path / "dspark-confidence.x.rank0.jsonl"
+    with dump.open("w") as f:
+        step = 0
+        for req, blocks in requests.items():
+            for b in blocks:
+                step += 1
+                f.write(json.dumps({"step": step, "req": req, "conf": list(b.conf),
+                                    "width": KMAX, "verified": b.verified,
+                                    "accepted": b.accepted, "batch": 1, "t": 0.0}) + "\n")
+            # A censored block near the end of a request, and a warm-up row.
+            f.write(json.dumps({"step": step + 1, "req": req, "conf": [0.9] * KMAX,
+                                "width": KMAX, "verified": 4, "accepted": 4,
+                                "batch": 1, "t": 0.0}) + "\n")
+        f.write(json.dumps({"step": 0, "req": "_warmup_0", "conf": [0.5] * KMAX,
+                            "width": KMAX, "verified": 12, "accepted": 0,
+                            "batch": 1, "t": 0.0}) + "\n")
+    costs = tmp_path / "costs.json"
+    costs.write_text(json.dumps({str(k): v for k, v in COSTS.items()}))
+    out = tmp_path / "tiers.json"
+    assert tf.main([str(dump), "--costs", str(costs), "--age", "1", "--out", str(out)]) == 0
+    printed = capsys.readouterr().out
+    assert "| fixed 12 |" in printed and "accept_weight" in printed
+    raw = json.loads(out.read_text())
+    config = AdaptiveKConfig.from_dict(raw, KMAX)
+    assert config.allowed == tuple(TIERS)
+    assert config.confidence.max_age == 2
+    assert list(config.confidence.thresholds) == sorted(config.confidence.thresholds)
+    loaded = tf.load_dump([dump])
+    assert len(loaded) == 6 and not any("_warmup" in r for r in loaded)
+    # The CLI default keeps only blocks verified at the widest tier.
+    assert sum(len(v) for v in loaded.values()) == 6 * 61
+    assert sum(len(v) for v in tf.load_dump([dump], KMAX).values()) == 6 * 60
