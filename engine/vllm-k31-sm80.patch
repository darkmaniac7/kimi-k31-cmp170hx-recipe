+            torch.randn((1, T, H), dtype=torch.bfloat16),
+            torch.empty((1, T, H, D), dtype=torch.bfloat16),
+        )
+
+    assert fake.calls_for("fused_kda_spec_verify") == []
+    assert any("kda_spec_verify" in m and expected_substr in m for m in logged), logged
