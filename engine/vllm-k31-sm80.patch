+def _patch_fake_attention(monkeypatch) -> None:
+    """Avoid initializing CUDA Attention backend or libcuda ops on CPU-only runs."""
+    from vllm.model_executor.layers import activation
+    from vllm.model_executor.models import qwen3_dflash
+
+    class _DummyAttn(torch.nn.Module):
+        def __init__(self, *args, prefix="", **kwargs):
+            super().__init__()
+            self.layer_name = prefix
+
+        def forward(self, q, k, v):
+            return q
+
+    monkeypatch.setattr(qwen3_dflash, "Attention", _DummyAttn)
+
+    if not hasattr(torch.ops._C, "silu_and_mul"):
+        def _cpu_silu_init(self, *, compile_native: bool = True):
+            super(activation.SiluAndMul, self).__init__(compile_native=compile_native)
+            self.op = None
+
+        monkeypatch.setattr(activation.SiluAndMul, "__init__", _cpu_silu_init)
+
