+# 3. Injected single-layer bug detectors (exact layer + boundary pinpointing)
+# ---------------------------------------------------------------------------
+@pytest.mark.parametrize(
+    "bug_name,target_layer,expected_tag",
+    [
+        ("dropped_tp_allreduce_half_norm", 19, "MLA/DSA"),
+        ("corrupted_mla_l3", 3, "MLA/DSA"),
+        ("broken_attnres_l12", 12, "ATTNRES_BLK"),
+        ("swapped_pp_boundary_l27", 27, "PP_STAGE"),
+        ("wrong_abliteration_l48", 48, "ABL"),
+        ("nan_injection_l70", 70, "KDA"),
+    ],
+)
+def test_injected_single_layer_bugs_caught_and_pinpointed(
+    bug_name: str,
+    target_layer: int,
+    expected_tag: str,
+) -> None:
+    ref_dump, cand_dump = _make_synthetic_93_layer_pair()
+    g = torch.Generator().manual_seed(999 + target_layer)
+    key = f"L{target_layer}.out"
+
+    if bug_name == "dropped_tp_allreduce_half_norm":
+        cand_dump.tensors[key] = cand_dump.tensors[key] * 0.5
+    elif bug_name == "corrupted_mla_l3":
+        cand_dump.tensors[key] = torch.randn_like(cand_dump.tensors[key])
+    elif bug_name == "broken_attnres_l12":
+        cand_dump.tensors[key] = cand_dump.tensors[key] * 2.0 + torch.randn_like(cand_dump.tensors[key]) * 0.8
+    elif bug_name == "swapped_pp_boundary_l27":
+        cand_dump.tensors[key] = cand_dump.tensors[key].roll(shifts=5, dims=0)
+    elif bug_name == "wrong_abliteration_l48":
+        cand_dump.tensors[key] = -cand_dump.tensors[key]
+    elif bug_name == "nan_injection_l70":
+        t = cand_dump.tensors[key].clone()
+        t[0, 0] = float("nan")
+        cand_dump.tensors[key] = t
+
+    pr = cmp_mod.compare_prompt_dumps(ref_dump, cand_dump)
+    assert pr["status"] == "FAIL", f"{bug_name} was not flagged FAIL"
+    ff = pr["boundary_summary"]["first_fail_layer"]
+    assert ff is not None
+    assert ff["layer"] == target_layer, f"{bug_name}: expected L{target_layer}, got L{ff['layer']}"
+    assert expected_tag in ff["tags"]
+
