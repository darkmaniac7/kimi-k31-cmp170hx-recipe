+def test_k3_dspark_config_head_arch_contract() -> None:
+    base_kwargs = dict(
+        vocab_size=512,
+        hidden_size=256,
+        intermediate_size=512,
+        num_hidden_layers=2,
+        num_attention_heads=8,
+        num_key_value_heads=4,
+        q_lora_rank=64,
+        kv_lora_rank=64,
+        qk_nope_head_dim=32,
+        qk_rope_head_dim=32,
+        v_head_dim=32,
+        target_layer_ids=[1, 2],
+        num_target_layers=2,
+    )
+    cfg_default = K3DSparkConfig(**base_kwargs)
+    assert cfg_default.dspark_head_arch == "vanilla"
+
+    for arch in SUPPORTED_DSPARK_HEAD_ARCHS:
+        cfg = K3DSparkConfig(
+            **base_kwargs,
+            dspark_head_arch=arch,
+            dspark_gru_dim=384,
+            dspark_ar1_dim=512,
+            dspark_ar1_layers=2,
+            dspark_ar1_heads=8,
+            dspark_ar1_inter=1024,
+        )
+        assert cfg.dspark_head_arch == arch
+        assert cfg.dspark_gru_dim == 384
+        assert cfg.dspark_ar1_dim == 512
+
+    with pytest.raises(ValueError, match="Unsupported dspark_head_arch"):
+        K3DSparkConfig(**base_kwargs, dspark_head_arch="invalid_arch")
