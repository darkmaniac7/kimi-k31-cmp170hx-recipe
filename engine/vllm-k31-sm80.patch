+def run_gemv_check(mini: Path) -> dict[str, Any]:
+    from vllm.sm80.kernels.k31q.manifest import PLAIN
+    from vllm.sm80.kernels.k31q.quant import K31FusedLinearMethod
+
+    device = torch.device("cuda:0")
+    records: list[dict[str, Any]] = []
+    max_rel = 0.0
+
+    for lid in (0, 1):
+        attn_in = gpu.tensors(mini / "ref_acts.safetensors", f"L{lid}.attn_in.q", device=device)[0]
+        w_fa = _load_layer_plain(mini, lid, "self_attn.f_a_proj.weight", device).contiguous()
+        w_b = _load_layer_plain(mini, lid, "self_attn.b_proj.weight", device).contiguous()
+        n0, n1 = w_fa.shape[0], w_b.shape[0]
+        w_pair = torch.cat([w_fa, w_b], dim=0).contiguous()
+
+        method = K31FusedLinearMethod.__new__(K31FusedLinearMethod)
+        method.out_dtype = torch.bfloat16
+        method.padding = 0
+        method.launcher = None
+        method.row_chunks = []
+        method.segments = [
+            (PLAIN, (0, n0, "f_a_proj.weight", slice(0, n0))),
+            (PLAIN, (n0, n1, "b_proj.weight", slice(0, n1))),
+        ]
+        layer = nn.Module()
+        layer.exl3_weights = nn.ModuleList()
+        layer.plain_weight = nn.Parameter(w_pair, requires_grad=False)
+
+        row0_m1 = None
+        for M in (1, 4, 8, 16):
+            xm = attn_in[:M].contiguous()
+            with _glue_switches(VLLM_K31_GLUE_GEMV=1):
+                got = method.apply(layer, xm)
+            ref = F.linear(xm.float(), w_pair.float()).to(torch.bfloat16)
+            rel = _rel_l2(got, ref)
+            assert rel <= BOUND_GEMV_REL_L2, f"L{lid} M={M}: gemv rel_l2={rel}"
+            if M == 1:
+                row0_m1 = got[0].clone()
+            else:
+                assert torch.equal(got[0], row0_m1), f"L{lid} M={M}: row-0 NOT 0-ULP invariant!"
+            max_rel = max(max_rel, rel)
+            records.append(
+                {
+                    "layer": lid,
+                    "M": M,
+                    "rel_l2_vs_fp32": rel,
+                    "row0_zero_ulp": True,
+                }
+            )
+
+    return {
+        "bound_rel_l2": BOUND_GEMV_REL_L2,
+        "max_rel_l2": max_rel,
+        "row0_zero_ulp_all": True,
+        "cases": records,
+    }
