+
+@pytest.mark.parametrize(
+    "cands, successors, model_overrides, stats, reason",
+    [
+        ("4", "8", dict(markov_w2_rows=None), None, "markov_w2_rows"),
+        ("4", "8", dict(has_recurrent_markov_head=True), None, "recurrent"),
+        ("4", "8", {}, torch.zeros(1), "adaptive depth"),
+        ("65", "8", {}, None, "65 base candidates"),
+        ("-1", "8", {}, None, "-1 base candidates"),
+        ("4", "0", {}, None, "0 Markov successors"),
+        ("4", "257", {}, None, "257 Markov successors"),
+        ("4", "8", dict(markov_w2_rows=lambda s, n: torch.zeros(n, 4)), None, "not BF16"),
+        (
+            "4",
+            "8",
+            dict(markov_w2_rows=lambda s, n: torch.zeros(n + 1, 4, dtype=torch.bfloat16)),
+            None,
+            "not BF16",
+        ),
+    ],
+)
+def test_switch_refuses_what_it_cannot_serve(
+    monkeypatch, cands, successors, model_overrides, stats, reason
+):
+    from vllm.sm80.spec_decode import markov_shortlist as mt
+
+    monkeypatch.setenv(SWITCH, cands)
+    monkeypatch.setenv(SUCCESSORS, successors)
+    s = _speculator(**model_overrides)
+    with pytest.raises(ValueError, match=f"{SWITCH}: .*{reason}"):
+        mt.sample(s, 1, None, torch.zeros(2, 8), 0, 8, 0, 1, stats)
+    assert getattr(s, "_markov_shortlist", None) is None
+
+
+def test_successor_table_holds_the_largest_biases(monkeypatch):
+    from vllm.sm80.spec_decode import markov_shortlist as mt
+
+    monkeypatch.setattr(mt, "TABLE_ROWS", 7)  # several matmuls
+    g = torch.Generator().manual_seed(1)
+    w1 = torch.randn(20, 6, generator=g).to(torch.bfloat16)
+    w2 = torch.randn(11, 6, generator=g).to(torch.bfloat16)
+    cols, bias = mt.successor_table(w1, w2, 4)
+    full = w1.float() @ w2.float().T
+    assert cols.dtype == torch.int32 and bias.dtype == torch.float32
+    assert cols.shape == bias.shape == (20, 4)
+    # Each kept column with its own bias, the largest first, and no column
+    # left out beats a kept one (up to the summation order of the matmul).
+    assert torch.allclose(bias, full.gather(1, cols.long()), atol=1e-5)
+    assert bool((bias[:, :-1] >= bias[:, 1:]).all())
+    rest = full.scatter(1, cols.long(), float("-inf"))
+    assert bool((rest.max(-1).values <= bias[:, -1] + 1e-5).all())
+    assert all(len(set(row)) == 4 for row in cols.tolist())
+    # A shard with fewer columns than successors: the rest is empty.
+    cols, bias = mt.successor_table(w1, w2[:3].contiguous(), 5)
+    assert torch.equal(cols[:, 3:], torch.full((20, 2), -1, dtype=torch.int32))
+    assert torch.equal(cols[:, :3].long().sort(-1).values, torch.arange(3).expand(20, 3))
+    assert torch.allclose(
+        bias[:, :3], full[:, :3].sort(-1, descending=True).values, atol=1e-5
+    )
+    # A rank without columns.
+    cols, bias = mt.successor_table(w1, w2[:0].contiguous(), 5)
+    assert cols.shape == (20, 5) and bool((cols == -1).all())
+
+
+def test_k6_drafter_gives_the_rows_of_the_asked_columns():
+    from vllm.sm80.spec_decode import dspark_k6_model as k6
+
+    vocab, rank_dim = 20, 6
+    g = torch.Generator().manual_seed(3)
+    w2 = torch.randint(-4, 5, (vocab, rank_dim), generator=g).float()
+    asked = []
+
+    class Drafter(k6.Qwen3DSparkForCausalLM):
+        def markov_bias_local(self, markov_embed, col_start, n_cols):
+            asked.append((markov_embed.shape[0], col_start, n_cols))
+            return markov_embed.float() @ w2[col_start : col_start + n_cols].T * 2.0
+
+    d = object.__new__(Drafter)
+    w1 = torch.zeros(vocab, rank_dim, dtype=torch.bfloat16)
+    d.__dict__["_modules"] = {}
+    d.__dict__["_parameters"] = {}
+    d.__dict__["_buffers"] = {}
+    d.__dict__["model"] = SimpleNamespace(
+        markov_head=SimpleNamespace(markov_w1=SimpleNamespace(weight=w1))
+    )
+    old = k6._TABLE_ROWS
+    k6._TABLE_ROWS = 4
+    try:
+        rows = d.markov_w2_rows(8, 7)
+        none = d.markov_w2_rows(16, 0)
+    finally:
+        k6._TABLE_ROWS = old
+    assert rows.dtype == torch.bfloat16 and rows.shape == (7, rank_dim)
+    assert torch.equal(rows.float(), w2[8:15] * 2.0)  # the scale of markov_bias_local
+    assert asked == [(4, 8, 7), (2, 8, 7)]
+    assert none.shape == (0, rank_dim)
+    with pytest.raises(ValueError, match="-1 columns"):
+        d.markov_w2_rows(0, -1)
+
+
+def test_kernels_compile_for_sm80():
+    import triton
+    from triton.backends.compiler import GPUTarget
+    from triton.compiler import ASTSource
+
+    from vllm.sm80.spec_decode import markov_shortlist as mt
+
+    target = GPUTarget("cuda", 80, 32)
+
+    def build(kern, types, consts, warps):
+        sig = {p: types.get(p, "constexpr") for p in kern.arg_names}
+        c = triton.compile(
+            ASTSource(kern, sig, constexprs=consts),
+            target=target,
+            options={"num_warps": warps},
+        )
+        assert c.asm["cubin"]
+
+    tp, cands, successors, width, rank_dim, steps = 2, 32, 64, 81920, 512, 11
+    chunks = -(-width // mt.BLOCK)
+    for logits in ("*fp32", "*bf16"):
+        build(
+            mt._chunk_top_kernel,
+            {"logits_ptr": logits, "logits_stride": "i32", "scratch_ptr": "*i64",
+             "scratch_stride": "i32", "n_cols": "i32"},
+            dict(T=cands, BLOCK=mt.BLOCK),
+            8,
+        )
+        for first in (True, False):
+            build(
+                mt._step_kernel,
+                {"prev_slots_ptr": "*bf16", "input_ids_ptr": "*i32", "anchor_ptr": "*i64",
+                 "out_ptr": "*i64", "logits_ptr": logits, "logits_stride": "i32",
+                 "top_col_ptr": "*i32", "top_val_ptr": "*fp32", "succ_col_ptr": "*i32",
+                 "succ_bias_ptr": "*fp32", "w1_ptr": "*bf16", "w2_ptr": "*bf16",
+                 "slots_ptr": "*bf16", "step": "i32", "col_start": "i32", "rank": "i32",
+                 "w1_rows": "i32", "vocab": "i32"},
+                dict(FIRST=first, K=steps, C=cands, S=successors, S_P2=64, RANK=rank_dim,
+                     RANK_P2=512, TP=tp, TP_P2=2, TILE=mt.TILE),
+                4,
+            )
+    build(
+        mt._merge_top_kernel,
+        {"scratch_ptr": "*i64", "scratch_stride": "i32", "col_ptr": "*i32",
+         "val_ptr": "*fp32"},
+        dict(N=chunks * cands, N_P2=1024, C=cands),
+        4,
+    )
+    build(
+        mt._last_kernel,
+        {"slots_ptr": "*bf16", "out_ptr": "*i64", "step": "i32", "vocab": "i32"},
+        dict(K=steps, TP=tp, TP_P2=2),
+        1,
+    )
