+EXPECTED_MEMBERS = {
+    # module (layer index replaced by N) -> EXL3 members, in launch order
+    "self_attn.in_proj_qkvgfab": ["q_proj", "k_proj", "v_proj", "g_proj"],
+    "self_attn.o_proj": ["o_proj"],
+    "self_attn.fused_qkv_a_proj": ["q_a_proj", "kv_a_proj_with_mqa"],
+    "self_attn.q_b_proj": ["q_b_proj"],
+    "self_attn.g_proj": ["g_proj"],
+    "mlp.gate_up_proj": ["gate_proj", "up_proj"],
+    "mlp.down_proj": ["down_proj"],
+    "block_sparse_moe.shared_experts.gate_up_proj": ["gate_proj", "up_proj"],
+    "block_sparse_moe.shared_experts.down_proj": ["down_proj"],
+    "block_sparse_moe.routed_expert_down_proj": ["routed_expert_down_proj"],
+    "block_sparse_moe.routed_expert_up_proj": ["routed_expert_up_proj"],
+}
