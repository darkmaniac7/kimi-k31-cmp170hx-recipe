+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU-only inventory of a k31q v1 checkpoint directory.
+
+A k31q directory holds ``k31q_manifest.json``, ``codebooks.safetensors``, one
+or more safetensors files per decoder layer (``layer-NNN*.safetensors``,
+never two layers in one file) and the files the manifest lists under
+``other`` (embedding, head, vision). A pipeline stage may be given a view:
+the same layout with only its own layer files and a manifest filtered to
+them; a mini checkpoint holds a handful of layers. :class:`K31QManifest`
+therefore takes the manifest as the list of files that are the checkpoint,
+requires each of them, and checks their headers against its fields.
+
+Three storage classes:
+  plain   ``<name>.weight`` and every other tensor, original dtype and shape;
+  dense   EXL3 (``.trellis/.suh/.svh/.mul1``), read by the header rules of
+          :class:`vllm.sm80.kernels.exl3.utils.Exl3Manifest`, which this
+          class extends;
+  routed experts, per (layer, projection w1/w3/w2), one of
+          ``vq``    stacked ``<base>.vq_idx`` U8 [experts, I / 128, record
+                    bytes] and ``<base>.vq_scale`` F16 [experts, I / 128,
+                    scales], encoded as vllm/sm80/kernels/k31q/codec.py
+                    defines, with a codebook ``vq.<id>`` in
+                    codebooks.safetensors;
+          ``exl3``  one EXL3 matrix per expert,
+                    ``<experts>.<E>.<w>.trellis`` and so on.
+"""
+
+import json
+import re
+from dataclasses import dataclass
+from pathlib import Path
+
+import torch
+
+from vllm.logger import init_logger
+from vllm.sm80.kernels.exl3.utils import (
+    Exl3Manifest,
+    PackedMatrix,
+    TensorHeader,
+    _unique_object,
+    read_headers,
+)
+from vllm.sm80.kernels.k31q.codec import (
+    BLOCK,
+    IN_LATENT,
+    PROJECTION_ROLES,
+    VqGeometry,
+)
+
+logger = init_logger(__name__)
+
+MANIFEST_NAME = "k31q_manifest.json"
+INDEX_NAME = "model.safetensors.index.json"
+CODEBOOK_FILE = "codebooks.safetensors"
+# The vision tower and the projector, plain, under their released names. A
+# checkpoint without it serves text only (vllm/sm80/kernels/k31q/loader.py).
+VISION_FILE = "vision.safetensors"
+# Safetensors files a checkpoint directory may carry that hold no model
+# tensors (reference activations of a mini checkpoint): never read, listed
+# in the manifest or not.
+NON_MODEL_FILES = ("ref_acts.safetensors",)
+# Model files the manifest must list under "other" when the directory holds
+# them: left unlisted, the loader would never read them and the model would
+# fail later (or, for the vision file, be taken for a text-only checkpoint).
+OTHER_MODEL_FILES = ("embed.safetensors", "head.safetensors", VISION_FILE)
+CODEBOOK_PREFIX = "vq."
+FORMAT, VERSION = "k31q", 1
+PROJECTIONS = ("w1", "w3", "w2")
+VQ, EXL3, PLAIN = "vq", "exl3", "plain"
+_LAYER_FILE = re.compile(r"^layer-(\d{3,})(\.[A-Za-z0-9]+)?\.safetensors$")
+_LAYER_NAME = re.compile(r"(?:^|\.)layers\.(\d+)\.")
+_EXPERT_MATRIX = re.compile(r"^(?P<base>.+\.experts)\.(?P<expert>\d+)\.(?P<w>w[123])$")
+_TORCH_DTYPES = {
+    "U8": torch.uint8,
+    "F16": torch.float16,
+    "BF16": torch.bfloat16,
+    "F32": torch.float32,
+    "I16": torch.int16,
+    "I32": torch.int32,
+    "I64": torch.int64,
+}
+
+
+def layer_of(name: str) -> int | None:
+    """Decoder layer index of a checkpoint tensor name, None outside layers."""
+    match = _LAYER_NAME.search(name)
+    return int(match.group(1)) if match else None
+
+
+def read_rows(
+    header: TensorHeader, rows: slice | None = None, inner: slice | None = None
+) -> tuple[torch.Tensor, int]:
+    """Read ``header[rows]`` (first axis), or with ``inner`` the range
+    ``header[:, inner]`` of every first-axis entry, by byte ranges.
+
+    Returns the tensor and the bytes read from the file. ``inner`` is how a
+    tensor-parallel rank reads its I-blocks of a stacked expert tensor: one
+    contiguous range per expert, never the whole tensor.
+    """
+    shape = list(header.shape)
+    dtype = _TORCH_DTYPES[header.dtype]
+    if not shape:
+        raise ValueError(f"k31q range read of a scalar: {header.name}")
+    first = header.nbytes // shape[0] if shape[0] else 0
+    if inner is None:
+        rows = rows or slice(0, shape[0])
+        if not 0 <= rows.start <= rows.stop <= shape[0]:
+            raise ValueError(f"k31q row range outside {header.name}")
+        ranges = [(rows.start * first, (rows.stop - rows.start) * first)]
+        shape[0] = rows.stop - rows.start
+    else:
+        if rows is not None or len(shape) < 2:
+            raise ValueError(f"k31q inner range needs a stacked tensor: {header.name}")
+        if not 0 <= inner.start <= inner.stop <= shape[1]:
+            raise ValueError(f"k31q block range outside {header.name}")
+        second = first // shape[1] if shape[1] else 0
+        width = (inner.stop - inner.start) * second
+        if inner.start == 0 and inner.stop == shape[1]:
+            ranges = [(0, header.nbytes)]
+        else:
+            ranges = [
+                (entry * first + inner.start * second, width)
+                for entry in range(shape[0])
+            ]
+        shape[1] = inner.stop - inner.start
+    total = sum(length for _, length in ranges)
+    buffer = bytearray(total)
+    view, done = memoryview(buffer), 0
+    with header.path.open("rb") as file:
+        for start, length in ranges:
+            file.seek(header.offset + start)
+            if file.readinto(view[done : done + length]) != length:
+                raise ValueError(f"Truncated k31q tensor: {header.name}")
+            done += length
+    if not total:
+        return torch.empty(shape, dtype=dtype), 0
+    return torch.frombuffer(buffer, dtype=dtype).reshape(shape), total
+
+
+@dataclass(frozen=True)
+class _MarkerHeader(TensorHeader):
+    """The header of an EXL3 codebook marker (a 4-byte scalar) whose bytes
+    were read with its file's other markers through one open file."""
+
+    data: bytes = b""
+
+    def read_bytes(self) -> bytes:
+        return self.data
+
+
+def _with_markers(path: Path, headers: dict[str, TensorHeader]) -> dict:
+    """``headers`` of one file with its EXL3 marker scalars read. The EXL3
+    header rules read each matrix's marker to tell its codebook
+    (Exl3Manifest._matrix), one file open per matrix; with 2,688 expert
+    matrices in a layer file that is done here in one pass per file."""
+    markers = [
+        header
+        for name, header in headers.items()
+        if name.endswith((".mul1", ".mcg")) and header.nbytes == 4
+    ]
+    if not markers:
+        return headers
+    headers = dict(headers)
+    with path.open("rb") as file:
+        for header in markers:
+            file.seek(header.offset)
+            data = file.read(4)
+            if len(data) != 4:
+                raise ValueError(f"Truncated k31q tensor: {header.name}")
+            headers[header.name] = _MarkerHeader(
+                header.name,
+                header.path,
+                header.dtype,
+                header.shape,
+                header.data_start,
+                header.data_offsets,
+                data,
+            )
+    return headers
+
+
+@dataclass(frozen=True)
+class ExpertProjection:
+    """One (layer, projection) of the routed experts as the checkpoint holds it."""
+
+    layer: int
+    name: str  # w1 (gate), w3 (up) or w2 (down)
+    method: str  # vq or exl3
+    base: str  # "<...>.block_sparse_moe.experts"
+    experts: int
+    # vq: the stacked tensors, the codebook and the record parameters.
+    idx: TensorHeader | None = None
+    scale: TensorHeader | None = None
+    codebook: str | None = None
+    dim: int = 0
+    index_bits: int = 0
+    group_size: int = 0
+    # exl3: the per-expert matrices in expert order.
+    matrices: tuple[PackedMatrix, ...] = ()
+    # [out, in] of one whole expert matrix when the manifest gives it.
+    shape: tuple[int, int] | None = None
+
+    @property
+    def role(self) -> str:
+        return PROJECTION_ROLES[self.name]
+
+    @property
+    def blocks(self) -> int:
+        """I-blocks of the whole intermediate."""
+        if self.method == VQ:
+            assert self.idx is not None
+            return self.idx.shape[1]
+        matrix = self.matrices[0]
+        side = matrix.padded_out if self.role == IN_LATENT else matrix.padded_in
+        return side // BLOCK
+
+    @property
+    def keys(self) -> tuple[str, ...]:
+        """Checkpoint tensors of this projection."""
+        if self.method == VQ:
+            assert self.idx is not None and self.scale is not None
+            return (self.idx.name, self.scale.name)
+        return tuple(key for matrix in self.matrices for key in matrix.keys)
+
+    def geometry(self, latent: int) -> VqGeometry:
+        return VqGeometry(self.role, latent, self.dim, self.index_bits, self.group_size)
+
+    def validate(self, experts: int, latent: int, intermediate: int) -> None:
+        """Check the stored tensors against the model's expert count, latent
+        (routed expert hidden) size and whole intermediate size."""
+        where = f"layer {self.layer} {self.name}"
+        if self.experts != experts:
+            raise ValueError(
+                f"k31q {where}: checkpoint holds {self.experts} experts, the "
+                f"model has {experts}"
+            )
+        if intermediate % BLOCK or self.blocks * BLOCK != intermediate:
+            raise ValueError(
+                f"k31q {where}: checkpoint holds {self.blocks} I-blocks, the "
+                f"model's intermediate size is {intermediate}"
+            )
+        if self.method == VQ:
+            assert self.idx is not None and self.scale is not None
+            geometry = self.geometry(latent)
+            if (
+                self.idx.shape[2] != geometry.record_bytes
+                or self.scale.shape[2] != geometry.record_scales
+            ):
+                raise ValueError(
+                    f"k31q {where}: records of {self.idx.shape[2]} bytes and "
+                    f"{self.scale.shape[2]} scales, expected "
+                    f"{geometry.record_bytes} and {geometry.record_scales} for "
+                    f"latent {latent} ({geometry})"
+                )
+            return
+        k, n = (
+            (latent, intermediate) if self.role == IN_LATENT else (intermediate, latent)
+        )
+        for matrix in self.matrices:
+            matrix.validate_logical(k, n)
+
+
+class K31QManifest(Exl3Manifest):
+    """The tensors of a k31q directory, checked against ``k31q_manifest.json``.
+
+    The manifest says which files are the checkpoint: the layer files of the
+    layers it lists (all layers, one pipeline stage's, or the handful of a
+    mini checkpoint; they need not be contiguous) and the files under
+    ``other``. Each must be present. Other safetensors files of the directory
+    are not checkpoint data and are left alone (``ignored_files``), except a
+    layer file the manifest does not list, which is an error: a stage must
+    never see another stage's layers.
+
+    ``layers``   decoder layers the manifest lists, each with its entry;
+    ``expert_projections``  (layer, w) -> :class:`ExpertProjection`;
+    ``codebooks``           codebook id -> its tensor header;
+    ``stage``    the view's stage record when the manifest carries one.
+    """
+
+    def __init__(self, directory: str | Path):
+        directory = Path(directory)
+        path = directory / MANIFEST_NAME
+        if not path.is_file():
+            raise ValueError(f"k31q checkpoint without {MANIFEST_NAME}: {directory}")
+        self.meta = json.loads(path.read_text(), object_pairs_hook=_unique_object)
+        if self.meta.get("format") != FORMAT or self.meta.get("version") != VERSION:
+            raise ValueError(
+                f"Unsupported k31q manifest: format {self.meta.get('format')!r} "
+                f"version {self.meta.get('version')!r}"
+            )
+        # Not Exl3Manifest.__init__: that takes every safetensors file of the
+        # directory as checkpoint data and requires the index to match them.
+        # Here the manifest selects the files; the EXL3 header rules
+        # (_matrix, expect) apply to what they hold.
+        self.directory = directory
+        self.tensors: dict[str, TensorHeader] = {}
+        self.matrices: dict[str, PackedMatrix] = {}
+        self.unused: dict[str, str] = {}
+        self.unselected = 0
+        self.ple_tables: dict = {}
+        self.stage: dict | None = self.meta.get("stage")
+        self.layers: dict[int, dict] = {}
+        self.codebooks: dict[str, TensorHeader] = {}
+        self.expert_projections: dict[tuple[int, str], ExpertProjection] = {}
+        self.ignored_files: list[str] = []
+        self._read_headers(self._check_files())
+        self._check_layer_tensors()
+        self._check_codebooks()
+        for layer, entry in sorted(self.layers.items()):
+            self._check_dense(layer, entry)
+            self._check_experts(layer, entry)
+        self._check_owners()
+
+    # -- files ---------------------------------------------------------------
+
+    def _base_unchanged_dir(self) -> Path | None:
+        raw = self.meta.get("base_unchanged_dir")
+        if raw is None and isinstance(self.meta.get("source"), dict):
+            raw = self.meta["source"].get("base_unchanged_dir")
+        if not isinstance(raw, str) or not raw.strip():
+            return None
+        base = Path(raw.strip())
+        return base if base.is_absolute() else self.directory.parent / base
+
+    def _check_files(self) -> list[Path]:
+        """Check the files the manifest lists against the directory; return
+        the ones that hold checkpoint tensors."""
+        present = {p.name: p for p in sorted(self.directory.glob("*.safetensors"))}
+        base_dir = self._base_unchanged_dir()
+        resolved: dict[str, Path] = {}
+
+        def _locate(name: str) -> Path | None:
+            if name in present:
+                return present[name]
+            if base_dir is not None:
+                candidate = base_dir / name
+                if candidate.is_file():
+                    return candidate
+            return None
+
+        listed: dict[str, int] = {}
+        layers = self.meta.get("layers")
+        if not isinstance(layers, dict) or not layers:
+            raise ValueError("k31q manifest lists no layers")
+        for key, entry in layers.items():
+            layer = int(key)
+            files = entry.get("file")
+            if not isinstance(files, list) or not files:
+                raise ValueError(f"k31q manifest layer {layer} lists no file")
+            size = 0
+            for name in files:
+                match = _LAYER_FILE.match(name)
+                if match is None or int(match.group(1)) != layer:
+                    raise ValueError(
+                        f"k31q manifest layer {layer} lists a file of another "
+                        f"name: {name}"
+                    )
+                path = _locate(name)
+                if path is None:
+                    if base_dir is not None:
+                        raise ValueError(
+                            f"k31q manifest layer {layer} lists {name}, which is not "
+                            f"in this directory or base_unchanged_dir ({base_dir})"
+                        )
+                    raise ValueError(
+                        f"k31q manifest layer {layer} lists {name}, which is not "
+                        "in this directory (a stage view must filter its manifest)"
+                    )
+                if name in listed:
+                    raise ValueError(f"k31q manifest lists {name} twice")
+                listed[name] = layer
+                resolved[name] = path
+                size += path.stat().st_size
+            # A zero is a placeholder (the format request shows one), not a size.
+            if entry.get("bytes") and entry["bytes"] != size:
+                raise ValueError(
+                    f"k31q layer {layer}: files hold {size} bytes, the manifest "
+                    f"says {entry['bytes']}"
+                )
+            self.layers[layer] = entry
+        other = self.meta.get("other", {})
+        for name, entry in other.items():
+            path = _locate(name)
+            if path is None:
+                if base_dir is not None:
+                    raise ValueError(
+                        f"k31q manifest lists {name}, which is not in this "
+                        f"directory or base_unchanged_dir ({base_dir})"
+                    )
+                raise ValueError(
+                    f"k31q manifest lists {name}, which is not in this directory"
+                )
+            resolved[name] = path
+            size = path.stat().st_size
+            if isinstance(entry, dict) and (entry.get("bytes") or size) != size:
+                raise ValueError(
+                    f"k31q {name}: file holds {size} bytes, the manifest says "
+                    f"{entry['bytes']}"
+                )
+        for name in present:
+            if name in listed or name in other:
+                continue
+            if _LAYER_FILE.match(name):
+                raise ValueError(f"k31q directory holds an unlisted layer file: {name}")
+            if name in OTHER_MODEL_FILES:
+                raise ValueError(
+                    f"k31q directory holds {name}, which the manifest does not "
+                    'list under "other" (a stage view must filter its manifest '
+                    "to the files it links)"
+                )
+            self.ignored_files.append(name)
+        skipped = [n for n in other if n in NON_MODEL_FILES]
+        self.ignored_files = sorted(set(self.ignored_files) | set(skipped))
+        if self.ignored_files:
+            logger.info(
+                "k31q: safetensors files outside the checkpoint are not read: %s",
+                self.ignored_files,
+            )
+        self.base_unchanged_dir = base_dir
+        self.files = resolved
+        self.layer_files = listed
+        return [
+            resolved[name]
+            for name in sorted(set(listed) | set(other))
+            if name not in NON_MODEL_FILES
+        ]
+
+    def _read_headers(self, files: list[Path]) -> None:
+        """Headers of the selected files, the index cross-check for those
+        files, and the EXL3 matrices among their tensors."""
+        for path in files:
+            for name, tensor in _with_markers(path, read_headers(path)).items():
+                if name in self.tensors:
+                    raise ValueError(f"Duplicate k31q source tensor: {name}")
+                self.tensors[name] = tensor
+        self.tensors = dict(sorted(self.tensors.items()))
+        index = self.directory / INDEX_NAME
+        if index.exists():
+            names = {path.name for path in files}
+            entries = json.loads(index.read_text(), object_pairs_hook=_unique_object)
+            for name, filename in entries["weight_map"].items():
+                # Entries of files this directory does not hold as checkpoint
+                # data (another stage's layers) are not this reader's concern.
+                if filename not in names:
+                    continue
+                tensor = self.tensors.get(name)
+                if tensor is None or tensor.path.name != filename:
+                    raise ValueError(f"k31q index/header conflict: {name}")
+        # (experts base, w) -> expert -> matrix: every per-expert EXL3 matrix
+        # is matched once, here, however many layers and projections ask
+        # (an all-EXL3 checkpoint has about 250,000 of them per rank).
+        self._expert_matrices: dict[tuple[str, str], dict[int, PackedMatrix]] = {}
+        for name, tensor in self.tensors.items():
+            if name.endswith(".trellis"):
+                prefix = name.removesuffix(".trellis")
+                matrix = self.matrices[prefix] = self._matrix(prefix, tensor)
+                match = _EXPERT_MATRIX.match(prefix)
+                if match:
+                    self._expert_matrices.setdefault((match["base"], match["w"]), {})[
+                        int(match["expert"])
+                    ] = matrix
+        packed = {key for matrix in self.matrices.values() for key in matrix.keys}
+        for name in self.tensors:
+            if name.endswith((".suh", ".svh", ".mcg", ".mul1")) and name not in packed:
+                raise ValueError(f"Orphan EXL3 quantization tensor: {name}")
+
+    def _check_layer_tensors(self) -> None:
+        """A layer file holds tensors of its own layer only, under one prefix."""
+        listed = self.layer_files
+        self._layer_prefixes: dict[int, str] = {}
+        for name, header in self.tensors.items():
+            layer = listed.get(header.path.name)
+            match = _LAYER_NAME.search(name)
+            found = int(match.group(1)) if match else None
+            if layer is None and found is not None:
+                raise ValueError(
+                    f"k31q layer tensor outside a layer file: {name} in "
+                    f"{header.path.name}"
+                )
+            if layer is None:
+                continue
+            prefix = self._layer_prefixes.setdefault(
+                layer, name[: match.end()] if match else ""
+            )
+            if found != layer or not name.startswith(prefix):
+                raise ValueError(
+                    f"k31q {header.path.name} holds a tensor of another layer: {name}"
+                )
+        for layer in self.layers:
+            if layer not in self._layer_prefixes:
+                raise ValueError(f"k31q layer {layer} holds no tensors")
+
+    @property
+    def has_vision(self) -> bool:
+        """Whether the checkpoint (or this stage's view of it) lists the
+        vision file."""
+        return VISION_FILE in self.meta.get("other", {})
+
+    def tensor_layer(self, name: str) -> int | None:
+        """Decoder layer of a checkpoint tensor (None: embedding, head,
+        codebooks, vision)."""
+        return self.layer_files.get(self.tensors[name].path.name)
+
+    # -- codebooks -----------------------------------------------------------
+
+    def _check_codebooks(self) -> None:
+        declared = self.meta.get("codebooks", {})
+        for name, header in self.tensors.items():
+            if header.path.name != CODEBOOK_FILE:
+                if name.startswith(CODEBOOK_PREFIX):
+                    raise ValueError(f"k31q codebook outside {CODEBOOK_FILE}: {name}")
+                continue
+            if not name.startswith(CODEBOOK_PREFIX):
+                raise ValueError(f"k31q {CODEBOOK_FILE} holds a foreign tensor: {name}")
+            book = name.removeprefix(CODEBOOK_PREFIX)
+            spec = declared.get(book)
+            if spec is None:
+                raise ValueError(f"k31q codebook missing from the manifest: {book}")
+            dim, bits = spec.get("dim"), spec.get("index_bits")
+            if (
+                type(dim) is not int
+                or type(bits) is not int
+                or header.dtype != "F16"
+                or header.shape != (1 << bits, dim)
+                or spec.get("entries", 1 << bits) != 1 << bits
+            ):
+                raise ValueError(
+                    f"k31q codebook {book}: {header.dtype} {header.shape} does "
+                    f"not match the manifest ({spec})"
+                )
+            self.codebooks[book] = header
+        missing = declared.keys() - self.codebooks.keys()
+        if missing:
+            raise ValueError(
+                f"k31q codebooks missing from the files: {sorted(missing)}"
+            )
+
+    # -- dense ---------------------------------------------------------------
+
+    def layer_prefix(self, layer: int) -> str:
+        """Checkpoint name prefix of a decoder layer, taken from its tensors
+        (``language_model.model.layers.<L>.`` in a K3.1 checkpoint)."""
+        return self._layer_prefixes[layer]
+
+    def _check_dense(self, layer: int, entry: dict) -> None:
+        prefix = self.layer_prefix(layer)
+        for name, spec in entry.get("dense", {}).items():
+            source = f"{prefix}{name}"
+            method = spec.get("method")
+            if method == EXL3:
+                matrix = self.matrices.get(source)
+                if matrix is None:
+                    raise ValueError(f"k31q dense EXL3 matrix missing: {source}")
+                bits = spec.get("bits")
+                if bits is not None and matrix.bits_x2 != 2 * bits:
+                    raise ValueError(
+                        f"k31q {source}: bits_x2 {matrix.bits_x2} in the file, "
+                        f"K{bits} in the manifest"
+                    )
+                shape = spec.get("shape")
+                if shape is not None:
+                    matrix.validate_logical(shape[1], shape[0])
+            elif method == PLAIN:
+                if f"{source}.weight" not in self.tensors:
+                    raise ValueError(f"k31q plain matrix missing: {source}.weight")
+            else:
+                raise ValueError(
+                    f"k31q {source}: unknown dense method {method!r} (exl3 or plain)"
+                )
+
+    # -- routed experts ------------------------------------------------------
+
+    def _check_experts(self, layer: int, entry: dict) -> None:
+        experts = entry.get("experts") or {}
+        if not experts:
+            return
+        if set(experts) != set(PROJECTIONS):
+            raise ValueError(
+                f"k31q layer {layer}: experts need w1, w3 and w2, the manifest "
+                f"has {sorted(experts)}"
+            )
+        base = f"{self.layer_prefix(layer)}block_sparse_moe.experts"
+        for name in PROJECTIONS:
+            spec = experts[name]
+            method = spec.get("method")
+            if method == VQ:
+                projection = self._vq_projection(layer, name, base, spec)
+            elif method == EXL3:
+                projection = self._exl3_projection(layer, name, base, spec)
+            else:
+                raise ValueError(
+                    f"k31q layer {layer} {name}: unknown expert method "
+                    f"{method!r} (vq or exl3)"
+                )
+            self.expert_projections[layer, name] = projection
+        counts = {self.expert_projections[layer, n].experts for n in PROJECTIONS}
+        blocks = {self.expert_projections[layer, n].blocks for n in PROJECTIONS}
+        if len(counts) != 1 or len(blocks) != 1:
+            raise ValueError(
+                f"k31q layer {layer}: w1, w3 and w2 disagree on experts "
+                f"{sorted(counts)} or I-blocks {sorted(blocks)}"
+            )
+
+    def _vq_projection(self, layer, name, base, spec) -> ExpertProjection:
+        where = f"layer {layer} {name}"
+        idx = self.tensors.get(f"{base}.{name}.vq_idx")
+        scale = self.tensors.get(f"{base}.{name}.vq_scale")
+        if idx is None or scale is None:
+            raise ValueError(f"k31q {where}: vq_idx or vq_scale tensor missing")
+        if (
+            idx.dtype != "U8"
+            or scale.dtype != "F16"
+            or len(idx.shape) != 3
+            or len(scale.shape) != 3
+            or idx.shape[:2] != scale.shape[:2]
+            or 0 in idx.shape
+            or 0 in scale.shape
+        ):
+            raise ValueError(
+                f"k31q {where}: vq_idx {idx.dtype} {idx.shape} and vq_scale "
+                f"{scale.dtype} {scale.shape} are not U8 and F16 "
+                "[experts, I / 128, n]"
+            )
+        if spec.get("vec_axis", "in") != "in" or spec.get("group_axis", "in") != "in":
+            raise ValueError(
+                f"k31q {where}: only vectors and scale groups along the input "
+                "axis are defined in format version 1"
+            )
+        book = spec.get("codebook")
+        declared = self.meta.get("codebooks", {}).get(book)
+        if book not in self.codebooks or declared is None:
+            raise ValueError(
+                f"k31q {where}: codebook {book!r} is not in the checkpoint"
+            )
+        dim, bits, group = (spec.get(k) for k in ("dim", "index_bits", "group_size"))
+        if any(type(v) is not int or v <= 0 for v in (dim, bits, group)):
+            raise ValueError(
+                f"k31q {where}: dim, index_bits and group_size must be set"
+            )
+        if (dim, bits) != (declared["dim"], declared["index_bits"]):
+            raise ValueError(
+                f"k31q {where}: dim {dim} and index_bits {bits} do not match "
+                f"codebook {book} ({declared['dim']}, {declared['index_bits']})"
+            )
+        record = spec.get("record_bytes")
+        if record and record != idx.shape[2]:
+            raise ValueError(
+                f"k31q {where}: records of {idx.shape[2]} bytes in the file, "
+                f"{record} in the manifest"
+            )
+        if idx.shape[2] % 16:
+            raise ValueError(f"k31q {where}: record size is not a multiple of 16")
+        projection = ExpertProjection(
+            layer=layer,
+            name=name,
+            method=VQ,
+            base=base,
+            experts=idx.shape[0],
+            idx=idx,
+            scale=scale,
+            codebook=book,
+            dim=dim,
+            index_bits=bits,
+            group_size=group,
+            shape=self._shape(spec),
+        )
+        self._check_shape(projection)
+        return projection
+
+    def _exl3_projection(self, layer, name, base, spec) -> ExpertProjection:
+        where = f"layer {layer} {name}"
+        found = self._expert_matrices.get((base, name), {})
+        if not found or sorted(found) != list(range(len(found))):
+            raise ValueError(
+                f"k31q {where}: EXL3 expert matrices are missing or not "
+                f"numbered 0..{max(len(found) - 1, 0)}"
+            )
+        matrices = tuple(found[expert] for expert in range(len(found)))
+        bits = spec.get("bits")
+        for matrix in matrices:
+            if bits is not None and matrix.bits_x2 != 2 * bits:
+                raise ValueError(
+                    f"k31q {matrix.prefix}: bits_x2 {matrix.bits_x2} in the "
+                    f"file, K{bits} in the manifest"
+                )
+            if (matrix.padded_in, matrix.padded_out) != (
+                matrices[0].padded_in,
+                matrices[0].padded_out,
+            ):
+                raise ValueError(f"k31q {where}: expert matrices differ in size")
+        projection = ExpertProjection(
+            layer=layer,
+            name=name,
+            method=EXL3,
+            base=base,
+            experts=len(matrices),
+            matrices=matrices,
+            shape=self._shape(spec),
+        )
+        self._check_shape(projection)
+        return projection
+
+    @staticmethod
+    def _shape(spec: dict) -> tuple[int, int] | None:
+        shape = spec.get("shape")
+        if shape is None:
+            return None
+        if len(shape) != 2 or any(type(v) is not int or v <= 0 for v in shape):
+            raise ValueError(f"k31q expert shape must be [out, in]: {shape}")
+        return shape[0], shape[1]
+
+    @staticmethod
+    def _check_shape(projection: ExpertProjection) -> None:
+        """With the manifest's [out, in] the stored sizes are checked here;
+        without it the MoE method checks them against the model."""
+        if projection.shape is None:
+            return
+        out_f, in_f = projection.shape
+        latent, inter = (in_f, out_f) if projection.role == IN_LATENT else (out_f, in_f)
+        projection.validate(projection.experts, latent, inter)
+
+    def expert_method(self, layer: int) -> str:
+        """The routed-expert method of a layer. One kernel call takes all
+        three projections, so they must share it (their rates may differ)."""
+        methods = {
+            name: self.expert_projections[layer, name].method
+            for name in PROJECTIONS
+            if (layer, name) in self.expert_projections
+        }
+        if len(methods) != len(PROJECTIONS):
+            raise ValueError(f"k31q layer {layer} holds no routed experts")
+        if len(set(methods.values())) != 1:
+            raise ValueError(
+                f"k31q layer {layer}: w1, w3 and w2 must share one expert "
+                f"method at run time, the manifest has {methods}"
+            )
+        return methods["w1"]
+
+    # -- owners --------------------------------------------------------------
+
+    def _check_owners(self) -> None:
+        """Every stacked or per-expert routed tensor belongs to a projection
+        the manifest declares."""
+        owned = {
+            key
+            for projection in self.expert_projections.values()
+            for key in projection.keys
+        }
+        for name in self.tensors:
+            if name.endswith((".vq_idx", ".vq_scale")) and name not in owned:
+                raise ValueError(f"Orphan k31q VQ tensor: {name}")
+        for matrices in self._expert_matrices.values():
+            for matrix in matrices.values():
+                if matrix.keys[0] not in owned:
+                    raise ValueError(f"Orphan k31q EXL3 expert matrix: {matrix.prefix}")
+
+    def verify_hashes(self) -> list[str]:
+        """Names of the present files whose sha256 differs from the manifest
+        (reads every file whole: a maintenance check, not part of loading)."""
+        import hashlib
+
+        expected: dict[str, str] = {}
+        for entry in self.layers.values():
+            for name, digest in zip(entry["file"], entry.get("sha256", [])):
+                expected[name] = digest
+        for name, entry in self.meta.get("other", {}).items():
+            if isinstance(entry, dict) and "sha256" in entry:
+                expected[name] = entry["sha256"]
+        wrong = []
+        for name, digest in sorted(expected.items()):
+            sha = hashlib.sha256()
+            with self.files.get(name, self.directory / name).open("rb") as file:
+                for chunk in iter(lambda: file.read(1 << 22), b""):
+                    sha.update(chunk)
+            if sha.hexdigest() != digest:
+                wrong.append(name)
+        return wrong
