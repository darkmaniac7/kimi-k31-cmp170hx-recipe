+@torch.inference_mode()
+def test_layer_profile_run_reserves_memory_and_touches_no_cache(harness):
+    """The engine's first forward has no attention metadata: the indexer
+    reserves its workspace and peak logits and returns; keys, latent rows
+    and the top-k buffer stay as they were."""
+    from vllm.forward_context import set_forward_context
+    from vllm.v1.worker.workspace import current_workspace_manager
+
+    x = torch.randn((16, harness.text.hidden_size), device=DEVICE).to(torch.bfloat16)
+    positions = torch.arange(16, device=DEVICE)
+    harness.topk.fill_(-5)
+    with set_forward_context(None, harness.config):
+        out = harness.layer(positions, x)
+    assert out.shape == (16, harness.text.hidden_size)
+    assert (harness.topk == -5).all()
+    assert torch.count_nonzero(harness.indexer.k_cache.kv_cache) == 0
+    assert torch.count_nonzero(harness.mla.kv_cache) == 0
+    # The reservation covers what a later step asks of the workspace.
+    current_workspace_manager().lock()
+    try:
+        _check_step(harness, harness.step({0: 300}, seed=3))
+        _check_step(harness, harness.step({0: 1}, seed=4))
+    finally:
+        current_workspace_manager().unlock()
+
