+++ b/vllm/sm80/kernels/k31q/codec.py
@@ -0,0 +1,205 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Canonical VQ record encoding of the k31q v1 format.
+
+Everything that knows how a routed-expert matrix is laid out in a ``vq_idx`` /
+``vq_scale`` record is in this file: :func:`vq_pack` and :func:`vq_unpack` are
+the one pack/unpack pair, and :class:`VqGeometry` gives the sizes the manifest
+and the loader check. A change of the record layout is a change here only.
+
+One expert matrix W[out, in] with intermediate size I (a multiple of 128):
+  role ``in_latent``  (w1 gate, w3 up):  out = I, in = latent. I-block b holds
+      output rows [128b, 128b + 128) and every input.
+  role ``out_latent`` (w2 down):         out = latent, in = I. I-block b holds
+      input columns [128b, 128b + 128) and every output.
+Vectors of ``dim`` weights run along the input axis. Inside a record the
+indices go row by row (in_latent: the block's 128 rows; out_latent: all
+latent rows), each ``index_bits`` wide, as a little-endian bitstream padded
+with zero bytes to a multiple of 16 bytes. Scales: one FP16 per (row, group
+of ``group_size`` consecutive inputs of the record), same order.
+  W[o, c] = scale[o, c // group_size] * codebook[idx[o, c // dim], c % dim]
+with c counted inside the record (in_latent: over all inputs; out_latent:
+over the block's 128 inputs). The product is taken in FP32.
+Stacked tensors: ``vq_idx`` U8 [experts, I / 128, record_bytes] and
+``vq_scale`` F16 [experts, I / 128, scales_per_record], so the I-blocks one
+tensor-parallel rank holds are one byte range per expert.
+"""
+
+from dataclasses import dataclass
+
+import torch
+
+BLOCK = 128
+RECORD_ALIGN = 16
+IN_LATENT = "in_latent"
+OUT_LATENT = "out_latent"
+# Role of each routed-expert projection (HF names: w1 gate, w3 up, w2 down).
+PROJECTION_ROLES = {"w1": IN_LATENT, "w3": IN_LATENT, "w2": OUT_LATENT}
+
+
+@dataclass(frozen=True)
+class VqGeometry:
+    """Sizes of one (expert, I-block) record."""
+
+    role: str
+    latent: int
+    dim: int
+    index_bits: int
+    group_size: int
+
+    def __post_init__(self):
+        if self.role not in (IN_LATENT, OUT_LATENT):
+            raise ValueError(f"Unknown k31q VQ role: {self.role!r}")
+        if self.latent <= 0 or self.dim <= 0 or self.group_size <= 0:
+            raise ValueError("k31q VQ sizes must be positive")
+        if RECORD_ALIGN % self.dim:
+            raise ValueError(f"k31q VQ vector size {self.dim} must divide 16")
+        if not 1 <= self.index_bits <= 16:
+            raise ValueError(f"k31q VQ index bits {self.index_bits} not in 1..16")
+        if self.columns % self.dim:
+            raise ValueError(
+                f"k31q VQ vectors of {self.dim} do not tile {self.columns} inputs"
+            )
+
+    @property
+    def rows(self) -> int:
+        """Matrix rows (outputs) one record holds."""
+        return BLOCK if self.role == IN_LATENT else self.latent
+
+    @property
+    def columns(self) -> int:
+        """Matrix columns (inputs) one record holds."""
+        return self.latent if self.role == IN_LATENT else BLOCK
+
+    @property
+    def vectors(self) -> int:
+        """Code vectors per row of a record."""
+        return self.columns // self.dim
+
+    @property
+    def groups(self) -> int:
+        """Scales per row of a record."""
+        return -(-self.columns // self.group_size)
+
+    @property
+    def record_bytes(self) -> int:
+        payload = -(-(self.rows * self.vectors * self.index_bits) // 8)
+        return -(-payload // RECORD_ALIGN) * RECORD_ALIGN
+
+    @property
+    def record_scales(self) -> int:
+        return self.rows * self.groups
+
+    def matrix_shape(self, blocks: int) -> tuple[int, int]:
+        """[out, in] of the matrix that ``blocks`` consecutive records hold."""
+        if self.role == IN_LATENT:
+            return blocks * BLOCK, self.latent
+        return self.latent, blocks * BLOCK
+
+
+def pack_indices(indices: torch.Tensor, index_bits: int, nbytes: int) -> torch.Tensor:
+    """``indices`` [..., count] -> U8 [..., nbytes]: a little-endian bitstream
+    of ``index_bits``-wide values, zero padded."""
+    indices = indices.to(torch.int64)
+    count = indices.shape[-1]
+    if count * index_bits > nbytes * 8:
+        raise ValueError("k31q VQ indices do not fit the record")
+    if indices.numel() and (
+        int(indices.min()) < 0 or int(indices.max()) >= 1 << index_bits
+    ):
+        raise ValueError("k31q VQ index out of range")
+    bit = torch.arange(index_bits, dtype=torch.int64)
+    bits = ((indices.unsqueeze(-1) >> bit) & 1).reshape(*indices.shape[:-1], -1)
+    padded = torch.zeros(*indices.shape[:-1], nbytes * 8, dtype=torch.int64)
+    padded[..., : count * index_bits] = bits
+    weights = 1 << torch.arange(8, dtype=torch.int64)
+    packed = (padded.reshape(*indices.shape[:-1], nbytes, 8) * weights).sum(-1)
+    return packed.to(torch.uint8)
+
+
+def unpack_indices(records: torch.Tensor, index_bits: int, count: int) -> torch.Tensor:
+    """U8 ``records`` [..., nbytes] -> int64 [..., count], the inverse of
+    :func:`pack_indices`. Each value is read from the three bytes that cover
+    its bits (bit offset in the first byte at most 7, at most 16 value bits)."""
+    if records.dtype != torch.uint8:
+        raise ValueError("k31q VQ records are U8")
+    nbytes = records.shape[-1]
+    if count * index_bits > nbytes * 8:
+        raise ValueError("k31q VQ record is too short for its indices")
+    if index_bits == 8:
+        return records[..., :count].to(torch.int64)
+    data = torch.nn.functional.pad(records, (0, 2)).to(torch.int64)
+    offset = torch.arange(count, dtype=torch.int64, device=records.device) * index_bits
+    first, shift = offset >> 3, offset & 7
+    word = data[..., first] | (data[..., first + 1] << 8) | (data[..., first + 2] << 16)
+    return (word >> shift) & ((1 << index_bits) - 1)
+
+
+def vq_pack(
+    indices: torch.Tensor, scales: torch.Tensor, geometry: VqGeometry
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """One expert matrix as code indices [out, in / dim] and scales
+    [out, in / group_size] -> (records U8 [I / 128, record_bytes], scales F16
+    [I / 128, record_scales])."""
+    g = geometry
+    if g.role == IN_LATENT:
+        blocks = indices.shape[0] // BLOCK
+        expect = (blocks * BLOCK, g.vectors), (blocks * BLOCK, g.groups)
+    else:
+        blocks = indices.shape[1] // g.vectors
+        expect = (g.latent, blocks * g.vectors), (g.latent, blocks * g.groups)
+    if blocks <= 0 or (tuple(indices.shape), tuple(scales.shape)) != expect:
+        raise ValueError(
+            f"k31q VQ pack: indices {tuple(indices.shape)} and scales "
+            f"{tuple(scales.shape)} do not form whole I-blocks ({g})"
+        )
+    records, record_scales = [], []
+    for block in range(blocks):
+        if g.role == IN_LATENT:
+            rows = slice(block * BLOCK, (block + 1) * BLOCK)
+            idx, scale = indices[rows], scales[rows]
+        else:
+            idx = indices[:, block * g.vectors : (block + 1) * g.vectors]
+            scale = scales[:, block * g.groups : (block + 1) * g.groups]
+        records.append(pack_indices(idx.reshape(-1), g.index_bits, g.record_bytes))
+        record_scales.append(scale.to(torch.float16).reshape(-1))
+    return torch.stack(records), torch.stack(record_scales)
+
+
+def vq_unpack(
+    records: torch.Tensor,
+    scales: torch.Tensor,
+    codebook: torch.Tensor,
+    geometry: VqGeometry,
+) -> torch.Tensor:
+    """Dequantize consecutive I-block records to FP32.
+
+    ``records`` U8 [..., blocks, record_bytes] and ``scales`` F16 [..., blocks,
+    record_scales] (any leading dimensions, such as experts), ``codebook``
+    [2 ** index_bits, dim]. Returns W [..., out, in] of the blocks given: a
+    tensor-parallel rank passes its own block range and gets its rows
+    (in_latent) or columns (out_latent) of the whole matrix.
+    """
+    g = geometry
+    if records.shape[-1] != g.record_bytes or scales.shape[-1] != g.record_scales:
+        raise ValueError(
+            f"k31q VQ record of {records.shape[-1]} bytes and "
+            f"{scales.shape[-1]} scales does not match {g}"
+        )
+    if records.shape[:-1] != scales.shape[:-1]:
+        raise ValueError("k31q VQ records and scales disagree on their blocks")
+    if tuple(codebook.shape) != (1 << g.index_bits, g.dim):
+        raise ValueError(f"k31q VQ codebook {tuple(codebook.shape)} does not match {g}")
+    lead, blocks = records.shape[:-2], records.shape[-2]
+    indices = unpack_indices(records, g.index_bits, g.rows * g.vectors)
+    weight = codebook.to(torch.float32)[indices].reshape(
+        *lead, blocks, g.rows, g.vectors * g.dim
+    )
+    scale = scales.to(torch.float32).reshape(*lead, blocks, g.rows, g.groups)
+    scale = scale.repeat_interleave(g.group_size, dim=-1)[..., : g.columns]
+    weight = weight * scale
+    if g.role == IN_LATENT:
+        # Blocks stack along the outputs.
+        return weight.reshape(*lead, blocks * g.rows, g.columns)
+    # Blocks stack along the inputs: [.., blocks, latent, 128] -> [.., latent, I].
+    return weight.transpose(-3, -2).reshape(*lead, g.rows, blocks * g.columns)
