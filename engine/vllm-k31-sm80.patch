+  if (total_slots <= 1024) {
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+      const int slot = tid + k * 256;
+      if (slot < total_slots) {
+        const int e = cached_e[k];
+        if (e >= 0) {
+          const int dst = atomicAdd(&sh_pos[e], 1);
+          sorted_rows[dst] = slot / routing.topk;
+          if (use_slot_out) slot_to_dst[slot] = dst;
+          else sorted_weights[dst] = topk_weights[slot];
+        } else if (use_slot_out) {
+          slot_to_dst[slot] = -1;
+        }
+      }
+    }
+  } else {
+    for (int i = tid; i < total_slots; i += 256) {
+      const int e = map_local_expert(routing, i);
+      if (e >= 0) {
+        const int dst = atomicAdd(&sh_pos[e], 1);
+        sorted_rows[dst] = i / routing.topk;
+        if (use_slot_out) slot_to_dst[i] = dst;
+        else sorted_weights[dst] = topk_weights[i];
+      } else if (use_slot_out) {
+        slot_to_dst[i] = -1;
+      }
+    }
+  }
+}
