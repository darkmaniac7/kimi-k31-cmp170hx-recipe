+def chunk_indices_from_counts(chunk_counts: list[int]) -> torch.Tensor:
+    """[NT, 2] int64 rows (sequence index into ``cu_seqlens``, chunk index
+    within that sequence), in sequence order. Sequences with no chunks (zero
