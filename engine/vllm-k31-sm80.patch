+    routed = model.model.layers[2].block_sparse_moe.experts.routed_experts
+    ref_kernel = routed.quant_method.reference_experts(routed)
+
+    g = torch.Generator().manual_seed(42)
+    x = torch.randn((4, latent), generator=g, dtype=torch.bfloat16)
+    ids = torch.arange(4 * topk, dtype=torch.int32).view(4, topk) % num_experts
