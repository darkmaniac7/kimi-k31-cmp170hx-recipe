+        else sorted_weights[dst] = topk_weights[lane];
+      } else if (use_slot_out) {
+        slot_to_dst[lane] = -1;
+      }
+    }
+    if (lane == 31) {
+      header[0] = wt;
+      header[1] = fast_rate ? ((wt > 0) ? (1 << rate_id_gu) : 0) : gu_mask;
+      header[2] = fast_rate ? ((wt > 0) ? (1 << rate_id_dn) : 0) : dn_mask;
+      header[3] = 0;
+    }
