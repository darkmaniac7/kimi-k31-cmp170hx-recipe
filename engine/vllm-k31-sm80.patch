+
+def _synth_vq_projection(
+    E: int,
+    H: int,
+    I: int,
+    role: str,
+    dim: int,
+    bits: int,
+    seed: int,
+):
+    g = torch.Generator(device="cuda").manual_seed(seed)
+    geom = VqGeometry(role=role, latent=H, dim=dim, index_bits=bits, group_size=128)
+    blocks = I // BLOCK
+    idx = torch.randint(
+        0, 256, (E, blocks, geom.record_bytes), device="cuda", generator=g, dtype=torch.uint8
+    )
+    scale = (
+        torch.randn((E, blocks, geom.record_scales), device="cuda", generator=g) * 0.04
+    ).to(torch.float16)
+    cb = (
+        torch.randn((1 << bits, dim), device="cuda", generator=g) * 0.5
+    ).to(torch.float16)
+    return geom, idx, scale, cb
+
+
+def _dense_moe_ref_gpu(
+    x: torch.Tensor,
+    ids: torch.Tensor,
+    weights: torch.Tensor,
+    w1_f32: torch.Tensor,
+    w3_f32: torch.Tensor,
+    w2_f32: torch.Tensor,
+    situ_beta: float = 1.0,
+    situ_linear_beta: float = 2.0,
+) -> torch.Tensor:
+    xf = x.float()
+    out = torch.zeros_like(xf)
+    E = w1_f32.size(0)
+    for e in range(E):
+        rows, slots = (ids == e).nonzero(as_tuple=True)
+        if rows.numel() == 0:
+            continue
+        rx = xf[rows]
+        hid = moe.situ_and_mul(
+            rx @ w1_f32[e].t(), rx @ w3_f32[e].t(), situ_beta, situ_linear_beta
+        )
+        out.index_add_(0, rows, (hid @ w2_f32[e].t()) * weights[rows, slots].unsqueeze(1))
+    return out.to(torch.bfloat16)
+
+
+@gpu_only
+@pytest.mark.parametrize(
+    ("dim", "bits"),
+    [(2, 3), (2, 4), (2, 5), (4, 5), (4, 6)],
+)
+def test_gpu_vq_tp4_i768_pack_dequant_and_moe_out_all_rates(dim: int, bits: int):
+    """Deliverable 2 silicon check: _k31_vq_C at K3.1 TP=4 shape (H=3584, I=768)
+    matches vq_unpack bit-for-bit on dequant and matches FP32 dense reference on
+    both moe_out_vq (decode) and moe_out_prefill_vq (prefill) across all 5 rates."""
+    _require_gpu_vq_and_glue()
+    E, H, I = 8, 3584, 768
+    rate_id = vq_ops.vq_rate_id(dim, bits)
+    assert rate_id >= 0
+
+    g1, idx1, sc1, cb1 = _synth_vq_projection(E, H, I, IN_LATENT, dim, bits, 100 + rate_id)
+    g3, idx3, sc3, cb3 = _synth_vq_projection(E, H, I, IN_LATENT, dim, bits, 200 + rate_id)
+    g2, idx2, sc2, cb2 = _synth_vq_projection(E, H, I, OUT_LATENT, dim, bits, 300 + rate_id)
+
+    p_idx1, p_sc1 = vq_ops.vq_pack(idx1, sc1, cb1, 0, H, dim, bits, 128)
+    p_idx3, p_sc3 = vq_ops.vq_pack(idx3, sc3, cb3, 0, H, dim, bits, 128)
+    p_idx2, p_sc2 = vq_ops.vq_pack(idx2, sc2, cb2, 1, H, dim, bits, 128)
+
+    w1_ref = vq_ops.vq_dequant_reference(p_idx1, p_sc1, cb1, I, H, dim, bits, 128)
+    w3_ref = vq_ops.vq_dequant_reference(p_idx3, p_sc3, cb3, I, H, dim, bits, 128)
+    w2_ref = vq_ops.vq_dequant_reference(p_idx2, p_sc2, cb2, H, I, dim, bits, 128)
+
+    # Bit-exact check against canonical Python codec.vq_unpack on expert 0
+    assert torch.equal(
+        w1_ref[0].cpu(), codec.vq_unpack(idx1[0].cpu(), sc1[0].cpu(), cb1.cpu(), g1)
+    )
+    assert torch.equal(
+        w2_ref[0].cpu(), codec.vq_unpack(idx2[0].cpu(), sc2[0].cpu(), cb2.cpu(), g2)
+    )
+
+    ex = torch.arange(E, dtype=torch.int64, device="cuda")
+    ptrs = torch.zeros((E, 9), dtype=torch.int64, device="cuda")
+    for slot, (pi, ps, cb) in enumerate(((p_idx1, p_sc1, cb1), (p_idx3, p_sc3, cb3), (p_idx2, p_sc2, cb2))):
+        ptrs[:, 3 * slot + 0] = pi.data_ptr() + ex * (pi[0].numel() * pi.element_size())
+        ptrs[:, 3 * slot + 1] = ps.data_ptr() + ex * (ps[0].numel() * ps.element_size())
+        ptrs[:, 3 * slot + 2] = cb.data_ptr()
+
+    meta_row = torch.tensor(
+        [H, I, dim, bits, H, I, dim, bits, I, H, dim, bits],
+        dtype=torch.int64,
+        device="cuda",
+    )
+    meta = meta_row.repeat(E, 1).contiguous()
+    emap = torch.arange(E, dtype=torch.int32, device="cuda")
+
+    topk = 6
+    ws_elems = vq_ops.moe_workspace_size_vq(96, H, I, topk, E)
+    ws = torch.empty((ws_elems,), dtype=torch.float32, device="cuda")
+
+    for M, is_prefill in ((1, False), (6, False), (16, False), (96, True)):
+        gen = torch.Generator(device="cuda").manual_seed(400 + M + rate_id)
+        x = (torch.randn((M, H), device="cuda", generator=gen) * 0.3).to(torch.bfloat16)
+        ids = (
+            torch.argsort(torch.rand((M, E), device="cuda", generator=gen), dim=-1)[
+                :, :topk
+            ]
+            .to(torch.int32)
+            .contiguous()
+        )
+        w = torch.softmax(
+            torch.randn((M, topk), device="cuda", generator=gen), dim=-1
+        ).contiguous()
+        out = torch.empty_like(x)
+        op = vq_ops.moe_out_prefill_vq if is_prefill else vq_ops.moe_out_vq
+        op(x, ids, w, ptrs, meta, emap, I, out, ws, 1.0, 2.0, 0.0, rate_id, rate_id)
+
+        ref = _dense_moe_ref_gpu(x, ids, w, w1_ref, w3_ref, w2_ref)
+        cos = torch.nn.functional.cosine_similarity(
+            out.float().flatten(), ref.float().flatten(), dim=0
+        ).item()
+        assert cos > 0.9999, f"rate=({dim},{bits}) M={M} cos={cos}"
+        assert (out.float() - ref.float()).abs().max().item() < 0.025
+
