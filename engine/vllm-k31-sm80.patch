+    monkeypatch.setattr(p2p, "WATCHDOG_POLL_S", 0.01)
+    monkeypatch.setattr(p2p, "_pid_ns_inode", lambda: 77777)
+
+    pid_map = {0: 51001, 1: 51002}
+    tls_rank = threading.local()
+    orig_getpid = os.getpid
+
+    def _fake_getpid():
