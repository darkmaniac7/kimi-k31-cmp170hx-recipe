+def _make_gpu_kda_weights(H: int, D: int, seed: int, *, with_bias: bool = False):
+    g = torch.Generator(device="cuda").manual_seed(seed)
+    C = 3 * H * D
+    cw = torch.randn((C, 4), device="cuda", generator=g, dtype=torch.float32) * 0.15
+    cb = (
+        torch.randn((C,), device="cuda", generator=g, dtype=torch.float32) * 0.05
+        if with_bias
+        else None
+    )
+    A_log = torch.randn((H,), device="cuda", generator=g, dtype=torch.float32) * 0.2
+    dt_bias = (
+        torch.randn((H * D,), device="cuda", generator=g, dtype=torch.float32) * 0.2
+    )
+    norm_w = (
+        0.8 + 0.4 * torch.rand((D,), device="cuda", generator=g, dtype=torch.float32)
+    )
+    return cw, cb, A_log, dt_bias, norm_w
+
+
+def _make_gpu_step_inputs(T: int, H: int, D: int, seed: int):
+    g = torch.Generator(device="cuda").manual_seed(seed)
+    C = 3 * H * D
+    mqkv = (
+        torch.randn((T, C), device="cuda", generator=g, dtype=torch.float32) * 0.25
+    ).to(torch.bfloat16)
+    rg = (
+        torch.randn((T, H, D), device="cuda", generator=g, dtype=torch.float32) * 0.3
+    ).to(torch.bfloat16)
+    rb = (
+        torch.randn((T, H), device="cuda", generator=g, dtype=torch.float32) * 0.3
+    ).to(torch.bfloat16)
+    g2 = (
+        torch.randn((T, H, D), device="cuda", generator=g, dtype=torch.float32) * 0.3
+    ).to(torch.bfloat16)
+    return mqkv, rg, rb, g2
+
