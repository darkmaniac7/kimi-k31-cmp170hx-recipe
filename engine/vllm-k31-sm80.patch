+def test_python_constants_follow_the_kernel_sources():
+    """The limits and tables this tree keeps in Python against the C++ that
+    defines them (csrc), not against another Python copy."""
+    from vllm.sm80.kernels.k31q import moe, vq_ops
+
+    def constant(source, name):
+        match = re.search(rf"constexpr int64_t {name} = (\d+);", source)
+        return int(match.group(1))
+
+    decode = (REPO / "csrc/exl3/moe_k31.cu").read_text()
+    prefill = (REPO / "csrc/exl3/moe_prefill_k31.cu").read_text()
+    shape = (constant(decode, "kH"), constant(decode, "kI"))
+    assert shape == moe.K31_KERNEL_SHAPE
+    shape = (constant(prefill, "kHidden"), constant(prefill, "kIntermediate"))
+    assert shape == moe.K31_KERNEL_SHAPE
+    assert constant(decode, "kMaxAssignments") == moe.K31_MAX_ASSIGNMENTS
+
+    kernel = (REPO / "csrc/k31_vq/moe_vq_k31.cu").read_text()
+    rates = {
+        (int(dim), int(bits)): int(rate)
+        for dim, bits, rate in re.findall(
+            r"if \(dim == (\d) && bits == (\d)\) return (\d);", kernel
+        )
+    }
+    assert len(rates) == 5 and rates == RATE_IDS
+    for dim in (1, 2, 4, 8):
+        for bits in range(1, 9):
+            assert vq_ops.vq_rate_id(dim, bits) == rates.get((dim, bits), -1)
+    # Words per lane of a packed tile: the kernel's comment lists them.
+    listed = re.search(r"// (d2_b3:\d.*d4_b6:\d)", kernel).group(1)
+    for entry in listed.split(", "):
+        rate, words = entry.split(":")
+        dim, bits = (int(part[1:]) for part in rate.split("_"))
+        assert words_per_lane(dim, bits) == int(words)
+    header = (REPO / "csrc/k31_vq/moe_vq_k31.h").read_text()
+    rows = re.search(r"Decode MoE kernel \(1\.\.(\d+) rows", header).group(1)
+    assert int(rows) == moe.VQ_DECODE_MAX_ROWS
+    rows = re.search(r"Prefill MoE kernel \(up to ([\d,]+) rows", header).group(1)
+    assert int(rows.replace(",", "")) == moe.VQ_PREFILL_MAX_ROWS
+    assert "group_size == 128" in kernel and moe.VQ_GROUP_SIZE == 128
+
