+def _run_composite_layer0(mini: Path) -> dict[str, Any]:
+    from vllm.model_executor.layers.mamba.ops.causal_conv1d import causal_conv1d_update
+    import importlib; ar_mod = importlib.import_module('vllm.models.kimi_k3.nvidia.ops.attn_res')
+    from vllm.models.kimi_k3.nvidia.ops.third_party.kda import (
+        fused_recurrent_kda_packed_decode,
+    )
+    from vllm.sm80.kernels.exl3.utils import Exl3LoadLedger
+    from vllm.sm80.kernels.k31q import glue
+    from vllm.sm80.kernels.k31q.manifest import PLAIN, K31QManifest
+    from vllm.sm80.kernels.k31q.quant import K31FusedLinearMethod
+    from vllm.third_party.flash_linear_attention.ops.kda import FusedRMSNormGated
+
+    device = torch.device("cuda:0")
+    manifest = K31QManifest(mini)
+    embed = gpu.tensors(mini / "ref_acts.safetensors", "embed", device=device)[0]
+    layer_path = mini / "layer-000.safetensors"
+    H, D = 96, 128
+    C = 3 * H * D
+
+    with ExitStack() as stack:
+        files = {layer_path: stack.enter_context(safe_open(str(layer_path), framework="pt", device="cpu"))}
+        ledger = Exl3LoadLedger(manifest)
+        pfx = f"{LAYER_PREFIX}0."
+        qkvg_l, _ = _load_exl3_launcher(
+            manifest, files, ledger,
+            [pfx + "self_attn." + n for n in ("q_proj", "k_proj", "v_proj", "g_proj")],
+            [12288] * 4, 7168,
+        )
+        o_l, _ = _load_exl3_launcher(manifest, files, ledger, [pfx + "self_attn.o_proj"], [7168], 12288)
+        mlp_gu_l, _ = _load_exl3_launcher(
+            manifest, files, ledger, [pfx + "mlp.gate_proj", pfx + "mlp.up_proj"], [33792, 33792], 7168
+        )
+        mlp_down_l, _ = _load_exl3_launcher(manifest, files, ledger, [pfx + "mlp.down_proj"], [7168], 33792)
+
+        in_ln = _load_layer_plain(mini, 0, "input_layernorm.weight", device).contiguous()
+        post_ln = _load_layer_plain(mini, 0, "post_attention_layernorm.weight", device).contiguous()
+        ar_attn_nw = _load_layer_plain(mini, 0, "self_attention_res_norm.weight", device).contiguous()
+        ar_attn_qk = _load_layer_plain(mini, 0, "self_attention_res_proj.weight", device).squeeze(0).contiguous()
+        ar_mlp_nw = _load_layer_plain(mini, 0, "mlp_res_norm.weight", device).contiguous()
+        ar_mlp_qk = _load_layer_plain(mini, 0, "mlp_res_proj.weight", device).squeeze(0).contiguous()
+
+        f_a_w = _load_layer_plain(mini, 0, "self_attn.f_a_proj.weight", device).contiguous()
+        b_w = _load_layer_plain(mini, 0, "self_attn.b_proj.weight", device).contiguous()
+        f_b_w = _load_layer_plain(mini, 0, "self_attn.f_b_proj.weight", device).contiguous()
+        conv_w = torch.cat(
+            [
+                _load_layer_plain(mini, 0, f"self_attn.{k}_conv1d.weight", device).view(-1, 4).to(torch.bfloat16)
+                for k in ("q", "k", "v")
+            ],
+            dim=0,
+        ).contiguous()
+        a_log = _load_layer_plain(mini, 0, "self_attn.A_log", device)[:H].contiguous()
+        dt_bias = _load_layer_plain(mini, 0, "self_attn.dt_bias", device).contiguous()
+        o_norm_w = _load_layer_plain(mini, 0, "self_attn.o_norm.weight", device).contiguous()
+        o_norm_mod = FusedRMSNormGated(D, activation="sigmoid", eps=1e-5, device=device, dtype=torch.float32)
+        o_norm_mod.weight.data.copy_(o_norm_w)
+
+        fab_method = K31FusedLinearMethod.__new__(K31FusedLinearMethod)
+        fab_method.out_dtype = torch.bfloat16
+        fab_method.padding = 0
+        fab_method.launcher = None
+        fab_method.row_chunks = []
+        fab_method.segments = [
+            (PLAIN, (0, 128, "f_a_proj.weight", slice(0, 128))),
+            (PLAIN, (128, 96, "b_proj.weight", slice(0, 96))),
+        ]
+        fab_layer = nn.Module()
+        fab_layer.exl3_weights = nn.ModuleList()
+        fab_layer.plain_weight = nn.Parameter(torch.cat([f_a_w, b_w], dim=0).contiguous(), requires_grad=False)
+
+        results = {}
+        for M in (1, 4, 8):
+            torch.manual_seed(1000 + M)
+            slots = 12
+            cs0 = torch.randn((slots, C, 3), dtype=torch.bfloat16, device=device) * 0.2
+            rs0 = torch.randn((slots, H, D, D), dtype=torch.float32, device=device) * 0.03
+            sidx = torch.arange(M, dtype=torch.int32, device=device) + 1
+            x_in = embed[:M].contiguous()
+            blocks0 = torch.zeros((M, 8, 7168), dtype=torch.bfloat16, device=device)
+
+            def make_step(mode: str, cs_buf: torch.Tensor, rs_buf: torch.Tensor):
+                out_kda = torch.empty((1, M, H, D), dtype=torch.bfloat16, device=device)
+                conv_tmp = torch.empty((M, C), dtype=torch.bfloat16, device=device)
+                pref_buf = x_in.clone()
+                blk_buf = blocks0.clone()
+
+                def step():
+                    pref_buf.copy_(x_in)
+                    h = ar_mod.attn_res(pref_buf, None, blk_buf, ar_attn_nw, ar_attn_qk, in_ln, 0, 0, 1e-5, 1e-5)
+                    qkvg = qkvg_l(h, torch.bfloat16)
+                    fab = fab_method.apply(fab_layer, h)
+                    mixed_qkv = qkvg[:, :C]
+                    g2 = qkvg[:, C:].view(M, H, D)
+                    f_a, raw_beta = fab[:, :128], fab[:, 128:]
+                    raw_g = F.linear(f_a, f_b_w).view(M, H, D)
+                    if mode == "glue":
+                        glue.fused_kda_decode(
+                            mixed_qkv, cs_buf, conv_w, None, raw_g, raw_beta, a_log, dt_bias,
+                            g2, o_norm_w, rs_buf, sidx, -5.0, 1e-5, out_kda[0],
+                        )
+                    else:
+                        if mode == "fp32conv":
+                            post_qkv = _fp32_conv1d_silu_update(mixed_qkv, cs_buf, conv_w, sidx)
+                        else:
+                            post_qkv = causal_conv1d_update(
+                                mixed_qkv, cs_buf, conv_w, None, activation="silu",
+                                conv_state_indices=sidx, validate_data=True, out=conv_tmp,
+                            )
+                        fused_recurrent_kda_packed_decode(
+                            mixed_qkv=post_qkv, raw_g=raw_g.unsqueeze(0), raw_beta=raw_beta.unsqueeze(0),
+                            A_log=a_log, dt_bias=dt_bias, lower_bound=-5.0,
+                            initial_state=rs_buf, state_indices=sidx, out=out_kda,
+                        )
+                        out_kda.copy_(o_norm_mod(out_kda, g2))
+                    attn_out = o_l(out_kda[0].reshape(M, H * D), torch.bfloat16)
+                    h_mlp = ar_mod.attn_res(attn_out, None, blk_buf, ar_mlp_nw, ar_mlp_qk, post_ln, 1, -1, 1e-5, 1e-5)
+                    gu = mlp_gu_l(h_mlp, torch.bfloat16)
+                    act = _situ_and_mul(gu)
+                    return mlp_down_l(act, torch.bfloat16)
+
+                return step
+
+            with _glue_switches():
+                out_off_fp32 = make_step("fp32conv", cs0.clone(), rs0.clone())()
+                out_off_tri = make_step("triton", cs0.clone(), rs0.clone())()
+            with _glue_switches(VLLM_K31_GLUE_ALL=1):
+                out_on = make_step("glue", cs0.clone(), rs0.clone())()
+
+            rel = _rel_l2(out_on, out_off_fp32)
+            rel_tri = _rel_l2(out_on, out_off_tri)
+            assert rel <= BOUND_COMPOSITE_REL_L2, f"L0 M={M}: composite rel_l2={rel}"
+
+            with _glue_switches():
+                us_off = _bench_graph_us(make_step("triton", cs0.clone(), rs0.clone()))
+            with _glue_switches(VLLM_K31_GLUE_ALL=1):
+                us_on = _bench_graph_us(make_step("glue", cs0.clone(), rs0.clone()))
+            results[str(M)] = {
+                "rel_l2": rel,
+                "rel_l2_vs_triton_bf16conv": rel_tri,
+                "graph_off_us": round(us_off, 1),
+                "graph_on_us": round(us_on, 1),
+                "delta_us": round(us_off - us_on, 1),
+            }
+
+    gc.collect()
+    torch.cuda.empty_cache()
+    return results
+
