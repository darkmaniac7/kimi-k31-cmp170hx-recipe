+def test_p2p_with_item10_sharded_routed_up_proj(
+    monkeypatch, meta_platform, checkpoint, manager
+):
+    """Item 10 + R6: VLLM_K31Q_SHARD_ROUTED_UP=1 with VLLM_K31_P2P_ALLREDUCE=1
+    uses two one-shot P2P all-reduces around the ColumnParallelLinear up_proj
+    for M <= max_rows and falls back cleanly to _shard_up_proj_tail above it."""
+    from vllm.models.kimi_k3.nvidia import latent_moe_runner
+    from vllm.sm80.kernels.k31q import p2p
+
+    monkeypatch.setenv("VLLM_K31_P2P_ALLREDUCE", "1")
+    monkeypatch.setenv("VLLM_K31Q_SHARD_ROUTED_UP", "1")
+    monkeypatch.setenv("VLLM_K31_P2P_MAX_ROWS", "16")
+
+    dense_ops = _install_dense_standin(monkeypatch)
+    p2p_ops = fake_p2p.FakeP2POps().install(monkeypatch)
+    _patch_cpu_rmsnorm(monkeypatch)
+
+    model0, _ = _build_tp_model(
+        monkeypatch, checkpoint, dense_ops, tp_size=2, tp_rank=0
+    )
+    model1, _ = _build_tp_model(
+        monkeypatch, checkpoint, dense_ops, tp_size=2, tp_rank=1
+    )
+
+    runner0 = model0.model.layers[1].block_sparse_moe.experts
+    runner1 = model1.model.layers[1].block_sparse_moe.experts
+    assert runner0._up_proj_is_sharded() is True
+    assert runner0._use_k31_p2p_path() is True
+
+    comm0, comm1, init_ok = _run_pair_init(p2p_ops, max_rows=16)
+    assert init_ok == [True, True]
+    tls = threading.local()
+    monkeypatch.setattr(p2p, "get_active_communicator", lambda: tls.comm)
+
+    rows = 8
+    hidden = fixture.TEXT["hidden_size"]
+    latent = fixture.TEXT["routed_expert_hidden_size"]
+    g = torch.Generator().manual_seed(107)
+    r0 = (torch.randn((rows, latent), generator=g) / 4).to(torch.bfloat16)
+    r1 = (torch.randn((rows, latent), generator=g) / 4).to(torch.bfloat16)
+    s0 = (torch.randn((rows, hidden), generator=g) / 4).to(torch.bfloat16)
+    s1 = (torch.randn((rows, hidden), generator=g) / 4).to(torch.bfloat16)
+
+    monkeypatch.setattr(runner0, "_forward_entry", lambda *a, **kw: (s0.clone(), r0.clone()))
+    monkeypatch.setattr(runner1, "_forward_entry", lambda *a, **kw: (s1.clone(), r1.clone()))
+
+    # Provide per-thread TP rank for ColumnParallelLinear shard offset.
+    monkeypatch.setattr(
+        latent_moe_runner,
+        "get_tensor_model_parallel_rank",
+        lambda: tls.rank,
+    )
+
+    def _run(comm, runner, rank):
+        tls.comm = comm
+        tls.rank = rank
+        return runner(
+            hidden_states=torch.zeros((rows, latent), dtype=torch.bfloat16),
+            router_logits=torch.zeros(
+                (rows, fixture.TEXT["num_experts"]), dtype=torch.float32
+            ),
+            shared_experts_input=torch.zeros((rows, hidden), dtype=torch.bfloat16),
+        )
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        f0 = pool.submit(_run, comm0, runner0, 0)
+        f1 = pool.submit(_run, comm1, runner1, 1)
+        o0, o1 = f0.result(timeout=10), f1.result(timeout=10)
+
+    # Reference: RMSNorm(r0 + r1) -> sharded up_proj on rank 0 & rank 1 -> add into s0/s1 -> sum.
+    norm_layer = model0.model.layers[1].block_sparse_moe.routed_expert_norm
+    ref_latent = norm_layer((r0.float() + r1.float()).to(torch.bfloat16))
+    up0, _ = model0.model.layers[1].block_sparse_moe.routed_expert_up_proj(ref_latent)
+    up1, _ = model1.model.layers[1].block_sparse_moe.routed_expert_up_proj(ref_latent)
+    ref_s0 = s0.clone()
+    ref_s1 = s1.clone()
+    half = hidden // 2
+    ref_s0[:, :half].add_(up0)
+    ref_s1[:, half:].add_(up1)
+    ref = (ref_s0.float() + ref_s1.float()).to(torch.bfloat16)
+
+    assert torch.equal(o0, o1)
+    assert torch.equal(o0, ref)
+    assert len(p2p_ops.moe_dual_calls) == 0
+    assert len(p2p_ops.allreduce_calls) == 4  # 2 ranks x (latent + shared)
+
+    # M > max_rows falls back cleanly to _shard_up_proj_tail via standard AR.
+    from vllm.model_executor.layers.fused_moe.runner import moe_runner
+    ar_calls = []
+    _rec_ar = lambda t: (ar_calls.append(tuple(t.shape)), t * 2)[1]
+    monkeypatch.setattr(
+        latent_moe_runner, "tensor_model_parallel_all_reduce", _rec_ar
+    )
+    monkeypatch.setattr(
+        moe_runner, "tensor_model_parallel_all_reduce", _rec_ar
+    )
+    tls.comm = comm0
+    tls.rank = 0
+    big_rows = 24
+    monkeypatch.setattr(
+        runner0,
+        "_forward_entry",
+        lambda *a, **kw: (
+            torch.ones((big_rows, hidden), dtype=torch.bfloat16),
+            torch.ones((big_rows, latent), dtype=torch.bfloat16),
+        ),
+    )
+    out_big = runner0(
+        hidden_states=torch.zeros((big_rows, latent), dtype=torch.bfloat16),
+        router_logits=torch.zeros(
+            (big_rows, fixture.TEXT["num_experts"]), dtype=torch.float32
+        ),
+        shared_experts_input=torch.zeros((big_rows, hidden), dtype=torch.bfloat16),
+    )
+    assert tuple(out_big.shape) == (big_rows, hidden)
+    assert len(ar_calls) == 2
+
+    comm0.close()
+    comm1.close()
