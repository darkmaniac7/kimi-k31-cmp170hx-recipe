+def rewrite_manifest(tree, man, *, stamp=False):
+    man["build_owned_sha256"] = build_owned_sha256(man["files"])
+    write(os.path.join(tree, MANIFEST), json.dumps(man))
+    if stamp:
+        write_stamp(tree, man)
