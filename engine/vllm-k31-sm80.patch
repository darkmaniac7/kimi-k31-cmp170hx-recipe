+def test_best_first_tree_is_optimal_for_its_size():
+    rng = random.Random(5)
+    for _ in range(30):
+        cache: dict[tuple[int, ...], list[float]] = {}
+
+        def expand(path):
+            if path not in cache:
+                a = rng.uniform(0.3, 0.95)
+                cache[path] = [a, rng.uniform(0.0, min(a, 1.0 - a))]
+            return cache[path]
+
+        budget = rng.randint(1, 5)
+        tree, probs = dt.best_first_tree(expand, budget, max_depth=3)
+
+        def prob(path):
+            p = 1.0
+            for d in range(len(path)):
+                p *= expand(path[:d])[path[d]]
+            return p
+
+        every = [
+            p
+            for d in range(1, 4)
+            for p in itertools.product(range(2), repeat=d)
+        ]
+        best = 0.0
+        for subset in itertools.combinations(every, budget):
+            have = set(subset)
+            if all(len(p) == 1 or p[:-1] in have for p in subset):
+                best = max(best, sum(prob(p) for p in subset))
+        assert sum(probs) == pytest.approx(best)
+        assert probs == pytest.approx(tuple(prob(p) for p in tree.paths))
+
