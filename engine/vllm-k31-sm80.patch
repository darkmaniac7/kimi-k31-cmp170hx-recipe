+@pytest.mark.parametrize("arch", ["gru", "ar1_markov", "ar1_cand_embed", "ar1_fulllm"])
+def test_zero_init_parity_and_parallel_vs_step_equivalence(arch: str) -> None:
+    g = torch.Generator().manual_seed(42)
+    bsz, k_steps, h_dim, rank_dim = 3, 11, 256, 64
+    e_seq = torch.randn(bsz, k_steps, rank_dim, generator=g, dtype=torch.float32)
+    draft_hidden = torch.randn(bsz, k_steps, h_dim, generator=g, dtype=torch.float32)
+
+    if arch == "gru":
+        head = DSparkGRUHead(
+            hidden_size=h_dim, markov_rank=rank_dim, gru_dim=128, trained_k=7
+        ).float()
+        m_zero = head.forward_sequence(e_seq, draft_hidden)
+        assert torch.equal(m_zero, e_seq)
+
+        _randomize_head(head, seed=99)
+        m_par = head.forward_sequence(e_seq, draft_hidden)
+        hz, hr, hn, hctx = head.precompute_hidden(draft_hidden)
+        state = None
+        m_steps = []
+        for t in range(k_steps):
+            m_t, state = head.step_precomputed(
+                e_seq[:, t], hz[:, t], hr[:, t], hn[:, t], hctx[:, t], state
+            )
+            m_steps.append(m_t)
+        assert torch.allclose(m_par, torch.stack(m_steps, dim=1), atol=1e-5)
+    else:
+        head = DSparkAR1Head(
+            mode=arch,
+            hidden_size=h_dim,
+            markov_rank=rank_dim,
+            d_model=128,
+            num_layers=2,
+            num_heads=4,
+            intermediate_size=256,
+            trained_k=7,
+        ).float()
+        m_zero, vec_zero = head.forward_parallel(e_seq, draft_hidden)
+        assert torch.equal(m_zero, e_seq)
+        if arch in ("ar1_cand_embed", "ar1_fulllm"):
+            assert vec_zero is not None and float(vec_zero.abs().max().item()) == 0.0
+        else:
+            assert vec_zero is None
+
+        _randomize_head(head, seed=105)
+        m_par, vec_par = head.forward_parallel(e_seq, draft_hidden)
+        hbase = head.precompute_hidden(draft_hidden)
+        kv_cache = head.init_kv_cache(bsz, k_steps, draft_hidden.device)
+        m_steps, vec_steps = [], []
+        for t in range(k_steps):
+            m_t, vec_t = head.step_precomputed(e_seq[:, t], hbase[:, t], kv_cache, t)
+            m_steps.append(m_t)
+            if vec_t is not None:
+                vec_steps.append(vec_t)
+        assert torch.allclose(m_par, torch.stack(m_steps, dim=1), atol=1e-5)
+        if vec_par is not None:
+            assert torch.allclose(vec_par, torch.stack(vec_steps, dim=1), atol=1e-5)
