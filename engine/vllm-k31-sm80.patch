+  const bool conv_w_fp32 = (conv_weight.scalar_type() == at::kFloat);
+
+  const void* cb_ptr = nullptr;
+  bool conv_b_fp32 = false;
+  if (conv_bias.has_value() && conv_bias->defined()) {
+    TORCH_CHECK(conv_bias->is_cuda() &&
+                    (conv_bias->scalar_type() == at::kBFloat16 ||
