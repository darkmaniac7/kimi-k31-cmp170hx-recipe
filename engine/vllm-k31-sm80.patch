+        exl3_ptrs=torch.zeros(LOCAL, 3, 3, dtype=torch.int64),
+        exl3_meta=torch.tensor(_meta(bits_x2)),
+        exl3_expert_map=torch.zeros(GLOBAL, dtype=torch.int32),
+        top_k=TOPK,
+        global_num_experts=GLOBAL,
