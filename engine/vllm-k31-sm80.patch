diff --git a/vllm/sm80/kernels/exl3/capture_points.py b/vllm/sm80/kernels/exl3/capture_points.py
new file mode 100644
index 0000000000..e8da971f95
--- /dev/null
+++ b/vllm/sm80/kernels/exl3/capture_points.py
@@ -0,0 +1,111 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The EXL3 capture points of the kernel call capture (vllm/sm80/capture.py,
+VLLM_SM80_CAPTURE_DIR; inert when it is unset).
+
+- ``dense`` (point ``exl3_linear``): every call of ops._linear on a
+  registered matrix: tensors ``x`` (the input as the operator received it)
+  and ``out`` (the output it returned; BF16, or FP32 where the method asks for
+  it). The prefix is the matrix's checkpoint prefix; meta carries the shard
+  (logical_in, logical_out, input_slice, output_slices, padded_in,
+  padded_out, bits_x2, codebook, out_dtype, row_chunk, weight_sha256 of the
+  rank's trellis, suh and svh bytes) and the operator that ran.
+- ``moe`` (points ``exl3_moe_out``, ``exl3_moe_out_v2``,
+  ``exl3_moe_out_prefill``, ``exl3_moe_out_prefill_v2``: the operator family
+  the dispatch chose; moe_out_v2_fold and moe_out_v2_try, which return
+  moe_out_v2's bits, record as ``exl3_moe_out_v2`` with the operator in
+  meta): every call of Exl3Experts.apply on a registered layer, with the
+  arguments of the FP64 case driver's capture point (x, topk_ids,
+  topk_weights, packed_meta, expert_map, intermediate_size, swiglu_limit, and
+  bits_x2 for moe_out_v2) and the output ``out``. The prefix is the layer's
+  module prefix.
+"""
+
+import torch
+
+from vllm.sm80 import capture
+
+# Operators that return another operator's output bits record under its
+# point, so a case driver replays them as that operator.
+_MOE_POINTS = {"moe_out_v2_fold": "moe_out_v2", "moe_out_v2_try": "moe_out_v2"}
+
+
+def register_linear(weight, row_chunk: int, out_dtype: torch.dtype) -> None:
+    """Key a loaded dense matrix by its trellis address."""
+    if not capture.active:
+        return
+    cfg = capture.config()
+    prefix = weight.matrix.prefix
+    if not (cfg.match.search(prefix) or cfg.prefill_match.search(prefix)):
+        return
+    capture.register_weight(
+        weight.trellis.data_ptr(),
+        prefix=prefix,
+        logical_in=weight.logical_in,
+        logical_out=weight.logical_out,
+        input_slice=[weight.input_slice.start, weight.input_slice.stop],
+        output_slices=[[s.start, s.stop] for s in weight.output_slices],
+        padded_in=weight.padded_in,
+        padded_out=weight.padded_out,
+        bits_x2=weight.matrix.bits_x2,
+        codebook=weight.matrix.codebook,
+        out_dtype=str(out_dtype).removeprefix("torch."),
+        row_chunk=row_chunk,
+        weight_sha256=capture.sha256_of(weight.trellis, weight.suh, weight.svh),
+    )
+
+
+def linear(x: torch.Tensor, trellis: torch.Tensor, out: torch.Tensor, operator) -> None:
+    facts = capture.weight(trellis.data_ptr())
+    if facts is None:
+        return
+    facts = dict(facts)
+    prefix = facts.pop("prefix")
+    name = getattr(operator, "__name__", type(operator).__name__)
+    rec = capture.begin("dense", "exl3_linear", prefix, x.shape[0], operator=name, **facts)
+    if rec is not None:
+        rec.put(x=x, out=out).done()
+
+
+def register_moe(pointers: torch.Tensor, prefix: str) -> None:
+    """Key a loaded MoE layer by its expert pointer table's address."""
+    if capture.active:
+        capture.config()
+        capture.register_weight(pointers.data_ptr(), prefix=prefix)
+
+
+def moe(
+    operator,
+    x: torch.Tensor,
+    topk_ids: torch.Tensor,
+    topk_weights: torch.Tensor,
+    pointers: torch.Tensor,
+    packed_meta: torch.Tensor,
+    expert_map: torch.Tensor,
+    intermediate_size: int,
+    swiglu_limit: float,
+    out: torch.Tensor,
+) -> None:
+    facts = capture.weight(pointers.data_ptr())
+    if facts is None:
+        return
+    func = getattr(operator, "func", operator)
+    keywords = dict(getattr(operator, "keywords", None) or {})
+    name = func.__name__
+    rec = capture.begin(
+        "moe", f"exl3_{_MOE_POINTS.get(name, name)}", facts["prefix"], x.shape[0],
+        operator=name,
+    )
+    if rec is None:
+        return
+    rec.put(
+        x=x,
+        topk_ids=topk_ids,
+        topk_weights=topk_weights,
+        packed_meta=packed_meta,
+        expert_map=expert_map,
+        intermediate_size=int(intermediate_size),
+        swiglu_limit=float(swiglu_limit),
+        **({"bits_x2": int(keywords["bits_x2"])} if "bits_x2" in keywords else {}),
+        out=out,
+    ).done()
diff --git a/vllm/sm80/kernels/exl3/dense_mma.py b/vllm/sm80/kernels/exl3/dense_mma.py
new file mode 100644
index 0000000000..1882baacbb
--- /dev/null
+++ b/vllm/sm80/kernels/exl3/dense_mma.py
@@ -0,0 +1,151 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Tensor-core dense EXL3 launches of 1..32 rows (VLLM_EXL3_DENSE_MMA).
+
+The kernels are part of the shipped library (csrc/exl3/dense_mma.cu) and run
+inside linear_out_splitk, which hands them every launch they cover: launches
+of 1..32 rows of the dense matrices of one tensor-parallel rank of
+Qwen3.8-Flash-Next at TP2 (the library's served shapes, the LM head
+included). resolve() is called once per process by ops.ensure_extension,
+before any launch or graph capture: with the switch on and its gate open
+(the split-K operator active, sm_80 with 74 multiprocessors, tensor
+parallel size 2 and pipeline parallel size 1, the configuration the plans
+were measured and validated in) it checks the library, applies the
+diagnostic plan override, prepares every kernel instantiation on the
+current device (shared-memory attributes and occupancy), sets the
+library's process switch and logs the banner.
+"""
+
+import torch
+
+from vllm import envs
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+# The multiprocessor count the plans were measured and validated at.
+VALIDATED_SMS = 74
+# The layout the matrices were validated in: (tensor, pipeline) parallel size.
+VALIDATED_PARALLEL = (2, 1)
+
+# Library functions resolve() needs; a library without them is refused.
+_OPERATORS = (
+    "set_dense_mma",
+    "set_dense_mma_shape_override",
+    "dense_mma_prepare",
+    "linear_mma_plan",
+)
+
+# The library's switch as resolve() set it.
+active = False
+
+
+def closed_reason(
+    splitk: bool, capability: tuple[int, int] | None, sms: int | None, vllm_config
+) -> str | None:
+    """Why the tensor-core blocks must not serve this process, or None.
+
+    `splitk` is the split-K operator's resolved gate (the blocks run inside
+    linear_out_splitk, so they serve nothing while it is off)."""
+    if not splitk:
+        return (
+            "the split-K operator is not active (VLLM_EXL3_DENSE_SPLITK off or its "
+            "gate closed; the tensor-core blocks run inside linear_out_splitk)"
+        )
+    if capability != (8, 0):
+        return f"device capability {capability}, not (8, 0)"
+    if sms != VALIDATED_SMS:
+        return f"{sms} multiprocessors, not {VALIDATED_SMS}"
+    if vllm_config is None:
+        return "no vLLM config is set, so the parallel layout is unknown"
+    parallel = vllm_config.parallel_config
+    layout = (parallel.tensor_parallel_size, parallel.pipeline_parallel_size)
+    if layout != VALIDATED_PARALLEL:
+        return f"(tensor, pipeline) parallel size {layout}, not {VALIDATED_PARALLEL}"
+    return None
+
+
+def parse_shape_override(value: str) -> tuple[int, int, int] | None:
+    """VLLM_EXL3_DENSE_MMA_SHAPE_OVERRIDE as (mt, kw, splits), or None."""
+    if not value:
+        return None
+    try:
+        mt, kw, splits = (int(part) for part in value.split(","))
+    except ValueError:
+        mt = kw = splits = 0
+    if mt not in (2, 4) or kw not in (1, 2, 4, 8) or splits not in (1, 2):
+        raise ValueError(
+            f"VLLM_EXL3_DENSE_MMA_SHAPE_OVERRIDE={value!r}: expected MT,KW,SPLITS "
+            "with MT 2 or 4, KW 1, 2, 4 or 8 and SPLITS 1 or 2"
+        )
+    return mt, kw, splits
+
+
+def _library():
+    """torch.ops._exl3_C, after checking that it has the functions above."""
+    for name in _OPERATORS:
+        try:
+            torch._C._dispatch_find_schema_or_throw(f"_exl3_C::{name}", "")
+        except RuntimeError as exc:
+            raise RuntimeError(
+                "VLLM_EXL3_DENSE_MMA needs a vllm._exl3_C built with "
+                f"csrc/exl3/dense_mma.cu: rebuild it ({exc})"
+            ) from exc
+    return torch.ops._exl3_C
+
+
+def resolve() -> None:
+    """VLLM_EXL3_DENSE_MMA for this process, with its log line."""
+    global active
+    if not envs.VLLM_EXL3_DENSE_MMA:
+        if envs.VLLM_EXL3_DENSE_MMA_SHAPE_OVERRIDE:
+            logger.info_once(
+                "VLLM_EXL3_DENSE_MMA_SHAPE_OVERRIDE is set but VLLM_EXL3_DENSE_MMA "
+                "is off; the override is ignored.",
+                scope="process",
+            )
+        return
+    override = parse_shape_override(envs.VLLM_EXL3_DENSE_MMA_SHAPE_OVERRIDE)
+    from vllm.config import get_current_vllm_config_or_none
+    from vllm.sm80.kernels.exl3 import ops
+
+    capability, sms = None, None
+    if torch.cuda.is_available():
+        capability = tuple(torch.cuda.get_device_capability())
+        sms = torch.cuda.get_device_properties(
+            torch.cuda.current_device()
+        ).multi_processor_count
+    reason = closed_reason(
+        ops._resolve_dense_splitk(),
+        capability,
+        sms,
+        get_current_vllm_config_or_none(),
+    )
+    if reason is not None:
+        logger.info_once(
+            "VLLM_EXL3_DENSE_MMA is set but the gate is closed: %s; every dense "
+            "EXL3 launch keeps its current path.",
+            reason,
+            scope="process",
+        )
+        return
+    library = _library()
+    if override is not None:
+        library.set_dense_mma_shape_override(*override)
+    library.dense_mma_prepare()
+    library.set_dense_mma(True)
+    active = True
+    logger.info_once(
+        "EXL3 dense MMA active (VLLM_EXL3_DENSE_MMA): dense launches of 1..32 "
+        "rows of the validated TP2 matrices (bits_x2 10/12/14, codebook 2; the "
+        "LM head included) run on tensor-core blocks inside linear_out_splitk; "
+        "other launches keep the split-K operator's path.",
+        scope="process",
+    )
+    if override is not None:
+        logger.info_once(
+            "EXL3 dense MMA plan forced by VLLM_EXL3_DENSE_MMA_SHAPE_OVERRIDE: "
+            "mt=%d kw=%d splits=%d on every tensor-core launch (diagnostic).",
+            *override,
+            scope="process",
+        )
diff --git a/vllm/sm80/kernels/exl3/dense_prefill_tc.py b/vllm/sm80/kernels/exl3/dense_prefill_tc.py
new file mode 100644
index 0000000000..3a83ecb2d3
--- /dev/null
+++ b/vllm/sm80/kernels/exl3/dense_prefill_tc.py
@@ -0,0 +1,354 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Tensor-core dense EXL3 linear for prefill steps (VLLM_EXL3_DENSE_PREFILL_TC).
+
+The operator ``linear_out_prefill`` (csrc/exl3/dense_prefill_tc.cu) computes
+what ``linear_out`` computes, on the tensor cores: exact integer-grid main
+products, FP32 sums in k order, and, for the last part-empty wave of tiles,
+a k split whose partial tiles the last arriving block adds in k order
+(arithmetic in csrc/exl3/dense_prefill_tc.h). Its results differ from
+``linear_out``'s in the last bits, and a row's bits depend on the row count
+of its launch and the row's position in it (which tiles the schedule
+splits).
+
+``ops._linear`` asks ``route`` for the operator of each call. A row chunk of
+the call takes ``linear_out_prefill`` only when all of these hold:
+- the flag is set and ``resolve`` found the gate open: sm_80 with 74
+  multiprocessors, a validated layout (tensor parallel size 2 or 4,
+  pipeline parallel size 1), and either no speculative decoding, an MTP /
+  EAGLE drafter without parallel drafting (the drafters ``step_phase``
+  covers), or a drafter whose decode steps carry at most MAX_SHIPPED_ROWS
+  rows in every forward pass (``step_phase.max_decode_step_rows``), so the
+  row floor below keeps every decode step on today's kernels;
+- the running step is a prefill step by the scheduler (``step_phase``: some
+  request has more than 1 + num_speculative_tokens tokens scheduled), never
+  judged from a row count, and the stream is not capturing a CUDA graph;
+- the matrix is one of VALIDATED_MATRICES (padded_in, padded_out, bits_x2;
+  codebook 2), the call has more than MAX_SHIPPED_ROWS rows, and the launch
+  has more than 64 rows, at least 16 output tiles of 128 x 128 and a 16-byte
+  aligned trellis;
+- with VLLM_EXL3_DENSE_SPLITK on, ``linear_out_splitk`` would not split the
+  launch's K: every launch split-K splits keeps split-K.
+Every other launch runs the operator ``_linear`` picked before (linear_out or
+linear_out_splitk), unchanged. Row chunks, the workspace and its size are
+``_linear``'s; the operator places its stream-K partial tiles and their
+counters inside ``linear_workspace_size`` of the launch and zeroes the
+counters on every call.
+"""
+
+import functools
+
+import torch
+
+from vllm import envs
+from vllm.logger import init_logger
+from vllm.sm80.kernels.exl3 import step_phase
+
+logger = init_logger(__name__)
+
+# Launches of at most this many rows keep today's kernels (the decode bound).
+MAX_SHIPPED_ROWS = 64
+# The multiprocessor count the schedule was validated at.
+VALIDATED_SMS = 74
+# The layouts the matrices were validated in: (tensor, pipeline) parallel size.
+VALIDATED_PARALLEL = ((2, 1), (4, 1))
+# (padded_in, padded_out, bits_x2) of the validated matrices, codebook 2: the
+# dense matrices of the tensor-parallel ranks of the validated models, each
+# validated at the row chunks of its layout.
+VALIDATED_MATRICES = frozenset(
+    {
+        # Qwen3.8-Flash-Next at TP2.
+        (2560, 256, 14),  # attention k/v
+        (2560, 640, 14),  # shared expert gate/up
+        (2560, 640, 10),  # sparse-attention indexer q/k
+        (2560, 1280, 12),  # drafter embedding / hidden-state projections
+        (640, 2560, 14),  # shared expert down
+        (3072, 2560, 14),  # output projections
+        (2560, 3072, 14),  # linear-attention z
+        (2560, 5120, 14),  # linear-attention qkv
+        (2560, 6144, 14),  # attention q (with output gate)
+        # DeepSeek-V4.1-Flash at TP4 (every rank), with its DSpark drafter.
+        (5120, 512, 10),  # kv, compressor kv/gate, shared expert gate/up
+        (5120, 512, 12),  # kv; drafter kv, shared expert gate/up
+        (5120, 640, 10),  # shared expert gate/up
+        (5120, 640, 12),  # drafter shared expert gate/up
+        (512, 5120, 10),  # shared expert down
+        (512, 5120, 12),  # drafter shared expert down
+        (640, 5120, 10),  # shared expert down
+        (640, 5120, 12),  # drafter shared expert down
+        (5120, 1280, 10),  # q down-projection
+        (5120, 1280, 12),  # q down-projection; drafter
+        (1280, 8192, 10),  # q up-projection
+        (1280, 8192, 12),  # drafter q up-projection
+        (1280, 4096, 10),  # indexer q
+        (4096, 1024, 10),  # output projection groups
+        (4096, 1024, 12),  # drafter output projection groups
+        (2048, 5120, 10),  # output projection
+        (2048, 5120, 12),  # drafter output projection
+        (6144, 6400, 10),  # Engram kv
+        (15360, 5120, 12),  # drafter hidden-state projection
+    }
+)
+VALIDATED_CODEBOOK = 2
+# Speculative methods whose decode steps step_phase reads as decode steps.
+COVERED_DRAFTERS = ("mtp", "eagle", "eagle3")
+# VLLM_EXL3_DENSE_PREFILL_TC_SCHEDULE -> set_prefill_schedule mode.
+SCHEDULES = {"planned": 0, "whole": 1}
+# The library operators this path needs (csrc/exl3/dense_prefill_tc.cu).
+OPERATORS = ("linear_out_prefill", "linear_prefill_applies", "set_prefill_schedule")
+# A warm-up launch per covered format: (rows, padded_in, padded_out). Its plan
+# runs both kernels (whole tiles and the k split) at 74 multiprocessors.
+WARMUP_LAUNCH = (482, 2560, 2560)
+
+# Fixed by resolve(), before any launch or graph capture.
+active = False
+_max_decode_query_len = 0
+_sms = 0
+_fake_registered = False
+
+
+def closed_reason(
+    capability: tuple[int, int] | None, sms: int | None, vllm_config
+) -> str | None:
+    """Why linear_out_prefill must not serve this process, or None."""
+    if capability != (8, 0):
+        return f"device capability {capability}, not (8, 0)"
+    if sms != VALIDATED_SMS:
+        return f"{sms} multiprocessors, not {VALIDATED_SMS}"
+    if vllm_config is None:
+        return "no vLLM config is set, so the decode query length is unknown"
+    parallel = vllm_config.parallel_config
+    layout = (parallel.tensor_parallel_size, parallel.pipeline_parallel_size)
+    if layout not in VALIDATED_PARALLEL:
+        return (
+            f"(tensor, pipeline) parallel size {layout}, not one of "
+            f"{', '.join(map(str, VALIDATED_PARALLEL))}"
+        )
+    speculative = vllm_config.speculative_config
+    parallel_drafting = bool(getattr(speculative, "parallel_drafting", False))
+    if (
+        speculative is not None
+        and (speculative.method not in COVERED_DRAFTERS or parallel_drafting)
+        and (rows := step_phase.max_decode_step_rows(vllm_config)) > MAX_SHIPPED_ROWS
+    ):
+        return (
+            f"speculative method {speculative.method!r} (parallel drafting "
+            f"{parallel_drafting}): its decode steps can schedule more than 1 + "
+            "num_speculative_tokens tokens per request, and a decode step's "
+            f"forward pass can carry {rows} rows, more than the "
+            f"{MAX_SHIPPED_ROWS} rows at or below which every call keeps "
+            "today's kernels"
+        )
+    return None
+
+
+def _warmup(sms: int) -> None:
+    """Run linear_out_prefill once per covered format and output dtype (BF16,
+    FP32) before any capture, so no request's first prefill loads the kernels
+    or sets their attributes.
+    The temporary buffers are freed again. ops.ensure_extension runs this
+    before it marks the library loaded, so the workspace size comes from the
+    library itself: ops.linear_workspace_size would call ensure_extension."""
+    device = torch.device("cuda", torch.cuda.current_device())
+    rows, padded_in, padded_out = WARMUP_LAUNCH
+
+    x = torch.ones((rows, padded_in), dtype=torch.bfloat16, device=device)
+    outs = [
+        torch.empty((rows, padded_out), dtype=dtype, device=device)
+        for dtype in (torch.bfloat16, torch.float32)
+    ]
+    workspace = torch.empty(
+        torch.ops._exl3_C.linear_workspace_size(rows, padded_in, padded_out),
+        dtype=torch.float32,
+        device=device,
+    )
+    suh = torch.ones(padded_in, dtype=torch.float16, device=device)
+    svh = torch.ones(padded_out, dtype=torch.float16, device=device)
+    for bits_x2 in sorted({b for _, _, b in VALIDATED_MATRICES}):
+        trellis = torch.zeros(
+            (padded_in // 16, padded_out // 16, 8 * bits_x2),
+            dtype=torch.int16,
+            device=device,
+        )
+        for out in outs:
+            linear_out_prefill(
+                x,
+                trellis,
+                suh,
+                svh,
+                bits_x2,
+                VALIDATED_CODEBOOK,
+                padded_in,
+                padded_out,
+                out,
+                workspace,
+            )
+    torch.cuda.synchronize(device)
+
+
+def resolve() -> None:
+    """VLLM_EXL3_DENSE_PREFILL_TC for this process, with its log line.
+
+    Called once by ops.ensure_extension, after the library loaded and before
+    ensure_extension returns: nothing here may call an ops function that calls
+    ensure_extension."""
+    global active, _max_decode_query_len, _sms, _fake_registered
+    if not envs.VLLM_EXL3_DENSE_PREFILL_TC:
+        return
+    from vllm.config import get_current_vllm_config_or_none
+
+    capability, sms = None, None
+    if torch.cuda.is_available():
+        capability = tuple(torch.cuda.get_device_capability())
+        sms = torch.cuda.get_device_properties(
+            torch.cuda.current_device()
+        ).multi_processor_count
+    vllm_config = get_current_vllm_config_or_none()
+    reason = closed_reason(capability, sms, vllm_config)
+    if reason is not None:
+        logger.info_once(
+            "VLLM_EXL3_DENSE_PREFILL_TC is set but the gate is closed: %s; every "
+            "dense EXL3 launch keeps today's kernels.",
+            reason,
+            scope="process",
+        )
+        return
+    schedule = envs.VLLM_EXL3_DENSE_PREFILL_TC_SCHEDULE
+    for name in OPERATORS:
+        try:
+            torch._C._dispatch_find_schema_or_throw(f"_exl3_C::{name}", "")
+        except RuntimeError as exc:
+            raise RuntimeError(
+                f"VLLM_EXL3_DENSE_PREFILL_TC needs _exl3_C::{name}: rebuild the "
+                "EXL3 extension from this tree (python "
+                "csrc/exl3/build_standalone.py --out vllm), or unset the flag. "
+                f"Detail: {exc}"
+            ) from exc
+    if not _fake_registered:
+        from vllm.sm80.kernels.exl3.ops import _linear_fake
+
+        torch.library.register_fake("_exl3_C::linear_out_prefill")(_linear_fake)
+        _fake_registered = True
+    set_prefill_schedule(SCHEDULES[schedule])
+    _warmup(sms)
+    _max_decode_query_len = step_phase.max_decode_query_len(vllm_config)
+    _sms = sms
+    logger.info_once(
+        "EXL3 dense prefill tensor-core path active (VLLM_EXL3_DENSE_PREFILL_TC): "
+        "in prefill steps (a request with more than %d tokens scheduled), dense "
+        "launches of more than %d rows and at least 16 output tiles of the %d "
+        "validated matrices (bits_x2 10/12/14, codebook 2) take "
+        "linear_out_prefill, schedule %s; split-K launches, other matrices, "
+        "decode steps and graph captures keep today's kernels.",
+        _max_decode_query_len,
+        MAX_SHIPPED_ROWS,
+        len(VALIDATED_MATRICES),
+        schedule,
+        scope="process",
+    )
+    active = True
+
+
+def linear_prefill_applies(
+    rows: int, padded_in: int, padded_out: int, bits_x2: int, codebook: int
+) -> bool:
+    """Whether linear_out_prefill covers this launch shape (host arithmetic)."""
+    return torch.ops._exl3_C.linear_prefill_applies(
+        rows, padded_in, padded_out, bits_x2, codebook
+    )
+
+
+def set_prefill_schedule(mode: int) -> None:
+    """The operator's schedule for this process: 0 planned, 1 whole tiles."""
+    torch.ops._exl3_C.set_prefill_schedule(mode)
+
+
+@functools.cache
+def takes_launch(
+    rows: int,
+    padded_in: int,
+    padded_out: int,
+    bits_x2: int,
+    codebook: int,
+    splitk: bool,
+    sms: int,
+) -> bool:
+    """Whether a prefill-step launch of this shape goes to linear_out_prefill:
+    a validated matrix the operator covers at this row count and, with
+    split-K on, split-K does not split it."""
+    from vllm.sm80.kernels.exl3.ops import linear_splitk_splits
+
+    if (
+        codebook != VALIDATED_CODEBOOK
+        or (padded_in, padded_out, bits_x2) not in VALIDATED_MATRICES
+    ):
+        return False
+    if splitk and linear_splitk_splits(rows, padded_out, sms, bits_x2, codebook) == 2:
+        return False
+    return linear_prefill_applies(rows, padded_in, padded_out, bits_x2, codebook)
+
+
+def linear_out_prefill(
+    x,
+    trellis,
+    suh,
+    svh,
+    bits_x2: int,
+    codebook: int,
+    logical_in: int,
+    logical_out: int,
+    out,
+    workspace,
+) -> None:
+    """linear_out's contract for the launches linear_prefill_applies covers."""
+    torch.ops._exl3_C.linear_out_prefill(
+        x,
+        trellis,
+        suh,
+        svh,
+        bits_x2,
+        codebook,
+        logical_in,
+        logical_out,
+        out,
+        workspace,
+    )
+
+
+def _launch(
+    default,
+    splitk: bool,
+    x,
+    trellis,
+    suh,
+    svh,
+    bits_x2: int,
+    codebook: int,
+    logical_in: int,
+    logical_out: int,
+    out,
+    workspace,
+) -> None:
+    padded_in, padded_out = trellis.shape[0] * 16, trellis.shape[1] * 16
+    operator = default
+    if trellis.data_ptr() % 16 == 0 and takes_launch(
+        x.shape[0], padded_in, padded_out, bits_x2, codebook, splitk, _sms
+    ):
+        operator = linear_out_prefill
+    operator(
+        x, trellis, suh, svh, bits_x2, codebook, logical_in, logical_out, out, workspace
+    )
+
+
+def route(default, rows: int, splitk: bool):
+    """The operator _linear calls for each row chunk of a call of `rows` rows:
+    `default` itself outside prefill steps, during graph capture and for calls
+    of at most MAX_SHIPPED_ROWS rows; otherwise a per-launch choice between
+    linear_out_prefill and `default`."""
+    if (
+        rows <= MAX_SHIPPED_ROWS
+        or torch.cuda.is_current_stream_capturing()
+        or not step_phase.prefill_step(_max_decode_query_len)
+    ):
+        return default
+    return functools.partial(_launch, default, splitk)
