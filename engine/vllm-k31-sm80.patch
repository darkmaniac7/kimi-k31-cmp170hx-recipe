+def _frames(name):
+    return [
+        {"filename": "/x/torch/cuda/memory.py", "line": 1, "name": "alloc"},
+        {"filename": "/t/vllm/models/m.py", "line": 7, "name": name},
+        {"filename": "/t/vllm/v1/worker/gpu/model_runner.py", "line": 9, "name": "run"},
+    ]
