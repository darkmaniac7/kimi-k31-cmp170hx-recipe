+        rec_rec, ssi_seed, qsl_seed, acc_seed, -5.0, 1e-6, out_s_rec, sm,
+    )
+    assert torch.equal(out_s_rec, out_s_leg)
+    assert [int(sm[int(ssi[b, 0])]) for b in range(B)] == [0, 1, 0, 1]
+
+    # Now launch full B=4 (1,536 recurrence CTAs) over 4 steps with variable q_lens & acc!
+    step_specs = [
+        ([5, 7, 4, 6], [3, 4, 1, 5]),  # mixed mode 0 (with acc=3 copy!) + mode 1 fold
+        ([6, 5, 8, 4], [4, 5, 3, 2]),
+        ([4, 8, 6, 7], [6, 2, 7, 4]),
+        ([7, 6, 5, 8], [2, 8, 4, 6]),
