+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU tests of the indexer cache layout arithmetic of the sm_80 Kimi K3.1
+path (vllm/models/kimi_k3/nvidia/sm80_dsa.py): K3.1 binds the key cache as a
+strided page view of a packed block row, which the fork's paged logits
+wrapper refuses (it asserts a contiguous cache) while its kernel only needs
+the page stride. No Triton code runs here: the byte offsets, the refusals,
+the torch references on both layouts and the logits wrapper in its reference
+mode.
+"""
+
+import pytest
+import torch
+
+from tests.models.kimi_k3.sm80 import sm80_dsa_cases as cases
+from vllm.models.kimi_k3.nvidia import sm80_dsa
+from vllm.sm80.kernels.attention import triton_mqa_logits as mqa
+
+D, BLOCK, ENTRY = cases.HEAD_DIM, cases.BLOCK, cases.ENTRY
+
+
+def test_k31_packed_rows():
+    """The two packed block rows a K3.1 DSA layer can have, per kernel page:
+    64 x (MLA bytes + 132), rounded up to whole MLA rows."""
+    assert cases.packed_row_stride(cases.MLA_BYTES_BF16) == 82944 == 72 * 1152
+    assert cases.packed_row_stride(cases.MLA_BYTES_FP8_DS) == 50512 == 77 * 656
+    for mla_bytes in (cases.MLA_BYTES_BF16, cases.MLA_BYTES_FP8_DS):
+        _, view = cases.make_index_cache(True, 3, mla_bytes=mla_bytes)
+        geometry = sm80_dsa.index_cache_geometry(view, D)
+        assert geometry.packed and geometry.block_size == BLOCK
+        assert geometry.page_stride == cases.packed_row_stride(mla_bytes)
+        assert geometry.page_bytes == BLOCK * ENTRY == 8448
+        assert geometry.span_bytes == 2 * geometry.page_stride + 8448
+        # What the fork kernels assume of a page: a power of two of at least
+        # 16 keys, D + 4 bytes each; and what the scale reads need.
+        assert BLOCK >= 16 and BLOCK & (BLOCK - 1) == 0
+        assert geometry.page_stride % 4 == 0 and view.storage_offset() % 4 == 0
+        # The fork's own wrapper cannot take this cache.
+        assert not view.is_contiguous()
+
+
+def test_contiguous_cache_geometry():
+    _, view = cases.make_index_cache(False, 5)
+    geometry = sm80_dsa.index_cache_geometry(view, D)
+    assert not geometry.packed
+    assert (geometry.num_pages, geometry.page_stride) == (5, BLOCK * ENTRY)
+    assert geometry.span_bytes == view.numel()
+
+
+@pytest.mark.parametrize("packed", [False, True])
+def test_slot_offsets_address_the_view(packed):
+    """value_byte / scale_byte against plain indexing of the bound view."""
+    raw, view = cases.make_index_cache(packed, 4)
+    geometry = sm80_dsa.index_cache_geometry(view, D)
+    flat = sm80_dsa._flat_cache_bytes(view, geometry)
+    assert flat.data_ptr() == view.data_ptr()
+    for mark, slot in enumerate([0, 1, 63, 64, 130, 4 * BLOCK - 1], start=1):
+        flat[geometry.value_byte(slot)] = mark
+        flat[geometry.value_byte(slot) + D - 1] = mark + 50
+        flat[geometry.scale_byte(slot) + 3] = mark + 100
+        page, off = divmod(slot, BLOCK)
+        page_flat = view[page].reshape(-1)
+        assert page_flat[off * D] == mark
+        assert page_flat[off * D + D - 1] == mark + 50
+        assert page_flat[BLOCK * D + off * 4 + 3] == mark + 100
+    # Nothing outside the pages of this layer was touched.
+    if packed:
+        assert torch.count_nonzero(raw[:, : BLOCK * cases.MLA_BYTES_BF16]) == 0
+        assert torch.count_nonzero(raw[:, BLOCK * cases.MLA_BYTES_BF16 + 8448 :]) == 0
+
+
+def _refused(view: torch.Tensor, head_dim: int = D) -> str:
+    with pytest.raises(
+        ValueError, match="Kimi K3.1 DSA indexer on the sm_80 path"
+    ) as e:
+        sm80_dsa.index_cache_geometry(view, head_dim)
+    return str(e.value)
+
+
+def test_unsupported_layouts_are_refused_by_name():
+    raw = torch.zeros(4, 2 * 8448 + 64, dtype=torch.uint8)
+
+    def view(shape, stride, offset=0):
+        return torch.as_strided(raw, shape, stride, offset)
+
+    assert "3-D uint8" in _refused(torch.zeros(4, BLOCK, ENTRY, dtype=torch.int8))
+    assert "3-D uint8" in _refused(torch.zeros(4, BLOCK, 1, ENTRY, dtype=torch.uint8))
+    # The MXFP4 cache: 68 bytes per key.
+    assert "MXFP4" in _refused(torch.zeros(4, BLOCK, 68, dtype=torch.uint8))
+    assert "power of two" in _refused(torch.zeros(4, 48, ENTRY, dtype=torch.uint8))
+    assert "at least 16" in _refused(torch.zeros(4, 8, ENTRY, dtype=torch.uint8))
+    # A layout that interleaves other bytes inside a page (not block-outermost).
+    assert "block-outermost" in _refused(view((4, BLOCK, ENTRY), (16962, 2 * ENTRY, 1)))
+    assert "multiples of 4" in _refused(view((4, BLOCK, ENTRY), (8450, ENTRY, 1)))
+    assert "multiples of 4" in _refused(view((4, BLOCK, ENTRY), (8452, ENTRY, 1), 2))
+    assert "overlap" in _refused(view((4, BLOCK, ENTRY), (8444, ENTRY, 1)))
+    # The message carries the facts needed to act on it.
+    assert "(8450, 132, 1)" in _refused(view((4, BLOCK, ENTRY), (8450, ENTRY, 1)))
+
+
+@pytest.mark.parametrize("packed", [False, True])
+def test_reference_write_and_read(packed):
+    torch.manual_seed(1)
+    raw, view = cases.make_index_cache(packed, 3, fill=0x5A)
+    slots = torch.tensor([7, -1, 191, 64, 0], dtype=torch.int64)
+    bits = torch.randint(0, 255, (6, D), dtype=torch.uint8)
+    scale = torch.exp2(torch.arange(6, dtype=torch.float32) - 9)
+    # One row more than slots: rows past the slot mapping are not written.
+    sm80_dsa.index_cache_write_reference(view, slots, bits, scale)
+    got_bits, got_scale = cases.keys_by_page_view(view)
+    for row, slot in enumerate(slots.tolist()):
+        if slot >= 0:
+            assert torch.equal(got_bits[slot], bits[row])
+            assert got_scale[slot] == scale[row]
+    untouched = torch.ones(3 * BLOCK, dtype=torch.bool)
+    untouched[slots[slots >= 0]] = False
+    assert (got_bits[untouched] == 0x5A).all()
+    read_bits, read_scale = sm80_dsa.index_cache_read_reference(
+        view, slots[slots >= 0], D
+    )
+    assert torch.equal(read_bits, bits[:5][slots >= 0])
+    assert torch.equal(read_scale, scale[:5][slots >= 0])
+    assert int((raw != 0x5A).sum()) <= 4 * ENTRY
+
+
+@pytest.mark.parametrize("next_n", [1, 2])
+@pytest.mark.parametrize("packed", [False, True])
+def test_paged_logits_reference_on_both_layouts(packed, next_n, monkeypatch):
+    """The torch reference of the fork (used under VLLM_INDEXER_DSA_REF=1
+    and by the card tests) reads a packed cache correctly, and the sm_80
+    wrapper hands it the right arguments."""
+    problem = cases.exact_decode_problem(packed, next_n)
+    want = cases.brute_force_logits(problem)
+    q_bits, view, weights = problem.q_bits, problem.view, problem.weights
+    context_lens, block_table = problem.context_lens, problem.block_table
+    max_model_len = 4 * BLOCK
+    direct = mqa.fp8_paged_mqa_logits_torch(
+        q_bits.view(torch.float8_e4m3fn),
+        view,
+        weights,
+        context_lens,
+        block_table,
+        max_model_len,
+    )
+    monkeypatch.setenv("VLLM_INDEXER_DSA_REF", "1")
+    through_wrapper = sm80_dsa.sm80_paged_mqa_logits(
+        q_bits, view, weights, context_lens, block_table, max_model_len
+    )
+    for got in (direct, through_wrapper):
+        assert got.shape == (context_lens.numel(), max_model_len)
+        for row, expected in enumerate(want):
+            assert torch.equal(got[row, : expected.numel()], expected), row
+            assert (got[row, expected.numel() :] == float("-inf")).all()
+
+
+def test_logits_shape_checks():
+    with pytest.raises(ValueError, match="index_head_dim"):
+        sm80_dsa._check_logits_shape(32, 96)
+    for heads in (4, 20):
+        with pytest.raises(ValueError, match="power of two of at least 8"):
+            sm80_dsa._check_logits_shape(heads, D)
+    sm80_dsa._check_logits_shape(32, D)
