+
+    def call():
+        exl3_ops.moe_out_v2_fold(
+            x, ids, weights, synthetic.pointers, synthetic.meta, synthetic.expert_map,
+            h5120.INTERMEDIATE, out, workspace, swiglu_limit=h5120.SWIGLU_LIMIT,
+            bits_x2=synthetic.bits_x2,
