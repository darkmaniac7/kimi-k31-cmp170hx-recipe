+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The real mini checkpoint through the real model class, on the CPU.
+
+The mini checkpoint holds decoder layers 0, 1, 3, 46 and 92 with the
+embedding, the head and the codebooks, at the real sizes (896 experts, latent
+3584, intermediate 3072). A pipeline partition that makes one of those layers
+(or layers 0 and 1) a stage of its own lets the engine's model be built for
+exactly what the checkpoint holds: the class its config.json names, the K3.1
+wrapper, one pipeline stage and one tensor-parallel rank of two. The k31q
+loader then accounts for every tensor of the directory and leaves no
+parameter unloaded, and the bytes it read for the routed experts are the
+bytes of the header-level plan.
+
+The checkpoint has no vision file, so the stages are launched text-only
+(``--language-model-only``); with images allowed the first stage is refused.
+
+Layer 1 also goes through the native VQ load path with the recording stand-in
+for the ops (fake_vq.py): the real record sizes, what is on the "device" while
+each projection is packed, and the tables at the real shapes.
+
+Needs K31Q_MINI_CHECKPOINT (default
+/tmp/k31q-mini-checkpoint) with a file DONE beside the
+manifest; skipped without it. About 8 GB of host memory, under a minute.
+"""
+
+import os
+from collections import Counter
+from pathlib import Path
+
+import pytest
+
+from tests.models.kimi_k3.sm80 import construct
+from tests.models.kimi_k3.sm80.fake_vq import FakeVqOps
+from vllm.sm80.kernels.k31q.manifest import K31QManifest
+from vllm.sm80.kernels.k31q.plan import plan_layer
+
+MINI = Path(
+    os.environ.get(
+        "K31Q_MINI_CHECKPOINT", "/tmp/k31q-mini-checkpoint"
+    )
+)
+pytestmark = pytest.mark.skipif(
+    not (MINI / "DONE").is_file(), reason=f"no finished mini checkpoint at {MINI}"
+)
+LAYERS = 93
+EXPERTS, LATENT, INTERMEDIATE = 896, 3584, 3072
+# (pipeline partition, stage) whose stage is made of mini checkpoint layers.
+STAGES = {
+    "layers 0-1 with the embedding": ((2, 91), 0),
+    "layer 3 (MLA with the indexer)": ((3, 1, 89), 1),
+    "layer 46": ((46, 1, 46), 1),
+    "layer 92 with the head": ((92, 1), 1),
+}
+TP, RANK = 2, 0
+
+
+def _stage(monkeypatch, partition, stage, text_only=True, load=True, native=None):
+    construct.set_groups(
+        monkeypatch, TP, RANK, len(partition), stage, partition, native
+    )
+    config = construct.vllm_config(
+        MINI, TP, len(partition), multimodal=construct.multimodal_config(text_only)
+    )
+    names = set(config.quant_config.manifest.tensors)
+    model = construct.build_wrapper(monkeypatch, config)
+    report = construct.load(monkeypatch, model, config) if load else None
+    return model, config, report, names
+
+
+def _routed(model, layer):
+    text = model.language_model.model
+    return text.layers[layer].block_sparse_moe.experts.routed_experts
+
+
+@pytest.mark.parametrize("case", list(STAGES))
+def test_real_stage_builds_and_loads(monkeypatch, meta_platform, case):
+    from vllm.model_executor.models.utils import PPMissingLayer, StageMissingLayer
+    from vllm.models.kimi_k3.nvidia.model import KimiK3ForConditionalGeneration
+
+    partition, stage = STAGES[case]
+    first = sum(partition[:stage])
+    layers = range(first, first + partition[stage])
+    model, config, report, names = _stage(monkeypatch, partition, stage)
+    hf_config = config.model_config.hf_config
+    assert hf_config.architectures == ["KimiK31ForConditionalGeneration"]
+    assert type(model) is KimiK3ForConditionalGeneration
+    assert isinstance(model.vision_tower, StageMissingLayer)
+    assert isinstance(model.mm_projector, StageMissingLayer)
+    text = model.language_model.model
+    assert len(text.layers) == LAYERS
+    built = [n for n, m in enumerate(text.layers) if not isinstance(m, PPMissingLayer)]
+    assert built == list(layers)
+    assert report.layers == (layers.start, layers.stop)
+    assert (report.tp_rank, report.tp_size) == (RANK, TP)
+
+    # Every tensor of the directory, each with one disposition and a reason.
+    assert set(report.ledger) == names
+    manifest = K31QManifest(MINI)
+    reasons = Counter(why for use, why in report.ledger.values() if use == "unused")
+    assert set(reasons) <= {
+        "layer of another pipeline stage",
+        "module is not built on this pipeline stage",
+        "no VQ layer of this stage uses this codebook",
+    }
+    for name, (use, _) in report.ledger.items():
+        layer = manifest.tensor_layer(name)
+        if layer is not None:
+            assert (use == "consumed") == (layer in layers), name
+        elif "embed_tokens" in name:
+            assert (use == "consumed") == (stage == 0), name
+        elif not name.startswith("vq."):  # the head file
+            assert (use == "consumed") == (layers.stop == LAYERS), name
+    books = {
+        f"vq.{manifest.expert_projections[layer, w].codebook}"
+        for layer in layers
+        if (layer, "w1") in manifest.expert_projections
+        for w in ("w1", "w3", "w2")
+    }
+    assert {n for n in names if report.ledger[n][0] == "consumed"} >= books
+    assert reasons["no VQ layer of this stage uses this codebook"] == 5 - len(books)
+
+    # The routed experts at the real sizes, and the plan's bytes for this rank.
+    text_config = config.model_config.hf_config.text_config
+    expert_bytes = 0
+    for layer in layers:
+        planned = plan_layer(manifest, layer, text_config, TP, RANK)
+        if planned.expert_method is None:
+            assert layer == 0
+            continue
+        experts = _routed(model, layer).k31_experts
+        assert (experts.experts, experts.latent) == (EXPERTS, LATENT)
+        assert (experts.intermediate, experts.local_intermediate) == (
+            INTERMEDIATE,
+            INTERMEDIATE // TP,
+        )
+        # Rank r of layer L holds chunk (r + L) mod 2 of the 24 I-blocks.
+        chunk = (RANK + layer) % TP
+        assert experts.blocks == slice(12 * chunk, 12 * chunk + 12)
+        assert experts.bytes_read == planned.expert_bytes
+        expert_bytes += planned.expert_bytes
+        # One expert decodes; all 896 of a projection (19.7 GiB) are refused.
+        with pytest.raises(ValueError, match="GiB in FP32; pass an expert"):
+            experts.dequant("w1")
+    assert report.expert_bytes == expert_bytes
