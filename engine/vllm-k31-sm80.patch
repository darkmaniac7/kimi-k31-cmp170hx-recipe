+            for i in range(spec_state_indices.size(0)):
+                slot = int(spec_state_indices[i, 0])
+                if slot > 0:
+                    state_mode[slot] = 0
+
+        @staticmethod
+        def fused_kda_spec_verify(*args, **kwargs):
+            events.append("spec_v2")
+
+        @staticmethod
+        def moe_prune_topk(*args, **kwargs):
