+def _make_kda_stub(H: int = 4, D: int = 128, dim_first: bool = True):
+    from vllm.models.kimi_k3.nvidia.kda import KimiK3DeltaAttention
+
+    C = 3 * H * D
+    attn = KimiK3DeltaAttention.__new__(KimiK3DeltaAttention)
+    nn.Module.__init__(attn)
+    attn.prefix = "layers.0.self_attn"
+    attn.head_dim = D
+    attn.local_num_heads = H
+    attn.local_projection_size = H * D
+    attn.conv_size = 4
+    attn.gate_lower_bound = -5.0
+    attn.kda_decode_backend = "triton"
+    attn.kda_spec_decode_backend = "native"
+    attn.kda_prefill_backend = "triton"
+    attn.use_recoverssm = False
+    attn.decode_conv1d_weight = None
+    attn.decode_norm_weight = None
+    attn.conv1d = SimpleNamespace(
+        weight=torch.randn((C, 1, 4), dtype=torch.bfloat16) * 0.2,
+        bias=torch.randn((C,), dtype=torch.bfloat16) * 0.05,
+    )
+    attn.A_log = torch.randn((H,), dtype=torch.float32) * 0.3 - 1.0
+    attn.dt_bias = torch.randn((H * D,), dtype=torch.float32) * 0.2
+    attn.o_norm = SimpleNamespace(
+        activation="sigmoid",
+        eps=1e-5,
+        weight=torch.randn((D,), dtype=torch.float32) * 0.1 + 1.0,
+    )
+    slots = 24
+    cs_shape = (slots, C, 3) if dim_first else (slots, 3, C)
+    attn.kv_cache = [
+        torch.randn(cs_shape, dtype=torch.bfloat16) * 0.2,
+        torch.randn((slots, H, D, D), dtype=torch.float32) * 0.05,
+    ]
+    return attn
+
+
+@pytest.mark.parametrize("dim_first", [True, False])
+@pytest.mark.parametrize("B", [1, 8, 16])
+def test_kda_decode_wiring_and_exact_ref(monkeypatch, dim_first, B):
+    from vllm.models.kimi_k3.nvidia import kda as kda_mod
+    from vllm.models.kimi_k3.nvidia.kda_metadata import KimiK3KDAMetadata
+
+    _clear_glue_env(monkeypatch)
+    fake = FakeGlueOps().install(monkeypatch)
+    monkeypatch.setenv("VLLM_K31_GLUE_KDA", "1")
+    monkeypatch.setattr(kda_mod, "is_conv_state_dim_first", lambda: dim_first)
+
+    torch.manual_seed(50 + B + int(dim_first))
+    H, D = 4, 128
+    attn = _make_kda_stub(H=H, D=D, dim_first=dim_first)
+
+    sidx = torch.arange(B, dtype=torch.int32) + 1
+    if B >= 4:
+        sidx[-1] = -1
+    meta = KimiK3KDAMetadata(
+        num_prefills=0,
+        num_prefill_tokens=0,
+        num_decodes=B,
+        num_decode_tokens=B,
+        num_actual_tokens=B,
+        num_spec_decodes=0,
+        num_spec_decode_tokens=0,
+        non_spec_state_indices_tensor=sidx,
+    )
+    monkeypatch.setattr(
+        kda_mod,
+        "get_forward_context",
+        lambda: SimpleNamespace(attn_metadata={attn.prefix: meta}),
+    )
+
+    mixed = torch.randn((B, 3 * H * D), dtype=torch.bfloat16) * 0.4
+    g1 = torch.randn((1, B, H, D), dtype=torch.bfloat16) * 0.4
+    g2 = torch.randn((B, H, D), dtype=torch.bfloat16) * 0.4
+    beta = torch.randn((1, B, H), dtype=torch.bfloat16) * 0.4
+    out = torch.empty((1, B, H, D), dtype=torch.bfloat16)
+
+    cs_orig = attn.kv_cache[0].clone()
+    rs_orig = attn.kv_cache[1].clone()
+    ref_o, ref_cs, ref_rs = ref_fused_kda_decode(
+        mixed,
+        cs_orig if dim_first else cs_orig.transpose(-1, -2),
+        attn.conv1d.weight.view(-1, 4),
+        attn.conv1d.bias,
+        g1[0],
+        beta[0],
+        attn.A_log,
+        attn.dt_bias,
+        g2,
+        attn.o_norm.weight,
+        rs_orig,
+        sidx,
+        -5.0,
+        1e-5,
+    )
+
+    attn._forward(mixed, g1, g2, beta, out)
+
+    kda_calls = fake.calls_for("fused_kda_decode")
+    assert len(kda_calls) == 1
+    assert kda_calls[0]["rows"] == B
+    assert torch.equal(out[0], ref_o)
+    cs_got = attn.kv_cache[0] if dim_first else attn.kv_cache[0].transpose(-1, -2)
+    assert torch.equal(cs_got, ref_cs)
+    assert torch.equal(attn.kv_cache[1], ref_rs)
+
