+def test_mla_fuse_g_proj_forward_1_launch_bit_identical_and_fallbacks(
+    monkeypatch, meta_platform, checkpoint, manager
+):
+    from vllm.sm80.kernels.k31q import dense
+
+    ops = fake_dense.FakeDenseOps().install(monkeypatch)
+    old_calls = _install_old_exl3(monkeypatch)
+    model, _, _, _ = construct.build_and_load(
+        monkeypatch, checkpoint, tp_size=2, tp_rank=0
+    )
+    _cpu_post_load(monkeypatch)
+    ops.name(model)
+    _process_dense(model)
+
+    mla_wrapper = model.model.layers[MLA_LAYER].self_attn.mla_attn
+    captured = _stub_mla_tail(mla_wrapper)
+    hidden = fixture.TEXT["hidden_size"]
+
+    # Default OFF: 2 separate launches ([q_a, kv_a], then [g_proj]).
+    monkeypatch.delenv("VLLM_K31Q_MLA_FUSE_G_PROJ", raising=False)
+    assert mla_wrapper.maybe_prepare_fused_qkv_a_g_launcher() is None
+
+    baseline_outputs = {}
+    for m_rows in (1, 4, 8, 32, 33):
+        gen = torch.Generator().manual_seed(100 + m_rows)
+        x = (torch.randn((m_rows, hidden), generator=gen) / 8).to(torch.bfloat16)
+        pos = torch.arange(m_rows, dtype=torch.int64)
+        ops.calls.clear()
+        old_calls.clear()
+        out = mla_wrapper(pos, x)
+        baseline_outputs[m_rows] = (
+            x,
+            pos,
+            out.clone(),
+            captured["kv_c_normed"].clone(),
+            captured["k_pe"].clone(),
+        )
+        if m_rows <= 32:
+            assert len(ops.calls) == 2
+            assert [[_leaf(m) for m in c["members"]] for c in ops.calls] == [
+                ["q_a_proj", "kv_a_proj_with_mqa"],
+                ["g_proj"],
+            ]
+        else:
+            # Default VLLM_K31Q_DENSE_PREFILL=exl3 routes >32 rows to EXL3 path.
+            assert len(ops.calls) == 0 and len(old_calls) == 3
+
+    # Switch ON: 1 launch for M in {1, 4, 8, 32}, exact bit-identical outputs!
+    monkeypatch.setenv("VLLM_K31Q_MLA_FUSE_G_PROJ", "1")
+    launcher = mla_wrapper.maybe_prepare_fused_qkv_a_g_launcher()
+    assert launcher is not None
+    # Lock workspace after one warm call (simulating post-profile CUDA graph capture).
+    for m_rows in (1, 4, 8, 32):
+        x, pos, ref_out, ref_kv_c, ref_k_pe = baseline_outputs[m_rows]
+        ops.calls.clear()
+        old_calls.clear()
+        with construct.no_host_reads(monkeypatch):
+            out = mla_wrapper(pos, x)
+        assert len(ops.calls) == 1
+        assert [_leaf(m) for m in ops.calls[0]["members"]] == [
+            "q_a_proj",
+            "kv_a_proj_with_mqa",
+            "g_proj",
+        ]
+        assert ops.calls[0]["rows"] == m_rows
+        assert old_calls == []
+        assert torch.equal(out, ref_out)
+        assert torch.equal(captured["kv_c_normed"], ref_kv_c)
+        assert torch.equal(captured["k_pe"], ref_k_pe)
+
+    # M = 33 (prefill > 32): falls back cleanly to separate calls, bit-identical.
+    x33, pos33, ref_out33, _, _ = baseline_outputs[33]
+    ops.calls.clear()
+    old_calls.clear()
+    out33 = mla_wrapper(pos33, x33)
+    assert len(ops.calls) == 0 and len(old_calls) == 3
+    assert torch.equal(out33, ref_out33)
+
+    # Forward hook attached to fused_qkv_a_proj or g_proj: falls back to 2 launches
+    # and invokes the hook.
+    for target in (mla_wrapper.fused_qkv_a_proj, mla_wrapper.g_proj):
+        fired = []
+        handle = target.register_forward_hook(lambda mod, inp, out: fired.append(1))
+        try:
+            x8, pos8, ref_out8, _, _ = baseline_outputs[8]
+            ops.calls.clear()
+            out8 = mla_wrapper(pos8, x8)
+            assert fired == [1]
+            assert len(ops.calls) == 2
+            assert torch.equal(out8, ref_out8)
+        finally:
+            handle.remove()
+
+    # Mixed bitrate between fused_qkv_a_proj (5-bit) and g_proj (6-bit):
+    # build_combined_decode_launcher returns None cleanly.
+    import dataclasses
+
+    orig_matrix = mla_wrapper.g_proj.exl3_weights[0].matrix
+    alt_bits = 12 if orig_matrix.bits_x2 != 12 else 10
+    mla_wrapper.g_proj.exl3_weights[0].matrix = dataclasses.replace(
+        orig_matrix, bits_x2=alt_bits
+    )
+    try:
+        assert (
+            dense.build_combined_decode_launcher(
+                [mla_wrapper.fused_qkv_a_proj, mla_wrapper.g_proj]
+            )
+            is None
+        )
+    finally:
+        mla_wrapper.g_proj.exl3_weights[0].matrix = orig_matrix
+
