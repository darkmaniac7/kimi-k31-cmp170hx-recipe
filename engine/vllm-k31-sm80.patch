+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Build and load the model class config.json names: the K3.1 wrapper with
+the vision tower, the projector and the text model under ``language_model``,
+resolved through the registry and loaded by the k31q loader on the CPU.
+
+A k31q checkpoint without ``vision.safetensors`` serves text only: the tower
+and the projector must be placeholders (``--language-model-only``, or a
+pipeline stage after the first), and a rank that builds them for real is
+refused with the option's name, at construction and again by the loader. With
+the file the tower loads on the first stage only, from the whole directory or
+from a stage view, and its tensors are cut for the tensor-parallel rank by
+the model's own loaders.
+
+The vision file here is written from the tiny config under the released
+names as this lane knows them (the projector's ``proj.0`` and ``proj.2``, a
+fused ``wqkv``): no real vision.safetensors exists yet to compare with.
+"""
+
+import numpy as np
+import pytest
+import torch
+
+from tests.models.kimi_k3.sm80 import construct
+from tests.models.kimi_k3.sm80 import k31q_fixture as fixture
+
+LAYERS = fixture.TEXT["num_hidden_layers"]
+PARTITION = (2, 2, 2)
+VISION_ROOTS = ("vision_tower.", "mm_projector.")
+
+
+@pytest.fixture(scope="module")
+def text_only(tmp_path_factory):
+    """The lane's first builds: no vision file."""
+    directory = tmp_path_factory.mktemp("k31q-text")
+    fixture.write_checkpoint(directory)
+    return directory
+
+
+@pytest.fixture(scope="module")
+def with_vision(tmp_path_factory):
+    directory = tmp_path_factory.mktemp("k31q-vision")
+    fixture.write_checkpoint(directory, vision=True)
+    return directory
+
+
+def _bits(tensor: torch.Tensor) -> np.ndarray:
+    return tensor.detach().contiguous().view(torch.int16).numpy().view(np.uint16)
+
+
+def _wrapper(
+    monkeypatch, directory, text_only, tp=1, rank=0, stage=0, stages=1, load=True
+):
+    """(model, report, checkpoint tensor names) of one rank of the wrapper."""
+    partition = PARTITION if stages > 1 else None
+    construct.set_groups(monkeypatch, tp, rank, stages, stage, partition)
+    config = construct.vllm_config(
+        directory, tp, stages, multimodal=construct.multimodal_config(text_only)
+    )
+    names = set(config.quant_config.manifest.tensors)
+    model = construct.build_wrapper(monkeypatch, config)
+    report = construct.load(monkeypatch, model, config) if load else None
+    return model, report, names
+
+
+def _vision_parameters(model) -> list[str]:
+    return [n for n, _ in model.named_parameters() if n.startswith(VISION_ROOTS)]
+
+
+def _is_placeholder(module) -> bool:
+    from vllm.model_executor.models.utils import StageMissingLayer
+
+    return isinstance(module, StageMissingLayer)
+
+
+@pytest.mark.parametrize("tp,rank", [(1, 0), (2, 1)])
+def test_text_only_wrapper_loads_without_a_vision_file(
+    monkeypatch, meta_platform, text_only, tp, rank
+):
+    from vllm.models.kimi_k3.nvidia.model import (
+        KimiK3ForConditionalGeneration,
+        KimiLinearForCausalLM,
+    )
+    from vllm.sm80.kernels.k31q.moe import K31VqMoEMethod
+    from vllm.sm80.kernels.k31q.quant import K31FusedLinearMethod
+
+    model, report, names = _wrapper(monkeypatch, text_only, True, tp, rank)
+    # The class the checkpoint's config names, not the text model alone.
+    assert type(model) is KimiK3ForConditionalGeneration
+    assert type(model.language_model) is KimiLinearForCausalLM
+    assert _is_placeholder(model.vision_tower) and _is_placeholder(model.mm_projector)
+    assert _vision_parameters(model) == []
+    assert not [n for n in names if n.startswith(VISION_ROOTS)]
+    # Every tensor of the directory has one entry, all consumed at one stage.
+    assert set(report.ledger) == names
+    assert {use for use, _ in report.ledger.values()} == {"consumed"}
+    assert report.layers == (0, LAYERS) and report.tp_size == tp
+    # The text model inside the wrapper took the k31q methods and its own cut.
+    layer = model.language_model.model.layers[1]
+    assert type(layer.self_attn.in_proj_qkvgfab.quant_method) is K31FusedLinearMethod
+    routed = layer.block_sparse_moe.experts.routed_experts
+    assert type(routed.quant_method) is K31VqMoEMethod
+    trellis = fixture.st_read(
+        text_only / "layer-001.safetensors",
+        f"{fixture.P}layers.1.self_attn.o_proj.trellis",
+    )
+    rows = slice(None) if tp == 1 else slice(rank * 8, (rank + 1) * 8)
+    assert np.array_equal(
+        layer.self_attn.o_proj.exl3_weights[0].trellis.numpy(), trellis[rows]
+    )
+    embed = fixture.st_read(
+        text_only / "embed.safetensors", fixture.P + "embed_tokens.weight"
+    )
+    vocab = fixture.TEXT["vocab_size"]
+    rows = slice(rank * vocab // tp, (rank + 1) * vocab // tp)
+    assert np.array_equal(
+        _bits(model.language_model.model.embed_tokens.weight), embed[rows]
+    )
+
+
+def test_a_real_tower_without_a_vision_file_is_refused(
+    monkeypatch, meta_platform, text_only
+):
+    """Images allowed and no vision file: the first stage, which builds the
+    tower for real, stops at the tower's first linear and names the option."""
+    with pytest.raises(ValueError, match="--language-model-only") as error:
+        _wrapper(monkeypatch, text_only, False, load=False)
+    assert "lists no vision.safetensors" in str(error.value)
+    assert "vision_tower.encoder.blocks.0" in str(error.value)
+
+
+def test_the_loader_refuses_uninitialized_vision_parameters(
+    monkeypatch, meta_platform, text_only
+):
+    """The same outcome from what the model really built: a tower that got
+    past construction is never left without weights."""
+    from vllm.sm80.kernels.k31q.quant import K31QConfig
+
+    monkeypatch.setattr(K31QConfig, "_require_vision_source", lambda *args: None)
+    model, _, _ = _wrapper(monkeypatch, text_only, False, load=False)
+    assert not _is_placeholder(model.vision_tower)
+    count = len(_vision_parameters(model))
+    assert count == 3 + 6 * fixture.VISION["vt_num_hidden_layers"] + 3
+    config = construct.vllm_config(
+        text_only, multimodal=construct.multimodal_config(False)
+    )
+    with pytest.raises(ValueError, match="--language-model-only") as error:
+        construct.load(monkeypatch, model, config)
+    assert f"{count} vision parameters without a source" in str(error.value)
+
+
+@pytest.mark.parametrize("tp,rank", [(1, 0), (2, 0), (2, 1)])
+def test_wrapper_loads_the_vision_file(
+    monkeypatch, meta_platform, with_vision, tp, rank
+):
+    from vllm.model_executor.layers.linear import UnquantizedLinearMethod
+
+    model, report, names = _wrapper(monkeypatch, with_vision, False, tp, rank)
+    assert not _is_placeholder(model.vision_tower)
+    assert set(report.ledger) == names
+    assert {use for use, _ in report.ledger.values()} == {"consumed"}
+    path = with_vision / fixture.VISION_FILE
+    stored = fixture.st_read_all(path)
+    assert len(stored) == len(_vision_parameters(model))
+    # Never quantized, whatever the text model's linears are.
+    block = model.vision_tower.encoder.blocks[1]
+    projector = model.mm_projector
+    for module in (block.mlp.fc0, block.wqkv, block.wo, projector.linear_1):
+        assert type(module.quant_method) is UnquantizedLinearMethod
+    # Unsplit tensors, bit for bit, the projector under its released names.
+    base = "vision_tower.encoder.blocks.1."
+    for parameter, name in (
+        (model.vision_tower.patch_embed.proj.weight, "vision_tower.patch_embed.proj"),
+        (block.norm0.weight, base + "norm0"),
+        (projector.linear_1.weight, "mm_projector.proj.0"),
+        (projector.linear_2.weight, "mm_projector.proj.2"),
+        (projector.post_norm.weight, "mm_projector.post_norm"),
+    ):
+        assert np.array_equal(_bits(parameter), stored[name + ".weight"][1])
+    owners = report.ledger["mm_projector.proj.0.weight"]
+    assert owners == ("consumed", "mm_projector.linear_1.weight")
+    # Cut by the tensor-parallel rank as the model's linears cut them:
+    # outputs of fc0 and of each of q, k, v; inputs of fc1 and wo.
+    hidden, inter = fixture.VISION["vt_hidden_size"], 128
+    qkv = fixture.VISION["qkv_hidden_size"]
+    cut = slice(rank * inter // tp, (rank + 1) * inter // tp)
+    fc0 = stored[base + "mlp.fc0.weight"][1]
+    fc1 = stored[base + "mlp.fc1.weight"][1]
+    assert np.array_equal(_bits(block.mlp.fc0.weight), fc0[cut])
+    assert np.array_equal(_bits(block.mlp.fc1.weight), fc1[:, cut])
+    cut = slice(rank * qkv // tp, (rank + 1) * qkv // tp)
+    wqkv = stored[base + "wqkv.weight"][1].reshape(3, qkv, hidden)
+    assert np.array_equal(_bits(block.wqkv.weight), wqkv[:, cut].reshape(-1, hidden))
+    assert np.array_equal(_bits(block.wo.weight), stored[base + "wo.weight"][1][:, cut])
+
+
+def test_text_only_wrapper_leaves_a_vision_file_unread(
+    monkeypatch, meta_platform, with_vision
+):
+    model, report, names = _wrapper(monkeypatch, with_vision, True)
+    assert _is_placeholder(model.vision_tower) and _vision_parameters(model) == []
+    assert set(report.ledger) == names
+    unused = {n: why for n, (use, why) in report.ledger.items() if use == "unused"}
+    assert set(unused) == {n for n in names if n.startswith(VISION_ROOTS)}
+    assert len(unused) == 18
+    assert set(unused.values()) == {"module is not built on this pipeline stage"}
+
+
+@pytest.mark.parametrize("vision", [False, True])
+@pytest.mark.parametrize("tp,rank", [(1, 0), (2, 1)])
+def test_wrapper_stages_load_from_views(
+    tmp_path, monkeypatch, meta_platform, text_only, with_vision, vision, tp, rank
+):
+    """Every pipeline stage builds the wrapper from its own view. The tower
+    is real on stage 0 of a checkpoint with the vision file and a placeholder
+    everywhere else; the view of stage 0 alone holds that file."""
+    from vllm.model_executor.models.utils import PPMissingLayer
+
+    source = with_vision if vision else text_only
+    views = fixture.build_views(source, tmp_path / "views", PARTITION)
+    held = [(view / fixture.VISION_FILE).exists() for view in views]
+    assert held == [vision, False, False]
+    for stage, view in enumerate(views):
+        # Without the file every stage is launched text-only.
+        model, report, names = _wrapper(
+            monkeypatch, view, not vision, tp, rank, stage, len(PARTITION)
+        )
+        first = sum(PARTITION[:stage])
+        assert report.layers == (first, first + PARTITION[stage])
+        assert (report.pp_rank, report.pp_size) == (stage, len(PARTITION))
+        assert _is_placeholder(model.vision_tower) == (not (vision and stage == 0))
+        assert bool(_vision_parameters(model)) == (vision and stage == 0)
+        text = model.language_model
+        built = [not isinstance(layer, PPMissingLayer) for layer in text.model.layers]
+        assert built == [first <= n < first + PARTITION[stage] for n in range(LAYERS)]
+        assert isinstance(text.model.embed_tokens, PPMissingLayer) == (stage != 0)
+        assert isinstance(text.lm_head, PPMissingLayer) == (stage != 2)
+        # The view holds this stage's tensors only, and all are accounted for.
+        assert set(report.ledger) == names
+        assert bool([n for n in names if n.startswith(VISION_ROOTS)]) == (
+            vision and stage == 0
+        )
+        unused = {n for n, (use, _) in report.ledger.items() if use == "unused"}
+        assert all(n.startswith("vq.") for n in unused)
+
+
+def test_later_stages_take_no_vision_from_the_whole_directory(
+    monkeypatch, meta_platform, with_vision
+):
+    """Without views a later stage sees the vision tensors and leaves them."""
+    model, report, names = _wrapper(
+        monkeypatch, with_vision, False, stage=1, stages=len(PARTITION)
+    )
+    assert _is_placeholder(model.vision_tower)
+    vision = {n for n in names if n.startswith(VISION_ROOTS)}
+    assert len(vision) == 18
+    assert {report.ledger[n] for n in vision} == {
+        ("unused", "module is not built on this pipeline stage")
+    }
+
+
+def test_a_vision_tensor_missing_from_the_file_fails_the_load(
+    tmp_path, monkeypatch, meta_platform, with_vision
+):
+    broken = fixture.copy_checkpoint(with_vision, tmp_path / "broken")
+    fixture.edit_file(
+        broken,
+        fixture.VISION_FILE,
+        lambda tensors: tensors.pop("mm_projector.proj.2.weight"),
+    )
+    with pytest.raises(ValueError, match="Unloaded k31q runtime parameters") as error:
+        _wrapper(monkeypatch, broken, False)
+    assert "mm_projector.linear_2.weight" in str(error.value)
