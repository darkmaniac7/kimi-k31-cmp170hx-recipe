+@pytest.mark.parametrize("tp_size,tp_rank", [(1, 0), (2, 0), (2, 1)])
+def test_k6_engine_wiring_tp_sharding_and_k31_launches(
+    monkeypatch, meta_platform, workspace_manager, tmp_path, tp_size, tp_rank
+):
+    """VLLM_DSPARK_EXL3_K6=1 wires fc, fused 3-mem qkv, o, fused 2-mem gate_up,
+    down, and replicated full-vocab markov_w2 through _k31_dense_C while keeping
+    confidence_head FP32, norms BF16, zero-Q context KV, and shared target K6 lm_head.
+    """
+    monkeypatch.setenv("VLLM_DSPARK_EXL3_K6", "1")
+    monkeypatch.setenv("VLLM_K31Q_DENSE_BACKEND", "k31")
+    _patch_fake_attention(monkeypatch)
+    _cpu_post_load_patch(monkeypatch)
+    ops = fake_dense.FakeDenseOps().install(monkeypatch)
+
+    ckpt = _write_tiny_dspark_k6_checkpoint(tmp_path / f"k6_tp{tp_size}_r{tp_rank}")
+    vcfg, draft_mc = _make_dspark_vllm_config(
+        monkeypatch, ckpt, quantized=True, tp_size=tp_size, tp_rank=tp_rank
+    )
+
+    with set_current_vllm_config(vcfg), set_default_torch_dtype(torch.bfloat16):
+        model = Qwen3DSparkForCausalLM(vllm_config=vcfg)
+        report = load_dspark_k6_weights(model, draft_mc, require_cuda=False)
+        for mod in model.modules():
+            qm = getattr(mod, "quant_method", None)
+            if isinstance(qm, K31DenseLinearMethod):
+                qm.process_weights_after_loading(mod)
+        model.process_weights_after_loading()
+
+    # Verify exact module counts & ledger
+    # 2 layers * (qkv + o + gate_up + down) + fc + markov_w2 = 10 EXL3 modules, 16 matrices
+    assert report.exl3_modules == 2 * 4 + 2
+    assert report.exl3_matrices == 2 * 7 + 2
+    assert report.counts()["consumed"] == len(K31DSparkManifest(ckpt).tensors)
+    assert report.reclaim_bytes > 0
+
+    # Verify header-only plan_dspark agrees byte-for-byte with loader report!
+    planned = plan_dspark(ckpt, tp_size=tp_size, tp_rank=tp_rank)
+    assert planned.total_bytes == report.loaded_bytes
+    assert planned.bf16_baseline_bytes == report.bf16_equivalent_bytes
+    assert planned.reclaim_bytes == report.reclaim_bytes
+
+    # Verify fused 3-member QKV, 2-member gate_up, replicated fc & markov_w2 shapes
+    assert isinstance(model.model.fc.quant_method, K31DenseLinearMethod)
+    assert len(model.model.fc.exl3_weights) == 1
+    assert model.model.fc.exl3_weights[0].logical_in == len(_TINY_AUX) * _TINY_H
+    assert model.model.fc.exl3_weights[0].logical_out == _TINY_H
+
+    qkv = model.model.layers[0].self_attn.qkv_proj
+    assert isinstance(qkv.quant_method, K31DenseLinearMethod)
+    assert [w.matrix.prefix for w in qkv.exl3_weights] == [
+        "layers.0.self_attn.q_proj",
+        "layers.0.self_attn.k_proj",
+        "layers.0.self_attn.v_proj",
+    ]
+    assert [w.logical_out for w in qkv.exl3_weights] == [
+        (_TINY_NQ * _TINY_HD) // tp_size,
+        (_TINY_NKV * _TINY_HD) // tp_size,
+        (_TINY_NKV * _TINY_HD) // tp_size,
+    ]
+
+    o_proj = model.model.layers[0].self_attn.o_proj
+    assert isinstance(o_proj.quant_method, K31DenseLinearMethod)
+    assert o_proj.exl3_weights[0].logical_in == (_TINY_NQ * _TINY_HD) // tp_size
+    assert o_proj.exl3_weights[0].logical_out == _TINY_H
+
+    gu = model.model.layers[0].mlp.gate_up_proj
+    assert isinstance(gu.quant_method, K31DenseLinearMethod)
+    assert [w.matrix.prefix for w in gu.exl3_weights] == [
+        "layers.0.mlp.gate_proj",
+        "layers.0.mlp.up_proj",
+    ]
+    assert [w.logical_out for w in gu.exl3_weights] == [
+        _TINY_INTER // tp_size,
+        _TINY_INTER // tp_size,
+    ]
+
+    down = model.model.layers[0].mlp.down_proj
+    assert isinstance(down.quant_method, K31DenseLinearMethod)
+    assert down.exl3_weights[0].logical_in == _TINY_INTER // tp_size
+    assert down.exl3_weights[0].logical_out == _TINY_H
+
+    mw2 = model.model.markov_head.markov_w2
+    assert isinstance(mw2.quant_method, K31DenseLinearMethod)
+    assert mw2.tp_size == 1
+    assert mw2.exl3_weights[0].logical_in == _TINY_MARKOV
+    assert mw2.exl3_weights[0].logical_out == _TINY_VOCAB
+
+    # Confidence head stays FP32 plain; markov_w1 stays BF16 embedding
+    assert isinstance(model.model.confidence_head.proj.quant_method, UnquantizedLinearMethod)
+    assert model.model.confidence_head.proj.weight.dtype == torch.float32
+    assert model.model.confidence_head.proj.bias.dtype == torch.float32
+    assert model.model.markov_head.markov_w1.weight.dtype == torch.bfloat16
+
+    # Refuses gathered top-k truncation on EXL3 K6 markov_w2
+    with pytest.raises(RuntimeError, match="full-vocabulary markov_w2"):
+        model.apply_markov_bias_gathered(
+            torch.zeros((1, _TINY_MARKOV), dtype=torch.bfloat16),
+            torch.zeros((1, _TINY_VOCAB), dtype=torch.bfloat16),
+            torch.zeros((1, 64), dtype=torch.bfloat16),
+            torch.zeros((1, 64), dtype=torch.long),
+        )
+
+    # Run forward ops through FakeDenseOps and check exact call sequence & zero-Q context KV!
+    ops.name(model)
+    ops.calls.clear()
+
+    # 1) fc
+    aux_x = torch.randn((4, len(_TINY_AUX) * _TINY_H), dtype=torch.bfloat16)
+    c = model.combine_hidden_states(aux_x)
+    assert c.shape == (4, _TINY_H)
+    assert ops.calls[-1]["members"] == ["fc"]
+
+    # 2) Phase-1 context KV (must launch ONLY k_proj + v_proj, NEVER q_proj!)
+    ops.calls.clear()
+    monkeypatch.setattr(
+        model.model,
+        "_normalize_context_states",
+        lambda x: x,
+    )
+    all_kv = model.model._project_context_kv_token_major(
+        c, 4, _TINY_LAYERS, _TINY_NKV // tp_size, _TINY_HD
+    )
+    assert all_kv.shape == (4, _TINY_LAYERS, 2, _TINY_NKV // tp_size, _TINY_HD)
+    assert len(ops.calls) == 1  # 2 layers * 2 (k,v) = 4 members in ONE launch!
+    assert ops.calls[0]["members"] == [
+        "layers.0.self_attn.k_proj",
+        "layers.0.self_attn.v_proj",
+        "layers.1.self_attn.k_proj",
+        "layers.1.self_attn.v_proj",
+    ]
+    assert not any("q_proj" in m for call in ops.calls for m in call["members"])
+
+    # 3) Fused 3-member QKV + 2-member gate_up
+    ops.calls.clear()
+    qkv_out, _ = qkv(c)
+    assert qkv_out.shape == (4, (_TINY_NQ + 2 * _TINY_NKV) * _TINY_HD // tp_size)
+    assert ops.calls[-1]["members"] == [
+        "layers.0.self_attn.q_proj",
+        "layers.0.self_attn.k_proj",
+        "layers.0.self_attn.v_proj",
+    ]
+    gu_out, _ = gu(c)
+    assert gu_out.shape == (4, (2 * _TINY_INTER) // tp_size)
+    assert ops.calls[-1]["members"] == [
+        "layers.0.mlp.gate_proj",
+        "layers.0.mlp.up_proj",
+    ]
+
+    # 4) Full-vocab markov_w2 + confidence head
+    ops.calls.clear()
+    me = model.markov_embed(torch.tensor([3, 7], dtype=torch.long))
+    mb = model.markov_bias(me)
+    assert mb.shape == (2, _TINY_VOCAB)
+    assert ops.calls[-1]["members"] == ["markov_head.markov_w2"]
+    conf = model.compute_confidence(c[:2], me)
+    assert conf.shape == (2,)
+    assert torch.all((conf >= 0.0) & (conf <= 1.0))
+
+    # 5) Share a target EXL3 K6 ParallelLMHead and verify compute_draft_logits_local
+    target_head_dir = tmp_path / f"target_head_tp{tp_size}_r{tp_rank}"
+    target_head_dir.mkdir()
+    th_tensors: dict[str, torch.Tensor] = {}
+    _pack_fake_exl3_k6(th_tensors, "lm_head", _TINY_VOCAB, _TINY_H, seed=999)
+    save_file(th_tensors, str(target_head_dir / "head.safetensors"))
+    from vllm.sm80.kernels.exl3.utils import Exl3LoadLedger, Exl3Manifest
+
+    th_manifest = Exl3Manifest(target_head_dir)
+    th_method = K31DenseLinearMethod([th_manifest.matrices["lm_head"]])
+    with set_current_vllm_config(vcfg), set_default_torch_dtype(torch.bfloat16):
+        target_lm_head = ParallelLMHead(
+            _TINY_VOCAB, _TINY_H, bias=False, quant_method=th_method, prefix="lm_head"
+        )
+        from safetensors import safe_open
+
+        with safe_open(str(target_head_dir / "head.safetensors"), framework="pt", device="cpu") as sf:
+            th_ledger = Exl3LoadLedger(th_manifest)
+            target_lm_head.exl3_weights[0].load({target_head_dir / "head.safetensors": sf}, th_ledger)
+        th_method.process_weights_after_loading(target_lm_head)
+
+    installed = share_target_lm_head(model, target_lm_head, quantization=None, can_share=True)
+    assert installed is target_lm_head
+    assert model.lm_head is target_lm_head
+    ops.name(model)
+    ops.calls.clear()
+    local_logits = model.compute_draft_logits_local(c)
+    assert local_logits.shape == (4, _TINY_VOCAB // tp_size)
+    assert ops.calls[-1]["members"] == ["lm_head"]
+
