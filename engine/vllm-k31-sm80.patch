+class _FakeDSparkBase:
+    """Minimal base matching DSparkSpeculator's interface for CPU tests."""
+
+    def __init__(self, vllm_config, device):
+        self.vllm_config = vllm_config
+        self.device = device
+        self.max_num_reqs = 8
+        self.max_width = 12
+        self.num_speculative_steps = 12
+        self.use_confidence_head = True
+        self.context_kv_only = False
+        self.draft_tokens = torch.zeros((8, 12), dtype=torch.int64)
+        self.draft_token_confidence_probs = torch.zeros((8, 12), dtype=torch.float32)
+        self.draft_logits = None
+        self.added: list[int] = []
+        self.finished: list[list[str]] = []
+
+    def add_request(self, req_index: int, new_req_data) -> None:
+        self.added.append(req_index)
+
+    def on_requests_finished(self, finished_req_ids) -> None:
+        self.finished.append(list(finished_req_ids))
+
+    def propose(
+        self,
+        input_batch,
+        attn_metadata,
+        slot_mappings,
+        last_hidden_states,
+        aux_hidden_states,
+        num_sampled,
+        num_rejected,
+        last_sampled,
+        next_prefill_tokens,
+        temperature,
+        seeds,
+        dp_sync_state=None,
+        dummy_run=False,
+        skip_attn_for_dummy_run=False,
+        mm_inputs=None,
+        is_profile=False,
+        num_speculative_tokens=None,
+    ):
+        return self.draft_tokens[: input_batch.num_reqs]
