+@_cuda
+def test_thin_gemm_lane_on_a_side_stream_is_bitwise_serial():
+    tg = pytest.importorskip("vllm.sm80.kernels.thin_gemm.thin_gemm_v74")
+    if torch.cuda.get_device_capability() != (8, 0):
