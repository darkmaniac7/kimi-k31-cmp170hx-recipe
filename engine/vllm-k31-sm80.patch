+def test_spec_decode_warmup_drives_the_served_paths(monkeypatch) -> None:
+    verify_calls, prepare_calls = [], []
+    runner, spec = _fake_worker(monkeypatch, verify_calls, prepare_calls)
+    spec_warmup.warmup_spec_decode(runner)
+
+    # One request with 5 drafts, verified on the model's logits and on their
+    # FP32 copy, with the speculator's draft logits and the runner's dtypes.
+    assert len(verify_calls) == 2
+    raw, proc = verify_calls
+    assert raw["target_logits"].dtype == torch.bfloat16
+    assert proc["target_logits"].dtype == torch.float32
+    assert raw["target_logits"].shape == (6, 16)
+    assert raw["draft_logits_cache"] is spec.draft_logits
+    assert raw["draft_sampled"].dtype == torch.int32
+    assert raw["pos"].dtype == torch.int64
+    assert raw["cu_num_logits"].tolist() == [0, 6]
+    assert raw["num_speculative_steps"] == 5
+    assert raw["use_block_verification"] is False
+
+    # Every reachable BLOCK_SIZE, for every draft KV-cache group.
+    blocks = {
+        min(
+            256,
+            triton.next_power_of_2(
+                int(c["input_batch"].num_scheduled_tokens.max()) + 6
+            ),
+        )
+        for c in prepare_calls
+    }
+    assert blocks == {8, 16, 32, 64, 128, 256}
+    assert len(prepare_calls) == 2 * len(blocks)
+    first, second = prepare_calls[0], prepare_calls[1]
+    assert first["input_buffers"] == "spec_buffers"
+    assert first["query_slot_mapping"] == "s0"
+    assert first["context_slot_mapping"] == "ctx0"
+    assert first["block_table"] == "t0"
+    assert first["block_size"] == 64
+    assert first["block_stride"] == 64
+    assert first["cp_rank"] == 0 and first["cp_size"] == 1
+    assert first["cp_interleave"] == 1
+    assert first["parallel_drafting_token_id"] == 7
+    assert first["num_query_per_req"] == 6
+    assert first["num_speculative_steps"] == 5
+    assert first["max_num_reqs"] == 8
+    assert first["max_num_tokens"] == 2048
+    assert first["max_model_len"] == 4096
+    assert first["sample_from_anchor"] is True
+    assert first["num_reqs_override"] == 1
+    # Group 2 has kernel_block_stride=3, kernel_block_size=64 -> block_stride=192.
+    assert second["block_size"] == 128 and second["block_stride"] == 192
+
