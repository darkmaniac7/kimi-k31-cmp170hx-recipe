+                         dict(HIDDEN=HIDDEN, KS=160, KA=128, KB=32, SINK=20, HAS_PRE_IN=has_pre,
+                              HAS_NORM=True, BH=finish_v2.BH_FIN, PART=0), M)
+            assert c.asm["cubin"]
