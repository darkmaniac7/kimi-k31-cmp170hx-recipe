+    if block_size < 16 or block_size & (block_size - 1):
+        raise refuse(
+            f"the kernel page must hold a power of two of at least 16 keys, not "
+            f"{block_size}"
+        )
+    page_stride, token_stride, byte_stride = kv_cache.stride()
+    if num_pages <= 1:
+        # A stride of a size-1 (or empty) dimension carries no information.
+        page_stride = max(page_stride, block_size * entry)
+    if token_stride != entry or byte_stride != 1:
+        raise refuse(
+            "a page must be contiguous (the packed layout must be "
+            "block-outermost, BLHNC)"
+        )
+    if page_stride < block_size * entry:
+        raise refuse("pages overlap")
+    if page_stride % SCALE_BYTES or kv_cache.storage_offset() % SCALE_BYTES:
+        raise refuse(
+            "the page stride and the cache offset must be multiples of 4 bytes: "
+            "the per-key scales are read and written as aligned fp32"
+        )
+    return IndexCacheGeometry(num_pages, block_size, head_dim, page_stride)
+
+
+def _flat_cache_bytes(kv_cache: torch.Tensor, geometry: IndexCacheGeometry):
+    """The cache's bytes from its first page on as one 1-D alias (for the
+    torch references; the Triton kernels take the cache's pointer)."""
+    return kv_cache.as_strided((geometry.span_bytes,), (1,))
+
+
+# ---------------------------------------------------------------------------
+# Torch references (VLLM_INDEXER_DSA_REF=1, tests)
+# ---------------------------------------------------------------------------
+
+
+def e4m3_values() -> torch.Tensor:
+    """The 127 finite non-negative float8_e4m3fn values, by code (fp64)."""
+    code = torch.arange(_E4M3_NAN_CODE, dtype=torch.float64)
+    exponent = torch.div(code, 8, rounding_mode="floor")
+    mantissa = code - 8 * exponent
+    subnormal = mantissa * 2.0**-9
+    normal = (1 + mantissa / 8) * torch.pow(2.0, exponent - 7)
+    return torch.where(exponent == 0, subnormal, normal)
+
+
+def e4m3_bits_reference(x: torch.Tensor) -> torch.Tensor:
+    """fp32 -> float8_e4m3fn bit patterns (``uint8``) by nearest value.
+
+    The definition the Triton helper ``f32_to_e4m3_bits`` is tested against,
+    written without its bit tricks: round to the nearest representable value,
+    ties to the even code; every magnitude above 448 (infinity included)
+    saturates to +-448; NaN gives the NaN pattern; the sign bit is kept
+    (so -0.0 is 0x80).
+    """
+    values = e4m3_values().to(x.device)
+    magnitude = x.abs().to(torch.float64)
+    upper = torch.bucketize(magnitude, values).clamp_(max=_E4M3_MAX_CODE)
+    lower = (upper - 1).clamp_(min=0)
+    below = magnitude - values[lower]
+    above = values[upper] - magnitude
+    even = torch.where(lower % 2 == 0, lower, upper)
+    code = torch.where(below < above, lower, torch.where(above < below, upper, even))
+    code = torch.where(magnitude > E4M3_MAX, _E4M3_MAX_CODE, code)
+    code = torch.where(torch.isnan(x), _E4M3_NAN_CODE, code)
+    code = code | (torch.signbit(x).to(code.dtype) << 7)
+    return code.to(torch.uint8)
+
+
+def e4m3_values_reference(bits: torch.Tensor) -> torch.Tensor:
+    """float8_e4m3fn bit patterns -> fp32; the NaN patterns give NaN."""
+    table = torch.cat(
+        (e4m3_values(), torch.tensor([float("nan")], dtype=torch.float64))
+    ).to(bits.device)
+    index = bits.to(torch.int64)
+    value = table[index & 0x7F]
+    return torch.where(index >= 0x80, -value, value).to(torch.float32)
+
+
+def ue8m0_scale_reference(amax: torch.Tensor, floor: float) -> torch.Tensor:
+    """The power-of-two scale that brings ``amax`` (fp32) under 448."""
+    scale = torch.clamp(amax, min=floor) / E4M3_MAX
+    return torch.exp2(torch.ceil(torch.log2(scale)))
+
+
+def k_norm_quant_reference(
+    k: torch.Tensor, norm_weight: torch.Tensor, norm_bias: torch.Tensor, norm_eps: float
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """``(bits [T, D] uint8, scale [T] fp32)`` of the indexer keys ``k``
+    ``[T, D]``: fp32 LayerNorm, rounded to ``k``'s dtype, then per-key FP8."""
+    head_dim = k.shape[-1]
+    y = F.layer_norm(
+        k.float(), (head_dim,), norm_weight.float(), norm_bias.float(), norm_eps
+    )
+    y = y.to(k.dtype).float()
+    scale = ue8m0_scale_reference(y.abs().amax(dim=-1), _K_AMAX_FLOOR)
+    return e4m3_bits_reference(y / scale[:, None]), scale
+
+
+def index_cache_write_reference(
+    kv_cache: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    bits: torch.Tensor,
+    scale: torch.Tensor,
+) -> None:
+    """Write keys ``bits`` ``[T, D]`` and their scales at ``slot_mapping``
+    (negative slots are skipped) into a bound cache of either layout."""
+    head_dim = bits.shape[-1]
+    geometry = index_cache_geometry(kv_cache, head_dim)
+    flat = _flat_cache_bytes(kv_cache, geometry)
+    slots = slot_mapping[: bits.shape[0]].to(torch.int64)
+    keep = slots >= 0
+    count = keep.shape[0]
+    slots, bits, scale = slots[keep], bits[:count][keep], scale[:count][keep]
+    page = torch.div(slots, geometry.block_size, rounding_mode="floor")
+    offset = slots - page * geometry.block_size
+    value_at = page * geometry.page_stride + offset * head_dim
+    scale_at = (
+        page * geometry.page_stride
+        + geometry.block_size * head_dim
+        + offset * SCALE_BYTES
+    )
+    span = torch.arange(head_dim, device=bits.device)
+    flat[(value_at[:, None] + span[None, :]).reshape(-1)] = bits.reshape(-1)
+    scale_bytes = scale.to(torch.float32).contiguous().view(torch.uint8).view(-1, 4)
+    span = torch.arange(SCALE_BYTES, device=bits.device)
+    flat[(scale_at[:, None] + span[None, :]).reshape(-1)] = scale_bytes.reshape(-1)
+
+
+def index_cache_read_reference(
+    kv_cache: torch.Tensor, slots: torch.Tensor, head_dim: int
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """``(bits [N, D] uint8, scale [N] fp32)`` of the keys at ``slots``."""
+    geometry = index_cache_geometry(kv_cache, head_dim)
+    flat = _flat_cache_bytes(kv_cache, geometry)
+    slots = slots.to(torch.int64)
+    page = torch.div(slots, geometry.block_size, rounding_mode="floor")
+    offset = slots - page * geometry.block_size
+    value_at = page * geometry.page_stride + offset * head_dim
+    scale_at = (
+        page * geometry.page_stride
+        + geometry.block_size * head_dim
+        + offset * SCALE_BYTES
+    )
+    span = torch.arange(head_dim, device=flat.device)
+    bits = flat[value_at[:, None] + span[None, :]]
+    span = torch.arange(SCALE_BYTES, device=flat.device)
+    scale = flat[scale_at[:, None] + span[None, :]].contiguous().view(torch.float32)
+    return bits, scale.reshape(-1)
+
+
+def q_quant_fold_weights_reference(
+    index_q: torch.Tensor,
+    index_weights: torch.Tensor,
+    weight_scale: float,
+    padded_num_heads: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Torch form of :func:`sm80_indexer_q_quant_fold_weights`."""
+    num_tokens, num_heads, head_dim = index_q.shape
+    q = index_q.float()
+    scale = ue8m0_scale_reference(q.abs().amax(dim=-1), _Q_AMAX_FLOOR)
+    bits = e4m3_bits_reference((q / scale[..., None]).clamp(-E4M3_MAX, E4M3_MAX))
+    folded = index_weights.float() * scale
+    folded = folded * torch.tensor(weight_scale, dtype=torch.float32, device=q.device)
+    q_bits = torch.zeros(
+        (num_tokens, padded_num_heads, head_dim), dtype=torch.uint8, device=q.device
+    )
+    weights = torch.zeros(
+        (num_tokens, padded_num_heads), dtype=torch.float32, device=q.device
+    )
+    q_bits[:, :num_heads] = bits
+    weights[:, :num_heads] = folded
+    return q_bits, weights
+
+
+# ---------------------------------------------------------------------------
+# Key insert and query quantization
+# ---------------------------------------------------------------------------
+
+
+@triton.jit
+def _sm80_k_norm_quant_insert_kernel(
+    k_ptr,
+    k_stride,
+    norm_w_ptr,
+    norm_b_ptr,
+    norm_eps,
+    slot_mapping_ptr,
+    num_slots,
+    cache_u8_ptr,
+    cache_f32_ptr,
+    cache_block_size,
+    cache_block_stride,
+    topk_ptr,
+    topk_stride,
+    HEAD_DIM: tl.constexpr,
+    TOPK: tl.constexpr,
+    TOPK_BLOCK: tl.constexpr,
+    FP8_MAX: tl.constexpr,
+):
+    """Upstream's ``_indexer_k_norm_quant_insert_kernel`` with the e4m3 bytes
+    computed in software and stored through a ``uint8`` pointer."""
+    tok = tl.program_id(0).to(tl.int64)
+    if tl.program_id(1) == 1:
+        # Padding rows included.
+        _fill_topk(topk_ptr + tok * topk_stride, TOPK, TOPK_BLOCK)
+    else:
+        # Padded rows have no slot.
+        slot = tl.load(slot_mapping_ptr + tok, mask=tok < num_slots, other=-1)
+        if slot >= 0:
+            offs = tl.arange(0, HEAD_DIM)
+            row_ptr = k_ptr + tok * k_stride
+            x = tl.load(row_ptr + offs).to(tl.float32)
+            mean = tl.sum(x, axis=0) / HEAD_DIM
+            diff = x - mean
+            rstd = tl.rsqrt(tl.sum(diff * diff, axis=0) / HEAD_DIM + norm_eps)
+            w = tl.load(norm_w_ptr + offs).to(tl.float32)
+            b = tl.load(norm_b_ptr + offs).to(tl.float32)
+            # Round to the key's dtype like the unfused path.
+            y = (diff * rstd * w + b).to(k_ptr.dtype.element_ty).to(tl.float32)
+
+            scale = _ue8m0_scale(tl.max(tl.abs(y), axis=0), 1e-4, FP8_MAX)
+            bits = f32_to_e4m3_bits(tl.div_rn(y, scale))
+
+            # Page layout: [block_size x HEAD_DIM values | block_size x fp32].
+            block_start = (slot // cache_block_size) * cache_block_stride
+            block_off = slot % cache_block_size
+            tl.store(cache_u8_ptr + block_start + block_off * HEAD_DIM + offs, bits)
+            scale_byte = block_start + cache_block_size * HEAD_DIM + block_off * 4
+            tl.store(cache_f32_ptr + scale_byte // 4, scale)
+
+
+def _require_fp32_scales() -> None:
+    if mqa_logits_use_mx_scales():
+        raise NotImplementedError(
+            f"{_PREFIX}: this device family stores packed UE8M0 key scales "
+            "(SM100); the fork's Triton logits kernels read fp32 scales. "
+            "Upstream's indexer serves there."
+        )
+
+
+def sm80_indexer_k_norm_quant_insert(
+    k: torch.Tensor,
+    norm_weight: torch.Tensor,
+    norm_bias: torch.Tensor,
+    norm_eps: float,
+    slot_mapping: torch.Tensor,
+    kv_cache: torch.Tensor,
+    topk_indices_buffer: torch.Tensor,
+    num_tokens: int,
+) -> None:
+    """LayerNorm + FP8 quantization + cache insert of the indexer key, and
+    the -1 fill of the top-k rows ``[:num_tokens]``: the contract of
+    upstream's ``indexer_k_norm_quant_insert`` without ``tl.float8e4nv``.
+
+    ``kv_cache`` is ``[pages, block_size, head_dim + 4]`` ``uint8``, possibly
+    a strided page view of a packed cache. Rows past ``slot_mapping`` or with
+    a negative slot are not inserted.
+    """
+    if num_tokens == 0:
+        return
+    head_dim = k.shape[-1]
+    assert k.stride(-1) == 1
+    assert triton.next_power_of_2(head_dim) == head_dim
+    geometry = index_cache_geometry(kv_cache, head_dim)
+    _require_fp32_scales()
+    if envs.VLLM_INDEXER_DSA_REF:
+        bits, scale = k_norm_quant_reference(
+            k[:num_tokens], norm_weight, norm_bias, norm_eps
+        )
+        index_cache_write_reference(kv_cache, slot_mapping, bits, scale)
+        topk_indices_buffer[:num_tokens] = -1
+        return
+    topk = topk_indices_buffer.shape[-1]
+    _sm80_k_norm_quant_insert_kernel[(num_tokens, 2)](
+        k,
+        k.stride(0),
+        norm_weight,
+        norm_bias,
+        norm_eps,
+        slot_mapping,
+        slot_mapping.shape[0],
+        kv_cache,
+        kv_cache.view(torch.float32),
+        geometry.block_size,
+        geometry.page_stride,
+        topk_indices_buffer,
+        topk_indices_buffer.stride(0),
+        HEAD_DIM=head_dim,
+        TOPK=topk,
+        TOPK_BLOCK=min(1024, triton.next_power_of_2(topk)),
+        FP8_MAX=E4M3_MAX,
+        num_warps=1,
+    )
+
+
+@triton.jit
+def _sm80_q_quant_fold_weights_kernel(
+    q_ptr,
+    q_stride0,
+    q_stride1,
+    w_ptr,
+    w_stride,
+    q_u8_ptr,
+    q_u8_stride0,
+    q_u8_stride1,
+    w_out_ptr,
+    w_out_stride,
+    weight_scale,
+    HEAD_DIM: tl.constexpr,
+    FP8_MAX: tl.constexpr,
+):
+    """Upstream's ``_indexer_q_quant_fold_weights_kernel`` with the e4m3
+    bytes computed in software."""
+    tok = tl.program_id(0).to(tl.int64)
+    head = tl.program_id(1)
+    offs = tl.arange(0, HEAD_DIM)
+    q = tl.load(q_ptr + tok * q_stride0 + head * q_stride1 + offs).to(tl.float32)
+    # Same math as per_token_group_quant_fp8(use_ue8m0=True) (eps=1e-10).
+    scale = _ue8m0_scale(tl.max(tl.abs(q), axis=0), 1e-10, FP8_MAX)
+    bits = f32_to_e4m3_bits(tl.clamp(tl.div_rn(q, scale), -FP8_MAX, FP8_MAX))
+    tl.store(q_u8_ptr + tok * q_u8_stride0 + head * q_u8_stride1 + offs, bits)
+    w = tl.load(w_ptr + tok * w_stride + head).to(tl.float32)
+    tl.store(w_out_ptr + tok * w_out_stride + head, w * scale * weight_scale)
+
+
+def sm80_indexer_q_quant_fold_weights(
+    index_q: torch.Tensor,
+    index_weights: torch.Tensor,
+    weight_scale: float,
+    padded_num_heads: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Quantize ``index_q`` ``[T, H, D]`` to FP8 per head (UE8M0 scales) and
+    fold each head's scale into ``index_weights`` ``[T, H]`` together with
+    ``weight_scale``: the contract of upstream's
+    ``indexer_q_quant_fold_weights`` without ``tl.float8e4nv``.
+
+    Returns ``(q_bits [T, P, D] uint8 e4m3 bit patterns, weights [T, P]
+    fp32)`` where ``P = padded_num_heads``; heads ``[H, P)`` are zero.
+    """
+    num_tokens, num_heads, head_dim = index_q.shape
+    assert index_q.stride(-1) == 1
+    assert index_weights.shape == (num_tokens, num_heads)
+    assert triton.next_power_of_2(head_dim) == head_dim
+    if envs.VLLM_INDEXER_DSA_REF:
+        return q_quant_fold_weights_reference(
+            index_q, index_weights, weight_scale, padded_num_heads
+        )
+    alloc = torch.empty if padded_num_heads == num_heads else torch.zeros
+    q_bits = alloc(
+        (num_tokens, padded_num_heads, head_dim),
+        dtype=torch.uint8,
+        device=index_q.device,
+    )
+    weights = alloc(
+        (num_tokens, padded_num_heads), dtype=torch.float32, device=index_q.device
+    )
+    if num_tokens == 0:
+        return q_bits, weights
+    _sm80_q_quant_fold_weights_kernel[(num_tokens, num_heads)](
+        index_q,
+        index_q.stride(0),
+        index_q.stride(1),
+        index_weights,
+        index_weights.stride(0),
+        q_bits,
+        q_bits.stride(0),
+        q_bits.stride(1),
+        weights,
+        weights.stride(0),
+        weight_scale,
+        HEAD_DIM=head_dim,
+        FP8_MAX=E4M3_MAX,
+        num_warps=1,
+    )
+    return q_bits, weights
+
+
+# ---------------------------------------------------------------------------
+# Logits over the paged cache (decode)
+# ---------------------------------------------------------------------------
+
+
+def _check_logits_shape(num_heads: int, head_dim: int) -> None:
+    if head_dim not in _LOGITS_HEAD_DIMS:
+        raise ValueError(
+            f"{_PREFIX}: index_head_dim must be one of {_LOGITS_HEAD_DIMS}, got "
+            f"{head_dim}."
+        )
+    if num_heads < 8 or num_heads & (num_heads - 1):
+        raise ValueError(
+            f"{_PREFIX}: the padded index head count must be a power of two of "
+            f"at least 8, got {num_heads}."
+        )
+
+
+def sm80_paged_mqa_logits(
+    q: torch.Tensor,
+    kv_cache: torch.Tensor,
+    weights: torch.Tensor,
+    context_lens: torch.Tensor,
+    block_tables: torch.Tensor,
+    max_model_len: int,
+    max_seq_len: int | None = None,
+) -> torch.Tensor:
+    """The fork's paged MQA logits over a K3.1 indexer cache of either layout.
+
+    Args:
+        q: ``[B, next_n, H, D]`` ``uint8`` e4m3 bit patterns.
+        kv_cache: the bound cache, see :func:`index_cache_geometry`.
+        weights: ``[B * next_n, H]`` fp32 (query scales folded in).
+        context_lens: ``[B, next_n]`` int32, or ``[B]`` / ``[B, 1]`` in the
+            DeepGEMM convention (``triton_mqa_logits._per_row_context_lens``).
+        block_tables: ``[B, max_pages]`` int32 kernel page ids.
+        max_model_len: width of the output.
+        max_seq_len: an upper bound on ``context_lens`` (any over-estimate is
+            safe).
+
+    Returns ``[B * next_n, max_model_len]`` fp32; ``-inf`` at and past a
+    row's context length inside the pages the kernel visits, undefined
+    beyond (the top-k kernels read ``[0, context_len)`` only).
+
+    """
+    assert q.dtype == torch.uint8 and q.dim() == 4, (q.dtype, q.shape)
+    batch, next_n, num_heads, head_dim = q.shape
+    assert q.stride(3) == 1
+    _check_logits_shape(num_heads, head_dim)
+    geometry = index_cache_geometry(kv_cache, head_dim)
+    if envs.VLLM_INDEXER_DSA_REF:
+        # The reference copies each page (reshape of the strided view).
+        return mqa.fp8_paged_mqa_logits_torch(
+            q.view(torch.float8_e4m3fn),
+            kv_cache,
+            weights,
+            context_lens,
+            block_tables,
+            max_model_len,
+        )
+    weights = weights.contiguous()
+    assert weights.shape[0] >= batch * next_n and weights.shape[1] == num_heads
+    assert weights.dtype == torch.float32
+    ctx = mqa._per_row_context_lens(context_lens, batch, next_n)
+    assert block_tables.dtype == torch.int32 and block_tables.stride(1) == 1
+
+    logits = torch.empty(
+        (batch * next_n, max_model_len), dtype=torch.float32, device=q.device
+    )
+    if batch == 0:
+        return logits
+    block_size = geometry.block_size
+    if max_seq_len is None:
+        max_seq_len = min(block_tables.shape[1] * block_size, max_model_len)
+    n_tiles = min(cdiv(max_seq_len, block_size), block_tables.shape[1])
+    if n_tiles == 0:
+        return logits
+    tiles_per_prog = mqa._tiles_per_program(batch, n_tiles, cap=max(1, 8 // next_n))
+    sq, sctx = q.stride(), ctx.stride()
+    # The kernel reads page `p` at byte `p * PAGE_BYTES` of the cache pointer
+    # and its scales `block_size * D` bytes further: with PAGE_BYTES the page
+    # stride it addresses the packed layout as it does the contiguous one.
+    mqa._paged_mqa_logits_kernel[(batch, cdiv(n_tiles, tiles_per_prog))](
+        q,
+        kv_cache,
+        kv_cache.view(torch.float32),
+        weights,
+        ctx,
+        block_tables,
+        logits,
+        max_model_len,
+        tiles_per_prog,
+        sq[0],
+        sq[1],
+        sq[2],
+        weights.stride(0),
+        sctx[0],
+        sctx[1],
+        block_tables.stride(0),
+        max_model_len,
+        NEXT_N=next_n,
+        NEXT_N_P2=1 << (next_n - 1).bit_length(),
+        H=num_heads,
+        D=head_dim,
+        BLOCK_SIZE=block_size,
+        PAGE_BYTES=geometry.page_stride,
+        RAW_K=mqa._decode_raw_k(q.device),
+        num_warps=2,
+        num_stages=2,
+    )
+    return logits
+
+
+# ---------------------------------------------------------------------------
+# The indexer step: logits and top-k of the current rows
+# ---------------------------------------------------------------------------
+
+
+def _reserve_profile_memory(
+    hidden_states: torch.Tensor,
+    head_dim: int,
+    max_model_len: int,
+    total_seq_lens: int,
+) -> None:
+    """The profiling run: reserve the gather workspace and the peak logits."""
+    current_workspace_manager().get_simultaneous(
+        ((total_seq_lens, head_dim), torch.uint8),
+        ((total_seq_lens, SCALE_BYTES), torch.uint8),
+        ((RADIX_TOPK_WORKSPACE_SIZE,), torch.uint8),
+    )
+    max_decode_tokens = 0
+    if (cfg := get_current_vllm_config_or_none()) is not None:
+        max_decode_tokens = min(
+            cfg.scheduler_config.max_num_seqs * (1 + cfg.num_speculative_tokens),
+            cfg.scheduler_config.max_num_batched_tokens,
+        )
+    max_logits_bytes = max(
+        envs.VLLM_SPARSE_INDEXER_MAX_LOGITS_MB * 1024 * 1024,
+        max_decode_tokens * max_model_len * torch.float32.itemsize,
+    )
+    _ = torch.empty(max_logits_bytes, dtype=torch.uint8, device=hidden_states.device)
+
+
+def _skip_scoring(mla_metadata: object, cudagraph_runtime_mode: CUDAGraphMode) -> bool:
+    """Upstream's ``should_skip_indexer_scoring``: a pure prefill the main
+    MLA runs on dense MHA never reads the top-k indices."""
+    prefill = getattr(mla_metadata, "prefill", None)
+    return (
+        cudagraph_runtime_mode != CUDAGraphMode.FULL
+        and getattr(prefill, "route", None) is SparseMLAPrefillRoute.DENSE_MHA
+        and getattr(mla_metadata, "num_decode_tokens", -1) == 0
+        and not torch.cuda.is_current_stream_capturing()
+    )
+
+
+def _score_prefill(
+    prefill: v32_indexer.DeepseekV32IndexerPrefillMetadata,
+    kv_cache: torch.Tensor,
+    q: torch.Tensor,
+    weights: torch.Tensor,
+    topk_tokens: int,
+    head_dim: int,
+    topk_indices_buffer: torch.Tensor,
+    topk_backend: str,
+) -> None:
+    from vllm import _custom_ops as ops
+
+    if prefill.shardq_gather_indices is not None:
+        raise NotImplementedError(
+            f"{_PREFIX}: ShardQ prefill steps are not supported (the Triton "
+            "sparse MLA backend does not enable them)."
+        )
+    k_bits_full, k_scale_full = current_workspace_manager().get_simultaneous(
+        (
+            (max(c.max_local_total_seq_lens for c in prefill.chunks), head_dim),
+            torch.uint8,
+        ),
+        (
+            (max(c.max_local_total_seq_lens for c in prefill.chunks), SCALE_BYTES),
+            torch.uint8,
+        ),
+    )
+    selector = get_indexer_topk(topk_backend)
+    for chunk in prefill.chunks:
+        assert chunk.local_cu_seq_lens is not None
+        assert chunk.pcp_deinterleave_idx is None
+        k_bits = k_bits_full[: chunk.max_local_total_seq_lens]
+        k_scale = k_scale_full[: chunk.max_local_total_seq_lens]
+        if not chunk.skip_kv_gather and chunk.local_total_seq_lens > 0:
+            # Reads pages at the cache's own page stride (cache_kernels.cu).
+            ops.cp_gather_indexer_k_quant_cache(
+                kv_cache, k_bits, k_scale, chunk.block_table, chunk.local_cu_seq_lens
+            )
+        row_start, row_end = chunk.token_start, chunk.token_end
+        q_rows = q[row_start:row_end]
+        topk_dst = topk_indices_buffer[row_start:row_end, :topk_tokens]
+        num_rows = q_rows.shape[0]
+        if chunk.local_total_seq_lens == 0 or num_rows == 0:
+            topk_dst.fill_(-1)
+            continue
+        # The Triton logits are not compressed: a row spans every gathered
+        # key, so the rows per call follow from the gathered count.
+        rows_per_call = v32_indexer.dense_logits_rows(k_bits.shape[0])
+        for sub in range(0, num_rows, rows_per_call):
+            rows = slice(sub, min(sub + rows_per_call, num_rows))
+            row_starts = chunk.cu_seqlen_ks[rows]
+            row_ends = chunk.cu_seqlen_ke[rows]
+            logits = mqa.fp8_mqa_logits(
+                q_rows[rows],
+                (k_bits, k_scale.view(torch.float32).squeeze(-1)),
+                weights[row_start + rows.start : row_start + rows.stop],
+                row_starts,
+                row_ends,
+            )
+            # Indices come out relative to the row start: positions in the
+            # request.
+            selector.forward_prefill(
+                logits, row_starts, row_ends, topk_dst[rows], topk_tokens
+            )
+            if use_tiefix_topk():
+                tiefix_topk_(
+                    logits,
+                    topk_dst[rows],
+                    row_starts=row_starts,
+                    row_ends=row_ends,
+                    relative=True,
+                    sort=use_sorted_topk(),
+                )
+            # Free this call's logits before the next allocates its own.
+            del logits
+
+
+def _score_decode(
+    metadata: v32_indexer.DeepseekV32IndexerMetadata,
+    kv_cache: torch.Tensor,
+    q: torch.Tensor,
+    weights: torch.Tensor,
+    topk_tokens: int,
+    max_model_len: int,
+    topk_indices_buffer: torch.Tensor,
+    topk_backend: str,
+) -> None:
+    decode = metadata.decode
+    assert decode is not None
+    if decode.global_seq_lens is not None or decode.indices is not None:
+        raise NotImplementedError(
+            f"{_PREFIX}: decode context parallelism and varlen decode rows "
+            "need DeepGEMM."
+        )
+    num_decode_tokens = metadata.num_decode_tokens
+    decode_lens = decode.decode_lens
+    # As upstream: requires_padding can be False for a ragged batch.
+    padded = decode.requires_padding or (num_decode_tokens % decode_lens.shape[0] != 0)
+    if num_decode_tokens == 0:
+        q_rows = q[:1].reshape(1, 1, *q.shape[1:])
+        row_weights = weights[:1]
+    elif padded:
+        # Zero bytes dequantize to zero; zero weights keep padded rows finite.
+        q_rows = pack_seq_triton(q[:num_decode_tokens], decode_lens, pad_value=0)
+        row_weights = pack_seq_triton(
+            weights[:num_decode_tokens], decode_lens, pad_value=0
+        ).reshape(-1, weights.shape[1])
+    else:
+        q_rows = q[:num_decode_tokens].reshape(decode_lens.shape[0], -1, *q.shape[1:])
+        row_weights = weights[:num_decode_tokens]
+    batch_size, next_n = q_rows.shape[0], q_rows.shape[1]
+    num_rows = batch_size * next_n
+    seq_lens = decode.seq_lens[:batch_size]
+    logits = sm80_paged_mqa_logits(
+        q_rows,
+        kv_cache,
+        row_weights[:num_rows],
+        seq_lens,
+        decode.block_table,
+        max_model_len,
+        max_seq_len=metadata.max_seq_len,
+    )
+    if padded:
+        # The packed rows are not the buffer's rows and may exceed its row
+        # count on ragged batches: allocate the full packed shape, then unpack.
+        topk_indices = torch.empty(
+            (num_rows, topk_tokens),
+            dtype=topk_indices_buffer.dtype,
+            device=topk_indices_buffer.device,
+        )
+    else:
+        topk_indices = topk_indices_buffer[:num_rows, :topk_tokens]
+    get_indexer_topk(topk_backend)(
+        logits, seq_lens, next_n, topk_indices, topk_tokens, metadata.max_seq_len
+    )
+    # Boundary ties go to the lowest indices when the fork's tie fix is on.
+    tiefix_decode_topk_(logits, topk_indices, seq_lens, next_n)
+    if padded:
+        unpacked = unpack_seq_triton(
+            topk_indices.reshape(batch_size, -1, topk_indices.shape[-1]), decode_lens
+        )
+        topk_indices_buffer[: unpacked.shape[0], : unpacked.shape[-1]] = unpacked
+
+
+@eager_break_during_capture
+def sm80_sparse_attn_indexer(
+    hidden_states: torch.Tensor,
+    k_cache_prefix: str,
+    kv_cache: torch.Tensor,
+    q: torch.Tensor,
+    weights: torch.Tensor,
+    topk_tokens: int,
+    head_dim: int,
+    max_model_len: int,
+    total_seq_lens: int,
+    topk_indices_buffer: torch.Tensor,
+    dense_mha_metadata_layer_name: str = "",
+    topk_backend: str = "auto",
+) -> torch.Tensor:
+    """Top-k of the current rows into ``topk_indices_buffer``: upstream's
+    ``sparse_attn_indexer`` for the K3.1 FP8 indexer (keys already inserted,
+    top-k rows already -1 filled by the key insert), with the fork's Triton
+    logits kernels in place of DeepGEMM. ``q`` is ``[T, H, D]`` ``uint8``.
+    """
+    forward_context = get_forward_context()
+    attn_metadata = forward_context.attn_metadata
+    # None in a dummy run.
+    if not isinstance(attn_metadata, dict):
+        _reserve_profile_memory(hidden_states, head_dim, max_model_len, total_seq_lens)
+        return topk_indices_buffer
+    metadata = attn_metadata[k_cache_prefix]
+    assert isinstance(metadata, v32_indexer.DeepseekV32IndexerMetadata)
+    if dense_mha_metadata_layer_name and _skip_scoring(
+        attn_metadata.get(dense_mha_metadata_layer_name),
+        forward_context.cudagraph_runtime_mode,
+    ):
+        return topk_indices_buffer
+    _check_logits_shape(q.shape[1], q.shape[2])
+    prefill = metadata.prefill
+    if prefill is not None and prefill.chunks:
+        _score_prefill(
+            prefill,
+            kv_cache,
+            q,
+            weights,
+            topk_tokens,
+            head_dim,
+            topk_indices_buffer,
+            topk_backend,
+        )
+    if metadata.num_decodes > 0:
+        _score_decode(
+            metadata,
+            kv_cache,
+            q,
+            weights,
+            topk_tokens,
+            max_model_len,
+            topk_indices_buffer,
+            topk_backend,
+        )
+    return topk_indices_buffer
+
+
+# ---------------------------------------------------------------------------
+# The layer classes
+# ---------------------------------------------------------------------------
+
+
+class KimiK3DSAIndexer(upstream_dsa.KimiK3DSAIndexer):
+    """Upstream's indexer with the three steps of this module."""
+
+    @classmethod
+    def adopt(cls, indexer: upstream_dsa.KimiK3DSAIndexer) -> "KimiK3DSAIndexer":
+        """Give an upstream-built indexer this class, or refuse a
+        configuration the sm_80 kernels do not serve."""
+        assert type(indexer) is upstream_dsa.KimiK3DSAIndexer, type(indexer)
+
+        def refuse(what: str) -> NotImplementedError:
+            return NotImplementedError(f"{_PREFIX}: {what}.")
+
+        if indexer.use_fp4_cache:
+            raise refuse(
+                "the MXFP4 key cache (indexer_kv_dtype='mxfp4') needs DeepGEMM"
+            )
+        if not indexer.use_fused_k_insert:
+            raise refuse(
+                "only the fused key insert is implemented (LayerNorm key norm, "
+                "index_rope_dim 0, no prefill context parallelism)"
+            )
+        if indexer.dcp_world_size > 1:
+            raise refuse("decode context parallelism needs DeepGEMM")
+        _check_logits_shape(indexer.padded_index_num_heads, indexer.index_head_dim)
+        indexer.__class__ = cls
+        return cast(KimiK3DSAIndexer, indexer)
+
+    def _fused_k_insert(self, index_k: torch.Tensor, num_tokens: int) -> None:
+        attn_metadata = get_forward_context().attn_metadata
+        kv_cache = self.k_cache.kv_cache
+        # Dummy / profiling run: the cache and the top-k buffer are left alone.
+        if not isinstance(attn_metadata, dict) or kv_cache.numel() == 0:
+            return
+        metadata = attn_metadata[self.k_cache.prefix]
+        assert isinstance(metadata, v32_indexer.DeepseekV32IndexerMetadata)
+        assert self.topk_indices_buffer is not None
+        norm = cast(upstream_dsa.KimiK3DSAIndexerKNorm, self.k_index_norm)
+        sm80_indexer_k_norm_quant_insert(
+            index_k,
+            norm.weight,
+            norm.bias,
+            norm.eps,
+            metadata.slot_mapping,
+            kv_cache,
+            self.topk_indices_buffer,
+            num_tokens,
+        )
+
+    def score(
+        self,
+        hidden_states: torch.Tensor,
+        index_q: torch.Tensor,
+        index_weights: torch.Tensor,
+        index_k: torch.Tensor | None,
+    ) -> torch.Tensor:
+        assert index_k is None, "the key is inserted before scoring"
+        assert self.topk_indices_buffer is not None
+        q_bits, weights = sm80_indexer_q_quant_fold_weights(
+            index_q,
+            index_weights,
+            self.index_softmax_scale * self.indexer_weight_scale,
+            self.padded_index_num_heads,
+        )
+        return sm80_sparse_attn_indexer(
+            hidden_states,
+            self.k_cache.prefix,
+            self.k_cache.kv_cache,
+            q_bits,
+            weights,
+            self.topk_tokens,
+            self.index_head_dim,
+            self.max_model_len,
+            self.max_total_seq_len,
+            self.topk_indices_buffer,
+            self.dense_mha_metadata_layer_name,
+            self.topk_backend,
+        )
+
+
+def served_by_triton_sparse_mla(attention: upstream_dsa.KimiK3DSAAttention) -> bool:
+    """Whether the layer's MLA backend is the fork's Triton sparse backend
+    (``vllm/sm80/attention/triton_mla_sparse.py``)."""
+    from vllm.sm80.attention.triton_mla_sparse import TritonMLASparseBackend
+
+    return attention.mla_attn.mla_attn.get_attn_backend() is TritonMLASparseBackend
+
+
+class KimiK3DSAAttention(upstream_dsa.KimiK3DSAAttention):
+    """Upstream's DSA layer with the sm_80 indexer and the wrapper forward.
+
+    The fused forward (``pack_projections``) is upstream's ``fp8_ds_mla``
+    path; its prologue stores through ``tl.float8e4nv``. This layer keeps the
+    wrapper forward, whose pieces all run on sm_80.
+    """
+
+    @classmethod
+    def adopt(cls, attention: upstream_dsa.KimiK3DSAAttention) -> "KimiK3DSAAttention":
+        """Give an upstream-built DSA layer this class and its indexer the
+        sm_80 class. The layer must be served by the Triton sparse backend."""
+        assert type(attention) is upstream_dsa.KimiK3DSAAttention, type(attention)
+        assert served_by_triton_sparse_mla(attention)
+        KimiK3DSAIndexer.adopt(attention.dsa_indexer)
+        attention.__class__ = cls
+        return cast(KimiK3DSAAttention, attention)
+
+    def pack_projections(self) -> None:
+        assert self._packed is None
