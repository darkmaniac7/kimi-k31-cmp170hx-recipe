@@ -0,0 +1,425 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU recording stand-in for ``vllm/sm80/kernels/k31q/glue_ops.py``.
+
+Implements exact FP32/BF16 reference math matching ``csrc/k31_glue/glue_k31.cu``
+on the CPU and records every call so unit tests can assert switch gating,
+fallback behavior, ``num_blocks = 0..8`` dispatch, ``delta2`` folding,
+``aux_hidden_states`` preservation, and ``M > 16`` fallbacks without a GPU.
+"""
+
+from __future__ import annotations
+
+import math
+
+from dataclasses import dataclass, field
+from typing import Any
+
+import torch
+import torch.nn.functional as F
+
+
+def ref_attn_res_rmsnorm(
+    prefix: torch.Tensor,
+    delta: torch.Tensor | None,
+    delta2: torch.Tensor | None,
+    blocks: torch.Tensor,
+    norm_weight: torch.Tensor,
+    qk_weight: torch.Tensor,
+    output_norm_weight: torch.Tensor | None,
+    num_blocks: int,
+    block_write_idx: int,
+    eps: float,
+    output_norm_eps: float,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Exact PyTorch FP32/BF16 reference matching ``k31_attn_res_7168_kernel``."""
+    p = prefix.clone()
+    b = blocks.clone()
+    if delta is not None:
+        d = delta
+        if delta2 is not None:
+            d = (delta.float() + delta2.float()).to(torch.bfloat16)
+        p = (p.float() + d.float()).to(torch.bfloat16)
+    if block_write_idx >= 0:
+        b[:, block_write_idx, :] = p
+    if num_blocks == 0:
+        mixed = p.float()
+    else:
+        srcs = [b[:, s, :].float() for s in range(num_blocks)] + [p.float()]
+        stk = torch.stack(srcs, dim=1)
+        w_qk = norm_weight.float() * qk_weight.float()
+        rstd = torch.rsqrt(stk.square().mean(dim=-1, keepdim=True) + float(eps))
+        logits = (stk * rstd * w_qk).sum(dim=-1)
+        probs = torch.softmax(logits, dim=-1)
+        mixed = (probs.unsqueeze(-1) * stk).sum(dim=1)
+    if output_norm_weight is not None:
+        rstd_o = torch.rsqrt(
+            mixed.square().mean(dim=-1, keepdim=True) + float(output_norm_eps)
+        )
+        out = (mixed * rstd_o * output_norm_weight.float()).to(torch.bfloat16)
+    else:
+        out = mixed.to(torch.bfloat16)
+    return out, p, b
+
+
+def ref_moe_topk_sigmoid(
+    logits: torch.Tensor,
+    bias: torch.Tensor,
+    top_k: int,
+    renormalize: bool,
+    routed_scaling_factor: float,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Exact deterministic FP32 reference matching ``k31_moe_topk_sigmoid``."""
+    sig = torch.sigmoid(logits.float())
+    biased = sig + bias.float().unsqueeze(0)
+    M, E = biased.shape
+    out_w = torch.empty((M, top_k), dtype=torch.float32, device=logits.device)
+    out_i = torch.empty((M, top_k), dtype=torch.int32, device=logits.device)
+    for m in range(M):
+        vals = biased[m].tolist()
+        order = sorted(
+            range(E),
+            key=lambda e: (math.isnan(vals[e]), 0.0 if math.isnan(vals[e]) else -vals[e], e),
+        )[:top_k]
+        idx_t = torch.tensor(order, dtype=torch.long, device=logits.device)
+        w = sig[m, idx_t]
+        if renormalize:
+            s = w.sum()
+            w = w / s if s > 0 else torch.zeros_like(w)
+        out_w[m] = w * float(routed_scaling_factor)
+        out_i[m] = idx_t.to(torch.int32)
+    return out_w, out_i
+
+
+def ref_fused_kda_decode(
+    mixed_qkv: torch.Tensor,
+    conv_state: torch.Tensor,
+    conv_weight: torch.Tensor,
+    conv_bias: torch.Tensor | None,
+    raw_g: torch.Tensor,
+    raw_beta: torch.Tensor,
+    A_log: torch.Tensor,
+    dt_bias: torch.Tensor,
+    g2: torch.Tensor,
+    norm_weight: torch.Tensor,
+    recurrent_state: torch.Tensor,
+    state_indices: torch.Tensor,
+    lower_bound: float,
+    norm_eps: float,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Exact PyTorch FP32/BF16 reference matching ``k31_fused_kda_decode``."""
+    B, C = mixed_qkv.shape
+    H, D = raw_g.shape[1], raw_g.shape[2]
+    cs = conv_state.clone()
+    rs = recurrent_state.clone()
+    dim_first = cs.shape[1] == C and cs.shape[2] == 3
+    out = torch.empty((B, H, D), dtype=torch.bfloat16, device=mixed_qkv.device)
+    for b_i in range(B):
+        slot = int(state_indices[b_i].item())
+        if slot <= 0:
+            out[b_i].zero_()
+            continue
+        x_in = mixed_qkv[b_i]
+        s_prev = cs[slot] if dim_first else cs[slot].transpose(0, 1)
+        cat4 = torch.cat([s_prev, x_in.unsqueeze(-1)], dim=-1).float()
+        acc = (cat4 * conv_weight.float()).sum(dim=-1)
+        if conv_bias is not None:
+            acc = acc + conv_bias.float()
+        shifted = torch.cat([s_prev[:, 1:], x_in.unsqueeze(-1)], dim=-1)
+        if dim_first:
+            cs[slot] = shifted
+        else:
+            cs[slot] = shifted.transpose(0, 1)
+        post = F.silu(acc).to(torch.bfloat16).float()
+        q = post[: H * D].view(H, D)
+        k = post[H * D : 2 * H * D].view(H, D)
+        v = post[2 * H * D :].view(H, D)
+        q = q * torch.rsqrt(q.square().sum(dim=-1, keepdim=True) + 1e-6) * (D ** -0.5)
+        k = k * torch.rsqrt(k.square().sum(dim=-1, keepdim=True) + 1e-6)
+        a = torch.exp(A_log.float()).view(H, 1)
+        gp = raw_g[b_i].float() + dt_bias.float().view(H, D)
+        if lower_bound < 0.0:
+            decay = torch.exp(lower_bound * torch.sigmoid(a * gp))
+        else:
+            decay = torch.exp(-a * F.softplus(gp))
+        beta = torch.sigmoid(raw_beta[b_i].float()).view(H, 1)
+        st = rs[slot] * decay.unsqueeze(1)
+        kv_pred = (st * k.unsqueeze(1)).sum(dim=-1)
+        dv = (v - kv_pred) * beta
+        st = st + dv.unsqueeze(-1) * k.unsqueeze(1)
+        rs[slot] = st
+        o = (st * q.unsqueeze(1)).sum(dim=-1).to(torch.bfloat16).float()
+        inv_rms = torch.rsqrt(o.square().mean(dim=-1, keepdim=True) + float(norm_eps))
+        y = o * inv_rms * norm_weight.float().view(1, D) * torch.sigmoid(g2[b_i].float())
+        out[b_i] = y.to(torch.bfloat16)
+    return out, cs, rs
+
+
+@dataclass
+class FakeGlueOps:
+    calls: list[dict[str, Any]] = field(default_factory=list)
+    api_version: int = 1
+    abi_version: int = 1
+
+    def install(self, monkeypatch) -> "FakeGlueOps":
+        """Install this stand-in on CPU so all glue custom ops run cleanly."""
+        from vllm.sm80.kernels.k31q import glue
+
+        glue._reset_state()
+        monkeypatch.setattr(glue, "library_built", lambda: True)
+        monkeypatch.setattr(glue, "load_glue_native", lambda: self)
+        monkeypatch.setattr(glue, "_attn_res_rmsnorm_op", glue._attn_res_rmsnorm_impl)
+        monkeypatch.setattr(glue, "_fused_kda_decode_op", glue._fused_kda_decode_impl)
+        monkeypatch.setattr(glue, "_moe_topk_sigmoid_op", glue._moe_topk_sigmoid_impl)
+        monkeypatch.setattr(glue, "_bf16_gemv_split2_op", glue._bf16_gemv_split2_impl)
+        monkeypatch.setattr(
+            glue, "_fused_router_gemv_topk_op", glue._fused_router_gemv_topk_impl
+        )
+        monkeypatch.setattr(
+            glue, "_fused_q_kv_rmsnorm_op", glue._fused_q_kv_rmsnorm_impl
+        )
+        monkeypatch.setattr(glue, "_sigmoid_mul_op", glue._sigmoid_mul_impl)
+        return self
+
+    def calls_for(self, op: str) -> list[dict[str, Any]]:
+        return [c for c in self.calls if c["op"] == op]
+
+    def build_info(self) -> dict[str, Any]:
+        return {
+            "abi_version": self.abi_version,
+            "api_version": self.api_version,
+            "torch_version": torch.__version__.split("+")[0],
+            "cuda_version": 13000,
+            "cxx11_abi": int(torch._C._GLIBCXX_USE_CXX11_ABI),
+        }
+
+    def attn_res_rmsnorm(
+        self,
+        prefix: torch.Tensor,
+        delta: torch.Tensor | None,
+        blocks: torch.Tensor,
+        norm_weight: torch.Tensor,
+        qk_weight: torch.Tensor,
+        output_norm_weight: torch.Tensor | None,
+        num_blocks: int,
+        block_write_idx: int,
+        eps: float,
+        output_norm_eps: float,
+        *,
+        delta2: torch.Tensor | None = None,
+        out: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        self.calls.append(
+            dict(
+                op="attn_res_rmsnorm",
+                rows=int(prefix.shape[0]),
+                hidden=int(prefix.shape[1]),
+                num_blocks=int(num_blocks),
+                block_write_idx=int(block_write_idx),
+                has_delta=delta is not None,
+                has_delta2=delta2 is not None,
+                apply_out_norm=output_norm_weight is not None,
+            )
+        )
+        res, new_p, new_b = ref_attn_res_rmsnorm(
+            prefix,
+            delta,
+            delta2,
+            blocks,
+            norm_weight,
+            qk_weight,
+            output_norm_weight,
+            num_blocks,
+            block_write_idx,
+            eps,
+            output_norm_eps,
+        )
+        if delta is not None:
+            prefix.copy_(new_p)
+        if block_write_idx >= 0:
+            blocks.copy_(new_b)
+        if out is None:
+            return res
+        out.copy_(res)
+        return out
+
+    def fused_kda_decode(
+        self,
+        mixed_qkv: torch.Tensor,
+        conv_state: torch.Tensor,
+        conv_weight: torch.Tensor,
+        conv_bias: torch.Tensor | None,
+        raw_g: torch.Tensor,
+        raw_beta: torch.Tensor,
+        A_log: torch.Tensor,
+        dt_bias: torch.Tensor,
+        g2: torch.Tensor,
+        norm_weight: torch.Tensor,
+        recurrent_state: torch.Tensor,
+        state_indices: torch.Tensor,
+        lower_bound: float,
+        norm_eps: float,
+        out: torch.Tensor,
+    ) -> None:
+        self.calls.append(
+            dict(
+                op="fused_kda_decode",
+                rows=int(mixed_qkv.shape[0]),
+                heads=int(raw_g.shape[1]),
+                head_dim=int(raw_g.shape[2]),
+                conv_state_shape=tuple(conv_state.shape),
+                lower_bound=float(lower_bound),
+            )
+        )
+        res, new_cs, new_rs = ref_fused_kda_decode(
+            mixed_qkv,
+            conv_state,
+            conv_weight,
+            conv_bias,
+            raw_g,
+            raw_beta,
+            A_log,
+            dt_bias,
+            g2,
+            norm_weight,
+            recurrent_state,
+            state_indices,
+            lower_bound,
+            norm_eps,
+        )
+        conv_state.copy_(new_cs)
+        recurrent_state.copy_(new_rs)
+        out.copy_(res)
+
+    def moe_topk_sigmoid(
+        self,
+        logits: torch.Tensor,
+        bias: torch.Tensor,
+        top_k: int,
+        renormalize: bool,
+        routed_scaling_factor: float,
+        topk_weights: torch.Tensor,
+        topk_ids: torch.Tensor,
+    ) -> None:
+        self.calls.append(
+            dict(
+                op="moe_topk_sigmoid",
+                rows=int(logits.shape[0]),
+                num_experts=int(logits.shape[1]),
+                top_k=int(top_k),
+                renormalize=bool(renormalize),
+                routed_scaling_factor=float(routed_scaling_factor),
+            )
+        )
+        w, idx = ref_moe_topk_sigmoid(
+            logits, bias, top_k, renormalize, routed_scaling_factor
+        )
+        topk_weights.copy_(w)
+        topk_ids.copy_(idx)
+
+    def bf16_gemv_split2(
+        self,
+        x: torch.Tensor,
+        w: torch.Tensor,
+        n0: int,
+        out0: torch.Tensor,
+        out1: torch.Tensor,
+    ) -> None:
+        self.calls.append(
+            dict(
+                op="bf16_gemv_split2",
+                rows=int(x.shape[0]),
+                k=int(x.shape[1]),
+                n0=int(n0),
+                n1=int(w.shape[0] - n0),
+            )
+        )
+        full = F.linear(x.float(), w.float()).to(torch.bfloat16)
+        out0.copy_(full[:, :n0])
+        out1.copy_(full[:, n0:])
+
+
+    def router_workspace_size(self, max_rows: int, num_experts: int) -> int:
+        chunk_rows = min(int(max_rows), 16)
+        return 4 + 2 * chunk_rows * int(num_experts)
+
+    def allocate_router_workspace(
+        self, max_rows: int, num_experts: int, device: torch.device | str
+    ) -> torch.Tensor:
+        n = self.router_workspace_size(max_rows, num_experts)
+        return torch.zeros((n,), dtype=torch.float32, device=device)
+
+    def fused_router_gemv_topk(
+        self,
+        x: torch.Tensor,
+        w_gate: torch.Tensor,
+        bias: torch.Tensor,
+        top_k: int,
+        renormalize: bool,
+        routed_scaling_factor: float,
+        topk_weights: torch.Tensor,
+        topk_ids: torch.Tensor,
+        workspace: torch.Tensor,
+    ) -> None:
+        self.calls.append(
+            dict(
+                op="fused_router_gemv_topk",
+                rows=int(x.shape[0]),
+                k=int(x.shape[1]),
+                num_experts=int(w_gate.shape[0]),
+                top_k=int(top_k),
+                renormalize=bool(renormalize),
+                routed_scaling_factor=float(routed_scaling_factor),
+            )
+        )
+        logits = F.linear(x.float(), w_gate.float())
+        w, idx = ref_moe_topk_sigmoid(
+            logits, bias, top_k, renormalize, routed_scaling_factor
+        )
+        topk_weights.copy_(w)
+        topk_ids.copy_(idx)
+
+    def fused_q_kv_rmsnorm(
+        self,
+        q_c: torch.Tensor,
+        kv_c: torch.Tensor,
+        q_weight: torch.Tensor,
+        kv_weight: torch.Tensor,
+        q_eps: float,
+        kv_eps: float,
+        q_out: torch.Tensor,
+        kv_out: torch.Tensor,
+    ) -> None:
+        self.calls.append(
+            dict(
+                op="fused_q_kv_rmsnorm",
+                rows=int(q_c.shape[0]),
+                q_dim=int(q_c.shape[1]),
+                kv_dim=int(kv_c.shape[1]),
+                q_eps=float(q_eps),
+                kv_eps=float(kv_eps),
+            )
+        )
+        qf = q_c.float()
+        q_rstd = torch.rsqrt(qf.square().mean(dim=-1, keepdim=True) + float(q_eps))
+        q_out.copy_((qf * q_rstd * q_weight.float()).to(torch.bfloat16))
+        kvf = kv_c.float()
+        kv_rstd = torch.rsqrt(kvf.square().mean(dim=-1, keepdim=True) + float(kv_eps))
+        kv_out.copy_((kvf * kv_rstd * kv_weight.float()).to(torch.bfloat16))
+
+    def sigmoid_mul(
+        self,
+        attn_out: torch.Tensor,
+        gate: torch.Tensor,
+        out: torch.Tensor,
+    ) -> None:
+        self.calls.append(
+            dict(
+                op="sigmoid_mul",
+                shape=tuple(attn_out.shape),
+                numel=int(attn_out.numel()),
+            )
+        )
+        out.copy_(
+            (attn_out.float() * torch.sigmoid(gate.float())).to(torch.bfloat16)
+        )
