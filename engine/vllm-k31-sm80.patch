+void set_ref_sms_k31(int64_t ref_sms) {
+  if (ref_sms < 0) {
+    g_ref_sms_cached.store(-1, std::memory_order_release);
+  } else if (ref_sms == 0) {
+    g_ref_sms_cached.store(0, std::memory_order_release);
+  } else {
+    const int clamped = static_cast<int>(std::min<int64_t>(ref_sms, 1024));
+    g_ref_sms_cached.store(clamped, std::memory_order_release);
+  }
+}
+
+int64_t get_ref_sms_k31() {
+  int cached = g_ref_sms_cached.load(std::memory_order_acquire);
+  if (cached < 0) {
+    cached = parse_ref_sms_env();
+    g_ref_sms_cached.store(cached, std::memory_order_release);
+  }
+  return static_cast<int64_t>(cached);
+}
+
+int64_t linear_workspace_size_k31(int64_t max_rows, int64_t padded_in, int64_t total_padded_out, int64_t num_members) {
+  TORCH_CHECK(max_rows >= 0 && padded_in > 0 && padded_in % 128 == 0,
+              "dense_k31: invalid linear_workspace_size_k31 max_rows/padded_in");
+  TORCH_CHECK(total_padded_out > 0 && total_padded_out % 128 == 0,
+              "dense_k31: invalid linear_workspace_size_k31 total_padded_out");
+  TORCH_CHECK(num_members >= 1 && num_members <= kMaxMembers,
+              "dense_k31: num_members must be in 1..4");
+  auto align4 = [](int64_t n) { return ((n + 3) / 4) * 4; };
+  const int64_t dec_rows = std::max<int64_t>(1, std::min<int64_t>(max_rows, 32));
+  const int64_t rows8 = (dec_rows + 7) & ~int64_t(7);
+  const int64_t nt_tot = rows8 >> 3;
+  const int64_t steps = padded_in / 16;
+  // First 4096 ints (16 KB, 128B aligned): per-workspace split arrival counters.
+  const int64_t dec_arr = align4(kMaxArrivalBlocks);
+  const int64_t dec_act = align4(num_members * steps * nt_tot * 32 * 2);
+  const int64_t dec_sc  = align4(num_members * (padded_in / 128) * rows8);
+  const int64_t max_slots = (total_padded_out / 128) + 1536;
+  const int64_t dec_par = align4(dec_rows * max_slots * 128);
+  const int64_t dec_tot = dec_arr + dec_act + dec_sc + dec_par + 64;
+  if (max_rows <= 32) {
+    return dec_tot;
+  }
+
+  const int64_t max_n_chunk = std::min<int64_t>(total_padded_out, 8192);
+  const int64_t pre_xh  = align4((max_rows * padded_in + 1) / 2);
+  const int64_t pre_wc  = align4((max_n_chunk * padded_in + 1) / 2);
+  const int64_t pre_yh  = align4((max_rows * max_n_chunk + 1) / 2);
+  const int64_t pre_tot = pre_xh + pre_wc + pre_yh + 64;
+  return std::max(dec_tot, pre_tot);
+}
+
+void linear_out_k31_multi(
+    const at::Tensor& x,
+    const std::vector<at::Tensor>& trellises,
+    const std::vector<at::Tensor>& suhs,
+    const std::vector<at::Tensor>& svhs,
+    const std::vector<int64_t>& bits_x2s,
+    const std::vector<int64_t>& logical_outs,
+    at::Tensor& out,
+    at::Tensor& workspace
+) {
+  const int M_mem = static_cast<int>(trellises.size());
+  TORCH_CHECK(M_mem >= 1 && M_mem <= kMaxMembers, "dense_k31 supports 1..4 members");
+  TORCH_CHECK(static_cast<int>(suhs.size()) == M_mem &&
+                  static_cast<int>(svhs.size()) == M_mem &&
+                  static_cast<int>(bits_x2s.size()) == M_mem &&
+                  static_cast<int>(logical_outs.size()) == M_mem,
+              "dense_k31: trellises, suhs, svhs, bits_x2s, and logical_outs must have equal length");
+  TORCH_CHECK(x.is_cuda() && x.dtype() == at::kBFloat16 && x.dim() == 2 && x.is_contiguous(),
+              "dense_k31: x must be contiguous CUDA BF16 2D");
+  TORCH_CHECK(out.is_cuda() && (out.dtype() == at::kBFloat16 || out.dtype() == at::kFloat) &&
+                  out.dim() == 2 && out.is_contiguous() && out.device() == x.device(),
+              "dense_k31: out must be contiguous CUDA BF16/FP32 2D on x.device()");
+  TORCH_CHECK(workspace.is_cuda() && workspace.dtype() == at::kFloat &&
+                  workspace.dim() == 1 && workspace.is_contiguous() &&
+                  workspace.device() == x.device(),
+              "dense_k31: workspace must be contiguous CUDA FP32 1D on x.device()");
+  TORCH_CHECK(trellises[0].is_cuda() && trellises[0].dim() == 3 &&
+                  trellises[0].dtype() == at::kShort,
+              "dense_k31: trellises[0] must be CUDA int16 3D");
+
+  const int64_t rows = x.size(0);
+  const int64_t logical_in = x.size(1);
+  const int64_t padded_in = trellises[0].size(0) * 16;
+  TORCH_CHECK(padded_in > 0 && (padded_in % 128) == 0,
+              "dense_k31: padded_in must be positive multiple of 128, got ", padded_in);
+  TORCH_CHECK(logical_in >= 0 && logical_in <= padded_in,
+              "dense_k31: x.size(1) (", logical_in, ") exceeds padded_in (", padded_in, ")");
+
+  int64_t total_logical_out = 0, total_padded_out = 0;
+  bool uniform_bits = true;
+  for (int i = 0; i < M_mem; ++i) {
+    TORCH_CHECK(trellises[i].is_cuda() && trellises[i].device() == x.device() &&
+                    trellises[i].dtype() == at::kShort && trellises[i].dim() == 3 &&
+                    trellises[i].is_contiguous(),
+                "dense_k31: trellises[", i, "] must be contiguous CUDA int16 3D on x.device()");
+    TORCH_CHECK(suhs[i].is_cuda() && suhs[i].device() == x.device() &&
+                    suhs[i].dtype() == at::kHalf && suhs[i].dim() == 1 &&
+                    suhs[i].is_contiguous() && suhs[i].size(0) == padded_in,
+                "dense_k31: suhs[", i, "] must be contiguous CUDA FP16 1D of length padded_in");
+    TORCH_CHECK(svhs[i].is_cuda() && svhs[i].device() == x.device() &&
+                    svhs[i].dtype() == at::kHalf && svhs[i].dim() == 1 &&
+                    svhs[i].is_contiguous(),
+                "dense_k31: svhs[", i, "] must be contiguous CUDA FP16 1D on x.device()");
+    TORCH_CHECK(trellises[i].size(0) * 16 == padded_in,
+                "dense_k31: trellises[", i, "] padded_in mismatch");
+    const int64_t b2 = bits_x2s[i];
+    TORCH_CHECK(b2 == 10 || b2 == 12 || b2 == 14,
+                "dense_k31: bits_x2s[", i, "] must be in {10, 12, 14}, got ", b2);
+    TORCH_CHECK(trellises[i].size(2) == 8 * b2,
+                "dense_k31: trellises[", i, "].size(2) must equal 8 * bits_x2 (", 8 * b2, ")");
+    const int64_t po = trellises[i].size(1) * 16;
+    TORCH_CHECK(po > 0 && (po % 128) == 0,
+                "dense_k31: member ", i, " padded_out must be positive multiple of 128, got ", po);
+    TORCH_CHECK(svhs[i].size(0) == po,
+                "dense_k31: svhs[", i, "] length (", svhs[i].size(0), ") != padded_out (", po, ")");
+    TORCH_CHECK(logical_outs[i] > 0 && logical_outs[i] <= po,
+                "dense_k31: logical_outs[", i, "] (", logical_outs[i], ") out of range (0, ", po, "]");
+    total_logical_out += logical_outs[i];
+    total_padded_out += po;
+    if (b2 != bits_x2s[0]) uniform_bits = false;
+  }
+  TORCH_CHECK(out.size(0) == rows && out.size(1) == total_logical_out,
+              "dense_k31: out shape mismatch (expected [", rows, ", ", total_logical_out, "])");
+  if (rows == 0) return;
+
+  const int64_t ws_check_rows = (rows <= 32 && !uniform_bits) ? 33 : rows;
+  const int64_t needed_ws = linear_workspace_size_k31(ws_check_rows, padded_in, total_padded_out, M_mem);
+  TORCH_CHECK(workspace.numel() >= needed_ws,
+              "dense_k31 workspace too small (got ", workspace.numel(), ", need ", needed_ws, ")");
+
+  const c10::cuda::CUDAGuard guard(x.device());
+  const cudaStream_t stream = at::cuda::getCurrentCUDAStream(x.get_device()).stream();
+  const int sms = at::cuda::getCurrentDeviceProperties()->multiProcessorCount;
+  const int eff_sms = resolve_effective_sms(sms);
+
+  auto align4 = [](int64_t n) { return ((n + 3) / 4) * 4; };
+  float* ws = workspace.data_ptr<float>();
+
+  if (rows <= 32 && uniform_bits) {
+    const int64_t rows8 = (rows + 7) & ~int64_t(7);
+    const int64_t nt_tot = rows8 >> 3;
+    const int64_t steps = padded_in / 16;
+
+    int64_t off = 0;
+    int* arrival_buf = reinterpret_cast<int*>(ws + off);   off += align4(kMaxArrivalBlocks);
+    uint2* act_bfrag = reinterpret_cast<uint2*>(ws + off); off += align4(M_mem * steps * nt_tot * 32 * 2);
+    float* blk_sc    = ws + off;                           off += align4(M_mem * (padded_in / 128) * rows8);
+    float* partial_b = ws + off;
+    const int64_t avail_partial = workspace.numel() - off;
+
+    MultiDecodeParams p{};
+    p.num_members = M_mem;
+    p.rows = static_cast<int>(rows);
+    p.logical_in = static_cast<int>(logical_in);
+    p.padded_in = static_cast<int>(padded_in);
+    p.total_logical_out = static_cast<int>(total_logical_out);
+    p.total_padded_out = static_cast<int>(total_padded_out);
+    p.total_out_blocks = static_cast<int>(total_padded_out / 128);
+    p.grid_ctas = choose_fused_grid(padded_in, total_padded_out, rows, eff_sms, avail_partial);
+    p.exact_splits = (p.grid_ctas % p.total_out_blocks == 0) ? (p.grid_ctas / p.total_out_blocks) : 0;
+
+    InputParams ip{};
+    ip.num_members = M_mem;
+    ip.rows = static_cast<int>(rows);
+    ip.logical_in = static_cast<int>(logical_in);
+    ip.padded_in = static_cast<int>(padded_in);
+    ip.total_out_blocks = p.total_out_blocks;
+
+    int off_log = 0, blk_acc = 0;
+    for (int i = 0; i < M_mem; ++i) {
+      const int po = static_cast<int>(trellises[i].size(1) * 16);
+      const half* suh_ptr = reinterpret_cast<const half*>(suhs[i].data_ptr<at::Half>());
+      if (i == 0) ip.suh0 = suh_ptr;
+      else if (i == 1) ip.suh1 = suh_ptr;
+      else if (i == 2) ip.suh2 = suh_ptr;
+      else ip.suh3 = suh_ptr;
+      p.mem[i] = MemberDesc{
+          reinterpret_cast<const uint16_t*>(trellises[i].data_ptr<int16_t>()),
+          suh_ptr,
+          reinterpret_cast<const half*>(svhs[i].data_ptr<at::Half>()),
+          po, static_cast<int>(logical_outs[i]), off_log, blk_acc, po / 128
+      };
+      off_log += static_cast<int>(logical_outs[i]);
+      blk_acc += po / 128;
+    }
+
+    const int blocks_k = static_cast<int>(padded_in / 128);
+    const int total_in_warps = blocks_k * static_cast<int>(rows) * M_mem;
+    const int warps_per_cta = (total_in_warps <= 4 * sms) ? 1 : 4;
+    const dim3 in_grid(static_cast<unsigned int>((blocks_k + warps_per_cta - 1) / warps_per_cta),
+                       static_cast<unsigned int>(rows * M_mem));
+    k31_decode_input_multi_kernel<<<in_grid, 32 * warps_per_cta, 0, stream>>>(
+        reinterpret_cast<const __nv_bfloat16*>(x.data_ptr<at::BFloat16>()),
+        ip, arrival_buf, act_bfrag, blk_sc);
+
+    if (out.dtype() == at::kBFloat16) {
+      launch_fused_all<__nv_bfloat16>(
+          static_cast<int>(bits_x2s[0]), p, arrival_buf, act_bfrag, blk_sc, partial_b,
+          reinterpret_cast<__nv_bfloat16*>(out.data_ptr<at::BFloat16>()), stream);
+    } else {
+      launch_fused_all<float>(
+          static_cast<int>(bits_x2s[0]), p, arrival_buf, act_bfrag, blk_sc, partial_b,
+          out.data_ptr<float>(), stream);
+    }
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+    return;
+  }
+
+  // PREFILL PATH (rows > 32): 100%-COALESCED [K_pad, cur_n] dequant + cuBLAS BF16 Tensor Core GEMM.
+  // Enforce FP32 cuBLAS reduction (disallowing reduced-precision BF16 split-K reduction).
+  // Note: trellis weights are dequantized from FP16 to BF16 before GEMM, which differs from
+  // decode's FP16 MMA accumulation; default VLLM_K31Q_DENSE_PREFILL=exl3 routes M > 32 to EXL3.
+  ScopedFp32Bf16GemmGuard fp32_red_guard;
+  const int64_t max_n_chunk = std::min<int64_t>(total_padded_out, 8192);
+  int64_t off = 0;
+  __nv_bfloat16* x_h_ptr = reinterpret_cast<__nv_bfloat16*>(ws + off); off += align4((rows * padded_in + 1) / 2);
+  __nv_bfloat16* w_c_ptr = reinterpret_cast<__nv_bfloat16*>(ws + off); off += align4((max_n_chunk * padded_in + 1) / 2);
+  __nv_bfloat16* y_h_ptr = reinterpret_cast<__nv_bfloat16*>(ws + off);
+
+  auto bf16_opts = x.options().dtype(at::kBFloat16);
+  at::Tensor x_h_t = at::from_blob(x_h_ptr, {rows, padded_in}, bf16_opts);
+
+  int64_t out_off = 0;
+  for (int m = 0; m < M_mem; ++m) {
+    const int64_t padded_out = trellises[m].size(1) * 16;
+    const int64_t logical_out = logical_outs[m];
+    const int64_t tiles_k = padded_in / 16;
+    const int64_t tiles_n = padded_out / 16;
+
+    const int64_t in_warps = rows * (padded_in / 128);
+    k31_prefill_h128_in_bf16_kernel<<<static_cast<unsigned int>((in_warps + 7) / 8), 256, 0, stream>>>(
+        reinterpret_cast<const __nv_bfloat16*>(x.data_ptr<at::BFloat16>()),
+        reinterpret_cast<const half*>(suhs[m].data_ptr<at::Half>()),
+        rows, logical_in, padded_in, x_h_ptr);
+
+    const int64_t n_chunk_cols = 8192;
+    for (int64_t n0 = 0; n0 < padded_out; n0 += n_chunk_cols) {
+      const int64_t cur_n = std::min<int64_t>(n_chunk_cols, padded_out - n0);
+      const int64_t nt_start = n0 / 16;
+      const int64_t nt_chunk = cur_n / 16;
+      const unsigned int d_grid = static_cast<unsigned int>(tiles_k * (nt_chunk / 8));
+
+      const auto* tptr = reinterpret_cast<const uint16_t*>(trellises[m].data_ptr<int16_t>());
+      switch (bits_x2s[m]) {
+        case 10: k31_dequant_trellis_kn_bf16_kernel<10><<<d_grid, 256, 0, stream>>>(tptr, tiles_k, tiles_n, nt_start, nt_chunk, w_c_ptr); break;
+        case 12: k31_dequant_trellis_kn_bf16_kernel<12><<<d_grid, 256, 0, stream>>>(tptr, tiles_k, tiles_n, nt_start, nt_chunk, w_c_ptr); break;
+        case 14: k31_dequant_trellis_kn_bf16_kernel<14><<<d_grid, 256, 0, stream>>>(tptr, tiles_k, tiles_n, nt_start, nt_chunk, w_c_ptr); break;
+        default: TORCH_CHECK(false, "dense_k31 prefill supports bits_x2 in {10, 12, 14}");
+      }
+
+      at::Tensor w_kn_t = at::from_blob(w_c_ptr, {padded_in, cur_n}, bf16_opts);
+      at::Tensor y_h_t  = at::from_blob(y_h_ptr, {rows, cur_n}, bf16_opts);
+      at::mm_out(y_h_t, x_h_t, w_kn_t);
+
+      const int64_t out_warps = rows * (cur_n / 128);
+      if (out.dtype() == at::kBFloat16) {
+        k31_prefill_h128_out_kernel<__nv_bfloat16><<<static_cast<unsigned int>((out_warps + 7) / 8), 256, 0, stream>>>(
+            y_h_ptr, reinterpret_cast<const half*>(svhs[m].data_ptr<at::Half>()),
+            rows, n0, cur_n, logical_out, total_logical_out, out_off,
+            reinterpret_cast<__nv_bfloat16*>(out.data_ptr<at::BFloat16>()));
+      } else {
+        k31_prefill_h128_out_kernel<float><<<static_cast<unsigned int>((out_warps + 7) / 8), 256, 0, stream>>>(
+            y_h_ptr, reinterpret_cast<const half*>(svhs[m].data_ptr<at::Half>()),
+            rows, n0, cur_n, logical_out, total_logical_out, out_off,
+            out.data_ptr<float>());
+      }
+    }
+    out_off += logical_out;
+  }
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
