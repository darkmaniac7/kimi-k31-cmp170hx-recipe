+@pytest.mark.cuda
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="needs CUDA")
+def test_cuda_glue_ops_smoke_and_graph():
+    gpu.require_library(glue_ops.ensure_glue_extension, "_k31_glue_C")
+    info = glue_ops.build_info()
+    assert info["abi_version"] == 1
+    assert info["api_version"] >= 1
+
+    device = torch.device("cuda:0")
+    torch.manual_seed(0)
+
+    p = torch.randn((4, 7168), dtype=torch.bfloat16, device=device)
+    d = torch.randn((4, 7168), dtype=torch.bfloat16, device=device)
+    d2 = torch.randn((4, 7168), dtype=torch.bfloat16, device=device)
+    b = torch.randn((4, 8, 7168), dtype=torch.bfloat16, device=device)
+    w = torch.ones((7168,), dtype=torch.bfloat16, device=device)
+    eager = glue.attn_res_rmsnorm(
+        p.clone(), d, d2, b.clone(), w, w, w, 4, -1, 1e-5, 1e-5
+    )
+
+    pg, bg = p.clone(), b.clone()
+    _ = glue.attn_res_rmsnorm(pg.clone(), d, d2, bg.clone(), w, w, w, 4, -1, 1e-5, 1e-5)
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        g_out = glue.attn_res_rmsnorm(pg, d, d2, bg, w, w, w, 4, -1, 1e-5, 1e-5)
+    pg.copy_(p)
+    bg.copy_(b)
+    g.replay()
+    torch.cuda.synchronize()
+    assert torch.equal(g_out, eager)
+
+    x16 = torch.randn((16, 7168), dtype=torch.bfloat16, device=device)
+    w_pair = torch.randn((224, 7168), dtype=torch.bfloat16, device=device) * 0.03
+    o0_1, o1_1 = glue.bf16_gemv_split2(x16[:1].contiguous(), w_pair, 128)
+    for M in (4, 8, 16):
+        o0_m, o1_m = glue.bf16_gemv_split2(x16[:M].contiguous(), w_pair, 128)
+        assert torch.equal(o0_m[0], o0_1[0])
+        assert torch.equal(o1_m[0], o1_1[0])
+
+    # Changed-input CUDA-Graph replay must match eager bit-for-bit.
+    p_new = torch.randn_like(p)
+    b_new = torch.randn_like(b)
+    eager_new = glue.attn_res_rmsnorm(
+        p_new.clone(), d, d2, b_new.clone(), w, w, w, 4, -1, 1e-5, 1e-5
+    )
+    pg.copy_(p_new)
+    bg.copy_(b_new)
+    g.replay()
+    torch.cuda.synchronize()
+    assert torch.equal(g_out, eager_new)
+
+    # M8 GPU check: all-NaN router row produces in-range ids [0..15], never 896.
+    nan_logits = torch.full((2, 896), float("nan"), dtype=torch.float32, device=device)
+    nan_logits[1] = torch.randn((896,), dtype=torch.float32, device=device)
+    nan_logits[1, 7] = float("nan")
+    bias_gpu = torch.zeros((896,), dtype=torch.float32, device=device)
+    rw, ri = glue.moe_topk_sigmoid(nan_logits, bias_gpu, 16, True, 1.0)
+    assert (ri >= 0).all().item() and (ri < 896).all().item()
+    assert ri[0].tolist() == list(range(16))
+
