+        prefill_len_np=np.array([8], dtype=np.int32),
+        num_scheduled_tokens=np.array([1 + k], dtype=np.int32),
+        is_prefilling_np=np.array([False], dtype=np.bool_),
+        max_seq_len_np=None,
+        idx_mapping=torch.tensor([req_idx], dtype=torch.int32),
+        idx_mapping_np=np.array([req_idx], dtype=np.int32),
+    )
