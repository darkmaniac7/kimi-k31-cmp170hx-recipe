+
+template <int RANK, bool IS_SHM, bool HAS_RES>
+void launch_allreduce_impl(
+    P2PContext* ctx,
+    const uint4* x_ptr,
+    const uint4* res_ptr,
+    uint4* sum_ptr,
+    uint4* out_res_ptr,
+    int64_t total_vecs,
+    bool write_sum,
+    cudaStream_t stream) {
+  const int64_t max_chunk_vecs = static_cast<int64_t>(ctx->slot_bytes / 16ull);
+  FlagLine* my_ar_flags = ctx->active_my_flags + kArFlagOffset;
+  FlagLine* peer_ar_flags = ctx->active_peer_flags + kArFlagOffset;
+  if (total_vecs <= max_chunk_vecs &&
+      total_vecs <= static_cast<int64_t>(kFixedGrid * kArFastMaxVecsPerCta)) {
+    int active_ctas = static_cast<int>(
+        (total_vecs + kArTargetVecsPerCta - 1) / kArTargetVecsPerCta);
+    const int total_lines = static_cast<int>((total_vecs + 7) >> 3);
+    if (active_ctas > total_lines) active_ctas = total_lines;
+    if (active_ctas < 1) active_ctas = 1;
+    if (active_ctas > kFixedGrid) active_ctas = kFixedGrid;
+    p2p_allreduce_residual_fast_kernel<RANK, IS_SHM, HAS_RES><<<active_ctas, kBlockThreads, 0, stream>>>(
+        x_ptr, res_ptr, sum_ptr, out_res_ptr,
+        ctx->active_my_inbox, my_ar_flags,
+        ctx->active_peer_inbox, peer_ar_flags,
+        ctx->dev_ctrl, ctx->host_ctrl_dev,
+        ctx->slot_bytes, ctx->generation,
+        static_cast<int>(total_vecs), active_ctas, write_sum);
+  } else {
+    p2p_allreduce_residual_stream_kernel<RANK, IS_SHM, HAS_RES><<<kFixedGrid, kBlockThreads, 0, stream>>>(
+        x_ptr, res_ptr, sum_ptr, out_res_ptr,
+        ctx->active_my_inbox, my_ar_flags,
+        ctx->active_peer_inbox, peer_ar_flags,
+        ctx->dev_ctrl, ctx->host_ctrl_dev,
+        ctx->slot_bytes, ctx->generation,
+        total_vecs, max_chunk_vecs, write_sum);
+  }
+}
+
+template <int RANK, bool IS_SHM, bool HAS_RES, bool WEIGHT_FP32>
+void launch_moe_dual_impl(
+    P2PContext* ctx,
+    const uint4* routed_ptr,
+    const uint4* shared_ptr,
+    const void* w_ptr,
+    const uint4* res_ptr,
+    uint4* out_r_ptr,
+    uint4* out_s_ptr,
+    uint4* out_sr_ptr,
+    int M,
+    int r_vecs,
+    int s_vecs,
+    float eps,
+    bool write_shared_sum,
+    cudaStream_t stream) {
+  const uint64_t one_row_aligned_bytes =
+      static_cast<uint64_t>(((r_vecs + 7) & ~7) + s_vecs) * 16ull;
+  TORCH_CHECK(one_row_aligned_bytes <= ctx->slot_bytes,
+              "k31_p2p: single row bytes (", one_row_aligned_bytes,
+              ") exceeds slot_bytes (", ctx->slot_bytes, ")");
+  const uint64_t fast_total_bytes =
+      static_cast<uint64_t>(((M * r_vecs + 7) & ~7) + M * s_vecs) * 16ull;
+  FlagLine* my_ar_flags = ctx->active_my_flags + kArFlagOffset;
+  FlagLine* peer_ar_flags = ctx->active_peer_flags + kArFlagOffset;
+  if (M <= 32 && r_vecs <= 2 * kBlockThreads && fast_total_bytes <= ctx->slot_bytes) {
+    int routed_ctas = (M * r_vecs + kMoeRoutedTargetVecsPerCta - 1) / kMoeRoutedTargetVecsPerCta;
+    if (routed_ctas > M) routed_ctas = M;
+    if (routed_ctas < 1) routed_ctas = 1;
+    if (routed_ctas > kMoeMaxRoutedCtas) routed_ctas = kMoeMaxRoutedCtas;
+
+    const int max_shared_ctas = kFixedGrid - routed_ctas;
+    int shared_ctas = (M * s_vecs + kArTargetVecsPerCta - 1) / kArTargetVecsPerCta;
+    const int shared_lines = (M * s_vecs + 7) >> 3;
+    if (shared_ctas > shared_lines) shared_ctas = shared_lines;
+    if (shared_ctas < 1) shared_ctas = 1;
+    if (shared_ctas > max_shared_ctas) shared_ctas = max_shared_ctas;
+
+    const int total_ctas = routed_ctas + shared_ctas;
+    p2p_moe_dual_fast_kernel<RANK, IS_SHM, HAS_RES, WEIGHT_FP32><<<total_ctas, kBlockThreads, 0, stream>>>(
+        routed_ptr, shared_ptr, w_ptr, res_ptr, out_r_ptr, out_s_ptr, out_sr_ptr,
+        ctx->active_my_inbox, my_ar_flags,
+        ctx->active_peer_inbox, peer_ar_flags,
+        ctx->dev_ctrl, ctx->host_ctrl_dev,
+        ctx->slot_bytes, ctx->generation,
+        M, r_vecs, s_vecs, routed_ctas, shared_ctas, eps, write_shared_sum);
+  } else {
+    const uint64_t row_bytes = static_cast<uint64_t>(r_vecs + s_vecs) * 16ull;
+    int max_chunk_rows = static_cast<int>((ctx->slot_bytes - 112ull) / row_bytes);
+    if (max_chunk_rows < 1) max_chunk_rows = 1;
+    if (max_chunk_rows > M) max_chunk_rows = M;
+    p2p_moe_dual_stream_kernel<RANK, IS_SHM, HAS_RES, WEIGHT_FP32><<<kFixedGrid, kBlockThreads, 0, stream>>>(
+        routed_ptr, shared_ptr, w_ptr, res_ptr, out_r_ptr, out_s_ptr, out_sr_ptr,
+        ctx->active_my_inbox, my_ar_flags,
+        ctx->active_peer_inbox, peer_ar_flags,
+        ctx->dev_ctrl, ctx->host_ctrl_dev,
+        ctx->slot_bytes, ctx->generation,
+        M, r_vecs, s_vecs, max_chunk_rows, eps, write_shared_sum);
+  }
+}
+
+void preload_one(const void* fn) {
+  cudaFuncAttributes attr = {};
+  if (cudaFuncGetAttributes(&attr, fn) != cudaSuccess) {
+    cudaGetLastError();
+  }
+}
+
+template <int RANK, bool IS_SHM, bool HAS_RES>
+void preload_ar_combo() {
+  preload_one(reinterpret_cast<const void*>(p2p_allreduce_residual_fast_kernel<RANK, IS_SHM, HAS_RES>));
+  preload_one(reinterpret_cast<const void*>(p2p_allreduce_residual_stream_kernel<RANK, IS_SHM, HAS_RES>));
+}
+
+template <int RANK, bool IS_SHM, bool HAS_RES, bool WEIGHT_FP32>
+void preload_moe_combo() {
+  preload_one(reinterpret_cast<const void*>(p2p_moe_dual_fast_kernel<RANK, IS_SHM, HAS_RES, WEIGHT_FP32>));
+  preload_one(reinterpret_cast<const void*>(p2p_moe_dual_stream_kernel<RANK, IS_SHM, HAS_RES, WEIGHT_FP32>));
+}
+
+void preload_kernels_for_device(int dev) {
+  if (dev < 0 || dev >= 64) return;
+  if (g_device_preloaded[dev].load(std::memory_order_acquire)) return;
+  preload_ar_combo<0, false, false>(); preload_ar_combo<0, false, true>();
+  preload_ar_combo<0, true,  false>(); preload_ar_combo<0, true,  true>();
+  preload_ar_combo<1, false, false>(); preload_ar_combo<1, false, true>();
+  preload_ar_combo<1, true,  false>(); preload_ar_combo<1, true,  true>();
+
+  preload_moe_combo<0, false, false, false>(); preload_moe_combo<0, false, false, true>();
+  preload_moe_combo<0, false, true,  false>(); preload_moe_combo<0, false, true,  true>();
+  preload_moe_combo<0, true,  false, false>(); preload_moe_combo<0, true,  false, true>();
+  preload_moe_combo<0, true,  true,  false>(); preload_moe_combo<0, true,  true,  true>();
+  preload_moe_combo<1, false, false, false>(); preload_moe_combo<1, false, false, true>();
+  preload_moe_combo<1, false, true,  false>(); preload_moe_combo<1, false, true,  true>();
+  preload_moe_combo<1, true,  false, false>(); preload_moe_combo<1, true,  false, true>();
+  preload_moe_combo<1, true,  true,  false>(); preload_moe_combo<1, true,  true,  true>();
+
+  preload_one(reinterpret_cast<const void*>(p2p_pp_send_kernel<false>));
+  preload_one(reinterpret_cast<const void*>(p2p_pp_send_kernel<true>));
+  preload_one(reinterpret_cast<const void*>(p2p_pp_recv_kernel<false>));
+  preload_one(reinterpret_cast<const void*>(p2p_pp_recv_kernel<true>));
+  preload_one(reinterpret_cast<const void*>(p2p_pp_drain_kernel<false>));
+  preload_one(reinterpret_cast<const void*>(p2p_pp_drain_kernel<true>));
+
+  g_device_preloaded[dev].store(true, std::memory_order_release);
+}
+
+void mirror_ctrl_to_device(P2PContext* ctx, uint32_t* dev_dst, const uint32_t* pinned_src) {
+  if (!ctx || !ctx->dev_ctrl || !dev_dst || !pinned_src) return;
+  std::lock_guard<std::mutex> lk(ctx->ctrl_mutex);
+  int prev_dev = -1;
+  bool restore = false;
+  if (cudaGetDevice(&prev_dev) == cudaSuccess) {
+    if (prev_dev != ctx->device_ordinal) {
+      if (cudaSetDevice(ctx->device_ordinal) != cudaSuccess) {
+        cudaGetLastError();
+        return;
+      }
+      restore = true;
+    }
+  } else {
+    cudaGetLastError();
+    if (cudaSetDevice(ctx->device_ordinal) != cudaSuccess) {
+      cudaGetLastError();
+      return;
+    }
+  }
+  cudaError_t err;
+  if (ctx->ctrl_stream != nullptr) {
+    err = cudaMemcpyAsync(dev_dst, pinned_src, sizeof(uint32_t),
+                          cudaMemcpyHostToDevice, ctx->ctrl_stream);
+    if (err == cudaSuccess) {
+      err = cudaStreamSynchronize(ctx->ctrl_stream);
+    }
+  } else {
+    err = cudaMemcpy(dev_dst, pinned_src, sizeof(uint32_t), cudaMemcpyHostToDevice);
+  }
+  if (err != cudaSuccess) {
+    cudaGetLastError();
+  }
+  if (restore && prev_dev >= 0) {
+    cudaSetDevice(prev_dev);
+  }
+}
+
+void close_peer_imports_unlocked(P2PContext* ctx) {
+  if (!ctx || ctx->peer_imports_closed) return;
+  ctx->peer_imports_closed = true;
+  ctx->connected = false;
+  if (ctx->host_ctrl) {
+    __atomic_store_n(&ctx->host_ctrl->abort_flag, 1u, __ATOMIC_RELEASE);
+    __atomic_store_n(&ctx->host_ctrl->generation, 0u, __ATOMIC_RELEASE);
+    if (ctx->dev_ctrl) {
+      mirror_ctrl_to_device(ctx, &ctx->dev_ctrl->dev_abort_flag, &ctx->host_ctrl->abort_flag);
+      mirror_ctrl_to_device(ctx, &ctx->dev_ctrl->dev_generation, &ctx->host_ctrl->generation);
+    }
+  }
+  DeviceGuard guard(ctx->device_ordinal);
+  if (ctx->transport == TransportMode::P2P_IPC) {
+    if (ctx->ipc_peer_inbox) {
+      cudaIpcCloseMemHandle(ctx->ipc_peer_inbox);
+      ctx->ipc_peer_inbox = nullptr;
+    }
+    if (ctx->ipc_peer_flags) {
+      cudaIpcCloseMemHandle(ctx->ipc_peer_flags);
+      ctx->ipc_peer_flags = nullptr;
+    }
+  } else if (ctx->transport == TransportMode::SHM_ZERO_COPY) {
+    if (ctx->shm_registered && ctx->shm_host_ptr) {
+      cudaHostUnregister(ctx->shm_host_ptr);
+      ctx->shm_registered = false;
+    }
+    if (ctx->shm_host_ptr && ctx->shm_host_ptr != MAP_FAILED) {
+      munmap(ctx->shm_host_ptr, ctx->shm_total_bytes);
+      ctx->shm_host_ptr = nullptr;
+    }
+    if (ctx->shm_fd >= 0) {
+      close(ctx->shm_fd);
+      ctx->shm_fd = -1;
+    }
+    if (!ctx->active_shm_name.empty()) {
+      shm_unlink(ctx->active_shm_name.c_str());
+    }
+  }
+  ctx->active_peer_inbox = nullptr;
+  ctx->active_peer_flags = nullptr;
+  cudaGetLastError();
+}
+
+void cleanup_context(P2PContext* ctx) {
+  if (!ctx) return;
+  close_peer_imports_unlocked(ctx);
+  DeviceGuard guard(ctx->device_ordinal);
+  if (ctx->ctrl_stream) { cudaStreamDestroy(ctx->ctrl_stream); ctx->ctrl_stream = nullptr; }
+  if (ctx->dev_inbox) { cudaFree(ctx->dev_inbox); ctx->dev_inbox = nullptr; }
+  if (ctx->dev_flags) { cudaFree(ctx->dev_flags); ctx->dev_flags = nullptr; }
+  if (ctx->dev_ctrl) { cudaFree(ctx->dev_ctrl); ctx->dev_ctrl = nullptr; }
+  if (ctx->host_ctrl) { cudaFreeHost(ctx->host_ctrl); ctx->host_ctrl = nullptr; ctx->host_ctrl_dev = nullptr; }
+  cudaGetLastError();
+}
