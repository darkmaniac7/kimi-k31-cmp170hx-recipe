+
+    # Verify real Chunk-B prepare + commit mutates flat-tuple KDA caches.
+    bt = torch.arange(1, 9, dtype=torch.int32)  # 2 * (3 + 1) = 8 slots
+    conv_flat[1].fill_(5.0)
