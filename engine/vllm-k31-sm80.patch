+enum class SaveDtype {
+    BF16,
+    F16,
+    F32,
+};
+
+static const char * dtype_st_name(SaveDtype dt) {
+    switch (dt) {
+        case SaveDtype::BF16: return "BF16";
+        case SaveDtype::F16:  return "F16";
+        case SaveDtype::F32:  return "F32";
+    }
+    return "BF16";
+}
+
+static const char * dtype_cli_name(SaveDtype dt) {
+    switch (dt) {
+        case SaveDtype::BF16: return "bf16";
+        case SaveDtype::F16:  return "fp16";
+        case SaveDtype::F32:  return "fp32";
+    }
+    return "bf16";
+}
+
+static size_t dtype_elem_bytes(SaveDtype dt) {
+    return (dt == SaveDtype::F32) ? 4 : 2;
+}
+
+// IEEE-754 round-to-nearest-even FP32 -> BF16
+static inline uint16_t fp32_to_bf16(float x) {
+    uint32_t u = 0;
+    std::memcpy(&u, &x, sizeof(u));
+    if ((u & 0x7fffffffu) > 0x7f800000u) {
+        return static_cast<uint16_t>((u >> 16) | 0x0040u); // quiet NaN
+    }
+    uint32_t lsb = (u >> 16) & 1u;
+    uint32_t rounding_bias = 0x7fffu + lsb;
+    return static_cast<uint16_t>((u + rounding_bias) >> 16);
+}
+
+// IEEE-754 round-to-nearest-even FP32 -> FP16
+static inline uint16_t fp32_to_fp16(float x) {
+    uint32_t u = 0;
+    std::memcpy(&u, &x, sizeof(u));
+    uint32_t sign = (u >> 16) & 0x8000u;
+    uint32_t exp  = (u >> 23) & 0xffu;
+    uint32_t mant = u & 0x7fffffu;
+
+    if (exp == 0xffu) {
+        if (mant != 0) {
+            return static_cast<uint16_t>(sign | 0x7e00u | (mant >> 13));
+        }
+        return static_cast<uint16_t>(sign | 0x7c00u);
+    }
+    int32_t new_exp = static_cast<int32_t>(exp) - 127 + 15;
+    if (new_exp >= 31) {
+        return static_cast<uint16_t>(sign | 0x7bffu);
+    }
+    if (new_exp <= 0) {
+        if (new_exp < -10) {
+            return static_cast<uint16_t>(sign);
+        }
+        mant |= 0x800000u;
+        uint32_t shift = static_cast<uint32_t>(14 - new_exp);
+        uint32_t half  = 1u << (shift - 1);
+        uint32_t rem   = mant & ((1u << shift) - 1u);
+        uint32_t res   = mant >> shift;
+        if (rem > half || (rem == half && (res & 1u))) {
+            res += 1u;
+        }
+        return static_cast<uint16_t>(sign | res);
+    }
+    uint32_t half_mant = mant >> 13;
+    uint32_t rem       = mant & 0x1fffu;
+    if (rem > 0x1000u || (rem == 0x1000u && (half_mant & 1u))) {
+        half_mant += 1u;
+        if (half_mant == 0x400u) {
+            half_mant = 0;
+            new_exp += 1;
+            if (new_exp >= 31) {
+                return static_cast<uint16_t>(sign | 0x7bffu);
+            }
+        }
+    }
+    return static_cast<uint16_t>(sign | (static_cast<uint32_t>(new_exp) << 10) | half_mant);
+}
+
+// Compact FIPS 180-4 SHA-256 for model head fingerprinting (zero extra link deps)
+class Sha256 {
+public:
+    Sha256() { reset(); }
+
+    void reset() {
+        h_[0] = 0x6a09e667u; h_[1] = 0xbb67ae85u; h_[2] = 0x3c6ef372u; h_[3] = 0xa54ff53au;
+        h_[4] = 0x510e527fu; h_[5] = 0x9b05688cu; h_[6] = 0x1f83d9abu; h_[7] = 0x5be0cd19u;
+        total_bits_ = 0;
+        buf_len_ = 0;
+    }
+
+    void update(const uint8_t * data, size_t len) {
+        total_bits_ += static_cast<uint64_t>(len) * 8u;
+        size_t i = 0;
+        if (buf_len_ > 0) {
+            size_t take = std::min(64 - buf_len_, len);
+            std::memcpy(buf_ + buf_len_, data, take);
+            buf_len_ += take;
+            i += take;
+            if (buf_len_ == 64) {
+                compress(buf_);
+                buf_len_ = 0;
+            }
+        }
+        while (i + 64 <= len) {
+            compress(data + i);
+            i += 64;
+        }
+        if (i < len) {
+            buf_len_ = len - i;
+            std::memcpy(buf_, data + i, buf_len_);
+        }
+    }
+
+    std::string hex_digest() {
+        uint8_t pad[64] = {0};
+        pad[0] = 0x80u;
+        size_t pad_len = (buf_len_ < 56) ? (56 - buf_len_) : (120 - buf_len_);
+        uint64_t bits_be = total_bits_;
+        update(pad, pad_len);
+        uint8_t len_bytes[8];
+        for (int k = 0; k < 8; ++k) {
+            len_bytes[k] = static_cast<uint8_t>((bits_be >> (56 - 8 * k)) & 0xffu);
+        }
+        update(len_bytes, 8);
+        std::ostringstream oss;
+        oss << std::hex << std::setfill('0');
+        for (uint32_t v : h_) {
+            oss << std::setw(8) << v;
+        }
+        return oss.str();
+    }
+
+private:
+    static inline uint32_t rotr(uint32_t x, uint32_t n) { return (x >> n) | (x << (32 - n)); }
+
+    void compress(const uint8_t blk[64]) {
+        static constexpr uint32_t K[64] = {
+            0x428a2f98u,0x71374491u,0xb5c0fbcfu,0xe9b5dba5u,0x3956c25bu,0x59f111f1u,0x923f82a4u,0xab1c5ed5u,
+            0xd807aa98u,0x12835b01u,0x243185beu,0x550c7dc3u,0x72be5d74u,0x80deb1feu,0x9bdc06a7u,0xc19bf174u,
+            0xe49b69c1u,0xefbe4786u,0x0fc19dc6u,0x240ca1ccu,0x2de92c6fu,0x4a7484aau,0x5cb0a9dcu,0x76f988dau,
+            0x983e5152u,0xa831c66du,0xb00327c8u,0xbf597fc7u,0xc6e00bf3u,0xd5a79147u,0x06ca6351u,0x14292967u,
+            0x27b70a85u,0x2e1b2138u,0x4d2c6dfcu,0x53380d13u,0x650a7354u,0x766a0abbu,0x81c2c92eu,0x92722c85u,
+            0xa2bfe8a1u,0xa81a664bu,0xc24b8b70u,0xc76c51a3u,0xd192e819u,0xd6990624u,0xf40e3585u,0x106aa070u,
+            0x19a4c116u,0x1e376c08u,0x2748774cu,0x34b0bcb5u,0x391c0cb3u,0x4ed8aa4au,0x5b9cca4fu,0x682e6ff3u,
+            0x748f82eeu,0x78a5636fu,0x84c87814u,0x8cc70208u,0x90befffau,0xa4506cebu,0xbef9a3f7u,0xc67178f2u
+        };
+        uint32_t w[64];
+        for (int i = 0; i < 16; ++i) {
+            w[i] = (static_cast<uint32_t>(blk[4 * i]) << 24) |
+                   (static_cast<uint32_t>(blk[4 * i + 1]) << 16) |
+                   (static_cast<uint32_t>(blk[4 * i + 2]) << 8) |
+                   static_cast<uint32_t>(blk[4 * i + 3]);
+        }
+        for (int i = 16; i < 64; ++i) {
+            uint32_t s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
+            uint32_t s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
+            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+        }
+        uint32_t a = h_[0], b = h_[1], c = h_[2], d = h_[3];
+        uint32_t e = h_[4], f = h_[5], g = h_[6], h = h_[7];
+        for (int i = 0; i < 64; ++i) {
+            uint32_t S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
+            uint32_t ch = (e & f) ^ ((~e) & g);
+            uint32_t t1 = h + S1 + ch + K[i] + w[i];
+            uint32_t S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
+            uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
+            uint32_t t2 = S0 + maj;
+            h = g; g = f; f = e; e = d + t1;
+            d = c; c = b; b = a; a = t1 + t2;
+        }
+        h_[0] += a; h_[1] += b; h_[2] += c; h_[3] += d;
+        h_[4] += e; h_[5] += f; h_[6] += g; h_[7] += h;
+    }
+
+    uint32_t h_[8];
+    uint64_t total_bits_;
+    uint8_t  buf_[64];
+    size_t   buf_len_;
+};
+
+static std::string hash_file_head_sha256(const std::string & path, size_t max_bytes = 4u * 1024u * 1024u) {
+    std::ifstream ifs(path, std::ios::binary);
+    if (!ifs) {
+        return "";
+    }
+    Sha256 sha;
+    std::vector<uint8_t> buf(65536);
+    size_t remaining = max_bytes;
+    while (remaining > 0 && ifs) {
+        size_t chunk = std::min(buf.size(), remaining);
+        ifs.read(reinterpret_cast<char *>(buf.data()), static_cast<std::streamsize>(chunk));
+        std::streamsize got = ifs.gcount();
+        if (got <= 0) {
+            break;
+        }
+        sha.update(buf.data(), static_cast<size_t>(got));
+        remaining -= static_cast<size_t>(got);
+    }
+    return sha.hex_digest();
+}
+
+static std::string json_escape(const std::string & s) {
+    std::string out;
+    out.reserve(s.size() + 8);
+    out.push_back('"');
+    for (unsigned char c : s) {
+        switch (c) {
+            case '"':  out += "\\\""; break;
+            case '\\': out += "\\\\"; break;
+            case '\b': out += "\\b";  break;
+            case '\f': out += "\\f";  break;
+            case '\n': out += "\\n";  break;
+            case '\r': out += "\\r";  break;
+            case '\t': out += "\\t";  break;
+            default:
+                if (c < 0x20) {
+                    char buf[8];
+                    std::snprintf(buf, sizeof(buf), "\\u%04x", c);
+                    out += buf;
+                } else {
+                    out.push_back(static_cast<char>(c));
+                }
+        }
+    }
+    out.push_back('"');
+    return out;
+}
+
+// Minimal recursive-descent JSON reader for prompt suite files (zero external deps)
+struct JsonValue {
+    enum Type { Null, Bool, Number, String, Array, Object } type = Null;
+    bool bval = false;
+    double nval = 0.0;
+    std::string sval;
+    std::vector<JsonValue> aval;
+    std::map<std::string, JsonValue> oval;
+
+    bool has(const std::string & k) const {
+        return type == Object && oval.find(k) != oval.end();
+    }
+    const JsonValue & at(const std::string & k) const { return oval.at(k); }
+};
+
+class JsonParser {
+public:
+    explicit JsonParser(std::string src) : s_(std::move(src)), pos_(0) {}
+
+    JsonValue parse() {
+        skip_ws();
+        JsonValue v = parse_value();
+        skip_ws();
+        if (pos_ != s_.size()) {
+            throw std::runtime_error("Unexpected trailing characters in JSON");
+        }
+        return v;
+    }
+
+private:
+    void skip_ws() {
+        while (pos_ < s_.size() && std::isspace(static_cast<unsigned char>(s_[pos_]))) {
+            ++pos_;
+        }
+    }
+
+    char peek() const {
+        if (pos_ >= s_.size()) {
+            throw std::runtime_error("Unexpected EOF in JSON");
+        }
+        return s_[pos_];
+    }
+
+    JsonValue parse_value() {
+        skip_ws();
+        char c = peek();
+        if (c == '{') return parse_object();
+        if (c == '[') return parse_array();
+        if (c == '"') return parse_string_val();
+        if (c == 't' || c == 'f') return parse_bool();
+        if (c == 'n') return parse_null();
+        if (c == '-' || std::isdigit(static_cast<unsigned char>(c))) return parse_number();
+        throw std::runtime_error(std::string("Unexpected JSON token: ") + c);
+    }
+
+    JsonValue parse_null() {
+        if (s_.compare(pos_, 4, "null") != 0) throw std::runtime_error("Invalid null");
+        pos_ += 4;
+        return JsonValue{};
+    }
+
+    JsonValue parse_bool() {
+        JsonValue v;
+        v.type = JsonValue::Bool;
+        if (s_.compare(pos_, 4, "true") == 0) {
+            v.bval = true;
+            pos_ += 4;
+            return v;
+        }
+        if (s_.compare(pos_, 5, "false") == 0) {
+            v.bval = false;
+            pos_ += 5;
+            return v;
+        }
+        throw std::runtime_error("Invalid boolean");
+    }
+
+    JsonValue parse_number() {
+        size_t start = pos_;
+        if (s_[pos_] == '-') ++pos_;
+        while (pos_ < s_.size() && (std::isdigit(static_cast<unsigned char>(s_[pos_])) ||
+                                    s_[pos_] == '.' || s_[pos_] == 'e' || s_[pos_] == 'E' ||
+                                    s_[pos_] == '+' || s_[pos_] == '-')) {
+            ++pos_;
+        }
+        JsonValue v;
+        v.type = JsonValue::Number;
+        v.nval = std::stod(s_.substr(start, pos_ - start));
+        return v;
+    }
+
+    std::string parse_string() {
+        if (peek() != '"') throw std::runtime_error("Expected double quote");
+        ++pos_;
+        std::string out;
+        while (pos_ < s_.size()) {
+            char c = s_[pos_++];
+            if (c == '"') return out;
+            if (c == '\\') {
+                if (pos_ >= s_.size()) throw std::runtime_error("Unterminated escape");
+                char e = s_[pos_++];
+                switch (e) {
+                    case '"':  out.push_back('"');  break;
+                    case '\\': out.push_back('\\'); break;
+                    case '/':  out.push_back('/');  break;
+                    case 'b':  out.push_back('\b'); break;
+                    case 'f':  out.push_back('\f'); break;
+                    case 'n':  out.push_back('\n'); break;
+                    case 'r':  out.push_back('\r'); break;
+                    case 't':  out.push_back('\t'); break;
+                    case 'u': {
+                        if (pos_ + 4 > s_.size()) throw std::runtime_error("Short unicode escape");
+                        unsigned int cp = std::stoul(s_.substr(pos_, 4), nullptr, 16);
+                        pos_ += 4;
+                        if (cp < 0x80) {
+                            out.push_back(static_cast<char>(cp));
+                        } else if (cp < 0x800) {
+                            out.push_back(static_cast<char>(0xc0 | (cp >> 6)));
+                            out.push_back(static_cast<char>(0x80 | (cp & 0x3f)));
+                        } else {
+                            out.push_back(static_cast<char>(0xe0 | (cp >> 12)));
+                            out.push_back(static_cast<char>(0x80 | ((cp >> 6) & 0x3f)));
+                            out.push_back(static_cast<char>(0x80 | (cp & 0x3f)));
+                        }
+                        break;
+                    }
+                    default: throw std::runtime_error("Unsupported JSON escape");
+                }
+            } else {
+                out.push_back(c);
+            }
+        }
+        throw std::runtime_error("Unterminated JSON string");
+    }
+
+    JsonValue parse_string_val() {
+        JsonValue v;
+        v.type = JsonValue::String;
+        v.sval = parse_string();
+        return v;
+    }
+
+    JsonValue parse_array() {
+        ++pos_;
+        JsonValue v;
+        v.type = JsonValue::Array;
+        skip_ws();
+        if (peek() == ']') {
+            ++pos_;
+            return v;
+        }
+        while (true) {
+            v.aval.push_back(parse_value());
+            skip_ws();
+            char c = peek();
+            if (c == ']') {
+                ++pos_;
+                return v;
+            }
+            if (c != ',') throw std::runtime_error("Expected comma or closing bracket in array");
+            ++pos_;
+        }
+    }
+
+    JsonValue parse_object() {
+        ++pos_;
+        JsonValue v;
+        v.type = JsonValue::Object;
+        skip_ws();
+        if (peek() == '}') {
+            ++pos_;
+            return v;
+        }
+        while (true) {
+            skip_ws();
+            std::string key = parse_string();
+            skip_ws();
+            if (peek() != ':') throw std::runtime_error("Expected colon in object");
+            ++pos_;
+            v.oval[std::move(key)] = parse_value();
+            skip_ws();
+            char c = peek();
+            if (c == '}') {
+                ++pos_;
+                return v;
+            }
+            if (c != ',') throw std::runtime_error("Expected comma or closing brace in object");
+            ++pos_;
+        }
+    }
+
+    std::string s_;
+    size_t pos_;
+};
+
+struct PromptSpec {
+    std::string id;
+    std::string category;
+    std::string prompt_text;
+    bool add_bos = true;
+    std::vector<llama_token> token_ids;
+    int32_t recommended_n_predict = -1;
+};
+
+static std::vector<PromptSpec> load_prompts_json(const std::string & path) {
+    std::ifstream ifs(path);
+    if (!ifs) {
+        throw std::runtime_error("Cannot open prompts file: " + path);
+    }
+    std::ostringstream oss;
+    oss << ifs.rdbuf();
+    JsonParser parser(oss.str());
+    JsonValue root = parser.parse();
+
+    const JsonValue * arr = nullptr;
+    if (root.type == JsonValue::Array) {
+        arr = &root;
+    } else if (root.type == JsonValue::Object && root.has("prompts") && root.at("prompts").type == JsonValue::Array) {
+        arr = &root.at("prompts");
+    } else {
+        throw std::runtime_error("Prompts JSON must be an array or an object with a prompts array");
+    }
+
+    std::vector<PromptSpec> out;
+    for (size_t i = 0; i < arr->aval.size(); ++i) {
+        const JsonValue & item = arr->aval[i];
+        if (item.type != JsonValue::Object) {
+            throw std::runtime_error("Prompt entry is not an object");
+        }
+        PromptSpec p;
+        p.id = item.has("id") ? item.at("id").sval : ("prompt_" + std::to_string(i));
+        p.category = item.has("category") ? item.at("category").sval : "unknown";
+        if (item.has("prompt_text")) {
+            p.prompt_text = item.at("prompt_text").sval;
+        } else if (item.has("prompt")) {
+            p.prompt_text = item.at("prompt").sval;
+        }
+        if (item.has("add_bos") && item.at("add_bos").type == JsonValue::Bool) {
+            p.add_bos = item.at("add_bos").bval;
+        }
+        if (item.has("token_ids") && item.at("token_ids").type == JsonValue::Array) {
+            for (const auto & tv : item.at("token_ids").aval) {
+                p.token_ids.push_back(static_cast<llama_token>(std::llround(tv.nval)));
+            }
+        }
+        if (item.has("recommended_n_predict") && item.at("recommended_n_predict").type == JsonValue::Number) {
+            p.recommended_n_predict = static_cast<int32_t>(std::llround(item.at("recommended_n_predict").nval));
+        }
+        out.push_back(std::move(p));
+    }
+    return out;
+}
+
+struct TensorRecord {
+    std::string dtype; // "BF16", "F16", "F32", "I32", "I64"
+    std::vector<int64_t> shape;
+    std::vector<uint8_t> bytes;
+    int64_t nan_count = 0;
+    int64_t inf_count = 0;
+    double  sum_sq    = 0.0;
+    double  max_abs   = 0.0;
+};
+
+static void write_safetensors_atomic(
+        const fs::path & dst_path,
+        const std::map<std::string, TensorRecord> & tensors,
+        const std::map<std::string, std::string> & metadata) {
+    std::ostringstream hdr;
+    hdr << "{";
+    bool first = true;
+    if (!metadata.empty()) {
+        hdr << "\"__metadata__\":{";
+        bool mf = true;
+        for (const auto & kv : metadata) {
+            if (!mf) hdr << ",";
+            mf = false;
+            hdr << json_escape(kv.first) << ":" << json_escape(kv.second);
+        }
+        hdr << "}";
+        first = false;
+    }
+
+    uint64_t offset = 0;
+    for (const auto & kv : tensors) {
+        const std::string & name = kv.first;
+        const TensorRecord & rec = kv.second;
+        if (!first) hdr << ",";
+        first = false;
+        uint64_t end = offset + rec.bytes.size();
+        hdr << json_escape(name) << ":{\"dtype\":" << json_escape(rec.dtype) << ",\"shape\":[";
+        for (size_t d = 0; d < rec.shape.size(); ++d) {
+            if (d > 0) hdr << ",";
+            hdr << rec.shape[d];
+        }
+        hdr << "],\"data_offsets\":[" << offset << "," << end << "]}";
+        offset = end;
+    }
+    hdr << "}";
+
+    std::string hdr_str = hdr.str();
+    while ((hdr_str.size() % 8) != 0) {
+        hdr_str.push_back(' ');
+    }
+    uint64_t hdr_len = static_cast<uint64_t>(hdr_str.size());
+
+    fs::path tmp_path = dst_path;
+    tmp_path += ".tmp";
+    {
+        std::ofstream ofs(tmp_path, std::ios::binary | std::ios::trunc);
+        if (!ofs) {
+            throw std::runtime_error("Cannot open output safetensors temp file: " + tmp_path.string());
+        }
+        ofs.write(reinterpret_cast<const char *>(&hdr_len), sizeof(hdr_len));
+        ofs.write(hdr_str.data(), static_cast<std::streamsize>(hdr_str.size()));
+        for (const auto & kv : tensors) {
+            if (!kv.second.bytes.empty()) {
+                ofs.write(reinterpret_cast<const char *>(kv.second.bytes.data()),
+                          static_cast<std::streamsize>(kv.second.bytes.size()));
+            }
+        }
+        ofs.flush();
+        if (!ofs) {
+            throw std::runtime_error("Failed writing safetensors file: " + tmp_path.string());
+        }
+    }
+    fs::rename(tmp_path, dst_path);
+}
