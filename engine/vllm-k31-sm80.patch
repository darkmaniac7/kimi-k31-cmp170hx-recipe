+    nw = torch.randn((D,), dtype=torch.float32) * 0.1 + 1.0
+    rs = torch.randn((slots, H, D, D), dtype=torch.float32) * 0.05
+
+    ssi = torch.zeros((B, W), dtype=torch.int32)
+    ssi[0] = torch.arange(1, 1 + W, dtype=torch.int32)
+    ssi[1] = torch.arange(1 + W, 1 + 2 * W, dtype=torch.int32)
+    qsl = torch.tensor([0, W, 2 * W], dtype=torch.int32)
+    # seq 0: num_accepted=1 (init_tok=0, aliasing out_slot[0]==init_state_slot),
+    # seq 1: num_accepted=min(W, 8) (init_tok up to 7)
+    acc = torch.tensor([1, min(W, 8)], dtype=torch.int32)
+
+    o_tri, cs_tri, rs_tri = ref_triton_spec_verify(
+        mixed, cs, cw, cb, rg, rb, a_log, dt_bias, g2, nw, rs, ssi, qsl, acc, -5.0, 1e-5
