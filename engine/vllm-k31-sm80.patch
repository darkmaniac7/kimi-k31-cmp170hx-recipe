+@pytest.mark.parametrize("reason", ["off", "m_gt_16", "prefill", "spec_decode"])
+def test_kda_decode_fallback_on_switch_off_or_unsupported(monkeypatch, reason):
+    from vllm.models.kimi_k3.nvidia import kda as kda_mod
