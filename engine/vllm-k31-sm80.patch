+uint64_t read_urandom_u64() {
+  uint64_t r = 0ull;
+  int fd = open("/dev/urandom", O_RDONLY | O_CLOEXEC);
+  if (fd >= 0) {
+    ssize_t n = read(fd, &r, sizeof(r));
+    close(fd);
+    if (n != static_cast<ssize_t>(sizeof(r))) {
+      r = 0ull;
+    }
+  }
+  if (r == 0ull) {
+    std::random_device rd;
+    r = (static_cast<uint64_t>(rd()) << 32) ^ static_cast<uint64_t>(rd());
+  }
+  struct timespec ts = {};
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  uint64_t seq = g_shm_counter.fetch_add(1, std::memory_order_relaxed);
+  uint64_t mix = static_cast<uint64_t>(ts.tv_nsec) ^
+                 (static_cast<uint64_t>(ts.tv_sec) << 21) ^
+                 (static_cast<uint64_t>(static_cast<uint32_t>(getpid())) << 16) ^
+                 (seq * 0x9E3779B97F4A7C15ull);
+  r ^= mix;
+  // SplitMix64 finalizer guarantees high entropy across all 64 bits.
+  r = (r ^ (r >> 30)) * 0xBF58476D1CE4E5B9ull;
+  r = (r ^ (r >> 27)) * 0x94D049BB133111EBull;
+  r = r ^ (r >> 31);
+  return (r == 0ull) ? 0x9E3779B97F4A7C15ull : r;
+}
+
+// Process-wide random 64-bit nonce generated once from /dev/urandom (M2).
+// Distinguishes separate processes even when containers share identical PIDs (e.g. PID 1).
+uint64_t get_process_nonce() {
+  static std::once_flag once;
+  static uint64_t nonce = 0ull;
+  std::call_once(once, []() { nonce = read_urandom_u64(); });
+  return nonce;
+}
