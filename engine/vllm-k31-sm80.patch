+
+    # Switch OFF: 0 glue calls at M=4.
+    x4 = torch.randn((4, 64), dtype=torch.bfloat16)
+    method.apply(layer, x4)
+    assert fake.calls == []
+
+    # Switch ON: M = 1, 4, 8, 16 all intercept via bf16_gemv_split2.
+    monkeypatch.setenv("VLLM_K31_GLUE_GEMV", "1")
+    for M in (1, 4, 8, 16):
+        xm = torch.randn((M, 64), dtype=torch.bfloat16)
+        got = method.apply(layer, xm)
+        want = F.linear(xm.float(), layer.plain_weight.float()).to(torch.bfloat16)
+        assert torch.allclose(got.float(), want.float(), atol=1e-2, rtol=1e-2)
+    gemv_calls = fake.calls_for("bf16_gemv_split2")
+    assert [c["rows"] for c in gemv_calls] == [1, 4, 8, 16]
+    assert all(c["n0"] == 128 and c["n1"] == 48 for c in gemv_calls)
+
+    # M10: default lifted row gate (0 = unlimited) handles M=24 via bf16_gemv_split2
+    # so decode numerics do not split across batch size 16/17.
+    x24 = torch.randn((24, 64), dtype=torch.bfloat16)
+    got24_lifted = method.apply(layer, x24)
+    want24 = F.linear(x24.float(), layer.plain_weight.float()).to(torch.bfloat16)
+    assert fake.calls_for("bf16_gemv_split2")[-1]["rows"] == 24
+    assert torch.allclose(got24_lifted.float(), want24.float(), atol=2e-2, rtol=2e-2)
+
+    # Explicit VLLM_K31_GLUE_GEMV_MAX_ROWS=16 cap falls back cleanly at M=24.
+    monkeypatch.setenv("VLLM_K31_GLUE_GEMV_MAX_ROWS", "16")
+    before = len(fake.calls_for("bf16_gemv_split2"))
+    got24 = method.apply(layer, x24)
+    assert len(fake.calls_for("bf16_gemv_split2")) == before
+    assert torch.allclose(got24.float(), want24.float(), atol=2e-2, rtol=2e-2)
+
+    # When Item 2 linear_plain_invariant_k31 is present on dense, capped M > 16 delegates to it.
+    item2_calls = []
+
+    def _fake_item2_plain(x_in, w_in, bias=None):
+        item2_calls.append((x_in.shape, w_in.shape))
+        return F.linear(x_in.float(), w_in.float()).to(torch.bfloat16)
+
+    monkeypatch.setattr(
+        dense, "linear_plain_invariant_k31", _fake_item2_plain, raising=False
+    )
+    method.apply(layer, x24)
+    # Contiguous plain segments (128 + 48 = 176) coalesce into one Item 2 launch.
+    assert item2_calls == [(torch.Size([24, 64]), torch.Size([176, 64]))]
+    assert len(fake.calls_for("bf16_gemv_split2")) == before
+
