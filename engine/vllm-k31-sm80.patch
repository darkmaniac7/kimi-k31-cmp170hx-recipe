index 0000000000..2aee6d9343
--- /dev/null
+++ b/vllm/sm80/kernels/k31q/plan.py
@@ -0,0 +1,522 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Header-level load plan of a k31q checkpoint: what one tensor-parallel rank
+would hold of each decoder layer present, from the manifest and the model
+config alone. No model is built and no tensor data is read.
+
+It serves checkpoints a model cannot be built from (a mini checkpoint of
+non-contiguous layers) and sizing: the bytes per rank and layer are what the
+loader reads for that rank (tests compare the two on a tiny model). It also
+refuses, by name, what the loader would only trip over later: a tensor-
+parallel cut that does not fall on whole 128 blocks, a matrix stored as EXL3
+that the model needs as a dense weight, an EXL3 matrix with no cut rule, and
+routed experts that do not fit the model's expert count and sizes.
+"""
+
+from dataclasses import dataclass
+
+from vllm import envs
+from vllm.sm80.kernels.exl3.utils import PackedMatrix, aligned_shard, block_shard
+from vllm.sm80.kernels.k31q.codec import BLOCK, IN_LATENT
+from vllm.sm80.kernels.k31q.manifest import PROJECTIONS, VQ, K31QManifest
+
+# How the model cuts each EXL3 matrix of a decoder layer across the ranks
+# (vllm/models/kimi_k3/nvidia: column-parallel = outputs, row-parallel =
+# inputs, replicated = whole on every rank).
+OUTPUTS, INPUTS, WHOLE = "outputs", "inputs", "whole"
+DENSE_CUTS = {
+    "self_attn.q_proj": OUTPUTS,
+    "self_attn.k_proj": OUTPUTS,
+    "self_attn.v_proj": OUTPUTS,
+    "self_attn.g_proj": OUTPUTS,
+    "self_attn.q_b_proj": OUTPUTS,
+    "self_attn.o_proj": INPUTS,
+    "self_attn.q_a_proj": WHOLE,
+    "self_attn.kv_a_proj_with_mqa": WHOLE,
+    "mlp.gate_proj": OUTPUTS,
+    "mlp.up_proj": OUTPUTS,
+    "mlp.down_proj": INPUTS,
+    "block_sparse_moe.shared_experts.gate_proj": OUTPUTS,
+    "block_sparse_moe.shared_experts.up_proj": OUTPUTS,
+    "block_sparse_moe.shared_experts.down_proj": INPUTS,
+    "block_sparse_moe.routed_expert_down_proj": WHOLE,
+    "block_sparse_moe.routed_expert_up_proj": WHOLE,
+}
+# Matrices the model reads as dense weights (AttnRes vectors, the KDA key
+# gate and low-rank members, the absorbed MLA kv_b, the indexer): plain only.
+PLAIN_ONLY = (
+    "mlp_res_proj",
+    "self_attention_res_proj",
+    "self_attn.f_a_proj",
+    "self_attn.b_proj",
+    "self_attn.f_b_proj",
+    "self_attn.kv_b_proj",
+    "self_attn.indexer.wq_b",
+    "self_attn.indexer.wk",
+    "self_attn.indexer.weights_proj",
+)
+
+
+@dataclass(frozen=True)
+class LayerPlan:
+    """One rank's share of one decoder layer, in bytes of checkpoint data."""
+
+    layer: int
+    expert_method: str | None  # None: the layer has no routed experts
+    expert_blocks: slice | None  # this rank's I-blocks
+    expert_bytes: int  # routed experts (codebooks not counted)
+    dense_bytes: int  # EXL3 matrices after the rank's cut
+    plain_bytes: int  # plain tensors as stored (the model cuts some)
+
+    @property
+    def total_bytes(self) -> int:
+        return self.expert_bytes + self.dense_bytes + self.plain_bytes
+
+
+def _matrix_bytes(matrix: PackedMatrix, rows: slice, cols: slice) -> int:
+    k, n = rows.stop - rows.start, cols.stop - cols.start
+    return 2 * ((k // 16) * (n // 16) * 8 * matrix.bits_x2 + k + n)
+
+
+def _dense_bytes(matrix: PackedMatrix, cut: str, tp_size: int, tp_rank: int) -> int:
+    rows, cols = slice(0, matrix.padded_in), slice(0, matrix.padded_out)
+    try:
+        if cut == OUTPUTS:
+            cols = aligned_shard(matrix.padded_out, matrix.padded_out, tp_rank, tp_size)
+        elif cut == INPUTS:
+            rows = aligned_shard(matrix.padded_in, matrix.padded_in, tp_rank, tp_size)
+    except ValueError as exc:
+        raise ValueError(
+            f"k31q {matrix.prefix}: its {cut} cannot be cut for {tp_size} ranks "
+            "at whole 128 blocks"
+        ) from exc
+    return _matrix_bytes(matrix, rows, cols)
+
+
+def plan_layer(
+    manifest: K31QManifest, layer: int, text_config, tp_size: int, tp_rank: int
+) -> LayerPlan:
+    """The plan of one layer the checkpoint holds. ``text_config`` is the HF
+    text config (num_experts, routed_expert_hidden_size,
+    moe_intermediate_size, first_k_dense_replace)."""
+    prefix = manifest.layer_prefix(layer)
+    owned = set()
+    dense = 0
+    for source, matrix in manifest.matrices.items():
+        if not source.startswith(prefix):
+            continue
+        name = source.removeprefix(prefix)
+        if name.startswith("block_sparse_moe.experts."):
+            continue
+        if name in PLAIN_ONLY:
+            raise ValueError(
+                f"k31q {source} is stored as EXL3; the model reads it as a dense "
+                "weight, so the format stores it plain"
+            )
+        cut = DENSE_CUTS.get(name)
+        if cut is None:
+            raise ValueError(
+                f"k31q {source}: no tensor-parallel cut rule for this matrix"
+            )
+        hidden_size = getattr(text_config, "hidden_size", matrix.padded_out)
+        if (
+            name == "block_sparse_moe.routed_expert_up_proj"
+            and envs.VLLM_K31Q_SHARD_ROUTED_UP
+            and tp_size > 1
+            and getattr(text_config, "num_shared_experts", None) is not None
+            and hidden_size % tp_size == 0
+            and (hidden_size // tp_size) % 128 == 0
+        ):
+            cut = OUTPUTS
+        dense += _dense_bytes(matrix, cut, tp_size, tp_rank)
+        owned.update(matrix.keys)
+
+    method, blocks, expert_bytes = None, None, 0
+    if (layer, "w1") in manifest.expert_projections:
+        method = manifest.expert_method(layer)
+        experts = text_config.num_experts
+        latent = text_config.routed_expert_hidden_size
+        intermediate = text_config.moe_intermediate_size
+        columns = block_shard(intermediate, intermediate, tp_rank, tp_size, layer)
+        blocks = slice(columns.start // BLOCK, columns.stop // BLOCK)
+        for name in PROJECTIONS:
+            projection = manifest.expert_projections[layer, name]
+            projection.validate(experts, latent, intermediate)
+            owned.update(projection.keys)
+            if method == VQ:
+                share = blocks.stop - blocks.start
+                expert_bytes += (
+                    (projection.idx.nbytes + projection.scale.nbytes)
+                    * share
+                    // projection.blocks
+                )
+                continue
+            for matrix in projection.matrices:
+                whole_in, whole_out = (
+                    slice(0, matrix.padded_in),
+                    slice(0, matrix.padded_out),
+                )
+                if projection.role == IN_LATENT:
+                    expert_bytes += _matrix_bytes(matrix, whole_in, columns)
+                else:
+                    expert_bytes += _matrix_bytes(matrix, columns, whole_out)
+    elif layer >= getattr(text_config, "first_k_dense_replace", 0):
+        raise ValueError(
+            f"k31q layer {layer}: the model has routed experts here, the "
+            "checkpoint none"
+        )
+
+    plain = sum(
+        header.nbytes
+        for name, header in manifest.tensors.items()
+        if name.startswith(prefix) and name not in owned
+    )
+    return LayerPlan(layer, method, blocks, expert_bytes, dense, plain)
+
+
+def plan(
+    manifest: K31QManifest, text_config, tp_size: int, tp_rank: int
+) -> dict[int, LayerPlan]:
+    """Plans of every layer the checkpoint holds (all of them, one stage's,
+    or a mini checkpoint's handful), by layer index."""
+    return {
+        layer: plan_layer(manifest, layer, text_config, tp_size, tp_rank)
+        for layer in sorted(manifest.layers)
+    }
+
+
+# ---------------------------------------------------------------------------
+# DSpark drafter VRAM accounting and Stage-3 EXL3 K6 reclaim visibility
+# ---------------------------------------------------------------------------
+
+DSPARK_DEFAULT_CONFIG = {
+    "hidden_size": 7168,
+    "intermediate_size": 14336,
+    "num_hidden_layers": 5,
+    "num_attention_heads": 96,
+    "num_key_value_heads": 16,
+    "head_dim": 64,
+    "vocab_size": 163840,
+    "draft_vocab_size": 163840,
+    "markov_rank": 512,
+    "num_aux_layers": 5,
+    "enable_confidence_head": True,
+    "confidence_head_with_markov": True,
+}
+
+DSPARK_DENSE_CUTS = {
+    "fc": WHOLE,
+    "markov_head.markov_w2": WHOLE,
+    "self_attn.q_proj": OUTPUTS,
+    "self_attn.k_proj": OUTPUTS,
+    "self_attn.v_proj": OUTPUTS,
+    "self_attn.o_proj": INPUTS,
+    "mlp.gate_proj": OUTPUTS,
+    "mlp.up_proj": OUTPUTS,
+    "mlp.down_proj": INPUTS,
+}
+
+_GIB = 2**30
+
+
+@dataclass(frozen=True)
+class DSparkVramPlan:
+    """Exact per-rank runtime VRAM budget of a Qwen3 DSpark drafter on Stage 3.
+
+    Excludes shared target ``embed_tokens`` and ``lm_head`` from ``total_bytes``
+    (already owned by Stage 0 and Stage 3 of the verifier); exposes
+    ``shared_lm_head_k6_bytes`` separately for full last-stage budget math.
+    """
+
+    tp_size: int
+    k6: bool
+    fc_bytes: int
+    layers_bytes: int
+    markov_w1_bytes: int
+    markov_w2_bytes: int
+    norms_and_conf_bytes: int
+    bf16_baseline_bytes: int
+    shared_lm_head_k6_bytes: int
+
+    @property
+    def total_bytes(self) -> int:
+        return (
+            self.fc_bytes
+            + self.layers_bytes
+            + self.markov_w1_bytes
+            + self.markov_w2_bytes
+            + self.norms_and_conf_bytes
+        )
+
+    @property
+    def reclaim_bytes(self) -> int:
+        return self.bf16_baseline_bytes - self.total_bytes
+
+    @property
+    def total_gib(self) -> float:
+        return self.total_bytes / _GIB
+
+    @property
+    def bf16_baseline_gib(self) -> float:
+        return self.bf16_baseline_bytes / _GIB
+
+    @property
+    def reclaim_gib(self) -> float:
+        return self.reclaim_bytes / _GIB
+
+    @property
+    def shared_lm_head_k6_gib(self) -> float:
+        return self.shared_lm_head_k6_bytes / _GIB
+
+
+def _exl3_k6_runtime_bytes(in_dim: int, out_dim: int, bits_x2: int = 12) -> int:
+    """Per-rank EXL3 parameter bytes (trellis I16 + suh F16 + svh F16)."""
+    return 2 * ((in_dim // 16) * (out_dim // 16) * 8 * bits_x2 + in_dim + out_dim)
+
+
+def _cfg_field(config, key: str, default):
+    if config is None:
+        return default
+    if isinstance(config, dict):
+        return config.get(key, default)
+    return getattr(config, key, default)
+
+
+def estimate_dspark_vram_bytes(
+    tp_size: int = 2,
+    *,
+    k6: bool = True,
+    config=None,
+    bits_x2: int = 12,
+) -> DSparkVramPlan:
+    """Compute exact per-rank Stage-3 VRAM bytes for BF16 or EXL3 K6 DSpark.
+
+    For Kimi-K3.1-Pro-DSpark at TP2 (Stage 3):
+      - BF16: ``2,904,759,556`` bytes (``2.705 GiB/rank``)
+      - EXL3 K6: ``1,195,473,156`` bytes (``1.113 GiB/rank``)
+      - Reclaim: ``1,709,286,400`` bytes (``1.592 GiB/rank``, ``3.184 GiB`` total)
+    At TP1:
+      - BF16: ``4,959,968,516`` bytes (``4.619 GiB``)
+      - EXL3 K6: ``1,966,545,156`` bytes (``1.831 GiB``)
+      - Reclaim: ``2,993,423,360`` bytes (``2.788 GiB``)
+    """
+    if tp_size < 1:
+        raise ValueError(f"tp_size must be positive, got {tp_size}")
+    h = int(_cfg_field(config, "hidden_size", DSPARK_DEFAULT_CONFIG["hidden_size"]))
+    inter = int(
+        _cfg_field(
+            config, "intermediate_size", DSPARK_DEFAULT_CONFIG["intermediate_size"]
+        )
+    )
+    n_layers = int(
+        _cfg_field(
+            config, "num_hidden_layers", DSPARK_DEFAULT_CONFIG["num_hidden_layers"]
+        )
+    )
+    nq = int(
+        _cfg_field(
+            config,
+            "num_attention_heads",
+            DSPARK_DEFAULT_CONFIG["num_attention_heads"],
+        )
+    )
+    nkv = int(
+        _cfg_field(
+            config,
+            "num_key_value_heads",
+            DSPARK_DEFAULT_CONFIG["num_key_value_heads"],
+        )
+    )
+    hd = int(_cfg_field(config, "head_dim", DSPARK_DEFAULT_CONFIG["head_dim"]))
+    vocab = int(_cfg_field(config, "vocab_size", DSPARK_DEFAULT_CONFIG["vocab_size"]))
+    draft_vocab = int(
+        _cfg_field(config, "draft_vocab_size", None) or vocab
+    )
+    markov_rank = int(
+        _cfg_field(config, "markov_rank", DSPARK_DEFAULT_CONFIG["markov_rank"])
+    )
+    aux_ids = _cfg_field(config, "aux_hidden_state_layer_ids", None)
+    if aux_ids is not None:
+        n_aux = len(aux_ids)
+    else:
+        n_aux = int(
+            _cfg_field(
+                config, "num_aux_layers", DSPARK_DEFAULT_CONFIG["num_aux_layers"]
+            )
+        )
+    enable_conf = bool(
+        _cfg_field(
+            config,
+            "enable_confidence_head",
+            DSPARK_DEFAULT_CONFIG["enable_confidence_head"],
+        )
+    )
+    conf_with_markov = bool(
+        _cfg_field(
+            config,
+            "confidence_head_with_markov",
+            DSPARK_DEFAULT_CONFIG["confidence_head_with_markov"],
+        )
+    )
+
+    q_dim = nq * hd
+    kv_dim = nkv * hd
+    if q_dim % tp_size or kv_dim % tp_size or inter % tp_size or draft_vocab % tp_size:
+        raise ValueError(
+            f"DSpark dimensions do not divide evenly across tp_size={tp_size}"
+        )
+
+    fc_in = n_aux * h
+    fc_bf16 = fc_in * h * 2
+    fc_bytes = _exl3_k6_runtime_bytes(fc_in, h, bits_x2) if k6 else fc_bf16
+
+    layer_shapes_local = (
+        (h, q_dim // tp_size),
+        (h, kv_dim // tp_size),
+        (h, kv_dim // tp_size),
+        (q_dim // tp_size, h),
+        (h, inter // tp_size),
+        (h, inter // tp_size),
+        (inter // tp_size, h),
+    )
+    layers_bf16 = n_layers * sum(k_d * n_d * 2 for k_d, n_d in layer_shapes_local)
+    layers_bytes = (
+        n_layers * sum(_exl3_k6_runtime_bytes(k_d, n_d, bits_x2) for k_d, n_d in layer_shapes_local)
+        if k6
+        else layers_bf16
+    )
+
+    # markov_w1 is an embedding lookup table (always BF16, replicated).
+    markov_w1_bytes = vocab * markov_rank * 2
+    # markov_w2 is replicated full-vocabulary linear [draft_vocab, markov_rank].
+    markov_w2_bf16 = markov_rank * draft_vocab * 2
+    markov_w2_bytes = (
+        _exl3_k6_runtime_bytes(markov_rank, draft_vocab, bits_x2)
+        if k6
+        else markov_w2_bf16
+    )
+
+    # Norms in BF16; confidence_head.proj.{weight,bias} in FP32 at runtime.
+    norm_elems = 2 * h + n_layers * (2 * h + 2 * hd)
+    conf_elems = (h + (markov_rank if conf_with_markov else 0) + 1) if enable_conf else 0
+    norms_and_conf_bytes = norm_elems * 2 + conf_elems * 4
+
+    bf16_baseline = (
+        fc_bf16 + layers_bf16 + markov_w1_bytes + markov_w2_bf16 + norms_and_conf_bytes
+    )
+    shared_lm_head_k6_bytes = _exl3_k6_runtime_bytes(h, draft_vocab // tp_size, bits_x2)
+
+    return DSparkVramPlan(
+        tp_size=tp_size,
+        k6=k6,
+        fc_bytes=fc_bytes,
+        layers_bytes=layers_bytes,
+        markov_w1_bytes=markov_w1_bytes,
+        markov_w2_bytes=markov_w2_bytes,
+        norms_and_conf_bytes=norms_and_conf_bytes,
+        bf16_baseline_bytes=bf16_baseline,
+        shared_lm_head_k6_bytes=shared_lm_head_k6_bytes,
+    )
+
+
+def plan_dspark(directory, tp_size: int = 2, tp_rank: int = 0) -> DSparkVramPlan:
+    """Header-only per-rank VRAM plan from a ``k31q_dspark_exl3`` checkpoint dir."""
+    from vllm.sm80.kernels.k31q.dspark_k6 import K31DSparkManifest
+
+    manifest = K31DSparkManifest(directory)
+    fc_bytes = 0
+    layers_bytes = 0
+    markov_w2_bytes = 0
+    bf16_quant_bytes = 0
+
+    for prefix, matrix in manifest.matrices.items():
+        if prefix == "fc":
+            cut = WHOLE
+        elif prefix == "markov_head.markov_w2":
+            cut = WHOLE
+        elif ".layers." in f".{prefix}":
+            leaf = prefix.split(".", 2)[2]
+            cut = DSPARK_DENSE_CUTS.get(leaf)
+            if cut is None:
+                raise ValueError(f"k31q_dspark_exl3 {prefix}: no TP cut rule")
+        else:
+            cut = WHOLE
+        nbytes = _dense_bytes(matrix, cut, tp_size, tp_rank)
+        local_in = matrix.padded_in // tp_size if cut == INPUTS else matrix.padded_in
+        local_out = matrix.padded_out // tp_size if cut == OUTPUTS else matrix.padded_out
+        bf16_quant_bytes += local_in * local_out * 2
+        if prefix == "fc":
+            fc_bytes += nbytes
+        elif prefix == "markov_head.markov_w2":
+            markov_w2_bytes += nbytes
+        else:
+            layers_bytes += nbytes
+
+    markov_w1_bytes = 0
+    norms_and_conf_bytes = 0
+    packed_keys = {k for m in manifest.matrices.values() for k in m.keys}
+    for name, header in manifest.tensors.items():
+        if name in packed_keys:
+            continue
+        if name == "markov_head.markov_w1.weight":
+            markov_w1_bytes += header.nbytes
+        elif name.startswith("confidence_head.proj."):
+            # Stored BF16 on disk, held in FP32 at runtime.
+            norms_and_conf_bytes += header.nbytes * (2 if header.dtype == "BF16" else 1)
+        else:
+            norms_and_conf_bytes += header.nbytes
+
+    bf16_baseline = bf16_quant_bytes + markov_w1_bytes + norms_and_conf_bytes
+    fc_mat = manifest.matrices.get("fc")
+    mw2_mat = manifest.matrices.get("markov_head.markov_w2")
+    h = fc_mat.padded_out if fc_mat is not None else DSPARK_DEFAULT_CONFIG["hidden_size"]
+    v = mw2_mat.padded_out if mw2_mat is not None else DSPARK_DEFAULT_CONFIG["vocab_size"]
+    shared_lm_head_k6_bytes = _exl3_k6_runtime_bytes(h, v // tp_size, 12)
+
+    return DSparkVramPlan(
+        tp_size=tp_size,
+        k6=True,
+        fc_bytes=fc_bytes,
+        layers_bytes=layers_bytes,
+        markov_w1_bytes=markov_w1_bytes,
+        markov_w2_bytes=markov_w2_bytes,
+        norms_and_conf_bytes=norms_and_conf_bytes,
+        bf16_baseline_bytes=bf16_baseline,
+        shared_lm_head_k6_bytes=shared_lm_head_k6_bytes,
+    )
+
+
+def stage_head_budget_gib(
+    stage_idx: int,
+    num_stages: int,
+    *,
+    dspark_mode: str = "bf16",
+    tp_size: int = 2,
+    embed_gib: float | None = None,
+    lm_head_k6_gib: float | None = None,
+    dspark_gib_override: float | None = None,
+) -> float:
+    """Per-rank fixed head/embed/drafter VRAM (GiB) for pipeline stage ``stage_idx``.
+
+    Stage 0 holds the target's BF16 ``embed_tokens`` shard (``1.094 GiB/rank``
+    at TP2); the last stage holds the shared target EXL3 K6 ``lm_head``
+    (``0.410 GiB/rank`` at TP2) plus the DSpark drafter (``0.0`` for ``none``,
+    ``2.705 GiB/rank`` for ``bf16``, ``1.113 GiB/rank`` for ``exl3-k6``).
+    """
+    if dspark_mode not in ("none", "bf16", "exl3-k6"):
+        raise ValueError(f"Unknown dspark_mode: {dspark_mode!r}")
+    total = 0.0
+    if stage_idx == 0:
+        if embed_gib is not None:
+            total += embed_gib
+        else:
+            v = DSPARK_DEFAULT_CONFIG["vocab_size"]
+            h = DSPARK_DEFAULT_CONFIG["hidden_size"]
+            total += (v * h * 2 / tp_size) / _GIB
+    if stage_idx == num_stages - 1:
+        k6 = dspark_mode == "exl3-k6"
+        dplan = estimate_dspark_vram_bytes(tp_size=tp_size, k6=k6)
+        total += lm_head_k6_gib if lm_head_k6_gib is not None else dplan.shared_lm_head_k6_gib
+        if dspark_mode != "none":
+            total += dspark_gib_override if dspark_gib_override is not None else dplan.total_gib
+    return total
