+"""Python interface and FakeTensor registrations for _k31_glue_C (sm_80 + sm_120).
+
+Fused non-GEMM / non-VQ decode glue kernels for Kimi-K3.1-Pro:
+  1. attn_res_rmsnorm: fused AttnRes (0..8 blocks, optional delta2 fold) + RMSNorm
+  2. fused_router_gemv_topk: 1-launch BF16 router GEMV + sigmoid + bias + top-k
+  3. moe_topk_sigmoid: 256-thread cooperative histogram top-k for FP32 router logits
+  4. bf16_gemv_split2: row-count-invariant narrow-N BF16 GEMV writing 2 outputs
+  5. fused_kda_decode: 1-launch SM80/SM120 KDA decode (conv1d+SiLU + rec + norm)
+  6. fused_q_kv_rmsnorm & sigmoid_mul: MLA decode glue fusions
+
+Loaded as ``vllm/_k31_glue_C.abi3.so`` through :mod:`vllm.sm80.kernels.k31q.native`
+with strict ``abi_version=1`` and ``api_version>=1`` validation. Importing this
+module triggers zero CUDA lazy initialization.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import torch
+
+from vllm.sm80.kernels.k31q import native
+
