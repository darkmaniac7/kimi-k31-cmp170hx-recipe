+@pytest.mark.parametrize("field,edit", [
+    ("pins", lambda r: r.update(pins={})),
+    ("pins.TARGET_REVISION", lambda r: r["pins"].pop("TARGET_REVISION")),
+    ("engines", lambda r: r.update(engines=[])),
+    ("engines.build_owned", lambda r: r["engines"][0].update(build_owned_sha256=None)),
+    ("engines.natives", lambda r: r["engines"][0].update(native_manifest_sha256=None)),
+    ("checkpoints", lambda r: r.update(checkpoints={})),
+    ("layouts", lambda r: r.update(layouts={})),
+])
+def test_receipt_field_removed(built, field, edit):
+    p = os.path.join(built.settings, "validated", "receipt.json")
+    r = json.load(open(p))
+    edit(r)
+    write(p, json.dumps(r))
+    d = built.resolve()
+    assert d["validated"]["state"] == "NOT_VALIDATED", field
+
+
+def test_tree_without_build_identity_not_validated(tmp_path):
+    w = World(tmp_path, build=False)
+    assert w.verify() == 0
+    promote(w, ["tp2"])
+    d = w.resolve()
+    assert d["validated"]["state"] == "NOT_VALIDATED"
+    assert "build ≠ receipt" in reasons(d) or "receipt malformed" in " ".join(reasons(d))
+
+
+# -- adversarial inputs and schemas ----------------------------------------------------
+
+@pytest.mark.parametrize("text,needle", [
+    ('[args]\nx = nan\n', "non-finite"),
+    ('[args]\nx = inf\n', "non-finite"),
+    ('[args]\nmax_num_seqs = 4\nmax-num-seqs = 4\n', "same argument"),
+    ('[env]\nVLLM_THIN_GEMM = "1\\n2"\n', "newline or NUL"),
+    ('[env]\nVLLM_THIN_GEMM = "1\\u0000"\n', "newline or NUL"),
+])
+def test_bad_values(w, text, needle):
+    write(os.path.join(w.settings, "layouts", "tp2.toml"),
+          'schema = "launch-layout/1"\ntp = 2\npp = 1\ncards = 2\n' + text)
+    assert needle in w.refused()
+
+
+def test_symlinks_refused(w, tmp_path):
+    os.symlink(str(tmp_path), os.path.join(w.settings, "layouts", "out.toml"))
+    assert "symlink" in w.refused()
+    os.unlink(os.path.join(w.settings, "layouts", "out.toml"))
+    os.symlink("tp2.toml", os.path.join(w.settings, "layouts", "alias.toml"))
+    assert "symlink" in w.refused()
+
+
+def test_community_layout(w, tmp_path):
+    promote(w, ["tp2"])
+    extra = tmp_path / "extra"
+    write(str(extra / "layouts" / "tp2.toml"), open(os.path.join(w.settings, "layouts", "tp2.toml")).read())
+    d = w.resolve("--settings-extra", str(extra))
+    assert d["validated"]["state"] == "VALIDATED"          # functionally equal
+    write(str(extra / "layouts" / "tp2.toml"),
+          'schema = "launch-layout/1"\n[args]\nmax-num-batched-tokens = 1000\n')
+    assert "community layer" in reasons(w.resolve("--settings-extra", str(extra)))
+    write(str(extra / "layouts" / "tp1x.toml"), 'schema = "launch-layout/1"\ntp = 1\npp = 1\ncards = 1\ncard_ids = "1"\n')
+    d = w.resolve("--settings-extra", str(extra), layout="tp1x")
+    assert "community layer" in reasons(d)
+
+
+@pytest.mark.parametrize("schema", ["launch-layout/2", "launch-model/1"])
+def test_unknown_schema_major(w, schema):
+    path = os.path.join(w.settings, "layouts", "tp2.toml")
+    write(path, open(path).read().replace('schema = "launch-layout/1"', f'schema = "{schema}"'))
+    assert "schema" in w.refused()
+
+
+def test_receipt_unknown_major(w):
+    promote(w, ["tp2"])
+    p = os.path.join(w.settings, "validated", "receipt.json")
+    r = json.load(open(p))
+    r["schema"] = "validation-receipt/2"
+    write(p, json.dumps(r))
+    assert "unsupported schema" in w.refused()
+
+
+def test_previous_major_fixtures_read():
+    """Every schema the launcher reads has exactly one major today; this
+    keeps the list honest when a second major is added."""
+    from settings_dir import SUPPORTED_SCHEMAS
+    assert all(len(v) == 1 for v in SUPPORTED_SCHEMAS.values())
+
+
+def test_exec_matches_printed(w):
+    promote(w, ["tp2"])
+    d = w.resolve()
+    p = w.run()
+    assert p.returncode == 0, p.stderr
+    assert p.stderr.startswith("VALIDATED synth-dense tp2")
+    argv, env = read_record(w.venv)
+    assert argv == d["argv"]
+    assert set(env) == set(d["child_env"])
+    assert {k: v for k, v in env.items() if d["child_env"][k]["class"] == "functional"} == d["env_functional"]
+    assert canonical_sha256({"argv": d["argv_functional"], "env": d["env_functional"]}) == d["functional_sha256"]
diff --git a/tests/sm80/round_once_allreduce_bits.py b/tests/sm80/round_once_allreduce_bits.py
new file mode 100644
index 0000000000..5982a648ac
--- /dev/null
+++ b/tests/sm80/round_once_allreduce_bits.py
@@ -0,0 +1,207 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Bits and time of the grouped round-once all-reduce on real GPUs
+(vllm/sm80/distributed/round_once_all_reduce.py), against NCCL's BF16 ring.
+
+For every row count and hidden size, on rank-distinct random BF16 partials
+(per-rank, per-row scales 2^[-6, 3]), this compares
+* ``grouped``: ``nccl_round_once_all_reduce(partial)`` on the TP group's
+  PyNccl communicator;
+* ``ring``: the TP group's PyNccl all-reduce of the BF16 partial (NCCL's
+  ring, one rounding per hop);
+* ``exact``: the exact sum of the gathered partials, correctly rounded
+  (tests/sm80/test_round_once_all_reduce.py's reference);
+records mismatch counts against ``exact``, whether every rank holds the same
+bits, and the median time of the grouped all-reduce, the BF16 ring and the
+FP32 ring at seed 0. ``grouped`` must equal ``exact`` everywhere (verdict
+line ``GROUPED``). Rank 0 writes JSON to ``--out``; the exit code is 0 when
+every case ran.
+
+Not a pytest module: it needs peer-connected GPUs, one process each
+(test_round_once_all_reduce_gpu.py runs it at TP4 under the served settings
+and judges its JSON)::
+
+    torchrun --standalone --nproc-per-node 4 \\
+        tests/sm80/round_once_allreduce_bits.py --out result.json
+"""
+
+import argparse
+import json
+import os
+import statistics
+
+import torch
+import torch.distributed as dist
+
+from vllm.sm80.distributed.step_errors import copy_error_flags
+
+ROWS = [1, 7, 819, 820, 1024, 2047, 2048]
+HIDDEN = [5120, 4096]
+
+
+def _time(fn, iters: int) -> float:
+    times = []
+    for _ in range(iters):
+        dist.barrier()
+        start = torch.cuda.Event(enable_timing=True)
+        end = torch.cuda.Event(enable_timing=True)
+        start.record()
+        fn()
+        errors = copy_error_flags()
+        end.record()
+        torch.cuda.synchronize()
+        if errors is not None:
+            errors.raise_if_failed()
+        times.append(start.elapsed_time(end) * 1000.0)
+    return statistics.median(times)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", required=True)
+    parser.add_argument("--seeds", type=int, default=2)
+    parser.add_argument("--iters", type=int, default=20)
+    parser.add_argument("--invalid", choices=("span", "nonfinite"))
+    args = parser.parse_args()
+
+    from tests.sm80.test_round_once_all_reduce import exact_sum, reference_round
+    from vllm.config import VllmConfig, set_current_vllm_config
+    from vllm.distributed import (
+        ensure_model_parallel_initialized,
+        init_distributed_environment,
+    )
+    from vllm.distributed.parallel_state import get_tp_group
+    from vllm.plugins import load_general_plugins
+    from vllm.sm80.distributed.round_once_all_reduce import (
+        grouped_round_once_takes,
+        nccl_round_once_all_reduce,
+    )
+
+    load_general_plugins()
+    rank = int(os.environ["RANK"])
+    world = int(os.environ["WORLD_SIZE"])
+    local_rank = int(os.environ["LOCAL_RANK"])
+    torch.cuda.set_device(local_rank)
+    with set_current_vllm_config(VllmConfig()):
+        init_distributed_environment(
+            world_size=world,
+            rank=rank,
+            local_rank=local_rank,
+            distributed_init_method="env://",
+            backend="nccl",
+        )
+        ensure_model_parallel_initialized(world, 1)
+    comm = get_tp_group().device_communicator
+    pynccl = comm.pynccl_comm
+    dev = torch.device("cuda", local_rank)
+    if args.invalid:
+        from types import SimpleNamespace
+        from vllm.v1.worker.gpu.async_utils import AsyncOutput
+        partial = torch.zeros((4, 8), dtype=torch.bfloat16, device=dev)
+        values = [1.0, 2.0**-60 if args.invalid == "span" else float("inf"), -1.0, 0.0]
+        partial.flatten()[16] = values[rank]
+        nccl_round_once_all_reduce(partial, pynccl)
+        sampler = SimpleNamespace(sampled_token_ids=torch.ones((1, 1), dtype=torch.int64, device=dev),
+                                  logprobs_tensors=None, num_nans=None, sampling_mask_tensors=None)
+        output = SimpleNamespace(prompt_logprobs_dict={}, prompt_token_id_logprobs_dict={})
+        pending = AsyncOutput(output, sampler, torch.ones(1, dtype=torch.int32, device=dev),
+                              torch.cuda.current_stream(), torch.cuda.Stream(), False, None)
+        refused = False
+        try:
+            pending.get_output()
+        except ValueError as error:
+            refused = "finite exponent span" in str(error)
+        healthy = torch.ones(1, device=dev).sum().item() == 1
+        records = [None] * world
+        dist.all_gather_object(records, dict(rank=rank, refused=refused, cuda_context_healthy=healthy))
+        if rank == 0:
+            with open(args.out, "w") as file:
+                json.dump(dict(invalid=args.invalid, records=records), file, indent=1)
+        dist.barrier()
+        dist.destroy_process_group()
+        return
+    from tests.sm80.round_once_unchecked import make_unchecked_control
+    results = []
+    for hidden in HIDDEN:
+        for rows in ROWS:
+            for seed in range(args.seeds):
+                g = torch.Generator(device=dev).manual_seed(
+                    1000 * seed + rows + 7 * rank + hidden
+                )
+                scale = torch.exp2(
+                    torch.randint(-6, 4, (rows, 1), generator=g, device=dev).float()
+                )
+                partial = (
+                    torch.randn(rows, hidden, generator=g, device=dev) * scale
+                ).to(torch.bfloat16)
+                partial[0, 0] = (1.0, 2.0**-8, 2.0**-30, 0.0)[rank]
+                partial[0, 1] = 2.0**-133
+                partial[0, 2] = -2.0**-133
+                partial[0, 3] = (1.0, 2.0**-43, -1.0, 0.0)[rank]
+                assert grouped_round_once_takes(partial, comm)
+                grouped = nccl_round_once_all_reduce(partial, pynccl)
+                errors = copy_error_flags(dev)
+                ring = pynccl.all_reduce(partial)
+                gathered = [torch.empty_like(partial) for _ in range(world)]
+                dist.all_gather(gathered, partial)
+                exact = reference_round(exact_sum(torch.stack(gathered)), torch.bfloat16)
+                bits = grouped.view(torch.int16)
+                wire_bits = grouped.view(torch.uint8)
+                same = [torch.empty_like(wire_bits) for _ in range(world)]
+                dist.all_gather(same, wire_bits)
+                case = {
+                    "rows": rows,
+                    "hidden": hidden,
+                    "seed": seed,
+                    "grouped_ne_exact": int((bits != exact.view(torch.int16)).sum()),
+                    "ring_ne_exact": int(
+                        (ring.view(torch.int16) != exact.view(torch.int16)).sum()
+                    ),
+                    "ranks_agree": all(torch.equal(s, same[0]) for s in same),
+                    "elements": rows * hidden,
+                }
+                if errors is not None:
+                    errors.raise_if_failed()
+                if seed == 0:
+                    unchecked = make_unchecked_control(partial, pynccl)
+                    assert torch.equal(unchecked().view(torch.int16), bits)
+                    case["us_grouped_unchecked"] = _time(unchecked, args.iters)
+                    pf = partial.float()
+                    case["us_grouped"] = _time(
+                        lambda: nccl_round_once_all_reduce(partial, pynccl), args.iters
+                    )
+                    case["us_validation_overhead"] = case["us_grouped"] - case["us_grouped_unchecked"]
+                    case["us_ring_bf16"] = _time(
+                        lambda: pynccl.all_reduce(partial), args.iters
+                    )
+                    case["us_ring_fp32"] = _time(lambda: pynccl.all_reduce(pf), args.iters)
+                results.append(case)
+    all_results = [None] * world
+    dist.all_gather_object(all_results, results)
+    results = [dict(case, rank=r) for r, cases in enumerate(all_results) for case in cases]
+    if rank == 0:
+        equal = all(c["grouped_ne_exact"] == 0 and c["ranks_agree"] for c in results)
+        for c in results:
+            t = (
+                f" grouped {c['us_grouped']:.1f} us ring bf16 {c['us_ring_bf16']:.1f} us"
+                f" ring fp32 {c['us_ring_fp32']:.1f} us"
+                if "us_grouped" in c
+                else ""
+            )
+            print(
+                f"hidden {c['hidden']} rows {c['rows']:5d} seed {c['seed']} "
+                f"grouped ne {c['grouped_ne_exact']} ring ne {c['ring_ne_exact']:8d}/"
+                f"{c['elements']} agree {c['ranks_agree']}{t}"
+            )
+        state = "EQUAL to" if equal else "DIFFERS from"
+        print(f"GROUPED {state} the correctly rounded exact sum")
+        with open(args.out, "w") as f:
+            json.dump(
+                {"world": world, "equal": equal, "cases": results}, f, indent=1
+            )
+    dist.barrier()
+    dist.destroy_process_group()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/sm80/round_once_unchecked.py b/tests/sm80/round_once_unchecked.py
new file mode 100644
index 0000000000..3683a4ff5f
--- /dev/null
+++ b/tests/sm80/round_once_unchecked.py
@@ -0,0 +1,46 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Timing-only control: identical fused transport without numerical validation.
+
+Never imported by serving. The factory first sends the same immutable input
+through the checked path; its deferred error must be consumed at the caller's
+existing synchronization before accepting any measurements. Only the checked
+transport can gate a numerical or performance decision.
+"""
+import torch
+import triton
+
+from vllm.sm80.distributed.round_once_all_reduce import nccl_round_once_all_reduce
+from vllm.sm80.distributed.round_once_kernels import _sum_round
+
+
+def make_unchecked_control(t, pynccl):
+    nccl_round_once_all_reduce(t, pynccl)
+    rank, world = pynccl.rank, pynccl.world_size
+    numel = t.numel()
+    chunk = triton.cdiv(numel, world)
+    span = (45 if t.dtype == torch.bfloat16 else 42) - (world - 1).bit_length()
+
+    def run():
+        flat = t.reshape(-1)
+        if chunk * world != numel:
+            padded = torch.zeros(chunk * world, dtype=t.dtype, device=t.device)
+            padded[:numel] = flat
+            flat = padded
+        recv = torch.empty((world, chunk), dtype=t.dtype, device=t.device)
+        sends = list(flat.view(world, chunk).unbind())
+        recvs = list(recv.unbind())
+        recvs[rank].copy_(sends[rank])
+        stream = torch.cuda.current_stream()
+        pynccl.group_start()
+        for peer in range(world):
+            if peer != rank:
+                pynccl.send(sends[peer], peer, stream)
+                pynccl.recv(recvs[peer], peer, stream)
+        pynccl.group_end()
+        mine = torch.empty(chunk, dtype=t.dtype, device=t.device)
+        _sum_round[(triton.cdiv(chunk, 256),)](recv, mine, chunk, world, 2.0**span, False, 256)
+        out = torch.empty(chunk * world, dtype=t.dtype, device=t.device)
+        pynccl.all_gather(out, mine, stream)
+        return out[:numel].view(t.shape)
+    return run
