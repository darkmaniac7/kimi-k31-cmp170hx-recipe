+def _require_gpu_vq_and_glue() -> None:
+    if not torch.cuda.is_available():
+        pytest.skip("CUDA not available")
+    cap = torch.cuda.get_device_capability()
+    if cap not in ((8, 0), (12, 0)):
+        pytest.skip(f"Unsupported CUDA capability {cap}")
+    try:
+        vq_ops.ensure_vq_extension()
+        glue.load_glue_native_v3()
+    except RuntimeError as exc:
+        pytest.skip(f"Native extensions unavailable: {exc}")
+
+
+gpu_only = pytest.mark.skipif(
+    os.environ.get("CUDA_VISIBLE_DEVICES") == "",
+    reason="Skipped in CPU-only session (CUDA_VISIBLE_DEVICES='')",
+)
