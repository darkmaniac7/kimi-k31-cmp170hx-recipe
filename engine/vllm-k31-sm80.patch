+    tree, probs = dt.best_first_tree(expand, 4, branch=2)
+    # Path probabilities: a .6, aa .54, b .3, ba .15, bb .12, aaa .108, ab .03.
+    assert tree.paths == ((0,), (0, 0), (1,), (1, 0))
+    assert probs == pytest.approx((0.6, 0.54, 0.3, 0.15))
+    assert dt.expected_tokens(probs) == pytest.approx(2.59)
+    # One drafter evaluation for the root and one per selected node.
+    assert sorted(calls) == sorted([(), (0,), (0, 0), (1,), (1, 0)])
+    # branch=1 is the greedy chain.
+    chain, probs = dt.best_first_tree(lambda p: table.get(p, []), 3, branch=1)
+    assert chain.paths == dt.DraftTree.chain(3).paths
+    assert probs == pytest.approx((0.6, 0.54, 0.108))
+    # max_depth and min_path_prob bound the tree.
+    shallow, _ = dt.best_first_tree(lambda p: table.get(p, []), 8, max_depth=1)
+    assert shallow.paths == ((0,), (1,))
+    likely, _ = dt.best_first_tree(lambda p: table.get(p, []), 8, min_path_prob=0.2)
+    assert likely.paths == ((0,), (0, 0), (1,))
