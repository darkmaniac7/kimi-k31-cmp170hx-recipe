+  __shared__ alignas(16) float s_q[kD];
+  __shared__ alignas(16) float s_k[kD];
+  __shared__ alignas(16) float s_v[kD];
+  __shared__ alignas(16) float s_decay[kD];
+  __shared__ alignas(16) float s_o[kD];
+  __shared__ alignas(16) float s_nw[kD];
