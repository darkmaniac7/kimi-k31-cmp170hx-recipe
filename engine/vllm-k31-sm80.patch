+def test_runner_applies_late_drafts_before_the_input_ids_are_read():
+    """Structure of execute_model: the drafts are applied before every return
+    that follows the slot consume, before a PipeSpec chunk prepares its inputs,
+    and before the forward reads the input ids."""
+    src = inspect.getsource(GPUModelRunner.execute_model)
+    consume = src.index("self.update_pp_decode_requests()")
+    read = src.index("input_ids = input_batch.input_ids")
+    forward = src.index("self.cudagraph_manager.run_fullgraph(batch_desc)")
+    late = src.rindex("self.apply_late_drafts()", 0, read)
+    assert consume < late < read < forward
+    # Nothing between the last apply and the read enqueues GPU work.
+    assert src[late:read].count("self.") == 1
+    for marker in (
+        "empty_output = self.kv_connector.no_forward(scheduler_output)",
+        "if self._ps_pre_execute(scheduler_output):",
+    ):
+        at = src.index(marker)
+        window = src[max(0, at - 200) : at + 200]
+        assert "self.apply_late_drafts()" in window, marker
+    non_n = src.index('if self._ps_mark != "N":')
+    prep = src.index("input_batch = self.prepare_inputs(")
+    assert non_n < src.index("self.apply_late_drafts()", non_n) < prep
+
+    prepare = inspect.getsource(GPUModelRunner.prepare_inputs)
+    assert "self._late_combine_args = combine_args" in prepare
+    update = inspect.getsource(GPUModelRunner.update_pp_decode_requests)
+    assert update.index("self.apply_late_drafts()") < update.index(
+        "get_prev_sampled_outputs()"
+    )
