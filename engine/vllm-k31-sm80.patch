+"""K3.1 Lever 3 Phase B: DSpark + Suffix/N-Gram hybrid proposer unit tests.
+
+Verifies switch-off identity, strong suffix override + Adaptive-K widening,
+coherent tail extension, non-matching bit-identity, multi-request batch
+masking, probabilistic draft_logits one-hot rewriting, last_bucket purity,
+lifecycle forwarding, and zero host syncs inside propose(). CPU only.
+"""
+
+from __future__ import annotations
+
+import inspect
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.sm80.spec_decode.adaptive_k import AdaptiveKConfig, AdaptiveKPolicy
+from vllm.sm80.spec_decode.dspark_suffix_hybrid import (
+    DSparkSuffixHybridMixin,
+    blend_dspark_and_suffix,
+    compute_suffix_confidence,
+    extract_suffix_match_len,
+    suffix_hybrid_class,
+    update_draft_logits_for_suffix,
+)
+from vllm.sm80.spec_decode.dspark_width import wrap_dspark_speculator_cls
+from vllm.v1.worker.gpu.spec_decode.dspark.speculator import DSparkSpeculator
