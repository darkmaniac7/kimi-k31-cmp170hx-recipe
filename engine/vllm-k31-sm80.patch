+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Fork Qwen3 DSpark draft model with switch-gated EXL3 K6 support.
+
+Registered in ``vllm/sm80/plugin.py`` under ``DRAFTER_OVERRIDES`` for
+``Qwen3DSparkModel``.
+
+With ``VLLM_DSPARK_EXL3_K6=0`` (default) or any plain BF16 checkpoint, every
+method delegates directly to upstream ``Qwen3DSparkForCausalLM`` /
+``Qwen3DSparkModel`` with zero behavioral change.
+
+With ``VLLM_DSPARK_EXL3_K6=1`` and a ``k31q_dspark_exl3`` checkpoint:
+  - Passes ``start_layer_id`` to ``K31DSparkLayout`` via ``draft_layer_offset``
+    so draft layers ``layers.{start_layer_id + l}`` bind cleanly to checkpoint
+    ``layers.{l}``.
+  - Builds a zero-copy KV-only ``K31DenseLauncher`` over each layer's EXL3 K6
+    ``k_proj`` and ``v_proj`` packed weights (skipping ``q_proj`` during
+    Phase-1 context KV precompute, 3 launches for 5 layers).
+  - Supports vanilla, ``DSpark-GRU`` (``dspark_head_arch="gru"``), and
+    ``DSpark-AR1`` (``ar1_markov``, ``ar1_cand_embed``, ``ar1_fulllm``) plain
+    BF16 head weights stored in ``model.safetensors`` and/or
+    ``head_extra.safetensors``.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+
+import torch
+
+import vllm.envs as envs
+from vllm.config import VllmConfig
+from vllm.logger import init_logger
+from vllm.model_executor.layers.logits_processor import LogitsProcessor
+from vllm.model_executor.models import qwen3_dspark
+from vllm.sm80.kernels.exl3.quant import Exl3HeadLogitsProcessor
+from vllm.sm80.kernels.k31q import dense
+from vllm.sm80.kernels.k31q.dspark_k6 import (
+    K31DSparkExl3Config,
+    draft_layer_offset,
+    load_dspark_k6_weights,
+)
+from vllm.sm80.kernels.k31q.quant import K31DenseLinearMethod, _exl3_linear
+
+logger = init_logger(__name__)
+
+# Unit embeddings per markov_bias_local call of markov_w2_rows.
+_TABLE_ROWS = 32
+
+
+class Qwen3DSparkModel(qwen3_dspark.Qwen3DSparkModel):
+    """Qwen3 DSpark backbone with zero-copy EXL3 K6 context-KV launcher."""
+
+    def __init__(
+        self,
+        *,
+        vllm_config: VllmConfig,
+        start_layer_id: int = 0,
+        prefix: str = "",
+    ) -> None:
+        self._k31_context_kv_launcher: dense.K31DenseLauncher | None = None
+        self._k31_context_kv_weights: list = []
+        self._k31_context_kv_row_chunks: list[int] = []
+        self._k31_context_kv_dtype: torch.dtype = torch.bfloat16
+        with draft_layer_offset(start_layer_id):
+            super().__init__(
+                vllm_config=vllm_config,
+                start_layer_id=start_layer_id,
+                prefix=prefix,
+            )
+
+    def _build_fused_kv_buffers(self) -> None:
+        super()._build_fused_kv_buffers()
+        self._k31_context_kv_launcher = None
+        self._k31_context_kv_weights = []
+        self._k31_context_kv_row_chunks = []
+
+        if not (
+            envs.VLLM_DSPARK_EXL3_K6
+            and isinstance(self.quant_config, K31DSparkExl3Config)
+        ):
+            return
+
+        projs = [layer.self_attn.qkv_proj for layer in self.layers]
+        if not projs or not all(
+            isinstance(getattr(p, "quant_method", None), K31DenseLinearMethod)
+            and len(getattr(p, "exl3_weights", ())) == 3
+            for p in projs
+        ):
+            return
+
+        kv_weights = []
+        kv_chunks = []
+        for proj in projs:
+            method: K31DenseLinearMethod = proj.quant_method
+            kv_weights.append(proj.exl3_weights[1])
+            kv_weights.append(proj.exl3_weights[2])
+            row_chunks = getattr(method, "row_chunks", None)
+            if row_chunks is not None and len(row_chunks) >= 3:
+                kv_chunks.append(row_chunks[1])
+                kv_chunks.append(row_chunks[2])
+            else:
+                kv_chunks.extend([1 << 20, 1 << 20])
+
+        first_method: K31DenseLinearMethod = projs[0].quant_method
+        out_dtype = first_method.out_dtype
+        launch_rows = first_method.launch_rows
+        launcher, reason = dense.select_launcher(kv_weights, out_dtype, launch_rows)
+        self._k31_context_kv_weights = kv_weights
+        self._k31_context_kv_row_chunks = kv_chunks
+        self._k31_context_kv_dtype = out_dtype
+        self._k31_context_kv_launcher = launcher
+        logger.info_once(
+            "DSpark EXL3 K6 context-KV fast path: %d K/V projections (%d layers), "
+            "backend=%s%s.",
+            len(kv_weights),
+            len(projs),
+            "k31" if launcher is not None else "exl3",
+            f" ({len(launcher.groups)} launches)"
+            if launcher is not None
+            else f" ({reason})",
+        )
+
+    def _project_context_kv_token_major(
+        self,
+        context_states: torch.Tensor,
+        num_ctx: int,
+        num_layers: int,
+        num_kv_heads: int,
+        head_dim: int,
+    ) -> torch.Tensor:
+        if not self._k31_context_kv_weights:
+            return super()._project_context_kv_token_major(
+                context_states, num_ctx, num_layers, num_kv_heads, head_dim
+            )
+        normed_context_states = self._normalize_context_states(context_states)
+        x2d = normed_context_states.reshape(num_ctx, -1).contiguous()
+        launcher = self._k31_context_kv_launcher
+        if launcher is not None and launcher.takes(num_ctx):
+            all_kv_flat = launcher(x2d, self._k31_context_kv_dtype)
+        else:
+            outputs = [
+                _exl3_linear(x2d, w, chunk, self._k31_context_kv_dtype)
+                for w, chunk in zip(
+                    self._k31_context_kv_weights,
+                    self._k31_context_kv_row_chunks,
+                    strict=True,
+                )
+            ]
+            all_kv_flat = torch.cat(outputs, dim=-1)
+        return all_kv_flat.view(num_ctx, num_layers, 2, num_kv_heads, head_dim)
+
+
+class Qwen3DSparkForCausalLM(qwen3_dspark.Qwen3DSparkForCausalLM):
+    """Fork Qwen3 DSpark drafter supporting optional EXL3 K6 quantization."""
+
+    model_cls = Qwen3DSparkModel
+
+    def __init__(self, *, vllm_config: VllmConfig, prefix: str = "") -> None:
+        self._k31_markov_local_cache: dict[tuple[int, int, torch.dtype], tuple] = {}
+        super().__init__(vllm_config=vllm_config, prefix=prefix)
+        if type(self.logits_processor) is LogitsProcessor and (
+            isinstance(self.model.quant_config, K31DSparkExl3Config)
+            or getattr(vllm_config.model_config, "quantization", None) == "k31q"
+        ):
+            orig_head_dtype = self.logits_processor.head_dtype
+            Exl3HeadLogitsProcessor.adopt(self.logits_processor)
+            self.logits_processor.head_dtype = orig_head_dtype
+
+    def combine_hidden_states(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        if (
+            self.model.use_aux_hidden_state
+            and getattr(self, "aux_fc_folded", False)
+            and not hasattr(self.model.fc, "weight")
+        ):
+            assert hidden_states.shape[-1] == self.model.fc.output_size, (
+                hidden_states.shape
+            )
+            return hidden_states.to(self.model.fc.params_dtype)
+        return super().combine_hidden_states(hidden_states)
+
+    def apply_markov_bias_gathered(
+        self,
+        markov_embed: torch.Tensor,
+        logits: torch.Tensor,
+        values: torch.Tensor,
+        index: torch.Tensor,
+    ) -> torch.Tensor:
+        if isinstance(
+            getattr(self.model.markov_head.markov_w2, "quant_method", None),
+            K31DenseLinearMethod,
+        ):
+            raise RuntimeError(
+                "EXL3 K6 DSpark uses full-vocabulary markov_w2 and does not "
+                "support gathered top-k truncation (dspark_draft_topk)."
+            )
+        return super().apply_markov_bias_gathered(
+            markov_embed, logits, values, index
+        )
+
+    def markov_bias_local(
+        self, markov_embed: torch.Tensor, col_start: int, n_cols: int
+    ) -> torch.Tensor:
+        mw2 = self.model.markov_head.markov_w2
+        method = getattr(mw2, "quant_method", None)
+        weights = getattr(mw2, "exl3_weights", ())
+        head_dtype = self.logits_processor.head_dtype or markov_embed.dtype
+        if (
+            not envs.VLLM_DSPARK_EXL3_K6
+            or not isinstance(method, K31DenseLinearMethod)
+            or len(weights) != 1
+            or col_start < 0
+            or n_cols <= 0
+            or col_start % 128 != 0
+            or head_dtype not in (torch.bfloat16, torch.float32)
+        ):
+            return super().markov_bias_local(markov_embed, col_start, n_cols)
+        w = weights[0]
+        n_pad = ((n_cols + 127) // 128) * 128
+        if col_start + n_pad > w.padded_out or not markov_embed.is_cuda:
+            return super().markov_bias_local(markov_embed, col_start, n_cols)
+        key = (int(col_start), int(n_cols), head_dtype)
+        cached = self._k31_markov_local_cache.get(key)
+        if cached is None:
+            if torch.cuda.is_current_stream_capturing():
+                return super().markov_bias_local(markov_embed, col_start, n_cols)
+            t0 = col_start // 16
+            t1 = (col_start + n_pad) // 16
+            trel_sub = w.trellis[:, t0:t1, :].contiguous()
+            svh_sub = w.svh[col_start : col_start + n_pad].contiguous()
+            ops_mod, reason = dense.native_or_reason()
+            if ops_mod is None:
+                return super().markov_bias_local(markov_embed, col_start, n_cols)
+            ws_elems = ops_mod.linear_workspace_size_k31(
+                method.launch_rows, w.padded_in, n_pad, 1
+            )
+            dense.require_workspace(markov_embed.device, ws_elems)
+            _ = dense._workspace(markov_embed.device)
+            cached = (
+                [trel_sub],
+                [w.suh],
+                [svh_sub],
+                [int(w.matrix.bits_x2)],
+                [int(n_cols)],
+                int(method.launch_rows),
+            )
+            self._k31_markov_local_cache[key] = cached
+        trels, suhs, svhs, b2s, los, lrows = cached
+        out = dense._dense_linear(
+            markov_embed.to(self.model.markov_head.markov_w1.weight.dtype).contiguous(),
+            trels,
+            suhs,
+            svhs,
+            b2s,
+            los,
+            lrows,
+            head_dtype,
+        )
+        scale = getattr(self.logits_processor, "scale", 1.0)
+        if scale != 1.0:
+            out = out * scale
+        return out
+
+    def markov_w2_rows(self, col_start: int, n_cols: int) -> torch.Tensor:
+        """Rows ``col_start .. col_start + n_cols - 1`` of ``markov_w2`` as a
+        dense [n_cols, rank] BF16 tensor on this rank's device."""
+        w1 = self.model.markov_head.markov_w1.weight
+        if w1.is_cuda and torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("markov_w2_rows must be built before graph capture")
+        rank_dim = w1.shape[1]
+        if col_start < 0 or n_cols < 0:
+            raise ValueError(f"{n_cols} columns from {col_start}")
+        rows = torch.empty(n_cols, rank_dim, dtype=torch.bfloat16, device=w1.device)
+        if not n_cols:
+            return rows
+        eye = torch.eye(rank_dim, dtype=w1.dtype, device=w1.device)
+        for first in range(0, rank_dim, _TABLE_ROWS):
+            units = eye[first : first + _TABLE_ROWS]
+            bias = self.markov_bias_local(units, col_start, n_cols)
+            rows[:, first : first + units.shape[0]] = bias.to(torch.bfloat16).t()
+        return rows
+
+    def load_plain_weights(self, weights: Iterable[tuple[str, torch.Tensor]]):
+        """Load plain BF16 tensors (norms, markov_w1, gru_head/ar1_head, confidence_head)."""
+        return super().load_weights(weights)
+
+    def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]):
+        if isinstance(self.model.quant_config, K31DSparkExl3Config):
+            if getattr(self, "_k31_dspark_k6_loaded", False):
+                return set()
+            report = load_dspark_k6_weights(self, self.draft_model_config)
+            return report.loaded
+        return super().load_weights(weights)
