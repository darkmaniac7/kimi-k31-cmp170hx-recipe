+import pytest
+
+import vllm.envs as envs
+from vllm.sm80 import envs as fork_envs
+
+RENAMED = {
+    "VLLM_GLM5_DECODE_MOE_MAX_TOKENS": "VLLM_MOE_MASK_PADDING_MAX_TOKENS",
