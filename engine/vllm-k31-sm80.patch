diff --git a/vllm/sm80/spec_decode/adaptive_k.py b/vllm/sm80/spec_decode/adaptive_k.py
new file mode 100644
index 0000000000..ec74a8bb61
--- /dev/null
+++ b/vllm/sm80/spec_decode/adaptive_k.py
@@ -0,0 +1,848 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Load-adaptive speculative draft count (host-side).
+
+Picks the number of draft tokens to *verify* per scheduler step from the
+number of requests the server holds (``by_load``), optionally refined by the
+recent per-draft acceptance of the running requests (``accept``), and can ask
+the drafter to draft only that width (``draft_by_load``). Everything here is
+pure Python running on the scheduler's CPU thread: nothing is trimmed on the
+device, so it composes with attention backends (e.g. the DSA indexer) that
+reject vLLM's device-side ``enable_adaptive_verification``.
+
+Because decode runs under uniform-batch full CUDA graphs, the choice is made
+once per step for the whole batch and is always one of the draft counts that
+have captured graphs.
+
+Width tiers (K3.1 lever 3, ``tiers`` and ``confidence``): the step verifies
+one of a fixed list of draft counts (one decode graph set per tier), chosen
+per request from a summary of the drafter's confidence for the newest block
+whose output reached the host and of the request's recent acceptance, with a
+Schmitt-trigger hysteresis per request; the step takes the widest request's
+tier. The drafter always drafts ``num_speculative_tokens`` (the widest tier),
+so the confidences of every position exist and the step verifies a prefix.
+Under async scheduling the newest confidence describes the block one round
+older than the one being verified (``age`` 1 under pipeline parallelism and
+async scheduling, 0 with synchronous scheduling); a confidence older than
+``max_age`` rounds is ignored and acceptance alone decides.
+"""
+
+import math
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+from typing import Any
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+# Keys accepted in the ``adaptive_k`` speculative-config mapping.
+_CONFIG_KEYS = frozenset(
+    {
+        "by_load",
+        "draft_by_load",
+        "accept",
+        "log_interval",
+        "tiers",
+        "tier_preset",
+        "confidence",
+    }
+)
+_CONFIDENCE_KEYS = frozenset(
+    {
+        "thresholds",
+        "hysteresis",
+        "accept_weight",
+        "max_age",
+        "prior",
+        "decay",
+        "strength",
+    }
+)
+# Scheduler outputs whose per-request step stamps are still awaited (bounded).
+_MAX_STAMPED_STEPS = 256
+# Tiers of a ``confidence`` block given without ``tiers`` (rows 4 to 13).
+SAFE_TIERS = (3, 5, 7, 9)
+FULL_TIERS = (3, 5, 7, 9, 12)
+DEFAULT_TIERS = FULL_TIERS
+TIER_PRESETS: dict[str, tuple[int, ...]] = {
+    "safe": SAFE_TIERS,
+    "full": FULL_TIERS,
+}
+
+
+def expected_accepted(probs: Sequence[float], width: int) -> float:
+    """Expected accepted drafts of a block of ``width`` drafts whose position
+    i is accepted with probability ``probs[i]`` given the earlier ones were:
+    sum over i of prod_{j <= i} probs[j]."""
+    total = 0.0
+    run = 1.0
+    for p in list(probs)[:width]:
+        run *= min(max(float(p), 0.0), 1.0)
+        total += run
+    return total
+
+
+def geometric_expected_accepted(p: float, width: int) -> float:
+    """``expected_accepted`` with the same probability ``p`` at every
+    position."""
+    p = min(max(p, 0.0), 1.0)
+    return sum(p**i for i in range(1, width + 1))
+
+
+def width_summary(
+    confidence: Sequence[float] | None,
+    accept_rate: float,
+    width: int,
+    accept_weight: float,
+) -> float:
+    """The scalar the tier thresholds compare against: expected accepted
+    drafts at ``width`` from the drafter's confidences, blended with the same
+    figure from the request's per-draft acceptance rate. Without a usable
+    confidence (none yet, or too old) acceptance alone decides."""
+    from_accept = geometric_expected_accepted(accept_rate, width)
+    if confidence is None:
+        return from_accept
+    from_conf = expected_accepted(confidence, width)
+    return (1.0 - accept_weight) * from_conf + accept_weight * from_accept
+
+
+def tier_index(
+    summary: float,
+    thresholds: Sequence[float],
+    current: int | None,
+    hysteresis: float,
+) -> int:
+    """Index into the tier list for ``summary``: the number of thresholds at
+    or below it. With a ``current`` index the band is widened by
+    ``hysteresis`` on both sides (a Schmitt trigger): the index moves up only
+    when the summary clears the next threshold by the margin, and down only
+    when it falls the margin below the current band's lower threshold."""
+    if current is None:
+        return sum(1 for t in thresholds if summary >= t)
+    up = sum(1 for t in thresholds if summary >= t + hysteresis)
+    down = sum(1 for t in thresholds if summary >= t - hysteresis)
+    return min(max(current, up), down)
+
+
+@dataclass(frozen=True)
+class ConfidenceTierConfig:
+    """Validated ``adaptive_k.confidence`` block."""
+
+    # One fewer than the tiers, nondecreasing, in expected accepted drafts at
+    # ``width`` (the summary of ``width_summary``).
+    thresholds: tuple[float, ...]
+    # Positions of the summary: the drafted block (num_speculative_tokens).
+    width: int
+    hysteresis: float = 0.25
+    # Weight of recent acceptance in the summary; 1.0 needs no confidence head.
+    accept_weight: float = 0.5
+    # Rounds; a request's newest confidence older than this is ignored.
+    max_age: int = 2
+
+    @property
+    def needs_draft_confidence(self) -> bool:
+        return self.accept_weight < 1.0
+
+
+def _finite_float(name: str, value: Any) -> float:
+    try:
+        v = float(value)
+    except (TypeError, ValueError):
+        raise ValueError(f"adaptive_k.confidence.{name} must be a number.") from None
+    if not math.isfinite(v):
+        raise ValueError(f"adaptive_k.confidence.{name} must be finite.")
+    return v
+
+
+def _parse_tiers(raw_tiers: Any, num_speculative_tokens: int) -> tuple[int, ...]:
+    if not isinstance(raw_tiers, (list, tuple)) or not raw_tiers:
+        raise ValueError(
+            "adaptive_k.tiers must be a non-empty list of draft counts, e.g. "
+            "[3, 5, 7, 9, 12]."
+        )
+    if any(isinstance(k, bool) or not isinstance(k, int) for k in raw_tiers):
+        raise ValueError(f"adaptive_k.tiers must be integers, got {list(raw_tiers)}.")
+    tiers = tuple(raw_tiers)
+    if list(tiers) != sorted(set(tiers)):
+        raise ValueError(
+            f"adaptive_k.tiers must be strictly increasing, got {list(tiers)}."
+        )
+    illegal = [k for k in tiers if not 1 <= k <= num_speculative_tokens]
+    if illegal:
+        raise ValueError(
+            f"adaptive_k.tiers contains {illegal}, outside "
+            f"[1, num_speculative_tokens={num_speculative_tokens}]."
+        )
+    return tiers
+
+
+def _parse_confidence(
+    raw_conf: Any, tiers: tuple[int, ...], num_speculative_tokens: int
+) -> tuple[ConfidenceTierConfig, dict[str, float]]:
+    if not isinstance(raw_conf, dict):
+        raise ValueError("adaptive_k.confidence must be a mapping.")
+    unknown = set(raw_conf) - _CONFIDENCE_KEYS
+    if unknown:
+        raise ValueError(
+            f"Unknown adaptive_k.confidence keys {sorted(unknown)}; expected a "
+            f"subset of {sorted(_CONFIDENCE_KEYS)}."
+        )
+    if "thresholds" not in raw_conf:
+        raise ValueError(
+            "adaptive_k.confidence needs thresholds (one per tier boundary, "
+            "fitted from a confidence dump with vllm.sm80.spec_decode.tier_fit)."
+        )
+    raw_thresholds = raw_conf["thresholds"]
+    if not isinstance(raw_thresholds, (list, tuple)):
+        raise ValueError("adaptive_k.confidence.thresholds must be a list.")
+    thresholds = tuple(_finite_float("thresholds", t) for t in raw_thresholds)
+    if len(thresholds) != len(tiers) - 1:
+        raise ValueError(
+            f"adaptive_k.confidence.thresholds needs {len(tiers) - 1} values "
+            f"for tiers {list(tiers)}, got {len(thresholds)}."
+        )
+    if list(thresholds) != sorted(thresholds):
+        raise ValueError("adaptive_k.confidence.thresholds must be nondecreasing.")
+    hysteresis = _finite_float("hysteresis", raw_conf.get("hysteresis", 0.25))
+    accept_weight = _finite_float("accept_weight", raw_conf.get("accept_weight", 0.5))
+    raw_age = raw_conf.get("max_age", 2)
+    if isinstance(raw_age, bool) or not isinstance(raw_age, int) or raw_age < 0:
+        raise ValueError("adaptive_k.confidence.max_age must be an integer >= 0.")
+    prior = _finite_float("prior", raw_conf.get("prior", 0.75))
+    decay = _finite_float("decay", raw_conf.get("decay", 0.9))
+    strength = _finite_float("strength", raw_conf.get("strength", 2.0))
+    if hysteresis < 0:
+        raise ValueError("adaptive_k.confidence.hysteresis must be >= 0.")
+    if not 0.0 <= accept_weight <= 1.0:
+        raise ValueError("adaptive_k.confidence.accept_weight must be in [0, 1].")
+    if not 0.0 < prior < 1.0 or not 0.0 <= decay < 1.0 or strength <= 0:
+        raise ValueError(
+            "adaptive_k.confidence: prior must be in (0, 1), decay in [0, 1) "
+            "and strength > 0."
+        )
+    conf = ConfidenceTierConfig(
+        thresholds=thresholds,
+        width=num_speculative_tokens,
+        hysteresis=hysteresis,
+        accept_weight=accept_weight,
+        max_age=raw_age,
+    )
+    return conf, dict(prior=prior, decay=decay, strength=strength)
+
+
+def wants_draft_confidence(vllm_config: Any) -> bool:
+    """Whether the confidence tier policy reads the drafter's confidence head
+    (so the drafter must run it and the last rank must send it to the host)."""
+    spec = getattr(vllm_config, "speculative_config", None)
+    config = getattr(spec, "adaptive_k_config", None) if spec is not None else None
+    conf = getattr(config, "confidence", None)
+    return conf is not None and conf.needs_draft_confidence
+
+
+_warned_pcp = False
+
+
+def attach_draft_confidences(
+    async_output: Any,
+    speculator: Any,
+    num_reqs: int,
+    main_stream: Any,
+    copy_stream: Any,
+    pcp: bool = False,
+) -> bool:
+    """Worker side of the confidence tiers (last PP rank, after the drafter
+    ran): hand the confidences of the block just drafted, one row per request
+    in batch order, to the step's async output, which copies them to the host
+    with the sampled tokens. Returns whether it did."""
+    global _warned_pcp
+    if pcp:
+        # Prefill context parallelism reorders the batch around sampling.
+        if not _warned_pcp:
+            logger.warning(
+                "adaptive_k confidence tiers: no drafter confidences with "
+                "prefill context parallelism; acceptance alone decides."
+            )
+            _warned_pcp = True
+        return False
+    if not getattr(speculator, "use_confidence_head", False):
+        return False
+    if getattr(speculator, "context_kv_only", False):
+        return False
+    probs = speculator.draft_token_confidence_probs
+    width = min(int(getattr(speculator, "num_speculative_steps", probs.shape[1])),
+                probs.shape[1])
+    # A clone on the producer stream: the next draft step rewrites the buffer
+    # before the copy stream may have run.
+    rows = probs[:num_reqs, :width].clone()
+    async_output.add_draft_confidences(rows, main_stream, copy_stream)
+    return True
+
+
+@dataclass
+class AdaptiveKConfig:
+    """Validated form of the ``adaptive_k`` speculative-config mapping."""
+
+    # The verification width for 1, 2, ... requests in the server; the last
+    # entry covers every larger count.
+    by_load: tuple[int, ...]
+    # Draft counts that may be chosen, and therefore the counts that decode
+    # CUDA graphs must be captured for. Always sorted.
+    allowed: tuple[int, ...]
+    log_interval: int = 0
+    # Also draft only the width the next step verifies (the drafter must
+    # support per-width drafting; otherwise it drafts its full block and the
+    # scheduler still verifies the load width).
+    draft_by_load: bool = False
+    # Also weigh recent draft acceptance (acceptance-aware depth).
+    # accept_costs[i] is the relative step cost of verifying allowed[i]
+    # drafts; the step takes the depth (at most the load width) that
+    # maximises expected tokens per unit cost over the batch.
+    accept: bool = False
+    accept_costs: tuple[float, ...] = ()
+    # Costs for steps of two or more requests (empty: accept_costs).
+    accept_costs_multi: tuple[float, ...] = ()
+    accept_hysteresis: float = 0.03
+    accept_prior: float = 0.75
+    accept_decay: float = 0.9
+    accept_strength: float = 2.0
+    # Width tiers (``tiers``): the draft counts a step may verify; then
+    # ``allowed`` is exactly this list. Empty when not configured.
+    tiers: tuple[int, ...] = ()
+    # Confidence tier policy (``confidence``); None when off.
+    confidence: ConfidenceTierConfig | None = None
+
+    def k_for_load(self, num_reqs: int) -> int:
+        """Verification width for ``num_reqs`` requests."""
+        return self.by_load[min(max(num_reqs, 1), len(self.by_load)) - 1]
+
+    def max_reqs_for(self, k: int, max_num_reqs: int) -> int:
+        """Largest request count at which ``k`` is verified, so decode CUDA
+        graphs for ``k`` are needed only up to it; 0 when ``k`` is never
+        picked."""
+        if k not in self.allowed:
+            return 0
+        if k <= self.by_load[-1]:
+            return max_num_reqs
+        # A step verifies at most the load width, so depth k runs only while
+        # the load width is at least k (exactly the load width without the
+        # acceptance-aware choice, which then only lists load widths).
+        widest = 0
+        for n, value in enumerate(self.by_load, start=1):
+            if value >= k:
+                widest = n
+        return min(widest, max_num_reqs)
+
+    @classmethod
+    def from_dict(cls, raw: Any, num_speculative_tokens: int) -> "AdaptiveKConfig":
+        """Build from the user mapping.
+
+        ``num_speculative_tokens`` is the hard upper bound: it sizes the
+        drafter's buffers and the widest captured decode graph, so no load
+        width can exceed it.
+
+        Every count in ``1..num_speculative_tokens`` is legal for both drafter
+        families, because the count is applied to *verification*: an
+        autoregressive drafter (MTP) proposes into a fixed-width buffer, and a
+        DFlash block drafter emits its whole block in one fixed-shape pass
+        unless ``draft_by_load`` gives it one graph set per width. In both
+        cases a step verifies a prefix of the drafts and discards the tail,
+        which is what keeps this CUDA-graph-safe.
+        """
+        if not isinstance(raw, dict):
+            raise ValueError(
+                "speculative_config.adaptive_k must be a mapping, e.g. "
+                '{"by_load": [7, 5, 3]}.'
+            )
+        tiers: tuple[int, ...] = ()
+        raw_preset = raw.get("tier_preset")
+        if raw_preset is not None:
+            if (
+                not isinstance(raw_preset, str)
+                or raw_preset.strip().lower() not in TIER_PRESETS
+            ):
+                raise ValueError(
+                    f"adaptive_k.tier_preset must be one of {sorted(TIER_PRESETS)}, "
+                    f"got {raw_preset!r}."
+                )
+            raw_preset = raw_preset.strip().lower()
+        if raw.get("tiers") is not None:
+            tiers = _parse_tiers(raw["tiers"], num_speculative_tokens)
+            if raw.get("accept") is not None:
+                raise ValueError(
+                    "adaptive_k.tiers with adaptive_k.accept: both pick the "
+                    "verified depth; use tiers with confidence."
+                )
+            if "by_load" not in raw:
+                # The load never narrows the width: every tier at every load.
+                raw = dict(raw, by_load=[tiers[-1]])
+        elif raw_preset is not None or raw.get("confidence") is not None:
+            preset_name = raw_preset
+            if preset_name is None:
+                import vllm.envs as envs
+
+                env_preset = getattr(envs, "VLLM_K31_ADAPTIVE_K_TIER_PRESET", "")
+                if env_preset:
+                    if env_preset not in TIER_PRESETS:
+                        raise ValueError(
+                            "VLLM_K31_ADAPTIVE_K_TIER_PRESET must be one of "
+                            f"{sorted(TIER_PRESETS)}, got {env_preset!r}."
+                        )
+                    preset_name = env_preset
+            chosen_default = TIER_PRESETS[preset_name] if preset_name else DEFAULT_TIERS
+            if num_speculative_tokens < chosen_default[-1]:
+                raise ValueError(
+                    "adaptive_k.confidence without adaptive_k.tiers uses the default "
+                    f"tiers {list(chosen_default)}, which need num_speculative_tokens "
+                    f">= {chosen_default[-1]} (got {num_speculative_tokens}); give "
+                    "adaptive_k.tiers."
+                )
+            tiers = chosen_default
+            if raw.get("accept") is not None:
+                raise ValueError(
+                    "adaptive_k.confidence with adaptive_k.accept: both pick the "
+                    "verified depth."
+                )
+            if "by_load" not in raw:
+                raw = dict(raw, by_load=[tiers[-1]])
+        if raw.get("confidence") is not None and raw.get("draft_by_load"):
+            raise ValueError(
+                "adaptive_k.confidence with draft_by_load: the policy reads the "
+                "confidences of the whole drafted block to widen the step, so "
+                "the drafter must draft num_speculative_tokens."
+            )
+        if "by_load" not in raw:
+            raise ValueError(
+                "speculative_config.adaptive_k needs by_load (the draft count "
+                "for 1, 2, ... requests, the last covering the rest); the "
+                "acceptance-EMA policy (min/max/ema/margin/quantile/allowed) "
+                "has been removed."
+            )
+        unknown = set(raw) - _CONFIG_KEYS
+        if unknown:
+            raise ValueError(
+                f"Unknown adaptive_k keys {sorted(unknown)}; "
+                f"expected a subset of {sorted(_CONFIG_KEYS)}."
+            )
+        if num_speculative_tokens <= 0:
+            raise ValueError(
+                "adaptive_k requires num_speculative_tokens > 0 (it is the "
+                "maximum draft count and sizes the drafter's buffers)."
+            )
+
+        log_interval = int(raw.get("log_interval", 0))
+        if log_interval < 0:
+            raise ValueError("adaptive_k.log_interval must be >= 0.")
+
+        raw_by_load = raw["by_load"]
+        if not isinstance(raw_by_load, (list, tuple)) or not raw_by_load:
+            raise ValueError(
+                "adaptive_k.by_load must be a non-empty list of draft "
+                "counts (for 1, 2, ... requests; the last covers the rest)."
+            )
+        by_load = tuple(int(k) for k in raw_by_load)
+        illegal = sorted({k for k in by_load if not 1 <= k <= num_speculative_tokens})
+        if illegal:
+            raise ValueError(
+                f"adaptive_k.by_load contains {illegal}, outside "
+                f"[1, num_speculative_tokens={num_speculative_tokens}]."
+            )
+        allowed = tuple(sorted(set(by_load)))
+        accept_kwargs: dict[str, Any] = {}
+        raw_accept = raw.get("accept")
+        if raw_accept is not None:
+            if not isinstance(raw_accept, dict):
+                raise ValueError("adaptive_k.accept must be a mapping.")
+            # The acceptance-aware choice may pick any depth from the
+            # shallowest load width up to the deepest one.
+            allowed = tuple(range(min(by_load), max(by_load) + 1))
+            costs = tuple(float(c) for c in raw_accept.get("costs", ()))
+            if len(costs) != len(allowed) or min(costs, default=0.0) <= 0:
+                raise ValueError(
+                    f"adaptive_k.accept.costs needs one positive cost per "
+                    f"draft count {list(allowed)}, got {list(costs)}."
+                )
+            costs_multi = tuple(
+                float(c) for c in raw_accept.get("costs_multi", ()) or ()
+            )
+            if costs_multi and (
+                len(costs_multi) != len(allowed) or min(costs_multi) <= 0
+            ):
+                raise ValueError(
+                    f"adaptive_k.accept.costs_multi needs one positive cost "
+                    f"per draft count {list(allowed)}, got {list(costs_multi)}."
+                )
+            hysteresis = float(raw_accept.get("hysteresis", 0.03))
+            prior = float(raw_accept.get("prior", 0.75))
+            decay = float(raw_accept.get("decay", 0.9))
+            if not 0.0 <= hysteresis < 1.0:
+                raise ValueError("adaptive_k.accept.hysteresis must be in [0, 1).")
+            if not 0.0 < prior < 1.0 or not 0.0 <= decay < 1.0:
+                raise ValueError(
+                    "adaptive_k.accept.prior must be in (0, 1) and decay in [0, 1)."
+                )
+            accept_kwargs = dict(
+                accept=True,
+                accept_costs=costs,
+                accept_costs_multi=costs_multi,
+                accept_hysteresis=hysteresis,
+                accept_prior=prior,
+                accept_decay=decay,
+            )
+        if tiers:
+            outside = sorted(set(by_load) - set(tiers))
+            if outside:
+                raise ValueError(
+                    f"adaptive_k.by_load lists {outside}, which adaptive_k.tiers "
+                    f"{list(tiers)} does not: every verified count needs a tier."
+                )
+            allowed = tiers
+            accept_kwargs["tiers"] = tiers
+            if raw.get("confidence") is not None:
+                conf, acc = _parse_confidence(
+                    raw["confidence"], tiers, num_speculative_tokens
+                )
+                accept_kwargs.update(
+                    confidence=conf,
+                    accept_prior=acc["prior"],
+                    accept_decay=acc["decay"],
+                    accept_strength=acc["strength"],
+                )
+        return cls(
+            by_load=by_load,
+            allowed=allowed,
+            log_interval=log_interval,
+            draft_by_load=bool(raw.get("draft_by_load", False)),
+            **accept_kwargs,
+        )
+
+
+@dataclass
+class AdaptiveKPolicy:
+    """Per-request acceptance counts and the per-step depth choice."""
+
+    config: AdaptiveKConfig
+    # Histogram of chosen k, for the periodic summary log line.
+    _k_counts: dict[int, int] = field(default_factory=dict)
+    _steps_since_log: int = 0
+    # req_id -> number of in-flight steps whose "drafts" were the scheduler's
+    # ``[-1] * k`` uniform-decode padding rather than real proposals. Those are
+    # rejected by construction, so their result is not evidence about
+    # acceptance; see :meth:`mark_padded`.
+    _pending_padded: dict[str, int] = field(default_factory=dict)
+    # Acceptance-aware depth: per request, decayed counts of accepted drafts
+    # and of rejections (a geometric model of per-draft acceptance; a step
+    # whose drafts were all accepted adds successes and no failure, so no
+    # censoring correction is needed). A request's depth depends only on its
+    # own history and on the batch it runs in: new requests start from the
+    # fixed configured prior and the hysteresis reference is per request, so
+    # an identical request run alone repeats exactly whatever ran before it.
+    _acc_s: dict[str, float] = field(default_factory=dict)
+    _acc_f: dict[str, float] = field(default_factory=dict)
+    _accept_last: dict[str, int] = field(default_factory=dict)
+    # Model-wide observed counts, for the log line only (never read by the
+    # choice).
+    _obs_s: float = 0.0
+    _obs_f: float = 0.0
+    # Confidence tiers. Per request: steps scheduled so far (any step, prefill
+    # chunks included), the newest drafter confidence that reached the host
+    # with the stamp of the step whose output carried it, and its current
+    # tier index (the hysteresis reference).
+    _steps: dict[str, int] = field(default_factory=dict)
+    _conf: dict[str, tuple[int, tuple[float, ...]]] = field(default_factory=dict)
+    _tier: dict[str, int] = field(default_factory=dict)
+    # id(scheduler_output) -> (scheduler_output, {req_id: step stamp}).
+    _stamps: dict[int, tuple[Any, dict[str, int]]] = field(default_factory=dict)
+    # Log line only: confidence ages used (-1: none usable).
+    _age_counts: dict[int, int] = field(default_factory=dict)
+
+    # ---------------------------------------------------------------- feedback
+
+    def mark_padded(self, req_id: str) -> None:
+        """Note that this step's "drafts" for ``req_id`` are padding.
+
+        The scheduler pads a request that re-enters decode with
+        ``[-1] * k`` placeholder drafts so the batch stays uniform and inside
+        its captured CUDA graph. Those placeholders are always rejected, so
+        counting the result would be a fabricated zero-acceptance sample that
+        drags the depth down for several steps. Count them here and skip the
+        matching :meth:`observe`; a request's outputs arrive in the order its
+        steps were scheduled, so a counter is enough even with pipeline
+        parallelism or async scheduling putting several steps in flight.
+        """
+        self._pending_padded[req_id] = self._pending_padded.get(req_id, 0) + 1
+
+    def observe(self, req_id: str, num_draft_tokens: int, num_accepted: int) -> None:
+        """Record one verification result for a request.
+
+        ``num_accepted`` is the number of *draft* tokens accepted (the bonus
+        token is not a draft), so it lies in ``[0, num_draft_tokens]``.
+        """
+        if num_draft_tokens <= 0:
+            return
+        pending_padded = self._pending_padded.get(req_id)
+        if pending_padded:
+            # Placeholder drafts: no information about acceptance.
+            if pending_padded == 1:
+                del self._pending_padded[req_id]
+            else:
+                self._pending_padded[req_id] = pending_padded - 1
+            return
+
+        if self.config.accept or self.config.confidence is not None:
+            accepted = min(max(num_accepted, 0), num_draft_tokens)
+            rejected = 1.0 if accepted < num_draft_tokens else 0.0
+            d = self.config.accept_decay
+            self._acc_s[req_id] = d * self._acc_s.get(req_id, 0.0) + accepted
+            self._acc_f[req_id] = d * self._acc_f.get(req_id, 0.0) + rejected
+            gd = 0.999
+            self._obs_s = gd * self._obs_s + accepted
+            self._obs_f = gd * self._obs_f + rejected
+
+    def forget(self, req_id: str) -> None:
+        self._pending_padded.pop(req_id, None)
+        self._acc_s.pop(req_id, None)
+        self._acc_f.pop(req_id, None)
+        self._accept_last.pop(req_id, None)
+        self._steps.pop(req_id, None)
+        self._conf.pop(req_id, None)
+        self._tier.pop(req_id, None)
+
+    # ---------------------------------------------------- confidence tiers
+
+    def note_scheduled(self, scheduler_output: Any) -> None:
+        """Stamp every request of a scheduled step with its step count, so
+        the confidence its output carries can be aged (confidence tiers
+        only)."""
+        if self.config.confidence is None:
+            return
+        ps_marks = getattr(scheduler_output, "pipespec_markers", None) or {}
+        stamps: dict[str, int] = {}
+        for req_id in scheduler_output.num_scheduled_tokens:
+            if ps_marks.get(req_id) == "B":
+                # PipeSpec Chunk B belongs to the same epoch as its Chunk A;
+                # sharing A's epoch stamp keeps confidence age == 1 under async PP.
+                n = self._steps.get(req_id, 0)
+            else:
+                n = self._steps.get(req_id, 0) + 1
+                self._steps[req_id] = n
+            stamps[req_id] = n
+        if not stamps:
+            return
+        self._stamps[id(scheduler_output)] = (scheduler_output, stamps)
+        while len(self._stamps) > _MAX_STAMPED_STEPS:
+            del self._stamps[next(iter(self._stamps))]
+
+    def take_stamps(self, scheduler_output: Any) -> dict[str, int]:
+        """The stamps ``note_scheduled`` gave this step's requests (once)."""
+        entry = self._stamps.pop(id(scheduler_output), None)
+        if entry is None or entry[0] is not scheduler_output:
+            return {}
+        return entry[1]
+
+    def observe_confidence(
+        self, req_id: str, stamp: int | None, confidence: Sequence[float] | None
+    ) -> None:
+        """Record the drafter's per-position confidences for the block the
+        request verifies in its next step, carried by the output of its step
+        ``stamp``."""
+        if stamp is None or confidence is None or req_id not in self._steps:
+            return
+        old = self._conf.get(req_id)
+        if old is None or stamp > old[0]:
+            self._conf[req_id] = (stamp, tuple(float(x) for x in confidence))
+
+    def confidence_age(self, req_id: str) -> int | None:
+        """Rounds between the block the newest confidence describes and the
+        block the request's next step verifies (0: that very block). The next
+        step is number ``steps + 1``; a confidence carried by the output of
+        step j describes the block step j + 1 verifies."""
+        entry = self._conf.get(req_id)
+        if entry is None:
+            return None
+        return self._steps.get(req_id, 0) - entry[0]
+
+    def summary_for(self, req_id: str) -> tuple[float, int | None]:
+        """The request's tier summary and the age of the confidence it used
+        (None: acceptance alone)."""
+        conf_cfg = self.config.confidence
+        assert conf_cfg is not None
+        age = self.confidence_age(req_id)
+        vector = None
+        if (
+            conf_cfg.needs_draft_confidence
+            and age is not None
+            and 0 <= age <= conf_cfg.max_age
+        ):
+            vector = self._conf[req_id][1]
+        else:
+            age = None
+        summary = width_summary(
+            vector, self.accept_rate(req_id), conf_cfg.width, conf_cfg.accept_weight
+        )
+        return summary, age
+
+    def snapshot_tiers(self, req_ids: Sequence[str]) -> dict[str, int | None]:
+        """Capture each request's current hysteresis tier before selection."""
+        return {r: self._tier.get(r) for r in req_ids}
+
+    def restore_tiers(
+        self,
+        snapshot: dict[str, int | None],
+        unscheduled_ids: Sequence[str],
+    ) -> None:
+        """Undo hysteresis-tier writes for requests deferred by budget or cap."""
+        for r in unscheduled_ids:
+            if r not in snapshot:
+                continue
+            prev = snapshot[r]
+            if prev is None:
+                self._tier.pop(r, None)
+            else:
+                self._tier[r] = prev
+
+    def select_by_confidence(self, req_ids: list[str], cap: int) -> int:
+        """The step's verified count: each request's tier from its summary
+        (with hysteresis against its own last tier), the widest of them,
+        at most ``cap`` (the load width)."""
+        cfg = self.config
+        conf_cfg = cfg.confidence
+        assert conf_cfg is not None and cfg.tiers
+        if not req_ids:
+            return cap
+        widest = 0
+        for req_id in req_ids:
+            summary, age = self.summary_for(req_id)
+            index = tier_index(
+                summary,
+                conf_cfg.thresholds,
+                self._tier.get(req_id),
+                conf_cfg.hysteresis,
+            )
+            self._tier[req_id] = index
+            widest = max(widest, index)
+            if cfg.log_interval:
+                key = -1 if age is None else age
+                self._age_counts[key] = self._age_counts.get(key, 0) + 1
+        k = cfg.tiers[widest]
+        return k if k <= cap else self.snap(cap)
+
+    # ------------------------------------------------- acceptance-aware depth
+
+    def accept_prior(self) -> float:
+        """The fixed per-draft acceptance new requests start from (config,
+        never adapted at run time: a model-wide running mean would make a
+        request's depth depend on the requests before it)."""
+        return self.config.accept_prior
+
+    def observed_acceptance(self) -> float:
+        """Model-wide observed per-draft acceptance (logging only)."""
+        total = self._obs_s + self._obs_f
+        return self._obs_s / total if total else float("nan")
+
+    def accept_rate(self, req_id: str) -> float:
+        """This request's per-draft acceptance, shrunk towards the fixed
+        prior."""
+        a = self.config.accept_strength
+        p0 = self.accept_prior()
+        s = self._acc_s.get(req_id, 0.0)
+        f = self._acc_f.get(req_id, 0.0)
+        return (s + a * p0) / (s + f + a)
+
+    @staticmethod
+    def expected_tokens(p: float, k: int) -> float:
+        """Tokens a step commits at depth k (bonus included) when each draft
+        is accepted with probability p given the earlier ones were."""
+        p = min(max(p, 0.0), 0.999)
+        return (1.0 - p ** (k + 1)) / (1.0 - p)
+
+    def select_by_acceptance(self, req_ids: list[str], cap: int) -> int:
+        """The depth (a captured count, at most ``cap``, the load width) that
+        maximises the batch's expected tokens per unit step cost. Keeps the
+        current depth unless another beats it by the hysteresis margin."""
+        cfg = self.config
+        table = (
+            cfg.accept_costs_multi
+            if len(req_ids) > 1 and cfg.accept_costs_multi
+            else cfg.accept_costs
+        )
+        candidates = [(k, cost) for k, cost in zip(cfg.allowed, table) if k <= cap]
+        if not candidates or not req_ids:
+            return cap
+        rates = [self.accept_rate(r) for r in req_ids]
+        scores = {
+            k: sum(self.expected_tokens(p, k) for p in rates) / cost
+            for k, cost in candidates
+        }
+        best = max(scores, key=lambda k: (scores[k], -k))
+        # Hysteresis against the depth these requests last ran at (only when
+        # they agree on one; a request's own history, never another's).
+        lasts = {self._accept_last.get(r) for r in req_ids}
+        last = lasts.pop() if len(lasts) == 1 else None
+        if (
+            last is not None
+            and last in scores
+            and last != best
+            and scores[best] <= scores[last] * (1.0 + cfg.accept_hysteresis)
+        ):
+            best = last
+        for r in req_ids:
+            self._accept_last[r] = best
+        return best
+
+    # ------------------------------------------------------------------ policy
+
+    def snap(self, k: int) -> int:
+        """Round ``k`` down to the nearest draft count that has a CUDA graph."""
+        best = self.config.allowed[0]
+        for value in self.config.allowed:
+            if value > k:
+                break
+            best = value
+        return best
+
+    # ----------------------------------------------------------------- logging
+
+    def record_choice(self, k: int) -> None:
+        self._k_counts[k] = self._k_counts.get(k, 0) + 1
+        self._steps_since_log += 1
+
+    def maybe_log(self) -> None:
+        interval = self.config.log_interval
+        if not interval or self._steps_since_log < interval:
+            return
+        total = sum(self._k_counts.values()) or 1
+        hist = " ".join(
+            f"k={k}:{n}({100 * n / total:.0f}%)"
+            for k, n in sorted(self._k_counts.items())
+        )
+        mean_k = sum(k * n for k, n in self._k_counts.items()) / total
+        if self.config.confidence is not None:
+            ages = " ".join(
+                f"{'none' if a < 0 else a}:{n}"
+                for a, n in sorted(self._age_counts.items())
+            )
+            logger.info(
+                "Adaptive SD tiers: %d steps, mean k=%.2f, per-draft "
+                "acceptance observed=%.3f, confidence age %s, %s",
+                total,
+                mean_k,
+                self.observed_acceptance(),
+                ages or "-",
+                hist,
+            )
+            self._age_counts.clear()
+        elif self.config.accept:
+            logger.info(
+                "Adaptive SD: %d steps, mean k=%.2f, per-draft acceptance "
+                "observed=%.3f (prior %.2f), %s",
+                total,
+                mean_k,
+                self.observed_acceptance(),
+                self.accept_prior(),
+                hist,
+            )
+        else:
+            logger.info("Adaptive SD: %d steps, mean k=%.2f, %s", total, mean_k, hist)
+        self._k_counts.clear()
+        self._steps_since_log = 0
