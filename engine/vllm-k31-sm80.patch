+# -- 2. Active TP=2 wiring: call counts & exact numerics across M -------------
+
+
+@pytest.mark.parametrize("rows", [1, 4, 8, 16, 64, 256])
+def test_tp2_model_wiring_call_counts_and_exact_numerics(
+    monkeypatch, meta_platform, checkpoint, manager, rows
+):
+    """VLLM_K31_P2P_ALLREDUCE=1 at tp=2 runs 2 P2P calls per MoE layer
+    (1 attention reduce + 1 fused MoE dual-reduce/RMSNorm), 0 fallback TP
+    all-reduces, and matches the unmerged reference across M = 1..256."""
+    import vllm.distributed as vllm_dist
+    from vllm.model_executor.layers import linear as linear_mod
+    from vllm.model_executor.layers.fused_moe.runner import moe_runner
+    from vllm.models.kimi_k3.nvidia import latent_moe_runner
+    from vllm.sm80.kernels.k31q import p2p
+
+    monkeypatch.setenv("VLLM_K31_P2P_ALLREDUCE", "1")
+    monkeypatch.setenv("VLLM_K31_P2P_MAX_ROWS", str(max(64, rows)))
+
+    dense_ops = _install_dense_standin(monkeypatch)
+    p2p_ops = fake_p2p.FakeP2POps().install(monkeypatch)
+    _patch_cpu_rmsnorm(monkeypatch)
+
+    model0, _ = _build_tp_model(
+        monkeypatch, checkpoint, dense_ops, tp_size=2, tp_rank=0
+    )
+    model1, _ = _build_tp_model(
+        monkeypatch, checkpoint, dense_ops, tp_size=2, tp_rank=1
+    )
+
+    comm0, comm1, init_ok = _run_pair_init(p2p_ops, max_rows=max(64, rows))
+    assert init_ok == [True, True]
+    assert comm0.active and comm1.active
+    assert comm0.transport == "p2p_ipc" and comm1.transport == "p2p_ipc"
+
+    # Thread-local active communicator so both ranks execute concurrently in-process.
+    tls = threading.local()
+    monkeypatch.setattr(p2p, "get_active_communicator", lambda: tls.comm)
+
+    fallback_ar_calls = []
+
+    def _forbid_ar(tensor):
+        fallback_ar_calls.append(tuple(tensor.shape))
+        raise AssertionError(f"unexpected fallback TP all-reduce for {tensor.shape}")
+
+    monkeypatch.setattr(vllm_dist, "tensor_model_parallel_all_reduce", _forbid_ar)
+    monkeypatch.setattr(linear_mod, "tensor_model_parallel_all_reduce", _forbid_ar)
+    monkeypatch.setattr(moe_runner, "tensor_model_parallel_all_reduce", _forbid_ar)
+    monkeypatch.setattr(
+        latent_moe_runner, "tensor_model_parallel_all_reduce", _forbid_ar
+    )
+
+    gen = torch.Generator().manual_seed(1000 + rows)
+    hidden = fixture.TEXT["hidden_size"]
+    latent = fixture.TEXT["routed_expert_hidden_size"]
+
+    # Test Layer 0 (KDA + dense MLP), Layer 1 (KDA + MoE), and Layer 3 (MLA/DSA + MoE).
+    for layer_idx in (0, 1, 3):
+        l0 = model0.model.layers[layer_idx]
+        l1 = model1.model.layers[layer_idx]
+        p2p_ops.allreduce_calls.clear()
+        p2p_ops.moe_dual_calls.clear()
+
+        # Verify MLA/DSA shares the exact same o_proj object inside mla_attn.
+        if layer_idx == 3:
+            assert l0.self_attn.mla_attn.o_proj is l0.self_attn.o_proj
+            assert l1.self_attn.mla_attn.o_proj is l1.self_attn.o_proj
+
+        # 1) Attention o_proj partial inputs (distinct per rank).
+        in_w = l0.self_attn.o_proj.input_size_per_partition
+        x_attn_0 = (torch.randn((rows, in_w), generator=gen) / 4).to(torch.bfloat16)
+        x_attn_1 = (torch.randn((rows, in_w), generator=gen) / 4).to(torch.bfloat16)
+
+        # Reference unmerged o_proj outputs (quant_method.apply directly, then sum).
+        ref_o0 = l0.self_attn.o_proj.quant_method.apply(l0.self_attn.o_proj, x_attn_0)
+        ref_o1 = l1.self_attn.o_proj.quant_method.apply(l1.self_attn.o_proj, x_attn_1)
+        ref_attn = (ref_o0.float() + ref_o1.float()).to(torch.bfloat16)
+
+        # 2) MLP / MoE inputs.
+        if layer_idx == 0:
+            mlp_in_w = l0.mlp.down_proj.input_size_per_partition
+            x_mlp_0 = (torch.randn((rows, mlp_in_w), generator=gen) / 4).to(
+                torch.bfloat16
+            )
+            x_mlp_1 = (torch.randn((rows, mlp_in_w), generator=gen) / 4).to(
+                torch.bfloat16
+            )
+            ref_m0 = l0.mlp.down_proj.quant_method.apply(l0.mlp.down_proj, x_mlp_0)
+            ref_m1 = l1.mlp.down_proj.quant_method.apply(l1.mlp.down_proj, x_mlp_1)
+            ref_mlp = (ref_m0.float() + ref_m1.float()).to(torch.bfloat16)
+
+            def _run_l0(comm, layer, xa, xm):
+                tls.comm = comm
+                a_out, _ = layer.self_attn.o_proj(xa)
+                m_out, _ = layer.mlp.down_proj(xm)
+                return a_out, m_out
+
+            with ThreadPoolExecutor(max_workers=2) as pool:
+                f0 = pool.submit(_run_l0, comm0, l0, x_attn_0, x_mlp_0)
+                f1 = pool.submit(_run_l0, comm1, l1, x_attn_1, x_mlp_1)
+                (a0, m0), (a1, m1) = f0.result(timeout=10), f1.result(timeout=10)
+
+            assert torch.equal(a0, a1)
+            assert torch.equal(a0, ref_attn)
+            assert torch.equal(m0, m1)
+            assert torch.equal(m0, ref_mlp)
+            # Layer 0: 2 P2P allreduces per rank (4 total across 2 ranks), 0 MoE dual.
+            assert len(p2p_ops.allreduce_calls) == 4
+            assert len(p2p_ops.moe_dual_calls) == 0
+            continue
+
+        # MoE layers (layer 1 KDA+MoE, layer 3 MLA/DSA+MoE).
+        r_part_0 = (torch.randn((rows, latent), generator=gen) / 4).to(torch.bfloat16)
+        r_part_1 = (torch.randn((rows, latent), generator=gen) / 4).to(torch.bfloat16)
+        s_part_0 = (torch.randn((rows, hidden), generator=gen) / 4).to(torch.bfloat16)
+        s_part_1 = (torch.randn((rows, hidden), generator=gen) / 4).to(torch.bfloat16)
+
+        # Standalone RMSNorm must NOT be called when fused into P2P dual-reduce.
+        norm_calls = []
+        orig_norm = l0.block_sparse_moe.routed_expert_norm.forward
+
+        def _forbid_norm(*args, **kwargs):
+            norm_calls.append(1)
+            return orig_norm(*args, **kwargs)
+
+        monkeypatch.setattr(
+            l0.block_sparse_moe.routed_expert_norm, "forward", _forbid_norm
+        )
+        monkeypatch.setattr(
+            l1.block_sparse_moe.routed_expert_norm, "forward", _forbid_norm
+        )
+
+        # Unmerged reference: reduce routed -> FP32 RMSNorm -> up_proj + reduced shared.
+        ref_r_sum = r_part_0.float() + r_part_1.float()
+        norm_w = l0.block_sparse_moe.routed_expert_norm.weight
+        eps = l0.block_sparse_moe.routed_expert_norm.variance_epsilon
+        ref_r_norm = fake_p2p._fp32_rmsnorm_bf16(ref_r_sum, norm_w, eps)
+        ref_up, _ = l0.block_sparse_moe.routed_expert_up_proj(ref_r_norm)
+        ref_s_sum = (s_part_0.float() + s_part_1.float()).to(torch.bfloat16)
+        ref_moe = (ref_s_sum.float() + ref_up.float()).to(torch.bfloat16)
+
+        runner0 = l0.block_sparse_moe.experts
+        runner1 = l1.block_sparse_moe.experts
+        assert runner0._use_k31_p2p_path() and runner1._use_k31_p2p_path()
+        monkeypatch.setattr(
+            runner0, "_forward_entry", lambda *a, **kw: (s_part_0, r_part_0)
+        )
+        monkeypatch.setattr(
+            runner1, "_forward_entry", lambda *a, **kw: (s_part_1, r_part_1)
+        )
+
+        dummy_latent = torch.zeros((rows, latent), dtype=torch.bfloat16)
+        dummy_logits = torch.zeros(
+            (rows, fixture.TEXT["num_experts"]), dtype=torch.float32
+        )
+        dummy_shared_in = torch.zeros((rows, hidden), dtype=torch.bfloat16)
+
+        def _run_moe_layer(comm, layer, xa):
+            tls.comm = comm
+            o_proj = (
+                layer.self_attn.mla_attn.o_proj
+                if layer_idx == 3
+                else layer.self_attn.o_proj
+            )
+            a_out, _ = o_proj(xa)
+            m_out = layer.block_sparse_moe.experts(
+                hidden_states=dummy_latent,
+                router_logits=dummy_logits,
+                shared_experts_input=dummy_shared_in,
+            )
+            return a_out, m_out
+
+        with ThreadPoolExecutor(max_workers=2) as pool:
+            f0 = pool.submit(_run_moe_layer, comm0, l0, x_attn_0)
+            f1 = pool.submit(_run_moe_layer, comm1, l1, x_attn_1)
+            (a0, m0), (a1, m1) = f0.result(timeout=10), f1.result(timeout=10)
+
+        # Bitwise identical across ranks and exact match against unmerged reference.
+        assert torch.equal(a0, a1)
+        assert torch.equal(a0, ref_attn)
+        assert torch.equal(m0, m1)
+        assert torch.equal(m0, ref_moe)
+
+        # Exact call counts: per rank = 1 attention P2P + 1 fused MoE dual P2P = 2!
+        assert len(p2p_ops.allreduce_calls) == 2  # 1 per rank
+        assert len(p2p_ops.moe_dual_calls) == 2  # 1 per rank
+        assert p2p_ops.moe_dual_calls[0]["routed_cols"] == latent
+        assert p2p_ops.moe_dual_calls[0]["shared_cols"] == hidden
+        assert norm_calls == []
+        assert fallback_ar_calls == []
+
+    comm0.close()
+    comm1.close()
+
