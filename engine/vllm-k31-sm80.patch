+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Expected-value replay of draft-tree policies on dspark_tree_rank_dump.py
+output (measured drafter candidates on G1 teacher dumps).
+
+Every policy is replayed on the measured anchors: the drafter's candidates,
+their probabilities and whether each one matched the generated token. Step
+costs are the engine's own table (cmp_pipespec.DEFAULT_STEP_COSTS: 33.5 + 2.0
+ms per draft row; PipeSpec +11.5 ms on a hit, +5.5 ms on a miss); a tree adds
+0.1 ms plus --reload-ms per branch on top of a chain of the same size.
+
+With consecutive-anchor windows (--window of the dump) the headline numbers
+come from exact decode trajectories: a step at an anchor that yields T tokens
+is followed by the step at the anchor T positions later. Uniform-anchor means
+are printed next to them; they overweight easy positions, because a trajectory
+starts a step right after every token the drafter missed.
+
+Policies:
+  linK       chain of K drafts
+  lin_dyn    chain, K chosen per step from the confidence head (adaptive_k)
+  staticN    the best fixed tree of N nodes (fitted on the other fold)
+  dynN       the N most likely nodes by the drafter's own probabilities
+  dyn_adapt  dynN with N chosen per step for expected tokens per ms
+  dps        dynamic PipeSpec as landed: lin_dyn or a PipeSpec epoch (ck = 3)
+  dps_tree   dps where normal steps are dyn_adapt and chunk A may carry up to
+             two side nodes
+"""
+from __future__ import annotations
+
+import argparse
+import glob
+import heapq
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+
+DOMAINS = ["prose", "code", "chat", "tool", "long_ctx"]
+BRANCH = 3
+TIERS = (1, 2, 3, 4, 5, 7)
+PS_HIT, PS_MISS = 11.5, 5.5
+PS_CK = 3
+
+
+BASE_MS, ROW_MS = 33.5, 2.0
+
+
+def cost(n: int, extra: float = 0.0) -> float:
+    return BASE_MS + ROW_MS * n + extra
+
+
+def tree_extra(reloads: int, per_reload: float) -> float:
+    """What a tree adds to a chain of the same size: nothing when it is a
+    chain; else a flat mask and commit cost plus one state reload per branch."""
+    return 0.0 if reloads <= 0 else 0.1 + per_reload * reloads
+
+
+def load(pattern: str) -> dict[str, np.ndarray]:
+    files = sorted(glob.glob(pattern))
+    if not files:
+        raise SystemExit(f"no files match {pattern}")
+    parts = [np.load(f) for f in files]
+    data = {k: np.concatenate([p[k] for p in parts]) for k in parts[0].files}
+    data["file_id"] = np.concatenate(
+        [np.full(len(p["meta"]), i, np.int64) for i, p in enumerate(parts)]
+    )
+    if "actual" not in data:
+        data["actual"] = data["truth"]
+    return data
+
+
+def pav(x: np.ndarray, y: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    """Isotonic regression of y on x (pool adjacent violators)."""
+    order = np.argsort(x, kind="mergesort")
+    xs, ys = x[order].astype(np.float64), y[order].astype(np.float64)
+    vals: list[float] = []
+    wts: list[float] = []
+    ends: list[int] = []
+    for i, v in enumerate(ys):
+        vals.append(float(v))
+        wts.append(1.0)
+        ends.append(i)
+        while len(vals) > 1 and vals[-2] > vals[-1]:
+            w = wts[-2] + wts[-1]
+            merged = (vals[-2] * wts[-2] + vals[-1] * wts[-1]) / w
+            vals.pop()
+            wts.pop()
+            end = ends.pop()
+            vals[-1], wts[-1], ends[-1] = merged, w, end
+    gx, gy = [], []
+    start = 0
+    for v, e in zip(vals, ends):
+        gx.append(0.5 * (xs[start] + xs[e]))
+        gy.append(v)
+        start = e + 1
+    return np.asarray(gx), np.asarray(gy)
+
+
+class Calib:
+    """P(candidate accepted | its parent accepted) from the drafter's own
+    numbers: the confidence head for the top candidate, the softmax
+    probability for the runners-up."""
+
+    def __init__(self) -> None:
+        self.maps: dict[int, tuple[np.ndarray, np.ndarray]] = {}
+
+    def fit(self, c: int, x: np.ndarray, y: np.ndarray) -> None:
+        if len(x) < 20:
+            mean = float(y.mean()) if len(y) else 0.0
+            self.maps[c] = (np.asarray([0.0, 1.0]), np.asarray([mean, mean]))
+        else:
+            self.maps[c] = pav(x, y)
+
+    def __call__(self, c: int, x: np.ndarray) -> np.ndarray:
+        gx, gy = self.maps[c]
+        return np.interp(x, gx, gy)
+
+
+def node_tables(d: dict[str, np.ndarray], i: int):
+    """Flat candidate nodes of anchor i: id = level * B * 3 + slot * 3 + child."""
+    D, B = d["child_tok"].shape[1:3]
+    n = D * B * BRANCH
+    parent = np.full(n, -2, np.int64)  # -1 root, -2 not dumped
+    hit = np.zeros(n, np.bool_)
+    feat_q = np.zeros(n, np.float32)
+    feat_conf = np.zeros(n, np.float32)
+    next_slot = np.full(n, -1, np.int64)
+    actual = d["actual"][i]
+    for j in range(D):
+        for b in range(int(d["n_par"][i, j])):
+            pnode = -1 if j == 0 else (j - 1) * B * BRANCH + int(d["par_prev"][i, j, b])
+            phit = True if pnode < 0 else bool(hit[pnode])
+            if pnode >= 0:
+                next_slot[pnode] = b
+            for c in range(BRANCH):
+                nid = j * B * BRANCH + b * BRANCH + c
+                parent[nid] = pnode
+                feat_q[nid] = d["child_q"][i, j, b, c]
+                feat_conf[nid] = d["par_conf"][i, j, b]
+                hit[nid] = phit and int(d["child_tok"][i, j, b, c]) == int(actual[j])
+    return parent, hit, feat_q, feat_conf, next_slot
+
+
+def replay(T: np.ndarray, C: np.ndarray, starts: int = 8) -> tuple[float, float, int]:
+    """Tokens, milliseconds and steps of decode trajectories over one window
+    of consecutive anchors, summed over the first `starts` start offsets."""
+    W = len(T)
+    tok = ms = 0.0
+    steps = 0
+    for s in range(min(starts, W)):
+        i = s
+        while i < W:
+            t = int(T[i])
+            take = min(t, W - i)
+            tok += take
+            ms += C[i] * take / t
+            steps += 1
+            i += t
+    return tok, ms, steps
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--glob", required=True)
+    ap.add_argument("--reload-ms", type=float, default=0.1)
+    ap.add_argument("--boot", type=int, default=400)
+    ap.add_argument("--base-ms", type=float, default=33.5)
+    ap.add_argument("--row-ms", type=float, default=2.0)
+    ap.add_argument("--quiet", action="store_true", help="print the gain lines only")
+    ap.add_argument("--out-json", default=None)
+    ap.add_argument(
+        "--repo",
+        default=str(Path(__file__).resolve().parents[2]),
+        help="worktree holding vllm/sm80/spec_decode/draft_tree.py",
+    )
+    args = ap.parse_args()
+    global BASE_MS, ROW_MS
+    BASE_MS, ROW_MS = args.base_ms, args.row_ms
+
+    spec = importlib.util.spec_from_file_location(
+        "draft_tree", str(Path(args.repo) / "vllm/sm80/spec_decode/draft_tree.py")
+    )
+    dt = importlib.util.module_from_spec(spec)
+    sys.modules["draft_tree"] = dt
+    spec.loader.exec_module(dt)
+
+    d = load(args.glob)
+    A = d["actual"].shape[0]
+    D, B = d["child_tok"].shape[1:3]
+    dom = d["meta"][:, 2]
+    fid = d["file_id"]
+    fold = fid % 2
+    flips = 1.0 - float(d["consistent"].all(axis=1).mean())
+    print(f"files={int(fid.max()) + 1} anchors={A} depth={D} beam={B} "
+          f"anchors with a non-greedy generated token in reach: {flips:.3f}")
+
+    tabs = [node_tables(d, i) for i in range(A)]
+    NN = D * B * BRANCH
+    node_c = np.tile(np.arange(BRANCH), D * B)
+    node_j = np.repeat(np.arange(D), B * BRANCH)
+    chain_hits_all = np.cumprod(d["tf_rank"] == 0, axis=1).sum(axis=1)
+
+    # Cross-fitted calibration of P(node hit | parent hit).
+    calibs = []
+    for f in (0, 1):
+        cal = Calib()
+        xs: dict[int, list] = {c: [np.zeros(0, np.float32)] for c in range(BRANCH)}
+        ys: dict[int, list] = {c: [np.zeros(0, np.bool_)] for c in range(BRANCH)}
+        for i in range(A):
+            if fold[i] == f:
+                continue
+            parent, hit, fq, fc, _ = tabs[i]
+            valid = parent > -2
+            phit = np.where(parent >= 0, hit[np.maximum(parent, 0)], True) & valid
+            for c in range(BRANCH):
+                m = phit & (node_c == c)
+                xs[c].append((fc if c == 0 else fq)[m])
+                ys[c].append(hit[m])
+        for c in range(BRANCH):
+            cal.fit(c, np.concatenate(xs[c]), np.concatenate(ys[c]).astype(np.float64))
+        calibs.append(cal)
+
+    results: dict[str, dict] = {}
+    for dname in ["prose", "code", "chat", "all"]:
+        sel = (dom == DOMAINS.index(dname)) if dname != "all" else np.ones(A, np.bool_)
+        idx = np.nonzero(sel)[0]
+        if len(idx) < 30:
+            continue
+        tf_rank = d["tf_rank"][idx]
+        res: dict[str, object] = {
+            "anchors": int(len(idx)), "sequences": int(len(set(fid[idx].tolist())))
+        }
+
+        # Teacher-forced rank structure along the surviving chain.
+        surv = np.ones(len(idx), np.bool_)
+        rank_rows = []
+        for j in range(D):
+            r = tf_rank[surv, j]
+            n_alive = int(surv.sum())
+            miss = r > 0
+            rank_rows.append(dict(
+                depth=j + 1, alive=n_alive,
+                top1=float((r == 0).mean()) if n_alive else 0.0,
+                top2=float((r == 1).mean()) if n_alive else 0.0,
+                top3=float((r == 2).mean()) if n_alive else 0.0,
+                top2_given_miss=float((r[miss] == 1).mean()) if miss.any() else 0.0,
+                top23_given_miss=float((r[miss] <= 2).mean()) if miss.any() else 0.0,
+            ))
+            surv = surv & (tf_rank[:, j] == 0)
+        res["tf_rank_by_depth"] = rank_rows
+        res["chain_survival_uniform"] = [
+            float(np.cumprod(tf_rank == 0, axis=1)[:, j].mean()) for j in range(D)
+        ]
+
+        # Static trees from the other fold's rank-prefix frequencies.
+        static_paths: dict[int, dict[int, tuple]] = {0: {}, 1: {}}
+        for f in (0, 1):
+            fit = np.nonzero(sel & (fold != f))[0]
+            counts: dict[tuple, int] = {}
+            for i in fit:
+                p: tuple = ()
+                for j in range(D):
+                    if d["tf_rank"][i, j] >= BRANCH:
+                        break
+                    p = p + (int(d["tf_rank"][i, j]),)
+                    counts[p] = counts.get(p, 0) + 1
+            values = {p: c / max(1, len(fit)) for p, c in counts.items()}
+            for n in range(1, 8):
+                static_paths[f][n] = dt.static_tree_from_values(values, n)[0].paths
+
+        names = ([f"lin{k}" for k in range(1, 8)] + ["lin_dyn"]
+                 + [f"static{n}" for n in range(2, 8)]
+                 + [f"dyn{n}" for n in range(1, 8)] + ["dyn_adapt", "dps", "dps_tree"])
+        T = {n: np.zeros(len(idx)) for n in names}
+        C = {n: np.zeros(len(idx)) for n in names}
+        N = {n: np.zeros(len(idx)) for n in names}
+        shape_votes: dict[tuple, int] = {}
+        ps_share = {"dps": 0, "dps_tree": 0}
+
+        for k_i, i in enumerate(idx):
+            parent, hit, fq, fc, next_slot = tabs[i]
+            cal = calibs[int(fold[i])]
+            valid = parent > -2
+            cond = np.zeros(NN)
+            for c in range(BRANCH):
+                m = valid & (node_c == c)
+                cond[m] = cal(c, (fc if c == 0 else fq)[m])
+            pathp = np.zeros(NN)
+            for nid in range(NN):
+                if valid[nid]:
+                    pathp[nid] = cond[nid] * (1.0 if parent[nid] < 0 else pathp[parent[nid]])
+            chain = [j * B * BRANCH for j in range(D)]
+            ch = int(np.cumprod([bool(hit[n_]) for n_ in chain]).sum())
+            chain_hits_all[i] = ch
+            cum = np.cumprod([float(cond[n_]) for n_ in chain])
+
+            def put(name: str, t: float, c: float, n: float) -> None:
+                T[name][k_i], C[name][k_i], N[name][k_i] = t, c, n
+
+            for k in range(1, 8):
+                put(f"lin{k}", 1 + min(k, ch), cost(k), k)
+            kn = max(TIERS, key=lambda k: ((1 + cum[:k].sum()) / cost(k), -k))
+            put("lin_dyn", 1 + min(kn, ch), cost(kn), kn)
+
+            for n in range(2, 8):
+                sp = static_paths[int(fold[i])][n]
+                leaves = sum(1 for p_ in sp if not any(q_[:-1] == p_ for q_ in sp))
+                acc = dt.replay_accept_depth(sp, d["tf_rank"][i])
+                put(f"static{n}", 1 + acc, cost(n, tree_extra(leaves - 1, args.reload_ms)), n)
+
+            # Best-first dynamic tree over the dumped candidates.
+            heap = [(-pathp[c], c) for c in range(BRANCH)]
+            heapq.heapify(heap)
+            order: list[int] = []
+            while heap and len(order) < 7:
+                _, nid = heapq.heappop(heap)
+                order.append(nid)
+                s = next_slot[nid]
+                if s >= 0 and node_j[nid] + 1 < D:
+                    base = (node_j[nid] + 1) * B * BRANCH + s * BRANCH
+                    for c in range(BRANCH):
+                        if valid[base + c]:
+                            heapq.heappush(heap, (-pathp[base + c], base + c))
+            oprob = [float(pathp[n_]) for n_ in order]
+            ohit = np.cumsum([bool(hit[n_]) for n_ in order])
+            oextra: list[float] = []
+            has_child: set[int] = set()
+            for n_ in order:
+                if parent[n_] >= 0:
+                    has_child.add(int(parent[n_]))
+                leaves = sum(1 for m_ in order[: len(oextra) + 1] if m_ not in has_child)
+                oextra.append(tree_extra(leaves - 1, args.reload_ms))
+            for n in range(1, 8):
+                put(f"dyn{n}", 1 + int(ohit[n - 1]), cost(n, oextra[n - 1]), n)
+            nb = max(TIERS, key=lambda n: (dt.expected_tokens(oprob[:n]) / cost(n, oextra[n - 1]), -n))
+            put("dyn_adapt", 1 + int(ohit[nb - 1]), cost(nb, oextra[nb - 1]), nb)
+            key = []
+            for nid in order[:5]:
+                p_: list[int] = []
+                cur = nid
+                while cur >= 0:
+                    p_.append(int(node_c[cur]))
+                    cur = parent[cur]
+                key.append(tuple(reversed(p_)))
+            shape_votes[tuple(sorted(key))] = shape_votes.get(tuple(sorted(key)), 0) + 1
+
+            # Dynamic PipeSpec as landed: a chain step or an A/B epoch.
+            ck = PS_CK
+            e_a = 1 + cum[:ck].sum()
+            p_b = cum[ck]
+            e_b = 1 + (cum[ck + 1 : 2 * ck + 1] / max(cum[ck], 1e-12)).sum()
+            e_ps = e_a + p_b * e_b
+            ps_ms = cost(ck) + p_b * PS_HIT + (1 - p_b) * PS_MISS
+            b_valid = ch >= ck + 1
+            t_ps = 1 + min(ck, ch) + ((1 + min(ck, ch - (ck + 1))) if b_valid else 0)
+            if e_ps / ps_ms > (1 + cum[:kn].sum()) / cost(kn):
+                put("dps", t_ps, cost(ck) + (PS_HIT if b_valid else PS_MISS), ck)
+                ps_share["dps"] += 1
+            else:
+                put("dps", 1 + min(kn, ch), cost(kn), kn)
+
+            # Tree-aware: a dyn_adapt step, or an epoch whose chunk A carries
+            # up to two side nodes that hang off its chain or the root.
+            legal_side: list[int] = []
+            have = set(chain[:ck])
+            on_chain = set(chain)
+            for n_ in order:
+                if n_ in on_chain:
+                    continue
+                if parent[n_] < 0 or parent[n_] in have:
+                    legal_side.append(n_)
+                    have.add(n_)
+            cands = [(dt.expected_tokens(oprob[:nb]) / cost(nb, oextra[nb - 1]), "N", nb)]
+            for s in (0, 1, 2):
+                if s > len(legal_side):
+                    continue
+                e_side = sum(float(pathp[n_]) for n_ in legal_side[:s])
+                c_ms = cost(ck + s, tree_extra(s, args.reload_ms)) + p_b * PS_HIT + (1 - p_b) * PS_MISS
+                cands.append(((e_ps + e_side) / c_ms, "PS", s))
+            _, mode, arg = max(cands, key=lambda x: x[0])
+            if mode == "N":
+                put("dps_tree", 1 + int(ohit[nb - 1]), cost(nb, oextra[nb - 1]), nb)
+            else:
+                ps_share["dps_tree"] += 1
+                t = t_ps
+                if not b_valid:
+                    t = 1 + int(sum(bool(hit[n_]) for n_ in chain[:ck] + legal_side[:arg]))
+                put("dps_tree", t,
+                    cost(ck + arg, tree_extra(arg, args.reload_ms)) + (PS_HIT if b_valid else PS_MISS),
+                    ck + arg)
+
+        # Trajectory replay over windows of consecutive anchors.
+        groups = []
+        for f in sorted(set(fid[idx].tolist())):
+            loc = np.nonzero(fid[idx] == f)[0]
+            pos = d["meta"][idx[loc], 1]
+            o = np.argsort(pos)
+            if len(loc) >= 16 and np.all(np.diff(pos[o]) == 1):
+                groups.append(loc[o])
+        res["trajectory_windows"] = len(groups)
+        table = {}
+        per_group: dict[str, np.ndarray] = {}
+        for name in names:
+            row = dict(
+                tok_step_uniform=float(T[name].mean()),
+                tok_s_uniform=float(1000.0 * T[name].sum() / C[name].sum()),
+                rows_uniform=float(1 + N[name].mean()),
+            )
+            if groups:
+                g = np.asarray([replay(T[name][loc], C[name][loc]) for loc in groups])
+                per_group[name] = g
+                row.update(
+                    tok_step=float(g[:, 0].sum() / g[:, 2].sum()),
+                    ms_step=float(g[:, 1].sum() / g[:, 2].sum()),
+                    tok_s=float(1000.0 * g[:, 0].sum() / g[:, 1].sum()),
+                )
+            table[name] = row
+        res["policies"] = table
+        res["pipespec_share"] = {k: v / len(idx) for k, v in ps_share.items()}
+
+        gains = {}
+        if groups:
+            rng = np.random.default_rng(0)
+            pairs = [("dyn_adapt", "lin_dyn"), ("dps_tree", "dps"), ("dyn_adapt", "dps"),
+                     ("dyn3", "lin3"), ("dyn4", "lin4"), ("dyn5", "lin5"), ("dyn7", "lin7"),
+                     ("static4", "lin4"), ("static5", "lin5"), ("lin_dyn", "lin4")]
+
+            def rate(name: str, w: np.ndarray) -> float:
+                g = per_group[name]
+                return float((w * g[:, 0]).sum() / (w * g[:, 1]).sum())
+
+            ones = np.ones(len(groups))
+            boots = {p: [] for p in pairs}
+            for _ in range(args.boot):
+                w = np.bincount(rng.integers(0, len(groups), len(groups)),
+                                minlength=len(groups)).astype(np.float64)
+                for a_, b_ in pairs:
+                    boots[(a_, b_)].append(100.0 * (rate(a_, w) / rate(b_, w) - 1.0))
+            for a_, b_ in pairs:
+                gains[f"{a_}_vs_{b_}"] = dict(
+                    point=100.0 * (rate(a_, ones) / rate(b_, ones) - 1.0),
+                    lo=float(np.percentile(boots[(a_, b_)], 5)),
+                    hi=float(np.percentile(boots[(a_, b_)], 95)),
+                )
+            # Chain survival as the 7-wide chain's own trajectory sees it.
+            visited: list[int] = []
+            for loc in groups:
+                i = 0
+                while i < len(loc):
+                    visited.append(int(chain_hits_all[idx[loc[i]]]))
+                    i += int(T["lin7"][loc[i]])
+            v = np.asarray(visited)
+            res["chain_survival_trajectory"] = [float((v > j).mean()) for j in range(D)]
+        res["gain_pct"] = gains
+        top_shapes = sorted(shape_votes.items(), key=lambda kv: -kv[1])[:4]
+        res["dyn5_top_shapes"] = [([list(p) for p in k], v / len(idx)) for k, v in top_shapes]
+        res["static_paths_fold0"] = {n: [list(p) for p in static_paths[0][n]] for n in static_paths[0]}
+        results[dname] = res
+
+        print(f"\n== {dname}: {len(idx)} anchors, {res['sequences']} sequences, "
+              f"{len(groups)} trajectory windows")
+        if args.quiet:
+            for k_ in ("lin_dyn", "dyn_adapt", "dps", "dps_tree"):
+                print(f"  {k_:10s} {table[k_].get('tok_step', 0):.3f} tok/step "
+                      f"{table[k_].get('tok_s', 0):.2f} tok/s")
+            for k_, g_ in gains.items():
+                print(f"  gain {k_:22s} {g_['point']:+6.2f}%  ({g_['lo']:+.2f} .. {g_['hi']:+.2f})")
+            continue
+        print("teacher-forced rank of the generated token, chain alive so far:")
+        for r in rank_rows:
+            print("  d{depth} alive {alive:5d}  top1 {top1:.3f}  top2 {top2:.3f}  top3 {top3:.3f}"
+                  "  top2|miss {top2_given_miss:.3f}  top2or3|miss {top23_given_miss:.3f}".format(**r))
+        print("chain survival, uniform anchors:   ",
+              " ".join(f"{x:.3f}" for x in res["chain_survival_uniform"]))
+        if groups:
+            print("chain survival, lin7 trajectory:   ",
+                  " ".join(f"{x:.3f}" for x in res["chain_survival_trajectory"]))
+        print(f"{'policy':10s} {'tok/step':>9s} {'ms/step':>8s} {'tok/s':>7s}   "
+              f"{'uniform t/step':>14s} {'uniform tok/s':>13s} {'rows':>5s}")
+        for name, v_ in table.items():
+            print(f"{name:10s} {v_.get('tok_step', float('nan')):9.3f} "
+                  f"{v_.get('ms_step', float('nan')):8.2f} {v_.get('tok_s', float('nan')):7.2f}   "
+                  f"{v_['tok_step_uniform']:14.3f} {v_['tok_s_uniform']:13.2f} {v_['rows_uniform']:5.2f}")
+        for k_, g_ in gains.items():
+            print(f"  gain {k_:22s} {g_['point']:+6.2f}%  (90% CI by sequence {g_['lo']:+.2f} .. {g_['hi']:+.2f})")
+        print("  PipeSpec epochs chosen:", res["pipespec_share"])
+        print("  5-node dynamic shapes:", res["dyn5_top_shapes"])
+        print("  best static trees:", {n: static_paths[0][n] for n in (4, 5, 6)})
+    if args.out_json:
+        Path(args.out_json).write_text(json.dumps(results, indent=1))
+
+
+if __name__ == "__main__":
+    main()
