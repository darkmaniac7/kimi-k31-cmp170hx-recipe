+def test_r71_per_stream_workspace_and_decode_max_rows(
+    monkeypatch, meta_platform, checkpoint, manager
+):
+    """R7.1 + H4: default VLLM_K31Q_DENSE_PREFILL=exl3 sizes workspaces with
+    max_rows=32 (decode-only), and _workspace allocates 2 isolated buffers
+    (compute + aux_stream) on CUDA when aux_stream() exists so concurrent
+    launches never share workspace or arrival counters."""
+    from vllm.sm80.kernels.k31q import dense
+    from vllm.utils import torch_utils
+
+    recorded_rows = []
+    ops = fake_dense.FakeDenseOps().install(monkeypatch)
+    orig_ws_size = ops.linear_workspace_size_k31
+
+    def track_ws(rows, padded_in, padded_out, members):
+        recorded_rows.append(rows)
+        return orig_ws_size(rows, padded_in, padded_out, members)
+
+    monkeypatch.setattr(ops, "linear_workspace_size_k31", track_ws)
+    _old_path(monkeypatch)
+    monkeypatch.delenv("VLLM_K31Q_DENSE_PREFILL", raising=False)
+    model, _ = _build(monkeypatch, checkpoint, ops)
+    assert recorded_rows and set(recorded_rows) == {dense.DECODE_MAX_ROWS}
+
+    # On CPU (no CUDA aux_stream), 1 persistent buffer is allocated.
+    mod = model.model.layers[1].self_attn.o_proj
+    _forward(mod, _inputs(mod, 4))
+    resources = manager._persistent_resources[0]
+    (key,) = [k for k in resources if k[0] == dense.WORKSPACE_KEY]
+    assert len(resources[key]) == 1
+
+    # On CUDA with an active aux_stream, 2 isolated buffers are allocated and
+    # selected strictly by current_stream() == aux_stream() (H4).
+    main_s = object()
+    aux_s = object()
+    cur_s = [main_s]
+    class _FakeCudaDev:
+        type = "cuda"
+
+        def __str__(self) -> str:
+            return "cuda:0"
+
+    fake_dev = _FakeCudaDev()
+    monkeypatch.setitem(dense._WORKSPACE_NEEDS, "cuda:0", 64)
+    monkeypatch.setattr(torch_utils, "aux_stream", lambda: aux_s)
+    monkeypatch.setattr(torch_utils, "current_stream", lambda: cur_s[0])
+    monkeypatch.setattr(torch.cuda, "is_current_stream_capturing", lambda: False)
+    orig_empty = torch.empty
+    with monkeypatch.context() as mp:
+        mp.setattr(
+            torch, "empty", lambda *a, device=None, **kw: orig_empty(*a, **kw)
+        )
+        buf_main = dense._workspace(fake_dev)
+        cur_s[0] = aux_s
+        buf_aux = dense._workspace(fake_dev)
+    assert buf_main is not buf_aux
+    cuda_keys = [k for k in resources if k[0] == dense.WORKSPACE_KEY and k[1] == "cuda:0"]
+    assert len(cuda_keys) == 1 and len(resources[cuda_keys[0]]) == 2
+    assert buf_main is resources[cuda_keys[0]][0]
+    assert buf_aux is resources[cuda_keys[0]][1]
+
+    # With VLLM_K31Q_DENSE_PREFILL=k31, launchers size for MAX_ROWS (> 32).
+    recorded_rows.clear()
+    monkeypatch.setenv("VLLM_K31Q_DENSE_PREFILL", "k31")
+    _build(monkeypatch, checkpoint, ops)
+    assert recorded_rows and set(recorded_rows) == {MAX_ROWS}
+
+
+def test_plain_invariant_fallback_and_fake_tensor(monkeypatch):
+    """linear_plain_invariant_k31 falls back cleanly on CPU and on older
+    api_version == 2 binaries, and supports FakeTensor tracing."""
+    from torch._subclasses.fake_tensor import FakeTensorMode
+
+    from vllm.sm80.kernels.k31q import dense
+
+    # Older api_version == 2 binary: plain_invariant_available() returns False.
+    v2_ops = types.SimpleNamespace(build_info=lambda: {"api_version": 2})
+    monkeypatch.setattr(dense, "library_built", lambda: True)
+    monkeypatch.setattr(dense, "load_dense_native", lambda: v2_ops)
+    assert not dense.plain_invariant_available()
+
+    # Refused extension (RuntimeError from native.load): also returns False cleanly.
+    def refused():
+        raise RuntimeError("api_version mismatch")
+
+    monkeypatch.setattr(dense, "load_dense_native", refused)
+    assert not dense.plain_invariant_available()
+
+    # v4 ops with linear_plain_invariant_k31: available.
+    v4_ops = types.SimpleNamespace(
+        build_info=lambda: {"api_version": 4},
+        linear_plain_invariant_k31=lambda *a: None,
+    )
+    monkeypatch.setattr(dense, "load_dense_native", lambda: v4_ops)
+    assert dense.plain_invariant_available()
+
+    # L16: falling back to cuBLAS on CUDA BF16 with api_version < 3 logs warning_once.
+    warned = []
+    monkeypatch.setattr(dense.logger, "warning_once", lambda msg, *a: warned.append(msg))
+    monkeypatch.setattr(dense, "plain_invariant_available", lambda: False)
+    fake_cuda_x = torch.randn(2, 16, dtype=torch.bfloat16)
+    fake_cuda_w = torch.randn(8, 16, dtype=torch.bfloat16)
+    monkeypatch.setattr(torch.Tensor, "is_cuda", property(lambda self: True))
+    out_fb = dense.linear_plain_invariant_k31(fake_cuda_x, fake_cuda_w)
+    monkeypatch.undo()
+    assert out_fb.shape == (2, 8)
+    assert any("falling back to cuBLAS" in w for w in warned)
+
+    # CPU fallback matches F.linear exactly.
+    torch.manual_seed(0)
+    x = torch.randn(4, 128, dtype=torch.bfloat16)
+    w = torch.randn(224, 128, dtype=torch.bfloat16)
+    b = torch.randn(224, dtype=torch.bfloat16)
+    out = dense.linear_plain_invariant_k31(x, w, b)
+    assert torch.equal(out, torch.nn.functional.linear(x, w, b))
+
+    # FakeTensor registration for vllm::k31_plain_linear.
+    with FakeTensorMode():
+        fx = torch.empty((8, 7168), dtype=torch.bfloat16)
+        fw = torch.empty((176, 7168), dtype=torch.bfloat16)
+        fout = torch.ops.vllm.k31_plain_linear(fx, fw, None)
+        assert fout.shape == (8, 176) and fout.dtype == torch.bfloat16
