+#pragma once
+
+#include <ATen/Tensor.h>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <tuple>
+#include <vector>
+
+namespace k31_p2p {
+
+// Sticky error codes written into err_dev / err_host:
+//   0 = OK
+//   1 = ERR_TIMEOUT
+//   2 = ERR_ABORT
+//   3 = ERR_FRAMING_MISMATCH (PP slot header mismatch)
+//   4 = ERR_GENERATION_MISMATCH (stale CUDA graph after handle close/recreate)
+//   5 = ERR_OP_MISMATCH (peer posted a different op_kind tag at the same seq)
+static constexpr uint32_t kErrOk = 0u;
+static constexpr uint32_t kErrTimeout = 1u;
+static constexpr uint32_t kErrAbort = 2u;
+static constexpr uint32_t kErrFramingMismatch = 3u;
+static constexpr uint32_t kErrGenerationMismatch = 4u;
+static constexpr uint32_t kErrOpMismatch = 5u;
+
+struct HandleInfo {
+  int32_t rank = -1;
+  int32_t device_ordinal = -1;
+  int32_t peer_device_ordinal = -1;
+  int32_t num_slots = 0;
+  uint64_t slot_bytes = 0;
+  uint64_t timeout_ms = 0;
+  uint32_t error_code = 0;
+  uint32_t aborted = 0;
+  uint32_t generation = 0;
+  uint64_t proc_nonce = 0;
+  bool connected = false;
+  std::string transport;
+  std::string shm_name;
+};
+
+// Allocate local rank resources (8-slot inbox, cacheline-padded AR/PP/ack flags,
+// single per-handle monotonic op counters + grid completion counters, host-mapped
+// abort/error/generation/timeout words) and return (handle, serialized PeerMeta bytes).
+std::pair<int64_t, std::vector<uint8_t>> create_local(
+    int64_t rank,
+    int64_t device_ordinal,
+    int64_t max_bytes,
+    const std::string& shm_name);
+
+// Attach peer buffers using serialized PeerMeta bytes from peer's create_local().
+// Same-process detection uses a random 64-bit process nonce (never raw PIDs).
+// Auto-selects loopback, same-proc P2P, cross-proc P2P IPC, or zero-copy mapped
+// POSIX SHM fallback (or forces SHM when force_shm=true). Returns local_handle.
+int64_t connect_peer(
+    int64_t local_handle,
+    const uint8_t* peer_meta,
+    size_t peer_meta_len,
+    bool force_shm = false);
+
+// Convenience helper for single-GPU dual-stream testing (Rank 0 + Rank 1 on same device).
+std::pair<int64_t, int64_t> create_loopback_pair(int64_t device_ordinal, int64_t max_bytes);
+
+// Update spin timeout (writes device-mapped pinned memory so captured CUDA graphs
+// observe the updated timeout dynamically without re-capture).
+void set_timeout_ms(int64_t handle, int64_t timeout_ms);
+void set_abort(int64_t handle);
+void clear_abort(int64_t handle);
+int64_t check_error(int64_t handle);
+void clear_error(int64_t handle);
+HandleInfo get_handle_info(int64_t handle);
+
+// Phase 1 of two-phase collective teardown: sets abort, invalidates device generation
+// word, and closes peer IPC imports / unmaps SHM while keeping local exported buffers
+// alive until the peer finishes Phase 1 across a Gloo barrier.
+void close_peer_imports(int64_t handle);
+
+// Phase 2 of teardown: closes any remaining peer imports and frees all local exported
+// device and host-mapped allocations.
+void destroy(int64_t handle);
+
+// Fused 1-shot P2P all-reduce (+ optional residual add) for BF16 [M, D] (D % 8 == 0).
+// Writes out_sum = bf16(fp32(r0) + fp32(r1)). If residual & out_res are provided,
+// also computes out_res = bf16((fp32(r0) + fp32(r1)) + fp32(residual)) in the same launch.
+// Supports in-place aliasing (out_sum == out_res, out_sum == x_partial, out_res == residual).
+// On sticky error/abort/timeout/mismatch, poisons all outputs with quiet NaN (0x7fc0).
+void p2p_allreduce_residual(
+    int64_t handle,
+    const at::Tensor& x_partial,
+    at::Tensor out_sum,
+    const std::optional<at::Tensor>& residual,
+    const std::optional<at::Tensor>& out_res);
+
+// Fused 1-shot dual P2P exchange for MoE routed [M, H_r] + shared [M, H_s] (both BF16, % 8 == 0),
+// with fused FP32 RMSNorm(H_r) on routed sum and optional residual add on shared sum.
+// On sticky error/abort/timeout/mismatch, poisons all outputs with quiet NaN (0x7fc0).
+void p2p_moe_dual_reduce_rmsnorm(
+    int64_t handle,
+    const at::Tensor& routed_partial,
+    const at::Tensor& shared_partial,
+    const at::Tensor& rms_weight,
+    double eps,
+    at::Tensor out_routed_normed,
+    at::Tensor out_shared_sum,
+    const std::optional<at::Tensor>& residual,
+    const std::optional<at::Tensor>& out_shared_res);
+
+// One-way posted-write PP send of any contiguous CUDA tensor into peer's ring inbox.
+// Prepends a 64-byte PpSlotHeader (magic, seq, total_bytes, chunk_idx, num_chunks,
+// chunk_bytes, tag, msg_seq) and partitions payload via a unified 128B-line byte split
+// independent of pointer alignment.
+void p2p_pp_send(
+    int64_t handle,
+    const at::Tensor& src,
+    int64_t tag = 0);
+
+// One-way PP receive with 64-byte framing header validation before copying payload.
+// On header mismatch or sticky error, sets err_dev = 3 (or existing sticky error) and
+// poisons dst with quiet NaN (0x7fc0) instead of copying stale/misaligned data.
+void p2p_pp_recv(
+    int64_t handle,
+    at::Tensor dst,
+    int64_t tag = 0);
+
+// Cleanly drain and acknowledge one in-flight PP message (any size/chunks) from the ring
+// without copying payload, keeping sender/receiver seqs synchronized on PipeSpec dropped-B.
+void p2p_pp_drain(int64_t handle);
+
+}  // namespace k31_p2p
