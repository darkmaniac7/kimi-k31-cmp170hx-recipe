+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Driver and parser for llama.cpp Kimi-K3.1 per-layer hidden-state & logit dumps.
+
+Supports two backends automatically:
+  1. Primary: `llama-k31-dump` (built out-of-tree from `tools/sm80/llamacpp_k31_dump/`
+     against an external `llama.cpp` checkout with zero core edits).
+     Produces complete `k31_layer_dump_v1` safetensors + meta.json + manifest.json
+     with full [T, 7168] layer tensors, top-128 logits, exact full-vocab logsumexp,
+     and greedy token rollouts.
+  2. Fallback: upstream `llama-eval-callback` (if present without `llama-k31-dump`).
+     Parses GGML debug callback text output into per-tensor stats, shapes, NaN
+     flags, and corner slices, saving a diagnostic `k31_layer_dump_v1` summary
+     (clearly marked `partial_eval_callback: true`).
+
+Also includes a pure-Python GGUF header/slice inspector (`inspect_gguf_file`)
+for verifying KLX GGUF slices (e.g. `/tmp/ref-klx/klx_layer_*.gguf`)
+without requiring GPU execution.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+import shlex
+import shutil
+import struct
+import subprocess
+from pathlib import Path
+from typing import Any
+
+SCRIPT_DIR = Path(__file__).resolve().parent
+DEFAULT_PROMPTS_PATH = SCRIPT_DIR / "track2_fixed_prompts.json"
+DEFAULT_CPP_DIR = SCRIPT_DIR / "llamacpp_k31_dump"
+DEFAULT_LLAMA_CPP_DIR = Path("/opt/llama.cpp")
+DEFAULT_LLAMA_BUILD_DIR = DEFAULT_LLAMA_CPP_DIR / "build-cuda"
+
+SCHEMA_VERSION = "k31_layer_dump_v1"
+
+# Exact GGML tensor name mapping for kimi-k31.cpp (llama.cpp commit 8d60873dfb86)
+GGML_TENSOR_MAP_REGEX = re.compile(
+    r"^(?P<prefix>l_out|kda_out|mla_out|attn_out|ffn_out|attn_norm|ffn_norm|prefix_sum_attn|"
+    r"res_probs|ffn_moe_logits|ffn_moe_out|ffn_shexp|indexer_top_k)-(?P<layer>\d+)$"
+)
+
+GGML_TO_CANON_SUBTAP = {
+    "l_out": "out",
+    "kda_out": "attn_out",
+    "mla_out": "attn_out",
+    "attn_out": "attn_out",
+    "ffn_out": "mlp_out",
+    "attn_norm": "attn_in",
+    "ffn_norm": "mlp_in",
+    "prefix_sum_attn": "prefix_sum_attn",
+}
+
+_GGUF_SCALAR = {
+    0: "B",
+    1: "b",
+    2: "H",
+    3: "h",
+    4: "I",
+    5: "i",
+    6: "f",
+    7: "?",
+    10: "Q",
+    11: "q",
+    12: "d",
+}
+
+GGML_TYPE_NAMES = {
+    0: "F32",
+    1: "F16",
+    2: "Q4_0",
+    3: "Q4_1",
+    6: "Q5_0",
+    7: "Q5_1",
+    8: "Q8_0",
+    9: "Q8_1",
+    10: "Q2_K",
+    11: "Q3_K",
+    12: "Q4_K",
+    13: "Q5_K",
+    14: "Q6_K",
+    15: "Q8_K",
+    16: "IQ2_XXS",
+    17: "IQ2_XS",
+    18: "IQ3_XXS",
+    19: "IQ1_S",
+    20: "IQ4_NL",
+    21: "IQ3_S",
+    22: "IQ2_S",
+    23: "IQ4_XS",
+    29: "IQ1_M",
+    30: "BF16",
+}
+
+
+def map_ggml_tensor_name(raw_name: str) -> str | None:
+    """Map a llama.cpp kimi-k31.cpp GGML tensor name to canonical k31_layer_dump_v1 name."""
+    if raw_name == "inp_embd":
+        return "embed"
+    if raw_name == "result_norm":
+        return "final_norm"
+    if raw_name == "result_output":
+        return "result_output"
+    m = GGML_TENSOR_MAP_REGEX.match(raw_name)
+    if not m:
+        return None
+    sub = GGML_TO_CANON_SUBTAP.get(m.group("prefix"))
+    if sub is None:
+        return None
+    return f"L{int(m.group('layer'))}.{sub}"
+
+
+def parse_eval_callback_log(log_text: str) -> dict[str, dict[str, Any]]:
+    """Parse stdout/stderr emitted by llama.cpp `common_debug_cb_eval` / `llama-eval-callback`."""
+    hdr_re = re.compile(
+        r"common_debug_cb_eval:\s*(?P<name>\S+)\s*=\s*\((?P<dtype>[^)]+)\)\s*(?P<op>\S+?)\(.*?\)\s*=\s*\{(?P<ne>[^}]+)\}"
+    )
+    sum_re = re.compile(r"^\s*sum\s*=\s*(?P<val>[-+0-9.eE]+|nan|inf|-inf)\s*$", re.IGNORECASE)
+    num_re = re.compile(r"[-+]?(?:\d+\.\d+|\d+)(?:[eE][-+]?\d+)?|nan|inf|-inf", re.IGNORECASE)
+
+    parsed: dict[str, dict[str, Any]] = {}
+    cur_name: str | None = None
+
+    for line in log_text.splitlines():
+        hm = hdr_re.search(line)
+        if hm:
+            raw_name = hm.group("name").strip()
+            ne_vals = [int(x.strip()) for x in hm.group("ne").split(",") if x.strip()]
+            cur_name = raw_name
+            parsed[raw_name] = {
+                "raw_name": raw_name,
+                "canonical_name": map_ggml_tensor_name(raw_name),
+                "ggml_type": hm.group("dtype").strip(),
+                "op": hm.group("op").strip(),
+                "ne": ne_vals,
+                "shape_row_major": [ne_vals[1], ne_vals[0]] if len(ne_vals) >= 2 else ne_vals,
+                "sum": None,
+                "has_nan": False,
+                "sample_values": [],
+            }
+            continue
+
+        if cur_name is None:
+            continue
+
+        sm = sum_re.match(line)
+        if sm:
+            val_s = sm.group("val").lower()
+            if "nan" in val_s:
+                parsed[cur_name]["sum"] = float("nan")
+                parsed[cur_name]["has_nan"] = True
+            else:
+                parsed[cur_name]["sum"] = float(val_s)
+            continue
+
+        stripped = line.strip()
+        if stripped.startswith("[") and stripped.endswith("],"):
+            for tok in num_re.findall(stripped):
+                tl = tok.lower()
+                if "nan" in tl:
+                    parsed[cur_name]["has_nan"] = True
+                elif len(parsed[cur_name]["sample_values"]) < 12:
+                    try:
+                        parsed[cur_name]["sample_values"].append(float(tok))
+                    except ValueError:
+                        pass
+
+    return parsed
+
+
+def inspect_gguf_file(path: str | Path) -> dict[str, Any]:
+    """Read a GGUF v2/v3 header and tensor table without loading weight data."""
+    p = Path(path)
+    with p.open("rb") as f:
+        magic = f.read(4)
+        if magic != b"GGUF":
+            raise ValueError(f"Not a GGUF file (magic={magic!r}): {p}")
+        version, n_tensors, n_kv = struct.unpack("<IQQ", f.read(20))
+
+        def _rd(fmt: str) -> Any:
+            sz = struct.calcsize("<" + fmt)
+            return struct.unpack("<" + fmt, f.read(sz))[0]
+
+        def _rstr() -> str:
+            ln = _rd("Q")
+            return f.read(ln).decode("utf-8", "replace")
+
+        def _rval(vtype: int) -> Any:
+            if vtype == 8:
+                return _rstr()
+            if vtype == 9:
+                atype = _rd("I")
+                count = _rd("Q")
+                if atype == 8:
+                    vals = [_rstr() for _ in range(min(count, 16))]
+                    for _ in range(max(0, count - 16)):
+                        ln = _rd("Q")
+                        f.seek(ln, 1)
+                    return vals if count <= 16 else {"array_str_len": count}
+                sz = struct.calcsize("<" + _GGUF_SCALAR[atype])
+                if count <= 128:
+                    return [_rd(_GGUF_SCALAR[atype]) for _ in range(count)]
+                f.seek(sz * count, 1)
+                return {"array_type": atype, "len": count}
+            return _rd(_GGUF_SCALAR[vtype])
+
+        kv: dict[str, Any] = {}
+        for _ in range(n_kv):
+            k = _rstr()
+            vt = _rd("I")
+            kv[k] = _rval(vt)
+
+        tensors: list[dict[str, Any]] = []
+        layer_re = re.compile(r"^blk\.(\d+)\.(.+)$")
+        layers_seen: set[int] = set()
+        type_hist: dict[str, int] = {}
+
+        for _ in range(n_tensors):
+            name = _rstr()
+            nd = _rd("I")
+            dims = [_rd("Q") for _ in range(nd)]
+            ttype = _rd("I")
+            offset = _rd("Q")
+            tname = GGML_TYPE_NAMES.get(ttype, f"TYPE_{ttype}")
+            type_hist[tname] = type_hist.get(tname, 0) + 1
+            lm = layer_re.match(name)
+            layer_idx = int(lm.group(1)) if lm else None
+            if layer_idx is not None:
+                layers_seen.add(layer_idx)
+            tensors.append({
+                "name": name,
+                "dims": dims,
+                "ggml_type_id": ttype,
+                "ggml_type": tname,
+                "offset": offset,
+                "layer": layer_idx,
+            })
+
+    return {
+        "path": str(p),
+        "file_size_bytes": p.stat().st_size,
+        "gguf_version": version,
+        "n_tensors": n_tensors,
+        "n_kv": n_kv,
+        "architecture": kv.get("general.architecture"),
+        "layers": sorted(layers_seen),
+        "type_histogram": type_hist,
+        "kv": {k: v for k, v in kv.items() if "chat_template" not in k},
+        "tensors": tensors,
+    }
+
+
+def validate_k31_dump_dir(dump_dir: str | Path) -> dict[str, Any]:
+    """Validate a k31_layer_dump_v1 directory and return its parsed manifest and summary."""
+    from safetensors import safe_open
+
+    d = Path(dump_dir)
+    manifest_path = d / "manifest.json"
+    if not manifest_path.is_file():
+        raise FileNotFoundError(f"Missing manifest.json in {d}")
+    manifest = json.loads(manifest_path.read_text())
+    if manifest.get("schema") != SCHEMA_VERSION:
+        raise ValueError(f"Unexpected dump schema {manifest.get('schema')!r}, expected {SCHEMA_VERSION!r}")
+
+    prompt_summaries: dict[str, Any] = {}
+    for pid in manifest.get("prompts", []):
+        st_path = d / f"{pid}.safetensors"
+        meta_path = d / f"{pid}.meta.json"
+        if not st_path.is_file():
+            raise FileNotFoundError(f"Missing safetensors file for prompt {pid}: {st_path}")
+        if not meta_path.is_file():
+            raise FileNotFoundError(f"Missing meta.json for prompt {pid}: {meta_path}")
+        meta = json.loads(meta_path.read_text())
+        with safe_open(str(st_path), framework="pt") as f:
+            keys = sorted(f.keys())
+            st_meta = f.metadata() or {}
+        if st_meta.get("schema") != SCHEMA_VERSION:
+            raise ValueError(f"Prompt {pid} safetensors metadata schema mismatch: {st_meta}")
+        layer_outs = sorted(
+            int(m.group(1))
+            for k in keys
+            if (m := re.match(r"^L(\d+)\.out$", k))
+        )
+        prompt_summaries[pid] = {
+            "safetensors": str(st_path),
+            "meta": str(meta_path),
+            "num_tensors": len(keys),
+            "num_prompt_tokens": len(meta.get("prompt_token_ids", [])),
+            "num_generated_tokens": len(meta.get("generated_ids", [])),
+            "layers_with_out": layer_outs,
+            "has_logits": all(k in keys for k in ("topk_ids", "topk_logits", "logsumexp")),
+            "logit_nan_count": meta.get("logit_nan_count", 0),
+        }
+
+    return {"manifest": manifest, "prompts": prompt_summaries}
+
+
+def find_dump_binary(
+    explicit_bin: str | None,
+    llama_cpp_dir: Path,
+    llama_build_dir: Path,
+    auto_build: bool = False,
+) -> tuple[str, Path]:
+    """Locate `llama-k31-dump` (preferred) or `llama-eval-callback` (fallback)."""
+    if explicit_bin:
+        p = Path(explicit_bin)
+        if not p.is_file():
+            raise FileNotFoundError(f"Specified binary does not exist: {p}")
+        mode = "eval-callback" if "eval-callback" in p.name else "k31-dump"
+        return mode, p
+
+    candidates = [
+        DEFAULT_CPP_DIR / "llama-k31-dump",
+        llama_build_dir / "bin" / "llama-k31-dump",
+    ]
+    for c in candidates:
+        if c.is_file() and os.access(c, os.X_OK):
+            return "k31-dump", c
+
+    if auto_build:
+        out_bin = DEFAULT_CPP_DIR / "llama-k31-dump"
+        build_sh = DEFAULT_CPP_DIR / "build.sh"
+        if build_sh.is_file() and (llama_build_dir / "bin").is_dir():
+            subprocess.run(
+                [str(build_sh), str(llama_cpp_dir), str(llama_build_dir), str(out_bin)],
+                check=True,
+            )
+            return "k31-dump", out_bin
+
+    eval_cb_candidates = [
+        llama_build_dir / "bin" / "llama-eval-callback",
+        Path("/opt/llama.cpp/build/bin/llama-eval-callback"),
+    ]
+    which_cb = shutil.which("llama-eval-callback")
+    if which_cb:
+        eval_cb_candidates.append(Path(which_cb))
+
+    for c in eval_cb_candidates:
+        if c.is_file() and os.access(c, os.X_OK):
+            return "eval-callback", c
+
+    raise FileNotFoundError(
+        "Neither llama-k31-dump nor llama-eval-callback found. "
+        f"Build llama-k31-dump with: {DEFAULT_CPP_DIR / 'build.sh'} {llama_cpp_dir} {llama_build_dir}"
+    )
+
+
+def run_k31_dump(
+    binary: Path,
+    model_path: Path,
+    prompts_path: Path,
+    out_dir: Path,
+    layers: str,
+    taps: str,
+    dtype: str,
+    n_predict: int,
+    topk: int,
+    ngl: int,
+    ctx_size: int,
+    batch_size: int,
+    ubatch_size: int,
+    threads: int,
+    rpc: str | None,
+    tensor_split: str | None,
+    prompt_ids: str | None,
+    max_tokens: int,
+    capture_decode_layers: bool,
+    ignore_eos: bool,
+    extra_args: list[str],
+    dry_run: bool = False,
+) -> list[str]:
+    cmd: list[str] = [
+        str(binary),
+        "-m", str(model_path),
+        "-ngl", str(ngl),
+        "-c", str(ctx_size),
+        "-b", str(batch_size),
+        "-ub", str(ubatch_size),
+        "-t", str(threads),
+        "--k31-prompts", str(prompts_path),
+        "--k31-out", str(out_dir),
+        "--k31-layers", layers,
+        "--k31-taps", taps,
+        "--k31-dtype", dtype,
+        "--k31-n-predict", str(n_predict),
+        "--k31-topk", str(topk),
+    ]
+    if rpc:
+        cmd += ["--rpc", rpc]
+    if tensor_split:
+        cmd += ["--tensor-split", tensor_split]
+    if prompt_ids:
+        cmd += ["--k31-prompt-ids", prompt_ids]
+    if max_tokens > 0:
+        cmd += ["--k31-max-tokens", str(max_tokens)]
+    if capture_decode_layers:
+        cmd.append("--k31-capture-decode-layers")
+    if ignore_eos:
+        cmd.append("--k31-ignore-eos")
+    cmd += extra_args
+
+    if dry_run:
+        print("DRY RUN:", " ".join(shlex.quote(c) for c in cmd))
+        return cmd
+
+    out_dir.mkdir(parents=True, exist_ok=True)
+    subprocess.run(cmd, check=True)
+    return cmd
+
+
+def run_eval_callback_fallback(
+    binary: Path,
+    model_path: Path,
+    prompts_path: Path,
+    out_dir: Path,
+    ngl: int,
+    ctx_size: int,
+    threads: int,
+    rpc: str | None,
+    tensor_split: str | None,
+    prompt_ids: str | None,
+    extra_args: list[str],
+    dry_run: bool = False,
+) -> None:
+    """Fallback driver invoking upstream llama-eval-callback and parsing debug text output."""
+    suite = json.loads(prompts_path.read_text())
+    prompts = suite["prompts"] if isinstance(suite, dict) else suite
+    wanted = set(prompt_ids.split(",")) if prompt_ids else None
+    selected = [p for p in prompts if wanted is None or p["id"] in wanted]
+
+    out_dir.mkdir(parents=True, exist_ok=True)
+    done_ids: list[str] = []
+
+    for p in selected:
+        pid = p["id"]
+        cmd = [
+            str(binary),
+            "-m", str(model_path),
+            "-ngl", str(ngl),
+            "-c", str(ctx_size),
+            "-t", str(threads),
+            "-p", p["prompt_text"],
+        ]
+        if rpc:
+            cmd += ["--rpc", rpc]
+        if tensor_split:
+            cmd += ["--tensor-split", tensor_split]
+        cmd += extra_args
+
+        if dry_run:
+            print(f"DRY RUN [{pid}]:", " ".join(shlex.quote(c) for c in cmd))
+            continue
+
+        proc = subprocess.run(cmd, check=True, capture_output=True, text=True)
+        combined = proc.stdout + "\n" + proc.stderr
+        (out_dir / f"{pid}.eval_callback.log").write_text(combined)
+        parsed = parse_eval_callback_log(combined)
+        meta = {
+            "schema": SCHEMA_VERSION,
+            "engine": "llama.cpp-eval-callback",
+            "partial_eval_callback": True,
+            "warning": (
+                "Generated from llama-eval-callback text output (truncated corner slices + sums only). "
+                "Build llama-k31-dump via tools/sm80/llamacpp_k31_dump/build.sh for full safetensors cosine comparison."
+            ),
+            "prompt_id": pid,
+            "category": p.get("category", "unknown"),
+            "prompt_text": p.get("prompt_text", ""),
+            "prompt_token_ids": p.get("token_ids", []),
+            "model_path": str(model_path),
+            "tensors_parsed": parsed,
+        }
+        (out_dir / f"{pid}.meta.json").write_text(json.dumps(meta, indent=2) + "\n")
+        done_ids.append(pid)
+
+    if not dry_run:
+        manifest = {
+            "schema": SCHEMA_VERSION,
+            "engine": "llama.cpp-eval-callback",
+            "partial_eval_callback": True,
+            "model_path": str(model_path),
+            "prompts_file": str(prompts_path),
+            "prompts": done_ids,
+        }
+        (out_dir / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
+
+
+def build_arg_parser() -> argparse.ArgumentParser:
+    p = argparse.ArgumentParser(
+        description="Dump per-layer hidden states, logits, and greedy tokens from KLX GGUF via llama.cpp."
+    )
+    p.add_argument("--model", type=Path, help="Path to GGUF model (shard 00001 for split GGUF).")
+    p.add_argument("--prompts", type=Path, default=DEFAULT_PROMPTS_PATH, help="Fixed prompt suite JSON.")
+    p.add_argument("--out", type=Path, help="Output directory for k31_layer_dump_v1 files.")
+    p.add_argument("--layers", default="all", help="Layer indices/ranges (e.g. all or 0,1,3,46,92).")
+    p.add_argument(
+        "--taps",
+        default="out,attn_out,mlp_out,final_norm",
+        help="Comma-separated taps: out,attn_out,mlp_out,attn_in,mlp_in,prefix_sum_attn,embed,final_norm.",
+    )
+    p.add_argument("--dtype", choices=["bf16", "fp16", "fp32"], default="bf16")
+    p.add_argument("--n-predict", type=int, default=32, help="Greedy decode tokens per prompt.")
+    p.add_argument("--topk", type=int, default=128, help="Top-K logits saved per position.")
+    p.add_argument("--prompt-ids", default=None, help="Optional comma-separated subset of prompt IDs.")
+    p.add_argument("--max-tokens", type=int, default=0, help="Optional prompt token truncation cap.")
+    p.add_argument("--capture-decode-layers", action="store_true")
+    p.add_argument("--ignore-eos", action="store_true")
+    p.add_argument("--ngl", type=int, default=999, help="GPU offload layers (-ngl).")
+    p.add_argument("--ctx-size", type=int, default=4096)
+    p.add_argument("--batch-size", type=int, default=512)
+    p.add_argument("--ubatch-size", type=int, default=512)
+    p.add_argument("--threads", type=int, default=16)
+    p.add_argument("--rpc", default=None, help="Optional ggml-rpc servers (e.g. 192.0.2.10:50052).")
+    p.add_argument("--tensor-split", default=None, help="Optional --tensor-split weights.")
+    p.add_argument("--dump-bin", default=None, help="Explicit path to llama-k31-dump or llama-eval-callback.")
+    p.add_argument("--llama-cpp-dir", type=Path, default=DEFAULT_LLAMA_CPP_DIR)
+    p.add_argument("--llama-build-dir", type=Path, default=DEFAULT_LLAMA_BUILD_DIR)
+    p.add_argument("--auto-build", action="store_true", help="Compile llama-k31-dump automatically if missing.")
+    p.add_argument("--extra-args", default="", help="Extra llama.cpp CLI flags (quoted string).")
+    p.add_argument("--dry-run", action="store_true", help="Print resolved command without executing.")
+    p.add_argument("--validate", type=Path, default=None, help="Validate an existing k31_layer_dump_v1 directory.")
+    p.add_argument("--inspect-gguf", type=Path, default=None, help="Inspect GGUF header/layer quantization types.")
+    p.add_argument("--parse-eval-log", type=Path, default=None, help="Parse a raw llama-eval-callback log file.")
+    return p
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = build_arg_parser()
+    args = parser.parse_args(argv)
+
+    if args.inspect_gguf is not None:
+        info = inspect_gguf_file(args.inspect_gguf)
+        summary = {k: v for k, v in info.items() if k != "tensors"}
+        summary["tensor_count_listed"] = len(info["tensors"])
+        summary["sample_tensors"] = info["tensors"][:10]
+        print(json.dumps(summary, indent=2))
+        return 0
+
+    if args.parse_eval_log is not None:
+        parsed = parse_eval_callback_log(args.parse_eval_log.read_text())
+        print(json.dumps(parsed, indent=2))
+        return 0
+
+    if args.validate is not None:
+        res = validate_k31_dump_dir(args.validate)
+        print(json.dumps(res, indent=2))
+        return 0
+
+    if args.model is None or args.out is None:
+        parser.error("--model and --out are required unless using --inspect-gguf, --parse-eval-log, or --validate")
+
+    mode, binary = find_dump_binary(
+        args.dump_bin, args.llama_cpp_dir, args.llama_build_dir, auto_build=args.auto_build
+    )
+    extra = shlex.split(args.extra_args) if args.extra_args else []
+
+    if mode == "k31-dump":
+        run_k31_dump(
+            binary=binary,
+            model_path=args.model,
+            prompts_path=args.prompts,
+            out_dir=args.out,
+            layers=args.layers,
+            taps=args.taps,
+            dtype=args.dtype,
+            n_predict=args.n_predict,
+            topk=args.topk,
+            ngl=args.ngl,
+            ctx_size=args.ctx_size,
+            batch_size=args.batch_size,
+            ubatch_size=args.ubatch_size,
+            threads=args.threads,
+            rpc=args.rpc,
+            tensor_split=args.tensor_split,
+            prompt_ids=args.prompt_ids,
+            max_tokens=args.max_tokens,
+            capture_decode_layers=args.capture_decode_layers,
+            ignore_eos=args.ignore_eos,
+            extra_args=extra,
+            dry_run=args.dry_run,
+        )
+        if not args.dry_run:
+            summary = validate_k31_dump_dir(args.out)
+            print(f"Validated k31_layer_dump_v1 at {args.out}: {len(summary['prompts'])} prompt(s).")
+    else:
+        run_eval_callback_fallback(
+            binary=binary,
+            model_path=args.model,
+            prompts_path=args.prompts,
+            out_dir=args.out,
+            ngl=args.ngl,
+            ctx_size=args.ctx_size,
+            threads=args.threads,
+            rpc=args.rpc,
+            tensor_split=args.tensor_split,
+            prompt_ids=args.prompt_ids,
+            extra_args=extra,
+            dry_run=args.dry_run,
+        )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
