+# ----------------------------------------------------- summary, hysteresis
+
+
+def test_summary_is_expected_accepted_drafts_blended_with_acceptance():
+    assert expected_accepted([1.0, 0.5, 0.5], 3) == pytest.approx(1.75)
+    assert expected_accepted([1.0, 0.5, 0.5], 2) == pytest.approx(1.5)
+    assert width_summary(None, 0.5, 3, 0.3) == pytest.approx(0.875)
+    assert width_summary([1.0] * 3, 0.5, 3, 0.25) == pytest.approx(
+        0.75 * 3 + 0.25 * 0.875
+    )
+    assert expected_accepted(_block(3.4), KMAX) == pytest.approx(3.4)
+
+
+def test_hysteresis_holds_the_tier_inside_the_band_and_moves_outside():
+    t = [1.0, 2.0, 3.0]
+    assert tier_index(2.05, t, None, 0.25) == 2
+    assert tier_index(2.2, t, 1, 0.25) == 1
+    assert tier_index(2.3, t, 1, 0.25) == 2
+    assert tier_index(1.8, t, 2, 0.25) == 2
+    assert tier_index(1.7, t, 2, 0.25) == 1
+    assert tier_index(3.5, t, 0, 0.25) == 3
+    assert tier_index(0.1, t, 3, 0.25) == 0
+    # Without a margin the band is the raw one.
+    assert [tier_index(s, t, 1, 0.0) for s in (0.9, 1.0, 2.0)] == [0, 1, 2]
