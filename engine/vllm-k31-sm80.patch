@@ -0,0 +1,243 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The kernel owner's checks of ``_k31_vq_C`` (csrc/k31_vq), as pytest.
+
+Ported from the package's ``test_vq_ops.py`` (its tests 1 and 2; the timing
+table of test 3 is a benchmark and stays with the package). What changed: the
+library is the tree's ``vllm/_k31_vq_C`` instead of a build in the test, the
+mini checkpoint comes from K31Q_MINI_CHECKPOINT, and the records of test 1 are
+packed with this tree's numpy definition of the format
+(tests/models/kimi_k3/sm80/k31q_fixture.py) instead of the converter's
+packer. The checks and their thresholds are the package's.
+
+  1. ``vq_pack`` then ``vq_dequant_reference`` equals the format's definition
+     bit for bit at all five rates, w1 and w2 roles, I = 1536 (TP 2) and
+     I = 3072 (TP 1).
+  2. Real mini layer 1 (vq_d2_b3) against the reference activations at TP 1
+     through the decode and the prefill op and at TP 2 as rank 0 plus rank 1,
+     masked ids, CUDA graph capture and replay, and mini layer 3 (vq_d4_b6)
+     decode against prefill. Release 2 adds: the decode op is bitwise equal
+     over 20 runs at 1 to 64 rows (its own test 2 does the same).
+
+Needs a CUDA device and the built library; test 2 also the mini checkpoint.
+"""
+
+import numpy as np
+import pytest
+import torch
+
+from tests.models.kimi_k3.sm80 import gpu
+from tests.models.kimi_k3.sm80 import k31q_fixture as fixture
+
+pytestmark = gpu.CUDA_MARKS
+
+H = 3584
+RATES = {
+    "vq_d2_b3": (2, 3),
+    "vq_d2_b4": (2, 4),
+    "vq_d2_b5": (2, 5),
+    "vq_d4_b5": (4, 5),
+    "vq_d4_b6": (4, 6),
+}
+
+
+@pytest.fixture(scope="module")
+def vq_ops():
+    from vllm.sm80.kernels.k31q import vq_ops
+
+    gpu.require_library(vq_ops.ensure_vq_extension, "_k31_vq_C")
+    return vq_ops
+
+
+@pytest.mark.parametrize("rate", list(RATES))
+def test_pack_dequant_bit_exact(vq_ops, rate):
+    dim, bits = RATES[rate]
+    device = torch.device("cuda:0")
+    rng = np.random.default_rng(12345)
+    cb_f16 = torch.randn(
+        (1 << bits, dim), dtype=torch.float16, device=device
+    ).contiguous()
+    cb_np = cb_f16.float().cpu().numpy()
+    vecs = (128 * H) // dim
+    for inter in (1536, 3072):
+        nb = inter // 128
+        experts = 4
+        for role, out_f, in_f in ((0, inter, H), (1, H, inter)):
+            codes = rng.integers(
+                0, 1 << bits, size=(experts, nb, vecs), dtype=np.uint16
+            )
+            records = np.stack(
+                [
+                    np.stack([fixture.pack_bits(codes[e, b], bits) for b in range(nb)])
+                    for e in range(experts)
+                ]
+            )
+            idx_u8 = torch.from_numpy(records).to(device)
+            sc_f16 = (
+                torch.rand((experts, nb, H), dtype=torch.float16, device=device) * 0.2
+                + 0.01
+            ).contiguous()
+            p_idx, p_sc = vq_ops.vq_pack(
+                idx_u8, sc_f16, cb_f16, role, H, dim, bits, 128
+            )
+            w_gpu = (
+                vq_ops.vq_dequant_reference(
+                    p_idx, p_sc, cb_f16, out_f, in_f, dim, bits, 128
+                )
+                .cpu()
+                .numpy()
+            )
+            vals = cb_np[codes]
+            sc_np = sc_f16.float().cpu().numpy()
+            if role == 0:
+                w_ref = (
+                    vals.reshape(experts, nb, 128, 28, 128)
+                    * sc_np.reshape(experts, nb, 128, 28, 1)
+                ).reshape(experts, inter, H)
+            else:
+                w_ref = (
+                    (
+                        vals.reshape(experts, nb, H, 128)
+                        * sc_np.reshape(experts, nb, H, 1)
+                    )
+                    .transpose(0, 2, 1, 3)
+                    .reshape(experts, H, inter)
+                )
+            max_diff = float(np.max(np.abs(w_gpu - w_ref)))
+            assert max_diff == 0.0, f"Mismatch {rate} I={inter} role={role}: {max_diff}"
+
+
+def _layer_records(layer: int, device, blocks=slice(None)):
+    """Canonical records (idx, scale) of w1, w3 and w2 of a mini layer."""
+    prefix = f"language_model.model.layers.{layer}.block_sparse_moe.experts"
+    names = [
+        f"{prefix}.{w}.{kind}"
+        for w in ("w1", "w3", "w2")
+        for kind in ("vq_idx", "vq_scale")
+    ]
+    path = gpu.require_mini() / f"layer-{layer:03d}.safetensors"
+    held = gpu.tensors(path, *names, device="cpu")
+    return [t[:, blocks].contiguous().to(device) for t in held]
+
+
+def _packed_tables(vq_ops, records, codebook, dim, bits, inter):
+    """Pack the three projections and build the kernel owner's tables; the
+    packed tensors are returned so they outlive the tables."""
+    w1_i, w1_s, w3_i, w3_s, w2_i, w2_s = records
+    p1 = vq_ops.vq_pack(w1_i, w1_s, codebook, 0, H, dim, bits, 128)
+    p3 = vq_ops.vq_pack(w3_i, w3_s, codebook, 0, H, dim, bits, 128)
+    p2 = vq_ops.vq_pack(w2_i, w2_s, codebook, 1, H, dim, bits, 128)
+    ptrs, meta = vq_ops.build_vq_expert_tables(
+        *p1, codebook, dim, bits, *p3, codebook, dim, bits, *p2, codebook, dim, bits,
+        H, inter,
+    )  # fmt: skip
+    return ptrs, meta, (p1, p3, p2)
+
+
+def test_real_layer1_and_graph_capture(vq_ops):
+    device = torch.device("cuda:0")
+    mini = gpu.require_mini()
+    z_q, topk_ids, topk_w, ref_routed = gpu.reference_moe(1)
+    cb_b3, cb_d4b6 = gpu.tensors(
+        mini / "codebooks.safetensors", "vq.vq_d2_b3", "vq.vq_d4_b6"
+    )
+    cb_b3 = cb_b3.to(torch.float16).contiguous()
+    cb_d4b6 = cb_d4b6.to(torch.float16).contiguous()
+    raw = _layer_records(1, device)
+    experts = raw[0].shape[0]
+    emap = torch.arange(experts, dtype=torch.int32, device=device)
+
+    # TP1 I=3072
+    ptrs, meta, keep = _packed_tables(vq_ops, raw, cb_b3, 2, 3, 3072)
+    ws = torch.empty(
+        vq_ops.moe_workspace_size_vq(512, H, 3072, 16, experts),
+        dtype=torch.float32,
+        device=device,
+    )
+    out64 = torch.empty((64, H), dtype=torch.bfloat16, device=device)
+    vq_ops.moe_out_vq(
+        z_q[:64], topk_ids[:64], topk_w[:64], ptrs, meta, emap, 3072, out64, ws
+    )
+    rel64 = gpu.rel_l2(out64, ref_routed[:64])
+    assert rel64 < 0.005, f"TP1 decode rel64={rel64}"
+    print(f"real L1 TP1 I=3072 decode (64 rows) against ref_acts.q: rel_l2={rel64:.5f}")
+
+    out512 = torch.empty((512, H), dtype=torch.bfloat16, device=device)
+    vq_ops.moe_out_prefill_vq(z_q, topk_ids, topk_w, ptrs, meta, emap, 3072, out512, ws)
+    rel512 = gpu.rel_l2(out512, ref_routed)
+    assert rel512 < 0.005, f"TP1 prefill rel512={rel512}"
+    print(
+        f"real L1 TP1 I=3072 prefill (512 rows) against ref_acts.q: rel_l2={rel512:.5f}"
+    )
+
+    # Row mask (-1)
+    ids_m = topk_ids[:8].clone()
+    ids_m[2, :] = -1
+    ids_m[5, :8] = -1
+    out_m = torch.empty((8, H), dtype=torch.bfloat16, device=device)
+    vq_ops.moe_out_vq(z_q[:8], ids_m, topk_w[:8], ptrs, meta, emap, 3072, out_m, ws)
+    assert out_m[2].abs().max().item() == 0.0
+    assert torch.equal(out_m[0], out64[0]) and torch.equal(out_m[1], out64[1])
+    # CUDA graph capture and replay (no device-to-host sync inside the op).
+    x_g = z_q[:8].clone()
+    out_g = torch.empty((8, H), dtype=torch.bfloat16, device=device)
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        vq_ops.moe_out_vq(
+            x_g, topk_ids[:8], topk_w[:8], ptrs, meta, emap, 3072, out_g, ws
+        )
+    graph.replay()
+    torch.cuda.synchronize()
+    assert torch.equal(out_g, out64[:8]), "CUDA graph replay mismatch"
+
+    # Release 2: the decode op is bitwise deterministic from run to run, with
+    # the layer's static rate ids (0: vq_d2_b3) and with -1 (rates read from
+    # packed_meta on the device); the library reports api_version 2.
+    for rows in (1, 4, 8, 12, 16, 64):
+        for rates in ((0, 0), (-1, -1)):
+            args = (z_q[:rows], topk_ids[:rows], topk_w[:rows], ptrs, meta, emap, 3072)
+            first = torch.empty((rows, H), dtype=torch.bfloat16, device=device)
+            again = torch.empty_like(first)
+            vq_ops.moe_out_vq(*args, first, ws, 4.0, 25.0, 0.0, *rates)
+            for _ in range(20):
+                vq_ops.moe_out_vq(*args, again, ws, 4.0, 25.0, 0.0, *rates)
+                assert torch.equal(first, again), f"{rows} rows, rate ids {rates}"
+    assert vq_ops.build_info()["api_version"] == 2
+
+    # TP2 (rank 0 + rank 1)
+    del ptrs, meta, keep
+    ws_tp2 = torch.empty(
+        vq_ops.moe_workspace_size_vq(64, H, 1536, 16, experts),
+        dtype=torch.float32,
+        device=device,
+    )
+    out_sum = torch.zeros((64, H), dtype=torch.float32, device=device)
+    for rank in (0, 1):
+        half = [t[:, rank * 12 : (rank + 1) * 12].contiguous() for t in raw]
+        ptrs, meta, keep = _packed_tables(vq_ops, half, cb_b3, 2, 3, 1536)
+        o_rank = torch.empty((64, H), dtype=torch.bfloat16, device=device)
+        vq_ops.moe_out_vq(
+            z_q[:64], topk_ids[:64], topk_w[:64], ptrs, meta, emap, 1536, o_rank, ws_tp2
+        )
+        out_sum += o_rank.float()
+        del ptrs, meta, keep
+    rel_tp2 = gpu.rel_l2(out_sum, ref_routed[:64])
+    assert rel_tp2 < 0.005, f"TP2 rel={rel_tp2}"
+    print(f"real L1 TP2 (rank 0 + rank 1, I=1536) against ref_acts.q: {rel_tp2:.5f}")
+
+    # Mini layer 3 (vq_d4_b6), the d = 4 path: decode against prefill.
+    del raw
+    half = _layer_records(3, device, blocks=slice(0, 12))
+    ptrs, meta, keep = _packed_tables(vq_ops, half, cb_d4b6, 4, 6, 1536)
+    o3_dec = torch.empty((16, H), dtype=torch.bfloat16, device=device)
+    o3_pre = torch.empty((16, H), dtype=torch.bfloat16, device=device)
+    vq_ops.moe_out_vq(
+        z_q[:16], topk_ids[:16], topk_w[:16], ptrs, meta, emap, 1536, o3_dec, ws_tp2
+    )
+    vq_ops.moe_out_prefill_vq(
+        z_q[:16], topk_ids[:16], topk_w[:16], ptrs, meta, emap, 1536, o3_pre, ws_tp2
+    )
+    rel_d4 = gpu.rel_l2(o3_pre, o3_dec)
+    assert rel_d4 < 1e-4, f"d4 dec vs pre mismatch {rel_d4}"
+    print(f"real L3 (vq_d4_b6) decode against prefill: rel_l2={rel_d4:.6f}")
