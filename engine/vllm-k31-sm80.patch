+def test_read_rows_reads_only_the_range(checkpoint):
+    manifest = K31QManifest(checkpoint)
+    path = checkpoint / "layer-001.safetensors"
+    for suffix in ("vq_idx", "vq_scale"):
+        header = manifest.tensors[f"{EXPERTS1}.w2.{suffix}"]
+        want = fixture.st_read(path, header.name)
+        whole, count = read_rows(header)
+        assert count == header.nbytes and np.array_equal(
+            whole.numpy().view(want.dtype), want
+        )
+        # A rank's I-blocks: one range per expert, half the bytes at two ranks.
+        part, count = read_rows(header, inner=slice(2, 4))
+        assert count == header.nbytes // 2
+        assert np.array_equal(part.numpy().view(want.dtype), want[:, 2:4])
+        part, count = read_rows(header, inner=slice(1, 2))
+        assert count == header.nbytes // 4
+        assert np.array_equal(part.numpy().view(want.dtype), want[:, 1:2])
+        part, count = read_rows(header, inner=slice(0, 4))
+        assert count == header.nbytes
+        rows, count = read_rows(header, rows=slice(3, 5))
+        assert count == header.nbytes // 4
+        assert np.array_equal(rows.numpy().view(want.dtype), want[3:5])
+        with pytest.raises(ValueError, match="outside"):
+            read_rows(header, inner=slice(3, 5))
+    with pytest.raises(ValueError, match="scalar"):
+        read_rows(manifest.tensors[L1 + "self_attn.o_proj.mul1"])
