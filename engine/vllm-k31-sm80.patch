+def test_ref_parity_ragged_accepted_1_to_8_null_and_softplus():
+    torch.manual_seed(2026)
+    H, D, W = 2, 128, 8
+    C = 3 * H * D
+    cs_len = 2 + W
+
+    # 8 sequences testing num_accepted_tokens=1..8, ragged q_lens, q_len=0, NULL_BLOCK_ID=0.
+    q_lens = [8, 5, 3, 1, 0, 4, 2, 6]
+    T = sum(q_lens)
+    qsl = torch.tensor([0] + list(torch.cumsum(torch.tensor(q_lens), dim=0).tolist()), dtype=torch.int64)
+    acc = torch.tensor([1, 2, 3, 4, 5, 6, 7, 8], dtype=torch.int64)
+
+    N = len(q_lens)
+    slots = 90
+    ssi = torch.zeros((N, W), dtype=torch.int64)
+    nxt = 1
+    for i_n in range(N):
+        if i_n == 5:
+            # Padding row: conv_slot == 0 (NULL_BLOCK_ID).
+            ssi[i_n].zero_()
+        elif i_n == 6:
+            # init_tok=6 has slot 0 -> init_state_slot == 0 padding guard.
+            ssi[i_n] = torch.arange(nxt, nxt + W, dtype=torch.int64)
+            ssi[i_n, 6] = 0
+            nxt += W
+        else:
+            ssi[i_n] = torch.arange(nxt, nxt + W, dtype=torch.int64)
+            if i_n == 1:
+                # Mid-window checkpoint slot 0 (skips state write at t=2).
+                ssi[i_n, 2] = 0
+            nxt += W
+
+    mixed = torch.randn((T, C), dtype=torch.bfloat16) * 0.3
+    cs = torch.randn((slots, C, cs_len), dtype=torch.bfloat16) * 0.3
+    cs[0].fill_(4.25)
+    cw = torch.randn((C, 4), dtype=torch.bfloat16) * 0.2
+    rg = torch.randn((T, H, D), dtype=torch.bfloat16) * 0.3
+    rb = torch.randn((T, H), dtype=torch.bfloat16) * 0.3
+    a_log = torch.randn((H,), dtype=torch.bfloat16) * 0.2 - 1.0
+    dt_bias = torch.randn((H * D,), dtype=torch.bfloat16) * 0.2
+    g2 = torch.randn((T, H, D), dtype=torch.bfloat16) * 0.3
+    nw = torch.randn((D,), dtype=torch.bfloat16) * 0.1 + 1.0
+    rs = torch.randn((slots, H, D, D), dtype=torch.float32) * 0.05
+    rs[0].fill_(9.5)
+
+    cs_orig = cs.clone()
+    rs_orig = rs.clone()
+
+    for lb in (-5.0, 0.0):
+        o_tri, cs_tri, rs_tri = ref_triton_spec_verify(
+            mixed, cs, cw, None, rg, rb, a_log, dt_bias, g2, nw, rs, ssi, qsl, acc, lb, 1e-5
+        )
+        o_fus, cs_fus, rs_fus = ref_fused_kda_spec_verify(
+            mixed, cs, cw, None, rg, rb, a_log, dt_bias, g2, nw, rs, ssi, qsl, acc, lb, 1e-5
+        )
+        assert torch.equal(cs_fus, cs_tri)
+        assert torch.allclose(rs_fus, rs_tri, atol=1e-6, rtol=1e-5)
+        assert torch.allclose(o_fus.float(), o_tri.float(), atol=1e-2, rtol=1e-2)
+
+        # Slot 0 never mutated; padding sequences output exact zeros.
+        assert torch.equal(cs_fus[0], cs_orig[0])
+        assert torch.equal(rs_fus[0], rs_orig[0])
+        b5, e5 = int(qsl[5]), int(qsl[6])
+        b6, e6 = int(qsl[6]), int(qsl[7])
+        assert (o_fus[b5:e5] == 0).all().item()
+        assert (o_fus[b6:e6] == 0).all().item()
+
+        # Ragged sequence 2 (q_len=3, cs_len=10): conv_state tail [:, 5:] untouched!
+        slot2 = int(ssi[2, 0].item())
+        assert torch.equal(cs_fus[slot2, :, 2 + 3 :], cs_orig[slot2, :, 2 + 3 :])
+
