index 0000000000..76911eadf4
--- /dev/null
+++ b/tests/models/kimi_k3/sm80/fake_dense.py
@@ -0,0 +1,104 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""A recording stand-in for the K3.1 dense ops module
+(vllm/sm80/kernels/k31q/dense_k31_ops.py) for CPU tests of the engine side.
+
+It computes nothing a kernel computes. Each EXL3 member's columns get
+:func:`member_output`, a function of the input rows, the member's own svh
+(its output columns) and a tag read from its trellis, so a test can tell
+which member filled which columns of which rows. :func:`old_path_output`
+is the same function for the EXL3 path, so the two backends give the same
+bits when, and only when, every member lands where the EXL3 path puts it.
+"""
+
+from dataclasses import dataclass, field
+
+import torch
+
+
+def member_output(x: torch.Tensor, trellis, svh, logical_out: int, dtype):
+    """[rows, logical_out]: the row sum of ``x`` times the member's svh
+    columns, plus a tag of its trellis (no host read)."""
+    tag = trellis.reshape(-1)[:8].float().sum() / 4096.0
+    rows = x.float().sum(dim=-1, keepdim=True)
+    return (rows * svh[:logical_out].float() + tag).to(dtype)
+
+
+def old_path_output(
+    x,
+    trellis,
+    suh,
+    svh,
+    bits_x2,
+    codebook,
+    logical_out,
+    row_chunk,
+    out_dtype=torch.bfloat16,
+):
+    """Stand-in for torch.ops.vllm.exl3_linear (one matrix)."""
+    return member_output(x, trellis, svh, logical_out, out_dtype)
+
+
+@dataclass
+class FakeDenseOps:
+    calls: list = field(default_factory=list)
+    workspace_calls: list = field(default_factory=list)
+    names: dict = field(default_factory=dict)  # trellis address -> matrix prefix
+
+    def install(self, monkeypatch) -> "FakeDenseOps":
+        """Make this object the dense library of every model processed in
+        the test: present, loaded, and reached through the operator's Python
+        body (the registered operator dispatches to CUDA only)."""
+        from vllm.sm80.kernels.k31q import dense
+
+        monkeypatch.setattr(dense, "library_built", lambda: True)
+        monkeypatch.setattr(dense, "load_dense_native", lambda: self)
+        monkeypatch.setattr(dense, "_dense_linear", dense._linear_impl)
+        monkeypatch.setattr(dense, "_WORKSPACE_NEEDS", {})
+        return self
+
+    def name(self, model) -> None:
+        """Learn the matrix prefix of every EXL3 weight of ``model``."""
+        for module in model.modules():
+            for weight in getattr(module, "exl3_weights", ()):
+                self.names[weight.trellis.data_ptr()] = weight.matrix.prefix
+
+    @staticmethod
+    def linear_workspace_size_k31(rows, padded_in, padded_out, members):
+        # Distinct per launch shape, so a test can tell which one was taken.
+        return 1000 * members + 10 * rows + padded_in // 128 + padded_out // 128
+
+    def linear_out_k31_multi(
+        self, x, trellises, suhs, svhs, bits_x2s, logical_outs, out, workspace
+    ):
+        members = len(trellises)
+        assert 1 <= members <= 4
+        assert len(suhs) == len(svhs) == len(bits_x2s) == len(logical_outs) == members
+        assert x.dtype == torch.bfloat16 and x.dim() == 2 and x.is_contiguous()
+        assert out.is_contiguous() and out.dtype in (torch.bfloat16, torch.float32)
+        assert workspace.dtype == torch.float32 and workspace.is_contiguous()
+        assert tuple(out.shape) == (x.shape[0], sum(logical_outs))
+        padded_in = trellises[0].shape[0] * 16
+        assert all(t.shape[0] * 16 == padded_in for t in trellises)
+        padded_out = sum(t.shape[1] * 16 for t in trellises)
+        assert workspace.numel() >= self.linear_workspace_size_k31(
+            x.shape[0], padded_in, padded_out, members
+        )
+        self.calls.append(
+            dict(
+                rows=x.shape[0],
+                cols=x.shape[1],
+                members=[self.names.get(t.data_ptr(), "?") for t in trellises],
+                bits_x2s=list(bits_x2s),
+                logical_outs=list(logical_outs),
+                out_dtype=out.dtype,
+                workspace=workspace.data_ptr(),
+                workspace_numel=workspace.numel(),
+            )
+        )
+        start = 0
+        for trellis, svh, width in zip(trellises, svhs, logical_outs):
+            out[:, start : start + width] = member_output(
+                x, trellis, svh, width, out.dtype
+            )
+            start += width
