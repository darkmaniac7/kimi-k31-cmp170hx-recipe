+        self.step_emb = nn.Embedding(max_steps, 4 * gru_dim)
+        self.e_proj = nn.Linear(markov_rank, 3 * gru_dim, bias=True)
+        self.s_proj = nn.Linear(gru_dim, 3 * gru_dim, bias=False)
+        self.out_proj = nn.Linear(2 * gru_dim, markov_rank, bias=False)
