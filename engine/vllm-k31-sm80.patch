+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU unit tests for _k31_glue_C v2 fused_kda_spec_verify and KDA wiring.
+
+Verifies:
+  - VLLM_K31_GLUE_KDA_SPEC defaults OFF and is independent of VLLM_K31_GLUE_ALL
+    (so Arm B VLLM_K31_GLUE_ALL=1 stays compatible with api_version=1).
+  - Exact pure-PyTorch reference parity for sliding conv_state update (width=4,
+    VAL=2), multi-step KDA recurrence, per-step state slot checkpointing,
+    NULL_BLOCK_ID=0 padding, ragged varlen batches, out_slot == init_state_slot
+    aliasing, both dim-first and step-first conv_state layouts, W in {4,8,10,13},
+    and num_accepted_tokens in 1..8.
+  - KimiK3DeltaAttention._forward intercepts pure spec-decode when enabled,
+    passes exact arguments, and returns early skipping o_norm.
+  - Decline reasons logged once for use_recoverssm=True, mixed prefill/decode,
+    undersized conv_state width, bad o_norm activation, and missing metadata.
+  - api_version < 2 is accepted when VLLM_K31_GLUE_KDA_SPEC=0 and rejected
+    loudly with BUILD_COMMAND when VLLM_K31_GLUE_KDA_SPEC=1.
+  - FakeTensorMode tracing for vllm::k31_glue_fused_kda_spec_verify and zero
+    CUDA lazy initialization on import.
+"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+import types
+from dataclasses import dataclass, field
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any
+
+import pytest
+import torch
+import torch.nn.functional as F
+from torch._subclasses.fake_tensor import FakeTensorMode
+
+from vllm import envs
+from vllm.sm80.kernels.k31q import glue, glue_ops, native
+
+_GLUE_ENV_VARS = (
+    "VLLM_K31_GLUE_ALL",
+    "VLLM_K31_GLUE_ATTNRES",
+    "VLLM_K31_GLUE_KDA",
+    "VLLM_K31_GLUE_KDA_SPEC",
+    "VLLM_K31_GLUE_ROUTER",
+    "VLLM_K31_GLUE_GEMV",
+    "VLLM_K31_GLUE_KDA_MAX_ROWS",
+    "VLLM_K31_GLUE_GEMV_MAX_ROWS",
+)
+
+
+def _clear_glue_env(monkeypatch) -> None:
+    for var in _GLUE_ENV_VARS:
+        monkeypatch.delenv(var, raising=False)
+    glue._reset_state()
+
+
+def ref_triton_spec_verify(
+    mixed_qkv: torch.Tensor,
+    conv_state: torch.Tensor,
+    conv_weight: torch.Tensor,
+    conv_bias: torch.Tensor | None,
+    raw_g: torch.Tensor,
+    raw_beta: torch.Tensor,
+    A_log: torch.Tensor,
+    dt_bias: torch.Tensor,
+    g2: torch.Tensor,
+    norm_weight: torch.Tensor,
+    recurrent_state: torch.Tensor,
+    spec_state_indices: torch.Tensor,
+    query_start_loc: torch.Tensor,
+    num_accepted_tokens: torch.Tensor,
+    lower_bound: float,
+    norm_eps: float,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Independent step-by-step reference matching Triton causal_conv1d_update
+    (IS_VARLEN=True, IS_SPEC_DECODING=True, width=4) + fused_recurrent_kda +
+    FusedRMSNormGated(sigmoid).
+    """
+    T, C = mixed_qkv.shape
+    H, D = raw_g.shape[1], raw_g.shape[2]
+    N = int(query_start_loc.numel()) - 1
+    S_cols = int(spec_state_indices.shape[1])
+
+    cs = conv_state.clone()
+    rs = recurrent_state.clone()
+    dim_first = cs.shape[1] == C and cs.shape[2] >= 2 + S_cols
+    assert dim_first or (cs.shape[2] == C and cs.shape[1] >= 2 + S_cols)
+    cs_len = cs.shape[2] if dim_first else cs.shape[1]
+
+    # Step 1: exact causal_conv1d_update (IS_VARLEN=True, IS_SPEC_DECODING=True)
+    conv_out = torch.zeros_like(mixed_qkv)
+    for i_n in range(N):
+        bos = int(query_start_loc[i_n].item())
+        eos = int(query_start_loc[i_n + 1].item())
+        q_len = eos - bos
+        if q_len <= 0:
+            continue
+        conv_slot = int(spec_state_indices[i_n, 0].item())
+        init_tok = int(num_accepted_tokens[i_n].item()) - 1
+        init_state_slot = (
+            int(spec_state_indices[i_n, init_tok].item())
+            if 0 <= init_tok < S_cols
+            else 0
+        )
+        if conv_slot <= 0 or init_state_slot <= 0:
+            continue
+
+        # Read full channel-major slot [C, cs_len] before any write.
+        slot_view = cs[conv_slot] if dim_first else cs[conv_slot].transpose(0, 1)
+        slot_old = slot_view.clone()
+        h0 = slot_old[:, init_tok + 0]
+        h1 = slot_old[:, init_tok + 1]
+        h2 = slot_old[:, init_tok + 2]
+
+        # Triton causal_conv1d.py:915-951: state_len_eff = 2 + q_len, VAL = 2.
+        # Writes indices 0..2+q_len-1 ONLY; indices >= 2+q_len stay unchanged.
+        slot_new = slot_old.clone()
+        slot_new[:, 0] = h1
+        slot_new[:, 1] = h2
+        for t in range(q_len):
+            xt = mixed_qkv[bos + t]
+            if 2 + t < cs_len:
+                slot_new[:, 2 + t] = xt
+            cat4 = torch.stack([h0, h1, h2, xt], dim=-1).float()
+            acc = (cat4 * conv_weight.float()).sum(dim=-1)
+            if conv_bias is not None:
+                acc = acc + conv_bias.float()
+            conv_out[bos + t] = F.silu(acc).to(torch.bfloat16)
+            h0, h1, h2 = h1, h2, xt
+
+        if dim_first:
+            cs[conv_slot] = slot_new
+        else:
+            cs[conv_slot] = slot_new.transpose(0, 1)
+
+    # Step 2: fused_recurrent_kda + Step 3: FusedRMSNormGated(sigmoid)
+    out = torch.zeros((T, H, D), dtype=torch.bfloat16, device=mixed_qkv.device)
+    a = torch.exp(A_log.float()).view(H, 1)
+    dt_b = dt_bias.float().view(H, D)
+    nw = norm_weight.float().view(1, D)
+
+    for i_n in range(N):
+        bos = int(query_start_loc[i_n].item())
+        eos = int(query_start_loc[i_n + 1].item())
+        q_len = eos - bos
+        if q_len <= 0:
+            continue
+        conv_slot = int(spec_state_indices[i_n, 0].item())
+        init_tok = int(num_accepted_tokens[i_n].item()) - 1
+        init_state_slot = (
+            int(spec_state_indices[i_n, init_tok].item())
+            if 0 <= init_tok < S_cols
+            else 0
+        )
+        if conv_slot <= 0 or init_state_slot <= 0:
+            out[bos:eos].zero_()
+            continue
+
+        st = rs[init_state_slot].clone()  # [H, D, D] FP32
+        for t in range(q_len):
+            tok = bos + t
+            post = conv_out[tok].float()
+            q = post[: H * D].view(H, D)
+            k = post[H * D : 2 * H * D].view(H, D)
+            v = post[2 * H * D :].view(H, D)
+
+            q = q * torch.rsqrt(q.square().sum(dim=-1, keepdim=True) + 1e-6) * (D**-0.5)
+            k = k * torch.rsqrt(k.square().sum(dim=-1, keepdim=True) + 1e-6)
+
+            gp = raw_g[tok].float() + dt_b
+            if lower_bound < 0.0:
+                log_decay = lower_bound * torch.sigmoid(a * gp)
+            else:
+                sp = torch.where(gp > 20.0, gp, torch.log1p(torch.exp(gp)))
+                log_decay = -a * sp
+            decay = torch.exp(log_decay)
+            beta = torch.sigmoid(raw_beta[tok].float()).view(H, 1)
+
+            st = st * decay.unsqueeze(1)
+            kv_pred = (st * k.unsqueeze(1)).sum(dim=-1)
+            dv = (v - kv_pred) * beta
+            st = st + dv.unsqueeze(-1) * k.unsqueeze(1)
+
+            out_slot = int(spec_state_indices[i_n, t].item()) if t < S_cols else 0
+            if out_slot > 0:
+                rs[out_slot] = st.clone()
+
+            o = (st * q.unsqueeze(1)).sum(dim=-1).to(torch.bfloat16).float()
+            inv_rms = torch.rsqrt(o.square().mean(dim=-1, keepdim=True) + float(norm_eps))
+            y = o * inv_rms * nw * torch.sigmoid(g2[tok].float())
+            out[tok] = y.to(torch.bfloat16)
+
+    return out, cs, rs
+
+
+def ref_fused_kda_spec_verify(
+    mixed_qkv: torch.Tensor,
+    conv_state: torch.Tensor,
+    conv_weight: torch.Tensor,
+    conv_bias: torch.Tensor | None,
+    raw_g: torch.Tensor,
+    raw_beta: torch.Tensor,
+    A_log: torch.Tensor,
+    dt_bias: torch.Tensor,
+    g2: torch.Tensor,
+    norm_weight: torch.Tensor,
+    recurrent_state: torch.Tensor,
+    spec_state_indices: torch.Tensor,
+    query_start_loc: torch.Tensor,
+    num_accepted_tokens: torch.Tensor,
+    lower_bound: float,
+    norm_eps: float,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Single-pass fused reference mirroring k31_fused_kda_spec_verify_d128_kernel."""
+    T, C = mixed_qkv.shape
+    H, D = raw_g.shape[1], raw_g.shape[2]
+    N = int(query_start_loc.numel()) - 1
+    S_cols = int(spec_state_indices.shape[1])
+
+    cs = conv_state.clone()
+    rs = recurrent_state.clone()
+    dim_first = cs.shape[1] == C and cs.shape[2] >= 2 + S_cols
+    cs_len = cs.shape[2] if dim_first else cs.shape[1]
+    out = torch.empty((T, H, D), dtype=torch.bfloat16, device=mixed_qkv.device)
+
+    cw = conv_weight.float()
+    cb = conv_bias.float() if conv_bias is not None else torch.zeros(C, dtype=torch.float32)
+    a = torch.exp(A_log.float()).view(H, 1)
+    dt_b = dt_bias.float().view(H, D)
+    nw = norm_weight.float().view(1, D)
+
+    for i_n in range(N):
+        bos = int(query_start_loc[i_n].item())
+        eos = int(query_start_loc[i_n + 1].item())
+        q_len = eos - bos
+        if q_len <= 0 or bos < 0 or eos > T:
+            continue
+        conv_slot = int(spec_state_indices[i_n, 0].item())
+        init_tok = int(num_accepted_tokens[i_n].item()) - 1
+        init_state_slot = (
+            int(spec_state_indices[i_n, init_tok].item())
+            if 0 <= init_tok < S_cols
+            else 0
+        )
+        if conv_slot <= 0 or init_state_slot <= 0:
+            out[bos:eos].zero_()
+            continue
+
+        slot_cs = cs[conv_slot] if dim_first else cs[conv_slot].transpose(0, 1)
+        bh0 = slot_cs[:, init_tok + 0].clone()
+        bh1 = slot_cs[:, init_tok + 1].clone()
+        bh2 = slot_cs[:, init_tok + 2].clone()
+        slot_cs[:, 0] = bh1
+        slot_cs[:, 1] = bh2
+        h0, h1, h2 = bh0.float(), bh1.float(), bh2.float()
+
+        st = rs[init_state_slot].clone()
+        for t in range(q_len):
+            tok = bos + t
+            xt_bf16 = mixed_qkv[tok]
+            if 2 + t < cs_len:
+                slot_cs[:, 2 + t] = xt_bf16
+            xt = xt_bf16.float()
+            acc = cb + h0 * cw[:, 0] + h1 * cw[:, 1] + h2 * cw[:, 2] + xt * cw[:, 3]
+            h0, h1, h2 = h1, h2, xt
+            post = F.silu(acc).to(torch.bfloat16).float()
+
+            q = post[: H * D].view(H, D)
+            k = post[H * D : 2 * H * D].view(H, D)
+            v = post[2 * H * D :].view(H, D)
+            q = q * (torch.rsqrt(q.square().sum(dim=-1, keepdim=True) + 1e-6) * (D**-0.5))
+            k = k * torch.rsqrt(k.square().sum(dim=-1, keepdim=True) + 1e-6)
+
+            gp = raw_g[tok].float() + dt_b
+            if lower_bound < 0.0:
+                log_decay = lower_bound * torch.sigmoid(a * gp)
+            else:
+                sp = torch.where(gp > 20.0, gp, torch.log1p(torch.exp(gp)))
+                log_decay = -a * sp
+            decay = torch.exp(log_decay)
+            beta = torch.sigmoid(raw_beta[tok].float()).view(H, 1)
+
+            st = st * decay.unsqueeze(1)
+            kv_pred = (st * k.unsqueeze(1)).sum(dim=-1)
+            dv = (v - kv_pred) * beta
+            st = st + dv.unsqueeze(-1) * k.unsqueeze(1)
+
+            out_slot = int(spec_state_indices[i_n, t].item()) if t < S_cols else 0
+            if out_slot > 0:
+                rs[out_slot] = st.clone()
+
+            o = (st * q.unsqueeze(1)).sum(dim=-1).to(torch.bfloat16).float()
+            inv_rms = torch.rsqrt(o.square().mean(dim=-1, keepdim=True) + float(norm_eps))
+            y = o * inv_rms * nw * torch.sigmoid(g2[tok].float())
+            out[tok] = y.to(torch.bfloat16)
+
+    return out, cs, rs
+
+
+@dataclass
+class FakeGlueV2Ops:
+    calls: list[dict[str, Any]] = field(default_factory=list)
+    api_version: int = 2
+    abi_version: int = 1
+
+    def install(self, monkeypatch) -> "FakeGlueV2Ops":
+        glue._reset_state()
+        monkeypatch.setattr(glue, "library_built", lambda: True)
+        monkeypatch.setattr(glue, "load_glue_native", lambda: self)
+        monkeypatch.setattr(glue, "_fused_kda_decode_op", glue._fused_kda_decode_impl)
+        monkeypatch.setattr(
+            glue, "_fused_kda_spec_verify_op", glue._fused_kda_spec_verify_impl
+        )
+        return self
+
+    def calls_for(self, op: str) -> list[dict[str, Any]]:
+        return [c for c in self.calls if c["op"] == op]
+
+    def build_info(self) -> dict[str, Any]:
+        return {
+            "abi_version": self.abi_version,
+            "api_version": self.api_version,
+            "torch_version": torch.__version__.split("+")[0],
+            "cuda_version": 13000,
+            "cxx11_abi": int(torch._C._GLIBCXX_USE_CXX11_ABI),
+        }
+
+    def fused_kda_decode(self, *args, **kwargs) -> None:
+        self.calls.append({"op": "fused_kda_decode"})
+
+    def fused_kda_spec_verify(
+        self,
+        mixed_qkv: torch.Tensor,
+        conv_state: torch.Tensor,
+        conv_weight: torch.Tensor,
+        conv_bias: torch.Tensor | None,
+        raw_g: torch.Tensor,
+        raw_beta: torch.Tensor,
+        A_log: torch.Tensor,
+        dt_bias: torch.Tensor,
+        g2: torch.Tensor,
+        norm_weight: torch.Tensor,
+        recurrent_state: torch.Tensor,
+        spec_state_indices: torch.Tensor,
+        query_start_loc: torch.Tensor,
+        num_accepted_tokens: torch.Tensor,
+        lower_bound: float,
+        norm_eps: float,
+        out: torch.Tensor,
+    ) -> None:
+        self.calls.append(
+            dict(
+                op="fused_kda_spec_verify",
+                tokens=int(mixed_qkv.shape[0]),
+                seqs=int(query_start_loc.shape[0] - 1),
+                s_cols=int(spec_state_indices.shape[1]),
+                heads=int(raw_g.shape[1]),
+                head_dim=int(raw_g.shape[2]),
+                conv_state_shape=tuple(conv_state.shape),
+                has_bias=conv_bias is not None,
+                lower_bound=float(lower_bound),
+                norm_eps=float(norm_eps),
+                spec_state_indices=spec_state_indices.clone(),
+                query_start_loc=query_start_loc.clone(),
+                num_accepted_tokens=num_accepted_tokens.clone(),
+            )
+        )
+        res, new_cs, new_rs = ref_fused_kda_spec_verify(
+            mixed_qkv,
+            conv_state,
+            conv_weight,
+            conv_bias,
+            raw_g,
+            raw_beta,
+            A_log,
+            dt_bias,
+            g2,
+            norm_weight,
+            recurrent_state,
+            spec_state_indices,
+            query_start_loc,
+            num_accepted_tokens,
+            lower_bound,
+            norm_eps,
+        )
+        conv_state.copy_(new_cs)
+        recurrent_state.copy_(new_rs)
+        out.copy_(res)
+
+
+def _make_spec_kda_stub(
+    *,
+    H: int = 4,
+    D: int = 128,
+    W: int = 4,
+    slots: int = 32,
+    dim_first: bool = True,
+    use_recoverssm: bool = False,
+    conv_state_len: int | None = None,
+    o_norm_activation: str = "sigmoid",
+    lower_bound: float | None = -5.0,
+    with_bias: bool = True,
+):
+    from vllm.models.kimi_k3.nvidia.kda import KimiK3DeltaAttention
+
+    attn = KimiK3DeltaAttention.__new__(KimiK3DeltaAttention)
+    C = 3 * H * D
+    cs_len = (2 + W) if conv_state_len is None else conv_state_len
+    attn.prefix = "model.layers.0.self_attn"
+    attn.head_dim = D
+    attn.num_heads = H
+    attn.conv_size = 4
+    attn.local_projection_size = H * D
+    attn.gate_lower_bound = lower_bound
+    attn.kda_decode_backend = "triton"
+    attn.kda_spec_decode_backend = "triton"
+    attn.kda_prefill_backend = "triton"
+    attn.use_recoverssm = use_recoverssm
+    attn.decode_conv1d_weight = None
+    attn.decode_norm_weight = None
+    attn.conv1d = SimpleNamespace(
+        weight=torch.randn((C, 1, 4), dtype=torch.bfloat16) * 0.2,
+        bias=(torch.randn((C,), dtype=torch.bfloat16) * 0.05) if with_bias else None,
+    )
+    attn.A_log = torch.randn((H,), dtype=torch.float32) * 0.3 - 1.0
+    attn.dt_bias = torch.randn((H * D,), dtype=torch.float32) * 0.2
+    attn._o_norm_called = 0
+
+    class _TrapONorm:
+        def __init__(self):
+            self.activation = o_norm_activation
+            self.eps = 1e-5
+            self.weight = torch.randn((D,), dtype=torch.float32) * 0.1 + 1.0
+
+        def __call__(self, x, g):
+            attn._o_norm_called += 1
+            raise AssertionError("o_norm should be skipped when fused_kda_spec_verify engages")
+
+    attn.o_norm = _TrapONorm()
+    cs_shape = (slots, C, cs_len) if dim_first else (slots, cs_len, C)
+    attn.kv_cache = [
+        torch.randn(cs_shape, dtype=torch.bfloat16) * 0.2,
+        torch.randn((slots, H, D, D), dtype=torch.float32) * 0.05,
+    ]
+    return attn
+
