+        o_norm_activation=("silu" if case == "bad_o_norm" else "sigmoid"),
+    )
+
+    meta = KimiK3KDAMetadata(
+        num_prefills=1 if case == "mixed_prefill" else 0,
+        num_prefill_tokens=2 if case == "mixed_prefill" else 0,
+        num_decodes=1 if case == "mixed_decode" else 0,
+        num_decode_tokens=1 if case == "mixed_decode" else 0,
