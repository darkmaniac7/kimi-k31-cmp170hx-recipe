+    assert [t.data_ptr() for t in group.svhs] == [
+        w.svh.data_ptr() for w in orig_weights
+    ]
+    # Workspace pre-registered before forward / CUDA Graph capture.
+    assert dense.workspace_elements(torch.device("cpu")) >= group.workspace
