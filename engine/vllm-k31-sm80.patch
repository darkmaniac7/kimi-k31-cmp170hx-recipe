@@ -0,0 +1,277 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The two-sided shortlist Markov sampling of the DSpark drafter
+(``vllm/sm80/spec_decode/markov_shortlist.py``) on a CUDA device, at the
+served Kimi K3.1 shape: 2 ranks of 81920 columns, Markov rank 512, a
+163840-token successor table.
+
+- Integer-valued logits and tables (every score exact in FP32): the base
+  candidates are each shard's largest logits, and both ranks' drafts equal a
+  torch reference of the documented rule, at 1 and 4 requests, 7 and 11 draft
+  steps, BF16 and FP32 base logits.
+- The launches of both ranks capture into one CUDA graph and replay on new
+  inputs.
+- ``-s`` prints the time to build one rank's tables and the graph replay time
+  of one rank's launches of a whole draft step against the launches of the
+  per-rank argmax path that need no EXL3 library (its full-shard Markov bias
+  adds 56 us a draft token on a CMP 170HX). Neither side includes the
+  all-reduce of every draft token, which both keep.
+
+Needs a CUDA device; no native library and no checkpoint.
+
+    GPU_LOCK_TOKENS=1 pytest -q -s tests/models/kimi_k3/sm80/test_k31_markov_shortlist_gpu.py
+"""
+
+import time
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from tests.models.kimi_k3.sm80 import gpu
+
+pytestmark = gpu.CUDA_MARKS
+
+TP, WIDTH, VOCAB, RANK = 2, 81920, 163840, 512
+TOKEN_MASK = (1 << 24) - 1
+
+
+def _key(values: torch.Tensor) -> torch.Tensor:
+    bits = values.float().contiguous().view(torch.int32).to(torch.int64)
+    bits = torch.where(bits == -(1 << 31), torch.zeros_like(bits), bits)
+    nan = (bits & 0x7FFFFFFF) > 0x7F800000
+    key = torch.where(bits >= 0, bits + (1 << 31), -1 - bits)
+    return torch.where(nan, torch.full_like(key, (1 << 32) - 1), key)
+
+
+@pytest.fixture(scope="module")
+def mt():
+    from vllm.sm80.spec_decode import markov_shortlist
+
+    return markov_shortlist
+
+
+@pytest.fixture(scope="module")
+def tables(mt):
+    """Integer-valued Markov tables and both ranks' states (16 base
+    candidates, 64 successors), with the time one rank's tables took."""
+    g = torch.Generator().manual_seed(1)
+    shape = (VOCAB, RANK)
+    w1 = torch.randint(-2, 3, shape, generator=g, dtype=torch.int8).to("cuda", torch.bfloat16)
+    w2 = torch.randint(-2, 3, shape, generator=g, dtype=torch.int8).to("cuda", torch.bfloat16)
+    states, seconds = [], []
+    for k in range(TP):
+        rows = w2[k * WIDTH : (k + 1) * WIDTH].contiguous()
+        torch.cuda.synchronize()
+        start = time.perf_counter()
+        cols, bias = mt.successor_table(w1, rows, 64)
+        torch.cuda.synchronize()
+        seconds.append(time.perf_counter() - start)
+        states.append(
+            SimpleNamespace(cands=16, successors=64, w1=w1, w2_rows=rows,
+                            succ_cols=cols, succ_bias=bias)
+        )
+    return states, seconds
+
+
+def _shards(base: torch.Tensor) -> list[torch.Tensor]:
+    return [base[:, k * WIDTH : (k + 1) * WIDTH] for k in range(TP)]
+
+
+def _sampling(mt, states, base, input_ids, anchors, steps, out=None):
+    """Both ranks' launches of a draft step in one process, their slots summed
+    as the all-reduce sums them. Returns rank 0's drafts and both ranks'."""
+    num_reqs = anchors.shape[0]
+    locals_ = _shards(base)
+    tops = [mt.top_candidates(locals_[k], WIDTH, states[k].cands) for k in range(TP)]
+    outs = [
+        torch.empty(num_reqs, steps, dtype=torch.int64, device=base.device)
+        for _ in range(TP)
+    ]
+    slots = None
+    for step in range(steps):
+        per_rank = [
+            mt.step_slots(
+                states[k], step, slots, locals_[k], tops[k][0], tops[k][1], input_ids,
+                anchors, outs[k], steps, k * WIDTH, k, TP, VOCAB,
+            )
+            for k in range(TP)
+        ]
+        slots = (per_rank[0].float() + per_rank[1].float()).to(torch.bfloat16)
+    for k in range(TP):
+        mt.last_drafts(slots, outs[k], steps, TP, VOCAB)
+    if out is not None:
+        out.copy_(outs[0])
+    return outs, tops
+
+
+def _reference(states, base, tops, first, steps):
+    """The documented rule in torch, with the kernels' base candidates."""
+    num_reqs = len(first)
+    locals_ = _shards(base)
+    out = torch.zeros(num_reqs, steps, dtype=torch.int64, device=base.device)
+    for r in range(num_reqs):
+        prev = int(first[r])
+        for i in range(steps):
+            row = r * steps + i
+            best_key, best_tok = -1, 0
+            for k, st in enumerate(states):
+                p = min(max(prev, 0), st.w1.shape[0] - 1)
+                succ = st.succ_cols[p].long()
+                top = tops[k][0][row].long()
+                e = st.w1[p].float()
+                score = torch.cat(
+                    [
+                        locals_[k][row, succ.clamp(min=0)].float() + st.succ_bias[p],
+                        tops[k][1][row] + st.w2_rows[top.clamp(min=0)].float() @ e,
+                    ]
+                )
+                cols = torch.cat([succ, top])
+                comp = (_key(score) << 24) | (TOKEN_MASK - (k * WIDTH + cols))
+                comp = torch.where(cols >= 0, comp, torch.full_like(comp, -1)).max()
+                key = int(comp >> 24) if comp >= 0 else 0
+                if key > best_key:
+                    best_key = key
+                    best_tok = TOKEN_MASK - int(comp & TOKEN_MASK) if comp >= 0 else 0
+            prev = best_tok
+            out[r, i] = prev
+    return out
+
+
+def _base(g, rows, dtype):
+    base = torch.randint(-3, 4, (rows, VOCAB), generator=g).float()
+    base[0, [4095, 4096, 81919, 81920, 163839]] = 9.0
+    base[rows - 1, [81920 + 4096 * 7 + 1, 4096 * 3]] = float("nan")
+    base[rows // 2, 17] = float("inf")
+    base[rows // 2, 5] = -0.0
+    return base.to("cuda", dtype)
+
+
+@pytest.mark.parametrize("dtype", [torch.bfloat16, torch.float32])
+@pytest.mark.parametrize("num_reqs, steps", [(1, 7), (4, 11)])
+def test_exact_scores_draft_the_reference(mt, tables, dtype, num_reqs, steps):
+    states, _ = tables
+    g = torch.Generator().manual_seed(steps * 100 + num_reqs)
+    rows = num_reqs * steps
+    base = _base(g, rows, dtype)
+    input_ids = torch.randint(0, VOCAB, (64,), generator=g, dtype=torch.int32).cuda()
+    anchors = (torch.arange(num_reqs) * steps).cuda()
+    outs, tops = _sampling(mt, states, base, input_ids, anchors, steps)
+    assert torch.equal(outs[0], outs[1])
+    # The base candidates: each shard's largest logits, the lower column
+    # first among equal ones.
+    cols = torch.arange(WIDTH, device="cuda")
+    for k, local in enumerate(_shards(base)):
+        for row in (0, rows // 2, rows - 1):
+            comp = (_key(local[row]) << 20) | ((1 << 20) - 1 - cols)
+            want = (1 << 20) - 1 - (comp.topk(states[k].cands).values & ((1 << 20) - 1))
+            assert torch.equal(tops[k][0][row].long(), want)
+    want = _reference(states, base, tops, input_ids[anchors].tolist(), steps)
+    assert torch.equal(outs[0], want)
+
+
+def test_launches_capture_and_replay(mt, tables):
+    states, _ = tables
+    g = torch.Generator().manual_seed(11)
+    num_reqs, steps = 2, 7
+    base = _base(g, num_reqs * steps, torch.bfloat16)
+    input_ids = torch.randint(0, VOCAB, (64,), generator=g, dtype=torch.int32).cuda()
+    anchors = (torch.arange(num_reqs) * steps).cuda()
+    out = torch.zeros(num_reqs, steps, dtype=torch.int64, device="cuda")
+    _sampling(mt, states, base, input_ids, anchors, steps)  # compile
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        _sampling(mt, states, base, input_ids, anchors, steps, out)
+    for seed in range(3):
+        g2 = torch.Generator().manual_seed(100 + seed)
+        base.copy_(_base(g2, num_reqs * steps, torch.bfloat16))
+        input_ids.copy_(torch.randint(0, VOCAB, (64,), generator=g2, dtype=torch.int32))
+        graph.replay()
+        _, tops = _sampling(mt, states, base, input_ids, anchors, steps)
+        want = _reference(states, base, tops, input_ids[anchors].tolist(), steps)
+        assert torch.equal(out, want)
+
+
+def _replay_us(build, warmup=30, iters=300) -> float:
+    build()  # compile
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        build()
+    for _ in range(warmup):
+        graph.replay()
+    torch.cuda.synchronize()
+    start = time.perf_counter()
+    for _ in range(iters):
+        graph.replay()
+    torch.cuda.synchronize()
+    return (time.perf_counter() - start) / iters * 1e6
+
+
+def test_timing_table(mt, tables):
+    """One rank's launches of a draft step, replayed from a CUDA graph."""
+    from vllm.sm80.spec_decode import shard_argmax as sa
+
+    states, seconds = tables
+    g = torch.Generator().manual_seed(5)
+    input_ids = torch.randint(0, VOCAB, (64,), generator=g, dtype=torch.int32).cuda()
+    anchors = torch.zeros(1, dtype=torch.int64, device="cuda")
+    name = torch.cuda.get_device_name(0)
+    sms = torch.cuda.get_device_properties(0).multi_processor_count
+    print(f"\nmarkov_shortlist on {name} ({sms} SMs), one rank, one request")
+    print(f"successor table of one rank (64 successors): {seconds[0]:.1f} s")
+    print("steps cands succ  search_us  steps_us  total_us  argmax_path_us(no bias)")
+    worst = 0.0
+    w1 = states[0].w1
+    for steps in (4, 7, 9, 11):
+        base = (torch.randn(steps, VOCAB, generator=g) * 3).to("cuda", torch.bfloat16)
+        local = base[:, :WIDTH].contiguous()
+        bias = torch.randn(1, WIDTH, generator=g).to("cuda", torch.bfloat16)
+        chunks = -(-WIDTH // sa.BLOCK)
+
+        def argmax_path():
+            # The per-rank argmax path's launches of every draft token but its
+            # Markov bias (the EXL3 launch) and its all-reduce.
+            prev = input_ids[anchors]
+            for i in range(steps):
+                embed = torch.nn.functional.embedding(prev, w1)
+                logits = (local[i : i + 1] + bias).float()
+                slots = sa.chunk_slots(logits, 0, 0, TP, chunks)
+                prev = sa.pick(slots, VOCAB, TP * chunks)
+            return embed, prev
+
+        base_us = _replay_us(argmax_path)
+        for cands, successors in ((16, 64), (32, 64), (32, 32)):
+            st = SimpleNamespace(**vars(states[0]))
+            st.cands, st.successors = cands, successors
+            st.succ_cols = states[0].succ_cols[:, :successors].contiguous()
+            st.succ_bias = states[0].succ_bias[:, :successors].contiguous()
+            tops = mt.top_candidates(local, WIDTH, cands)
+            out = torch.empty(1, steps, dtype=torch.int64, device="cuda")
+
+            def search():
+                return mt.top_candidates(local, WIDTH, cands)
+
+            def chain(tops=tops):
+                slots = None
+                for step in range(steps):
+                    slots = mt.step_slots(
+                        st, step, slots, local, tops[0], tops[1], input_ids, anchors,
+                        out, steps, 0, 0, TP, VOCAB,
+                    )
+                mt.last_drafts(slots, out, steps, TP, VOCAB)
+                return out
+
+            def total():
+                return chain(mt.top_candidates(local, WIDTH, cands))
+
+            search_us, chain_us, total_us = (
+                _replay_us(search),
+                _replay_us(chain),
+                _replay_us(total),
+            )
+            worst = max(worst, total_us)
+            print(
+                f"{steps:5d} {cands:5d} {successors:4d}  {search_us:9.1f} {chain_us:9.1f} "
+                f"{total_us:9.1f}  {base_us:9.1f}"
+            )
+    assert worst < 5000.0
