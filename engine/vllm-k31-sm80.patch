@@ -0,0 +1,68 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Non-capturing RoPE position bounds guard (VLLM_K31_ROPE_GUARDS=1).
+
+Validates position tensors before launching rotary_embedding kernels so out-of-range
+or corrupted int64 indices fail with a Python RuntimeError instead of faulting on
+the GPU with Xid 13. Skipped automatically during CUDA graph capture and
+torch.compile tracing.
+"""
+
+import torch
+
+from vllm import envs
+
+
+class K31RopeGuardError(RuntimeError):
+    """Raised when VLLM_K31_ROPE_GUARDS=1 rejects a RoPE position buffer."""
+
+
+def enabled() -> bool:
+    return bool(getattr(envs, "VLLM_K31_ROPE_GUARDS", False))
+
+
+def _is_capturing(tensor: torch.Tensor) -> bool:
+    if torch.compiler.is_compiling():
+        return True
+    if tensor.is_cuda and torch.cuda.is_current_stream_capturing():
+        return True
+    return False
+
+
+def check_positions(
+    op: str,
+    positions: torch.Tensor,
+    cos_sin_cache: torch.Tensor,
+) -> None:
+    if not enabled() or _is_capturing(positions):
+        return
+    if positions.dtype != torch.int64:
+        raise K31RopeGuardError(
+            f"{op}: positions dtype {positions.dtype}, expected torch.int64 "
+            f"(shape={tuple(positions.shape)})"
+        )
+    if not positions.is_contiguous():
+        raise K31RopeGuardError(
+            f"{op}: positions must be contiguous "
+            f"(shape={tuple(positions.shape)}, stride={positions.stride()})"
+        )
+    if cos_sin_cache.dim() != 2 or cos_sin_cache.size(0) <= 0:
+        raise K31RopeGuardError(
+            f"{op}: invalid cos_sin_cache shape {tuple(cos_sin_cache.shape)}"
+        )
+    if positions.numel() == 0:
+        return
+    limit = int(cos_sin_cache.size(0))
+    flat = positions.reshape(-1)
+    pmin = int(flat.min().item())
+    pmax = int(flat.max().item())
+    if pmin < 0 or pmax >= limit:
+        bad = (flat < 0) | (flat >= limit)
+        first_idx = int(torch.nonzero(bad, as_tuple=False)[0].item())
+        val = int(flat[first_idx].item())
+        raw_hex = f"0x{val & ((1 << 64) - 1):016x}"
+        raise K31RopeGuardError(
+            f"{op}: positions out of range [0, {limit}): "
+            f"min={pmin}, max={pmax}, first bad positions[{first_idx}]={val} "
+            f"({raw_hex}), shape={tuple(positions.shape)}"
+        )
