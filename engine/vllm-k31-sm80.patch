+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU and CUDA tests for TP=4 (I=768) VQ/EXL3 MoE readiness and adaptive
+tail-expert pruning (VLLM_K31Q_MOE_MAX_TOPK / VLLM_K31Q_MOE_REL_THRESH).
+
+Covers:
+  1. k31q-v1 manifest inspection: verifies all routed MoE layers use VQ when
+     the checkpoint manifest is present on disk.
+  2. expert_split at TP=4 (intermediate=3072 -> 768 = 6 x 128 blocks per rank).
+  3. K31Exl3MoEMethod TP=4 zero-padding (< part_width -> part_width):
+     loads real file columns, zero-pads [local_intermediate : part_width] in
+     trellis/suh/svh, exposes part_width in exl3_tables & launcher, and keeps
+     test_exl3_kernel_shape_gate intact when latent != K31_KERNEL_SHAPE[0].
+  4. Adaptive MoE router tail-expert pruning switches:
+     - Default 0 / 0.0: zero-overhead byte-identical passthrough.
+     - Unsorted router weights (sigmoid + bias selection order != raw weight
+       order): keeps true top weights in original column positions, sets -1/0.0
+       on dropped slots.
+     - VLLM_K31Q_MOE_REL_THRESH: always keeps >= 4 valid experts per row.
+     - Renormalization (orig_sum / kept_sum) and FakeTensorMode tracing.
+  5. GPU silicon tests on sm_80 / sm_120:
+     - _k31_vq_C at I=768 (TP=4, H=3584): vq_pack -> vq_dequant_reference
+       bit-exactness, moe_out_vq (decode) and moe_out_prefill_vq (prefill)
+       numerical agreement across all 5 VQ rates, and 4x TP=4 shards == 2x TP=2.
+     - _k31_glue_C.moe_prune_topk vs PyTorch reference, CUDA Graph replay, and
+       moe_out_vq with pruned topk_ids matching vq_reference_forward.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+from torch._subclasses.fake_tensor import FakeTensorMode
+
+from vllm import envs
+from vllm.sm80.kernels.k31q import codec, glue, glue_ops, moe, vq_ops
+from vllm.sm80.kernels.k31q.codec import BLOCK, IN_LATENT, OUT_LATENT, VqGeometry
