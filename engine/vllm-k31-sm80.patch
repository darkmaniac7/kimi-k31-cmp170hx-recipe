+#pragma unroll
+  for (int d = 1; d < 32; d <<= 1) {
+    const int nc = __shfl_up_sync(0xffffffffu, wc, d);
+    const int nt = __shfl_up_sync(0xffffffffu, wt, d);
+    if (lane >= d) { wc += nc; wt += nt; }
