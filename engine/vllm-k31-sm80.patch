+    caches.topk = torch.cat((caches.topk, torch.full((2, 512), -1, dtype=torch.int32, device='cuda')))
+    caches.candidates = torch.cat((caches.candidates, torch.full((2, 2048), -1, dtype=torch.int32, device='cuda')))
