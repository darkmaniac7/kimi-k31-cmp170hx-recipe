+inline P2PContext* lookup_fast(int64_t handle) {
+  int slot = static_cast<int>(handle & 0x3F);
+  P2PContext* ctx = g_slots[slot].load(std::memory_order_acquire);
+  TORCH_CHECK(ctx != nullptr && ctx->handle_id == handle,
+              "k31_p2p: invalid or destroyed handle ", handle);
+  return ctx;
+}
