+@pytest.mark.parametrize("pp", [2, 4])
+@pytest.mark.parametrize("scenario", ["full_accept", "partial_a", "bonus_mismatch"])
+def test_pipespec_emulation_exact_token_stream_and_rollback(
+    monkeypatch, pp, scenario
+):
+    sched = _make_pp_scheduler(monkeypatch, pp=pp, k_max=KMAX, pipespec=True)
+    assert sched._pipespec.enabled
+    assert sched._pipespec.chunk_k == 5
+
+    def draft_fn(pos, k):
+        if scenario == "full_accept":
+            return [1000 + pos + i for i in range(k)]
+        if scenario == "partial_a":
+            # Accept first 2 drafts, reject draft 2 -> A partial, B always dropped!
+            out = [1000 + pos + i for i in range(k)]
+            out[2] = -999
+            return out
+        # bonus_mismatch: A accepts all 5 drafts, but P2[0] (idx 5) misses A's bonus!
+        out = [1000 + pos + i for i in range(k)]
+        out[5] = -888
+        return out
+
+    req = create_requests(num_requests=1, num_tokens=8, max_tokens=300)[0]
+    sched.add_request(req)
+    eng = _PipeSpecEngine(sched, pp=pp, draft_fn=draft_fn)
+    for _ in range(40):
+        eng.step()
+    eng.drain()
+
+    # Exact token stream matches sequential ground-truth oracle with zero gaps/dups!
+    emitted = eng.emitted_tokens[req.request_id]
+    assert len(emitted) >= 20
+    assert emitted == [1000 + 8 + i for i in range(len(emitted))]
+    assert list(req.output_token_ids) == emitted
+    # No leaked placeholders or num_computed_tokens drift after drain!
+    assert req.num_output_placeholders == 0
+    assert req.num_computed_tokens == req.num_prompt_tokens + len(emitted) - 1 or (
+        req.num_computed_tokens == req.num_prompt_tokens + len(emitted)
+    )
+
+    stats = sched._pipespec.stats
+    assert stats["epochs"] >= 4
+    assert stats["b_sched"] == stats["epochs"]
+    if scenario == "full_accept":
+        # Epoch 0 has no prior P2 so B0 drops; every subsequent epoch has valid B!
+        assert stats["b_valid"] >= 3
+        assert stats["b_tokens"] > 0
+    elif scenario == "partial_a":
+        assert stats["b_valid"] == 0
+        assert stats["b_invalid"] == stats["epochs"]
+    else:
+        assert stats["a_full"] >= 3
+        assert stats["b_valid"] == 0
+        assert stats["b_invalid"] == stats["epochs"]
