+# ---------------------------------------------------------------------------
+# 8. Exact G4 Run 3 first-token.json XTML verification with KimiK3ReasoningParser
+# ---------------------------------------------------------------------------
+
+
+class _XtmlDummyTokenizer:
+    OPEN_THINK = "<|open|>think<|sep|>"
+    CLOSE_THINK = "<|close|>think<|sep|>"
+    OPEN_RESP = "<|open|>response<|sep|>"
+
+    def __len__(self) -> int:
+        return 1
+
+    def get_vocab(self) -> dict[str, int]:
+        return {}
+
+    def encode(self, text: str, *args, **kwargs) -> list[int]:
+        if text == self.OPEN_THINK:
+            return [1, 2, 3]
+        if text == self.CLOSE_THINK:
+            return [4, 2, 3]
+        if text == self.OPEN_RESP:
+            return [1, 5, 3]
+        return [ord(ch) for ch in text]
+
+
+def test_kimi_k3_reasoning_parser_strips_g4_run3_xtml():
+    """Verify KimiK3ReasoningParser + KimiK3Parser strip XTML markers on the
+    exact G4 Run 3 first-token.json output in non-streaming and streaming modes."""
+    raw_g4_spaced = (
+        " The capital of France is Paris. "
+        "<|close|> response <|sep|> <|close|> message <|sep|>"
+    )
+    raw_g4_tight = (
+        " The capital of France is Paris."
+        "<|close|>response<|sep|><|close|>message<|sep|>"
+    )
+    tok = cast(TokenizerLike, _XtmlDummyTokenizer())
+
+    # 1. adjust_request disables special-token spacing so live serving emits tight XTML.
+    req = ChatCompletionRequest(model="kimi-k3.1", messages=[])
+    p_default = KimiK3ReasoningParser(tok)
+    p_default.adjust_request(req)
+    assert req.skip_special_tokens is False
+    assert req.spaces_between_special_tokens is False
+
+    # 2. Non-streaming, thinking OFF: both spaced G4 Run 3 text and tight text strip cleanly.
+    p_off = KimiK3ReasoningParser(tok, chat_template_kwargs={"thinking": False})
+    r_sp, c_sp = p_off.extract_reasoning(raw_g4_spaced, req)
+    assert r_sp is None
+    assert c_sp is not None
+    assert "<|" not in c_sp and "response" not in c_sp and "message" not in c_sp
+    assert c_sp.rstrip() == " The capital of France is Paris."
+
+    r_tg, c_tg = p_off.extract_reasoning(raw_g4_tight, req)
+    assert r_tg is None
+    assert c_tg == " The capital of France is Paris."
+
+    # 3. Non-streaming, thinking ON (with think channel + response wrapper).
+    p_on = KimiK3ReasoningParser(tok, chat_template_kwargs={"thinking": True})
+    full_spaced = (
+        "<|open|>think<|sep|>Recall capital.<|close|>think<|sep|>"
+        "<|open|>response<|sep|>" + raw_g4_spaced
+    )
+    full_tight = (
+        "<|open|>think<|sep|>Recall capital.<|close|>think<|sep|>"
+        "<|open|>response<|sep|>" + raw_g4_tight
+    )
+    r_on_sp, c_on_sp = p_on.extract_reasoning(full_spaced, req)
+    assert r_on_sp == "Recall capital."
+    assert c_on_sp is not None
+    assert "<|" not in c_on_sp
+    assert c_on_sp.rstrip() == " The capital of France is Paris."
+
+    r_on_tg, c_on_tg = p_on.extract_reasoning(full_tight, req)
+    assert r_on_tg == "Recall capital."
+    assert c_on_tg == " The capital of France is Paris."
+
+    # 4. Streaming through KimiK3Parser (reasoning_parser_name="kimi_k3"), thinking OFF.
+    parser_cls = ParserManager.get_parser(reasoning_parser_name="kimi_k3")
+    assert parser_cls is not None and issubclass(parser_cls, KimiK3Parser)
+
+    stream_off = parser_cls(tok, chat_template_kwargs={"thinking": False})
+    req_off = ChatCompletionRequest(
+        model="kimi-k3.1", messages=[], chat_template_kwargs={"thinking": False}
+    )
+    chunks_off = [
+        (" The capital of France is Paris.", [10]),
+        ("<|close|>", [4]),
+        ("response", [5]),
+        ("<|sep|>", [3]),
+        ("<|close|>", [4]),
+        ("message", [6]),
+        ("<|sep|>", [3]),
+    ]
+    emitted_r, emitted_c = [], []
+    for idx, (text_chunk, tids) in enumerate(chunks_off):
+        delta = stream_off.parse_delta(
+            text_chunk,
+            tids,
+            req_off,
+            prompt_token_ids=[1, 5, 3],
+            finished=(idx == len(chunks_off) - 1),
+        )
+        if delta is not None:
+            if delta.reasoning:
+                emitted_r.append(delta.reasoning)
+            if delta.content:
+                emitted_c.append(delta.content)
+    assert "".join(emitted_r) == ""
+    assert "".join(emitted_c) == " The capital of France is Paris."
+
+    # 5. Streaming through KimiK3Parser, thinking ON.
+    stream_on = parser_cls(tok, chat_template_kwargs={"thinking": True})
+    req_on = ChatCompletionRequest(
+        model="kimi-k3.1", messages=[], chat_template_kwargs={"thinking": True}
+    )
+    chunks_on = [
+        ("<|open|>think<|sep|>", [1, 2, 3]),
+        ("Recall capital.", [20]),
+        ("<|close|>think<|sep|>", [4, 2, 3]),
+        ("<|open|>response<|sep|>", [1, 5, 3]),
+        (" The capital of France is Paris.", [21]),
+        ("<|close|>", [4]),
+        ("response", [5]),
+        ("<|sep|>", [3]),
+        ("<|close|>", [4]),
+        ("message", [6]),
+        ("<|sep|>", [3]),
+    ]
+    emitted_r_on, emitted_c_on = [], []
+    for idx, (text_chunk, tids) in enumerate(chunks_on):
+        delta = stream_on.parse_delta(
+            text_chunk,
+            tids,
+            req_on,
+            prompt_token_ids=[99],
+            finished=(idx == len(chunks_on) - 1),
+        )
+        if delta is not None:
+            if delta.reasoning:
+                emitted_r_on.append(delta.reasoning)
+            if delta.content:
+                emitted_c_on.append(delta.content)
+    assert "".join(emitted_r_on) == "Recall capital."
+    assert "".join(emitted_c_on) == " The capital of France is Paris."
