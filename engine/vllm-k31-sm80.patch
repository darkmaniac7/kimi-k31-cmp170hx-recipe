+// ---------------------------------------------------------------------------
+// Kernel 2b: p2p_moe_dual_reduce_rmsnorm (chunked streaming path)
+// ---------------------------------------------------------------------------
+
+template <int RANK, bool IS_SHM, bool HAS_RES, bool WEIGHT_FP32>
+__global__ __launch_bounds__(kBlockThreads, 4)
+void p2p_moe_dual_stream_kernel(
+    const uint4* routed_partial,
+    const uint4* shared_partial,
+    const void* __restrict__ rms_weight,
+    const uint4* residual,
+    uint4* out_routed_normed,
+    uint4* out_shared_sum,
+    uint4* out_shared_res,
+    uint8_t* __restrict__ my_inbox,
+    FlagLine* __restrict__ my_flags,
+    uint8_t* __restrict__ peer_inbox,
+    FlagLine* __restrict__ peer_flags,
+    DeviceControlState* __restrict__ dev_ctrl,
+    HostMappedControl* __restrict__ host_ctrl,
+    uint64_t slot_bytes,
+    uint32_t expected_gen,
+    int M,
+    int r_vecs,
+    int s_vecs,
+    int max_chunk_rows,
+    float eps,
+    bool write_shared_sum) {
+  __shared__ uint64_t s_base_seq;
+  __shared__ uint32_t s_err;
+  __shared__ float s_warp_sq[kBlockThreads / 32];
+
+  const int bid = blockIdx.x;
+  const int tid = threadIdx.x;
+  if (tid == 0) {
+    s_base_seq = ld_acquire_gpu_u64(&dev_ctrl->ar_op_seq);
+    s_err = check_entry_status(dev_ctrl, host_ctrl, expected_gen);
+  }
+  __syncthreads();
+  const uint64_t base_seq = s_base_seq;
+
+  constexpr int kRoutedCtas = kFixedGrid / 2;
+  constexpr int kSharedCtas = kFixedGrid - kRoutedCtas;
+
+  uint64_t chunk_idx = 0ull;
+  for (int row_base = 0; row_base < M; row_base += max_chunk_rows, ++chunk_idx) {
+    const int cur_m = (M - row_base < max_chunk_rows) ? (M - row_base) : max_chunk_rows;
+    const uint64_t seq = base_seq + 1ull + chunk_idx;
+    const int slot = static_cast<int>(seq & kSlotMask);
+    const uint64_t flag_val = pack_flag(seq, kOpKindMoeStream);
+
+    uint4* peer_slot = reinterpret_cast<uint4*>(peer_inbox + static_cast<size_t>(slot) * slot_bytes);
+    const uint4* my_slot = reinterpret_cast<const uint4*>(my_inbox + static_cast<size_t>(slot) * slot_bytes);
+
+    if (bid < kRoutedCtas) {
+      if (bid < cur_m) {
+        if (s_err != 0u) {
+          for (int lm = bid; lm < cur_m; lm += kRoutedCtas) {
+            poison_v4_stripe(out_routed_normed, static_cast<int64_t>(row_base + lm) * r_vecs, r_vecs, tid);
+          }
+          continue;
+        }
+        for (int lm = bid; lm < cur_m; lm += kRoutedCtas) {
+          int64_t g_row = static_cast<int64_t>(row_base + lm) * r_vecs;
+          int s_row = lm * r_vecs;
+          for (int i = tid; i < r_vecs; i += kBlockThreads) {
+            uint4 v = ld_local_v4(routed_partial + g_row + i);
+            st_peer_v4<IS_SHM>(peer_slot + s_row + i, v);
+          }
+        }
+        __syncthreads();
+        if (tid == 0) {
+          st_release_sys_u64(&peer_flags[slot * kFixedGrid + bid].val, flag_val);
+          s_err = wait_for_peer_flag(my_flags, slot, bid, flag_val, dev_ctrl, host_ctrl, expected_gen);
+        }
+        __syncthreads();
+        if (s_err != 0u) {
+          for (int lm = bid; lm < cur_m; lm += kRoutedCtas) {
+            poison_v4_stripe(out_routed_normed, static_cast<int64_t>(row_base + lm) * r_vecs, r_vecs, tid);
+          }
+          continue;
+        }
+
+        for (int lm = bid; lm < cur_m; lm += kRoutedCtas) {
+          int64_t g_row = static_cast<int64_t>(row_base + lm) * r_vecs;
+          int s_row = lm * r_vecs;
+          if (r_vecs <= 2 * kBlockThreads) {
+            const bool has0 = (tid < r_vecs);
+            const bool has1 = (tid + kBlockThreads < r_vecs);
+            float sq = 0.0f;
+            float s0[8], s1[8];
+            if (has0) {
+              uint4 l0 = ld_local_v4(routed_partial + g_row + tid);
+              uint4 p0 = ld_peer_v4<IS_SHM>(my_slot + s_row + tid);
+              float2 a0 = fixed_add_pair<RANK>(l0.x, p0.x);
+              float2 a1 = fixed_add_pair<RANK>(l0.y, p0.y);
+              float2 a2 = fixed_add_pair<RANK>(l0.z, p0.z);
+              float2 a3 = fixed_add_pair<RANK>(l0.w, p0.w);
+              s0[0] = a0.x; s0[1] = a0.y; s0[2] = a1.x; s0[3] = a1.y;
+              s0[4] = a2.x; s0[5] = a2.y; s0[6] = a3.x; s0[7] = a3.y;
+#pragma unroll
+              for (int k = 0; k < 8; ++k) sq += s0[k] * s0[k];
+            }
+            if (has1) {
+              uint4 l1 = ld_local_v4(routed_partial + g_row + tid + kBlockThreads);
+              uint4 p1 = ld_peer_v4<IS_SHM>(my_slot + s_row + tid + kBlockThreads);
+              float2 b0 = fixed_add_pair<RANK>(l1.x, p1.x);
+              float2 b1 = fixed_add_pair<RANK>(l1.y, p1.y);
+              float2 b2 = fixed_add_pair<RANK>(l1.z, p1.z);
+              float2 b3 = fixed_add_pair<RANK>(l1.w, p1.w);
+              s1[0] = b0.x; s1[1] = b0.y; s1[2] = b1.x; s1[3] = b1.y;
+              s1[4] = b2.x; s1[5] = b2.y; s1[6] = b3.x; s1[7] = b3.y;
+#pragma unroll
+              for (int k = 0; k < 8; ++k) sq += s1[k] * s1[k];
+            }
+            const float total_sq = block_reduce_sum_deterministic(sq, s_warp_sq);
+            const float inv_rms = rsqrtf(total_sq / static_cast<float>(r_vecs * 8) + eps);
+            if (has0) {
+              float w0[8];
+              load_rms_weight_8<WEIGHT_FP32>(rms_weight, tid, w0);
+              uint4 out0;
+              out0.x = f32x2_to_bf16x2((s0[0] * inv_rms) * w0[0], (s0[1] * inv_rms) * w0[1]);
+              out0.y = f32x2_to_bf16x2((s0[2] * inv_rms) * w0[2], (s0[3] * inv_rms) * w0[3]);
+              out0.z = f32x2_to_bf16x2((s0[4] * inv_rms) * w0[4], (s0[5] * inv_rms) * w0[5]);
+              out0.w = f32x2_to_bf16x2((s0[6] * inv_rms) * w0[6], (s0[7] * inv_rms) * w0[7]);
+              st_local_v4(out_routed_normed + g_row + tid, out0);
+            }
+            if (has1) {
+              float w1[8];
+              load_rms_weight_8<WEIGHT_FP32>(rms_weight, tid + kBlockThreads, w1);
+              uint4 out1;
+              out1.x = f32x2_to_bf16x2((s1[0] * inv_rms) * w1[0], (s1[1] * inv_rms) * w1[1]);
+              out1.y = f32x2_to_bf16x2((s1[2] * inv_rms) * w1[2], (s1[3] * inv_rms) * w1[3]);
+              out1.z = f32x2_to_bf16x2((s1[4] * inv_rms) * w1[4], (s1[5] * inv_rms) * w1[5]);
+              out1.w = f32x2_to_bf16x2((s1[6] * inv_rms) * w1[6], (s1[7] * inv_rms) * w1[7]);
+              st_local_v4(out_routed_normed + g_row + tid + kBlockThreads, out1);
+            }
+          } else {
+            float sq = 0.0f;
+            for (int i = tid; i < r_vecs; i += kBlockThreads) {
+              uint4 lv = ld_local_v4(routed_partial + g_row + i);
+              uint4 pv = ld_peer_v4<IS_SHM>(my_slot + s_row + i);
+              float2 a0 = fixed_add_pair<RANK>(lv.x, pv.x);
+              float2 a1 = fixed_add_pair<RANK>(lv.y, pv.y);
+              float2 a2 = fixed_add_pair<RANK>(lv.z, pv.z);
+              float2 a3 = fixed_add_pair<RANK>(lv.w, pv.w);
+              sq += a0.x * a0.x + a0.y * a0.y + a1.x * a1.x + a1.y * a1.y +
+                    a2.x * a2.x + a2.y * a2.y + a3.x * a3.x + a3.y * a3.y;
+            }
+            const float total_sq = block_reduce_sum_deterministic(sq, s_warp_sq);
+            const float inv_rms = rsqrtf(total_sq / static_cast<float>(r_vecs * 8) + eps);
+            for (int i = tid; i < r_vecs; i += kBlockThreads) {
+              uint4 lv = ld_local_v4(routed_partial + g_row + i);
+              uint4 pv = ld_peer_v4<IS_SHM>(my_slot + s_row + i);
+              float2 a0 = fixed_add_pair<RANK>(lv.x, pv.x);
+              float2 a1 = fixed_add_pair<RANK>(lv.y, pv.y);
+              float2 a2 = fixed_add_pair<RANK>(lv.z, pv.z);
+              float2 a3 = fixed_add_pair<RANK>(lv.w, pv.w);
+              float wv[8];
+              load_rms_weight_8<WEIGHT_FP32>(rms_weight, i, wv);
+              uint4 ov;
+              ov.x = f32x2_to_bf16x2((a0.x * inv_rms) * wv[0], (a0.y * inv_rms) * wv[1]);
+              ov.y = f32x2_to_bf16x2((a1.x * inv_rms) * wv[2], (a1.y * inv_rms) * wv[3]);
+              ov.z = f32x2_to_bf16x2((a2.x * inv_rms) * wv[4], (a2.y * inv_rms) * wv[5]);
+              ov.w = f32x2_to_bf16x2((a3.x * inv_rms) * wv[6], (a3.y * inv_rms) * wv[7]);
+              st_local_v4(out_routed_normed + g_row + i, ov);
+            }
+          }
+          __syncthreads();
+        }
+      }
+    } else {
+      const int sbid = bid - kRoutedCtas;
+      const int shared_chunk_vecs = cur_m * s_vecs;
+      const int shared_slot_off = (cur_m * r_vecs + 7) & ~7;
+      const int64_t shared_global_off = static_cast<int64_t>(row_base) * s_vecs;
+      int v_start = 0, v_count = 0;
+      partition_aligned_128b(shared_chunk_vecs, kSharedCtas, sbid, v_start, v_count);
+      if (v_count <= 0) continue;
+
+      if (s_err != 0u) {
+        if (write_shared_sum) poison_v4_stripe(out_shared_sum, shared_global_off + v_start, v_count, tid);
+        if constexpr (HAS_RES) poison_v4_stripe(out_shared_res, shared_global_off + v_start, v_count, tid);
+        continue;
+      }
+
+      int i = tid;
+      for (; i + kBlockThreads < v_count; i += 2 * kBlockThreads) {
+        uint4 v0 = ld_local_v4(shared_partial + shared_global_off + v_start + i);
+        uint4 v1 = ld_local_v4(shared_partial + shared_global_off + v_start + i + kBlockThreads);
+        st_peer_v4<IS_SHM>(peer_slot + shared_slot_off + v_start + i, v0);
+        st_peer_v4<IS_SHM>(peer_slot + shared_slot_off + v_start + i + kBlockThreads, v1);
+      }
+      if (i < v_count) {
+        uint4 v0 = ld_local_v4(shared_partial + shared_global_off + v_start + i);
+        st_peer_v4<IS_SHM>(peer_slot + shared_slot_off + v_start + i, v0);
+      }
+      __syncthreads();
+      if (tid == 0) {
+        st_release_sys_u64(&peer_flags[slot * kFixedGrid + bid].val, flag_val);
+        s_err = wait_for_peer_flag(my_flags, slot, bid, flag_val, dev_ctrl, host_ctrl, expected_gen);
+      }
+      __syncthreads();
+      if (s_err != 0u) {
+        if (write_shared_sum) poison_v4_stripe(out_shared_sum, shared_global_off + v_start, v_count, tid);
+        if constexpr (HAS_RES) poison_v4_stripe(out_shared_res, shared_global_off + v_start, v_count, tid);
+        continue;
+      }
+      for (int j = tid; j < v_count; j += kBlockThreads) {
+        int64_t gidx = shared_global_off + v_start + j;
+        uint4 loc_v = ld_local_v4(shared_partial + gidx);
+        uint4 peer_v = ld_peer_v4<IS_SHM>(my_slot + shared_slot_off + v_start + j);
+        uint4 r_v = {};
+        if constexpr (HAS_RES) r_v = ld_local_v4(residual + gidx);
+        reduce_and_store_v4<RANK, HAS_RES>(
+            loc_v, peer_v, r_v,
+            out_shared_sum + gidx,
+            HAS_RES ? (out_shared_res + gidx) : nullptr,
+            write_shared_sum);
+      }
+      __syncthreads();
+    }
+  }
+
+  ar_grid_commit(dev_ctrl, base_seq + chunk_idx, tid);
+}
+
+// ---------------------------------------------------------------------------
+// Kernel 3: Framed One-way PP Send / Recv / Drain (api_version=3, H2, M1, L1)
+// ---------------------------------------------------------------------------
+
+template <bool IS_SHM>
+__device__ __forceinline__ void write_pp_header(
+    uint8_t* peer_slot_u8, const PpSlotHeader& hdr) {
+  const uint4* src = reinterpret_cast<const uint4*>(&hdr);
+  uint4* dst = reinterpret_cast<uint4*>(peer_slot_u8);
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    st_peer_v4<IS_SHM>(dst + i, src[i]);
+  }
+}
+
+template <bool IS_SHM>
+__device__ __forceinline__ void read_pp_header(
+    const uint8_t* my_slot_u8, PpSlotHeader& hdr) {
+  const uint4* src = reinterpret_cast<const uint4*>(my_slot_u8);
+  uint4* dst = reinterpret_cast<uint4*>(&hdr);
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    dst[i] = ld_peer_v4<IS_SHM>(src + i);
+  }
+}
+
+__device__ __forceinline__ void pp_recv_monotonic_ack(
+    DeviceControlState* __restrict__ dev_ctrl,
+    FlagLine* __restrict__ peer_pp_ack_flag,
+    int slot,
+    uint64_t seq) {
+  st_release_gpu_u64(&dev_ctrl->pp_recv_slot_done[slot], seq);
+  while (atomic_cas_acq_rel_gpu_u32(&dev_ctrl->pp_ack_lock, 0u, 1u) != 0u) {
+  }
+  uint64_t cur = dev_ctrl->pp_recv_ack_watermark;
+  uint64_t advanced = cur;
+  while (ld_acquire_gpu_u64(&dev_ctrl->pp_recv_slot_done[(advanced + 1ull) & kSlotMask]) ==
+         (advanced + 1ull)) {
+    ++advanced;
+  }
+  if (advanced > cur) {
+    dev_ctrl->pp_recv_ack_watermark = advanced;
+    st_release_sys_u64(&peer_pp_ack_flag->val, advanced);
+  }
+  st_release_gpu_u32(&dev_ctrl->pp_ack_lock, 0u);
+}
+
+template <bool IS_SHM>
+__global__ __launch_bounds__(kBlockThreads, 4)
+void p2p_pp_send_kernel(
+    const uint8_t* __restrict__ src,
+    uint8_t* __restrict__ peer_inbox,
+    FlagLine* __restrict__ peer_pp_flags,
+    const FlagLine* __restrict__ my_pp_ack_flag,
+    DeviceControlState* __restrict__ dev_ctrl,
+    HostMappedControl* __restrict__ host_ctrl,
+    uint64_t slot_bytes,
+    uint32_t expected_gen,
+    int64_t total_bytes,
+    uint32_t tag) {
+  __shared__ uint64_t s_base_seq;
+  __shared__ uint64_t s_msg_seq;
+  __shared__ uint32_t s_err;
+  static_assert(sizeof(s_base_seq) + sizeof(s_msg_seq) + sizeof(s_err) <= 48 * 1024, "SMEM cap");
+
+  const int bid = blockIdx.x;
+  const int tid = threadIdx.x;
+  if (tid == 0) {
+    s_base_seq = ld_acquire_gpu_u64(&dev_ctrl->pp_send_seq);
+    s_msg_seq = ld_acquire_gpu_u64(&dev_ctrl->pp_send_msg_seq) + 1ull;
+    s_err = check_entry_status(dev_ctrl, host_ctrl, expected_gen);
+  }
+  __syncthreads();
+
+  const uint64_t base_seq = s_base_seq;
+  const uint64_t msg_seq = s_msg_seq;
+  const int64_t payload_cap = static_cast<int64_t>(compute_pp_payload_cap(slot_bytes));
+  const uint32_t num_chunks = static_cast<uint32_t>((total_bytes + payload_cap - 1) / payload_cap);
+
+  if (s_err == 0u) {
+    uint32_t chunk_idx = 0u;
+    for (int64_t off = 0; off < total_bytes; off += payload_cap, ++chunk_idx) {
+      const int64_t rem_bytes = total_bytes - off;
+      const int cur_bytes = static_cast<int>(rem_bytes < payload_cap ? rem_bytes : payload_cap);
+      const uint64_t seq = base_seq + 1ull + static_cast<uint64_t>(chunk_idx);
+      const int active_ctas = compute_pp_active_ctas(cur_bytes);
+      if (bid >= active_ctas) {
+        continue;
+      }
+
+      if (tid == 0) {
+        if (ld_acquire_sys_u64(&my_pp_ack_flag->val) + static_cast<uint64_t>(kNumSlots) < seq) {
+          s_err = wait_for_pp_credit(my_pp_ack_flag, seq, dev_ctrl, host_ctrl, expected_gen);
+        } else {
+          s_err = check_entry_status(dev_ctrl, host_ctrl, expected_gen);
+        }
+      }
+      __syncthreads();
+      if (s_err != 0u) {
+        break;
+      }
+
+      const int slot = static_cast<int>(seq & kSlotMask);
+      uint8_t* peer_slot_u8 = peer_inbox + static_cast<size_t>(slot) * slot_bytes;
+      uint8_t* peer_payload = peer_slot_u8 + kPpHeaderBytes;
+      const uint8_t* src_chunk = src + off;
+
+      // CTA 0 writes the 64-byte framing header before posting flag 0 (H2).
+      if (bid == 0 && tid == 0) {
+        PpSlotHeader hdr = {};
+        hdr.magic = kPpHeaderMagic;
+        hdr.seq = seq;
+        hdr.total_bytes = static_cast<uint64_t>(total_bytes);
+        hdr.chunk_idx = chunk_idx;
+        hdr.num_chunks = num_chunks;
+        hdr.chunk_bytes = static_cast<uint32_t>(cur_bytes);
+        hdr.tag = tag;
+        hdr.msg_seq = msg_seq;
+        write_pp_header<IS_SHM>(peer_slot_u8, hdr);
+      }
+
+      // Unified alignment-independent 128B-line byte partition (M1).
+      int b_start = 0, b_count = 0;
+      partition_pp_bytes_128b(cur_bytes, active_ctas, bid, b_start, b_count);
+
+      if (b_count > 0) {
+        const bool src_aligned16 = ((reinterpret_cast<uintptr_t>(src_chunk) & 15u) == 0u);
+        if (src_aligned16) {
+          const int v_count = b_count >> 4;
+          const int tail_bytes = b_count & 15;
+          const uint4* src_v4 = reinterpret_cast<const uint4*>(src_chunk + b_start);
+          uint4* dst_v4 = reinterpret_cast<uint4*>(peer_payload + b_start);
+          int i = tid;
+          for (; i + kBlockThreads < v_count; i += 2 * kBlockThreads) {
+            uint4 v0 = ld_local_v4(src_v4 + i);
+            uint4 v1 = ld_local_v4(src_v4 + i + kBlockThreads);
+            st_peer_v4<IS_SHM>(dst_v4 + i, v0);
+            st_peer_v4<IS_SHM>(dst_v4 + i + kBlockThreads, v1);
+          }
+          if (i < v_count) {
+            uint4 v0 = ld_local_v4(src_v4 + i);
+            st_peer_v4<IS_SHM>(dst_v4 + i, v0);
+          }
+          if (tail_bytes > 0 && tid < tail_bytes) {
+            const int byte_off = b_start + (v_count << 4) + tid;
+            st_peer_u8(peer_payload + byte_off, src_chunk[byte_off]);
+          }
+        } else {
+          for (int i = tid; i < b_count; i += kBlockThreads) {
+            st_peer_u8(peer_payload + b_start + i, src_chunk[b_start + i]);
+          }
+        }
+      }
+
+      __syncthreads();
+      if (tid == 0) {
+        st_release_sys_u64(&peer_pp_flags[slot * kFixedGrid + bid].val,
+                           pack_flag(seq, kOpKindPpData));
+      }
+    }
+  }
+
+  __syncthreads();
+  if (tid == 0) {
+    if (gridDim.x == 1u) {
+      if (ld_acquire_gpu_u32(&dev_ctrl->dev_err_code) == 0u) {
+        st_release_gpu_u64(&dev_ctrl->pp_send_msg_seq, msg_seq);
+        st_release_gpu_u64(&dev_ctrl->pp_send_seq, base_seq + static_cast<uint64_t>(num_chunks));
+      }
+      return;
+    }
+    uint32_t prev = atomic_add_acq_rel_gpu(&dev_ctrl->pp_send_done_cnt, 1u);
+    if (prev + 1u == gridDim.x) {
+      dev_ctrl->pp_send_done_cnt = 0u;
+      if (ld_acquire_gpu_u32(&dev_ctrl->dev_err_code) == 0u) {
+        st_release_gpu_u64(&dev_ctrl->pp_send_msg_seq, msg_seq);
+        st_release_gpu_u64(&dev_ctrl->pp_send_seq, base_seq + static_cast<uint64_t>(num_chunks));
+      }
+    }
+  }
+}
+
+template <bool IS_SHM>
+__global__ __launch_bounds__(kBlockThreads, 4)
+void p2p_pp_recv_kernel(
+    uint8_t* __restrict__ dst,
+    const uint8_t* __restrict__ my_inbox,
+    const FlagLine* __restrict__ my_pp_flags,
+    FlagLine* __restrict__ peer_pp_ack_flag,
+    DeviceControlState* __restrict__ dev_ctrl,
+    HostMappedControl* __restrict__ host_ctrl,
+    uint64_t slot_bytes,
+    uint32_t expected_gen,
+    int64_t total_bytes,
+    uint32_t expected_tag) {
+  __shared__ uint64_t s_base_seq;
+  __shared__ uint64_t s_msg_seq;
+  __shared__ uint32_t s_err;
+  static_assert(sizeof(s_base_seq) + sizeof(s_msg_seq) + sizeof(s_err) <= 48 * 1024, "SMEM cap");
+
+  const int bid = blockIdx.x;
+  const int tid = threadIdx.x;
+  if (tid == 0) {
+    s_base_seq = ld_acquire_gpu_u64(&dev_ctrl->pp_recv_seq);
+    s_msg_seq = ld_acquire_gpu_u64(&dev_ctrl->pp_recv_msg_seq) + 1ull;
+    s_err = check_entry_status(dev_ctrl, host_ctrl, expected_gen);
+  }
+  __syncthreads();
+
+  const uint64_t base_seq = s_base_seq;
+  const uint64_t expected_msg_seq = s_msg_seq;
+  const int64_t payload_cap = static_cast<int64_t>(compute_pp_payload_cap(slot_bytes));
+  const uint32_t num_chunks = static_cast<uint32_t>((total_bytes + payload_cap - 1) / payload_cap);
+
+  uint32_t chunk_idx = 0u;
+  for (int64_t off = 0; off < total_bytes; off += payload_cap, ++chunk_idx) {
+    const int64_t rem_bytes = total_bytes - off;
+    const int cur_bytes = static_cast<int>(rem_bytes < payload_cap ? rem_bytes : payload_cap);
+    const uint64_t seq = base_seq + 1ull + static_cast<uint64_t>(chunk_idx);
+    const int active_ctas = compute_pp_active_ctas(cur_bytes);
+    if (bid >= active_ctas) {
+      continue;
+    }
+
+    int b_start = 0, b_count = 0;
+    partition_pp_bytes_128b(cur_bytes, active_ctas, bid, b_start, b_count);
+    uint8_t* dst_chunk = dst + off;
+
+    if (s_err != 0u) {
+      if (b_count > 0) poison_u8_stripe(dst_chunk, b_start, b_count, tid);
+      continue;
+    }
+
+    const int slot = static_cast<int>(seq & kSlotMask);
+    const uint64_t flag_val = pack_flag(seq, kOpKindPpData);
+    const uint8_t* my_slot_u8 = my_inbox + static_cast<size_t>(slot) * slot_bytes;
+    const uint8_t* my_payload = my_slot_u8 + kPpHeaderBytes;
+
+    // Wait for sender CTA 0's flag first (always posted for every chunk) and validate
+    // the 64-byte framing header before waiting on bid's flag or copying any payload (H2).
+    if (tid == 0) {
+      s_err = wait_for_peer_flag(my_pp_flags, slot, 0, flag_val, dev_ctrl, host_ctrl, expected_gen);
+      if (s_err == 0u) {
+        PpSlotHeader hdr = {};
+        read_pp_header<IS_SHM>(my_slot_u8, hdr);
+        if (hdr.magic != kPpHeaderMagic ||
+            hdr.seq != seq ||
+            hdr.total_bytes != static_cast<uint64_t>(total_bytes) ||
+            hdr.chunk_idx != chunk_idx ||
+            hdr.num_chunks != num_chunks ||
+            hdr.chunk_bytes != static_cast<uint32_t>(cur_bytes) ||
+            hdr.tag != expected_tag ||
+            hdr.msg_seq != expected_msg_seq) {
+          s_err = set_err_sticky(dev_ctrl, host_ctrl, kErrFramingMismatch);
+        }
+      }
+      if (s_err == 0u && bid > 0) {
+        s_err = wait_for_peer_flag(my_pp_flags, slot, bid, flag_val, dev_ctrl, host_ctrl, expected_gen);
+      }
+    }
+    __syncthreads();
+    if (s_err != 0u) {
+      if (b_count > 0) poison_u8_stripe(dst_chunk, b_start, b_count, tid);
+      continue;
+    }
+
+    if (b_count > 0) {
+      const bool dst_aligned16 = ((reinterpret_cast<uintptr_t>(dst_chunk) & 15u) == 0u);
+      if (dst_aligned16) {
+        const int v_count = b_count >> 4;
+        const int tail_bytes = b_count & 15;
+        const uint4* src_v4 = reinterpret_cast<const uint4*>(my_payload + b_start);
+        uint4* dst_v4 = reinterpret_cast<uint4*>(dst_chunk + b_start);
+        int i = tid;
+        for (; i + kBlockThreads < v_count; i += 2 * kBlockThreads) {
+          uint4 v0 = ld_peer_v4<IS_SHM>(src_v4 + i);
+          uint4 v1 = ld_peer_v4<IS_SHM>(src_v4 + i + kBlockThreads);
+          st_local_v4(dst_v4 + i, v0);
+          st_local_v4(dst_v4 + i + kBlockThreads, v1);
+        }
+        if (i < v_count) {
+          uint4 v0 = ld_peer_v4<IS_SHM>(src_v4 + i);
+          st_local_v4(dst_v4 + i, v0);
+        }
+        if (tail_bytes > 0 && tid < tail_bytes) {
+          const int byte_off = b_start + (v_count << 4) + tid;
+          dst_chunk[byte_off] = ld_peer_u8<IS_SHM>(my_payload + byte_off);
+        }
+      } else {
+        for (int i = tid; i < b_count; i += kBlockThreads) {
+          dst_chunk[b_start + i] = ld_peer_u8<IS_SHM>(my_payload + b_start + i);
+        }
+      }
+    }
+
+    // Strictly monotonic watermark credit ack (L1): never posts S+1 before S completes.
+    __syncthreads();
+    if (tid == 0) {
+      uint32_t prev = atomic_add_acq_rel_gpu(&dev_ctrl->pp_recv_slot_ctas[slot], 1u);
+      if (prev + 1u == static_cast<uint32_t>(active_ctas)) {
+        dev_ctrl->pp_recv_slot_ctas[slot] = 0u;
+        pp_recv_monotonic_ack(dev_ctrl, peer_pp_ack_flag, slot, seq);
+      }
+    }
+  }
+
+  __syncthreads();
+  if (tid == 0) {
+    if (gridDim.x == 1u) {
+      if (ld_acquire_gpu_u32(&dev_ctrl->dev_err_code) == 0u) {
+        st_release_gpu_u64(&dev_ctrl->pp_recv_msg_seq, expected_msg_seq);
+        st_release_gpu_u64(&dev_ctrl->pp_recv_seq, base_seq + static_cast<uint64_t>(num_chunks));
+      }
+      return;
+    }
+    uint32_t prev = atomic_add_acq_rel_gpu(&dev_ctrl->pp_recv_done_cnt, 1u);
+    if (prev + 1u == gridDim.x) {
+      dev_ctrl->pp_recv_done_cnt = 0u;
+      if (ld_acquire_gpu_u32(&dev_ctrl->dev_err_code) == 0u) {
+        st_release_gpu_u64(&dev_ctrl->pp_recv_msg_seq, expected_msg_seq);
+        st_release_gpu_u64(&dev_ctrl->pp_recv_seq, base_seq + static_cast<uint64_t>(num_chunks));
+      }
+    }
+  }
+}
+
+// Cleanly drain one in-flight PP message (any size/chunks) for PipeSpec dropped-B (H2).
+template <bool IS_SHM>
+__global__ __launch_bounds__(32, 1)
+void p2p_pp_drain_kernel(
+    const uint8_t* __restrict__ my_inbox,
+    const FlagLine* __restrict__ my_pp_flags,
+    FlagLine* __restrict__ peer_pp_ack_flag,
+    DeviceControlState* __restrict__ dev_ctrl,
+    HostMappedControl* __restrict__ host_ctrl,
+    uint64_t slot_bytes,
+    uint32_t expected_gen) {
+  if (blockIdx.x != 0 || threadIdx.x != 0) return;
+
+  uint32_t err = check_entry_status(dev_ctrl, host_ctrl, expected_gen);
+  if (err != 0u) return;
+
+  const uint64_t base_seq = ld_acquire_gpu_u64(&dev_ctrl->pp_recv_seq);
+  const uint64_t expected_msg_seq = ld_acquire_gpu_u64(&dev_ctrl->pp_recv_msg_seq) + 1ull;
+  const uint64_t payload_cap = compute_pp_payload_cap(slot_bytes);
+
+  const uint64_t seq0 = base_seq + 1ull;
+  const int slot0 = static_cast<int>(seq0 & kSlotMask);
+  err = wait_for_peer_flag(
+      my_pp_flags, slot0, 0, pack_flag(seq0, kOpKindPpData), dev_ctrl, host_ctrl, expected_gen);
+  if (err != 0u) return;
+
+  PpSlotHeader hdr0 = {};
+  read_pp_header<IS_SHM>(my_inbox + static_cast<size_t>(slot0) * slot_bytes, hdr0);
+  if (hdr0.magic != kPpHeaderMagic ||
+      hdr0.seq != seq0 ||
+      hdr0.chunk_idx != 0u ||
+      hdr0.num_chunks == 0u ||
+      hdr0.total_bytes == 0ull ||
+      hdr0.chunk_bytes == 0u ||
+      static_cast<uint64_t>(hdr0.chunk_bytes) > payload_cap ||
+      hdr0.msg_seq != expected_msg_seq) {
+    set_err_sticky(dev_ctrl, host_ctrl, kErrFramingMismatch);
+    return;
+  }
+
+  const uint32_t num_chunks = hdr0.num_chunks;
+  for (uint32_t c = 0u; c < num_chunks; ++c) {
+    const uint64_t seq = base_seq + 1ull + static_cast<uint64_t>(c);
+    const int slot = static_cast<int>(seq & kSlotMask);
+    const uint64_t flag_val = pack_flag(seq, kOpKindPpData);
+    uint32_t cur_chunk_bytes = hdr0.chunk_bytes;
+    if (c > 0u) {
+      err = wait_for_peer_flag(my_pp_flags, slot, 0, flag_val, dev_ctrl, host_ctrl, expected_gen);
+      if (err != 0u) return;
+      PpSlotHeader hdr = {};
+      read_pp_header<IS_SHM>(my_inbox + static_cast<size_t>(slot) * slot_bytes, hdr);
+      if (hdr.magic != kPpHeaderMagic ||
+          hdr.seq != seq ||
+          hdr.total_bytes != hdr0.total_bytes ||
+          hdr.chunk_idx != c ||
+          hdr.num_chunks != num_chunks ||
+          hdr.chunk_bytes == 0u ||
+          static_cast<uint64_t>(hdr.chunk_bytes) > payload_cap ||
+          hdr.msg_seq != expected_msg_seq) {
+        set_err_sticky(dev_ctrl, host_ctrl, kErrFramingMismatch);
+        return;
+      }
+      cur_chunk_bytes = hdr.chunk_bytes;
+    }
+
+    const int active_ctas = compute_pp_active_ctas(static_cast<int64_t>(cur_chunk_bytes));
+    for (int b = 1; b < active_ctas; ++b) {
+      err = wait_for_peer_flag(my_pp_flags, slot, b, flag_val, dev_ctrl, host_ctrl, expected_gen);
+      if (err != 0u) return;
+    }
+
+    pp_recv_monotonic_ack(dev_ctrl, peer_pp_ack_flag, slot, seq);
+  }
+
+  if (ld_acquire_gpu_u32(&dev_ctrl->dev_err_code) == 0u) {
+    st_release_gpu_u64(&dev_ctrl->pp_recv_msg_seq, expected_msg_seq);
+    st_release_gpu_u64(&dev_ctrl->pp_recv_seq, base_seq + static_cast<uint64_t>(num_chunks));
+  }
+}
