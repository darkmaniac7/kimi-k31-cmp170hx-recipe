+def test_kimi_linear_adopts_exl3_head_logits_processor(monkeypatch, meta_platform, tmp_path):
+    """Last PP rank adopts Exl3HeadLogitsProcessor; non-last PP ranks with
+    missing or PPMissingLayer logits_processor do not fail."""
+    import vllm._C_stable_libtorch  # noqa: F401  (registers torch.ops._C)
+    from vllm.models.kimi_k3.nvidia import model as upstream_kimi
+    from vllm.models.kimi_k3.nvidia import sm80_model
+
+    ckpt = dsa_cases.write_config(
+        tmp_path / "k31", dsa_cases.TINY_TEXT, dsa_cases.TINY_VISION
+    )
+
+    last_stage = build_kimi_text(
+        monkeypatch,
+        ckpt,
+        pp=(2, 1),
+        partition=(3, 3),
+        cls=sm80_model.KimiLinearForCausalLM,
+    )
+    assert type(last_stage.logits_processor) is Exl3HeadLogitsProcessor
+
+    # Also verify safe handling when upstream leaves logits_processor absent
+    # or as PPMissingLayer (e.g. non-last PP rank variant).
+    for stub_lp in (PPMissingLayer(), None):
+        def _fake_upstream_init(self, *, vllm_config, prefix="", _lp=stub_lp):
+            nn.Module.__init__(self)
+            if _lp is not None:
+                self.logits_processor = _lp
+
+        monkeypatch.setattr(
+            upstream_kimi.KimiLinearForCausalLM, "__init__", _fake_upstream_init
+        )
+        m = sm80_model.KimiLinearForCausalLM(vllm_config=SimpleNamespace(), prefix="")
+        if stub_lp is None:
+            assert not hasattr(m, "logits_processor")
+        else:
+            assert isinstance(m.logits_processor, PPMissingLayer)
