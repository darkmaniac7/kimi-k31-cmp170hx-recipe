+# ------------------------------------ KDA Bank-0 / Bank-1 exact state test
+
+
+def _sim_kda_spec_step(
+    x_qkv: torch.Tensor,  # [seqlen, dim]
+    conv_state: torch.Tensor,  # [num_blocks, dim, 3 + K]
+    conv_w: torch.Tensor,  # [dim, 4]
+    recurrent_state: torch.Tensor,  # [num_blocks, H, D, D]
+    state_indices: torch.Tensor,  # [1, K + 1]
+    num_accepted: int,
+) -> torch.Tensor:
+    """Exact reference of causal_conv1d_update + fused_recurrent_kda for 1 req."""
+    seqlen, dim = x_qkv.shape
+    k_plus_1 = state_indices.shape[1]
+    state_len_buf = conv_state.shape[2]
+    # Exact varlen state_len formula from causal_conv1d.py:841:
+    state_len = state_len_buf - (k_plus_1 - seqlen)
+    offset = num_accepted - 1
+    conv_idx = int(state_indices[0, 0].item())
+
+    # 1. Conv1d with width=4 reading [offset, offset+1, offset+2] and updating in-place.
+    prior = conv_state[conv_idx, :, offset : offset + 3].clone()  # [dim, 3]
+    seq_in = torch.cat([prior, x_qkv.T], dim=1)  # [dim, 3 + seqlen]
+    conv_out = torch.zeros(seqlen, dim, dtype=x_qkv.dtype)
+    for t in range(seqlen):
+        win = seq_in[:, t : t + 4]  # [dim, 4]
+        conv_out[t] = (win * conv_w).sum(dim=1)
+    # Write new conv state [0 .. state_len - 1]: [prior[:, 1:3], x_qkv.T]
+    val = state_len - seqlen  # == 2
+    new_conv = conv_state[conv_idx].clone()
+    new_conv[:, :val] = prior[:, 1 : 1 + val]
+    new_conv[:, val : val + seqlen] = x_qkv.T
+    conv_state[conv_idx].copy_(new_conv)
+
+    # 2. Recurrent KDA reading state_indices[offset], writing state_indices[i_t].
+    init_idx = int(state_indices[0, offset].item())
+    h = recurrent_state[init_idx].clone()
+    outs = []
+    for i_t in range(seqlen):
+        v = conv_out[i_t].view(h.shape[0], h.shape[1])
+        h = 0.9 * h + torch.einsum("hd,he->hde", v, v) * 0.01
+        outs.append(h.sum(dim=-1).reshape(-1))
+        dst_idx = int(state_indices[0, i_t].item())
+        if dst_idx > 0:
+            recurrent_state[dst_idx].copy_(h)
+    return torch.stack(outs, dim=0)
+
+
+def test_kda_bank0_bank1_isolation_and_rollback_bit_exact():
+    """Prove Bank-0 / Bank-1 KDA state is 100% bit-exact vs sequential
+    non-PipeSpec execution across valid B, dropped B (partial A), and dropped B
+    (full A bonus mismatch)."""
+    torch.manual_seed(7)
+    k_max = 12
+    chunk_k = 5
+    dim = 16
+    H, D = 2, 8
+    num_blocks = 32
+    conv_w = torch.randn(dim, 4)
+
+    # Request owns 1 + k_max = 13 distinct non-zero blocks: 1..13.
+    block_table = torch.arange(1, k_max + 2, dtype=torch.int32).unsqueeze(0)
+    full_indices = block_table[:, : k_max + 1]
+    b_indices = KDAPipeSpecStateManager.build_chunk_b_state_indices(
+        block_table, chunk_k, k_max + 1
+    )
+    assert b_indices.shape == (1, k_max + 1)
+    assert b_indices[0, : chunk_k + 1].tolist() == list(range(7, 13))
+    assert b_indices[0, chunk_k + 1 :].tolist() == [0] * (k_max - chunk_k)
+
+    # Seed identical initial Bank-0 state in both reference and PipeSpec copies.
+    ref_conv = torch.zeros(num_blocks, dim, 3 + k_max)
+    ref_rec = torch.zeros(num_blocks, H, D, D)
+    ref_conv[1, :, :3] = torch.randn(dim, 3)
+    ref_rec[1] = torch.randn(H, D, D)
+    ps_conv = ref_conv.clone()
+    ps_rec = ref_rec.clone()
+
+    ref_acc = 1
+    ps_acc_gpu = torch.tensor([1], dtype=torch.int32)
+    req_idx = torch.tensor([0], dtype=torch.int32)
+    pairs = [(ps_conv, ps_rec)]
+
+    # Sequence of epochs exercising ALL 3 outcomes in order:
+    # 1. Valid epoch: A accepts all 6, B runs and accepts 4.
+    # 2. Partial A: A accepts 3, B runs speculatively and is DROPPED (num_sampled=0).
+    # 3. Full A bonus mismatch: A accepts all 6 (slot chunk_k=5!), B DROPPED!
+    # 4. Valid epoch: A accepts all 6, B runs and accepts all 6.
+    epochs = [
+        (6, 4),
+        (3, 0),
+        (6, 0),
+        (6, 6),
+    ]
+    for m_a, m_b in epochs:
+        x_a = torch.randn(chunk_k + 1, dim)
+        x_b = torch.randn(chunk_k + 1, dim)
+
+        # Reference (never runs a dropped B).
+        ref_out_a = _sim_kda_spec_step(
+            x_a, ref_conv, conv_w, ref_rec, full_indices, ref_acc
+        )
+        ref_acc = m_a
+        ref_out_b = None
+        if m_b > 0:
+            ref_out_b = _sim_kda_spec_step(
+                x_b, ref_conv, conv_w, ref_rec, full_indices, ref_acc
+            )
+            ref_acc = m_b
+
+        # PipeSpec: ALWAYS runs A in Bank 0, prepares Bank 1, runs B in Bank 1.
+        ps_out_a = _sim_kda_spec_step(
+            x_a, ps_conv, conv_w, ps_rec, full_indices, int(ps_acc_gpu[0].item())
+        )
+        assert torch.equal(ps_out_a, ref_out_a)
+
+        KDAPipeSpecStateManager.prepare_chunk_b(pairs, block_table[0], chunk_k)
+        ps_out_b = _sim_kda_spec_step(
+            x_b, ps_conv, conv_w, ps_rec, b_indices, chunk_k + 1
+        )
+        if m_b > 0:
+            assert ref_out_b is not None
+            assert torch.equal(ps_out_b, ref_out_b)
+
+        # Deferred postprocess: first A updates ps_acc_gpu to m_a, then B commits or rolls back.
+        ps_acc_gpu[0] = m_a
+        KDAPipeSpecStateManager.commit_or_rollback_chunk_b(
+            pairs,
+            block_table[0],
+            chunk_k,
+            torch.tensor([m_b], dtype=torch.int32),
+            ps_acc_gpu,
+            req_idx,
+        )
+        assert int(ps_acc_gpu[0].item()) == ref_acc
+
+    # Final verification step: both systems produce BIT-IDENTICAL output!
+    x_final = torch.randn(chunk_k + 1, dim)
+    out_ref_final = _sim_kda_spec_step(
+        x_final, ref_conv, conv_w, ref_rec, full_indices, ref_acc
+    )
+    out_ps_final = _sim_kda_spec_step(
+        x_final, ps_conv, conv_w, ps_rec, full_indices, int(ps_acc_gpu[0].item())
+    )
+    assert torch.equal(out_ps_final, out_ref_final)
+
