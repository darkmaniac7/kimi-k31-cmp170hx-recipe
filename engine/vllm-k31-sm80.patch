+  cb.template decode_kt<1>(w, lane, a); run_kt(16);
+  cb.template decode_kt<2>(w, lane, a); run_kt(32);
+  cb.template decode_kt<3>(w, lane, a); run_kt(48);
+  cb.template decode_kt<4>(w, lane, a); run_kt(64);
+  cb.template decode_kt<5>(w, lane, a); run_kt(80);
+  cb.template decode_kt<6>(w, lane, a); run_kt(96);
+  cb.template decode_kt<7>(w, lane, a); run_kt(112);
