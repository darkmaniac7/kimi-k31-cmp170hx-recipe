@@ -0,0 +1,136 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Kimi K3 and K3.1 model classes of the sm_80 fork.
+
+The fork plugin (``vllm.sm80.plugin``) registers the architectures of this
+module in vLLM's model registry in place of the upstream classes in
+``vllm/models/kimi_k3/nvidia/model.py``: the text model
+(``KimiLinearForCausalLM``) and the multimodal wrapper, which serves both
+``KimiK3ForConditionalGeneration`` and ``KimiK31ForConditionalGeneration``
+(the name a K3.1 checkpoint's config.json carries). Each class subclasses the
+upstream one and keeps its name, so the registry reports the same model
+information and checkpoints load into the same parameter names.
+
+What the text model adds: every DSA layer (K3.1's MLA layers) whose MLA
+backend is the fork's Triton sparse backend is given the sm_80 classes of
+``sm80_dsa.py`` after the upstream constructor built it, so its modules and
+parameters are exactly the upstream ones. A layer served by an upstream
+backend is left as it is. KDA layers, the MoE and the AttnRes stream are
+upstream's.
+
+Importing this module also registers the fork's layer override for this
+model (``vllm.sm80.plugin.register_k3_layers``): the fork's MLA wrapper
+(``vllm/models/glm5next/nvidia/sm80_mla.py``), the one the Triton sparse
+backend's latent-cache hand-off is written against.
+"""
+
+import torch
+from torch import nn
+
+from vllm.config import VllmConfig
+from vllm.logger import init_logger
+from vllm.model_executor.layers.logits_processor import LogitsProcessor
+from vllm.models.kimi_k3.nvidia import dsa as upstream_dsa
+from vllm.models.kimi_k3.nvidia import model as kimi_model
+from vllm.models.kimi_k3.nvidia import sm80_dsa
+from vllm.sm80 import plugin
+from vllm.sm80.kernels.exl3.quant import Exl3HeadLogitsProcessor
+from vllm.sm80.worker import target_argmax
+
+logger = init_logger(__name__)
+
+
+def adopt_dsa_layers(model: nn.Module) -> int:
+    """Give every upstream-built DSA layer of ``model`` that the Triton
+    sparse MLA backend serves the sm_80 classes; return how many."""
+    adopted = 0
+    for module in model.modules():
+        if type(module) is not upstream_dsa.KimiK3DSAAttention:
+            continue
+        if sm80_dsa.served_by_triton_sparse_mla(module):
+            sm80_dsa.KimiK3DSAAttention.adopt(module)
+            adopted += 1
+    return adopted
+
+
+class KimiLinearForCausalLM(kimi_model.KimiLinearForCausalLM):
+    def __init__(self, *, vllm_config: VllmConfig, prefix: str = ""):
+        super().__init__(vllm_config=vllm_config, prefix=prefix)
+        # Pipeline stages hold their own layers only; a stage of KDA layers
+        # adopts none.
+        self.sm80_dsa_layers = adopt_dsa_layers(self)
+        if self.sm80_dsa_layers:
+            logger.info_once(
+                "Kimi K3.1 DSA layers use the sm_80 indexer (Triton logits "
+                "kernels, software e4m3) and the Triton sparse MLA backend."
+            )
+        logits_processor = getattr(self, "logits_processor", None)
+        if type(logits_processor) is LogitsProcessor:
+            Exl3HeadLogitsProcessor.adopt(logits_processor)
+
+    # target_argmax.refusal: compute_logits serves greedy-only steps.
+    target_argmax_logits = True
+
+    def compute_logits_local(
+        self,
+        hidden_states: torch.Tensor,
+    ) -> torch.Tensor:
+        """This rank's vocabulary shard of ``compute_logits`` (no all-gather,
+        padding columns kept), for greedy per-rank argmax
+        (``VLLM_SM80_TARGET_SHARD_ARGMAX``) and batch-sharded sampling."""
+        if self.needs_norm_in_logits:
+            hidden_states = self.model.norm(hidden_states, None)
+        return self.logits_processor(self.lm_head, hidden_states, skip_gather=True)
+
+    def compute_logits(
+        self,
+        hidden_states: torch.Tensor,
+    ) -> torch.Tensor | None:
+        """Upstream's gathered logits; inside a greedy-only sampling step
+        (``VLLM_SM80_TARGET_SHARD_ARGMAX``) the rows that hold only their
+        argmax, without the all-gather
+        (``vllm/sm80/worker/target_argmax.py``)."""
+        if target_argmax.active():
+            return target_argmax.argmax_rows(self, hidden_states)
+        return super().compute_logits(hidden_states)
+
+
+class KimiK3ForConditionalGeneration(kimi_model.KimiK3ForConditionalGeneration):
+    """The multimodal wrapper (K3 and K3.1). Its ``language_model`` is built
+    through the registry under ``KimiLinearForCausalLM``, so it is this
+    module's text model whenever the fork plugin has registered it."""
+
+    def __init__(self, vllm_config: VllmConfig, prefix: str = "") -> None:
+        hf_config = vllm_config.model_config.hf_config
+        text_config = getattr(hf_config, "text_config", None)
+        outer_head_dtype = getattr(hf_config, "head_dtype", None)
+        if (
+            text_config is not None
+            and outer_head_dtype is not None
+            and getattr(text_config, "head_dtype", None) is None
+        ):
+            text_config.head_dtype = outer_head_dtype
+        super().__init__(vllm_config=vllm_config, prefix=prefix)
+
+    # target_argmax.refusal: compute_logits serves greedy-only steps.
+    target_argmax_logits = True
+
+    def compute_logits_local(
+        self,
+        hidden_states: torch.Tensor,
+    ) -> torch.Tensor:
+        return self.language_model.compute_logits_local(hidden_states)
+
+    def compute_logits(
+        self,
+        hidden_states: torch.Tensor,
+        **kwargs,
+    ) -> torch.Tensor | None:
+        if target_argmax.active():
+            return target_argmax.argmax_rows(self, hidden_states)
+        return super().compute_logits(hidden_states, **kwargs)
+
+
+# The upstream DSA layer builds its MLA wrapper by the upstream class name;
+# the layer override makes each of them the fork class.
+plugin.register_k3_layers()
