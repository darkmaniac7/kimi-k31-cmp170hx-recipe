+def test_zero_cuda_lazy_init_on_import_kda_spec():
+    repo = Path(__file__).resolve().parents[2]
+    code = (
+        "import torch\n"
+        "def _trap(): raise AssertionError('CUDA lazy init triggered!')\n"
+        "torch.cuda._lazy_init = _trap\n"
+        "from vllm.sm80.kernels.k31q import glue_ops, glue\n"
+        "assert not glue.kda_spec_enabled()\n"
+        "print('ZERO_CUDA_LAZY_INIT_SPEC_OK')\n"
+    )
+    env = dict(os.environ)
+    env["PYTHONPATH"] = f"{repo}:{env.get('PYTHONPATH', '')}"
+    proc = subprocess.run(
+        [sys.executable, "-c", code],
+        capture_output=True,
+        text=True,
+        env=env,
+        timeout=60,
+    )
+    assert proc.returncode == 0, proc.stdout + proc.stderr
+    assert "ZERO_CUDA_LAZY_INIT_SPEC_OK" in proc.stdout
