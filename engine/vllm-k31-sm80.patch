+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU unit tests for the K3.1 pure-Python hot-path wiring wins:
+
+  1. Fused router GEMV + top-k (VLLM_K31_GLUE_FUSED_ROUTER=1)
+  2. Fused q/kv RMSNorm and sigmoid_mul in MLA/DSA (VLLM_K31_GLUE_MLA / _MLA_NORM / _SIGMOID_MUL)
+  3. Zero-cat KDA in_proj_qkvgfab parts fast path (VLLM_K31_GLUE_KDA_NO_CAT)
+  4. DSpark greedy shard argmax alias on Qwen3DSparkForCausalLM (VLLM_DSPARK_SHARD_ARGMAX=1)
+"""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+from torch._subclasses.fake_tensor import FakeTensorMode
+
+from tests.models.kimi_k3.sm80.fake_glue import FakeGlueOps, ref_moe_topk_sigmoid
+from vllm import envs
+from vllm.sm80.kernels.k31q import glue
+
+_NEW_GLUE_VARS = (
+    "VLLM_K31_GLUE_ALL",
+    "VLLM_K31_GLUE_ROUTER",
+    "VLLM_K31_GLUE_GEMV",
+    "VLLM_K31_GLUE_FUSED_ROUTER",
+    "VLLM_K31_GLUE_FUSED_ROUTER_MAX_ROWS",
+    "VLLM_K31_GLUE_MLA",
+    "VLLM_K31_GLUE_MLA_NORM",
+    "VLLM_K31_GLUE_SIGMOID_MUL",
+    "VLLM_K31_GLUE_KDA_NO_CAT",
+)
+
+
+def _clear_env(monkeypatch) -> None:
+    for var in _NEW_GLUE_VARS:
+        monkeypatch.delenv(var, raising=False)
+    glue._reset_state()
+
+
+# ---------------------------------------------------------------------------
+# 1. Switch resolution & defaults
+# ---------------------------------------------------------------------------
+
+
+def test_pywins_switches_default_off_and_override(monkeypatch):
+    _clear_env(monkeypatch)
+    assert envs.VLLM_K31_GLUE_FUSED_ROUTER is False
+    assert envs.VLLM_K31_GLUE_FUSED_ROUTER_MAX_ROWS == 16
+    assert envs.VLLM_K31_GLUE_MLA is False
+    assert envs.VLLM_K31_GLUE_MLA_NORM is False
+    assert envs.VLLM_K31_GLUE_SIGMOID_MUL is False
+    assert envs.VLLM_K31_GLUE_KDA_NO_CAT is False
+    assert not glue.fused_router_enabled()
+    assert not glue.mla_norm_enabled()
+    assert not glue.sigmoid_mul_enabled()
+    assert not glue.kda_no_cat_enabled()
+
+    # VLLM_K31_GLUE_ALL enables MLA norm, sigmoid_mul, and KDA no-cat,
+    # while keeping FUSED_ROUTER opt-in for clean A/B.
+    monkeypatch.setenv("VLLM_K31_GLUE_ALL", "1")
+    assert not glue.fused_router_enabled()
+    assert glue.mla_norm_enabled()
+    assert glue.sigmoid_mul_enabled()
+    assert glue.kda_no_cat_enabled()
+
+    # Individual =0 overrides win over VLLM_K31_GLUE_ALL=1 and VLLM_K31_GLUE_MLA=1.
+    monkeypatch.setenv("VLLM_K31_GLUE_MLA", "1")
+    monkeypatch.setenv("VLLM_K31_GLUE_SIGMOID_MUL", "0")
+    monkeypatch.setenv("VLLM_K31_GLUE_KDA_NO_CAT", "0")
+    assert glue.mla_norm_enabled()
+    assert not glue.sigmoid_mul_enabled()
+    assert not glue.kda_no_cat_enabled()
+
+    # FUSED_ROUTER turns on cleanly when opted in.
+    monkeypatch.setenv("VLLM_K31_GLUE_FUSED_ROUTER", "1")
+    assert glue.fused_router_enabled()
