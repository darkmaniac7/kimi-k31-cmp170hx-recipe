+def test_shard_routed_up_runner_tier_and_tp2_exact_equivalence(
+    monkeypatch, meta_platform, checkpoint, manager
+):
+    """Verify LatentMoERunner with sharded up_proj:
+    - _use_fused_path() is True for both K31DenseLinearMethod and BF16
+    - enable_k3_latent_moe_tail_fusion stays False even on SM100
+    - _select_tail_tier() ALWAYS selects COLUMN_PARALLEL (even at M=1)
+    - TP2 rank0+rank1 _shard_up_proj_tail() equals shared_full + up_proj(norm(latent_full))
+      with exactly 2 all-reduces per rank (zero extra collectives).
+    """
+    from vllm.model_executor.layers.layernorm import RMSNorm
+    from vllm.model_executor.layers.linear import ColumnParallelLinear
+    from vllm.models.kimi_k3.nvidia import latent_moe_runner as lmr
+    from vllm.models.kimi_k3.nvidia.model import KimiRoutedOutputTransform
+    from vllm.platforms import current_platform
+
+    # 1. Verify on real tiny k31q model (K31DenseLinearMethod) across TP2 ranks.
+    from vllm.models.kimi_k3.nvidia import model as kimi_mod
+
+    monkeypatch.setenv("VLLM_K31Q_SHARD_ROUTED_UP", "1")
+    monkeypatch.setattr(kimi_mod, "maybe_init_gemm_rs_ar", lambda *a, **k: False)
+    monkeypatch.setattr(
+        type(current_platform),
+        "is_device_capability_family",
+        staticmethod(lambda family: family == 100),
+        raising=False,
+    )
+    ops = fake_dense.FakeDenseOps().install(monkeypatch)
+    _install_old_exl3(monkeypatch)
+    from vllm.config import set_current_vllm_config
+
+    models = []
+    cfg = None
+    for rank in (0, 1):
+        m, cfg, _, _ = construct.build_and_load(
+            monkeypatch, checkpoint, tp_size=2, tp_rank=rank
+        )
+        _cpu_post_load(monkeypatch)
+        ops.name(m)
+        _process_dense(m)
+        models.append(m)
+
+    runners = [m.model.layers[1].block_sparse_moe.experts for m in models]
+    for r in runners:
+        assert r._up_proj_is_sharded() is True
+        assert r._use_fused_path() is True
+        assert r.enable_k3_latent_moe_tail_fusion is False
+        for m_rows in (1, 4, 8, 32, 128):
+            dummy_f = torch.empty((m_rows, 256), dtype=torch.bfloat16)
+            dummy_s = torch.empty((m_rows, 256), dtype=torch.bfloat16)
+            assert r._select_tail_tier(dummy_f, dummy_s) is lmr.LatentTailTier.COLUMN_PARALLEL
+
+    # 2. Verify exact mathematical equivalence of TP2 _shard_up_proj_tail() on BF16
+    #    ColumnParallelLinear (loaded via ColumnParallelLinear.weight_loader) and
+    #    on EXL3 K31DenseLinearMethod, counting all-reduces per rank.
+    gen = torch.Generator().manual_seed(42)
+    M, L, H = 5, 256, 256
+    full_w_up = (torch.randn((H, L), generator=gen) / 16).to(torch.bfloat16)
+    norm_w = (1.0 + torch.randn((L,), generator=gen) * 0.05).to(torch.bfloat16)
+    fused_partials = [
+        (torch.randn((M, L), generator=gen) / 4).to(torch.bfloat16) for _ in range(2)
+    ]
+    shared_partials = [
+        (torch.randn((M, H), generator=gen) / 4).to(torch.bfloat16) for _ in range(2)
+    ]
+
+    # Reference replicated calculation: AR(fused) -> norm -> full up_proj + AR(shared).
+    with set_current_vllm_config(cfg):
+        ref_norm = RMSNorm(L, eps=1e-5).to(torch.bfloat16)
+    ref_norm.weight.data.copy_(norm_w)
+    ref_latent = ref_norm(fused_partials[0] + fused_partials[1])
+    ref_up = torch.nn.functional.linear(ref_latent, full_w_up)
+    ref_shared = shared_partials[0] + shared_partials[1]
+    ref_out = ref_shared + ref_up
+
+    # Sharded TP2 execution: each rank loads its slice via ColumnParallelLinear.weight_loader
+    # and runs LatentMoERunner._shard_up_proj_tail().
+    bf16_runners = []
+    for rank in (0, 1):
+        _parallel_groups(monkeypatch, tp_size=2, tp_rank=rank)
+        up = ColumnParallelLinear(
+            L, H, bias=False, gather_output=False, params_dtype=torch.bfloat16
+        )
+        up.weight_loader(up.weight, full_w_up)
+        assert torch.equal(up.weight.data, full_w_up[rank * 128 : (rank + 1) * 128])
+        with set_current_vllm_config(cfg):
+            norm = RMSNorm(L, eps=1e-5).to(torch.bfloat16)
+        norm.weight.data.copy_(norm_w)
+        r = lmr.LatentMoERunner.__new__(lmr.LatentMoERunner)
+        torch.nn.Module.__init__(r)
+        r.moe_config = types.SimpleNamespace(
+            tp_size=2,
+            ep_size=1,
+            is_sequence_parallel=False,
+            skip_final_all_reduce=False,
+        )
+        r._shared_experts = object()
+        r.routed_experts = types.SimpleNamespace(
+            quant_method=types.SimpleNamespace(moe_kernel=None)
+        )
+        r.routed_output_transform = KimiRoutedOutputTransform(norm, up)
+        assert r._up_proj_is_sharded() is True
+        assert r._use_fused_path() is True
+        assert r._select_tail_tier(fused_partials[0], shared_partials[0]) is (
+            lmr.LatentTailTier.COLUMN_PARALLEL
+        )
+        bf16_runners.append(r)
+
+    ar_calls = {0: [], 1: []}
+    # Stage 1: collect AR#1 inputs (fused_partials) -> sum, run up_proj + add_ per rank,
+    # Stage 2: collect AR#2 inputs (mutated shared_partials) -> sum.
+    fused_sum = fused_partials[0] + fused_partials[1]
+    ar2_inputs = []
+    for rank in (0, 1):
+        _parallel_groups(monkeypatch, tp_size=2, tp_rank=rank)
+        monkeypatch.setattr(lmr, "get_tensor_model_parallel_rank", lambda r=rank: r)
+        stage = {"count": 0}
+
+        def fake_ar(tensor, r=rank, st=stage):
+            st["count"] += 1
+            ar_calls[r].append(tuple(tensor.shape))
+            if st["count"] == 1:
+                return fused_sum.clone()
+            ar2_inputs.append(tensor.clone())
+            return tensor
+
+        monkeypatch.setattr(lmr, "tensor_model_parallel_all_reduce", fake_ar)
+        monkeypatch.setattr(
+            "vllm.model_executor.layers.fused_moe.runner.moe_runner.tensor_model_parallel_all_reduce",
+            fake_ar,
+        )
+        bf16_runners[rank]._shard_up_proj_tail(
+            fused_partials[rank].clone(),
+            shared_partials[rank].clone(),
+            trunc_size=None,
+        )
+
+    assert ar_calls == {0: [(M, L), (M, H)], 1: [(M, L), (M, H)]}
+    sharded_out = ar2_inputs[0] + ar2_inputs[1]
+    assert torch.allclose(sharded_out, ref_out, atol=1e-2, rtol=1e-2)
+
+    # Also verify exact bit-identical match on the EXL3 K31DenseLinearMethod path
+    # (using shared_partials = 0 so BF16 addition associativity is exact).
+    exl3_ref_model, _, _, _ = construct.build_and_load(
+        monkeypatch, checkpoint, tp_size=1, tp_rank=0
+    )
+    _cpu_post_load(monkeypatch)
+    ops.name(exl3_ref_model)
+    _process_dense(exl3_ref_model)
+    ref_up_exl3 = exl3_ref_model.model.layers[1].block_sparse_moe.routed_expert_up_proj
+    ref_norm_exl3 = exl3_ref_model.model.layers[1].block_sparse_moe.routed_expert_norm
+    exl3_latent = ref_norm_exl3(fused_sum)
+    expected_exl3_up = ref_up_exl3.quant_method.apply(ref_up_exl3, exl3_latent)
+
+    exl3_ar2 = []
+    for rank in (0, 1):
+        _parallel_groups(monkeypatch, tp_size=2, tp_rank=rank)
+        monkeypatch.setattr(lmr, "get_tensor_model_parallel_rank", lambda r=rank: r)
+        stage = {"count": 0}
+
+        def fake_ar_exl3(tensor, st=stage):
+            st["count"] += 1
+            if st["count"] == 1:
+                return fused_sum.clone()
+            exl3_ar2.append(tensor.clone())
+            return tensor
+
+        monkeypatch.setattr(lmr, "tensor_model_parallel_all_reduce", fake_ar_exl3)
+        monkeypatch.setattr(
+            "vllm.model_executor.layers.fused_moe.runner.moe_runner.tensor_model_parallel_all_reduce",
+            fake_ar_exl3,
+        )
+        runners[rank]._shard_up_proj_tail(
+            fused_partials[rank].clone(),
+            torch.zeros((M, H), dtype=torch.bfloat16),
+            trunc_size=None,
+        )
+
+    exl3_sharded_up = exl3_ar2[0] + exl3_ar2[1]
+    assert exl3_sharded_up.shape == expected_exl3_up.shape
+    # Check per-rank slice exactness (note FakeDenseOps adds a small trellis tag per shard).
+    for rank in (0, 1):
+        w = models[rank].model.layers[1].block_sparse_moe.routed_expert_up_proj.exl3_weights[0]
+        want = fake_dense.member_output(
+            exl3_latent, w.trellis, w.svh, w.logical_out, torch.bfloat16
+        )
+        assert torch.equal(exl3_sharded_up[:, rank * 128 : (rank + 1) * 128], want)
+
