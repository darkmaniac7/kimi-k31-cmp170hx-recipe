+    C = 3 * H * D
+    num_blocks = 64
+    cw, cb, A_log, dt_bias, norm_w = _make_gpu_kda_weights(H, D, 1101)
+    g = torch.Generator(device="cuda").manual_seed(1102)
+
+    conv_leg = (
+        torch.randn((num_blocks, C, 2 + S_cols), device="cuda", generator=g) * 0.2
+    ).to(torch.bfloat16)
+    rec_leg = torch.randn((num_blocks, H, D, D), device="cuda", generator=g) * 0.05
+    conv_rec, rec_rec = conv_leg.clone(), rec_leg.clone()
+    sm = torch.zeros((num_blocks,), device="cuda", dtype=torch.int32)
+
+    ssi = torch.zeros((B, S_cols), device="cuda", dtype=torch.int32)
+    for b in range(B):
+        ssi[b] = torch.arange(2 + b * S_cols, 2 + (b + 1) * S_cols, device="cuda")
+
+    # Pre-seed sequences 1 and 3 in records mode, leaving 0 and 2 in legacy mode=0!
+    qsl_seed = torch.tensor([0, 6, 12], device="cuda", dtype=torch.int32)
+    ssi_seed = ssi[[1, 3]].contiguous()
+    acc_seed = torch.tensor([1, 1], device="cuda", dtype=torch.int32)
+    mqkv_s, rg_s, rb_s, g2_s = _make_gpu_step_inputs(12, H, D, 1110)
+    out_s_leg = torch.empty((12, H, D), device="cuda", dtype=torch.bfloat16)
+    out_s_rec = torch.empty((12, H, D), device="cuda", dtype=torch.bfloat16)
+    glue_ops.fused_kda_spec_verify(
