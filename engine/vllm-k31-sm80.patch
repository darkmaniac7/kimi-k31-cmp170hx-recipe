+def test_release_4_ref_sms_m14_and_concurrent_streams(dops):
+    """Release 4 checks (H4, M13, M14, L17): per-workspace arrival counters under
+    concurrent compute+aux streams, VLLM_K31_DENSE_REF_SMS split pinning across
+    unequal SM counts, and 0-ULP identical M=1..16 split reduction."""
+    device = torch.device("cuda:0")
+    assert dops.build_info()["api_version"] == 4
+    torch.manual_seed(7)
+    x = torch.randn((16, 7168), dtype=torch.bfloat16, device=device)
+    t_qa = torch.randint(-32768, 32767, (7168 // 16, 1536 // 16, 96), dtype=torch.int16, device=device)
+    t_kva = torch.randint(-32768, 32767, (7168 // 16, 640 // 16, 96), dtype=torch.int16, device=device)
+    su = torch.ones(7168, dtype=torch.float16, device=device)
+    sv_qa = torch.ones(1536, dtype=torch.float16, device=device) * 0.02
+    sv_kva = torch.ones(640, dtype=torch.float16, device=device) * 0.02
+    ws0 = torch.empty(dops.linear_workspace_size_k31(16, 7168, 2176, 2), dtype=torch.float32, device=device)
+    ws1 = torch.empty_like(ws0)
+
+    try:
+        for ref_sms in (74, 108, 122, 124, 188):
+            dops.set_ref_sms_k31(ref_sms)
+            assert dops.get_ref_sms_k31() == ref_sms
+            out1 = torch.empty((1, 2112), dtype=torch.bfloat16, device=device)
+            out8 = torch.empty((8, 2112), dtype=torch.bfloat16, device=device)
+            ws0.fill_(77.0)
+            dops.linear_out_k31_multi(x[:1], [t_qa, t_kva], [su, su], [sv_qa, sv_kva], [12, 12], [1536, 576], out1, ws0)
+            ws0.fill_(-33.0)
+            dops.linear_out_k31_multi(x[:8], [t_qa, t_kva], [su, su], [sv_qa, sv_kva], [12, 12], [1536, 576], out8, ws0)
+            assert torch.equal(out1[0], out8[0]), f"M14 row0 mismatch at ref_sms={ref_sms}"
+    finally:
+        dops.set_ref_sms_k31(0)
+
+    # H4: concurrent 2-stream stress with isolated workspaces.
+    ref_out = torch.empty((8, 2112), dtype=torch.bfloat16, device=device)
+    dops.linear_out_k31_multi(x[:8], [t_qa, t_kva], [su, su], [sv_qa, sv_kva], [12, 12], [1536, 576], ref_out, ws0)
+    torch.cuda.synchronize()
+    s0, s1 = torch.cuda.Stream(device=device), torch.cuda.Stream(device=device)
+    o0, o1 = torch.empty_like(ref_out), torch.empty_like(ref_out)
+    for _ in range(20):
+        o0.zero_(); o1.zero_()
+        torch.cuda.synchronize()
+        with torch.cuda.stream(s0):
+            dops.linear_out_k31_multi(x[:8], [t_qa, t_kva], [su, su], [sv_qa, sv_kva], [12, 12], [1536, 576], o0, ws0)
+        with torch.cuda.stream(s1):
+            dops.linear_out_k31_multi(x[:8], [t_qa, t_kva], [su, su], [sv_qa, sv_kva], [12, 12], [1536, 576], o1, ws1)
+        torch.cuda.synchronize()
+        assert torch.equal(o0, ref_out) and torch.equal(o1, ref_out)
