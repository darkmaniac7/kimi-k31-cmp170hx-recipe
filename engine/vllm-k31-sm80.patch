+
+  const int grid_x = static_cast<int>(bh_total);
+
+  k31_fused_kda_spec_verify_d128_kernel<<<grid_x, 512, 0, stream>>>(
+      reinterpret_cast<const __nv_bfloat16*>(mixed_qkv.data_ptr()),
+      reinterpret_cast<__nv_bfloat16*>(conv_state.data_ptr()),
+      conv_weight.data_ptr(),
+      cb_ptr,
+      reinterpret_cast<const __nv_bfloat16*>(raw_g.data_ptr()),
+      reinterpret_cast<const __nv_bfloat16*>(raw_beta.data_ptr()),
+      A_log.data_ptr(),
+      dt_bias.data_ptr(),
+      reinterpret_cast<const __nv_bfloat16*>(g2.data_ptr()),
+      norm_weight.data_ptr(),
+      recurrent_state.data_ptr<float>(),
+      spec_state_indices.data_ptr(),
+      query_start_loc.data_ptr(),
+      num_accepted_tokens.data_ptr(),
+      mixed_qkv.stride(0),
+      stride_cs_slot,
+      stride_cs_c,
+      stride_cs_t,
+      conv_weight.stride(0),
+      raw_g.stride(0),
+      raw_beta.stride(0),
+      g2.stride(0),
+      recurrent_state.stride(0),
+      spec_state_indices.stride(0),
+      out.stride(0),
+      T,
+      static_cast<int>(H),
