+def test_blocker3_stock_nccl_early_none_return_drains_irecv_handles(monkeypatch):
+    """Blocker 3: on stock NCCL (VLLM_PP_PACKED_HOP=0), early None return
+    from model_runner (e.g. PipeSpec dropped Chunk B) still waits irecv handles
+    without launching wasted TP all-gather postprocess callbacks."""
+    import inspect
+    from contextlib import nullcontext
+
+    import vllm.v1.worker.gpu_worker as gw
+
+    monkeypatch.setenv("VLLM_PP_PACKED_HOP", "0")
+    monkeypatch.setenv("VLLM_PP_HOP_NO_METADATA", "0")
+
+    waited = []
+    postprocess_called = []
+
+    class _Handle:
+        def __init__(self, tag: str):
+            self.tag = tag
+
+        def wait(self):
+            waited.append(self.tag)
+
+    def fake_irecv(all_gather_group=None):
+        tensors = {
+            "hidden_states": torch.zeros(4, 16, dtype=torch.bfloat16),
+            "residual": torch.zeros(4, 7, 16, dtype=torch.bfloat16),
+        }
+        return (
+            tensors,
+            [_Handle("hidden_states"), _Handle("residual")],
+            [lambda: postprocess_called.append("tp_all_gather")],
+        )
+
+    pp_last = SimpleNamespace(
+        world_size=4,
+        rank_in_group=3,
+        is_first_rank=False,
+        is_last_rank=True,
+        irecv_tensor_dict=fake_irecv,
+    )
+    monkeypatch.setattr(gw, "get_pp_group", lambda: pp_last)
+    monkeypatch.setattr(gw, "get_tp_group", lambda: SimpleNamespace(world_size=2))
+
+    class _DroppedChunkBRunner:
+        is_pooling_model = False
+
+        def execute_model(self, sched, intermediate_tensors):
+            # PipeSpec dropped Chunk B returns None without touching tensors.
+            assert isinstance(intermediate_tensors, gw.AsyncIntermediateTensors)
+            return None
+
+    w = gw.Worker.__new__(gw.Worker)
+    w.device = torch.device("cpu")
+    w.vllm_config = SimpleNamespace(
+        is_mm_encoder_only=False,
+        parallel_config=SimpleNamespace(distributed_executor_backend="mp"),
+    )
+    w._pp_send_work = []
+    w._pp_transport = None
+    w._pp_recv_specs = {}
+    w._pp_hop = None
+    w._pp_hop_resolved = False
+    w._pp_hop_layout = None
+    w.model_runner = _DroppedChunkBRunner()
+    w.annotate_profile = lambda _sched: nullcontext()
+
+    out = inspect.unwrap(gw.Worker.execute_model)(
+        w, SimpleNamespace(total_num_scheduled_tokens=4)
+    )
+    assert out is None
+    assert waited == ["hidden_states", "residual"]
+    assert postprocess_called == []
