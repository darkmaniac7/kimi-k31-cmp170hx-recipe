+        assert rec["post_mla_moe_rel_l2"] <= BOUND_COMPOSITE_REL_L2, f"L3 moe M={m_str}"
+        if m_str == "1":
+            assert rec["rel_l2"] <= BOUND_COMPOSITE_REL_L2, f"L3 M=1"
+        else:
+            assert rec["rel_l2"] <= 5e-3 and rec["cos"] >= 0.99999, f"L3 M={m_str}"
+
+
+if __name__ == "__main__":
