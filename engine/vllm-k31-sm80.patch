--- /dev/null
+++ b/vllm/sm80/spec_decode/draft_tree.py
@@ -0,0 +1,439 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Draft trees for speculative decoding: layout, greedy acceptance, builders
+and the expected-value arithmetic.
+
+A linear draft is a chain: the step verifies ``[last, d_1, ..., d_k]`` and
+accepts the longest prefix the target agrees with. A draft tree also carries
+runner-up tokens, so a step whose first guess fails can still accept a token
+down another branch. Every draft node is one verification row, exactly as a
+chain draft is, so a tree of ``n`` nodes costs what a chain of ``n`` drafts
+costs (plus the reloads counted by :attr:`TreeLayout.state_reload`).
+
+Nothing here is wired into the serving path. The functions are the pure core
+that a tree-speculation implementation needs on the host and in tests:
+
+* :class:`DraftTree`, :func:`layout`: node order, the parent of each row, the
+  position of each row (``base + depth``), the ancestor mask the attention of a
+  row may see, which rows cannot continue the recurrent state of the row before
+  them, and the three inputs behind each row for a width-4 causal convolution.
+* :func:`accept_walk`, :func:`commit_plan`: greedy verification of a tree and
+  what the accepted path leaves behind (the row whose recurrent state is next
+  step's start, the key/value rows to move to their final positions).
+* :func:`best_first_tree`, :func:`tree_from_depth_probs`,
+  :func:`static_tree_from_values`, :func:`choose_budget`: tree builders from
+  the drafter's own probabilities, and how many nodes a step should spend.
+* :func:`replay_accept_depth`, :func:`expected_tokens`, :func:`step_cost_ms`:
+  the offline expected-value simulator (``tools/sm80/dspark_tree_ev.py`` runs
+  it over measured drafter ranks).
+
+``VLLM_K31_DRAFT_TREE`` (default off) is the switch a wiring must check; see
+:func:`enabled`.
+"""
+
+from __future__ import annotations
+
+import heapq
+from collections.abc import Callable, Mapping, Sequence
+from dataclasses import dataclass
+
+SWITCH = "VLLM_K31_DRAFT_TREE"
+ROOT = -1
+# A width-4 causal convolution reads the three inputs before a row.
+CONV_TAPS = 3
+
+Path = tuple[int, ...]
+
+
+def enabled() -> bool:
+    """Whether ``VLLM_K31_DRAFT_TREE=1`` is set (default off)."""
+    import vllm.envs as envs
+
+    return bool(getattr(envs, SWITCH, False))
+
+
+@dataclass(frozen=True)
+class DraftTree:
+    """Draft nodes in verification order.
+
+    ``parent[i]`` is the node that node ``i`` follows, or :data:`ROOT` when it
+    follows the step's first row (the last accepted token). ``rank[i]`` says
+    which candidate of its parent's next-token distribution node ``i`` is
+    (0: the most likely). A parent always comes before its children.
+    """
+
+    parent: tuple[int, ...]
+    rank: tuple[int, ...]
+
+    def __post_init__(self) -> None:
+        if len(self.parent) != len(self.rank):
+            raise ValueError("parent and rank differ in length")
+        seen: set[tuple[int, int]] = set()
+        for i, (p, r) in enumerate(zip(self.parent, self.rank)):
+            if not ROOT <= p < i:
+                raise ValueError(f"node {i}: parent {p} does not come before it")
+            if r < 0:
+                raise ValueError(f"node {i}: negative rank {r}")
+            if (p, r) in seen:
+                raise ValueError(f"node {i}: candidate {r} of node {p} is drafted twice")
+            seen.add((p, r))
+
+    @property
+    def num_nodes(self) -> int:
+        return len(self.parent)
+
+    @property
+    def num_rows(self) -> int:
+        """Verification rows of the step: the last accepted token and the nodes."""
+        return 1 + len(self.parent)
+
+    @property
+    def depth(self) -> tuple[int, ...]:
+        """Draft depth of each node; a node that follows the root has depth 1."""
+        out: list[int] = []
+        for p in self.parent:
+            out.append(1 if p == ROOT else out[p] + 1)
+        return tuple(out)
+
+    @property
+    def paths(self) -> tuple[Path, ...]:
+        """The rank path of each node from the root."""
+        out: list[Path] = []
+        for p, r in zip(self.parent, self.rank):
+            out.append((r,) if p == ROOT else out[p] + (r,))
+        return tuple(out)
+
+    def children(self, node: int) -> list[int]:
+        """The nodes that follow ``node`` (:data:`ROOT` for the first row), by rank."""
+        kids = [i for i, p in enumerate(self.parent) if p == node]
+        return sorted(kids, key=lambda i: self.rank[i])
+
+    @classmethod
+    def chain(cls, k: int) -> DraftTree:
+        """The linear draft of ``k`` tokens."""
+        return cls(tuple(range(-1, k - 1)), (0,) * k)
+
+    @classmethod
+    def from_paths(cls, paths: Sequence[Path]) -> DraftTree:
+        """The tree with these rank paths, in depth-first order with the most
+        likely candidate first. The greedy chain then takes the first rows, so
+        its keys and values already sit at their final positions and the
+        recurrent state reloads only where a branch starts.
+        """
+        ordered = sorted(set(tuple(p) for p in paths))
+        index = {p: i for i, p in enumerate(ordered)}
+        parent: list[int] = []
+        for p in ordered:
+            if not p:
+                raise ValueError("the root has no path")
+            if len(p) == 1:
+                parent.append(ROOT)
+            elif p[:-1] not in index:
+                raise ValueError(f"path {p} has no parent in the tree")
+            else:
+                parent.append(index[p[:-1]])
+        return cls(tuple(parent), tuple(p[-1] for p in ordered))
+
+
+@dataclass(frozen=True)
+class TreeLayout:
+    """Per verification row (row 0 is the last accepted token).
+
+    Attributes:
+        parent_row: the row a row follows; -1 for row 0.
+        depth: 0 for row 0; a row's position is ``base + depth``.
+        ancestor_mask: ``ancestor_mask[i][j]`` is True when row ``i`` may
+            attend to row ``j``: ``j`` is ``i`` or one of its ancestors.
+        state_reload: True when the row does not follow the row before it, so
+            a recurrent kernel must reload the state its parent stored.
+        conv_history: the three inputs before the row, oldest first. A value
+            ``>= 0`` is a row of this step; ``-1``, ``-2``, ``-3`` are the
+            last, second-to-last and third-to-last inputs committed before it.
+    """
+
+    parent_row: tuple[int, ...]
+    depth: tuple[int, ...]
+    ancestor_mask: tuple[tuple[bool, ...], ...]
+    state_reload: tuple[bool, ...]
+    conv_history: tuple[tuple[int, int, int], ...]
+
+    @property
+    def num_rows(self) -> int:
+        return len(self.parent_row)
+
+    @property
+    def num_state_reloads(self) -> int:
+        return sum(self.state_reload)
+
+    def positions(self, base: int) -> list[int]:
+        """Token positions of the rows when row 0 sits at ``base``."""
+        return [base + d for d in self.depth]
+
+
+def _history(parent_row: Sequence[int], row: int) -> tuple[int, int, int]:
+    taps: list[int] = []
+    cur = parent_row[row]
+    while len(taps) < CONV_TAPS and cur >= 0:
+        taps.append(cur)
+        cur = parent_row[cur]
+    committed = -1
+    while len(taps) < CONV_TAPS:
+        taps.append(committed)
+        committed -= 1
+    oldest_first = tuple(reversed(taps))
+    return oldest_first[0], oldest_first[1], oldest_first[2]
+
+
+def layout(tree: DraftTree) -> TreeLayout:
+    """Row-level structure of a step that verifies ``tree``."""
+    parent_row = (-1,) + tuple(p + 1 for p in tree.parent)
+    depth = (0,) + tree.depth
+    rows = len(parent_row)
+    mask: list[tuple[bool, ...]] = []
+    for i in range(rows):
+        visible = [False] * rows
+        cur = i
+        while cur >= 0:
+            visible[cur] = True
+            cur = parent_row[cur]
+        mask.append(tuple(visible))
+    reload = tuple(i > 0 and parent_row[i] != i - 1 for i in range(rows))
+    history = tuple(_history(parent_row, i) for i in range(rows))
+    return TreeLayout(parent_row, depth, tuple(mask), reload, history)
+
+
+@dataclass(frozen=True)
+class AcceptResult:
+    """Outcome of greedy verification.
+
+    Attributes:
+        rows: the accepted draft rows, root to leaf.
+        tokens: the tokens the step emits: the target's token after row 0 and
+            after each accepted row (one more than ``rows``).
+        last_row: the row whose output was the last emitted token (0 when no
+            draft was accepted). Its recurrent state starts the next step.
+    """
+
+    rows: tuple[int, ...]
+    tokens: tuple[int, ...]
+    last_row: int
+
+    @property
+    def num_accepted(self) -> int:
+        return len(self.rows)
+
+
+def accept_walk(
+    tree: DraftTree, draft_tokens: Sequence[int], target_tokens: Sequence[int]
+) -> AcceptResult:
+    """Greedy verification of a draft tree.
+
+    ``draft_tokens[i]`` is node ``i``'s token and ``target_tokens[r]`` the
+    target's greedy token after row ``r`` (row 0 is the last accepted token,
+    row ``i + 1`` is node ``i``). From row 0, the walk moves to the child that
+    drafted the target's token and stops when no child did. Among children
+    that drafted the same token the lowest rank wins.
+    """
+    if len(draft_tokens) != tree.num_nodes:
+        raise ValueError("one draft token per node is required")
+    if len(target_tokens) != tree.num_rows:
+        raise ValueError("one target token per row is required")
+    rows: list[int] = []
+    tokens = [int(target_tokens[0])]
+    node = ROOT
+    while True:
+        want = tokens[-1]
+        nxt = next(
+            (c for c in tree.children(node) if int(draft_tokens[c]) == want), None
+        )
+        if nxt is None:
+            break
+        rows.append(nxt + 1)
+        tokens.append(int(target_tokens[nxt + 1]))
+        node = nxt
+    return AcceptResult(tuple(rows), tuple(tokens), rows[-1] if rows else 0)
+
+
+@dataclass(frozen=True)
+class CommitPlan:
+    """What an accepted path leaves for the next step.
+
+    Attributes:
+        state_row: the row whose stored recurrent state the next step starts
+            from (what ``num_accepted_tokens - 1`` selects for a chain).
+        kv_moves: ``(source_row, destination_row)`` for each accepted row whose
+            keys and values were written away from their final position (row
+            ``depth``). In order: a destination is never a later source.
+        conv_history: the three inputs before the next step's first row, oldest
+            first, in :attr:`TreeLayout.conv_history`'s encoding.
+    """
+
+    state_row: int
+    kv_moves: tuple[tuple[int, int], ...]
+    conv_history: tuple[int, int, int]
+
+
+def commit_plan(tree_layout: TreeLayout, accepted_rows: Sequence[int]) -> CommitPlan:
+    """The commit of an accepted path (``AcceptResult.rows``)."""
+    moves: list[tuple[int, int]] = []
+    prev = 0
+    for want_depth, row in enumerate(accepted_rows, start=1):
+        if tree_layout.parent_row[row] != prev or tree_layout.depth[row] != want_depth:
+            raise ValueError(f"row {row} does not continue the accepted path")
+        if row != want_depth:
+            moves.append((row, want_depth))
+        prev = row
+    # The next step's first row follows `prev`: its history is prev's history
+    # shifted by one, with prev itself as the newest input.
+    older = tree_layout.conv_history[prev]
+    return CommitPlan(prev, tuple(moves), (older[1], older[2], prev))
+
+
+def best_first_tree(
+    expand: Callable[[Path], Sequence[float]],
+    budget: int,
+    *,
+    branch: int = 2,
+    max_depth: int | None = None,
+    min_path_prob: float = 0.0,
+) -> tuple[DraftTree, tuple[float, ...]]:
+    """The ``budget`` draft nodes most likely to be accepted.
+
+    ``expand(path)`` returns the probabilities of the candidates that follow
+    the node at ``path`` (``()`` is the root), most likely first, given that the
+    node itself was accepted. A node's acceptance probability is the product of
+    those along its path; it never exceeds its parent's or its better sibling's,
+    so taking nodes in decreasing order always yields a valid tree, and that
+    tree maximizes the expected number of accepted tokens for its size.
+
+    ``expand`` is called once per selected node (one Markov evaluation of the
+    drafter) and once for the root.
+
+    Returns the tree (in :meth:`DraftTree.from_paths` order) and each node's
+    acceptance probability.
+    """
+    if budget <= 0 or branch <= 0:
+        return DraftTree((), ()), ()
+    cond: dict[Path, Sequence[float]] = {(): expand(())}
+    heap: list[tuple[float, Path]] = []
+
+    def push(path: Path, prob: float) -> None:
+        if prob > min_path_prob:
+            heapq.heappush(heap, (-prob, path))
+
+    if len(cond[()]) > 0:
+        push((0,), float(cond[()][0]))
+    chosen: dict[Path, float] = {}
+    while heap and len(chosen) < budget:
+        neg, path = heapq.heappop(heap)
+        prob = -neg
+        chosen[path] = prob
+        parent, rank = path[:-1], path[-1]
+        siblings = cond[parent]
+        if rank + 1 < min(branch, len(siblings)):
+            parent_prob = chosen[parent] if parent else 1.0
+            push(parent + (rank + 1,), parent_prob * float(siblings[rank + 1]))
+        if max_depth is None or len(path) < max_depth:
+            kids = expand(path)
+            cond[path] = kids
+            if len(kids) > 0:
+                push(path + (0,), prob * float(kids[0]))
+    tree = DraftTree.from_paths(list(chosen))
+    return tree, tuple(chosen[p] for p in tree.paths)
+
+
+def tree_from_depth_probs(
+    depth_probs: Sequence[Sequence[float]], budget: int, *, branch: int = 2
+) -> tuple[DraftTree, tuple[float, ...]]:
+    """:func:`best_first_tree` when the candidate probabilities are known per
+    depth only (``depth_probs[d][r]``: candidate ``r`` at draft depth ``d + 1``)
+    and are taken to hold on every branch. This is what the greedy chain's own
+    Markov steps give for free; a branch's true probabilities need one more
+    Markov evaluation per node.
+    """
+
+    def expand(path: Path) -> Sequence[float]:
+        return depth_probs[len(path)] if len(path) < len(depth_probs) else ()
+
+    return best_first_tree(expand, budget, branch=branch, max_depth=len(depth_probs))
+
+
+def static_tree_from_values(
+    values: Mapping[Path, float], budget: int
+) -> tuple[DraftTree, tuple[float, ...]]:
+    """The best fixed tree of ``budget`` nodes for measured acceptance rates
+    (``values[path]``: how often the node at ``path`` is accepted). A node is
+    taken only after its parent, so the result is a tree whatever the values.
+    """
+    chosen: dict[Path, float] = {}
+    frontier = [(-float(v), p) for p, v in values.items() if len(p) == 1]
+    heapq.heapify(frontier)
+    by_parent: dict[Path, list[Path]] = {}
+    for p in values:
+        if len(p) > 1:
+            by_parent.setdefault(p[:-1], []).append(p)
+    while frontier and len(chosen) < budget:
+        neg, path = heapq.heappop(frontier)
+        chosen[path] = -neg
+        for child in by_parent.get(path, ()):
+            heapq.heappush(frontier, (-float(values[child]), child))
+    tree = DraftTree.from_paths(list(chosen))
+    return tree, tuple(chosen[p] for p in tree.paths)
+
+
+def expected_tokens(path_probs: Sequence[float]) -> float:
+    """Expected tokens of a step: the target's own token plus each node's
+    acceptance probability."""
+    return 1.0 + float(sum(path_probs))
+
+
+def step_cost_ms(
+    num_nodes: int, costs: Mapping[str, float] | None = None, extra_ms: float = 0.0
+) -> float:
+    """Cost of a normal step that verifies ``num_nodes`` draft rows, from the
+    table dynamic PipeSpec uses (``VLLM_K31_STEP_COSTS``); ``extra_ms`` is what
+    a tree adds on top of a chain of the same size."""
+    key = str(int(num_nodes))
+    if costs is not None and key in costs:
+        return max(1.0, float(costs[key])) + extra_ms
+    return max(1.0, 33.5 + 2.0 * float(num_nodes)) + extra_ms
+
+
+def choose_budget(
+    probs_desc: Sequence[float],
+    *,
+    allowed: Sequence[int] | None = None,
+    costs: Mapping[str, float] | None = None,
+    extra_ms: float = 0.0,
+) -> int:
+    """How many nodes to verify this step: the count ``n`` that maximizes
+    expected tokens per millisecond when the step takes the ``n`` most likely
+    nodes (``probs_desc``: acceptance probabilities, largest first). ``allowed``
+    restricts ``n`` to the captured widths; the smallest wins a tie."""
+    sizes = sorted(allowed) if allowed is not None else range(1, len(probs_desc) + 1)
+    best_n, best_rate = 0, -1.0
+    for n in sizes:
+        if n <= 0 or n > len(probs_desc):
+            continue
+        rate = expected_tokens(probs_desc[:n]) / step_cost_ms(n, costs, extra_ms)
+        if rate > best_rate:
+            best_n, best_rate = n, rate
+    return best_n
+
+
+def replay_accept_depth(paths: Sequence[Path], true_ranks: Sequence[int]) -> int:
+    """Accepted drafts of a tree with rank paths ``paths`` on a measured anchor.
+
+    ``true_ranks[d]`` is the rank of the target's token among the drafter's
+    candidates at depth ``d + 1`` given the true tokens before it (teacher
+    forced), which is exactly what every node on an accepted path was drafted
+    from. The tree accepts the longest prefix of ``true_ranks`` it contains.
+    """
+    have = set(tuple(p) for p in paths)
+    cur: Path = ()
+    for r in true_ranks:
+        nxt = cur + (int(r),)
+        if nxt not in have:
+            break
+        cur = nxt
+    return len(cur)
