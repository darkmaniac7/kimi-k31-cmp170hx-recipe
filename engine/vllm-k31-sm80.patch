+    out_ref, cs_ref, rs_ref = ref_triton_spec_verify(
+        mixed_qkv, conv_state_0, conv_weight, None, raw_g, raw_beta,
+        A_log, dt_bias, g2, norm_weight, rec_state, state_slots, qsl, acc, -5.0, 1e-5,
+    )
+    out_fus, cs_fus, rs_fus = ref_fused_kda_spec_verify(
+        mixed_qkv, conv_state_0, conv_weight, None, raw_g, raw_beta,
+        A_log, dt_bias, g2, norm_weight, rec_state, state_slots, qsl, acc, -5.0, 1e-5,
+    )
+    assert torch.equal(cs_fus, cs_ref)
+    assert torch.allclose(out_fus.float(), out_ref.float(), atol=1e-3, rtol=1e-3)
+    assert torch.allclose(rs_fus, rs_ref, atol=1e-5, rtol=1e-5)
+
+    # Verify exact rolled contents on channel 0 of slot 3.
+    init_tok = na - 1
+    expected = [float(init_tok + 1), float(init_tok + 2)] + [float(100 + t) for t in range(W)]
+    if conv_state_len == 11:
+        expected.append(10.0)
+    assert cs_fus[3, 0].float().tolist() == expected
+
+    # Step 2: verify history window [init_tok2..init_tok2+2] picks exact last 3 accepted tokens.
+    mixed_qkv_2 = torch.arange(200, 200 + W, dtype=torch.bfloat16).view(W, 1).expand(W, C).contiguous()
+    acc_2 = torch.tensor([3], dtype=torch.int32)
+    _, cs_ref2, _ = ref_triton_spec_verify(
+        mixed_qkv_2, cs_ref, conv_weight, None, raw_g, raw_beta,
+        A_log, dt_bias, g2, norm_weight, rs_ref, state_slots, qsl, acc_2, -5.0, 1e-5,
+    )
+    _, cs_fus2, _ = ref_fused_kda_spec_verify(
+        mixed_qkv_2, cs_fus, conv_weight, None, raw_g, raw_beta,
+        A_log, dt_bias, g2, norm_weight, rs_fus, state_slots, qsl, acc_2, -5.0, 1e-5,
+    )
+    assert torch.equal(cs_fus2, cs_ref2)
+    expected2 = [101.0, 102.0] + [float(200 + t) for t in range(W)]
+    if conv_state_len == 11:
+        expected2.append(10.0)
+    assert cs_fus2[3, 0].float().tolist() == expected2
+
+
+@pytest.mark.parametrize("lower_bound", [-5.0, 0.0])
+def test_can_use_kda_spec_verify_fp32_conv_weight_k31_shape(monkeypatch, lower_bound):
+    """Verify K3.1 live FP32 conv_weight + None bias + H=48, W=8 passes eligibility."""
+    _clear_glue_env(monkeypatch)
+    FakeGlueV2Ops(api_version=2).install(monkeypatch)
+    monkeypatch.setenv("VLLM_K31_GLUE_KDA_SPEC", "1")
+    H, D, W, slots = 48, 128, 8, 16
+    C = 3 * H * D
+    mq = torch.empty((W, C), dtype=torch.bfloat16)
+    cs = torch.empty((slots, 2 + W, C), dtype=torch.bfloat16).transpose(1, 2)
+    cw = torch.empty((C, 4), dtype=torch.float32)
+    rg = torch.empty((W, H, D), dtype=torch.bfloat16)
+    rb = torch.empty((W, H), dtype=torch.bfloat16)
+    al = torch.empty((H,), dtype=torch.float32)
+    db = torch.empty((H * D,), dtype=torch.float32)
+    g2 = torch.empty((W, H, D), dtype=torch.bfloat16)
+    nw = torch.empty((D,), dtype=torch.float32)
+    rs = torch.empty((slots, H, D, D), dtype=torch.float32)
+    ssi = torch.tensor([[3, 4, 5, 6, 7, 8, 9, 10]], dtype=torch.int32)
+    qsl = torch.tensor([0, W], dtype=torch.int32)
+    acc = torch.tensor([3], dtype=torch.int32)
+    out = torch.empty((W, H, D), dtype=torch.bfloat16)
+
+    assert glue.can_use_kda_spec_verify(
+        mq, cs, cw, None, rg, rb, al, db, g2, nw, rs, ssi, qsl, acc,
+        out=out, o_norm_activation="sigmoid",
+    )
+    assert lower_bound <= 0.0
