+    _MODULE = mod
+    if not _FAKES_REGISTERED:
+        _register_fake_ops()
+        _FAKES_REGISTERED = True
+    if not _FAKES_V2_REGISTERED:
+        _register_fake_v2_ops()
+        _FAKES_V2_REGISTERED = True
+    _LOADED = True
+    _LOADED_V2 = True
+    return _MODULE
+
