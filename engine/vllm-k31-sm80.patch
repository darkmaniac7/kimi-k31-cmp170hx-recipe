+static std::string write_prompt_meta_json(
+        const fs::path & meta_path,
+        const PromptSpec & p,
+        const std::vector<llama_token> & prompt_tokens,
+        const std::vector<llama_token> & generated_ids,
+        const std::string & generated_text,
+        bool stopped_on_eog,
+        const std::string & model_path,
+        uint64_t model_size,
+        const std::string & model_head_sha256,
+        int32_t n_layer,
+        int32_t n_embd,
+        int32_t n_vocab,
+        const K31DumpConfig & cfg,
+        const std::set<int> & layers,
+        const std::map<std::string, TensorRecord> & tensors,
+        int64_t logit_nan_total,
+        int64_t logit_inf_total) {
+    std::ostringstream oss;
+    oss << "{\n";
+    oss << "  \"schema\": \"k31_layer_dump_v1\",\n";
+    oss << "  \"engine\": \"llama.cpp\",\n";
+    oss << "  \"prompt_id\": " << json_escape(p.id) << ",\n";
+    oss << "  \"category\": " << json_escape(p.category) << ",\n";
+    oss << "  \"prompt_text\": " << json_escape(p.prompt_text) << ",\n";
+    oss << "  \"model_path\": " << json_escape(model_path) << ",\n";
+    oss << "  \"model_size_bytes\": " << model_size << ",\n";
+    oss << "  \"model_head_sha256\": " << json_escape(model_head_sha256) << ",\n";
+    oss << "  \"n_layer\": " << n_layer << ",\n";
+    oss << "  \"hidden_size\": " << n_embd << ",\n";
+    oss << "  \"vocab_size\": " << n_vocab << ",\n";
+    oss << "  \"dtype\": " << json_escape(dtype_cli_name(cfg.save_dtype)) << ",\n";
+    oss << "  \"n_predict\": " << cfg.n_predict << ",\n";
+    oss << "  \"topk\": " << cfg.topk << ",\n";
+    oss << "  \"stopped_on_eog\": " << (stopped_on_eog ? "true" : "false") << ",\n";
+    oss << "  \"logit_nan_count\": " << logit_nan_total << ",\n";
+    oss << "  \"logit_inf_count\": " << logit_inf_total << ",\n";
+
+    oss << "  \"layers\": [";
+    bool first = true;
+    for (int il : layers) {
+        if (!first) oss << ", ";
+        first = false;
+        oss << il;
+    }
+    oss << "],\n";
+
+    oss << "  \"prompt_token_ids\": [";
+    for (size_t i = 0; i < prompt_tokens.size(); ++i) {
+        if (i > 0) oss << ", ";
+        oss << prompt_tokens[i];
+    }
+    oss << "],\n";
+
+    oss << "  \"generated_ids\": [";
+    for (size_t i = 0; i < generated_ids.size(); ++i) {
+        if (i > 0) oss << ", ";
+        oss << generated_ids[i];
+    }
+    oss << "],\n";
+
+    oss << "  \"generated_text\": " << json_escape(generated_text) << ",\n";
+    oss << "  \"safetensors_file\": " << json_escape(p.id + ".safetensors") << ",\n";
+
+    oss << "  \"tensors\": {\n";
+    size_t ti = 0;
+    for (const auto & kv : tensors) {
+        const auto & rec = kv.second;
+        double l2 = std::sqrt(rec.sum_sq);
+        oss << "    " << json_escape(kv.first) << ": {\"dtype\": " << json_escape(rec.dtype) << ", \"shape\": [";
+        for (size_t d = 0; d < rec.shape.size(); ++d) {
+            if (d > 0) oss << ", ";
+            oss << rec.shape[d];
+        }
+        oss << "], \"nan_count\": " << rec.nan_count
+            << ", \"inf_count\": " << rec.inf_count
+            << ", \"l2_norm\": " << std::setprecision(9) << l2
+            << ", \"max_abs\": " << std::setprecision(9) << rec.max_abs << "}";
+        if (++ti < tensors.size()) oss << ",";
+        oss << "\n";
+    }
+    oss << "  }\n";
+    oss << "}\n";
+
+    std::string body = oss.str();
+    fs::path tmp = meta_path;
+    tmp += ".tmp";
+    {
+        std::ofstream ofs(tmp, std::ios::binary | std::ios::trunc);
+        if (!ofs) throw std::runtime_error("Cannot open meta file: " + tmp.string());
+        ofs.write(body.data(), static_cast<std::streamsize>(body.size()));
+    }
+    fs::rename(tmp, meta_path);
+    return body;
+}
+
+} // namespace
+
+int main(int argc, char ** argv) {
+    std::setlocale(LC_NUMERIC, "C");
+
+    K31DumpConfig cfg;
+    std::vector<char *> llama_argv;
+    llama_argv.push_back(argv[0]);
+
+    for (int i = 1; i < argc; ++i) {
+        std::string arg(argv[i]);
+        auto need_val = [&](const char * flag) -> std::string {
+            if (i + 1 >= argc) {
+                throw std::runtime_error(std::string("Missing value for ") + flag);
+            }
+            return std::string(argv[++i]);
+        };
+        if (arg == "--k31-help") {
+            print_k31_usage(argv[0]);
+            return 0;
+        } else if (arg == "--k31-prompts") {
+            cfg.prompts_path = need_val("--k31-prompts");
+        } else if (arg == "--k31-out") {
+            cfg.out_dir = need_val("--k31-out");
+        } else if (arg == "--k31-layers") {
+            cfg.layers_spec = need_val("--k31-layers");
+        } else if (arg == "--k31-taps") {
+            cfg.taps_spec = need_val("--k31-taps");
+        } else if (arg == "--k31-dtype") {
+            std::string dt = need_val("--k31-dtype");
+            if (dt == "bf16") cfg.save_dtype = SaveDtype::BF16;
+            else if (dt == "fp16" || dt == "f16") cfg.save_dtype = SaveDtype::F16;
+            else if (dt == "fp32" || dt == "f32") cfg.save_dtype = SaveDtype::F32;
+            else {
+                std::fprintf(stderr, "ERROR: unknown --k31-dtype '%s' (expected bf16|fp16|fp32)\n", dt.c_str());
+                return 2;
+            }
+        } else if (arg == "--k31-n-predict") {
+            cfg.n_predict = std::stoi(need_val("--k31-n-predict"));
+        } else if (arg == "--k31-topk") {
+            cfg.topk = std::stoi(need_val("--k31-topk"));
+        } else if (arg == "--k31-prompt-ids") {
+            cfg.prompt_ids_spec = need_val("--k31-prompt-ids");
+        } else if (arg == "--k31-max-tokens") {
+            cfg.max_tokens = std::stoi(need_val("--k31-max-tokens"));
+        } else if (arg == "--k31-capture-decode-layers") {
+            cfg.capture_decode_layers = true;
+        } else if (arg == "--k31-ignore-eos") {
+            cfg.ignore_eos = true;
+        } else if (arg == "--k31-all-prefill-logits") {
+            cfg.all_prefill_logits = true;
+        } else if (arg == "--k31-verbose") {
+            cfg.verbose = true;
+        } else {
+            llama_argv.push_back(argv[i]);
+        }
+    }
+
+    if (cfg.prompts_path.empty() || cfg.out_dir.empty()) {
+        print_k31_usage(argv[0]);
+        std::fprintf(stderr, "\nERROR: --k31-prompts and --k31-out are required.\n");
+        return 2;
+    }
+
+    try {
+        std::vector<PromptSpec> prompts = load_prompts_json(cfg.prompts_path);
+        if (!cfg.prompt_ids_spec.empty()) {
+            auto wanted = split_csv(cfg.prompt_ids_spec);
+            std::unordered_set<std::string> wset(wanted.begin(), wanted.end());
+            std::vector<PromptSpec> filtered;
+            for (auto & p : prompts) {
+                if (wset.count(p.id)) filtered.push_back(std::move(p));
+            }
+            prompts = std::move(filtered);
+        }
+        if (prompts.empty()) {
+            std::fprintf(stderr, "ERROR: no prompts selected from %s\n", cfg.prompts_path.c_str());
+            return 2;
+        }
+
+        fs::create_directories(cfg.out_dir);
+
+        common_params params;
+        common_init();
+        if (!common_params_parse(static_cast<int>(llama_argv.size()), llama_argv.data(), params, LLAMA_EXAMPLE_COMMON)) {
+            return 1;
+        }
+
+        CaptureState cb_state;
+        cb_state.save_dtype = cfg.save_dtype;
+        cb_state.verbose    = cfg.verbose;
+        for (const auto & tap : split_csv(cfg.taps_spec)) {
+            cb_state.taps.insert(tap);
+        }
+
+        params.cb_eval           = k31_cb_eval;
+        params.cb_eval_user_data = &cb_state;
+        params.warmup            = false;
+
+        llama_backend_init();
+        llama_numa_init(params.numa);
+
+        auto llama_init = common_init_from_params(params);
+        auto * model = llama_init->model();
+        auto * ctx   = llama_init->context();
+        if (model == nullptr || ctx == nullptr) {
+            LOG_ERR("llama-k31-dump: failed to initialize model/context\n");
+            llama_backend_free();
+            return 1;
+        }
+
+        const llama_vocab * vocab = llama_model_get_vocab(model);
+        const int32_t n_layer = llama_model_n_layer(model);
+        const int32_t n_embd  = llama_model_n_embd(model);
+        const int32_t n_vocab = llama_vocab_n_tokens(vocab);
+        const int32_t n_batch = static_cast<int32_t>(llama_n_batch(ctx));
+
+        cb_state.layers = parse_layers_spec(cfg.layers_spec, n_layer);
+
+        std::string model_path = params.model.path;
+        uint64_t model_size = 0;
+        std::error_code ec;
+        if (!model_path.empty() && fs::exists(model_path, ec)) {
+            model_size = fs::file_size(model_path, ec);
+        }
+        std::string model_head_sha256 = hash_file_head_sha256(model_path);
+
+        LOG_INF("llama-k31-dump: n_layer=%d hidden_size=%d vocab_size=%d selected_layers=%zu n_predict=%d topk=%d dtype=%s\n",
+                n_layer, n_embd, n_vocab, cb_state.layers.size(), cfg.n_predict, cfg.topk, dtype_cli_name(cfg.save_dtype));
+
+        std::vector<std::string> done_prompt_ids;
+
+        for (const auto & p : prompts) {
+            llama_memory_clear(llama_get_memory(ctx), true);
+            cb_state.captured.clear();
+            cb_state.raw_name_to_canon.clear();
+
+            std::vector<llama_token> tokens = p.token_ids;
+            if (tokens.empty()) {
+                const bool add_bos = p.add_bos && llama_vocab_get_add_bos(vocab);
+                tokens = common_tokenize(ctx, p.prompt_text, add_bos, true);
+            }
+            if (cfg.max_tokens > 0 && static_cast<int32_t>(tokens.size()) > cfg.max_tokens) {
+                tokens.resize(static_cast<size_t>(cfg.max_tokens));
+            }
+            if (tokens.empty()) {
+                throw std::runtime_error("Prompt " + p.id + " produced zero tokens");
+            }
+
+            const int32_t n_prompt = static_cast<int32_t>(tokens.size());
+            LOG_INF("llama-k31-dump: running prompt '%s' (%d tokens, n_predict=%d)\n",
+                    p.id.c_str(), n_prompt, cfg.n_predict);
+
+            cb_state.active = true;
+            cb_state.key_prefix = "";
+
+            common_batch batch(ctx);
+            for (int32_t i = 0; i < n_prompt; ++i) {
+                const bool want_out = cfg.all_prefill_logits || (i == n_prompt - 1);
+                batch.add(tokens[static_cast<size_t>(i)], static_cast<llama_pos>(i), 0, want_out);
+            }
+
+            const int32_t step_chunk = std::max(1, n_batch);
+            for (int32_t off = 0; off < batch.size(); off += step_chunk) {
+                const int32_t cur_n = std::min(step_chunk, batch.size() - off);
+                if (llama_process(ctx, LLAMA_PROCESS_TYPE_DECODE, batch.get_sub_batch(off, cur_n)) != 0) {
+                    throw std::runtime_error("llama_process prefill failed on prompt: " + p.id);
+                }
+            }
+
+            const int32_t k_eff = std::min(std::max(cfg.topk, 1), n_vocab);
+            std::vector<int32_t> all_topk_ids;
+            std::vector<float>   all_topk_logits;
+            std::vector<float>   all_lse;
+            std::vector<int32_t> logit_positions;
+            std::vector<llama_token> generated_ids;
+            std::string generated_text;
+            bool stopped_on_eog = false;
+            int64_t logit_nan_total = 0;
+            int64_t logit_inf_total = 0;
+
+            auto record_step_logits = [&](int32_t pos_idx) -> llama_token {
+                const float * logits = llama_get_logits_ith(ctx, -1);
+                if (!logits) {
+                    throw std::runtime_error("llama_get_logits_ith(-1) returned NULL on prompt: " + p.id);
+                }
+                LogitTopKResult tk = extract_topk_and_lse(logits, n_vocab, k_eff);
+                logit_nan_total += tk.nan_count;
+                logit_inf_total += tk.inf_count;
+                all_topk_ids.insert(all_topk_ids.end(), tk.topk_ids.begin(), tk.topk_ids.end());
+                all_topk_logits.insert(all_topk_logits.end(), tk.topk_logits.begin(), tk.topk_logits.end());
+                all_lse.push_back(tk.logsumexp);
+                logit_positions.push_back(pos_idx);
+                return static_cast<llama_token>(tk.topk_ids[0]);
+            };
+
+            llama_token next_tok = record_step_logits(n_prompt - 1);
+
+            cb_state.active = cfg.capture_decode_layers;
+            cb_state.key_prefix = "decode.";
+
+            for (int32_t step = 0; step < cfg.n_predict; ++step) {
+                generated_ids.push_back(next_tok);
+                generated_text += common_token_to_piece(ctx, next_tok, false);
+                if (!cfg.ignore_eos && llama_vocab_is_eog(vocab, next_tok)) {
+                    stopped_on_eog = true;
+                    break;
+                }
+                if (step + 1 >= cfg.n_predict) {
+                    break;
+                }
+                batch.clear();
+                batch.add(next_tok, static_cast<llama_pos>(n_prompt + step), 0, true);
+                if (llama_process(ctx, LLAMA_PROCESS_TYPE_DECODE, batch.get()) != 0) {
+                    throw std::runtime_error("llama_process decode step failed on prompt: " + p.id);
+                }
+                next_tok = record_step_logits(n_prompt + step);
+            }
+
+            cb_state.active = false;
+
+            const int64_t n_logit_pos = static_cast<int64_t>(all_lse.size());
+            cb_state.captured["prompt_token_ids"] = make_i32_tensor(
+                std::vector<int32_t>(tokens.begin(), tokens.end()), {static_cast<int64_t>(tokens.size())});
+            cb_state.captured["generated_ids"] = make_i32_tensor(
+                std::vector<int32_t>(generated_ids.begin(), generated_ids.end()),
+                {static_cast<int64_t>(generated_ids.size())});
+            cb_state.captured["logit_positions"] = make_i32_tensor(logit_positions, {n_logit_pos});
+            cb_state.captured["topk_ids"] = make_i32_tensor(all_topk_ids, {n_logit_pos, k_eff});
+            cb_state.captured["topk_logits"] = make_f32_tensor(all_topk_logits, {n_logit_pos, k_eff});
+            cb_state.captured["logsumexp"] = make_f32_tensor(all_lse, {n_logit_pos});
+
+            std::map<std::string, std::string> st_meta = {
+                {"schema", "k31_layer_dump_v1"},
+                {"engine", "llama.cpp"},
+                {"prompt_id", p.id},
+                {"dtype", dtype_cli_name(cfg.save_dtype)},
+                {"n_layer", std::to_string(n_layer)},
+                {"hidden_size", std::to_string(n_embd)},
+                {"vocab_size", std::to_string(n_vocab)},
+            };
+
+            fs::path st_path   = fs::path(cfg.out_dir) / (p.id + ".safetensors");
+            fs::path meta_path = fs::path(cfg.out_dir) / (p.id + ".meta.json");
+            write_safetensors_atomic(st_path, cb_state.captured, st_meta);
+            write_prompt_meta_json(meta_path, p, tokens, generated_ids, generated_text, stopped_on_eog,
+                                   model_path, model_size, model_head_sha256, n_layer, n_embd, n_vocab,
+                                   cfg, cb_state.layers, cb_state.captured, logit_nan_total, logit_inf_total);
+            done_prompt_ids.push_back(p.id);
+            LOG_INF("llama-k31-dump: wrote %s (%zu tensors, %zu generated tokens)\n",
+                    st_path.c_str(), cb_state.captured.size(), generated_ids.size());
+        }
+
+        fs::path manifest_path = fs::path(cfg.out_dir) / "manifest.json";
+        fs::path manifest_tmp  = manifest_path;
+        manifest_tmp += ".tmp";
+        {
+            std::ofstream ofs(manifest_tmp, std::ios::binary | std::ios::trunc);
+            ofs << "{\n";
+            ofs << "  \"schema\": \"k31_layer_dump_v1\",\n";
+            ofs << "  \"engine\": \"llama.cpp\",\n";
+            ofs << "  \"model_path\": " << json_escape(model_path) << ",\n";
+            ofs << "  \"model_size_bytes\": " << model_size << ",\n";
+            ofs << "  \"model_head_sha256\": " << json_escape(model_head_sha256) << ",\n";
+            ofs << "  \"prompts_file\": " << json_escape(cfg.prompts_path) << ",\n";
+            ofs << "  \"n_layer\": " << n_layer << ",\n";
+            ofs << "  \"hidden_size\": " << n_embd << ",\n";
+            ofs << "  \"vocab_size\": " << n_vocab << ",\n";
+            ofs << "  \"dtype\": " << json_escape(dtype_cli_name(cfg.save_dtype)) << ",\n";
+            ofs << "  \"n_predict\": " << cfg.n_predict << ",\n";
+            ofs << "  \"topk\": " << cfg.topk << ",\n";
+            ofs << "  \"prompts\": [";
+            for (size_t i = 0; i < done_prompt_ids.size(); ++i) {
+                if (i > 0) ofs << ", ";
+                ofs << json_escape(done_prompt_ids[i]);
+            }
+            ofs << "]\n}\n";
+        }
+        fs::rename(manifest_tmp, manifest_path);
+
+        llama_backend_free();
+        LOG_INF("llama-k31-dump: DONE (%zu prompts written to %s)\n", done_prompt_ids.size(), cfg.out_dir.c_str());
+        return 0;
+    } catch (const std::exception & e) {
+        std::fprintf(stderr, "ERROR: %s\n", e.what());
+        return 1;
+    }
+}
