+    )
+    assert done.returncode == 0, done.stdout + "\n" + done.stderr[-4000:]
+    line = [ln for ln in done.stdout.splitlines() if ln.startswith("RESULT ")][-1]
+    res = json.loads(line[len("RESULT ") :])
+    assert res == {"ns": [4, 1, 2, 3], "nr": [0, 3, 2, 1]}
