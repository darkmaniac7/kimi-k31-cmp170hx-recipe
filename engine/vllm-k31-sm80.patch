+    from vllm.models.deepseek_v41.nvidia.ops import sm80_mhc_side as mhc_side
+
+    log = []
+    cur = [_Stream("main", log)]
+
+    @contextmanager
+    def stream(s):
+        prev, cur[0] = cur[0], s
+        try:
+            yield
+        finally:
+            cur[0] = prev
+
+    class Finish:
+        def __getitem__(self, grid):
+            return lambda *a, **k: log.append(("finish", cur[0].name, grid, k.get("PART")))
+
+    def kernel_a(*args, **kwargs):
