+def _chunk(rank: int, layer: int, tp: int = 2) -> slice:
+    """I-blocks of rank ``rank`` at layer ``layer``: chunk (rank + layer) mod tp."""
+    blocks = fixture.TEXT["moe_intermediate_size"] // 128
+    chunk = (rank + layer) % tp
+    return slice(chunk * blocks // tp, (chunk + 1) * blocks // tp)
+
+
+@pytest.mark.parametrize("rank", [0, 1])
+def test_tp2_rank_holds_its_own_cut(monkeypatch, meta_platform, checkpoint, rank):
+    directory, reference = checkpoint
+    model, config, report, names = construct.build_and_load(
+        monkeypatch, directory, tp_size=2, tp_rank=rank
+    )
+    assert set(report.ledger) == names
+    assert {use for use, _ in report.ledger.values()} == {"consumed"}
+    text = fixture.TEXT
+    hidden, latent = text["hidden_size"], text["routed_expert_hidden_size"]
+    half = slice(rank * 128, (rank + 1) * 128)
+
+    # VQ experts: the canonical records of this rank's I-blocks, read as byte ranges.
+    for layer in VQ_LAYERS:
+        experts = _experts(model, layer).k31_experts
+        blocks = _chunk(rank, layer)
+        assert (experts.blocks, experts.local_intermediate) == (blocks, 256)
+        base = f"{fixture.P}layers.{layer}.block_sparse_moe.experts"
+        read = books = 0
+        for w, role in fixture.PROJECTIONS:
+            idx = fixture.st_read(_file(directory, layer), f"{base}.{w}.vq_idx")
+            scale = fixture.st_read(_file(directory, layer), f"{base}.{w}.vq_scale")
+            assert np.array_equal(getattr(experts, f"{w}_idx").numpy(), idx[:, blocks])
+            assert np.array_equal(
+                _bits(getattr(experts, f"{w}_scale")), scale[:, blocks].view(np.uint16)
+            )
+            read += (idx.nbytes + scale.nbytes) // 2
+            books += getattr(experts, f"{w}_codebook").nbytes
+            # The reference path decodes them to this rank's rows or columns.
+            cut = slice(blocks.start * 128, blocks.stop * 128)
+            for expert in (0, text["num_experts"] - 1):
+                want = reference[f"{base}.{w}.{expert}"]
+                want = want[cut] if role == "in_latent" else want[:, cut]
+                assert np.array_equal(experts.dequant(w, expert).numpy(), want)
+        assert (experts.bytes_read, experts.codebook_bytes) == (read, books)
+
+    # EXL3 experts: every (expert, projection) is a view of one buffer per kind.
+    experts = _experts(model, EXL3_LAYER).k31_experts
+    blocks = _chunk(rank, EXL3_LAYER)
+    cut = slice(blocks.start * 8, blocks.stop * 8)  # in units of 16
+    base = f"{fixture.P}layers.{EXL3_LAYER}.block_sparse_moe.experts"
+    assert len(experts.parts) == 1 and len(experts.entries) == 3 * text["num_experts"]
+    for expert in (0, text["num_experts"] - 1):
+        for slot, (w, role) in enumerate(fixture.PROJECTIONS):
+            entry = experts.entries[3 * expert + slot]
+            trellis = fixture.st_read(
+                _file(directory, EXL3_LAYER), f"{base}.{expert}.{w}.trellis"
+            )
+            want = trellis[:, cut] if role == "in_latent" else trellis[cut]
+            assert np.array_equal(experts._view(0, entry).numpy(), want)
+            assert experts._view(1, entry).shape == (
+                (latent,) if role == "in_latent" else (256,)
+            )
+
+    # Dense EXL3: a row-parallel input cut, a column cut and the LM head's
+    # vocabulary cut.
+    kda = _layer(model, 1).self_attn
+    prefix = f"{fixture.P}layers.1.self_attn."
+    trellis = fixture.st_read(_file(directory, 1), prefix + "o_proj.trellis")
+    assert np.array_equal(
+        kda.o_proj.exl3_weights[0].trellis.numpy(), trellis[rank * 8 : (rank + 1) * 8]
+    )
+    trellis = fixture.st_read(_file(directory, 1), prefix + "q_proj.trellis")
+    fused = kda.in_proj_qkvgfab
+    assert np.array_equal(
+        fused.exl3_weights[0].trellis.numpy(), trellis[:, rank * 8 : (rank + 1) * 8]
+    )
+    svh = fixture.st_read(directory / "head.safetensors", fixture.ROOT + "lm_head.svh")
+    assert np.array_equal(
+        _bits(model.lm_head.exl3_weights[0].svh),
+        svh[rank * 256 : (rank + 1) * 256].view(np.uint16),
+    )
+    # The fused in-projection's plain members: f_a whole on every rank, b by heads.
+    f_a = fixture.st_read(_file(directory, 1), prefix + "f_a_proj.weight")
+    b = fixture.st_read(_file(directory, 1), prefix + "b_proj.weight")
+    assert fused.plain_weight.shape == (128 + 1, hidden)
+    assert np.array_equal(_bits(fused.plain_weight[:128]), f_a)
+    assert np.array_equal(_bits(fused.plain_weight[128:]), b[rank : rank + 1])
+    # A plain matrix behind a quantizable linear: cut by the stock weight loader.
+    f_b = fixture.st_read(_file(directory, 1), prefix + "f_b_proj.weight")
+    assert np.array_equal(_bits(kda.f_b_proj.weight), f_b[half])
+    # A_log is stored padded to 128 entries; the rank takes its own head.
+    a_log = fixture.st_read(_file(directory, 1), prefix + "A_log")
+    assert a_log.shape == (128,) and np.array_equal(
+        kda.A_log.detach().numpy(), a_log[rank : rank + 1]
+    )
+
