+def test_no_upstream_sparse_mla_follows_upstreams_gates(capability, expected):
+    """The predicate against the capability gates of upstream's own sparse
+    MLA candidates for that device (those whose module imports without a
+    GPU; a 10.x-only backend opens CUDA while it is imported)."""
+    from vllm.platforms import cuda
+    from vllm.platforms.interface import DeviceCapability
+    from vllm.sm80.platform import no_upstream_sparse_mla
+
+    cap = DeviceCapability(*capability)
+    assert no_upstream_sparse_mla(cap) is expected
+    sparse, unimportable = [], []
+    for backend in cuda._get_backend_priorities(True, cap, 48, None, False, 576):
+        try:
+            backend_cls = backend.get_class()
+        except (ImportError, OSError, RuntimeError, AssertionError):
+            # Only a sparse candidate that cannot be asked matters here.
+            if "SPARSE" in backend.name:
+                unimportable.append(backend.name)
+            continue
+        if backend_cls.is_sparse():
+            sparse.append(backend_cls)
+    accepted = [b.get_name() for b in sparse if b.supports_compute_capability(cap)]
+    if expected:
+        assert sparse and not unimportable, (sparse, unimportable)
+        assert not accepted, accepted
+    else:
+        assert accepted or unimportable, "no upstream sparse MLA backend here"
+
