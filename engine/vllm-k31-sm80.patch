+
+class World:
+    """One tmp directory with a built tree, a venv, a checkpoint and settings."""
+
+    def __init__(self, tmp, *, build: bool = True, **tree_kw) -> None:
+        self.tmp = str(tmp)
+        self.tree = make_tree(os.path.join(self.tmp, "tree"), **tree_kw)
+        if build:
+            add_build(self.tree)
+        self.venv = make_venv(os.path.join(self.tmp, "venv"))
+        self.models = os.path.join(self.tmp, "models")
+        self.cp = make_checkpoint(os.path.join(self.models, "synth-dense-1b"))
+        self.settings = make_settings(os.path.join(self.tmp, "settings"), commit=head(self.tree),
+                                      checkpoint_dir=self.cp)
+        self.stamps = os.path.join(self.tmp, "stamps")
+        self.home = os.path.join(self.tmp, "home")
+        os.makedirs(self.home, exist_ok=True)
+
+    def base_args(self, *extra: str, layout: str | None = "tp2") -> list[str]:
+        args = ["--runtime", "native", "--tree", self.tree, "--venv", self.venv,
+                "--settings", self.settings, "--models-dir", self.models,
+                "--stamp-dir", self.stamps]
+        if layout:
+            args += ["--layout", layout]
+        return args + list(extra)
+
+    def env(self, **extra: str) -> dict[str, str]:
+        e = {"HOME": self.home, "LANG": "C.UTF-8", "TERM": "xterm"}
+        e.update(extra)
+        return e
+
+    def resolve(self, *extra: str, layout: str | None = "tp2", environ: dict | None = None,
+                expect_code: int = 0) -> dict:
+        import main
+        out, err = io.StringIO(), io.StringIO()
+        with redirect_stdout(out), redirect_stderr(err):
+            code = main.main(self.base_args("--print-config", "--json", *extra, layout=layout),
+                             environ if environ is not None else self.env())
+        assert code == expect_code, (code, err.getvalue(), out.getvalue()[:2000])
+        return json.loads(out.getvalue()) if out.getvalue() else {"stderr": err.getvalue()}
+
+    def refused(self, *extra: str, layout: str | None = "tp2", environ: dict | None = None) -> str:
+        doc = self.resolve(*extra, layout=layout, environ=environ, expect_code=3)
+        assert doc.get("schema") == "launch-refusal/1", doc
+        return " | ".join(doc["reasons"])
+
+    def verify(self) -> int:
+        import checkpoint as ck
+        out = io.StringIO()
+        with redirect_stdout(out):
+            return ck.main(["verify", "--settings", self.settings, "--models-dir", self.models,
+                            "--stamp-dir", self.stamps])
+
+    def run(self, *extra: str, layout: str | None = "tp2", environ: dict | None = None,
+            python_flags: tuple[str, ...] = ("-I",)) -> subprocess.CompletedProcess:
+        """Run main.py as a real process (exec path)."""
+        return subprocess.run(
+            [sys.executable, *python_flags, os.path.join(LAUNCH, "main.py"),
+             *self.base_args(*extra, layout=layout)],
+            env=environ if environ is not None else self.env(), capture_output=True, text=True)
+
+
+# -- a minimal publisher, mirroring the receipt format (the release
+# -- publisher is the real writer; this one only gives the reader inputs) --
+
+def promote(world: World, layouts: list[str], *, generation: str | None = None,
+            docs: dict | None = None, gate: str = "gate-synth-1") -> dict:
+    """Write validated/<layout>.json files and receipt.json from resolved
+    launches. ``generation`` set: publish as validated.d/<gen>/ behind the
+    validated symlink; otherwise into a plain validated/ directory."""
+    from canon import sha256_bytes
+    docs = docs or {L: world.resolve(layout=L) for L in layouts}
+    any_doc = next(iter(docs.values()))
+    et = any_doc["engine_target"]
+    pins = {}
+    with open(os.path.join(world.settings, "pins.env")) as f:
+        for line in f:
+            if "=" in line and not line.startswith("#"):
+                k, v = line.strip().split("=", 1)
+                if k != "ENGINE_IMAGE":
+                    pins[k] = v
+    files: dict[str, bytes] = {}
+    entries = {}
+    for L, d in docs.items():
+        vf = {
+            "schema": "validated-launch/1", "model": d["model"], "layout": L,
+            "argv_functional": d["argv_functional"], "env_functional": d["env_functional"],
+            "functional_sha256": d["functional_sha256"], "engine_commit": et["commit"],
+            "requires": d["requires"],
+            "checkpoints": {n: c["manifest_sha256"] for n, c in d["checkpoint"].items()},
+            "gate_record": gate,
+        }
+        raw = json.dumps(vf, indent=1, sort_keys=True).encode() + b"\n"
+        files[f"{L}.json"] = raw
+        entries[L] = {"validated_sha256": sha256_bytes(raw),
+                      "functional_sha256": d["functional_sha256"], "gate_record": gate,
+                      "verdict_revision": "rev-1", "gate_revision": "grev-1",
+                      "requires": d["requires"]}
+    receipt = {
+        "schema": "validation-receipt/1", "model": any_doc["model"], "layouts": entries,
+        "pins": pins,
+        "engines": [{"commit": et["commit"], "role": "validated",
+                     "native_manifest_sha256": et["build_owned"]["native_manifest_sha256"],
+                     "build_owned_sha256": et["build_owned"]["build_owned_sha256"]}],
+        "checkpoints": {n: {"repo": c["repo"], "revision": c["revision"],
+                            "manifest_sha256": c["manifest_sha256"]}
+                        for n, c in any_doc["checkpoint"].items()},
+        "promoted_at": "2026-01-01T00:00:00Z", "user_yes": "test", "promoter_commit": "0" * 40,
+    }
+    files["receipt.json"] = json.dumps(receipt, indent=1, sort_keys=True).encode() + b"\n"
+    publish(world.settings, files, generation)
+    return receipt
+
+
+def publish(settings: str, files: dict[str, bytes], generation: str | None,
+            pause_before_rename=None) -> None:
+    pointer = os.path.join(settings, "validated")
+    if generation is None:
+        if os.path.islink(pointer):
+            os.unlink(pointer)
+        shutil.rmtree(pointer, ignore_errors=True)
+        os.makedirs(pointer)
+        target = pointer
+    else:
+        target = os.path.join(settings, "validated.d", generation)
+        os.makedirs(target)
+    for name, raw in files.items():
+        with open(os.path.join(target, name), "wb") as f:
+            f.write(raw)
+    if generation is not None:
+        tmp = os.path.join(settings, "validated.new")
+        os.symlink(os.path.join("validated.d", generation), tmp)
+        if pause_before_rename is not None:
+            pause_before_rename()
+        if os.path.isdir(pointer) and not os.path.islink(pointer):
+            shutil.rmtree(pointer)
+        os.replace(tmp, pointer)
