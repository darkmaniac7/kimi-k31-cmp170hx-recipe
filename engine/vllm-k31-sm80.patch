+def test_without_split_the_slot_hands_its_drafts_to_post_update(monkeypatch):
+    h, _ = _handler(monkeypatch, split=False)
+    slot = _slot([3], [[7, 8, 9]], split=False)
+    _queue(h, slot)
+    out = h.get_prev_sampled_outputs()
+    assert out["draft_tokens"] is slot.draft_tokens
+    assert not h.has_pending_drafts()
+
