+    dev = torch.device(device)
+    fn = torch.zeros(N, K, dtype=torch.float32, device=dev)
+    for M in ms:
+        hc_prenorm_gemm(torch.zeros(M, K, dtype=torch.bfloat16, device=dev), fn)
+    torch.cuda.synchronize()
