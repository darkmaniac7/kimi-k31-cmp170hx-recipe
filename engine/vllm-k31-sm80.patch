+def test_gpu_k31_p2p_loopback_allreduce_and_moe_dual():
+    """Real CUDA loopback check through vllm._k31_p2p_C (skipped on CPU)."""
+    if not torch.cuda.is_available():
+        pytest.skip("requires CUDA device")
+    from vllm.sm80.kernels.k31q import p2p, p2p_ops
+
