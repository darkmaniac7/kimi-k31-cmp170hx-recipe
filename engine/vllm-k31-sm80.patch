+def _run_composite_layer1(mini: Path) -> dict[str, Any]:
+    from vllm.model_executor.layers.fused_moe.router import grouped_topk_router as gtr
+    from vllm.model_executor.layers.mamba.ops.causal_conv1d import causal_conv1d_update
+    import importlib; ar_mod = importlib.import_module('vllm.models.kimi_k3.nvidia.ops.attn_res')
+    from vllm.models.kimi_k3.nvidia.ops.third_party.kda import (
+        fused_recurrent_kda_packed_decode,
+    )
+    from vllm.sm80.kernels.exl3.utils import Exl3LoadLedger
