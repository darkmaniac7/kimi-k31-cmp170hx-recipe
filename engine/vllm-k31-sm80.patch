+            assert maxima[i] <= storage.numel() < 2 * maxima[i]
+            assert view.data_ptr() == storage.data_ptr()
+            if previous[i] is not None and previous[i].numel() >= view.numel():
+                assert storage is previous[i]
+            live[id(storage)] = weakref.ref(storage)
