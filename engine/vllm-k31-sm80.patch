+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Routed experts of a tiny k31q checkpoint on the CPU.
+
+VQ layers: the reference path decodes the canonical records to exactly the
+FP32 matrices the checkpoint was written from, and its MoE output equals a
+float64 hand computation of
+    sum over slots of weight * W2 @ (SituAndMul(W1 @ x, W3 @ x))
+on random inputs, per tensor-parallel rank and summed over the ranks.
+EXL3 layers: the pointer and meta tables address the bytes of the right file
+slices (read back through the pointers), and the kernel object launches the
+decode or the prefill operator once per part with the buffers it should
+(the operators themselves need a GPU and are replaced by recorders here).
+"""
+
+import ctypes
+
+import numpy as np
+import pytest
+import torch
+
+from tests.models.kimi_k3.sm80 import construct
+from tests.models.kimi_k3.sm80 import k31q_fixture as fixture
+
+TEXT = fixture.TEXT
+EXPERTS, TOPK = TEXT["num_experts"], TEXT["num_experts_per_token"]
+LATENT, INTER = TEXT["routed_expert_hidden_size"], TEXT["moe_intermediate_size"]
+BETA, LINEAR_BETA = 4.0, 25.0
+VQ_LAYER = 2
+EXL3_LAYER = fixture.EXL3_EXPERT_LAYERS[0]
+TINY_KERNEL = (LATENT, 256)
+
+
+@pytest.fixture(scope="module")
+def checkpoint(tmp_path_factory):
+    directory = tmp_path_factory.mktemp("k31q")
+    return directory, fixture.write_checkpoint(directory)
+
+
+def _routed(model, layer):
+    return model.model.layers[layer].block_sparse_moe.experts.routed_experts
+
+
+def _base(layer):
+    return f"{fixture.P}layers.{layer}.block_sparse_moe.experts"
+
+
+def _columns(rank, layer, tp):
+    blocks = INTER // 128
+    chunk = (rank + layer) % tp
+    return slice(128 * (chunk * blocks // tp), 128 * ((chunk + 1) * blocks // tp))
+
+
+def _inputs(rows, seed=0):
+    generator = torch.Generator().manual_seed(seed)
+    x = (torch.randn((rows, LATENT), generator=generator) * 4).to(torch.bfloat16)
+    ids = torch.stack(
+        [torch.randperm(EXPERTS, generator=generator)[:TOPK] for _ in range(rows)]
+    ).to(torch.int32)
+    weights = torch.rand((rows, TOPK), generator=generator)
+    weights = (weights / weights.sum(-1, keepdim=True)).to(torch.float32)
+    # Masked slots and one fully masked row, as the row mask produces them.
+    ids[1, 0] = -1
+    ids[rows - 1] = -1
+    return x, ids, weights
+
+
+def _hand(reference, layer, x, ids, weights, columns=slice(None), skip=()):
+    """The MoE definition in float64 from the checkpoint's reference matrices."""
+    x = x.to(torch.float64).numpy()
+    out = np.zeros((x.shape[0], LATENT))
+    for row in range(x.shape[0]):
+        for slot in range(ids.shape[1]):
+            expert = int(ids[row, slot])
+            if expert < 0 or expert in skip:
+                continue
+            w1, w3, w2 = (
+                reference[f"{_base(layer)}.{w}.{expert}"].astype(np.float64)
+                for w in ("w1", "w3", "w2")
+            )
+            gate, up = w1[columns] @ x[row], w3[columns] @ x[row]
+            gate = BETA * np.tanh(gate / BETA) / (1.0 + np.exp(-gate))
+            up = LINEAR_BETA * np.tanh(up / LINEAR_BETA)
+            out[row] += float(weights[row, slot]) * (w2[:, columns] @ (gate * up))
+    return out
+
+
+def _apply(kernel, x, ids, weights, expert_map=None):
+    """Call a kernel object as the modular MoE kernel does."""
+    rows = x.shape[0]
+    _, shape2, out_shape = kernel.workspace_shapes(
+        rows, 0, LATENT, TOPK, EXPERTS, EXPERTS, None, None
+    )
+    output = torch.empty(out_shape, dtype=torch.bfloat16)
+    workspace2 = torch.empty(shape2, dtype=torch.bfloat16)
+    kernel.apply(
+        output=output,
+        hidden_states=x,
+        w1=None,
+        w2=None,
+        topk_weights=weights,
+        topk_ids=ids,
+        activation=None,
+        global_num_experts=EXPERTS,
+        expert_map=expert_map,
+        a1q_scale=None,
+        a2_scale=None,
+        workspace13=None,
+        workspace2=workspace2,
+        expert_tokens_meta=None,
+        apply_router_weight_on_input=False,
+    )
+    return output, workspace2
+
+
+def test_situ_and_mul_is_the_model_activation(default_vllm_config):
+    from vllm.sm80.kernels.k31q.moe import situ_and_mul
+
+    generator = torch.Generator().manual_seed(3)
+    gate = torch.randn((64, 96), generator=generator) * 12
+    up = torch.randn((64, 96), generator=generator) * 40
+    want = (BETA * torch.tanh(gate.double() / BETA) * torch.sigmoid(gate.double())) * (
+        LINEAR_BETA * torch.tanh(up.double() / LINEAR_BETA)
+    )
+    got = situ_and_mul(gate, up, BETA, LINEAR_BETA)
+    assert torch.allclose(got.double(), want, rtol=1e-5, atol=1e-6)
+    assert (up.abs() > LINEAR_BETA).any() and got.abs().max() <= BETA * LINEAR_BETA
+    unclipped = situ_and_mul(gate, up, BETA, None)
+    assert torch.allclose(
+        unclipped.double(),
+        BETA
+        * torch.tanh(gate.double() / BETA)
+        * torch.sigmoid(gate.double())
+        * up.double(),
+        rtol=1e-5,
+        atol=1e-6,
+    )
+    # The same function as the model's SituAndMul layer on [gate | up].
+    from vllm.model_executor.layers.activation import SituAndMul
+
+    layer = SituAndMul(BETA, LINEAR_BETA, compile_native=False)
+    assert torch.equal(layer.forward_native(torch.cat([gate, up], -1)), got)
+
+
+def test_vq_reference_path(monkeypatch, meta_platform, checkpoint):
+    from vllm.sm80.kernels.k31q.moe import K31VqReferenceExperts
+
+    directory, reference = checkpoint
+    x, ids, weights = _inputs(6)
+    partials = {}
+    for tp, rank in ((1, 0), (2, 0), (2, 1)):
+        model, _, _, _ = construct.build_and_load(
+            monkeypatch, directory, tp_size=tp, tp_rank=rank
+        )
+        for layer in (1, VQ_LAYER, 3, 4):  # three rates
+            routed = _routed(model, layer)
+            experts = routed.k31_experts
+            columns = _columns(rank, layer, tp)
+            assert experts.columns == columns
+            # Exact: every expert matrix of this rank's cut, all experts at once.
+            for w, role in fixture.PROJECTIONS:
+                got = experts.dequant(w).numpy()
+                assert got.dtype == np.float32
+                for expert in range(EXPERTS):
+                    want = reference[f"{_base(layer)}.{w}.{expert}"]
+                    want = want[columns] if role == "in_latent" else want[:, columns]
+                    assert np.array_equal(got[expert], want)
+            kernel = routed.quant_method.reference_experts(routed)
+            assert type(kernel) is K31VqReferenceExperts
+            assert (kernel.situ_beta, kernel.situ_linear_beta) == (BETA, LINEAR_BETA)
+            out = kernel.forward_fp32(x, ids, weights)
+            hand = _hand(reference, layer, x, ids, weights, columns)
+            assert np.abs(hand).max() > 1e-3
+            # FP32 sums of up to 512 products against float64: the absolute
+            # bound is the single-precision rounding of those sums.
+            assert np.allclose(out.double().numpy(), hand, rtol=2e-5, atol=5e-6)
+            assert not out[-1].any()  # the fully masked row
+            partials[tp, rank, layer] = out
+            # apply() rounds the FP32 sum once, to the output dtype.
+            output, _ = _apply(kernel, x, ids, weights)
+            assert torch.equal(output, out.to(torch.bfloat16))
+            # An expert the map sends to -1 is skipped.
+            expert_map = torch.arange(EXPERTS, dtype=torch.int32)
+            expert_map[int(ids[0, 0])] = -1
+            masked = kernel.forward_fp32(x, ids, weights, expert_map)
+            hand = _hand(
+                reference, layer, x, ids, weights, columns, skip={int(ids[0, 0])}
+            )
+            assert np.allclose(masked.double().numpy(), hand, rtol=2e-5, atol=5e-6)
+    # The ranks' partial outputs sum to the whole (the MoE's all-reduce).
+    for layer in (1, VQ_LAYER, 3, 4):
+        whole = partials[1, 0, layer]
+        summed = partials[2, 0, layer] + partials[2, 1, layer]
+        assert torch.allclose(summed, whole, rtol=1e-4, atol=1e-6)
+        assert partials[2, 0, layer].abs().max() > 1e-3
+
+
+def test_vq_reference_through_the_modular_kernel(
+    monkeypatch, meta_platform, checkpoint
+):
+    """The seam the model uses: RoutedExperts.quant_method.apply through
+    upstream's FusedMoEKernel and its prepare/finalize, with the reference
+    experts behind it."""
+    from vllm.config import set_current_vllm_config
+    from vllm.sm80.kernels.k31q.moe import K31VqReferenceExperts
+    from vllm.v1.worker import workspace
+
+    directory, reference = checkpoint
+    model, config, _, _ = construct.build_and_load(monkeypatch, directory)
+    routed = _routed(model, VQ_LAYER)
+    method = routed.quant_method
+    assert method.backend == "reference" and method.native is None
+    x, ids, weights = _inputs(6)
+    monkeypatch.setattr(workspace, "_manager", None)
+    with set_current_vllm_config(config):
+        method.process_weights_after_loading(routed)
+        kernel = method.moe_kernel.fused_experts
+        assert type(kernel) is K31VqReferenceExperts and not method.is_monolithic
+        workspace.init_workspace_manager(torch.device("cpu"))
+        out = method.apply(routed, x, weights, ids, None, None)
+    assert out.shape == (6, LATENT) and out.dtype == torch.bfloat16
+    assert torch.equal(out, kernel.forward_fp32(x, ids, weights).to(torch.bfloat16))
+    hand = _hand(reference, VQ_LAYER, x, ids, weights)
+    # BF16 keeps 8 significant bits.
+    assert np.allclose(out.double().numpy(), hand, rtol=2**-7, atol=1e-4)
+
+
+def _recorders(monkeypatch):
+    """Replace the K3.1 EXL3 operators and size calls by recorders."""
+    from vllm.sm80.kernels.exl3 import ops
+
+    calls = []
+
+    def operator(name):
+        def run(
+            x,
+            ids,
+            weights,
+            pointers,
+            metadata,
+            expert_map,
+            intermediate,
+            out,
+            workspace,
+            **kw,
+        ):
+            calls.append(
+                dict(
+                    name=name,
+                    pointers=pointers,
+                    metadata=metadata,
+                    intermediate=intermediate,
+                    out=out.data_ptr(),
+                    workspace=workspace,
+                    expert_map=expert_map,
+                    **kw,
+                )
+            )
+            out.fill_(float(len(calls)))
+
+        return run
+
+    monkeypatch.setattr(ops, "moe_out_k31", operator("decode"))
+    monkeypatch.setattr(ops, "moe_out_prefill_k31", operator("prefill"))
+    monkeypatch.setattr(
+        ops, "moe_workspace_size_k31", lambda rows, h, i, k, e: 1000 + rows
+    )
+    monkeypatch.setattr(
+        ops, "moe_workspace_size_prefill_k31", lambda rows, h, i, k, e: 5000 + rows
+    )
+    return calls
+
+
+def _at(address, dtype, shape):
+    count = int(np.prod(shape)) * np.dtype(dtype).itemsize
+    return np.frombuffer(ctypes.string_at(address, count), dtype=dtype).reshape(shape)
+
+
+def _check_tables(directory, experts, part, pointers, metadata, bits_x2):
+    """Every address of a part's tables holds the bytes of the file slice it names."""
+    columns = experts.parts[part]
+    cut = slice(columns.start // 16, columns.stop // 16)
+    width = columns.stop - columns.start
+    assert pointers.shape == (EXPERTS, 3, 3) and pointers.dtype == torch.int64
+    assert metadata.shape == (EXPERTS, 3, 4) and metadata.dtype == torch.int64
+    path = directory / f"layer-{EXL3_LAYER:03d}.safetensors"
+    for expert in range(EXPERTS):
+        for slot, (w, role) in enumerate(fixture.PROJECTIONS):
+            name = f"{_base(EXL3_LAYER)}.{expert}.{w}"
+            trellis, suh, svh = (
+                fixture.st_read(path, f"{name}.{s}") for s in ("trellis", "suh", "svh")
+            )
+            if role == "in_latent":  # gate, up: every input, the part's outputs
+                k, n = LATENT, width
+                trellis, svh = trellis[:, cut], svh[columns]
+            else:  # down: the part's inputs, every output
+                k, n = width, LATENT
+                trellis, suh = trellis[cut], suh[columns]
+            assert metadata[expert, slot].tolist() == [k, n, bits_x2, 2]
+            t_ptr, h_ptr, v_ptr = pointers[expert, slot].tolist()
+            assert t_ptr % 16 == 0
+            assert np.array_equal(
+                _at(t_ptr, np.int16, (k // 16, n // 16, 8 * bits_x2)), trellis
+            )
+            assert np.array_equal(_at(h_ptr, np.uint16, (k,)), suh.view(np.uint16))
+            assert np.array_equal(_at(v_ptr, np.uint16, (n,)), svh.view(np.uint16))
+
+
+def test_exl3_tables_and_two_part_launches(monkeypatch, meta_platform, checkpoint):
+    """Tensor parallel size 1: the rank holds twice the kernel intermediate,
+    as two parts with a table set each and two launches whose partials add."""
+    from vllm.sm80.kernels.k31q import moe
+
+    directory, _ = checkpoint
+    monkeypatch.setattr(moe, "K31_KERNEL_SHAPE", TINY_KERNEL)
+    calls = _recorders(monkeypatch)
+    model, _, _, _ = construct.build_and_load(monkeypatch, directory)
+    routed = _routed(model, EXL3_LAYER)
+    experts = routed.k31_experts
+    assert experts.parts == [slice(0, 256), slice(256, 512)]
+    assert experts.exl3_kernel_closed_reason() is None
+    bits_x2 = 2 * fixture.EXL3_EXPERT_BITS
+
+    kernel = routed.quant_method.build_kernel(routed, max_rows=600)
+    decode_rows = moe.K31_MAX_ASSIGNMENTS // TOPK
+    assert kernel.workspace_elements == max(1000 + decode_rows, 5000 + 600)
+    assert kernel.part_intermediate == 256 and len(kernel.tables) == 2
+    for part, (pointers, metadata) in enumerate(kernel.tables):
+        assert pointers is getattr(routed, f"k31_ptrs_{part}")
+        _check_tables(directory, experts, part, pointers, metadata, bits_x2)
+    assert routed.k31_expert_map.tolist() == list(range(EXPERTS))
+    w1, w2 = routed.quant_method._weights(routed)
+    assert w1.shape[0] == EXPERTS and w2.shape[0] == EXPERTS
+
+    for rows, name in (
+        (5, "decode"),
+        (decode_rows, "decode"),
+        (decode_rows + 1, "prefill"),
+    ):
+        calls.clear()
+        x, ids, weights = _inputs(rows)
+        output, workspace2 = _apply(kernel, x, ids, weights)
+        assert workspace2.numel() == 2 * kernel.workspace_elements + rows * LATENT
+        assert [call["name"] for call in calls] == [name, name]
+        first, second = calls
+        assert first["out"] == output.data_ptr()
+        # The second part writes its own partial, behind the operator's workspace.
+        assert (
+            second["out"] == workspace2.data_ptr() + 2 * 2 * kernel.workspace_elements
+        )
+        for part, call in enumerate(calls):
+            assert call["pointers"] is kernel.tables[part][0]
+            assert call["metadata"] is kernel.tables[part][1]
+            assert call["intermediate"] == 256
+            assert call["workspace"].dtype == torch.float32
+            assert call["workspace"].numel() == kernel.workspace_elements
+            assert call["workspace"].data_ptr() == workspace2.data_ptr()
+            assert call["expert_map"] is routed.k31_expert_map
+            assert (
+                call["situ_beta"],
+                call["situ_linear_beta"],
+                call["swiglu_limit"],
+            ) == (
+                BETA,
+                LINEAR_BETA,
+                0.0,
+            )
+        # Recorder k fills its output with k + 1: the partials were added.
+        assert torch.equal(output, torch.full_like(output, 3.0))
+    with pytest.raises(ValueError, match="row capacity"):
+        _apply(kernel, *_inputs(601))
+    calls.clear()
+    _apply(kernel, *(t[:0] for t in _inputs(4)))
+    assert calls == []
+    # A smaller configured batch needs only the decode operator's workspace.
+    assert (
+        routed.quant_method.build_kernel(routed, max_rows=8).workspace_elements == 1008
+    )
+
+
+@pytest.mark.parametrize("rank", [0, 1])
+def test_exl3_tables_at_tp2(monkeypatch, meta_platform, checkpoint, rank):
+    from vllm.sm80.kernels.k31q import moe
+
+    directory, _ = checkpoint
+    monkeypatch.setattr(moe, "K31_KERNEL_SHAPE", TINY_KERNEL)
+    calls = _recorders(monkeypatch)
+    model, _, _, _ = construct.build_and_load(
+        monkeypatch, directory, tp_size=2, tp_rank=rank
+    )
+    routed = _routed(model, EXL3_LAYER)
+    experts = routed.k31_experts
+    assert experts.parts == [_columns(rank, EXL3_LAYER, 2)]
+    kernel = routed.quant_method.build_kernel(routed, max_rows=64)
+    (tables,) = kernel.tables
+    _check_tables(directory, experts, 0, *tables, 2 * fixture.EXL3_EXPERT_BITS)
+    x, ids, weights = _inputs(4)
+    output, workspace2 = _apply(kernel, x, ids, weights)
+    assert workspace2.numel() == 2 * kernel.workspace_elements
+    assert [call["name"] for call in calls] == ["decode"]
+    assert torch.equal(output, torch.full_like(output, 1.0))
+
