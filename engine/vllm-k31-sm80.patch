+    out = torch.empty_like(x)
+    workspace = torch.empty(
+        exl3_ops.moe_workspace_size_v2(
+            rows, h5120.HIDDEN, h5120.INTERMEDIATE, h5120.TOPK, h5120.LOCAL
+        ),
