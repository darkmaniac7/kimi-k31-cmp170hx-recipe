--- /dev/null
+++ b/vllm/sm80/spec_decode/dspark_width.py
@@ -0,0 +1,305 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""DSpark query blocks at the scheduler's or worker's speculative width."""
+
+import inspect
+import os
+from functools import cache
+
+import numpy as np
+import torch
+
+import vllm.envs as envs
+from vllm.config import VllmConfig
+from vllm.logger import init_logger
+from vllm.v1.spec_decode.dynamic.utils import build_dynamic_sd_schedule_lookup
+from vllm.v1.worker.gpu.spec_decode.dspark.speculator import DSparkSpeculator
+
+logger = init_logger(__name__)
+
+ENV_PER_K_WIDTHS = "VLLM_DSPARK_PER_K_WIDTHS"
+ENV_PER_K_WORKER_NARROW = "VLLM_DSPARK_PER_K_WORKER_NARROW"
+
+
+def _parse_explicit_widths(max_width: int) -> tuple[int, ...] | None:
+    raw = os.environ.get(ENV_PER_K_WIDTHS, "").strip()
+    if not raw:
+        return None
+    parsed: set[int] = {int(max_width)}
+    for part in raw.split(","):
+        tok = part.strip()
+        if not tok:
+            continue
+        w = int(tok)
+        if w <= 0 or w > max_width:
+            raise ValueError(
+                f"{ENV_PER_K_WIDTHS}={raw!r} contains width {w} outside "
+                f"[1, {max_width}]."
+            )
+        parsed.add(w)
+    return tuple(sorted(parsed))
+
+
+def _confidence_tier_widths(adaptive, max_width: int) -> tuple[int, ...]:
+    """Compact query graph widths for host confidence-tier scheduling.
+
+    Aligns with PipeSpec half-epoch lookahead ``2 * ck + 1`` (``7`` for
+    ``ck=3``, ``9`` for ``ck=4``, ``11`` for ``ck=5``) plus ``5`` for
+    low-confidence prose steps (``k_verified <= 2`` or non-PipeSpec ``<= 3``),
+    keeping CUDA graph count compact while avoiding full-width ``K=11``
+    drafting on narrow steps.
+    """
+    if max_width >= 7:
+        cands = {w for w in (5, 7, 9, max_width) if 0 < w <= max_width}
+        return tuple(sorted(cands))
+    tiers = getattr(adaptive, "tiers", ()) or ()
+    cands = {int(t) for t in tiers if 0 < int(t) <= max_width}
+    cands.add(int(max_width))
+    return tuple(sorted(cands))
+
+
+def draft_widths(vllm_config: VllmConfig) -> tuple[int, ...]:
+    spec = vllm_config.speculative_config
+    assert spec is not None
+    max_width = int(spec.num_speculative_tokens)
+    explicit = _parse_explicit_widths(max_width)
+    if explicit is not None:
+        return explicit
+
+    widths = {max_width}
+    if spec.uses_dynamic_speculative_decoding():
+        widths.update(
+            build_dynamic_sd_schedule_lookup(
+                spec.num_speculative_tokens_per_batch_size,
+                vllm_config.scheduler_config.max_num_seqs,
+                max_width,
+            )[1:]
+        )
+    adaptive = spec.adaptive_k_config
+    if adaptive is not None:
+        if adaptive.draft_by_load:
+            widths.update(adaptive.allowed)
+        elif getattr(adaptive, "confidence", None) is not None:
+            widths.update(_confidence_tier_widths(adaptive, max_width))
+    # Zero means context-KV only, not a query block (draft_context_only).
+    return tuple(sorted(w for w in widths if w > 0))
+
+
+def _wants_worker_tier_narrowing(vllm_config: VllmConfig, max_width: int) -> bool:
+    raw = os.environ.get(ENV_PER_K_WORKER_NARROW, "").strip().lower()
+    if raw in ("0", "false", "no", "off"):
+        return False
+    if raw in ("1", "true", "yes", "on"):
+        return True
+    spec = getattr(vllm_config, "speculative_config", None)
+    if spec is None:
+        return False
+    adaptive = getattr(spec, "adaptive_k_config", None)
+    if adaptive is not None and not adaptive.draft_by_load:
+        if getattr(adaptive, "confidence", None) is not None:
+            return True
+    if _parse_explicit_widths(max_width) is not None:
+        if not spec.uses_dynamic_speculative_decoding() and not (
+            adaptive is not None and adaptive.draft_by_load
+        ):
+            return True
+    return False
+
+
+def create_dspark_speculator(
+    vllm_config: VllmConfig, device: torch.device
+) -> DSparkSpeculator:
+    if envs.VLLM_DSPARK_ADAPTIVE_DEPTH and envs.VLLM_DSPARK_CONFIDENCE_DUMP:
+        # The dump would record the drafts the mask cut as rejected by the target.
+        raise ValueError(
+            "VLLM_DSPARK_ADAPTIVE_DEPTH and VLLM_DSPARK_CONFIDENCE_DUMP cannot be "
+            "set together: the dump would label drafts the mask cut as rejected."
+        )
+    return wrap_dspark_speculator_cls(DSparkSpeculator)(vllm_config, device)
+
+
+def wrap_dspark_speculator_cls(
+    cls: type[DSparkSpeculator],
+) -> type[DSparkSpeculator]:
+    """The DSpark speculator class with the fork's switches applied; ``cls``
+    itself when they are all off. Called by the speculator factory
+    (``vllm/v1/worker/gpu/spec_decode/__init__.py``) with the class upstream
+    resolved for the configured speculator."""
+    if envs.VLLM_DSPARK_ADAPTIVE_DEPTH and envs.VLLM_DSPARK_CONFIDENCE_DUMP:
+        # The dump would record the drafts the mask cut as rejected by the target.
+        raise ValueError(
+            "VLLM_DSPARK_ADAPTIVE_DEPTH and VLLM_DSPARK_CONFIDENCE_DUMP cannot be "
+            "set together: the dump would label drafts the mask cut as rejected."
+        )
+    if envs.VLLM_DSPARK_PER_K_WIDTH:
+        if cls is not DSparkSpeculator:
+            raise ValueError(
+                "VLLM_DSPARK_PER_K_WIDTH needs the stock DSparkSpeculator, got "
+                f"{cls.__qualname__}."
+            )
+        cls = PerKDSparkSpeculator
+    if envs.VLLM_DSPARK_SUFFIX_HYBRID:
+        from vllm.sm80.spec_decode.dspark_suffix_hybrid import suffix_hybrid_class
+
+        cls = suffix_hybrid_class(cls)
+    if envs.VLLM_DSPARK_CONFIDENCE_DUMP:
+        from vllm.sm80.spec_decode.dspark_confidence import confidence_dump_class
+
+        cls = confidence_dump_class(cls)
+    if envs.VLLM_DSPARK_ADAPTIVE_DEPTH:
+        from vllm.sm80.spec_decode.dspark_row_mask_conf import row_mask_class
+
+        cls = row_mask_class(cls)
+    return cls
+
+
+@cache
+def _propose_sig() -> inspect.Signature:
+    from vllm.v1.worker.gpu.spec_decode.dflash.speculator import DFlashSpeculator
+
+    return inspect.signature(DFlashSpeculator.propose)
+
+
+class PerKDSparkSpeculator(DSparkSpeculator):
+    """Reuse DFlash's per-width graphs/views with DSpark's anchor layout.
+
+    The maximum-width logits cache retains its request/column strides: the
+    rejection sampler owns that tensor across width changes. Only the proposal
+    buffer is packed, as in DFlash. When host confidence-tier scheduling keeps
+    ``num_spec_tokens_to_schedule == max_width`` (``draft_by_load=False``),
+    :meth:`propose` selects the smallest captured query width that covers both
+    Adaptive-K tier climb headroom and PipeSpec ``2 * ck + 1`` lookahead,
+    padding trailing columns with ``-1`` / ``-1.0`` so downstream PP broadcast,
+    PipeSpec ``b_valid_prob``, and ``SuffixHybrid`` stay synchronized.
+    """
+
+    def __init__(self, vllm_config: VllmConfig, device: torch.device):
+        spec = vllm_config.speculative_config
+        assert spec is not None
+        if not getattr(spec.draft_model_config.hf_config, "sample_from_anchor", True):
+            raise ValueError(
+                "VLLM_DSPARK_PER_K_WIDTH requires sample_from_anchor=True; "
+                "fill-in graph descriptors are not restricted to the selected width"
+            )
+        super().__init__(vllm_config, device)
+        self._anchor_indices_by_width = {self.max_width: self._anchor_idx}
+        self._confidence_by_width = {
+            self.max_width: self.draft_token_confidence_probs
+        }
+        widths = draft_widths(vllm_config)
+        self.enable_draft_widths(widths)
+        self._worker_tier_narrowing = _wants_worker_tier_narrowing(
+            vllm_config, self.max_width
+        )
+        if len(self.widths) > 1:
+            logger.info(
+                "PerKDSparkSpeculator active: widths=%s, worker_tier_narrowing=%s",
+                self.widths,
+                self._worker_tier_narrowing,
+            )
+
+    def enable_draft_widths(self, widths) -> None:
+        super().enable_draft_widths(widths)
+        full_confidence = self._confidence_by_width[self.max_width]
+        anchor_extra = self.num_query_per_req - self.width
+        for width in self.widths:
+            self._draft_token_views[width] = self._full_draft_tokens[:, :width]
+            if width in self._anchor_indices_by_width:
+                continue
+            self._anchor_indices_by_width[width] = (
+                torch.arange(self.max_num_reqs, dtype=torch.int64, device=self.device)
+                * (width + anchor_extra)
+            )
+            self._confidence_by_width[width] = full_confidence[:, :width]
+
+    def _on_width(self, width: int) -> None:
+        # Persistent tensors are selected, not rewritten: each captured graph
+        # keeps its own immutable anchors through arbitrary width transitions.
+        self._anchor_idx = self._anchor_indices_by_width[width]
+
+    def _snap_up_width(self, needed: int) -> int:
+        for w in self.widths:
+            if w >= needed:
+                return w
+        return self.max_width
+
+    def _select_worker_width(
+        self, input_batch, num_speculative_tokens: int | None
+    ) -> tuple[int | None, bool]:
+        if (
+            not self._worker_tier_narrowing
+            or num_speculative_tokens is None
+            or num_speculative_tokens != self.max_width
+            or len(self.widths) <= 1
+        ):
+            return num_speculative_tokens, False
+
+        num_reqs = int(getattr(input_batch, "num_reqs", 0))
+        num_draft = int(getattr(input_batch, "num_draft_tokens", 0))
+        if num_reqs <= 0 or num_draft <= 0:
+            # Prefill step: draft full max_width so the initial decode step has
+            # complete drafts and confidences.
+            return self.max_width, False
+
+        cu_np = getattr(input_batch, "cu_num_logits_np", None)
+        if cu_np is not None and len(cu_np) > 1:
+            k_verified = int(np.max(np.diff(cu_np))) - 1
+        else:
+            k_verified = num_draft // num_reqs
+
+        if k_verified <= 0:
+            return self.max_width, False
+
+        pipespec_on = os.environ.get("VLLM_K31_PIPESPEC", "").strip().lower() in (
+            "1",
+            "true",
+            "yes",
+            "on",
+        )
+        # +2 headroom allows Adaptive-K to climb smoothly without scheduling
+        # unpopulated trailing draft slots; single-stream PipeSpec additionally
+        # reserves 2*ck + 1 tokens once k_verified reaches ck >= 3.
+        needed = k_verified + 2
+        if pipespec_on and num_reqs == 1 and k_verified >= 3:
+            needed = max(needed, min(self.max_width, 2 * k_verified + 1))
+
+        chosen = self._snap_up_width(needed)
+        return chosen, chosen < self.max_width
+
+    def _sample_sequential(self, num_reqs: int, head_hidden: torch.Tensor) -> None:
+        # The head writes a (requests, K) block. Publish the original maximum
+        # width to AdaptiveVerificationManager and attach_draft_confidences,
+        # clearing trailing columns to -1 / -1.0 when narrowed so stale drafts
+        # or confidences from a wider step never leak.
+        full_confidence = self.draft_token_confidence_probs
+        self.draft_token_confidence_probs = self._confidence_by_width[self.width]
+        try:
+            super()._sample_sequential(num_reqs, head_hidden)
+        finally:
+            self.draft_token_confidence_probs = full_confidence
+            if self.width < self.max_width and num_reqs > 0:
+                self._full_draft_tokens[:num_reqs, self.width :].fill_(-1)
+                if self.use_confidence_head:
+                    full_confidence[:num_reqs, self.width :].fill_(-1.0)
+
+    def propose(self, input_batch, *args, **kwargs):
+        bound = _propose_sig().bind(self, input_batch, *args, **kwargs)
+        arguments = bound.arguments
+        is_dummy_or_profile = bool(
+            arguments.get("dummy_run") or arguments.get("is_profile")
+        )
+        req_tokens = arguments.get("num_speculative_tokens")
+        padded_to_max = False
+        if not is_dummy_or_profile:
+            chosen_w, padded_to_max = self._select_worker_width(
+                input_batch, req_tokens
+            )
+            if padded_to_max:
+                arguments["num_speculative_tokens"] = chosen_w
+                out = super().propose(*bound.args[1:], **bound.kwargs)
+                is_ctx_only = bool(getattr(self, "context_kv_only", False))
+                self.set_width(self.max_width)
+                if not is_ctx_only:
+                    return self._full_draft_tokens[: input_batch.num_reqs]
+                return out
+        return super().propose(input_batch, *args, **kwargs)
