+
+# float8_e4m3fn: largest finite magnitude and its bit pattern.
+E4M3_MAX = 448.0
+_E4M3_MAX_CODE = 0x7E
+_E4M3_NAN_CODE = 0x7F
+# Scale bytes per cached key (one fp32).
+SCALE_BYTES = 4
+# Floors of the UE8M0 scales, as upstream's kernels (ops/dsa_indexer.py).
+_K_AMAX_FLOOR = 1e-4
+_Q_AMAX_FLOOR = 1e-10
