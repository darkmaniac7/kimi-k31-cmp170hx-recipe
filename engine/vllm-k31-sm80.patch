+def test_release_3_workspace_and_plain_invariant(dops):
+    """Release 3 checks: decode-only workspace sizing (R7.1) and bit-exact
+    row-count-invariant BF16 plain linear (single, multi, bias, odd N/K)."""
+    device = torch.device("cuda:0")
+    assert dops.build_info()["api_version"] == 4
+
+    # R7.1: decode-only sizing for max_rows <= 32 vs prefill for max_rows > 32.
+    dec_ws = dops.linear_workspace_size_k31(32, 16896, 7168, 1)
+    pre_ws = dops.linear_workspace_size_k31(2048, 16896, 7168, 1)
+    assert dec_ws < pre_ws // 8
+
+    torch.manual_seed(42)
+    # Single & multi-member bit identity + accuracy vs FP32 matmul (K=7168 and K=128).
+    for shape_name, n0, n1, k in (
+        ("kda_fab_tp2", 128, 48, 7168),
+        ("kda_fab_tp1", 128, 96, 7168),
+        ("kda_fb_tp2", 3072, 3072, 128),
+        ("odd_dims", 129, 17, 130),
+    ):
+        x = torch.randn((200, k), dtype=torch.bfloat16, device=device)
+        w0 = (torch.randn((n0, k), dtype=torch.bfloat16, device=device) * 0.02)
+        w1 = (torch.randn((n1, k), dtype=torch.bfloat16, device=device) * 0.02)
+        w_cat = torch.cat([w0, w1], dim=0).contiguous()
+        bias = (torch.randn((n0 + n1,), dtype=torch.bfloat16, device=device) * 0.01)
+
+        out_cat = torch.empty((200, n0 + n1), dtype=torch.bfloat16, device=device)
+        out_multi = torch.empty_like(out_cat)
+        out_0 = torch.empty((200, n0), dtype=torch.bfloat16, device=device)
+        out_1 = torch.empty((200, n1), dtype=torch.bfloat16, device=device)
+        dops.linear_plain_invariant_k31(x, w_cat, None, out_cat)
+        dops.linear_plain_invariant_k31_multi(x, [w0, w1], out_multi)
+        dops.linear_plain_invariant_k31(x, w0, None, out_0)
+        dops.linear_plain_invariant_k31(x, w1, None, out_1)
+        assert torch.equal(out_cat, out_multi), f"{shape_name}: cat vs multi mismatch"
+        assert torch.equal(out_cat[:, :n0], out_0), f"{shape_name}: cat[:n0] vs w0 mismatch"
+        assert torch.equal(out_cat[:, n0:], out_1), f"{shape_name}: cat[n0:] vs w1 mismatch"
+
+        ref = (x.float() @ w_cat.float().T)
+        rel = gpu.rel_l2(out_cat, ref)
+        assert rel < 0.005, f"{shape_name}: rel_l2={rel}"
+
+        # With bias, single row vs batch row 199 must be 0-ULP identical.
+        out_b_full = torch.empty((200, n0 + n1), dtype=torch.bfloat16, device=device)
+        out_b_one = torch.empty((1, n0 + n1), dtype=torch.bfloat16, device=device)
+        dops.linear_plain_invariant_k31(x, w_cat, bias, out_b_full)
+        dops.linear_plain_invariant_k31(x[199:200].contiguous(), w_cat, bias, out_b_one)
+        assert torch.equal(out_b_full[199], out_b_one[0]), f"{shape_name}: bias row mismatch"
+
