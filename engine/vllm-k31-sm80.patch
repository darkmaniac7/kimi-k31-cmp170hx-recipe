+            )
+        torch.cuda.synchronize(dev)
+
+        assert p2p_ops.check_error(h0) == 0
+        assert p2p_ops.check_error(h1) == 0
+        assert torch.equal(out_r0, out_r1)
+        assert torch.equal(out_s0, out_s1)
+    finally:
+        p2p_ops.destroy(h0)
+        p2p_ops.destroy(h1)
