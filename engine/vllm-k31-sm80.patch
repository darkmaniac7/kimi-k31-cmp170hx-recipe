+def test_plugin_registers_the_method_and_the_loader():
+    from vllm.config import LoadConfig
+    from vllm.model_executor.layers.quantization import get_quantization_config
+    from vllm.model_executor.model_loader import get_model_loader
+    from vllm.sm80 import plugin
+    from vllm.sm80.kernels.k31q.loader import K31QModelLoader
+    from vllm.sm80.kernels.k31q.quant import K31QConfig
+
+    plugin._register_k31q()
+    assert get_quantization_config("k31q") is K31QConfig
+    assert type(get_model_loader(LoadConfig(load_format="k31q"))) is K31QModelLoader
+    config = K31QConfig.from_config({"quant_method": "k31q", "version": 1})
+    assert config.get_name() == "k31q" and config.manifest is None
+    with pytest.raises(ValueError, match="Unsupported k31q quantization version"):
+        K31QConfig.from_config({"quant_method": "k31q", "version": 2})
+
