+    cw = torch.randn((C, 4), dtype=torch.bfloat16) * 0.2
+    cb = torch.randn((C,), dtype=torch.bfloat16) * 0.05
+    rg = torch.randn((T, H, D), dtype=torch.bfloat16) * 0.3
