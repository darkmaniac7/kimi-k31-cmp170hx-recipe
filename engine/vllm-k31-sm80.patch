+def _make_hybrid(monkeypatch, *, min_match_len=4, conf_floor=0.85, mode="hybrid"):
+    monkeypatch.setenv("VLLM_DSPARK_SUFFIX_HYBRID", "1")
+    monkeypatch.setenv("VLLM_DSPARK_SUFFIX_MIN_MATCH_LEN", str(min_match_len))
+    monkeypatch.setenv("VLLM_DSPARK_SUFFIX_CONF_FLOOR", str(conf_floor))
+    monkeypatch.setenv("VLLM_DSPARK_SUFFIX_MODE", mode)
+
+    fake_suffix = _FakeSuffix(max_num_reqs=8, k=12)
+    cls = suffix_hybrid_class(_FakeDSparkBase)
+    monkeypatch.setattr(
+        cls,
+        "_build_suffix_speculator",
+        lambda self, cfg, dev, rs: fake_suffix,
+    )
+    inst = cls(SimpleNamespace(), torch.device("cpu"), req_states=SimpleNamespace())
+    return inst, fake_suffix
+
+
+def _call_propose(inst, idx_mapping, **extra):
+    batch = SimpleNamespace(
+        num_reqs=len(idx_mapping),
+        idx_mapping=torch.tensor(idx_mapping, dtype=torch.int32),
+    )
+    z = torch.zeros(len(idx_mapping), dtype=torch.int32)
+    return inst.propose(batch, None, None, z, None, z, z, z, z, z, z, **extra)
+
