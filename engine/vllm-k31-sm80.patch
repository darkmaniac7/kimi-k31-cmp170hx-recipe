+    int bc = sh_warp_sum[lane], bt = sh_warp_tsum[lane];
+#pragma unroll
+    for (int d = 1; d < 8; d <<= 1) {
+      const int nc = __shfl_up_sync(0xffu, bc, d);
+      const int nt = __shfl_up_sync(0xffu, bt, d);
