+def verify_cli(w, *extra) -> tuple[int, dict]:
+    out = io.StringIO()
+    with redirect_stdout(out):
+        code = ck.main(["verify", "--settings", w.settings, "--models-dir", w.models,
+                        "--stamp-dir", w.stamps, *extra])
+    return code, json.loads(out.getvalue() or "{}")
+
