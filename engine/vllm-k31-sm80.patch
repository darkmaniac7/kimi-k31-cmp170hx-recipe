+def test_non_matching_prompt_keeps_dspark_bit_identical(monkeypatch):
+    inst, suffix = _make_hybrid(monkeypatch, min_match_len=4)
+    orig_drafts = torch.arange(100, 112, dtype=torch.int64).unsqueeze(0)
+    orig_conf = torch.linspace(0.9, 0.2, 12, dtype=torch.float32).unsqueeze(0)
+    inst.draft_tokens[:1].copy_(orig_drafts)
+    inst.draft_token_confidence_probs[:1].copy_(orig_conf)
+    # Short match (length 3 < min_match_len=4) must leave DSpark untouched.
+    suffix.set_match(0, 2, [999] * 12, match_len=3, bucket=2)
+
+    out = _call_propose(inst, [2])
+    assert torch.equal(out, orig_drafts)
+    assert torch.equal(inst.draft_token_confidence_probs[:1], orig_conf)
+    assert not bool(inst._last_suffix_used[0])
+    # last_bucket for req_slot=2 was cleared to -1 so DSpark does not pollute suffix stats.
+    assert suffix.last_bucket[2].item() == -1
+
