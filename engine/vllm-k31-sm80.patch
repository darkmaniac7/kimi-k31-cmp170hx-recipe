+
+def _pool():
+    from tests.kernels.quantization.test_exl3_dense_splitk import _Pool
+
+    return _Pool()
+
+
+def _ref(x, w):
+    return x.double() @ w.double().T
+
+
+def _bitwise(a, b):
+    return torch.equal(a.view(torch.int16), b.view(torch.int16))
