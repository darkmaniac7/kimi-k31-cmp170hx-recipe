+def _make_topk_logits_from_scores(scores: np.ndarray, topk: int = 128) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    """Compute exact FP64 logsumexp and sorted top-k from [P, V] float32 scores."""
+    s64 = scores.astype(np.float64)
+    m = s64.max(axis=-1, keepdims=True)
+    lse = (m[:, 0] + np.log(np.exp(s64 - m).sum(axis=-1))).astype(np.float32)
+    idx = np.argsort(-scores, axis=-1)[:, :topk].astype(np.int32)
+    vals = np.take_along_axis(scores, idx, axis=-1).astype(np.float32)
+    return idx, vals, lse
+
