+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""LiLiCorr drafter classes of the sm_80 fork.
+
+The fork plugin (``vllm.sm80.plugin``) registers :class:`LiLiCorrForCausalLM`
+in vLLM's model registry in place of the upstream class in
+``vllm/model_executor/models/lilicorr.py`` (``LiLiCorrDraftModel``). LiLiCorr
+builds DFlash2 decoder layers when its convolution is on; with the
+load-following draft width (``adaptive_k.draft_by_load``) their grouped
+convolutions read the block length from a device scalar, as DFlash2's do
+(``vllm/sm80/spec_decode/dflash2_model.py``). Both classes subclass the
+upstream ones and keep their names.
+"""
+
+from vllm.config import VllmConfig
+from vllm.model_executor.models import lilicorr
+from vllm.sm80.spec_decode.dflash2_model import adopt_grouped_convs
+
+
+class LiLiCorr(lilicorr.LiLiCorr):
+    def __init__(
+        self, *, vllm_config: VllmConfig, start_layer_id: int = 0, prefix: str = ""
+    ):
+        super().__init__(
+            vllm_config=vllm_config, start_layer_id=start_layer_id, prefix=prefix
+        )
+        adopt_grouped_convs(self, vllm_config)
+
+
+class LiLiCorrForCausalLM(lilicorr.LiLiCorrForCausalLM):
+    model_cls = LiLiCorr
diff --git a/vllm/sm80/spec_decode/markov_shortlist.py b/vllm/sm80/spec_decode/markov_shortlist.py
new file mode 100644
index 0000000000..e61a9ded82
--- /dev/null
+++ b/vllm/sm80/spec_decode/markov_shortlist.py
@@ -0,0 +1,896 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Greedy DSpark Markov sampling over a two-sided shortlist, without the
+full-shard Markov bias of every draft step.
+
+Supports both vanilla static-W1 DSpark models (byte-identical to baseline) and
+recurrent/block-causal DSpark heads (`DSpark-GRU` and `DSpark-AR1` Variants
+2A, 2A+, and 2B) inside full CUDA graphs with zero host synchronizations and
+zero dynamic shapes inside the step loop.
+"""
+
+from types import SimpleNamespace
+
+import torch
+
+import vllm.envs as envs
+from vllm.distributed import tensor_model_parallel_all_reduce
+from vllm.logger import init_logger
+from vllm.triton_utils import tl, triton
+
+logger = init_logger(__name__)
+
+SWITCH = "VLLM_DSPARK_MARKOV_SHORTLIST"
+SUCCESSORS = "VLLM_DSPARK_MARKOV_SUCCESSORS"
+BLOCK = 4096  # columns per chunk of the base candidate search
+LANES = 8  # BF16 lanes per slot: 4 key bytes, 3 token bytes, 1 zero
+TILE = 8  # base candidates a step multiplies at a time
+MAX_CANDIDATES = 64  # base candidates per rank
+MAX_SUCCESSORS = 256  # Markov successors per rank
+MAX_SHARD = 1 << 20  # columns of one shard (20 bits of the search composite)
+MAX_VOCAB = 1 << 24  # three token bytes
+TABLE_ROWS = 512  # previous tokens per matmul of the successor table
+
+
+@triton.jit
+def _lane_shift(lane):
+    # shard_argmax's slot: key bytes in lanes 0-3 and token bytes in lanes 4-6,
+    # most significant first; lane 7 carries nothing.
+    return tl.where(lane < 4, 24 - 8 * lane, tl.where(lane < 7, 48 - 8 * lane, 0))
+
+
+@triton.jit
+def _key32(x):
+    # shard_argmax's order key of FP32 values, as int64 in [0, 2**32): -0.0 is
+    # +0.0, every NaN the largest key, otherwise the IEEE order. A value's key
+    # is at least 0x007FFFFF (-inf), so key 0 marks an empty slot.
+    bits = x.to(tl.int32, bitcast=True)
+    bits = tl.where(bits == -2147483648, 0, bits)
+    is_nan = (bits & 0x7FFFFFFF) > 0x7F800000
+    wide = bits.to(tl.int64)
+    key = tl.where(wide >= 0, wide + 2147483648, -1 - wide)
+    return tl.where(is_nan, 4294967295, key)
+
+
+@triton.jit
+def _unkey32(key):
+    # The FP32 value of a key (a NaN for the NaN key).
+    bits = tl.where(key >= 2147483648, key - 2147483648, -1 - key)
+    return bits.to(tl.int32).to(tl.float32, bitcast=True)
+
+
+@triton.jit
+def _pick(slots_ptr, req, vocab, TP: tl.constexpr, TP_P2: tl.constexpr):
+    # The token of a request's summed slots: the slot with the largest key,
+    # the lowest rank (so the lowest token) among equal keys, held in the
+    # vocabulary (unwritten slots, a capture warmup's all-reduce output, hold
+    # any bytes).
+    r = tl.arange(0, TP_P2)
+    lane = tl.arange(0, 8)
+    v = tl.load(
+        slots_ptr + req * (TP * 8) + r[:, None] * 8 + lane[None, :],
+        mask=r[:, None] < TP,
+        other=0.0,
+    )
+    part = v.to(tl.float32).to(tl.int64) << _lane_shift(lane).to(tl.int64)[None, :]
+    key = tl.sum(tl.where(lane[None, :] < 4, part, 0), axis=1)
+    token = tl.sum(
+        tl.where((lane[None, :] >= 4) & (lane[None, :] < 7), part, 0), axis=1
+    )
+    key = tl.where(r < TP, key, -1)
+    best = tl.max(key, axis=0)
+    first = tl.min(tl.where(key == best, r, TP_P2), axis=0)
+    picked = tl.sum(tl.where(r == first, token, 0), axis=0)
+    return tl.minimum(tl.maximum(picked, 0), vocab - 1)
+
+
+@triton.jit(do_not_specialize=["n_cols"])
+def _chunk_top_kernel(
+    logits_ptr,  # [rows, >= n_cols] FP32 or BF16
+    logits_stride,
+    scratch_ptr,
+    scratch_stride,
+    n_cols,
+    T: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    chunk = tl.program_id(1)
+    offs = chunk * BLOCK + tl.arange(0, BLOCK)
+    valid = offs < n_cols
+    x = tl.load(logits_ptr + row * logits_stride + offs, mask=valid, other=0.0)
+    comp = (_key32(x.to(tl.float32)) << 20) | (1048575 - offs).to(tl.int64)
+    comp = tl.where(valid, comp, -1)
+    for t in tl.static_range(T):
+        best = tl.max(comp, axis=0)
+        tl.store(scratch_ptr + row * scratch_stride + chunk * T + t, best)
+        comp = tl.where(comp == best, -1, comp)
+
+
+@triton.jit
+def _merge_top_kernel(
+    scratch_ptr,
+    scratch_stride,
+    col_ptr,  # [rows, C] int32: the shard column, -1 without one
+    val_ptr,  # [rows, C] FP32
+    N: tl.constexpr,
+    N_P2: tl.constexpr,
+    C: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    s = tl.arange(0, N_P2)
+    comp = tl.load(scratch_ptr + row * scratch_stride + s, mask=s < N, other=-1)
+    for c in tl.static_range(C):
+        best = tl.max(comp, axis=0)
+        comp = tl.where(comp == best, -1, comp)
+        empty = best < 0
+        col = tl.where(empty, -1, 1048575 - (best & 1048575))
+        tl.store(col_ptr + row * C + c, col.to(tl.int32))
+        tl.store(val_ptr + row * C + c, _unkey32(tl.where(empty, 0, best >> 20)))
+
+
+@triton.jit(do_not_specialize=["step", "col_start", "rank"])
+def _step_kernel(
+    prev_slots_ptr,  # the step before's summed slots [num_reqs, TP * 8] BF16
+    input_ids_ptr,
+    anchor_ptr,  # [num_reqs] the previous token of step 0: input_ids[anchor]
+    out_ptr,  # [num_reqs * K] int64 drafts
+    logits_ptr,  # this rank's base logits [num_reqs * K, >= n_cols]
+    logits_stride,
+    top_col_ptr,  # [num_reqs * K, C] int32, top_candidates
+    top_val_ptr,  # [num_reqs * K, C] FP32
+    succ_col_ptr,  # [w1_rows, S] int32, successor_table
+    succ_bias_ptr,  # [w1_rows, S] FP32
+    w1_ptr,  # markov_w1 [w1_rows, RANK]
+    w2_ptr,  # this rank's markov_w2 rows [n_cols, RANK] BF16
+    slots_ptr,  # this step's slots [num_reqs, TP * 8] BF16
+    step,
+    col_start,
+    rank,
+    w1_rows,
+    vocab,
+    FIRST: tl.constexpr,
+    K: tl.constexpr,
+    C: tl.constexpr,
+    S: tl.constexpr,
+    S_P2: tl.constexpr,
+    RANK: tl.constexpr,
+    RANK_P2: tl.constexpr,
+    TP: tl.constexpr,
+    TP_P2: tl.constexpr,
+    TILE: tl.constexpr,
+):
+    req = tl.program_id(0).to(tl.int64)
+    if FIRST:
+        anchor = tl.load(anchor_ptr + req).to(tl.int64)
+        prev = tl.load(input_ids_ptr + anchor).to(tl.int64)
+    else:
+        prev = _pick(prev_slots_ptr, req, vocab, TP, TP_P2)
+        tl.store(out_ptr + req * K + step - 1, prev)
+    prev = tl.minimum(tl.maximum(prev, 0), w1_rows - 1)
+    row = req * K + step
+    j = tl.arange(0, S_P2)
+    succ = tl.load(succ_col_ptr + prev * S + j, mask=j < S, other=-1).to(tl.int64)
+    succ_bias = tl.load(succ_bias_ptr + prev * S + j, mask=j < S, other=0.0)
+    held = succ >= 0
+    base = tl.load(logits_ptr + row * logits_stride + succ, mask=held, other=0.0)
+    succ_comp = (_key32(base.to(tl.float32) + succ_bias) << 24) | (
+        16777215 - (col_start + succ)
+    )
+    best = tl.max(tl.where(held, succ_comp, -1), axis=0)
+    jr = tl.arange(0, RANK_P2)
+    e = tl.load(w1_ptr + prev * RANK + jr, mask=jr < RANK, other=0.0).to(tl.float32)
+    t = tl.arange(0, TILE)
+    for a in range(0, C, TILE):
+        c = a + t
+        top = tl.load(top_col_ptr + row * C + c, mask=c < C, other=-1).to(tl.int64)
+        value = tl.load(top_val_ptr + row * C + c, mask=c < C, other=0.0)
+        live = top >= 0
+        w = tl.load(
+            w2_ptr + top[:, None] * RANK + jr[None, :],
+            mask=live[:, None] & (jr[None, :] < RANK),
+            other=0.0,
+        )
+        bias = tl.sum(w.to(tl.float32) * e[None, :], axis=1)
+        comp = (_key32(value + bias) << 24) | (16777215 - (col_start + top))
+        best = tl.maximum(best, tl.max(tl.where(live, comp, -1), axis=0))
+    empty = best < 0
+    key = tl.where(empty, 0, best >> 24)
+    token = tl.where(empty, 0, 16777215 - (best & 16777215))
+    lane = tl.arange(0, 8)
+    src = tl.where(lane < 4, key, token)
+    byte = tl.where(lane < 7, (src >> _lane_shift(lane).to(tl.int64)) & 255, 0)
+    r = tl.arange(0, TP_P2)
+    vals = tl.where(r[:, None] == rank, byte[None, :], 0)
+    ptrs = slots_ptr + req * (TP * 8) + r[:, None] * 8 + lane[None, :]
+    tl.store(ptrs, vals.to(tl.float32).to(tl.bfloat16), mask=r[:, None] < TP)
+
+
+@triton.jit(do_not_specialize=["step"])
+def _pick_prev_kernel(
+    slots_ptr,
+    out_ptr,
+    prev_out_ptr,
+    step,
+    vocab,
+    K: tl.constexpr,
+    TP: tl.constexpr,
+    TP_P2: tl.constexpr,
+):
+    req = tl.program_id(0).to(tl.int64)
+    picked = _pick(slots_ptr, req, vocab, TP, TP_P2)
+    tl.store(out_ptr + req * K + step - 1, picked)
+    tl.store(prev_out_ptr + req, picked)
+
+
+@triton.jit(do_not_specialize=["step", "col_start", "rank"])
+def _recurrent_step_kernel(
+    prev_ptr,  # [num_reqs] int64 previous token id for this step
+    m_ptr,  # [num_reqs, RANK] recurrent Markov vector m_t
+    logits_ptr,  # [logits_rows, >= n_cols]
+    logits_stride,
+    top_col_ptr,  # [logits_rows, C] int32
+    top_val_ptr,  # [logits_rows, C] FP32
+    succ_col_ptr,  # [w1_rows, S] int32
+    w2_ptr,  # [n_cols, RANK] BF16
+    extra_ptr,  # [num_reqs, C + S] FP32 candidate embed scores (when HAS_EXTRA)
+    slots_ptr,  # [num_reqs, TP * 8] BF16
+    step,
+    col_start,
+    rank,
+    w1_rows,
+    PER_STEP_LOGITS: tl.constexpr,
+    K: tl.constexpr,
+    C: tl.constexpr,
+    S: tl.constexpr,
+    RANK: tl.constexpr,
+    RANK_P2: tl.constexpr,
+    TP: tl.constexpr,
+    TP_P2: tl.constexpr,
+    TILE: tl.constexpr,
+    HAS_EXTRA: tl.constexpr,
+):
+    req = tl.program_id(0).to(tl.int64)
+    prev = tl.load(prev_ptr + req).to(tl.int64)
+    prev = tl.minimum(tl.maximum(prev, 0), w1_rows - 1)
+    row = req if PER_STEP_LOGITS else (req * K + step)
+
+    jr = tl.arange(0, RANK_P2)
+    m = tl.load(m_ptr + req * RANK + jr, mask=jr < RANK, other=0.0).to(tl.float32)
+    best = tl.full((), -1, tl.int64)
+    t = tl.arange(0, TILE)
+
+    for a in range(0, S, TILE):
+        s_idx = a + t
+        in_s = s_idx < S
+        succ = tl.load(succ_col_ptr + prev * S + s_idx, mask=in_s, other=-1).to(
+            tl.int64
+        )
+        held = in_s & (succ >= 0)
+        base = tl.load(
+            logits_ptr + row * logits_stride + succ, mask=held, other=0.0
+        ).to(tl.float32)
+        w = tl.load(
+            w2_ptr + succ[:, None] * RANK + jr[None, :],
+            mask=held[:, None] & (jr[None, :] < RANK),
+            other=0.0,
+        )
+        bias = tl.sum(w.to(tl.float32) * m[None, :], axis=1)
+        if HAS_EXTRA:
+            extra = tl.load(
+                extra_ptr + req * (C + S) + C + s_idx, mask=held, other=0.0
+            ).to(tl.float32)
+            score = base + bias + extra
+        else:
+            score = base + bias
+        comp = (_key32(score) << 24) | (16777215 - (col_start + succ))
+        best = tl.maximum(best, tl.max(tl.where(held, comp, -1), axis=0))
+
+    for a in range(0, C, TILE):
+        c_idx = a + t
+        in_c = c_idx < C
+        top = tl.load(top_col_ptr + row * C + c_idx, mask=in_c, other=-1).to(tl.int64)
+        value = tl.load(top_val_ptr + row * C + c_idx, mask=in_c, other=0.0).to(
+            tl.float32
+        )
+        live = in_c & (top >= 0)
+        w = tl.load(
+            w2_ptr + top[:, None] * RANK + jr[None, :],
+            mask=live[:, None] & (jr[None, :] < RANK),
+            other=0.0,
+        )
+        bias = tl.sum(w.to(tl.float32) * m[None, :], axis=1)
+        if HAS_EXTRA:
+            extra = tl.load(
+                extra_ptr + req * (C + S) + c_idx, mask=live, other=0.0
+            ).to(tl.float32)
+            score = value + bias + extra
+        else:
+            score = value + bias
+        comp = (_key32(score) << 24) | (16777215 - (col_start + top))
+        best = tl.maximum(best, tl.max(tl.where(live, comp, -1), axis=0))
+
+    empty = best < 0
+    key = tl.where(empty, 0, best >> 24)
+    token = tl.where(empty, 0, 16777215 - (best & 16777215))
+    lane = tl.arange(0, 8)
+    src = tl.where(lane < 4, key, token)
+    byte = tl.where(lane < 7, (src >> _lane_shift(lane).to(tl.int64)) & 255, 0)
+    r = tl.arange(0, TP_P2)
+    vals = tl.where(r[:, None] == rank, byte[None, :], 0)
+    ptrs = slots_ptr + req * (TP * 8) + r[:, None] * 8 + lane[None, :]
+    tl.store(ptrs, vals.to(tl.float32).to(tl.bfloat16), mask=r[:, None] < TP)
+
+
+@triton.jit(do_not_specialize=["step"])
+def _last_kernel(
+    slots_ptr, out_ptr, step, vocab, K: tl.constexpr, TP: tl.constexpr, TP_P2: tl.constexpr
+):
+    req = tl.program_id(0).to(tl.int64)
+    tl.store(out_ptr + req * K + step, _pick(slots_ptr, req, vocab, TP, TP_P2))
+
+
+def top_candidates(
+    logits: torch.Tensor, n_cols: int, cands: int
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """The ``cands`` largest values of every row of a shard."""
+    rows = logits.shape[0]
+    if logits.dtype not in (torch.float32, torch.bfloat16) or logits.stride(-1) != 1:
+        raise ValueError(
+            "top_candidates takes FP32 or BF16 logits with unit column stride"
+        )
+    if not 0 < cands <= MAX_CANDIDATES:
+        raise ValueError(f"{cands} base candidates a rank (1 to {MAX_CANDIDATES})")
+    if not 0 <= n_cols <= min(logits.shape[1], MAX_SHARD):
+        raise ValueError(f"{n_cols} columns of a {logits.shape[1]} column shard")
+    chunks = max(1, triton.cdiv(n_cols, BLOCK))
+    device = logits.device
+    scratch = torch.empty(rows, chunks * cands, dtype=torch.int64, device=device)
+    cols = torch.empty(rows, cands, dtype=torch.int32, device=device)
+    vals = torch.empty(rows, cands, dtype=torch.float32, device=device)
+    if rows:
+        _chunk_top_kernel[(rows, chunks)](
+            logits,
+            logits.stride(0),
+            scratch,
+            scratch.stride(0),
+            n_cols,
+            T=cands,
+            BLOCK=BLOCK,
+            num_warps=8,
+        )
+        _merge_top_kernel[(rows,)](
+            scratch,
+            scratch.stride(0),
+            cols,
+            vals,
+            N=chunks * cands,
+            N_P2=triton.next_power_of_2(chunks * cands),
+            C=cands,
+            num_warps=4,
+        )
+    return cols, vals
+
+
+def successor_table(
+    w1: torch.Tensor, w2_rows: torch.Tensor, successors: int
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Per previous token, the ``successors`` columns of a shard with the
+    largest Markov bias ``w2_rows[col] . w1[prev]`` (FP32) and that bias."""
+    tokens, n_cols = w1.shape[0], w2_rows.shape[0]
+    cols = torch.full((tokens, successors), -1, dtype=torch.int32, device=w1.device)
+    bias = torch.zeros(tokens, successors, dtype=torch.float32, device=w1.device)
+    held = min(successors, n_cols)
+    if held:
+        rows_t = w2_rows.float().t().contiguous()
+        for start in range(0, tokens, TABLE_ROWS):
+            top = (w1[start : start + TABLE_ROWS].float() @ rows_t).topk(held, dim=-1)
+            cols[start : start + TABLE_ROWS, :held] = top.indices.to(torch.int32)
+            bias[start : start + TABLE_ROWS, :held] = top.values
+    return cols, bias
+
+
+def step_slots(
+    state: SimpleNamespace,
+    step: int,
+    prev_slots: torch.Tensor | None,
+    local: torch.Tensor,
+    top_cols: torch.Tensor,
+    top_vals: torch.Tensor,
+    input_ids: torch.Tensor,
+    anchor_idx: torch.Tensor,
+    out: torch.Tensor,
+    num_steps: int,
+    col_start: int,
+    rank: int,
+    tp_size: int,
+    vocab: int,
+) -> torch.Tensor:
+    """This rank's slots of draft step ``step`` ([num_reqs, tp_size * LANES]
+    BF16, every other rank's slot zero)."""
+    num_reqs = anchor_idx.shape[0]
+    slots = torch.empty(
+        num_reqs, tp_size * LANES, dtype=torch.bfloat16, device=local.device
+    )
+    if not num_reqs:
+        return slots
+    rank_dim = state.w1.shape[1]
+    _step_kernel[(num_reqs,)](
+        slots if prev_slots is None else prev_slots,
+        input_ids,
+        anchor_idx,
+        out,
+        local,
+        local.stride(0),
+        top_cols,
+        top_vals,
+        state.succ_cols,
+        state.succ_bias,
+        state.w1,
+        state.w2_rows,
+        slots,
+        step,
+        col_start,
+        rank,
+        state.w1.shape[0],
+        vocab,
+        FIRST=prev_slots is None,
+        K=num_steps,
+        C=state.cands,
+        S=state.successors,
+        S_P2=triton.next_power_of_2(state.successors),
+        RANK=rank_dim,
+        RANK_P2=triton.next_power_of_2(rank_dim),
+        TP=tp_size,
+        TP_P2=triton.next_power_of_2(tp_size),
+        TILE=TILE,
+        num_warps=4,
+    )
+    return slots
+
+
+def pick_prev_drafts(
+    slots: torch.Tensor,
+    out: torch.Tensor,
+    prev_buf: torch.Tensor,
+    step: int,
+    num_steps: int,
+    tp_size: int,
+    vocab: int,
+) -> None:
+    """Decode `slots` from step-1 into `out[:, step - 1]` and `prev_buf`."""
+    num_reqs = slots.shape[0]
+    if num_reqs:
+        _pick_prev_kernel[(num_reqs,)](
+            slots,
+            out,
+            prev_buf,
+            step,
+            vocab,
+            K=num_steps,
+            TP=tp_size,
+            TP_P2=triton.next_power_of_2(tp_size),
+            num_warps=1,
+        )
+
+
+def recurrent_step_slots(
+    state: SimpleNamespace,
+    step: int,
+    prev_ids: torch.Tensor,
+    m_t: torch.Tensor,
+    local: torch.Tensor,
+    top_cols: torch.Tensor,
+    top_vals: torch.Tensor,
+    extra_scores: torch.Tensor | None,
+    num_steps: int,
+    col_start: int,
+    rank: int,
+    tp_size: int,
+    *,
+    per_step_logits: bool = False,
+) -> torch.Tensor:
+    """Score C base candidates and S static successors with recurrent `m_t`."""
+    num_reqs = prev_ids.shape[0]
+    slots = torch.empty(
+        num_reqs, tp_size * LANES, dtype=torch.bfloat16, device=local.device
+    )
+    if not num_reqs:
+        return slots
+    rank_dim = state.w1.shape[1]
+    has_extra = extra_scores is not None
+    _recurrent_step_kernel[(num_reqs,)](
+        prev_ids,
+        m_t.contiguous(),
+        local,
+        local.stride(0),
+        top_cols,
+        top_vals,
+        state.succ_cols,
+        state.w2_rows,
+        extra_scores if has_extra else top_vals,
+        slots,
+        step,
+        col_start,
+        rank,
+        state.w1.shape[0],
+        PER_STEP_LOGITS=per_step_logits,
+        K=num_steps,
+        C=state.cands,
+        S=state.successors,
+        RANK=rank_dim,
+        RANK_P2=triton.next_power_of_2(rank_dim),
+        TP=tp_size,
+        TP_P2=triton.next_power_of_2(tp_size),
+        TILE=TILE,
+        HAS_EXTRA=has_extra,
+        num_warps=4,
+    )
+    return slots
+
+
+def last_drafts(
+    slots: torch.Tensor, out: torch.Tensor, num_steps: int, tp_size: int, vocab: int
+) -> None:
+    """Write the drafts of the last step's summed slots to ``out[:, -1]``."""
+    num_reqs = slots.shape[0]
+    if num_reqs:
+        _last_kernel[(num_reqs,)](
+            slots,
+            out,
+            num_steps - 1,
+            vocab,
+            K=num_steps,
+            TP=tp_size,
+            TP_P2=triton.next_power_of_2(tp_size),
+            num_warps=1,
+        )
+
+
+def candidates() -> int:
+    """Base candidates a rank and draft position (0: the switch is off)."""
+    return int(getattr(envs, SWITCH))
+
+
+def refusal(speculator, stats) -> str | None:
+    """Why the shortlist cannot replace this speculator's Markov steps."""
+    model = speculator.model
+    cands, successors = candidates(), int(getattr(envs, SUCCESSORS))
+    if not 0 < cands <= MAX_CANDIDATES:
+        return f"{cands} base candidates a rank (1 to {MAX_CANDIDATES})"
+    if not 0 < successors <= MAX_SUCCESSORS:
+        return (
+            f"{successors} Markov successors a rank ({SUCCESSORS}: 1 to "
+            f"{MAX_SUCCESSORS})"
+        )
+    if not hasattr(model, "markov_w2_rows"):
+        return (
+            f"{type(model).__name__} has no dense markov_w2 rows "
+            "(markov_w2_rows)"
+        )
+    if getattr(model, "has_recurrent_markov_head", False) and not getattr(
+        model, "supports_shortlist_recurrent", False
+    ):
+        return "a recurrent Markov head carries a state across the steps"
+    if stats is not None:
+        return (
+            "the adaptive depth policy reads the top-1 probability and entropy "
+            "of the full draft logits"
+        )
+    return None
+
+
+def _prepare(speculator, stats, col_start: int, n_cols: int) -> SimpleNamespace:
+    """The switch's state of a speculator, built at its first draft step."""
+    reason = refusal(speculator, stats)
+    if reason is not None:
+        raise ValueError(f"{SWITCH}: {reason}")
+    model = speculator.model
+    w1 = model.model.markov_head.markov_w1.weight
+    if w1.is_cuda and torch.cuda.is_current_stream_capturing():
+        raise ValueError(
+            f"{SWITCH}: the Markov tables must be built by an eager draft step "
+            "before graph capture"
+        )
+    vocab = model.logits_processor.org_vocab_size
+    if vocab > MAX_VOCAB or n_cols > MAX_SHARD:
+        raise ValueError(
+            f"{SWITCH}: a vocabulary above {MAX_VOCAB} tokens or a shard above "
+            f"{MAX_SHARD} columns"
+        )
+    w2_rows = model.markov_w2_rows(col_start, n_cols)
+    if w2_rows.dtype != torch.bfloat16 or w2_rows.shape != (n_cols, w1.shape[1]):
+        raise ValueError(
+            f"{SWITCH}: markov_w2_rows gave {w2_rows.dtype} "
+            f"{tuple(w2_rows.shape)}, not BF16 ({n_cols}, {w1.shape[1]})"
+        )
+    cands, successors = candidates(), int(getattr(envs, SUCCESSORS))
+    w1 = w1.contiguous()
+    w2_rows = w2_rows.contiguous()
+    succ_cols, succ_bias = successor_table(w1, w2_rows, successors)
+    embed_rows = (
+        model.embed_rows_local(n_cols)
+        if hasattr(model, "embed_rows_local")
+        else None
+    )
+    state = SimpleNamespace(
+        cands=cands,
+        successors=successors,
+        w1=w1,
+        w2_rows=w2_rows,
+        succ_cols=succ_cols,
+        succ_bias=succ_bias,
+        embed_rows=embed_rows,
+    )
+    logger.info(
+        "DSpark greedy Markov sampling scores %d base candidates and %d Markov "
+        "successors a rank and draft step (%s=%d, %s=%d) instead of the "
+        "full-shard Markov bias; tables %.0f MiB a rank.",
+        cands,
+        successors,
+        SWITCH,
+        cands,
+        SUCCESSORS,
+        successors,
+        (w2_rows.nbytes + succ_cols.nbytes + succ_bias.nbytes) / (1 << 20),
+    )
+    return state
+
+
+def _sample_recurrent(
+    s,
+    num_reqs: int,
+    sample_hidden: torch.Tensor,
+    local: torch.Tensor,
+    col_start: int,
+    n_cols: int,
+    rank: int,
+    tp_size: int,
+    stats,
+) -> None:
+    """CUDA-graph-safe greedy sampling for DSpark-GRU and DSpark-AR1 heads."""
+    model = s.model
+    n_spec = s.num_speculative_steps
+    vocab = model.logits_processor.org_vocab_size
+    anchors = s._anchor_idx[:num_reqs]
+    input_ids = s.input_buffers.input_ids
+    arch = getattr(model, "head_arch", "vanilla")
+    hidden_3d = sample_hidden.view(num_reqs, n_spec, -1)
+    rec_state = model.precompute_recurrent_hidden(hidden_3d)
+    m_embeds: list[torch.Tensor] = []
+    vec_list: list[torch.Tensor] = []
+
+    if not candidates():
+        # Full-shard VLLM_DSPARK_SHARD_ARGMAX=1 path (shortlist off).
+        from vllm.sm80.spec_decode import shard_argmax as sa
+
+        width = local.shape[-1]
+        chunks = triton.cdiv(width, sa.BLOCK)
+        base_lanes = tp_size * chunks * sa.LANES
+        local_3d = local.view(num_reqs, n_spec, width)
+        prev = input_ids[anchors].long()
+        for step in range(n_spec):
+            m_t, vec_t, rec_state = model.recurrent_step(prev, rec_state, step)
+            if s.use_confidence_head:
+                m_embeds.append(m_t)
+                if arch == "ar1_fulllm" and vec_t is not None:
+                    vec_list.append(vec_t)
+            if arch == "ar1_fulllm" and vec_t is not None:
+                base_step = model.compute_logits_local(hidden_3d[:, step] + vec_t)[
+                    :, :n_cols
+                ]
+            else:
+                base_step = local_3d[:, step, :n_cols]
+            if hasattr(model, "markov_bias_local"):
+                bias_local = model.markov_bias_local(m_t, col_start, n_cols)
+            else:
+                bias_local = model.markov_bias(m_t)[:, col_start : col_start + n_cols]
+            logits_i = base_step + bias_local
+            if arch == "ar1_cand_embed" and vec_t is not None and n_cols > 0:
+                logits_i = logits_i + model.compute_embed_logits_local(vec_t, n_cols)
+            if logits_i.dtype != torch.float32:
+                logits_i = logits_i.float()
+            slots = sa.chunk_slots(
+                logits_i, col_start, rank, tp_size, chunks, stats=stats is not None
+            )
+            if tp_size > 1:
+                slots = tensor_model_parallel_all_reduce(slots)
+            draft_i = sa.pick(slots, vocab, tp_size * chunks)
+            if stats is not None:
+                sa.combine_stats(slots, base_lanes, tp_size, stats[:num_reqs, :, step])
+            s.draft_tokens[:num_reqs, step] = draft_i
+            prev = draft_i
+        if s.use_confidence_head:
+            h_conf = (
+                (hidden_3d + torch.stack(vec_list, dim=1)).flatten(0, 1)
+                if vec_list
+                else sample_hidden
+            )
+            conf = model.compute_confidence(
+                h_conf, torch.stack(m_embeds, dim=1).flatten(0, 1)
+            )
+            s.draft_token_confidence_probs[:num_reqs] = conf.view(num_reqs, n_spec)
+        return
+
+    # Shortlist path (VLLM_DSPARK_MARKOV_SHORTLIST=C).
+    state = getattr(s, "_markov_shortlist", None)
+    if state is None:
+        state = s._markov_shortlist = _prepare(s, stats, col_start, n_cols)
+
+    is_fulllm = arch == "ar1_fulllm"
+    if not is_fulllm:
+        top_cols, top_vals = top_candidates(local, n_cols, state.cands)
+    else:
+        top_cols = top_vals = local  # unused placeholder; computed per step below
+
+    drafts = torch.empty(num_reqs, n_spec, dtype=torch.int64, device=local.device)
+    prev_buf = torch.empty(num_reqs, dtype=torch.int64, device=local.device)
+    slots: torch.Tensor | None = None
+    embed_rows = state.embed_rows
+    scale = float(getattr(model.logits_processor, "scale", 1.0))
+
+    for step in range(n_spec):
+        if step == 0:
+            prev_step = input_ids[anchors].long()
+        else:
+            assert slots is not None
+            pick_prev_drafts(slots, drafts, prev_buf, step, n_spec, tp_size, vocab)
+            prev_step = prev_buf
+
+        m_t, vec_t, rec_state = model.recurrent_step(prev_step, rec_state, step)
+        if s.use_confidence_head:
+            m_embeds.append(m_t)
+            if is_fulllm and vec_t is not None:
+                vec_list.append(vec_t)
+
+        if is_fulllm and vec_t is not None:
+            step_local = model.compute_logits_local(hidden_3d[:, step] + vec_t)
+            step_top_cols, step_top_vals = top_candidates(
+                step_local, n_cols, state.cands
+            )
+            logits_src = step_local
+            per_step_flag = True
+        else:
+            step_top_cols = top_cols
+            step_top_vals = top_vals
+            logits_src = local
+            per_step_flag = False
+
+        extra_scores: torch.Tensor | None = None
+        if arch == "ar1_cand_embed" and vec_t is not None:
+            if embed_rows is None:
+                raise RuntimeError(
+                    "ar1_cand_embed shortlist requires local embed_tokens rows"
+                )
+            if num_reqs > 0 and n_cols > 0:
+                row_slice = (
+                    step_top_cols
+                    if per_step_flag
+                    else step_top_cols[step::n_spec]
+                )
+                prev_clamped = prev_step.clamp(0, state.w1.shape[0] - 1)
+                succ_slice = state.succ_cols[prev_clamped]
+                cand_all = torch.cat([row_slice, succ_slice], dim=-1).clamp(min=0).long()
+                cand_emb = embed_rows[cand_all]  # [B, C + S, H]
+                extra_scores = (
+                    torch.bmm(
+                        cand_emb, vec_t.to(cand_emb.dtype).unsqueeze(-1)
+                    )
+                    .squeeze(-1)
+                    .float()
+                )
+                if scale != 1.0:
+                    extra_scores = extra_scores * scale
+            else:
+                extra_scores = torch.zeros(
+                    num_reqs,
+                    state.cands + state.successors,
+                    dtype=torch.float32,
+                    device=local.device,
+                )
+
+        slots = recurrent_step_slots(
+            state,
+            step,
+            prev_step,
+            m_t,
+            logits_src,
+            step_top_cols,
+            step_top_vals,
+            extra_scores,
+            n_spec,
+            col_start,
+            rank,
+            tp_size,
+            per_step_logits=per_step_flag,
+        )
+        if tp_size > 1:
+            slots = tensor_model_parallel_all_reduce(slots)
+
+    assert slots is not None
+    last_drafts(slots, drafts, n_spec, tp_size, vocab)
+    s.draft_tokens[:num_reqs, :n_spec] = drafts
+    if s.use_confidence_head:
+        h_conf = (
+            (hidden_3d + torch.stack(vec_list, dim=1)).flatten(0, 1)
+            if vec_list
+            else sample_hidden
+        )
+        confidence = model.compute_confidence(
+            h_conf, torch.stack(m_embeds, dim=1).flatten(0, 1)
+        )
+        s.draft_token_confidence_probs[:num_reqs] = confidence.view(num_reqs, n_spec)
+
+
+def sample(
+    speculator,
+    num_reqs: int,
+    sample_hidden: torch.Tensor,
+    local: torch.Tensor,
+    col_start: int,
+    n_cols: int,
+    rank: int,
+    tp_size: int,
+    stats,
+) -> bool:
+    """``shard_argmax.sample_sequential``'s Markov steps over the shortlist."""
+    has_rec = speculator is not None and getattr(
+        getattr(speculator, "model", None), "supports_shortlist_recurrent", False
+    )
+    if not candidates() and not has_rec:
+        return False
+    if has_rec:
+        _sample_recurrent(
+            speculator,
+            num_reqs,
+            sample_hidden,
+            local,
+            col_start,
+            n_cols,
+            rank,
+            tp_size,
+            stats,
+        )
+        return True
+
+    s = speculator
+    state = getattr(s, "_markov_shortlist", None)
+    if state is None:
+        state = s._markov_shortlist = _prepare(s, stats, col_start, n_cols)
+    model = s.model
+    n_spec = s.num_speculative_steps
+    vocab = model.logits_processor.org_vocab_size
+    anchors = s._anchor_idx[:num_reqs]
+    input_ids = s.input_buffers.input_ids
+    top_cols, top_vals = top_candidates(local, n_cols, state.cands)
+    drafts = torch.empty(num_reqs, n_spec, dtype=torch.int64, device=local.device)
+    slots = None
+    for step in range(n_spec):
+        slots = step_slots(
+            state,
+            step,
+            slots,
+            local,
+            top_cols,
+            top_vals,
+            input_ids,
+            anchors,
+            drafts,
+            n_spec,
+            col_start,
+            rank,
+            tp_size,
+            vocab,
+        )
+        if tp_size > 1:
+            slots = tensor_model_parallel_all_reduce(slots)
+    last_drafts(slots, drafts, n_spec, tp_size, vocab)
+    s.draft_tokens[:num_reqs, :n_spec] = drafts
+    if s.use_confidence_head:
+        first = input_ids[anchors].to(drafts.dtype)
+        prev = torch.cat([first[:, None], drafts[:, :-1]], dim=1)
+        confidence = model.compute_confidence(
+            sample_hidden, model.markov_embed(prev).flatten(0, 1)
+        )
+        s.draft_token_confidence_probs[:num_reqs] = confidence.view(num_reqs, n_spec)
+    return True
