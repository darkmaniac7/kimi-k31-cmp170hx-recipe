+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""A tiny Kimi K3.1 checkpoint in the k31q v1 format, with the real
+checkpoint's tensor names and storage classes.
+
+:func:`tiny_config` scales the real ``config.json`` (``fixtures/``) down
+while keeping every kind of layer: layer 0 with the dense MLP, KDA layers,
+one MLA layer with the DSA indexer, latent MoE layers, and three AttnRes bank
+writes. Every tensor-parallel cut of two ranks falls on whole 128 blocks, as
+in the real model, and the MLA key/value projection has the real 576 outputs
+padded to 640. :func:`write_checkpoint` writes the directory (random values:
+it tests names, shapes, ranges and cuts, never numerics of a quantizer) and
+returns the FP32 expert matrices the VQ records decode to.
+:func:`build_views` makes the per-stage views a pipeline stage loads from.
+
+The numpy functions below are the format's executable definition, kept
+independent of the engine's torch codec (vllm/sm80/kernels/k31q/codec.py) so
+the tests compare two implementations.
+"""
+
+import copy
+import hashlib
+import json
+import os
+import struct
+from pathlib import Path
+
+import numpy as np
+
+FIXTURES = Path(__file__).parent / "fixtures"
+REAL_CONFIG = FIXTURES / "config.json"
+ROOT = "language_model."
+P = ROOT + "model."
+EXL3_MUL1 = 0x83DCD12D
+DT = {
+    "F16": np.float16,
+    "F32": np.float32,
+    "BF16": np.uint16,
+    "I16": np.int16,
+    "I32": np.int32,
+    "U8": np.uint8,
+}
+
+TEXT = {
+    "vocab_size": 512,
+    "hidden_size": 256,
+    "intermediate_size": 512,
+    "num_hidden_layers": 6,
+    "attn_res_block_size": 2,
+    "num_attention_heads": 4,
+    "num_key_value_heads": 4,
+    "q_lora_rank": 128,
+    "kv_lora_rank": 512,
+    "moe_intermediate_size": 512,
+    # Two blocks, not one: with 128 the records of w1 and w3 (128 rows of
+    # latent / dim vectors) and of w2 (latent rows of 128 / dim vectors)
+    # would have one geometry, and a mix-up of the two roles would not show.
+    "routed_expert_hidden_size": 256,
+    "num_experts": 8,
+    "num_experts_per_token": 2,
+    "max_position_embeddings": 4096,
+    "linear_attn_config": {
+        "full_attn_layers": [4],
+        "gate_lower_bound": -5.0,
+        "head_dim": 128,
+        "kda_layers": [1, 2, 3, 5, 6],
+        "num_heads": 2,
+        "short_conv_kernel_size": 4,
+        "use_full_rank_gate": True,
+    },
+    "dsa_config": {
+        "dsa_layers": [4],
+        "index_topk": 64,
+        "index_head_dim": 128,
+        "index_num_heads": 8,
+        "index_rope_dim": 0,
+        "index_k_norm_type": "layernorm",
+        "index_topk_freq": 1,
+        "index_skip_topk_offset": 1,
+    },
+}
+# The vision tower and the projector of the wrapper, scaled down the same
+# way (the real tower: 27 layers of 1024, 1536 for q, k and v).
+VISION = {
+    "vt_hidden_size": 64,
+    "vt_intermediate_size": 128,
+    "vt_num_attention_heads": 4,
+    "vt_num_hidden_layers": 2,
+    "qkv_hidden_size": 64,
+    "mm_hidden_size": 64,
+    "init_pos_emb_height": 4,
+    "init_pos_emb_width": 4,
+    "init_pos_emb_time": 2,
+    "text_hidden_size": TEXT["hidden_size"],
+}
+VISION_FILE = "vision.safetensors"
+# name -> (dim, index_bits, group_size); all-in bits per weight are
+# bits / dim + 16 / group.
+# The three d = 2 codebooks are the real checkpoint's rate classes (1.625,
+# 2.125 and 2.625 bits per weight); its mini checkpoint also has a layer at
+# (4, 6, 128). No index width here is a whole byte.
+RATES = {
+    "vq_d2_b3": (2, 3, 128),
+    "vq_d2_b4": (2, 4, 128),
+    "vq_d2_b5": (2, 5, 128),
+    "vq_d4_b6": (4, 6, 128),
+}
+# Decoder layer -> rate of w1, w3 and w2. The projections of a layer may
+# differ in rate (layer 4); the run-time method is one per layer.
+LAYER_RATES = {
+    1: ("vq_d2_b3", "vq_d2_b3", "vq_d2_b3"),
+    2: ("vq_d2_b4", "vq_d2_b4", "vq_d2_b4"),
+    3: ("vq_d2_b5", "vq_d2_b5", "vq_d2_b5"),
+    4: ("vq_d4_b6", "vq_d4_b6", "vq_d2_b4"),
+}
+# Decoder layer whose routed experts use the EXL3 fallback, and their K.
+EXL3_EXPERT_LAYERS = (5,)
+EXL3_EXPERT_BITS = 2
+PROJECTIONS = (("w1", "in_latent"), ("w3", "in_latent"), ("w2", "out_latent"))
+
+
+def tiny_config(keep_text_record: bool = False) -> dict:
+    """The real config.json with the tiny dimensions above and the k31q
+    quantization record at the top level (request R1). The released
+    checkpoint's text config carries a compressed-tensors record of its MXFP4
+    experts; the top-level record wins over it (``keep_text_record`` leaves
+    it in, as a converter that only adds the k31q record would)."""
+    config = json.loads(REAL_CONFIG.read_text())
+    config["text_config"].update(copy.deepcopy(TEXT))
+    config["vision_config"].update(copy.deepcopy(VISION))
+    if not keep_text_record:
+        config["text_config"].pop("quantization_config", None)
+    config["quantization_config"] = {"quant_method": "k31q", "version": 1}
+    return config
+
+
+# -- safetensors container (8-byte LE header length, JSON header, raw data) ---
+
+
+def st_write(path, tensors, metadata=None):
+    """tensors: {name: (dtype_str, ndarray)} written in name order."""
+    header, blobs, offset = {}, [], 0
+    for name in sorted(tensors):
+        dtype, array = tensors[name]
+        data = np.ascontiguousarray(array, dtype=DT[dtype]).tobytes()
+        header[name] = {
+            "dtype": dtype,
+            "shape": list(np.shape(array)),
+            "data_offsets": [offset, offset + len(data)],
+        }
+        offset += len(data)
+        blobs.append(data)
+    if metadata:
+        header["__metadata__"] = metadata
+    encoded = json.dumps(header, separators=(",", ":")).encode()
+    encoded += b" " * ((8 - len(encoded) % 8) % 8)
+    with open(path, "wb") as file:
+        file.write(struct.pack("<Q", len(encoded)))
+        file.write(encoded)
+        for data in blobs:
+            file.write(data)
+
+
+def st_header(path):
+    with open(path, "rb") as file:
+        length = struct.unpack("<Q", file.read(8))[0]
+        return json.loads(file.read(length)), 8 + length
+
+
+def st_read(path, name):
+    header, base = st_header(path)
+    entry = header[name]
+    start, stop = entry["data_offsets"]
+    with open(path, "rb") as file:
+        file.seek(base + start)
+        data = file.read(stop - start)
+    return np.frombuffer(data, dtype=np.dtype(DT[entry["dtype"]])).reshape(
+        entry["shape"]
+    )
+
+
+def st_read_all(path) -> dict:
+    """{name: (dtype_str, ndarray)} of a file, the form st_write takes."""
+    header, _ = st_header(path)
+    return {
+        name: (entry["dtype"], st_read(path, name))
+        for name, entry in header.items()
+        if name != "__metadata__"
+    }
+
+
+def sha256_file(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as file:
+        for chunk in iter(lambda: file.read(1 << 22), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+# -- canonical VQ encoding (numpy definition) ---------------------------------
+
+
+def pack_bits(idx, bits):
+    """LE bitstream of `bits`-wide values, zero-padded to 16 bytes."""
+    idx = np.asarray(idx, dtype=np.uint32).ravel()
+    nbytes = -(-(idx.size * bits) // 8)
+    nbytes = -(-nbytes // 16) * 16
+    if bits == 8:
+        out = np.zeros(nbytes, np.uint8)
+        out[: idx.size] = idx
+        return out
+    b = (
+        ((idx[:, None] >> np.arange(bits, dtype=np.uint32)) & 1)
+        .astype(np.uint8)
+        .ravel()
+    )
+    b = np.concatenate([b, np.zeros(nbytes * 8 - b.size, np.uint8)])
+    return np.packbits(b, bitorder="little")
+
+
+def unpack_bits(rec, bits, count):
+    if bits == 8:
+        return rec[:count].astype(np.uint32)
+    b = np.unpackbits(rec, bitorder="little")[: count * bits]
+    b = b.reshape(count, bits).astype(np.uint32)
+    return (b << np.arange(bits, dtype=np.uint32)).sum(1)
+
+
+def vq_geometry(role, latent, dim, group):
+    """(rows, vectors per row, scales per row) of one I-block record."""
+    if role == "in_latent":
+        return 128, latent // dim, -(-latent // group)
+    return latent, 128 // dim, -(-128 // group)
+
+
+def vq_record_bytes(role, latent, dim, bits, group):
+    rows, vectors, _ = vq_geometry(role, latent, dim, group)
+    payload = (rows * vectors * bits + 7) // 8
+    return (payload + 15) // 16 * 16
+
+
+def vq_pack_matrix(idx, scale, role, inter, dim, bits, group):
+    """Pack idx [out, in/dim] and scale [out, in/group] to (records U8
+    [I/128, record bytes], scales F16 [I/128, n])."""
+    records, scales = [], []
+    for b in range(inter // 128):
+        if role == "in_latent":
+            i = idx[128 * b : 128 * b + 128, :]
+            s = scale[128 * b : 128 * b + 128, :]
+        else:
+            i = idx[:, (128 // dim) * b : (128 // dim) * (b + 1)]
+            s = scale[:, (128 // group) * b : (128 // group) * (b + 1)]
+        records.append(pack_bits(i, bits))
+        scales.append(np.asarray(s, np.float16).ravel())
+    return np.stack(records), np.stack(scales)
+
+
+def vq_unpack_matrix(records, scales, codebook, role, latent, dim, bits, group):
+    """Dequantize records [blocks, record bytes] to FP32 W[out, in] of those
+    blocks (in_latent: rows of W; out_latent: columns of W)."""
+    rows, vectors, groups = vq_geometry(role, latent, dim, group)
+    parts = []
+    for k in range(records.shape[0]):
+        i = unpack_bits(records[k], bits, rows * vectors).reshape(rows, vectors)
+        s = scales[k].astype(np.float32).reshape(rows, groups)
+        w = codebook.astype(np.float32)[i].reshape(rows, vectors * dim)
+        parts.append(w * np.repeat(s, group, axis=1)[:, : vectors * dim])
+    return np.concatenate(parts, axis=0 if role == "in_latent" else 1)
+
+
+def exl3_synthetic(out_f, in_f, bits, rng):
+    """Random but well-formed EXL3 constituents of a [out, in] matrix."""
+    k, n = -(-in_f // 128) * 128, -(-out_f // 128) * 128
+    return {
+        "trellis": (
+            "I16",
+            rng.integers(
+                -32768, 32767, size=(k // 16, n // 16, 16 * bits), dtype=np.int16
+            ),
+        ),
+        "suh": ("F16", rng.standard_normal(k).astype(np.float16)),
+        "svh": ("F16", rng.standard_normal(n).astype(np.float16)),
+        "mul1": ("I32", np.array(EXL3_MUL1, dtype=np.uint32).astype(np.int32)),
+    }
+
+
+# -- tensors of the tiny model -------------------------------------------------
+
+
+def _is_kda(text, layer):
+    return layer + 1 in text["linear_attn_config"]["kda_layers"]
+
+
+def dense_modules(text, layer) -> dict[str, tuple[int, int]]:
+    """EXL3 matrices of a decoder layer: module -> [out, in]."""
+    hidden = text["hidden_size"]
+    modules = {}
+    if _is_kda(text, layer):
+        kda = text["linear_attn_config"]
+        proj = kda["num_heads"] * kda["head_dim"]
+        for name in ("q_proj", "k_proj", "v_proj", "g_proj"):
+            modules[f"self_attn.{name}"] = (proj, hidden)
+        modules["self_attn.o_proj"] = (hidden, proj)
+    else:
+        heads = text["num_attention_heads"]
+        qk = text["qk_nope_head_dim"] + text["qk_rope_head_dim"]
+        modules["self_attn.q_a_proj"] = (text["q_lora_rank"], hidden)
+        modules["self_attn.q_b_proj"] = (heads * qk, text["q_lora_rank"])
+        modules["self_attn.kv_a_proj_with_mqa"] = (
+            text["kv_lora_rank"] + text["qk_rope_head_dim"],
+            hidden,
+        )
+        modules["self_attn.o_proj"] = (hidden, heads * text["v_head_dim"])
+        modules["self_attn.g_proj"] = (heads * text["v_head_dim"], hidden)
+    if layer < text["first_k_dense_replace"]:
+        inter = text["intermediate_size"]
+        modules["mlp.gate_proj"] = (inter, hidden)
+        modules["mlp.up_proj"] = (inter, hidden)
+        modules["mlp.down_proj"] = (hidden, inter)
+    else:
+        shared = text["num_shared_experts"] * text["moe_intermediate_size"]
+        latent = text["routed_expert_hidden_size"]
+        moe = "block_sparse_moe."
+        modules[moe + "shared_experts.gate_proj"] = (shared, hidden)
+        modules[moe + "shared_experts.up_proj"] = (shared, hidden)
+        modules[moe + "shared_experts.down_proj"] = (hidden, shared)
+        modules[moe + "routed_expert_down_proj"] = (latent, hidden)
+        modules[moe + "routed_expert_up_proj"] = (hidden, latent)
+    return modules
+
+
+def _bf16(rng, *shape):
+    # Small finite BF16 values (sign, exponent near 2**-7, random mantissa).
+    return "BF16", (
+        rng.integers(0, 2, shape) << 15 | 0x3C00 | rng.integers(0, 128, shape)
+    ).astype(np.uint16)
+
+
+def _f32(rng, *shape):
+    return "F32", (rng.standard_normal(shape) * 0.02).astype(np.float32)
+
+
+def plain_tensors(text, layer, rng) -> dict:
+    """Plain tensors of a decoder layer, original dtypes (request R1 and R1a)."""
+    hidden = text["hidden_size"]
+    tensors = {}
+    for name in (
+        "input_layernorm",
+        "post_attention_layernorm",
+        "mlp_res_norm",
+        "self_attention_res_norm",
+    ):
+        tensors[f"{name}.weight"] = _bf16(rng, hidden)
+    for name in ("mlp_res_proj", "self_attention_res_proj"):
+        tensors[f"{name}.weight"] = _bf16(rng, 1, hidden)
+    if _is_kda(text, layer):
+        kda = text["linear_attn_config"]
+        heads, dim = kda["num_heads"], kda["head_dim"]
+        proj = heads * dim
+        tensors["self_attn.f_a_proj.weight"] = _bf16(rng, dim, hidden)
+        tensors["self_attn.b_proj.weight"] = _bf16(rng, heads, hidden)
+        tensors["self_attn.f_b_proj.weight"] = _bf16(rng, proj, dim)
+        # The real checkpoint pads A_log with zeros to a multiple of 128
+        # (96 heads in a tensor of 128); the model's loader takes its heads.
+        a_log = np.zeros(-(-heads // 128) * 128, np.float32)
+        a_log[:heads] = _f32(rng, heads)[1]
+        tensors["self_attn.A_log"] = ("F32", a_log)
+        tensors["self_attn.dt_bias"] = _f32(rng, proj)
+        tensors["self_attn.o_norm.weight"] = _f32(rng, dim)
+        for name in ("q", "k", "v"):
+            tensors[f"self_attn.{name}_conv1d.weight"] = _f32(
+                rng, proj, 1, kda["short_conv_kernel_size"]
+            )
+    else:
+        heads = text["num_attention_heads"]
+        dsa = text["dsa_config"]
+        tensors["self_attn.kv_b_proj.weight"] = _bf16(
+            rng,
+            heads * (text["qk_nope_head_dim"] + text["v_head_dim"]),
+            text["kv_lora_rank"],
+        )
+        tensors["self_attn.q_a_layernorm.weight"] = _bf16(rng, text["q_lora_rank"])
+        tensors["self_attn.kv_a_layernorm.weight"] = _bf16(rng, text["kv_lora_rank"])
+        index = "self_attn.indexer."
+        tensors[index + "wq_b.weight"] = _bf16(
+            rng, dsa["index_num_heads"] * dsa["index_head_dim"], text["q_lora_rank"]
+        )
+        tensors[index + "wk.weight"] = _bf16(rng, dsa["index_head_dim"], hidden)
+        tensors[index + "weights_proj.weight"] = _bf16(
+            rng, dsa["index_num_heads"], hidden
+        )
+        tensors[index + "k_norm.weight"] = _f32(rng, dsa["index_head_dim"])
+        tensors[index + "k_norm.bias"] = _f32(rng, dsa["index_head_dim"])
+    if layer >= text["first_k_dense_replace"]:
+        moe = "block_sparse_moe."
+        tensors[moe + "gate.weight"] = _bf16(rng, text["num_experts"], hidden)
+        tensors[moe + "gate.e_score_correction_bias"] = _f32(rng, text["num_experts"])
+        tensors[moe + "routed_expert_norm.weight"] = _bf16(
+            rng, text["routed_expert_hidden_size"]
+        )
+    return tensors
+
+
+def vision_tensors(config, rng) -> dict:
+    """The vision file of the tiny model: tower and projector, plain BF16,
+    under the released names. The projector's linears are ``proj.0`` and
+    ``proj.2`` there and ``linear_1`` and ``linear_2`` in the model
+    (KimiK3ForConditionalGeneration.hf_to_vllm_mapper); q, k and v of a
+    tower block are one fused ``wqkv``."""
+    vision, text = config["vision_config"], config["text_config"]
+    hidden, inter = vision["vt_hidden_size"], vision["vt_intermediate_size"]
+    qkv, patch = vision["qkv_hidden_size"], vision["patch_size"]
+    tower = "vision_tower."
+    tensors = {
+        tower + "patch_embed.proj.weight": _bf16(rng, hidden, 3, patch, patch),
+        tower + "patch_embed.pos_emb.weight": _bf16(
+            rng, vision["init_pos_emb_height"], vision["init_pos_emb_width"], hidden
+        ),
+        tower + "encoder.final_layernorm.weight": _bf16(rng, hidden),
+    }
+    for block in range(vision["vt_num_hidden_layers"]):
+        base = f"{tower}encoder.blocks.{block}."
+        tensors[base + "norm0.weight"] = _bf16(rng, hidden)
+        tensors[base + "norm1.weight"] = _bf16(rng, hidden)
+        tensors[base + "mlp.fc0.weight"] = _bf16(rng, inter, hidden)
+        tensors[base + "mlp.fc1.weight"] = _bf16(rng, hidden, inter)
+        tensors[base + "wqkv.weight"] = _bf16(rng, 3 * qkv, hidden)
+        tensors[base + "wo.weight"] = _bf16(rng, hidden, qkv)
+    merge_h, merge_w = vision["merge_kernel_size"]
+    merged = hidden * merge_h * merge_w
+    tensors["mm_projector.proj.0.weight"] = _bf16(rng, merged, merged)
+    tensors["mm_projector.proj.2.weight"] = _bf16(rng, text["hidden_size"], merged)
+    tensors["mm_projector.post_norm.weight"] = _bf16(rng, text["hidden_size"])
+    return tensors
+
+
+def expert_rate(layer: int, projection: str = "w1") -> str:
+    """Codebook of a VQ layer's projection (LAYER_RATES, cycled past layer 4)."""
+    rates = LAYER_RATES[(layer - 1) % len(LAYER_RATES) + 1]
+    return rates[("w1", "w3", "w2").index(projection)]
+
+
+def write_checkpoint(
+    directory,
+    config=None,
+    seed=1,
+    exl3_expert_layers=EXL3_EXPERT_LAYERS,
+    vision=False,
+):
+    """Write a tiny k31q checkpoint; return {tensor base + "." + expert: FP32
+    matrix} for every VQ expert matrix (``<...>.experts.<w>.<E>``).
+    ``vision`` adds the vision file; without it the checkpoint is text-only,
+    as the lane's first builds are."""
+    directory = Path(directory)
+    directory.mkdir(parents=True, exist_ok=True)
+    config = config or tiny_config()
+    text = config["text_config"]
+    rng = np.random.default_rng(seed)
+    hidden, latent = text["hidden_size"], text["routed_expert_hidden_size"]
+    inter, experts = text["moe_intermediate_size"], text["num_experts"]
+    books = {
+        name: rng.standard_normal((1 << bits, dim)).astype(np.float16)
+        for name, (dim, bits, _) in RATES.items()
+    }
+    st_write(
+        directory / "codebooks.safetensors",
+        {f"vq.{name}": ("F16", book) for name, book in books.items()},
+    )
+    manifest = {
+        "format": "k31q",
+        "version": 1,
+        "source": {"repo": "synthetic", "revision": f"seed{seed}"},
+        "abliteration": {"applied": False},
+        "codebooks": {
+            name: {"dim": dim, "index_bits": bits, "entries": 1 << bits}
+            for name, (dim, bits, _) in RATES.items()
+        },
+        "layers": {},
+        "other": {},
+    }
+    index, reference = {}, {}
+    for layer in range(text["num_hidden_layers"]):
+        prefix = f"{P}layers.{layer}."
+        tensors = {}
+        entry = {"dense": {}, "experts": {}}
+        for name, (out_f, in_f) in dense_modules(text, layer).items():
+            bits = 6 if "o_proj" in name or "shared" in name else 5
+            for suffix, value in exl3_synthetic(out_f, in_f, bits, rng).items():
+                tensors[f"{prefix}{name}.{suffix}"] = value
+            entry["dense"][name] = {
+                "method": "exl3",
+                "bits": bits,
+                "shape": [out_f, in_f],
+            }
+        for name, value in plain_tensors(text, layer, rng).items():
+            tensors[prefix + name] = value
+        if layer >= text["first_k_dense_replace"]:
+            base = f"{prefix}block_sparse_moe.experts"
+            for w, role in PROJECTIONS:
+                out_f, in_f = (
+                    (inter, latent) if role == "in_latent" else (latent, inter)
+                )
+                if layer in exl3_expert_layers:
+                    for expert in range(experts):
+                        matrix = exl3_synthetic(out_f, in_f, EXL3_EXPERT_BITS, rng)
+                        for suffix, value in matrix.items():
+                            tensors[f"{base}.{expert}.{w}.{suffix}"] = value
+                    entry["experts"][w] = {
+                        "method": "exl3",
+                        "bits": EXL3_EXPERT_BITS,
+                        "shape": [out_f, in_f],
+                    }
+                    continue
+                rate = expert_rate(layer, w)
+                dim, bits, group = RATES[rate]
+                records, scales = [], []
+                for expert in range(experts):
+                    idx = rng.integers(0, 1 << bits, size=(out_f, in_f // dim))
+                    scale = (0.02 + 0.01 * rng.random((out_f, in_f // group))).astype(
+                        np.float16
+                    )
+                    r, s = vq_pack_matrix(idx, scale, role, inter, dim, bits, group)
+                    records.append(r)
+                    scales.append(s)
+                    reference[f"{base}.{w}.{expert}"] = books[rate].astype(np.float32)[
+                        idx
+                    ].reshape(out_f, in_f) * np.repeat(
+                        scale.astype(np.float32), group, 1
+                    )
+                tensors[f"{base}.{w}.vq_idx"] = ("U8", np.stack(records))
+                tensors[f"{base}.{w}.vq_scale"] = ("F16", np.stack(scales))
+                entry["experts"][w] = {
+                    "method": "vq",
+                    "codebook": rate,
+                    "dim": dim,
+                    "index_bits": bits,
+                    "vec_axis": "in",
+                    "group_size": group,
+                    "group_axis": "in",
+                    "shape": [out_f, in_f],
+                    "record_bytes": int(records[0].shape[1]),
+                    "bpw_all_in": bits / dim + 16 / group,
+                }
+        name = f"layer-{layer:03d}.safetensors"
+        st_write(directory / name, tensors)
+        entry.update(
+            file=[name],
+            bytes=os.path.getsize(directory / name),
+            sha256=[sha256_file(directory / name)],
+        )
+        manifest["layers"][str(layer)] = entry
+        index.update({key: name for key in tensors})
+    vocab = text["vocab_size"]
+    embed = {P + "embed_tokens.weight": _bf16(rng, vocab, hidden)}
+    head = {
+        P + "norm.weight": _bf16(rng, hidden),
+        P + "output_attn_res_norm.weight": _bf16(rng, hidden),
+        P + "output_attn_res_proj.weight": _bf16(rng, 1, hidden),
+    }
+    for suffix, value in exl3_synthetic(vocab, hidden, 6, rng).items():
+        head[f"{ROOT}lm_head.{suffix}"] = value
+    files = {"embed.safetensors": embed, "head.safetensors": head}
+    if vision:
+        files[VISION_FILE] = vision_tensors(config, rng)
+    for name, tensors in files.items():
+        st_write(directory / name, tensors)
+        index.update({key: name for key in tensors})
+    index.update({f"vq.{name}": "codebooks.safetensors" for name in books})
+    for name in (*files, "codebooks.safetensors"):
+        manifest["other"][name] = {
+            "bytes": os.path.getsize(directory / name),
+            "sha256": sha256_file(directory / name),
+        }
+    (directory / "k31q_manifest.json").write_text(json.dumps(manifest, indent=1))
+    (directory / "model.safetensors.index.json").write_text(
+        json.dumps({"metadata": {"format": "k31q"}, "weight_map": index})
+    )
+    (directory / "config.json").write_text(json.dumps(config))
+    return reference
+
+
+def build_views(source, root, partition, tag="k31", drafter=False) -> list[Path]:
+    """Per-stage views (the lane tool bin/k31q_views.py): ``root/<tag>-s<k>``
+    holds symlinks to the stage's layer files, the codebooks and the config,
+    the embedding on stage 0 (and on the last stage with a drafter), the
+    vision file on stage 0 when the checkpoint has one (the wrapper builds
+    the tower there only), the head on the last stage, and an index and a
+    manifest filtered to those files."""
+    source, root = Path(source), Path(root)
+    manifest = json.loads((source / "k31q_manifest.json").read_text())
+    index = json.loads((source / "model.safetensors.index.json").read_text())
+    if sum(partition) != len(manifest["layers"]):
+        raise ValueError("partition does not cover the checkpoint's layers")
+    views, first = [], 0
+    for stage, count in enumerate(partition):
+        layers = range(first, first + count)
+        first += count
+        files = {f for layer in layers for f in manifest["layers"][str(layer)]["file"]}
+        files.add("codebooks.safetensors")
+        if stage == 0:
+            files.add("embed.safetensors")
+            if (source / VISION_FILE).exists():
+                files.add(VISION_FILE)
+        if stage == len(partition) - 1:
+            files.add("head.safetensors")
+            if drafter:
+                files.add("embed.safetensors")
+        view = root / f"{tag}-s{stage}"
+        view.mkdir(parents=True, exist_ok=True)
+        for entry in sorted(os.listdir(source)):
+            path = source / entry
+            if path.is_dir() or entry in (
+                "model.safetensors.index.json",
+                "k31q_manifest.json",
+            ):
+                continue
+            if entry.endswith(".safetensors") and entry not in files:
+                continue
+            os.symlink(path, view / entry)
+        sub_index = dict(index)
+        sub_index["weight_map"] = {
+            name: file for name, file in index["weight_map"].items() if file in files
+        }
+        (view / "model.safetensors.index.json").write_text(json.dumps(sub_index))
+        sub = dict(manifest)
+        sub["layers"] = {str(layer): manifest["layers"][str(layer)] for layer in layers}
+        sub["other"] = {f: v for f, v in manifest["other"].items() if f in files}
+        sub["stage"] = {
+            "index": stage,
+            "of": len(partition),
+            "first_layer": layers[0],
+            "last_layer": layers[-1],
+        }
+        (view / "k31q_manifest.json").write_text(json.dumps(sub))
+        views.append(view)
+    return views
+
+
+def edit_file(directory, name, mutate) -> None:
+    """Rewrite one safetensors file of a checkpoint after ``mutate(tensors)``
+    changed its {name: (dtype, array)} in place, and bring the manifest's
+    byte count and digest and the index in line (so a test breaks exactly
+    what it means to break)."""
+    directory = Path(directory)
+    path = directory / name
+    tensors = st_read_all(path)
+    mutate(tensors)
+    if path.is_symlink():
+        path.unlink()
+    st_write(path, tensors)
+    manifest_path = directory / "k31q_manifest.json"
+    manifest = json.loads(manifest_path.read_text())
+    for entry in manifest["layers"].values():
+        if name in entry["file"]:
+            entry["bytes"] = sum(os.path.getsize(directory / f) for f in entry["file"])
+            entry["sha256"] = [sha256_file(directory / f) for f in entry["file"]]
+    if name in manifest["other"]:
+        manifest["other"][name] = {
+            "bytes": os.path.getsize(path),
+            "sha256": sha256_file(path),
+        }
+    manifest_path.write_text(json.dumps(manifest))
+    index_path = directory / "model.safetensors.index.json"
+    index = json.loads(index_path.read_text())
+    index["weight_map"] = {
+        key: file for key, file in index["weight_map"].items() if file != name
+    }
+    index["weight_map"].update({key: name for key in tensors})
+    index_path.write_text(json.dumps(index))
+
+
+def edit_manifest(directory, mutate) -> None:
+    path = Path(directory) / "k31q_manifest.json"
+    manifest = json.loads(path.read_text())
+    mutate(manifest)
+    path.write_text(json.dumps(manifest))
+
+
+def copy_checkpoint(source, target) -> Path:
+    """A private copy of a checkpoint directory for a test that breaks it."""
+    import shutil
+
+    shutil.copytree(source, target)
+    return Path(target)
