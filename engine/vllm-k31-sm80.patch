+def test_target_argmax_direct_four_rank_gloo_tp_ties_and_nans(tmp_path):
+    """Verify 4-rank Gloo TP direct int64 fast path matches dense argmax_rows
+    and gathered compute_logits across cross-rank ties, signed zeros, -inf,
+    NaN rows, and NaN/+inf padding columns."""
+    script = f"""
+import json, os
+from types import SimpleNamespace
+import numpy as np
+import torch
+import torch.distributed as dist
+import torch.multiprocessing as mp
+from tests.models.deepseek_v41.sm80.test_target_shard_argmax import (
+    cpu_buffers,
+    make_batch,
+    make_sampler,
+)
+from tests.models.kimi_k3.sm80.test_k31_opt_py_fastpaths import _make_rejection_sampler
+from vllm.models.deepseek_v41.nvidia.sm80_model import DeepseekV41ForCausalLM
+from vllm.sampling_params import SamplingParams
+from vllm.sm80.spec_decode import shard_argmax as sa
+from vllm.sm80.worker import target_argmax as ta
+from vllm.sm80.worker.graph_mem_worker import runner_cls
+
+def rank_worker(rank, tp, init_file, out_file):
+    cpu_buffers()
+    device = torch.device("cpu")
+    dist.init_process_group("gloo", init_method=f"file://{{init_file}}", rank=rank, world_size=tp)
+    sa.BLOCK = 8
+    vocab, width = 97, 25
+    pad = tp * width - vocab
+
+    def all_reduce(t):
+        f = t.float().cpu()
+        dist.all_reduce(f)
+        return f.to(device=t.device, dtype=t.dtype)
+
+    ta.tensor_model_parallel_all_reduce = all_reduce
+
+    g = torch.Generator().manual_seed(42)
+    per_req = 4
+    num_reqs = 4
+    full = torch.randint(-2, 3, (num_reqs * per_req, vocab), generator=g).float()
+    # Row 0: signed zeros tie across ranks
+    full[0] = torch.where(torch.arange(vocab) % 2 == 0, -0.0, 0.0)
+    # Row 5: NaN in rank 2 shard -> torch.argmax picks first NaN
+    full[5, 53] = float("nan")
+    full[5, 70] = float("nan")
+    # Row 9: all -inf
+    full[9].fill_(float("-inf"))
+
+    ref = torch.argmax(full, dim=-1)
+    ids = torch.zeros(full.shape[0], dtype=torch.long)
+    for r in range(num_reqs):
+        miss = r  # r=0 all accept, r=1..3 miss at j=1..3
+        for j in range(1, per_req):
+            t = int(ref[r * per_req + j - 1])
+            ids[r * per_req + j] = (t + 1) % vocab if j == miss else t
+
+    junk = torch.tensor([float("nan"), float("inf")]).repeat(pad)[:pad]
+    padded = torch.cat([full, junk.expand(full.shape[0], pad)], dim=1)
+
+    def build_model():
+        m = DeepseekV41ForCausalLM.__new__(DeepseekV41ForCausalLM)
+        torch.nn.Module.__init__(m)
+        m.language_model = SimpleNamespace(
+            lm_head=SimpleNamespace(tp_rank=rank, tp_size=tp),
+            logits_processor=SimpleNamespace(org_vocab_size=vocab, logits_as_input=False),
+            compute_logits=lambda h: full[h[:, 0].long()],
+            compute_logits_local=lambda h: padded[h[:, 0].long(), rank * width : (rank + 1) * width],
+        )
+        return m
+
+    greedy = SamplingParams(temperature=0.0)
+    arms = {{}}
+    for name, dsw in [("dense", "0"), ("direct", "1")]:
+        os.environ[ta.SWITCH] = "1"
+        os.environ[ta.DIRECT_SWITCH] = dsw
+        sampler = make_sampler(device, [greedy] * num_reqs, vocab)
+        rej = _make_rejection_sampler(sampler, device)
+        cls = runner_cls()
+        runner = cls.__new__(cls)
+        runner.__dict__.update(
+            model=build_model(),
+            sampler=sampler,
+            rejection_sampler=rej,
+            speculator=SimpleNamespace(draft_logits=None),
+            batch_sharder=None,
+            structured_outputs_worker=None,
+            lora_config=None,
+            masked_token_ids=None,
+            vocab_size=vocab,
+            is_last_pp_rank=True,
+        )
+        runner.model_state = SimpleNamespace(compute_sample_logits=runner.model.compute_logits)
+        hidden = torch.arange(full.shape[0], dtype=torch.float32)[:, None]
+        out, ns, nr = runner.sample(hidden, make_batch(num_reqs, per_req, ids, device), None)
+        toks = [row[:k] for row, k in zip(out.sampled_token_ids.tolist(), ns.tolist())]
+        arms[name] = {{"tokens": toks, "ns": ns.tolist(), "nr": nr.tolist()}}
+
+    assert arms["direct"] == arms["dense"]
+    with open(out_file, "w") as f:
+        json.dump(arms["direct"], f)
+    dist.destroy_process_group()
+
+if __name__ == "__main__":
+    tp = 4
+    init_f = os.path.join({str(tmp_path)!r}, "gloo_init")
+    outs = [os.path.join({str(tmp_path)!r}, f"r{{r}}.json") for r in range(tp)]
+    ctx = mp.get_context("spawn")
+    procs = [ctx.Process(target=rank_worker, args=(r, tp, init_f, outs[r])) for r in range(tp)]
+    for p in procs:
+        p.start()
+    for p in procs:
+        p.join(120)
+        assert p.exitcode == 0, p.exitcode
+    loaded = [json.load(open(f)) for f in outs]
+    for r in range(1, tp):
+        assert loaded[r] == loaded[0]
+    print("RESULT " + json.dumps({{"ns": loaded[0]["ns"], "nr": loaded[0]["nr"]}}))
+"""
+    script_file = tmp_path / "run_gloo_tp4.py"
+    script_file.write_text(script, encoding="utf-8")
+    env = dict(os.environ, TRITON_INTERPRET="1", CUDA_VISIBLE_DEVICES="")
+    done = subprocess.run(
+        [sys.executable, str(script_file)],
+        cwd=ROOT,
