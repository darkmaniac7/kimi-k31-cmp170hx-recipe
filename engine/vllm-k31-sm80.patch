+def test_ev_tool_end_to_end_on_a_synthetic_dump(tmp_path, monkeypatch, capsys):
+    import json
+
+    ev, repo = _load_ev_tool()
+    for f in range(4):
+        _synthetic_dump(tmp_path / f"w{f}.npz", anchors=48, first_pos=100 * f, seed=f)
+    out = tmp_path / "ev.json"
+    monkeypatch.setattr(
+        "sys.argv",
+        ["dspark_tree_ev.py", "--glob", str(tmp_path / "w*.npz"), "--repo", str(repo),
+         "--boot", "20", "--out-json", str(out)],
+    )
+    ev.main()
+    res = json.loads(out.read_text())["prose"]
+    assert res["anchors"] == 192 and res["trajectory_windows"] == 4
+    pol = res["policies"]
+    # More rows never accept fewer tokens on the same anchors.
+    for fam in ("lin", "dyn"):
+        vals = [pol[f"{fam}{n}"]["tok_step_uniform"] for n in range(1, 8)]
+        assert vals == sorted(vals) and 1.0 <= vals[0] <= 2.0
+    # One row is one row, whoever picks it.
+    assert pol["dyn1"]["tok_step_uniform"] == pytest.approx(
+        pol["lin1"]["tok_step_uniform"], abs=0.05
+    )
+    # With exact probabilities the most likely nodes beat the chain of that size.
+    assert pol["dyn7"]["tok_step_uniform"] > pol["lin7"]["tok_step_uniform"]
+    assert pol["dyn7"]["tok_step"] > pol["lin7"]["tok_step"]
+    assert pol["dyn_adapt"]["tok_s"] > 0 and pol["dps_tree"]["tok_s"] > 0
+    assert set(res["gain_pct"]) >= {"dyn_adapt_vs_lin_dyn", "dps_tree_vs_dps"}
+    assert len(res["chain_survival_trajectory"]) == 8
+    assert "trajectory windows" in capsys.readouterr().out
