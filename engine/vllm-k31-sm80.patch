+def test_fold_graph_replay_is_bitwise_without_allocations(synthetic, rows):
+    exl3_ops.warmup_moe_v2(
+        synthetic.pointers,
+        synthetic.meta,
+        synthetic.expert_map,
+        list(range(h5120.LOCAL)),
+        h5120.HIDDEN,
+        h5120.INTERMEDIATE,
