+def test_strong_suffix_match_overrides_and_widens_adaptive_k(monkeypatch):
+    inst, suffix = _make_hybrid(monkeypatch, min_match_len=4, conf_floor=0.90)
+    # DSpark has low confidence (expected accepted ~1.0 -> Adaptive-K tier 3).
+    inst.draft_tokens[:1] = torch.arange(10, 22, dtype=torch.int64)
+    inst.draft_token_confidence_probs[:1] = torch.tensor(
+        [[0.6, 0.4, 0.2] + [0.1] * 9], dtype=torch.float32
+    )
+    # Suffix has a long 10-token match covering all 12 draft positions.
+    sfx_toks = list(range(500, 512))
+    suffix.set_match(0, 0, sfx_toks, match_len=10, bucket=6)
+
+    cfg = AdaptiveKConfig.from_dict(
+        {
+            "tiers": [3, 5, 7, 9, 12],
+            "confidence": {
+                "thresholds": [1.5, 2.5, 3.5, 4.5],
+                "hysteresis": 0.0,
+                "accept_weight": 0.0,
+            },
+        },
+        12,
+    )
+    policy = AdaptiveKPolicy(cfg)
+    policy._steps["r"] = 1
+    policy.observe_confidence("r", 1, inst.draft_token_confidence_probs[0].tolist())
+    assert policy.select_by_confidence(["r"], 12) == 3
+
+    out = _call_propose(inst, [0])
+    assert out[0].tolist() == sfx_toks
+    assert bool(inst._last_suffix_used[0])
+    assert suffix.last_bucket[0].item() == 6  # preserved for online suffix stats
+
+    # Boosted suffix confidences push Adaptive-K straight to K=12!
+    policy._steps["r"] = 2
+    policy.observe_confidence("r", 2, inst.draft_token_confidence_probs[0].tolist())
+    assert policy.select_by_confidence(["r"], 12) == 12
+
