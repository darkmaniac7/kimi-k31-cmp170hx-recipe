+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Offline EXL3 K6 quantizer for Qwen3 DSpark draft checkpoints.
+
+Converts a BF16 Inferact/Kimi-K3.1-Pro-DSpark checkpoint (stock or
+self-distilled) into a drop-in ``k31q_dspark_exl3`` checkpoint directory:
+  - Quantizes all 128-aligned large linear projections (``fc``, every layer's
+    ``q_proj``, ``k_proj``, ``v_proj``, ``o_proj``, ``gate_proj``, ``up_proj``,
+    ``down_proj``, and full-vocabulary ``markov_head.markov_w2``) to EXL3 K6
+    (``bits=6``, ``bits_x2=12``, codebook ``mul1`` = ``0x83DCD12D``), matching
+    ``_k31_dense_C`` (``linear_out_k31_multi``) and ``Exl3Manifest``.
+  - Preserves all RMSNorm weights, ``markov_head.markov_w1.weight``,
+    ``confidence_head.proj.{weight,bias}``, and any non-128-aligned tensors as
+    plain BF16.
+  - Writes ``model.safetensors``, updated ``config.json`` with
+    ``quantization_config``, and ``k31q_dspark_manifest.json`` with SHA-256,
+    per-tensor SQNR, and exact TP1/TP2 VRAM footprint and Stage-3 reclaim.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import math
+import os
+import re
+import shutil
+import struct
+import time
+from functools import lru_cache
+from pathlib import Path
+from typing import Any
+
+import torch
+from safetensors import safe_open
+from safetensors.torch import save_file
+
+FORMAT = "k31q_dspark_exl3"
+VERSION = 1
+BITS = 6
+BITS_X2 = 12
+CODEBOOK = "mul1"
+CODEBOOK_SCALE = 1.24371088
+MUL1_U32 = 0x83DCD12D
+MUL1_I32 = struct.unpack("<i", struct.pack("<I", MUL1_U32))[0]
+
+_QUANTIZABLE_EXACT = frozenset(
+    {
+        "fc.weight",
+        "markov_head.markov_w2.weight",
+    }
+)
+_QUANTIZABLE_LAYER_RE = re.compile(
+    r"^layers\.\d+\.(?:self_attn\.(?:q|k|v|o)_proj|mlp\.(?:gate|up|down)_proj)\.weight$"
+)
+_DEFAULT_QUANT_EXT_CANDIDATES = (
+    "/tmp/gem-k31/build_q/_k31_quant.so",
+    )
+
+
+def is_quantizable_dspark_tensor(name: str, shape: tuple[int, ...]) -> bool:
+    """Return True iff ``name`` is one of the 128-aligned DSpark linear weights."""
+    if len(shape) != 2:
+        return False
+    out_dim, in_dim = int(shape[0]), int(shape[1])
+    if out_dim <= 0 or in_dim <= 0 or (out_dim % 128) != 0 or (in_dim % 128) != 0:
+        return False
+    return name in _QUANTIZABLE_EXACT or bool(_QUANTIZABLE_LAYER_RE.match(name))
+
+
+def _is_tp_sharded_linear(name: str) -> str:
+    """Return TP2 cut mode for VRAM accounting: 'outputs', 'inputs', or 'whole'."""
+    if name in ("fc.weight", "markov_head.markov_w2.weight"):
+        return "whole"
+    if any(
+        s in name
+        for s in (
+            ".q_proj.",
+            ".k_proj.",
+            ".v_proj.",
+            ".gate_proj.",
+            ".up_proj.",
+        )
+    ):
+        return "outputs"
+    if any(s in name for s in (".o_proj.", ".down_proj.")):
+        return "inputs"
+    return "whole"
+
+
+def _exl3_packed_bytes(out_dim: int, in_dim: int, bits_x2: int = BITS_X2) -> int:
+    """Runtime GPU parameter bytes (trellis I16 + suh F16 + svh F16)."""
+    return 2 * ((in_dim // 16) * (out_dim // 16) * 8 * bits_x2 + in_dim + out_dim)
+
+
+def compute_vram_summary(
+    quant_shapes: dict[str, tuple[int, int]],
+    plain_shapes: dict[str, tuple[int, ...]],
+) -> dict[str, int]:
+    """Exact runtime VRAM footprint (bytes) for TP1 and TP2 per rank.
+
+    Matches vLLM runtime storage: all BF16 weights take 2 B/param except
+    ``confidence_head.proj.{weight,bias}`` which run in FP32 (4 B/param).
+    EXL3 K6 matrices take ``2 * ((k/16)*(n/16)*96 + k + n)`` bytes per rank
+    after TP2 H128 sharding of the 5 Qwen3 GQA layers.
+    """
+    plain_bytes = 0
+    for name, shape in plain_shapes.items():
+        numel = math.prod(shape) if shape else 1
+        elem = 4 if name.startswith("confidence_head.proj.") else 2
+        plain_bytes += numel * elem
+
+    tp1_bf16 = plain_bytes
+    tp1_k6 = plain_bytes
+    tp2_bf16 = plain_bytes
+    tp2_k6 = plain_bytes
+
+    for name, (out_dim, in_dim) in quant_shapes.items():
+        tp1_bf16 += out_dim * in_dim * 2
+        tp1_k6 += _exl3_packed_bytes(out_dim, in_dim, BITS_X2)
+        cut = _is_tp_sharded_linear(name)
+        if cut == "outputs":
+            local_out, local_in = out_dim // 2, in_dim
+        elif cut == "inputs":
+            local_out, local_in = out_dim, in_dim // 2
+        else:
+            local_out, local_in = out_dim, in_dim
+        tp2_bf16 += local_out * local_in * 2
+        tp2_k6 += _exl3_packed_bytes(local_out, local_in, BITS_X2)
+
+    return {
+        "tp1_bf16": tp1_bf16,
+        "tp1_k6": tp1_k6,
+        "tp1_reclaim": tp1_bf16 - tp1_k6,
+        "tp2_per_rank_bf16": tp2_bf16,
+        "tp2_per_rank_k6": tp2_k6,
+        "tp2_per_rank_reclaim": tp2_bf16 - tp2_k6,
+    }
+
+
+@lru_cache(maxsize=8)
+def _get_hadamard(n: int, device_str: str) -> torch.Tensor:
+    h = torch.tensor([[1.0]], dtype=torch.float32)
+    while h.shape[0] < n:
+        h = torch.cat([torch.cat([h, h], dim=1), torch.cat([h, -h], dim=1)], dim=0)
+    h = h / math.sqrt(n)
+    return h.to(device=device_str, dtype=torch.float32).contiguous()
+
+
+@lru_cache(maxsize=8)
+def _tensor_core_perm(device_str: str) -> torch.Tensor:
+    perm_a = [0] * 256
+    for t in range(32):
+        r0 = (t % 4) * 2
+        r1 = r0 + 1
+        r2 = r0 + 8
+        r3 = r0 + 9
+        c0 = t // 4
+        c1 = c0 + 8
+        perm_a[t * 8 + 0] = r0 * 16 + c0
+        perm_a[t * 8 + 1] = r1 * 16 + c0
+        perm_a[t * 8 + 2] = r2 * 16 + c0
+        perm_a[t * 8 + 3] = r3 * 16 + c0
+        perm_a[t * 8 + 4] = r0 * 16 + c1
+        perm_a[t * 8 + 5] = r1 * 16 + c1
+        perm_a[t * 8 + 6] = r2 * 16 + c1
+        perm_a[t * 8 + 7] = r3 * 16 + c1
+    return torch.tensor(perm_a, dtype=torch.long, device=device_str)
+
+
+@lru_cache(maxsize=8)
+def _tensor_core_perm_i(device_str: str) -> torch.Tensor:
+    return torch.argsort(_tensor_core_perm(device_str))
+
+
+def _had_l(x: torch.Tensor, had_dim: int = 128) -> torch.Tensor:
+    k, n = x.shape
+    h = _get_hadamard(had_dim, str(x.device))
+    return (h @ x.view(-1, had_dim, n)).view(k, n)
+
+
+def _had_r(x: torch.Tensor, had_dim: int = 128) -> torch.Tensor:
+    k, n = x.shape
+    h = _get_hadamard(had_dim, str(x.device))
+    return (x.view(k, -1, had_dim) @ h).view(k, n)
+
+
+def _sample_scale_tiles(weight_r: torch.Tensor, width: int = 3) -> torch.Tensor:
+    device = weight_r.device
+    tiles_k = weight_r.shape[0] // 16
+    tiles_n = weight_r.shape[1] // 16
+    w4 = weight_r.view(tiles_k, 16, tiles_n, 16)
+    diag_len = max(tiles_k, tiles_n)
+    ii = torch.arange(diag_len, device=device).repeat_interleave(width)
+    ww = torch.arange(width, device=device).repeat(diag_len)
+    kk = ii % tiles_k
+    nn_idx = (ii + ww) % tiles_n
+
+    num_x = max(8, (diag_len * width) // 16)
+    tile_ms = w4.square().mean(dim=(1, 3)).flatten()
+    num_x = min(num_x, (tile_ms.shape[0] + 1) // 2)
+    hi = torch.topk(tile_ms, num_x).indices
+    lo = torch.topk(tile_ms, num_x, largest=False).indices
+    xk = torch.cat((hi, lo)) // tiles_n
+    xn = torch.cat((hi, lo)) % tiles_n
+    tiles = w4[torch.cat((kk, xk)), :, torch.cat((nn_idx, xn)), :].reshape(-1, 256)
+    return tiles[:, _tensor_core_perm(str(device))].contiguous()
+
+
+def _g_scale_search(
+    ext: Any, temp_k: torch.Tensor, weight_r: torch.Tensor, bits: int
+) -> float:
+    tiles = _sample_scale_tiles(weight_r, width=3)
+    q_buf = torch.empty_like(tiles)
+    i_buf = torch.empty(tiles.shape, dtype=torch.int16, device=tiles.device)
+
+    def eval_scale(t_set: torch.Tensor, s: float) -> float:
+        inp = (t_set * s).contiguous()
+        ext.quantize_tiles_mul1(
+            inp, q_buf[: inp.shape[0]], i_buf[: inp.shape[0]], temp_k, bits
+        )
+        return float((q_buf[: inp.shape[0]] / s - t_set).square().mean().item())
+
+    sub = tiles[::3].contiguous()
+    coarse = [0.2 + 0.2 * i for i in range(9)]
+    best_c = min(coarse, key=lambda s: eval_scale(sub, s))
+    step = 0.075
+    fine = [max(0.05, best_c + step * (i - 2)) for i in range(5)]
+    mses = [eval_scale(tiles, s) for s in fine]
+    best = min(range(5), key=lambda i: mses[i])
+    if 0 < best < 4:
+        y0, y1, y2 = mses[best - 1], mses[best], mses[best + 1]
+        denom = y0 - 2.0 * y1 + y2
+        off = 0.5 * (y0 - y2) / denom if denom > 0 else 0.0
+        off = max(-0.5, min(0.5, off))
+    else:
+        off = 0.0
+    return max(fine[best] + off * step, 0.05)
+
+
+def load_quant_extension(quant_ext_path: str | None = None) -> Any:
+    """Load prebuilt ``_k31_quant.so`` CUDA trellis encoder extension."""
+    candidates: list[str] = []
+    if quant_ext_path:
+        candidates.append(quant_ext_path)
+    env_path = os.getenv("K31_QUANT_EXT", "")
+    if env_path:
+        candidates.append(env_path)
+    candidates.extend(_DEFAULT_QUANT_EXT_CANDIDATES)
+    for cand in candidates:
+        p = Path(cand)
+        if p.is_file():
+            spec = importlib.util.spec_from_file_location("_k31_quant", str(p))
+            assert spec is not None and spec.loader is not None
+            mod = importlib.util.module_from_spec(spec)
+            spec.loader.exec_module(mod)
+            return mod
+    raise FileNotFoundError(
+        "Could not locate _k31_quant.so CUDA trellis encoder. "
+        "Pass --quant-ext /path/to/_k31_quant.so or set K31_QUANT_EXT."
+    )
+
+
+@torch.no_grad()
+def quantize_exl3_k6_matrix(
+    ext: Any,
+    temp_k: torch.Tensor,
+    weight_out_in: torch.Tensor,
+    *,
+    bits: int = BITS,
+    seed: int = 7000,
+    verify_ref: bool = False,
+) -> tuple[dict[str, torch.Tensor], dict[str, float]]:
+    """Quantize BF16/FP32 [out_dim, in_dim] to EXL3 K6 mul1 tensors on GPU."""
+    device = weight_out_in.device
+    dev_s = str(device)
+    logical_out, logical_in = int(weight_out_in.shape[0]), int(weight_out_in.shape[1])
+    if logical_out % 128 != 0 or logical_in % 128 != 0:
+        raise ValueError(
+            f"EXL3 DSpark matrix must be 128-aligned, got {(logical_out, logical_in)}"
+        )
+
+    w_orig = weight_out_in.float()
+    w = w_orig.T.contiguous()  # [k, n] = [in, out]
+    k, n = w.shape
+
+    g = torch.Generator(device=device)
+    g.manual_seed(seed)
+    su_signs = (
+        (torch.randn(k, generator=g, device=device).sign() + 1e-5).sign().view(k, 1)
+    )
+    sv = (torch.randn(n, generator=g, device=device).sign() + 1e-5).sign().view(1, n)
+
+    out_rms = w.square().mean(dim=0, keepdim=True).sqrt()
+    mean_out = float(out_rms.mean().item())
+    out_scales = out_rms / mean_out if mean_out > 1e-30 else torch.ones_like(out_rms)
+    zero_out = out_scales.abs() < 1e-30
+    out_scales_safe = out_scales.clone()
+    out_scales_safe[zero_out] = 0.1
+    sv = sv * out_scales_safe + 1e-10
+    w.div_(sv)
+    sv = sv.clone()
+    sv[zero_out] = 0.0
+    w = _had_r(w, 128)
+
+    in_scales = w.square().mean(dim=1, keepdim=True).sqrt()
+    in_scales[in_scales.abs() < 1e-30] = 0.1
+    su = su_signs * in_scales / (-CODEBOOK_SCALE) + 1e-10
+    w.div_(su)
+    w = _had_l(w, 128)
+
+    g_scale = _g_scale_search(ext, temp_k, w, bits)
+    w.mul_(g_scale)
+    su = su / g_scale
+
+    tiles_k, tiles_n = k // 16, n // 16
+    perm = _tensor_core_perm(dev_s)
+    perm_i = _tensor_core_perm_i(dev_s)
+
+    tiles = (
+        w.view(tiles_k, 16, tiles_n, 16)
+        .permute(0, 2, 1, 3)
+        .reshape(tiles_k * tiles_n, 256)
+    )
+    del w
+    tiles = tiles[:, perm].contiguous()
+    q_tiles = torch.empty_like(tiles)
+    q_idx = torch.empty(tiles.shape, dtype=torch.int16, device=device)
+    ext.quantize_tiles_mul1(tiles, q_tiles, q_idx, temp_k, bits)
+    del tiles
+
+    trellis = ext.pack_trellis(q_idx.view(tiles_k, tiles_n, 256).contiguous(), bits)
+    del q_idx
+    suh = su.flatten().to(torch.float16).contiguous()
+    svh = sv.flatten().to(torch.float16).contiguous()
+    mul1 = torch.tensor(MUL1_I32, dtype=torch.int32)
+
+    core_enc = (
+        q_tiles[:, perm_i]
+        .view(tiles_k, tiles_n, 16, 16)
+        .permute(0, 2, 1, 3)
+        .reshape(k, n)
+        .contiguous()
+    )
+    del q_tiles
+
+    ref_max_diff = 0.0
+    if verify_ref:
+        core_ref = ext.dequant_trellis_core_ref(trellis, bits)
+        ref_max_diff = float((core_ref - core_enc).abs().max().item())
+        del core_ref
+        if ref_max_diff > 1e-6:
+            raise RuntimeError(
+                f"pack_trellis round-trip check failed: max_diff={ref_max_diff}"
+            )
+
+    # Reconstruct exact FP16-scale dequantized matrix to measure SQNR.
+    w_rec = _had_l(core_enc, 128)
+    del core_enc
+    w_rec.mul_(suh.float().view(k, 1))
+    w_rec = _had_r(w_rec, 128)
+    w_rec.mul_(svh.float().view(1, n))
+    sig = float(w_orig.square().sum(dtype=torch.float64).item())
+    err = float((w_orig - w_rec.T).square().sum(dtype=torch.float64).item())
+    del w_rec
+    sqnr_db = 99.99 if err <= 0.0 else 10.0 * math.log10(max(sig, 1e-30) / err)
+
+    packed = {
+        "trellis": trellis.cpu().contiguous(),
+        "suh": suh.cpu().contiguous(),
+        "svh": svh.cpu().contiguous(),
+        "mul1": mul1,
+    }
+    stats = {
+        "sqnr_db": round(sqnr_db, 4),
+        "g_scale": round(g_scale, 6),
+        "ref_max_diff": ref_max_diff,
+    }
+    return packed, stats
+
+
+def build_quantized_config(config_dict: dict[str, Any]) -> dict[str, Any]:
+    """Attach ``k31q_dspark_exl3`` quantization metadata to a DSpark config dict."""
+    out = json.loads(json.dumps(config_dict))
+    qcfg = {
+        "quant_method": FORMAT,
+        "version": VERSION,
+        "bits": BITS,
+        "codebook": CODEBOOK,
+    }
+    out["quantization_config"] = dict(qcfg)
+    # SpeculatorsConfig.extract_transformers_pre_trained_config seeds the HF
+    # PreTrainedConfig from transformer_layer_config, so mirror it there too.
+    if isinstance(out.get("transformer_layer_config"), dict):
+        out["transformer_layer_config"]["quantization_config"] = dict(qcfg)
+    return out
+
+
+def _resolve_inputs(
+    input_dir: Path | None,
+    weights_file: Path | None,
+    config_file: Path | None,
+) -> tuple[list[Path], Path]:
+    if weights_file is not None:
+        weight_paths = [weights_file]
+    else:
+        if input_dir is None:
+            raise ValueError("Pass --input-dir or --weights-file")
+        single = input_dir / "model.safetensors"
+        if single.is_file():
+            weight_paths = [single]
+        else:
+            weight_paths = sorted(input_dir.glob("model*.safetensors"))
+        if not weight_paths:
+            raise FileNotFoundError(f"No model*.safetensors found in {input_dir}")
+
+    if config_file is not None:
+        cfg_path = config_file
+    elif input_dir is not None:
+        cfg_path = input_dir / "config.json"
+    else:
+        cfg_path = weight_paths[0].parent / "config.json"
+    if not cfg_path.is_file():
+        raise FileNotFoundError(f"config.json not found at {cfg_path}")
+    return weight_paths, cfg_path
+
+
+def _sha256_file(path: Path) -> str:
+    h = hashlib.sha256()
+    with path.open("rb") as f:
+        while True:
+            chunk = f.read(8 * 1024 * 1024)
+            if not chunk:
+                break
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def quantize_checkpoint(
+    *,
+    output_dir: Path,
+    input_dir: Path | None = None,
+    weights_file: Path | None = None,
+    config_file: Path | None = None,
+    quant_ext_path: str | None = None,
+    seed: int = 7000,
+    verify_ref: bool = True,
+    dry_run: bool = False,
+) -> dict[str, Any]:
+    """Quantize a BF16 DSpark checkpoint to an EXL3 K6 checkpoint directory."""
+    weight_paths, cfg_path = _resolve_inputs(input_dir, weights_file, config_file)
+    cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
+
+    tensor_sources: dict[str, tuple[Path, tuple[int, ...]]] = {}
+    for wp in weight_paths:
+        with safe_open(str(wp), framework="pt", device="cpu") as sf:
+            for key in sf.keys():
+                if key in tensor_sources:
+                    raise ValueError(f"Duplicate tensor key across shards: {key}")
+                shape = tuple(int(d) for d in sf.get_slice(key).get_shape())
+                tensor_sources[key] = (wp, shape)
+
+    quant_keys = sorted(
+        k
+        for k, (_, sh) in tensor_sources.items()
+        if is_quantizable_dspark_tensor(k, sh)
+    )
+    plain_keys = sorted(k for k in tensor_sources if k not in set(quant_keys))
+    quant_shapes = {
+        k: (int(tensor_sources[k][1][0]), int(tensor_sources[k][1][1]))
+        for k in quant_keys
+    }
+    plain_shapes = {k: tensor_sources[k][1] for k in plain_keys}
+    vram = compute_vram_summary(quant_shapes, plain_shapes)
+
+    if dry_run:
+        return {
+            "dry_run": True,
+            "num_quantized": len(quant_keys),
+            "num_plain": len(plain_keys),
+            "quantized_keys": quant_keys,
+            "plain_keys": plain_keys,
+            "vram_bytes": vram,
+        }
+
+    if not torch.cuda.is_available():
+        raise RuntimeError("CUDA GPU is required for EXL3 K6 trellis quantization")
+
+    device = torch.device("cuda:0")
+    ext = load_quant_extension(quant_ext_path)
+    temp_k = torch.empty((244 * 256 * 4096,), dtype=torch.uint8, device=device)
+
+    output_dir.mkdir(parents=True, exist_ok=True)
+    out_tensors: dict[str, torch.Tensor] = {}
+    quant_meta: dict[str, dict[str, Any]] = {}
+    sqnrs: list[float] = []
+
+    t0 = time.time()
+    open_handles = {
+        wp: safe_open(str(wp), framework="pt", device="cpu") for wp in weight_paths
+    }
+    try:
+        for idx, key in enumerate(quant_keys):
+            wp, shape = tensor_sources[key]
+            prefix = key.removesuffix(".weight")
+            w_gpu = open_handles[wp].get_tensor(key).to(device=device).contiguous()
+            packed, stats = quantize_exl3_k6_matrix(
+                ext,
+                temp_k,
+                w_gpu,
+                bits=BITS,
+                seed=seed + idx,
+                verify_ref=verify_ref,
+            )
+            del w_gpu
+            out_tensors[f"{prefix}.trellis"] = packed["trellis"]
+            out_tensors[f"{prefix}.suh"] = packed["suh"]
+            out_tensors[f"{prefix}.svh"] = packed["svh"]
+            out_tensors[f"{prefix}.mul1"] = packed["mul1"]
+            sqnrs.append(stats["sqnr_db"])
+            quant_meta[prefix] = {
+                "shape": [int(shape[0]), int(shape[1])],
+                "bits": BITS,
+                "bits_x2": BITS_X2,
+                "codebook": CODEBOOK,
+                "sqnr_db": stats["sqnr_db"],
+                "g_scale": stats["g_scale"],
+            }
+            print(
+                f"  [{idx + 1:2d}/{len(quant_keys)}] {prefix:42s} "
+                f"{str(list(shape)):16s} SQNR={stats['sqnr_db']:.2f} dB",
+                flush=True,
+            )
+
+        for key in plain_keys:
+            wp, _ = tensor_sources[key]
+            out_tensors[key] = open_handles[wp].get_tensor(key).contiguous()
+    finally:
+        open_handles.clear()
+
+    elapsed_s = time.time() - t0
+    out_safetensors = output_dir / "model.safetensors"
+    tmp_safetensors = output_dir / "model.safetensors.tmp"
+    save_file(
+        out_tensors,
+        str(tmp_safetensors),
+        metadata={
+            "format": FORMAT,
+            "version": str(VERSION),
+            "bits": str(BITS),
+            "codebook": CODEBOOK,
+        },
+    )
+    os.replace(tmp_safetensors, out_safetensors)
+    file_bytes = out_safetensors.stat().st_size
+    file_sha256 = _sha256_file(out_safetensors)
+
+    out_cfg = build_quantized_config(cfg)
+    (output_dir / "config.json").write_text(
+        json.dumps(out_cfg, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+    )
+
+    if input_dir is not None:
+        for aux_name in ("config.py", "README.md"):
+            src_aux = input_dir / aux_name
+            if src_aux.is_file():
+                shutil.copy2(src_aux, output_dir / aux_name)
+    elif cfg_path.parent != output_dir:
+        for aux_name in ("config.py",):
+            src_aux = cfg_path.parent / aux_name
+            if src_aux.is_file():
+                shutil.copy2(src_aux, output_dir / aux_name)
+
+    manifest = {
+        "format": FORMAT,
+        "version": VERSION,
+        "bits": BITS,
+        "bits_x2": BITS_X2,
+        "codebook": CODEBOOK,
+        "full_vocab_markov": True,
+        "share_target_lm_head": True,
+        "file": "model.safetensors",
+        "bytes": file_bytes,
+        "sha256": file_sha256,
+        "seed": seed,
+        "elapsed_s": round(elapsed_s, 2),
+        "quantized_matrices": quant_meta,
+        "plain_tensors": plain_keys,
+        "sqnr_summary": {
+            "count": len(sqnrs),
+            "min_db": round(min(sqnrs), 4) if sqnrs else 0.0,
+            "mean_db": round(sum(sqnrs) / len(sqnrs), 4) if sqnrs else 0.0,
+            "max_db": round(max(sqnrs), 4) if sqnrs else 0.0,
+        },
+        "vram_bytes": vram,
+    }
+    (output_dir / "k31q_dspark_manifest.json").write_text(
+        json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+    )
+
+    # Validate written safetensors headers through Exl3Manifest if vllm is importable.
+    try:
+        from vllm.sm80.kernels.exl3.utils import Exl3Manifest
+
+        exl3_m = Exl3Manifest(output_dir)
+        if set(exl3_m.matrices) != set(quant_meta):
+            raise RuntimeError(
+                f"Exl3Manifest matrix mismatch: {len(exl3_m.matrices)} vs {len(quant_meta)}"
+            )
+    except ImportError:
+        pass
+
+    return manifest
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(
+        description="Quantize a BF16 Qwen3 DSpark checkpoint to EXL3 K6 (k31q_dspark_exl3)."
+    )
+    parser.add_argument(
+        "--input-dir",
+        type=Path,
+        default=None,
+        help="Input BF16 DSpark checkpoint directory (config.json + model.safetensors).",
+    )
+    parser.add_argument(
+        "--weights-file",
+        type=Path,
+        default=None,
+        help="Optional explicit BF16 safetensors file (overrides input-dir weights).",
+    )
+    parser.add_argument(
+        "--config-file",
+        type=Path,
+        default=None,
+        help="Optional explicit config.json path (overrides input-dir config.json).",
+    )
+    parser.add_argument(
+        "--output-dir",
+        type=Path,
+        required=True,
+        help="Destination directory for the EXL3 K6 DSpark checkpoint.",
+    )
+    parser.add_argument(
+        "--quant-ext",
+        type=str,
+        default=None,
+        help="Path to prebuilt _k31_quant.so CUDA trellis encoder.",
+    )
+    parser.add_argument(
+        "--seed",
+        type=int,
+        default=7000,
+        help="Deterministic base RNG seed for Hadamard sign flips (default: 7000).",
+    )
+    parser.add_argument(
+        "--no-verify-ref",
+        action="store_true",
+        help="Skip trellis pack/unpack reference round-trip check.",
+    )
+    parser.add_argument(
+        "--dry-run",
+        action="store_true",
+        help="Inspect input tensors and print VRAM budget without running GPU quantization.",
+    )
+    args = parser.parse_args()
+
+    result = quantize_checkpoint(
+        output_dir=args.output_dir,
+        input_dir=args.input_dir,
+        weights_file=args.weights_file,
+        config_file=args.config_file,
+        quant_ext_path=args.quant_ext,
+        seed=args.seed,
+        verify_ref=not args.no_verify_ref,
+        dry_run=args.dry_run,
+    )
+    vram = result["vram_bytes"]
+    gib = 1024**3
+    if args.dry_run:
+        print(
+            f"[dry-run] quantizable={result['num_quantized']} plain={result['num_plain']} | "
+            f"TP2/rank BF16={vram['tp2_per_rank_bf16']/gib:.3f} GiB -> "
+            f"K6={vram['tp2_per_rank_k6']/gib:.3f} GiB "
+            f"(reclaim={vram['tp2_per_rank_reclaim']/gib:.3f} GiB/rank)"
+        )
+        return
+
+    sq = result["sqnr_summary"]
+    print(
+        f"[done] Wrote {args.output_dir}/model.safetensors "
+        f"({result['bytes'] / gib:.3f} GiB, sha256={result['sha256'][:12]}...) "
+        f"in {result['elapsed_s']:.1f}s | "
+        f"SQNR min={sq['min_db']:.2f} mean={sq['mean_db']:.2f} max={sq['max_db']:.2f} dB | "
+        f"TP2/rank VRAM {vram['tp2_per_rank_bf16']/gib:.3f} -> "
+        f"{vram['tp2_per_rank_k6']/gib:.3f} GiB "
+        f"(reclaim {vram['tp2_per_rank_reclaim']/gib:.3f} GiB/rank)"
+    )
+
+
+if __name__ == "__main__":
+    main()
