index 0000000000..06b953c089
--- /dev/null
+++ b/tools/sm80/dspark_tree_rank_dump.py
@@ -0,0 +1,281 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Offline tree-speculation measurement on G1 teacher dumps (CPU, FP32).
+
+For every anchor of the selected T=0 sequences this writes, per draft depth:
+  * the teacher-forced rank of the target's greedy token in the drafter's
+    logits (base + Markov bias of the true previous token), its probability and
+    the drafter's top-8 probabilities;
+  * a level-synchronous candidate tree: up to BEAM parents per depth (slot 0 is
+    always the greedy chain), the top-3 children of each with their softmax
+    probabilities, and the confidence head's output for each parent.
+With --window the anchors of a sequence are consecutive positions, so the
+analysis (dspark_tree_ev.py) can replay whole decode trajectories of any
+policy; otherwise they are strided samples.
+
+Needs the reference drafter of the distillation lane on the import path
+(dspark_model.py, g1_dataset.py, safetensors_io.py), the BF16 DSpark
+checkpoint, the target's embedding and a dense BF16 copy of its head.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from dspark_model import DSparkDraftModel, build_anchor_block_attention_mask
+from g1_dataset import G1ShardDataset
+from safetensors_io import load_safetensors
+
+NOTHINK_TAG = 12092
+BRANCH = 3
+
+
+def pick_anchors(seq, depth, stride, max_per_seq, window):
+    L = seq.token_ids.numel()
+    mask = seq.loss_mask.tolist()
+    valid = [a for a in range(1, L - depth) if all(mask[a + j] for j in range(depth))]
+    if not valid:
+        return []
+    if window > 0:
+        # The longest run of consecutive valid anchors, cut to the window.
+        best: list[int] = []
+        run: list[int] = []
+        for a in valid:
+            if run and a == run[-1] + 1:
+                run.append(a)
+            else:
+                run = [a]
+            if len(run) > len(best):
+                best = list(run)
+        return best[:window]
+    anchors = valid[:: max(1, stride)]
+    if max_per_seq > 0 and len(anchors) > max_per_seq:
+        step = len(anchors) / float(max_per_seq)
+        anchors = [anchors[int(i * step)] for i in range(max_per_seq)]
+    return anchors
+
+
+@torch.no_grad()
+def block_hidden(model, seq, anchors, ctx_kv, pos_all, depth):
+    """Draft hidden states [A, depth, H] of several anchors of one sequence in
+    one pass: the queries of all anchors form one masked sequence, as in the
+    reference model's training forward, over the precomputed context K/V."""
+    dtype = model.hidden_norm.weight.dtype
+    A = len(anchors)
+    anchor_t = torch.tensor(anchors, dtype=torch.long)
+    q_ids = torch.full((1, A * depth), model.config.mask_token_id, dtype=torch.long)
+    q_ids[0, ::depth] = seq.token_ids[anchor_t]
+    h = model.embed_tokens(q_ids).to(dtype)
+    q_pos = (pos_all[anchor_t].unsqueeze(1) + torch.arange(depth).unsqueeze(0)).reshape(1, -1)
+    q_cos, q_sin = model.rotary_emb(q_pos, dtype)
+    ctx_end = max(anchors) + 1
+    for idx, layer in enumerate(model.layers):
+        k_all, v_all = ctx_kv[idx]
+        win = layer.self_attn.sliding_window
+        ctx_start = max(0, min(anchors) - win) if win is not None else 0
+        mask = build_anchor_block_attention_mask(
+            ctx_len=ctx_end - ctx_start,
+            anchor_positions=anchor_t - ctx_start,
+            block_size=depth,
+            position_ids=pos_all[ctx_start:ctx_end],
+            is_causal=layer.self_attn.is_causal,
+            sliding_window=win,
+        )
+        h = layer(
+            h,
+            q_cos,
+            q_sin,
+            precomputed_ctx_kv=(k_all[:, :, ctx_start:ctx_end], v_all[:, :, ctx_start:ctx_end]),
+            attn_mask=mask,
+        )
+    return model.norm(h).view(A, depth, -1)
+
+
+@torch.no_grad()
+def measure_batch(model, seq, anchors, head_hidden, depth, beam):
+    w1 = model.markov_head.markov_w1.weight
+    w2 = model.markov_head.markov_w2.weight
+    A = len(anchors)
+    anchor_t = torch.tensor(anchors, dtype=torch.long)
+    base = model.compute_base_logits(head_hidden.reshape(A * depth, -1)).float()
+    base = base.view(A, depth, -1)
+
+    out = dict(
+        truth=np.zeros((A, depth), np.int64),
+        actual=np.zeros((A, depth), np.int64),
+        consistent=np.ones((A, depth), np.bool_),
+        tf_rank=np.zeros((A, depth), np.int32),
+        tf_q_truth=np.zeros((A, depth), np.float32),
+        tf_topq=np.zeros((A, depth, 8), np.float32),
+        tf_conf=np.zeros((A, depth), np.float32),
+        n_par=np.zeros((A, depth), np.int32),
+        par_prev=np.full((A, depth, beam), -1, np.int32),
+        par_tok=np.full((A, depth, beam), -1, np.int64),
+        par_pathq=np.zeros((A, depth, beam), np.float32),
+        par_conf=np.zeros((A, depth, beam), np.float32),
+        child_tok=np.full((A, depth, beam, BRANCH), -1, np.int64),
+        child_q=np.zeros((A, depth, beam, BRANCH), np.float32),
+    )
+    beam_tok = seq.token_ids[anchor_t].view(A, 1)
+    beam_pathq = torch.ones(A, 1)
+    beam_prev = torch.full((A, 1), -1, dtype=torch.long)
+    ok = torch.ones(A, dtype=torch.bool)
+    for j in range(depth):
+        rows = seq.gen_row_index[anchor_t + j]
+        truth = seq.topk_ids[rows, 0]
+        # The dump's context after depth j follows the generated token, which
+        # is the target's greedy token except at rare near-tie flips. Ranks and
+        # hits are taken against the generated token so that deeper levels and
+        # trajectory replays stay consistent with the dumped context.
+        actual = seq.token_ids[anchor_t + j + 1]
+        ok = ok & (actual == truth)
+        nb = beam_tok.shape[1]
+        toks = torch.cat([seq.token_ids[anchor_t + j].view(A, 1), beam_tok], dim=1)
+        emb = w1[toks]  # [A, P, r]
+        logits = base[:, j].unsqueeze(1) + emb @ w2.t()  # [A, P, V]
+        q = F.softmax(logits, dim=-1)
+        P = toks.shape[1]
+        hid = head_hidden[:, j].unsqueeze(1).expand(A, P, -1).reshape(A * P, -1)
+        conf = torch.sigmoid(model.confidence_head(hid, emb.reshape(A * P, -1))).view(A, P)
+        t_logit = logits[:, 0].gather(1, actual.view(A, 1))
+        out["truth"][:, j] = truth.numpy()
+        out["actual"][:, j] = actual.numpy()
+        out["consistent"][:, j] = ok.numpy()
+        out["tf_rank"][:, j] = (logits[:, 0] > t_logit).sum(dim=1).numpy()
+        out["tf_q_truth"][:, j] = q[:, 0].gather(1, actual.view(A, 1)).view(A).numpy()
+        out["tf_topq"][:, j] = torch.topk(q[:, 0], 8, dim=-1).values.numpy()
+        out["tf_conf"][:, j] = conf[:, 0].numpy()
+        cq, ct = torch.topk(q[:, 1:], BRANCH, dim=-1)  # [A, nb, 3]
+        out["n_par"][:, j] = nb
+        out["par_prev"][:, j, :nb] = beam_prev.numpy()
+        out["par_tok"][:, j, :nb] = beam_tok.numpy()
+        out["par_pathq"][:, j, :nb] = beam_pathq.numpy()
+        out["par_conf"][:, j, :nb] = conf[:, 1:].numpy()
+        out["child_tok"][:, j, :nb] = ct.numpy()
+        out["child_q"][:, j, :nb] = cq.numpy()
+        # Next beam: slot 0 is the greedy chain (child 0 of slot 0), then the
+        # most probable remaining children.
+        cand = (beam_pathq.unsqueeze(-1) * cq).reshape(A, nb * BRANCH)
+        score = cand.clone()
+        score[:, 0] = float("inf")
+        keep = min(beam, nb * BRANCH)
+        order = torch.argsort(score, dim=1, descending=True, stable=True)[:, :keep]
+        beam_prev = order
+        beam_pathq = cand.gather(1, order)
+        beam_tok = ct.reshape(A, nb * BRANCH).gather(1, order)
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--checkpoint", required=True)
+    ap.add_argument("--dataset", required=True)
+    ap.add_argument("--embed-weights", required=True)
+    ap.add_argument("--lm-head-weights", required=True)
+    ap.add_argument("--out-dir", required=True)
+    ap.add_argument("--split", default="eval")
+    ap.add_argument("--domains", default="prose,code")
+    ap.add_argument("--depth", type=int, default=8)
+    ap.add_argument("--beam", type=int, default=8)
+    ap.add_argument("--stride", type=int, default=6)
+    ap.add_argument("--max-anchors-per-seq", type=int, default=40)
+    ap.add_argument("--window", type=int, default=0)
+    ap.add_argument("--batch", type=int, default=32)
+    ap.add_argument("--shard-mod", type=int, default=1)
+    ap.add_argument("--shard-rem", type=int, default=0)
+    ap.add_argument("--include-think", action="store_true")
+    ap.add_argument("--max-ctx", type=int, default=4000)
+    ap.add_argument("--max-seqs", type=int, default=0)
+    ap.add_argument("--check", type=int, default=0, help="verify N anchors against the single-anchor path")
+    ap.add_argument("--threads", type=int, default=8)
+    args = ap.parse_args()
+
+    torch.set_num_threads(args.threads)
+    out_dir = Path(args.out_dir)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    domains = set(args.domains.split(","))
+
+    t0 = time.time()
+    model = DSparkDraftModel.from_hf_dir(args.checkpoint, dtype=torch.float32, device="cpu")
+    model.eval()
+    emb_sd = load_safetensors(args.embed_weights, device="cpu")
+    emb = emb_sd.get("language_model.model.embed_tokens.weight", next(iter(emb_sd.values())))
+    head_sd = load_safetensors(args.lm_head_weights, device="cpu")
+    lm = head_sd.get("language_model.lm_head.weight", next(iter(head_sd.values())))
+    model.attach_target_io(emb, lm.to(torch.float32))
+    del head_sd, emb_sd
+    print(f"loaded in {time.time() - t0:.1f}s", flush=True)
+
+    ds = G1ShardDataset(args.dataset, split=args.split)
+    files = [f for i, f in enumerate(ds.shard_files) if i % args.shard_mod == args.shard_rem]
+    total = 0
+    nseq = 0
+    for shard_path in files:
+        if args.max_seqs and nseq >= args.max_seqs:
+            break
+        seqs = ds.load_shard(shard_path)
+        for si, seq in enumerate(seqs):
+            if args.max_seqs and nseq >= args.max_seqs:
+                break
+            out_path = out_dir / f"{shard_path.stem}-seq{si:03d}.npz"
+            if out_path.exists():
+                continue
+            if seq.temperature > 0.0 or seq.domain not in domains:
+                continue
+            gpos = torch.nonzero(seq.loss_mask, as_tuple=False).view(-1)
+            if gpos.numel() == 0:
+                continue
+            nothink = int(seq.token_ids[int(gpos[0]) - 1]) == NOTHINK_TAG
+            if not nothink and not args.include_think:
+                continue
+            anchors = pick_anchors(seq, args.depth, args.stride, args.max_anchors_per_seq, args.window)
+            anchors = [a for a in anchors if a <= args.max_ctx]
+            if len(anchors) < 16:
+                continue
+            ts = time.time()
+            last = max(anchors)
+            pos_all = seq.position_ids[: last + 1]
+            ctx_kv = model.precompute_context_kv(seq.aux_hidden[: last + 1].float(), pos_all)
+            parts = []
+            for b0 in range(0, len(anchors), args.batch):
+                batch = anchors[b0 : b0 + args.batch]
+                hh = block_hidden(model, seq, batch, ctx_kv, pos_all, args.depth)
+                if args.check and b0 == 0:
+                    for a_i in range(min(args.check, len(batch))):
+                        a = batch[a_i]
+                        ref = model.draft_block_hidden(
+                            int(seq.token_ids[a]), int(seq.position_ids[a]), ctx_kv,
+                            num_draft_tokens=args.depth, anchor_index=a,
+                            context_positions=pos_all,
+                        )
+                        err = float((ref - hh[a_i]).abs().max() / ref.abs().max())
+                        print(f"check anchor {a}: rel max diff {err:.2e}", flush=True)
+                parts.append(measure_batch(model, seq, batch, hh, args.depth, args.beam))
+            packed = {k: np.concatenate([p[k] for p in parts]) for k in parts[0]}
+            packed["meta"] = np.asarray(
+                [(si, a, ds.domains.index(seq.domain), int(nothink), int(seq.prompt_id))
+                 for a in anchors], dtype=np.int64)
+            tmp = out_dir / f"{shard_path.stem}-seq{si:03d}.tmp.npz"
+            np.savez_compressed(tmp, **packed)
+            os.replace(tmp, out_path)
+            total += len(anchors)
+            nseq += 1
+            print(f"{shard_path.name} seq {si} {seq.domain} anchors {len(anchors)} "
+                  f"[{anchors[0]}..{anchors[-1]}] {(time.time() - ts) / len(anchors):.2f}s/anchor "
+                  f"total {total}", flush=True)
+            del ctx_kv
+        del seqs
+    (out_dir / f"DONE.{args.shard_rem}.{'-'.join(sorted(domains))}").write_text(
+        json.dumps({"anchors": total, "sequences": nseq}))
+
+
+if __name__ == "__main__":
+    main()
