+    monkeypatch.setenv("VLLM_AMPERE_DECODE_KERNELS", "1")
+    monkeypatch.setenv("VLLM_MOE_DECODE_ROUTE_V2", "1")
+    monkeypatch.setattr("vllm.sm80.kernels._platform._SM80_CACHE", True)
+    return monkeypatch
