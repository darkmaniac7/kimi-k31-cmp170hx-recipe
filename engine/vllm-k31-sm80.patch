+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Offline DSpark drafting measurements on real G1 teacher dumps.
+
+Two questions, answered on the target's own greedy generations (the eval split
+of a ``dspark_g1_teacher_v1`` dump: the five aux hidden states and the
+teacher's top-1 token of every generated position):
+
+1. Shortlist Markov sampling (``VLLM_DSPARK_MARKOV_SHORTLIST``,
+   ``vllm/sm80/spec_decode/markov_shortlist.py``): how many drafts the target
+   accepts when the Markov steps score only the ``C`` best base logits of each
+   vocabulary half, against the full-vocabulary steps; how often the two
+   chains draft the same block; where the full chain's token ranks among
+   the base logits and among the Markov biases of its half; the same for a
+   two-sided shortlist (best base logits and best Markov successors of the
+   previous token); and what the BF16 rounding of the served path costs
+   (bias and sum rounded to BF16, ties to the lowest token) against FP32
+   sums and against an FP32 head.
+2. Tree drafts: the teacher-forced rank of the true token at every draft
+   depth (any static tree's accepted length follows from the rank sequence),
+   and, for a tree grown best-first by the drafter's own path probabilities,
+   the pop index at which each depth of the true path enters the tree (the
+   accepted length under any node budget follows from it), with the path
+   probability of every popped node and, along the greedy chain, the
+   confidence head's estimates (what a per-step budget policy would see).
+
+It reuses the standalone drafter of the distillation lane (``dspark_model.py``,
+``g1_dataset.py``, ``eval_offline_acceptance.py`` under ``--distill-dir``): the
+BF16 checkpoint with the dense BF16 target head, all in torch. One CUDA device,
+no vLLM import. Writes per-anchor arrays to ``--output`` (.npz) and prints a
+summary per domain.
+
+    python tools/sm80/eval_dspark_shortlist_tree.py --output out.npz
+"""
+
+from __future__ import annotations
+
+import argparse
+import heapq
+import importlib
+import json
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+
+SHORTLISTS = (1, 2, 4, 8, 16, 32, 64)
+# (base candidates, Markov successors) per vocabulary half of the two-sided
+# shortlist: the best base logits of the position and the tokens the Markov
+# bias of the previous token favours.
+UNIONS = ((8, 8), (8, 32), (16, 16), (16, 64), (32, 32), (32, 64), (64, 64), (0, 64))
+BRANCH = 4  # children a tree node can grow
+POPS = 12  # nodes of the best-first tree
+GAMMAS = (1.0, 1.5, 2.0, 3.0)  # sharpening of the drafter's distribution
+NEVER = 255
+
+
+_BIAS: dict[int, torch.Tensor] = {}
+
+
+def markov_bias(w1, w2, prev: int) -> torch.Tensor:
+    """The Markov bias of the whole vocabulary after ``prev`` (cached: the
+    chains of one anchor mostly follow the same tokens)."""
+    if prev not in _BIAS:
+        _BIAS[prev] = w2 @ w1[prev]
+    return _BIAS[prev]
+
+
+def greedy_chain(base, w1, w2, anchor: int, cand=None) -> list[int]:
+    """The Markov chain's drafts over the whole vocabulary, or over ``cand``
+    ([steps, n] token ids) when given."""
+    prev, out = anchor, []
+    for step in range(base.shape[0]):
+        bias = markov_bias(w1, w2, prev)
+        if cand is None:
+            tok = int(torch.argmax(base[step] + bias))
+        else:
+            idx = cand[step]
+            tok = int(idx[torch.argmax(base[step, idx] + bias[idx])])
+        out.append(tok)
+        prev = tok
+    return out
+
+
+def rounded_chain(base, w1, w2, anchor: int) -> list[int]:
+    """The chain as the served BF16 path scores it: the bias rounded to BF16,
+    the sum rounded to BF16, the lowest token among the equal largest sums.
+    ``base`` holds BF16 values."""
+    prev, out = anchor, []
+    b16 = base.to(torch.bfloat16)
+    for step in range(base.shape[0]):
+        total = (b16[step] + markov_bias(w1, w2, prev).to(torch.bfloat16)).float()
+        tok = int(torch.nonzero(total == total.max())[0])
+        out.append(tok)
+        prev = tok
+    return out
+
+
+def union_chain(base, w1, w2, anchor: int, lo, hi, half: int, c: int, cp: int):
+    """The chain over the two-sided shortlist: per vocabulary half the ``c``
+    best base logits of the position and the ``cp`` largest Markov biases of
+    the previous token."""
+    prev, out = anchor, []
+    for step in range(base.shape[0]):
+        bias = markov_bias(w1, w2, prev)
+        idx = torch.cat(
+            [
+                lo[step, :c],
+                hi[step, :c],
+                bias[:half].topk(cp).indices,
+                bias[half:].topk(cp).indices + half,
+            ]
+        )
+        tok = int(idx[torch.argmax(base[step, idx] + bias[idx])])
+        out.append(tok)
+        prev = tok
+    return out
+
+
+def matched(drafts: list[int], truth: list[int]) -> int:
+    n = 0
+    for d, t in zip(drafts, truth):
+        if d != t:
+            break
+        n += 1
+    return n
+
+
+def best_first(base, w1, w2, anchor: int, truth: list[int], gamma: float):
+    """A tree grown best-first by path probability under the drafter's
+    distribution sharpened by ``gamma`` (softmax of ``gamma`` times the
+    logits): a popped node offers its best child and its next sibling.
+
+    Returns (entered, logp, depth): the pop index (1-based) at which the true
+    node of each depth entered the tree, NEVER when it did not within POPS
+    pops, and the path log-probability and depth of every popped node."""
+    steps = base.shape[0]
+    cache: dict[tuple[int, int], tuple[list[float], list[int]]] = {}
+
+    def children(depth: int, prev: int):
+        key = (depth, prev)
+        if key not in cache:
+            logp = torch.log_softmax(
+                gamma * (base[depth] + markov_bias(w1, w2, prev)), dim=-1
+            )
+            top = logp.topk(BRANCH)
+            cache[key] = (top.values.tolist(), top.indices.tolist())
+        return cache[key]
+
+    entered = [NEVER] * steps
+    pop_logp = [float("nan")] * POPS
+    pop_depth = [-1] * POPS
+    heap: list[tuple] = []
+    count = 0
+
+    def push(depth, prev, parent_logp, parent_on_path, j):
+        nonlocal count
+        logps, toks = children(depth, prev)
+        count += 1
+        heapq.heappush(
+            heap,
+            (-(parent_logp + logps[j]), count, depth, prev, parent_logp, parent_on_path, j, toks[j]),
+        )
+
+    push(0, anchor, 0.0, True, 0)
+    for pop in range(1, POPS + 1):
+        if not heap:
+            break
+        neg, _, depth, prev, parent_logp, parent_on_path, j, tok = heapq.heappop(heap)
+        pop_logp[pop - 1] = -neg
+        pop_depth[pop - 1] = depth
+        on_path = parent_on_path and tok == truth[depth]
+        if on_path:
+            entered[depth] = pop
+        if depth + 1 < steps:
+            push(depth + 1, tok, -neg, on_path, 0)
+        if j + 1 < BRANCH:
+            push(depth, prev, parent_logp, parent_on_path, j + 1)
+    return entered, pop_logp, pop_depth
+
+
+def chain_estimates(model, hidden, base, w1, w2, anchor: int, drafts: list[int]):
+    """Along the free-running greedy chain: the confidence head's acceptance
+    estimate of every draft (None without a head) and the drafter's own
+    probability of it."""
+    prevs = torch.tensor([anchor] + drafts[:-1], device=base.device)
+    embeds = w1[prevs]
+    logp = torch.log_softmax(base + embeds @ w2.T, dim=-1)
+    picked = torch.tensor(drafts, device=base.device)
+    probs = logp.gather(1, picked[:, None])[:, 0].exp().tolist()
+    conf = [float("nan")] * len(drafts)
+    if model.confidence_head is not None:
+        m_emb = model.markov_head.embed(prevs)
+        conf = torch.sigmoid(model.confidence_head(hidden, m_emb)).flatten().float().tolist()
+    return conf, probs
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    root = Path("/tmp/gem-k31")
+    ap.add_argument("--distill-dir", type=Path, default=root / "work/dspark_distill")
+    ap.add_argument(
+        "--checkpoint", type=Path, default=root / "dspark_assets/Kimi-K3.1-Pro-DSpark"
+    )
+    ap.add_argument("--dataset", type=Path, default=root / "dspark_g1_v2")
+    ap.add_argument(
+        "--embed-weights", type=Path, default=root / "dspark_assets/embed.safetensors"
+    )
+    ap.add_argument(
+        "--lm-head-weights",
+        type=Path,
+        default=root / "dspark_assets/lm_head_bf16.safetensors",
+    )
+    ap.add_argument("--split", default="eval")
+    ap.add_argument("--k-draft", type=int, nargs="+", default=[11, 7])
+    ap.add_argument("--stride", type=int, default=8)
+    ap.add_argument("--max-anchors-per-seq", type=int, default=16)
+    ap.add_argument("--time-limit-s", type=float, default=900.0)
+    ap.add_argument("--output", type=Path, required=True)
+    args = ap.parse_args()
+
+    sys.path.insert(0, str(args.distill_dir))
+    dspark_model = importlib.import_module("dspark_model")
+    g1_dataset = importlib.import_module("g1_dataset")
+    evalmod = importlib.import_module("eval_offline_acceptance")
+
+    device = torch.device("cuda")
+    model = dspark_model.DSparkDraftModel.from_hf_dir(
+        str(args.checkpoint), dtype=torch.bfloat16, device="cuda"
+    )
+    emb, lm = evalmod.load_target_io_weights(
+        args.embed_weights,
+        args.lm_head_weights,
+        embed_device="cpu",
+        lm_head_device="cuda",
+        dtype=torch.bfloat16,
+    )
+    model.attach_target_io(emb, lm)
+    model.eval()
+    w1 = model.markov_head.markov_w1.weight.float()
+    w2 = model.markov_head.markov_w2.weight.float()
+    head32 = lm.float()
+    vocab = w2.shape[0]
+    half = vocab // 2
+    top_c = max(SHORTLISTS)
+
+    rows: dict[str, list] = {
+        name: []
+        for name in ("domain", "k", "acc_full", "acc_short", "same_block", "base_rank",
+                     "acc_served", "acc_fp32", "acc_union", "same_union", "bias_rank",
+                     "chain_conf", "chain_prob", "tf_rank", "tf_top", "entered",
+                     "pop_logp", "pop_depth")
+    }
+    k_tree = args.k_draft[0]
+    started = time.time()
+    seqs = anchors_done = 0
+    stopped = False
+    dataset = g1_dataset.G1ShardDataset(args.dataset, split=args.split)
+    with torch.no_grad():
+        for seq in dataset.iter_shard_sequences():
+            if seq.temperature > 0.0:
+                continue
+            if time.time() - started > args.time_limit_s:
+                stopped = True
+                break
+            seqs += 1
+            for k in args.k_draft:
+                anchors = evalmod.select_eval_anchors(
+                    seq, k_draft=k, stride=args.stride,
+                    max_anchors_per_seq=args.max_anchors_per_seq,
+                )
+                if not anchors:
+                    continue
+                last = max(anchors)
+                aux = seq.aux_hidden[:last].to(device)
+                pos = seq.position_ids[:last].to(device)
+                ctx_kv = model.precompute_context_kv(aux, pos)
+                for a in anchors:
+                    anchor = int(seq.token_ids[a])
+                    hidden = model.draft_block_hidden(
+                        anchor,
+                        int(seq.position_ids[a]),
+                        ctx_kv,
+                        num_draft_tokens=k,
+                        anchor_index=a,
+                        context_positions=pos,
+                    )
+                    base = model.compute_base_logits(hidden).float()
+                    # The same logits without the BF16 rounding of the head.
+                    base32 = hidden.float() @ head32.T
+                    truth = [
+                        int(seq.topk_ids[int(seq.gen_row_index[a + s]), 0])
+                        for s in range(k)
+                    ]
+                    _BIAS.clear()
+                    full = greedy_chain(base, w1, w2, anchor)
+                    lo = base[:, :half].topk(top_c, dim=-1).indices
+                    hi = base[:, half:].topk(top_c, dim=-1).indices + half
+                    acc_short, same = [], []
+                    for c in SHORTLISTS:
+                        cand = torch.cat([lo[:, :c], hi[:, :c]], dim=1)
+                        short = greedy_chain(base, w1, w2, anchor, cand)
+                        acc_short.append(matched(short, truth))
+                        same.append(int(short == full))
+                    # Rank of the full chain's token among the base logits of
+                    # its vocabulary half (1 = it is that half's best).
+                    toks = torch.tensor(full, device=device)
+                    picked = base.gather(1, toks[:, None])
+                    in_lo = (toks < half)[:, None]
+                    above = torch.where(
+                        in_lo,
+                        (base[:, :half] > picked).sum(-1, keepdim=True),
+                        (base[:, half:] > picked).sum(-1, keepdim=True),
+                    )
+                    bias_at = w1[torch.tensor([anchor] + full[:-1], device=device)] @ w2.T
+                    bias_pick = bias_at.gather(1, toks[:, None])
+                    bias_above = torch.where(
+                        in_lo,
+                        (bias_at[:, :half] > bias_pick).sum(-1, keepdim=True),
+                        (bias_at[:, half:] > bias_pick).sum(-1, keepdim=True),
+                    )
+                    acc_union, same_union = [], []
+                    for c, cp in UNIONS:
+                        draft = union_chain(base, w1, w2, anchor, lo, hi, half, c, cp)
+                        acc_union.append(matched(draft, truth))
+                        same_union.append(int(draft == full))
+                    pad = k_tree - k
+                    rows["acc_served"].append(matched(rounded_chain(base, w1, w2, anchor), truth))
+                    rows["acc_fp32"].append(matched(greedy_chain(base32, w1, w2, anchor), truth))
+                    rows["acc_union"].append(acc_union)
+                    rows["same_union"].append(same_union)
+                    rows["bias_rank"].append(
+                        (bias_above[:, 0] + 1).clamp(max=60000).tolist() + [0] * pad
+                    )
+                    rows["domain"].append(seq.domain)
+                    rows["k"].append(k)
+                    rows["acc_full"].append(matched(full, truth))
+                    rows["acc_short"].append(acc_short)
+                    rows["same_block"].append(same)
+                    rows["base_rank"].append(
+                        (above[:, 0] + 1).clamp(max=60000).tolist() + [0] * pad
+                    )
+                    conf, prob = chain_estimates(model, hidden, base, w1, w2, anchor, full)
+                    rows["chain_conf"].append(conf + [0.0] * pad)
+                    rows["chain_prob"].append(prob + [0.0] * pad)
+                    if k != k_tree:
+                        rows["tf_rank"].append([0] * k_tree)
+                        rows["tf_top"].append([[0.0] * 3] * k_tree)
+                        rows["entered"].append([[NEVER] * k_tree] * len(GAMMAS))
+                        rows["pop_logp"].append([[0.0] * POPS] * len(GAMMAS))
+                        rows["pop_depth"].append([[-1] * POPS] * len(GAMMAS))
+                        continue
+                    # Teacher forced: every depth sees the true previous token.
+                    prevs = torch.tensor([anchor] + truth[:-1], device=device)
+                    logp = torch.log_softmax(base + w1[prevs] @ w2.T, dim=-1)
+                    true_t = torch.tensor(truth, device=device)
+                    true_lp = logp.gather(1, true_t[:, None])
+                    rank = (logp > true_lp).sum(-1) + 1
+                    rows["tf_rank"].append(rank.clamp(max=250).tolist())
+                    rows["tf_top"].append(logp.topk(3, dim=-1).values.exp().tolist())
+                    trees = [best_first(base, w1, w2, anchor, truth, g) for g in GAMMAS]
+                    rows["entered"].append([t[0] for t in trees])
+                    rows["pop_logp"].append([t[1] for t in trees])
+                    rows["pop_depth"].append([t[2] for t in trees])
+                    anchors_done += 1
+
+    domains = sorted(set(rows["domain"]))
+    out = {
+        "domain_names": np.array(domains),
+        "domain": np.array([domains.index(d) for d in rows["domain"]], dtype=np.int16),
+        "k": np.array(rows["k"], dtype=np.int16),
+        "shortlists": np.array(SHORTLISTS, dtype=np.int16),
+        "acc_full": np.array(rows["acc_full"], dtype=np.int16),
+        "acc_short": np.array(rows["acc_short"], dtype=np.int16),
+        "same_block": np.array(rows["same_block"], dtype=np.int8),
+        "base_rank": np.array(rows["base_rank"], dtype=np.int32),
+        "bias_rank": np.array(rows["bias_rank"], dtype=np.int32),
+        "unions": np.array(UNIONS, dtype=np.int16),
+        "acc_served": np.array(rows["acc_served"], dtype=np.int16),
+        "acc_fp32": np.array(rows["acc_fp32"], dtype=np.int16),
+        "acc_union": np.array(rows["acc_union"], dtype=np.int16),
+        "same_union": np.array(rows["same_union"], dtype=np.int8),
+        "tf_rank": np.array(rows["tf_rank"], dtype=np.int16),
+        "tf_top": np.array(rows["tf_top"], dtype=np.float32),
+        "entered": np.array(rows["entered"], dtype=np.int16),
+        "gammas": np.array(GAMMAS, dtype=np.float32),
+        "pop_logp": np.array(rows["pop_logp"], dtype=np.float32),
+        "pop_depth": np.array(rows["pop_depth"], dtype=np.int8),
+        "chain_conf": np.array(rows["chain_conf"], dtype=np.float32),
+        "chain_prob": np.array(rows["chain_prob"], dtype=np.float32),
+    }
+    np.savez_compressed(args.output, **out)
+    summary = {
+        "sequences": seqs,
+        "tree_anchors": anchors_done,
+        "stopped_on_time_limit": stopped,
+        "seconds": round(time.time() - started, 1),
+        "by_domain": {},
+    }
+    for di, name in enumerate(domains):
+        for k in args.k_draft:
+            sel = (out["domain"] == di) & (out["k"] == k)
+            if not sel.any():
+                continue
+            entry = {
+                "anchors": int(sel.sum()),
+                "accepted_full": round(float(out["acc_full"][sel].mean()), 4),
+                "accepted_served_bf16": round(float(out["acc_served"][sel].mean()), 4),
+                "accepted_all_fp32": round(float(out["acc_fp32"][sel].mean()), 4),
+                "accepted_union": {
+                    f"{c}+{cp}": round(float(out["acc_union"][sel][:, i].mean()), 4)
+                    for i, (c, cp) in enumerate(UNIONS)
+                },
+                "same_union": {
+                    f"{c}+{cp}": round(float(out["same_union"][sel][:, i].mean()), 4)
+                    for i, (c, cp) in enumerate(UNIONS)
+                },
+                "accepted_shortlist": {
+                    int(c): round(float(out["acc_short"][sel][:, i].mean()), 4)
+                    for i, c in enumerate(SHORTLISTS)
+                },
+                "same_block": {
+                    int(c): round(float(out["same_block"][sel][:, i].mean()), 4)
+                    for i, c in enumerate(SHORTLISTS)
+                },
+            }
+            summary["by_domain"][f"{name}/k{k}"] = entry
+    print("SUMMARY " + json.dumps(summary))
+
+
+if __name__ == "__main__":
+    main()
