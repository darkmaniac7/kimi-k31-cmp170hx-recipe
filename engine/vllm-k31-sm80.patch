+std::string sanitize_shm_name(const std::string& raw, int32_t rank) {
+  std::string base = raw;
+  while (!base.empty() && base.front() == '/') {
+    base.erase(base.begin());
+  }
+  for (char& c : base) {
+    if (c == '/' || c == ' ' || c == '\t') c = '_';
+  }
+  if (base.empty()) {
+    base = "k31_p2p";
+  }
+  if (rank == 0) {
+    constexpr size_t kSuffixLen = 17;  // "_" + 16 hex digits
+    constexpr size_t kMaxBaseLen = kShmNameMax - 1 - 1 - kSuffixLen;
+    if (base.size() > kMaxBaseLen) {
+      base.resize(kMaxBaseLen);
+    }
+    uint64_t nonce = read_urandom_u64();
+    char hexbuf[20];
+    std::snprintf(hexbuf, sizeof(hexbuf), "_%016llx", static_cast<unsigned long long>(nonce));
+    return "/" + base + hexbuf;
+  }
+  std::string full = "/" + base;
+  if (full.size() >= kShmNameMax) {
+    full.resize(kShmNameMax - 1);
+  }
+  return full;
+}
