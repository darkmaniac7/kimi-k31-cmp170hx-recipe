+        poisoned = exl3_ple._POISONED_SCALE
+        assert host[[0, 4], 0].tolist() == [poisoned] * 2
+        assert python[[0, 4], 0].tolist() == [poisoned] * 2
+        # The host reader duplicates the descriptor it is built with.
+        file_fd = reader.fd
