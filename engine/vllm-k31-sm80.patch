+def test_build_info_and_api_version_validation(monkeypatch):
+    """native.load validates abi_version=1 and api_version>=1 for _k31_p2p_C."""
+    from vllm.sm80.kernels.k31q import native, p2p_ops
+
+    # Fake schema lookup so validation exercises build_info checks without a .so.
+    monkeypatch.setattr(
+        torch._C, "_dispatch_find_schema_or_throw", lambda name, overload: None
+    )
+
+    def _make_module(api_version):
+        info = dict(native.runtime_build_info(1))
+        if api_version is not None:
+            info["api_version"] = api_version
+        mod = types.ModuleType("vllm._k31_p2p_C")
+        mod.build_info = lambda: dict(info)  # type: ignore[attr-defined]
+        return mod
+
+    # Accepted: api_version 3 and 4 (requires api_version >= 3).
+    for ver in (3, 4):
+        mod = _make_module(ver)
+        monkeypatch.setitem(sys.modules, "vllm._k31_p2p_C", mod)
+        loaded = native.load(
+            "_k31_p2p_C",
+            p2p_ops._ABI_VERSION,
+            p2p_ops._OPERATORS,
+            p2p_ops.BUILD_COMMAND,
+            p2p_ops._API_VERSION,
+        )
+        assert loaded is mod
+        assert loaded.build_info()["api_version"] == ver
+
+    # Refused: missing api_version or api_version < 3 -> RuntimeError with build cmd.
+    for bad_ver in (None, 0, 1, 2):
+        monkeypatch.setitem(sys.modules, "vllm._k31_p2p_C", _make_module(bad_ver))
+        with pytest.raises(RuntimeError, match="build_p2p_standalone.py"):
+            native.load(
+                "_k31_p2p_C",
+                p2p_ops._ABI_VERSION,
+                p2p_ops._OPERATORS,
+                p2p_ops.BUILD_COMMAND,
+                p2p_ops._API_VERSION,
+            )
+
+    # Verify build_p2p_standalone.py --arch-list parsing.
+    spec = importlib.util.spec_from_file_location(
+        "build_p2p_standalone", REPO / "csrc" / "k31_p2p" / "build_p2p_standalone.py"
+    )
+    assert spec is not None and spec.loader is not None
+    builder = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(builder)
+    assert builder.parse_arch_flags("8.0;12.0", False) == [
+        "-gencode=arch=compute_80,code=sm_80",
+        "-gencode=arch=compute_120,code=sm_120",
+    ]
+    assert builder.parse_arch_flags("8.0;12.0", True) == [
+        "-gencode=arch=compute_80,code=sm_80",
+        "-gencode=arch=compute_80,code=compute_80",
+        "-gencode=arch=compute_120,code=sm_120",
+        "-gencode=arch=compute_120,code=compute_120",
+    ]
