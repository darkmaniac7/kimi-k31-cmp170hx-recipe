+def test_native_load_in_expert_chunks(monkeypatch, meta_platform, checkpoint):
+    """VLLM_K31Q_VQ_PACK_EXPERTS: the same packed buffers from several
+    vq_pack calls per projection, with only that many experts' records on
+    the device at a time. (The engine preallocates the packed buffer and
+    copies each part in; the stand-in sees the parts, not that buffer, so
+    only the record bytes are compared here.)"""
+    whole = FakeVqOps()
+    model, _, _, _ = construct.build_and_load(monkeypatch, checkpoint, native=whole)
+    step = 3
+    monkeypatch.setenv("VLLM_K31Q_VQ_PACK_EXPERTS", str(step))
+    parts = FakeVqOps()
+    chunked, _, _, _ = construct.build_and_load(monkeypatch, checkpoint, native=parts)
+    calls = -(-EXPERTS // step)
+    assert len(parts.packs) == calls * len(whole.packs)
+    assert [pack["idx"][0] for pack in parts.packs[:calls]] == [3, 3, 2]
+    for layer in VQ_LAYERS:
+        a, b = _routed(model, layer).k31_experts, _routed(chunked, layer).k31_experts
+        for name, tensor in a.named_buffers():
+            if "packed_idx" in name or "packed_scale" in name:
+                assert torch.equal(tensor, getattr(b, name)), name
+        assert torch.equal(a.packed_meta, b.packed_meta)
+    records = _expected_record_bytes(checkpoint, 1, 0)
+    assert max(e.records for e in whole.events) == max(records)
+    assert max(e.records for e in parts.events) == max(records) * step // EXPERTS
+    assert parts.live().records == 0
+    monkeypatch.setenv("VLLM_K31Q_VQ_PACK_EXPERTS", "-1")
+    with pytest.raises(ValueError, match="VLLM_K31Q_VQ_PACK_EXPERTS must be 0 or"):
+        construct.build_and_load(monkeypatch, checkpoint, native=FakeVqOps())
+
+
+@pytest.mark.parametrize("tp,rank", [(1, 0), (2, 0), (2, 1)])
+def test_native_tables_are_the_documented_layout(
+    monkeypatch, meta_platform, checkpoint, tp, rank
+):
+    """packed_ptrs [E, 9]: per projection q (0 = w1, 1 = w3, 2 = w2) the
+    addresses of the expert's packed indices, of its packed scales and of
+    the codebook. packed_meta [E, 12]: in_features, out_features, dim,
+    index_bits per projection. Read back through the pointers against the
+    checkpoint file."""
+    fake = FakeVqOps()
+    model, _, _, _ = construct.build_and_load(
+        monkeypatch, checkpoint, tp_size=tp, tp_rank=rank, native=fake
+    )
+    width = INTER // tp
+    book_pointers = {}
+    for layer in VQ_LAYERS:
+        experts = _routed(model, layer).k31_experts
+        pointers, metadata = experts.packed_ptrs, experts.packed_meta
+        assert pointers.dtype == metadata.dtype == torch.int64
+        assert tuple(pointers.shape) == (EXPERTS, 9)
+        assert tuple(metadata.shape) == (EXPERTS, 12)
+        for q, (w, role) in enumerate(fixture.PROJECTIONS):
+            rate = fixture.expert_rate(layer, w)
+            dim, bits, _ = fixture.RATES[rate]
+            out_f, in_f = _shape(role, width)
+            idx, scale = _records(checkpoint, layer, w, experts.blocks)
+            book = fixture.st_read(checkpoint / "codebooks.safetensors", f"vq.{rate}")
+            assert metadata[:, 4 * q : 4 * q + 4].unique(dim=0).tolist() == [
+                [in_f, out_f, dim, bits]
+            ]
+            stride = (out_f // 16) * (in_f // 128) * words_per_lane(dim, bits) * 32 * 4
+            for expert in range(EXPERTS):
+                p_idx, p_scale, p_book = pointers[expert, 3 * q : 3 * q + 3].tolist()
+                assert p_idx % 16 == 0 and p_scale % 16 == 0 and p_book % 16 == 0
+                assert construct.memory_at(
+                    p_idx, np.int32, (3,)
+                ).tolist() == fingerprint(idx[expert])
+                assert np.array_equal(
+                    construct.memory_at(p_scale, np.uint16, (16,)),
+                    scale[expert].reshape(-1)[:16].view(np.uint16),
+                )
+                assert np.array_equal(
+                    construct.memory_at(p_book, np.uint16, book.shape),
+                    book.view(np.uint16),
+                )
+            assert (pointers[1:, 3 * q] - pointers[:-1, 3 * q]).unique().tolist() == [
+                stride
+            ]
+            book_pointers.setdefault(rate, set()).add(int(pointers[0, 3 * q + 2]))
+            assert experts.vq_codebooks[w].data_ptr() == int(pointers[0, 3 * q + 2])
+    # One device copy of each codebook for the process, not one per layer:
+    # layers 2 and 4 both read vq_d2_b4.
+    assert sorted(book_pointers) == sorted(
+        {r for layer in VQ_LAYERS for r in fixture.LAYER_RATES[layer]}
+    )
+    assert all(len(addresses) == 1 for addresses in book_pointers.values())
+    two, four = (_routed(model, n).k31_experts for n in (2, 4))
+    assert two.vq_codebooks["w1"] is four.vq_codebooks["w2"]
+    moved = [shape for kind, shape in fake.moves if kind == "codebooks"]
+    assert len(moved) == len(book_pointers) == 4
+
+
+# -- launches ----------------------------------------------------------------------
+
+
+def _kernel(monkeypatch, directory, layer, max_rows, tp=2, rank=1):
+    fake = FakeVqOps()
+    model, _, _, _ = construct.build_and_load(
+        monkeypatch, directory, tp_size=tp, tp_rank=rank, native=fake
+    )
+    routed = _routed(model, layer)
+    routed.register_buffer("k31_expert_map", torch.arange(EXPERTS, dtype=torch.int32))
+    return fake, routed, routed.quant_method.build_native_kernel(routed, max_rows)
+
+
+def _check_launches(fake, routed, kernel, x, ids, weights, output, workspace2, want):
+    """``want``: (operator, rows) per launch, in order."""
+    experts = routed.k31_experts
+    assert [(call["name"], call["rows"]) for call in fake.calls] == want
+    start = 0
+    for call in fake.calls:
+        assert call["x"] == x.data_ptr() + start * LATENT * 2
+        assert call["out"] == output.data_ptr() + start * LATENT * 2
+        assert call["ids"] == ids.data_ptr() + start * TOPK * 4
+        assert call["weights"] == weights.data_ptr() + start * TOPK * 4
+        assert call["pointers"] is experts.packed_ptrs
+        assert call["metadata"] is experts.packed_meta
+        assert call["expert_map"] is routed.k31_expert_map
+        assert call["intermediate"] == experts.local_intermediate
+        assert call["betas"] == (BETA, LINEAR_BETA) and call["swiglu_limit"] == 0.0
+        assert call["workspace"].dtype == torch.float32
+        assert call["workspace"].numel() == kernel.workspace_elements
+        assert call["workspace"].data_ptr() == workspace2.data_ptr()
+        start += call["rows"]
+    assert start == x.shape[0]
+    assert torch.equal(output, torch.full_like(output, fake.fill))
+
+
+def test_native_launches_and_static_rates(monkeypatch, meta_platform, checkpoint):
+    from vllm.sm80.kernels.k31q import moe
+
+    layer = 4  # w1 and w3 at (4, 6, 128), w2 at (2, 4, 128)
+    fake, routed, kernel = _kernel(monkeypatch, checkpoint, layer, max_rows=5000)
+    assert type(kernel) is moe.K31VqNativeExperts
+    # The workspace is sized once, for one launch: the prefill op's 2,048 rows.
+    assert fake.workspace_calls == [(2048, LATENT, INTER // 2, TOPK, EXPERTS)]
+    assert kernel.workspace_elements == 700 + 2048
+    assert kernel.launcher.launch_rows == 2048
+    assert (kernel.launcher.rate_gate_up, kernel.launcher.rate_down) == (
+        RATE_IDS[4, 6],
+        RATE_IDS[2, 4],
+    )
+    for rows, want in (
+        (1, [("decode", 1)]),
+        (64, [("decode", 64)]),
+        (65, [("prefill", 65)]),
+        (2048, [("prefill", 2048)]),
+        (2049, [("prefill", 2048), ("decode", 1)]),
+        (4200, [("prefill", 2048), ("prefill", 2048), ("prefill", 104)]),
+    ):
+        fake.calls.clear()
+        x, ids, weights = _inputs(rows)
+        # Nothing in the forward reads a tensor's value on the host.
+        with construct.no_host_reads(monkeypatch):
+            output, workspace2 = _apply(kernel, x, ids, weights)
+        assert workspace2.numel() == 2 * kernel.workspace_elements
+        _check_launches(fake, routed, kernel, x, ids, weights, output, workspace2, want)
+        assert {call["rates"] for call in fake.calls} == {(4, 1)}
+    assert fake.workspace_calls == [(2048, LATENT, INTER // 2, TOPK, EXPERTS)]
+    with pytest.raises(ValueError, match="row capacity"):
+        _apply(kernel, *_inputs(5001))
+    fake.calls.clear()
+    _apply(kernel, *(t[:0] for t in _inputs(4)))
+    assert fake.calls == []
+    # The guard itself: a value read does raise inside it.
+    with construct.no_host_reads(monkeypatch), pytest.raises(AssertionError):
+        _inputs(2)[1].tolist()
+
+    # A row cap below the operator's: more launches, a smaller workspace.
+    monkeypatch.setenv("VLLM_K31Q_MOE_CHUNK_ROWS", "100")
+    fake.workspace_calls.clear()
+    kernel = routed.quant_method.build_native_kernel(routed, 5000)
+    assert fake.workspace_calls == [(100, LATENT, INTER // 2, TOPK, EXPERTS)]
+    fake.calls.clear()
+    x, ids, weights = _inputs(250)
+    output, workspace2 = _apply(kernel, x, ids, weights)
+    _check_launches(
+        fake,
+        routed,
+        kernel,
+        x,
+        ids,
+        weights,
+        output,
+        workspace2,
+        [("prefill", 100), ("prefill", 100), ("decode", 50)],
+    )
+    # A cap above the most rows a call can have changes nothing.
+    kernel = routed.quant_method.build_native_kernel(routed, 60)
+    assert kernel.launcher.launch_rows == 60
+    monkeypatch.setenv("VLLM_K31Q_MOE_CHUNK_ROWS", "-5")
+    with pytest.raises(ValueError, match="VLLM_K31Q_MOE_CHUNK_ROWS must be 0 or"):
+        routed.quant_method.build_native_kernel(routed, 60)
+
+
+def test_static_rate_ids_per_layer(tmp_path, monkeypatch, meta_platform, checkpoint):
+    fake = FakeVqOps()
+    model, _, _, _ = construct.build_and_load(monkeypatch, checkpoint, native=fake)
+    got = {n: _routed(model, n).k31_experts.vq_rate_ids() for n in VQ_LAYERS}
+    assert got == {1: (0, 0), 2: (1, 1), 3: (2, 2), 4: (4, 1)}
+    # Gate and up at different rates: the ops read them from packed_meta.
+    monkeypatch.setitem(fixture.LAYER_RATES, 1, ("vq_d2_b3", "vq_d2_b4", "vq_d2_b5"))
+    fixture.write_checkpoint(tmp_path / "mixed")
+    model, _, _, _ = construct.build_and_load(
+        monkeypatch, tmp_path / "mixed", native=FakeVqOps()
+    )
+    experts = _routed(model, 1).k31_experts
+    assert experts.vq_rate_ids() == (-1, 2)
+    assert experts.packed_meta[0].tolist() == [
+        LATENT, INTER, 2, 3, LATENT, INTER, 2, 4, INTER, LATENT, 2, 5
+    ]  # fmt: skip
+
+
+def test_rates_the_native_ops_lack_are_refused(tmp_path, monkeypatch, meta_platform):
+    """At construction, before anything is read; the reference serves them."""
+    monkeypatch.setitem(fixture.RATES, "vq_d2_b6", (2, 6, 128))
+    monkeypatch.setitem(fixture.LAYER_RATES, 2, ("vq_d2_b6",) * 3)
+    fixture.write_checkpoint(tmp_path / "rate")
+    construct.set_groups(monkeypatch, 1, 0, native=FakeVqOps())
+    with pytest.raises(ValueError, match="layers.2.*a rate the native VQ ops do not"):
+        construct.build_model(construct.vllm_config(tmp_path / "rate"))
+    model, _, report, _ = construct.build_and_load(monkeypatch, tmp_path / "rate")
+    assert _routed(model, 2).k31_experts.geometry["w1"].index_bits == 6
+
+    monkeypatch.setitem(fixture.RATES, "vq_d2_b6", (2, 4, 64))
+    fixture.write_checkpoint(tmp_path / "group")
+    construct.set_groups(monkeypatch, 1, 0, native=FakeVqOps())
+    with pytest.raises(ValueError, match="scale groups of 64 inputs"):
+        construct.build_model(construct.vllm_config(tmp_path / "group"))
+
+
+def test_native_through_the_modular_kernel(monkeypatch, meta_platform, checkpoint):
+    """The seam the model uses: RoutedExperts.quant_method.apply through
+    upstream's FusedMoEKernel, its prepare/finalize and its workspace
+    manager, with the native launcher behind it."""
+    from vllm.config import set_current_vllm_config
+    from vllm.sm80.kernels.k31q import moe
+    from vllm.v1.worker import workspace
+
+    fake = FakeVqOps()
+    model, config, _, _ = construct.build_and_load(monkeypatch, checkpoint, native=fake)
+    routed = _routed(model, 2)
+    method = routed.quant_method
+    # The packed buffers of a serving process are CUDA tensors; here they are
+    # host memory, which process_weights_after_loading refuses.
+    with pytest.raises(ValueError, match="must be on CUDA"):
+        method.process_weights_after_loading(routed)
+    monkeypatch.setattr(moe.K31Experts, "require_loaded", lambda self, cuda=True: None)
+    x, ids, weights = _inputs(6)
+    monkeypatch.setattr(workspace, "_manager", None)
+    with set_current_vllm_config(config):
+        method.process_weights_after_loading(routed)
+        kernel = method.moe_kernel.fused_experts
+        assert type(kernel) is moe.K31VqNativeExperts and not method.is_monolithic
+        rows = kernel.max_rows
+        assert 6 <= rows <= 2048 and rows == method.moe.max_num_tokens
+        assert fake.workspace_calls == [(rows, LATENT, INTER, TOPK, EXPERTS)]
+        workspace.init_workspace_manager(torch.device("cpu"))
+        out = method.apply(routed, x, weights, ids, None, None)
+    assert out.shape == (6, LATENT) and out.dtype == torch.bfloat16
+    assert torch.equal(out, torch.full_like(out, fake.fill))
+    (call,) = fake.calls
+    assert (call["name"], call["rows"], call["rates"]) == ("decode", 6, (1, 1))
+    assert call["pointers"] is routed.k31_experts.packed_ptrs
+    assert call["expert_map"] is routed.k31_expert_map
+    assert routed.k31_expert_map.tolist() == list(range(EXPERTS))
+    assert call["workspace"].dtype == torch.float32
+    assert call["workspace"].numel() == 700 + rows
+    assert call["workspace"].data_ptr() % 16 == 0
+    w1, w2 = method._weights(routed)
+    assert w1.shape[0] == EXPERTS and w2.shape[0] == EXPERTS
