+            rec_rec, ssi, qsl, acc, -5.0, 1e-6, out_rec, sm,
+        )
+        assert torch.equal(out_rec, out_leg), f"B=4 step {step_idx} out mismatch"
+        for b in range(B):
+            base = int(ssi[b, 0])
+            assert int(sm[base]) == 1
+            assert torch.equal(rec_rec[base], rec_leg[base])
