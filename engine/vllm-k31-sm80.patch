+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Load format "k31q": a Kimi K3.1 k31q checkpoint, one pipeline stage and
+tensor-parallel rank at a time.
+
+What a rank loads follows from the model it built, not from a plan of its
+own. Upstream builds ``PPMissingLayer`` outside the stage's layer range and
+for the embedding, final norm and head on the ranks that lack them, and a
+missing layer asks for no quantization method, so only this stage's modules
+carry a loader-visible method. The loader walks those modules, then offers
+every remaining tensor of this stage to ``model.load_weights``, and keeps a
+ledger over every tensor of the directory (the fork's
+``Exl3LoadLedger``): each one ends as ``consumed`` or ``unused`` with a
+reason, a tensor nobody owns is an error, and so is a model parameter nothing
+loaded. The directory may be the whole checkpoint or a stage view that holds
+only this stage's files.
+
+The model is the class config.json names: the K3.1 wrapper, with the text
+model under ``language_model``, or the text model built on its own (tests).
+The wrapper's vision tower and projector load from ``vision.safetensors``
+through the model's own ``load_weights`` like every plain tensor, on the first
+pipeline stage only (upstream builds placeholders elsewhere). A checkpoint
+without that file serves text only: the tower must be a placeholder
+(``--language-model-only``); a tower built for real is refused, here and at
+construction (K31QConfig._require_vision_source), never left uninitialized.
+
+Tensor parallelism: dense EXL3 matrices and plain weights are cut by the
+methods' own slices (whole 128 blocks, as the fork cuts them). Routed experts
+are read by ``K31Experts.load``: this rank's I-blocks of each stacked tensor,
+one byte range per expert.
+"""
+
+import time
+from collections import Counter
+from contextlib import ExitStack
+from dataclasses import dataclass
+from pathlib import Path
+
+from safetensors import safe_open
+from torch import nn
+
+from vllm.config import ModelConfig, VllmConfig, get_current_vllm_config
+from vllm.distributed import get_pp_group, get_tensor_model_parallel_rank
+from vllm.logger import init_logger
+from vllm.model_executor.model_loader.default_loader import DefaultModelLoader
+from vllm.model_executor.models.utils import is_pp_missing_parameter
+from vllm.sm80.kernels.exl3.quant import Exl3LinearMethod
+from vllm.sm80.kernels.exl3.utils import Exl3LoadLedger
+from vllm.sm80.kernels.k31q import dense, p2p
+from vllm.sm80.kernels.k31q.dspark_k6 import (
+    DSPARK_EXL3_QUANT_METHOD,
+    load_dspark_k6_weights,
+)
+from vllm.sm80.kernels.k31q.manifest import CODEBOOK_PREFIX, K31QManifest
+from vllm.sm80.kernels.k31q.moe import K31Experts, K31MoEMethod
+from vllm.sm80.kernels.k31q.quant import (
+    LOAD_FORMAT,
+    ROOTS,
+    TEXT_ROOT,
+    VISION_ROOTS,
+    K31FusedLinearMethod,
+    K31QConfig,
+    no_vision_message,
+)
+from vllm.tracing import instrument
+
+logger = init_logger(__name__)
+
+_PACKED_SUFFIXES = (".trellis", ".suh", ".svh", ".mcg", ".mul1", ".vq_idx", ".vq_scale")
+
+
+@dataclass
+class K31QLoadReport:
+    """What one rank loaded."""
+
+    loaded: set[str]
+    # Checkpoint tensor -> (disposition, owner or reason).
+    ledger: dict[str, tuple[str, str]]
+    layers: tuple[int, int]  # this stage's [start, end)
+    pp_rank: int
+    pp_size: int
+    tp_rank: int
+    tp_size: int
+    expert_bytes: int  # bytes read for routed experts
+
+    def counts(self) -> Counter:
+        return Counter(disposition for disposition, _ in self.ledger.values())
+
+
+class K31QModelLoader(DefaultModelLoader):
+    """Load format "k31q" (--load-format k31q), registered by vllm/sm80/plugin.py.
+
+    k31q checkpoints get the checks below and manifest-driven loading;
+    anything else loads as with the default loader. K31QConfig refuses k31q
+    checkpoints under any other load format.
+    """
+
+    def download_model(self, model_config: ModelConfig) -> None:
+        if model_config.quantization not in (LOAD_FORMAT, DSPARK_EXL3_QUANT_METHOD):
+            super().download_model(model_config)
+        elif not Path(model_config.model).is_dir():
+            raise ValueError(
+                f"Download the {model_config.quantization} checkpoint directory before loading"
+            )
+
+    def create_model(
+        self, vllm_config: VllmConfig, model_config: ModelConfig, prefix: str = ""
+    ) -> nn.Module:
+        if model_config.quantization in (LOAD_FORMAT, DSPARK_EXL3_QUANT_METHOD):
+            from vllm.sm80.kernels.exl3.ops import ensure_extension
+
+            offload = vllm_config.offload_config
+            if offload.uva.cpu_offload_gb or offload.prefetch.offload_group_size:
+                raise ValueError("k31q does not support runtime weight offload")
+            if vllm_config.lora_config is not None:
+                raise ValueError("k31q does not support LoRA")
+            ensure_extension()
+        return super().create_model(vllm_config, model_config, prefix)
+
+    def load_model(
+        self, vllm_config: VllmConfig, model_config: ModelConfig, prefix: str = ""
+    ) -> nn.Module:
+        model = super().load_model(vllm_config, model_config, prefix)
+        if model_config.quantization == LOAD_FORMAT:
+            fused_mla = 0
+            for module in model.modules():
+                prepare = getattr(
+                    module, "maybe_prepare_fused_qkv_a_g_launcher", None
+                )
+                if prepare is not None and prepare() is not None:
+                    fused_mla += 1
+            if fused_mla:
+                logger.info(
+                    "Kimi K3.1 MLA fused q_a+kv_a+g_proj decode launcher prepared "
+                    "on %d layer(s) (VLLM_K31Q_MLA_FUSE_G_PROJ=1).",
+                    fused_mla,
+                )
+            # Which dense module launches where (VLLM_K31Q_DENSE_BACKEND),
+            # once process_weights_after_loading has chosen.
+            dense.log_backends(model)
+        elif model_config.quantization == DSPARK_EXL3_QUANT_METHOD:
+            dense.log_backends(model)
+        if p2p.is_enabled():
+            # Synchronize the TP2 P2P handshake before CUDA graph capture.
+            p2p.maybe_init_communicator()
+        return model
+
+    @instrument(span_name="Load weights")
+    def load_weights(self, model: nn.Module, model_config: ModelConfig) -> None:
+        if model_config.quantization == DSPARK_EXL3_QUANT_METHOD:
+            self.counter_before_loading_weights = time.perf_counter()
+            load_dspark_k6_weights(model, model_config)
+            self.counter_after_loading_weights = time.perf_counter()
+            return
+        if model_config.quantization != LOAD_FORMAT:
+            super().load_weights(model, model_config)
+            return
+        self.counter_before_loading_weights = time.perf_counter()
+        load_k31q_weights(model, model_config)
+        self.counter_after_loading_weights = time.perf_counter()
+
+
+def require_cuda_parameters(model: nn.Module) -> None:
+    """Refuse a loaded k31q model with a parameter off the GPU."""
+    for name, parameter in model.named_parameters():
+        if not parameter.is_cuda:
+            raise ValueError(f"k31q parameter must remain CUDA-owned: {name}")
+
+
+def _refuse_bias(module: nn.Module, what: str) -> None:
+    """A module bias that no checkpoint tensor fills would stay
+    uninitialized (the fork's loader: "Missing EXL3 bias"). The K3.1 model
+    has none on a packed projection, and this loader reads none."""
+    if getattr(module, "bias", None) is not None:
+        raise ValueError(
+            f"Missing k31q bias: the module of {what} has a bias, which the "
+            "k31q loader has no source and no loader for"
+        )
+
+
+def stage_layers(model: nn.Module) -> tuple[int, int]:
+    """[start, end) of the decoder layers this rank built: the text model's
+    own ``start_layer`` and ``end_layer`` (vllm.model_executor.models.utils
+    .make_layers, which reads VLLM_PP_LAYER_PARTITION)."""
+    for module in model.modules():
+        start, end = (
+            getattr(module, "start_layer", None),
+            getattr(module, "end_layer", None),
+        )
+        if type(start) is int and type(end) is int:
+            return start, end
+    raise ValueError("k31q: the model exposes no pipeline layer range")
+
+
+def _model_name(model: nn.Module, name: str) -> str | None:
+    """Checkpoint tensor name -> the name ``model.load_weights`` takes, or
+    None when the tensor's top-level module is not part of this model (a text
+    model built on its own has no vision tower)."""
+    if any(name.startswith(root) and hasattr(model, root[:-1]) for root in ROOTS):
+        return name
+    if not name.startswith(ROOTS):
+        return name
+    if name.startswith(TEXT_ROOT):
+        return name.removeprefix(TEXT_ROOT)
+    return None
+
+
+def load_k31q_weights(model: nn.Module, model_config) -> K31QLoadReport:
+    from vllm.sm80.kernels.exl3.ops import ensure_extension
+
+    ensure_extension()
+    config = get_current_vllm_config()
+    quant = (
+        model.quant_config if hasattr(model, "quant_config") else config.quant_config
+    )
+    if not isinstance(quant, K31QConfig):
+        raise ValueError("k31q loading needs the k31q quantization config")
+    manifest = quant.manifest
+    if not isinstance(manifest, K31QManifest):
+        raise ValueError("k31q checkpoint manifest was not initialized")
+    start, end = stage_layers(model)
+    ledger = Exl3LoadLedger(manifest)
+    loaded: set[str] = set()
+    expert_bytes = 0
+    codebooks: dict[str, list[str]] = {}
+    modules = dict(model.named_modules())
+
+    with ExitStack() as stack:
+        files = {
+            path: stack.enter_context(
+                safe_open(str(path), framework="pt", device="cpu")
+            )
+            for path in sorted({header.path for header in manifest.tensors.values()})
+        }
+        # 1. Modules that own packed or fused sources. Only the parameters
+        # a method really fills count as loaded: anything else the module
+        # holds (a bias) must find a source below or fail the final check.
+        for name, module in modules.items():
+            method = getattr(module, "quant_method", None)
+            if isinstance(method, K31FusedLinearMethod):
+                _refuse_bias(module, f"fused projection {method.source}")
+                method.load(module, files, ledger)
+                owned = ("exl3_weights.", "plain_weight")
+                if getattr(module, "weight", None) is not None:
+                    if module.weight.numel():
+                        raise ValueError(
+                            f"k31q fused projection holds a merged weight: {name}"
+                        )
+                    # The zero-column weight upstream's padding needs.
+                    loaded.add(f"{name}.weight")
+            elif isinstance(method, Exl3LinearMethod):
+                for weight in module.exl3_weights:
+                    weight.load(files, ledger)
+                    if f"{weight.matrix.prefix}.bias" in manifest.tensors:
+                        raise ValueError(
+                            f"k31q EXL3 matrix with a bias has no loader: "
+                            f"{weight.matrix.prefix}"
+                        )
+                    _refuse_bias(module, f"EXL3 matrix {weight.matrix.prefix}")
+                owned = ("exl3_weights.",)
+            elif isinstance(method, K31MoEMethod):
+                experts: K31Experts = module.k31_experts
+                experts.load(files, ledger)
+                expert_bytes += experts.bytes_read
+                for key in experts.codebook_keys:
+                    codebooks.setdefault(key, []).append(experts.prefix)
+                owned = ("k31_experts.",)
+            else:
+                continue
+            loaded.update(
+                f"{name}.{key}"
+                for key, _ in module.named_parameters()
+                if key.startswith(owned)
+            )
+
+        # 2. Codebooks are shared by layers: one ledger entry each.
+        for key in manifest.tensors:
+            if not key.startswith(CODEBOOK_PREFIX):
+                continue
+            owners = codebooks.get(key)
+            if owners:
+                ledger.mark(key, "consumed", f"{len(owners)} MoE layer(s) of this rank")
+            else:
+                ledger.mark(
+                    key, "unused", "no VQ layer of this stage uses this codebook"
+                )
+
+        # 3. Everything else: another stage's, a module this rank lacks, or a
+        # plain tensor for model.load_weights.
+        for name, header in manifest.tensors.items():
+            if name in ledger.entries:
+                continue
+            layer = manifest.tensor_layer(name)
+            if layer is not None and not start <= layer < end:
+                ledger.mark(name, "unused", "layer of another pipeline stage")
+                continue
+            target = _model_name(model, name)
+            if target is None:
+                ledger.mark(name, "unused", "module is not part of this model")
+                continue
+            if is_pp_missing_parameter(target, model):
+                ledger.mark(
+                    name, "unused", "module is not built on this pipeline stage"
+                )
+                continue
+            if name.endswith(_PACKED_SUFFIXES):
+                raise ValueError(f"k31q packed tensor has no runtime owner: {name}")
+            tensor = files[header.path].get_tensor(name)
+            try:
+                consumed = model.load_weights(iter([(target, tensor)]))
+            except KeyError as exc:
+                # Upstream's load_weights indexes its parameters by the name.
+                raise ValueError(
+                    f"k31q plain tensor has no runtime owner: {name}"
+                ) from exc
+            if not consumed:
+                raise ValueError(f"k31q plain tensor has no runtime owner: {name}")
+            loaded.update(consumed)
+            ledger.mark(name, "consumed", ",".join(sorted(consumed)))
+        ledger.finish()
+
+    missing = {name for name, _ in model.named_parameters() if name not in loaded}
+    # A checkpoint without the vision file serves text only: the tower and
+    # the projector must then be placeholders, which hold no parameters
+    # (--language-model-only, or a pipeline stage after the first). A tower
+    # built for real has nothing to load from and is refused, never left
+    # uninitialized.
+    vision = sorted(name for name in missing if name.startswith(VISION_ROOTS))
+    if vision and not manifest.has_vision:
+        raise ValueError(
+            no_vision_message(
+                manifest.directory,
+                f"{len(vision)} vision parameters without a source, such as "
+                f"{vision[0]}",
+            )
+        )
+    if missing:
+        raise ValueError(f"Unloaded k31q runtime parameters: {sorted(missing)[:16]}")
+    require_cuda_parameters(model)
+    pp = get_pp_group()
+    report = K31QLoadReport(
+        loaded=loaded,
+        ledger=dict(ledger.entries),
+        layers=(start, end),
+        pp_rank=pp.rank_in_group,
+        pp_size=pp.world_size,
+        tp_rank=get_tensor_model_parallel_rank(),
+        tp_size=config.parallel_config.tensor_parallel_size,
+        expert_bytes=expert_bytes,
+    )
+    counts = report.counts()
+    logger.info(
+        "k31q checkpoint, BF16 activations; pipeline stage %d/%d holds layers "
+        "[%d, %d); TP rank %d/%d; sources: %d consumed, %d unused; routed "
+        "experts read %.2f GiB",
+        report.pp_rank,
+        report.pp_size,
+        start,
+        end,
+        report.tp_rank,
+        report.tp_size,
+        counts["consumed"],
+        counts["unused"],
+        expert_bytes / 2**30,
+    )
+    spec = config.speculative_config
+    if not (spec is not None and spec.draft_model_config is not None):
+        # A draft model built after the target still reads the manifest.
+        quant.release_manifest()
+    return report
