+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""TP2 one-shot PCIe P2P all-reduce manager and custom ops for Kimi K3.1.
+
+Replaces the three per-layer TP2 decode collectives in Kimi K3.1
+(attention ``o_proj`` reduce, routed-expert latent reduce, and shared-expert
+reduce) plus Layer 0 dense MLP ``down_proj`` with two ``_k31_p2p_C`` calls:
+  1. ``p2p_allreduce_residual`` on ``o_proj`` (and Layer 0 ``mlp.down_proj``).
+  2. ``p2p_moe_dual_reduce_rmsnorm`` inside ``LatentMoERunner`` to merge the
+     routed ``[M, 3584]`` and shared ``[M, 7168]`` partials and fuse the
+     FP32 ``RMSNorm(3584)`` in one PCIe exchange.
+
+Off by default (``VLLM_K31_P2P_ALLREDUCE=0``). When enabled, activates only
+when ``tp_size == 2``, device capability is ``(8, 0)`` or ``(12, 0)``, the
+``vllm._k31_p2p_C`` extension loads with ``api_version >= 3``, and the
+byte-moving ``verify_peer_transport`` probe succeeds on both ranks (with
+automatic collective fallback from direct BAR1 P2P IPC to mapped POSIX SHM,
+and from SHM to vLLM standard TP all-reduce if both fail).
+"""
+
+from __future__ import annotations
+
+import atexit
+import importlib.util
+import os
+import re
+import threading
+from functools import partial
+from typing import Any
+
+import torch
+import torch.distributed as dist
+
+from vllm import envs
+from vllm.logger import init_logger
+from vllm.utils.torch_utils import direct_register_custom_op
+
+logger = init_logger(__name__)
+
+LIBRARY = "_k31_p2p_C"
+SUPPORTED_CAPABILITIES = ((8, 0), (12, 0))
+DEFAULT_MAX_BYTES = 4 * 1024 * 1024
+DEFAULT_PROBE_TIMEOUT_MS = 2000
+WATCHDOG_POLL_S = 0.25
+
+_ERROR_NAMES = {
+    0: "OK",
+    1: "ERR_TIMEOUT",
+    2: "ERR_ABORT",
+    3: "ERR_FRAMING_MISMATCH",
+    4: "ERR_GENERATION_MISMATCH",
+    5: "ERR_OP_MISMATCH",
+}
+
+
+class K31P2PError(RuntimeError):
+    """Fatal error raised when a _k31_p2p_C handle records a sticky kernel error
+    or peer-death watchdog abort (requires teardown, re-handshake, and CUDA graph
+    re-capture before resuming)."""
+
+
+def _error_name(code: int) -> str:
+    return _ERROR_NAMES.get(int(code), f"ERR_UNKNOWN({code})")
+
+
+def _pid_ns_inode() -> int | None:
+    """Return current Linux PID namespace inode, or None if unavailable."""
+    try:
+        return int(os.stat("/proc/self/ns/pid").st_ino)
+    except OSError:
+        return None
+
+
+def is_enabled() -> bool:
+    """Whether the operator opted into K3.1 TP2 P2P all-reduce."""
+    return bool(envs.VLLM_K31_P2P_ALLREDUCE)
+
+
+def configured_max_rows() -> int:
+    """Row count ceiling for the P2P path; larger batches fall back."""
+    rows = int(envs.VLLM_K31_P2P_MAX_ROWS)
+    if rows <= 0:
+        raise ValueError(f"VLLM_K31_P2P_MAX_ROWS must be positive, got {rows}")
+    return rows
+
+
+def configured_force_shm() -> bool:
+    return bool(envs.VLLM_K31_P2P_FORCE_SHM)
+
+
+def configured_timeout_ms() -> int:
+    ms = int(envs.VLLM_K31_P2P_TIMEOUT_MS)
+    if ms < 0:
+        raise ValueError(f"VLLM_K31_P2P_TIMEOUT_MS must be >= 0, got {ms}")
+    return ms
+
+
+def library_built() -> bool:
+    """Whether the compiled vllm._k31_p2p_C extension is present on disk."""
+    return importlib.util.find_spec(f"vllm.{LIBRARY}") is not None
+
+
+def load_p2p_native():
+    """Import and validate vllm._k31_p2p_C (requiring api_version >= 3)."""
+    from vllm.sm80.kernels.k31q import p2p_ops
+
+    p2p_ops.ensure_p2p_extension()
+    return p2p_ops
+
+
+def _device_capability() -> tuple[int, int] | None:
+    """Return (major, minor) CUDA capability, or None if unavailable."""
+    from vllm.platforms import current_platform
+
+    cap = current_platform.get_device_capability()
+    if cap is None:
+        return None
+    if hasattr(cap, "major") and hasattr(cap, "minor"):
+        return (int(cap.major), int(cap.minor))
+    return (int(cap[0]), int(cap[1]))
+
+
+def _current_device_ordinal(tp_group: Any) -> int:
+    if torch.cuda.is_available() and torch.cuda.is_initialized():
+        return int(torch.cuda.current_device())
+    idx = getattr(tp_group, "device_index", None)
+    if isinstance(idx, int) and idx >= 0:
+        return idx
+    local_rank = getattr(tp_group, "local_rank", 0)
+    return int(local_rank) if isinstance(local_rank, int) and local_rank >= 0 else 0
+
+
+def _is_stream_capturing() -> bool:
+    if not (torch.cuda.is_available() and torch.cuda.is_initialized()):
+        return False
+    return bool(torch.cuda.is_current_stream_capturing())
+
+
+def tp_group_identifier(tp_group: Any) -> str:
+    """Deterministic TP-pair identifier shared by both ranks of the pair."""
+    ranks = getattr(tp_group, "ranks", None)
+    if ranks:
+        return "_".join(str(int(r)) for r in ranks)
+    raw = str(getattr(tp_group, "unique_name", "0"))
+    cleaned = re.sub(r"[^A-Za-z0-9_]+", "_", raw).strip("_")
+    return cleaned or "0"
+
+
+def make_shm_name(pp_rank: int, tp_group_id: str) -> str:
+    """Build a PP-stage and TP-pair scoped POSIX SHM name."""
+    safe_id = re.sub(r"[^A-Za-z0-9_]+", "_", str(tp_group_id)).strip("_") or "0"
+    return f"k31_p2p_pp{int(pp_rank)}_tp{safe_id}"
+
+
+def _all_gather_object(tp_group: Any, obj: Any) -> list[Any]:
+    """Gather one small Python object from each rank in ``tp_group`` over CPU."""
+    if hasattr(tp_group, "all_gather_object"):
+        return list(tp_group.all_gather_object(obj))
+    cpu_group = getattr(tp_group, "cpu_group", None)
+    if cpu_group is None:
+        raise RuntimeError(
+            "TP group has neither all_gather_object nor a CPU Gloo group"
+        )
+    gathered: list[Any] = [None] * int(tp_group.world_size)
+    dist.all_gather_object(gathered, obj, group=cpu_group)
+    return gathered
+
+
+# -- Registered custom ops (CUDA-Graph and torch.compile safe) ----------------
+
+
+def _allreduce_impl(x_partial: torch.Tensor, handle: int) -> torch.Tensor:
+    ops = load_p2p_native()
+    out_sum = torch.empty_like(x_partial)
+    ops.p2p_allreduce_residual(handle, x_partial, out_sum, None, None)
+    return out_sum
+
+
+def _allreduce_fake(x_partial: torch.Tensor, handle: int) -> torch.Tensor:
+    torch._check(x_partial.dtype == torch.bfloat16)
+    torch._check(x_partial.dim() == 2)
+    return torch.empty_like(x_partial)
+
+
+def _allreduce_residual_impl(
+    x_partial: torch.Tensor,
+    residual: torch.Tensor,
+    handle: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    ops = load_p2p_native()
+    out_sum = torch.empty_like(x_partial)
+    out_res = torch.empty_like(residual)
+    ops.p2p_allreduce_residual(handle, x_partial, out_sum, residual, out_res)
+    return out_sum, out_res
+
+
+def _allreduce_residual_fake(
+    x_partial: torch.Tensor,
+    residual: torch.Tensor,
+    handle: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    torch._check(x_partial.dtype == torch.bfloat16)
+    torch._check(residual.dtype == torch.bfloat16)
+    torch._check(x_partial.dim() == 2)
+    torch._check(residual.shape == x_partial.shape)
+    return torch.empty_like(x_partial), torch.empty_like(residual)
+
+
+def _moe_dual_reduce_rmsnorm_impl(
+    routed_partial: torch.Tensor,
+    shared_partial: torch.Tensor,
+    rms_weight: torch.Tensor,
+    eps: float,
+    handle: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    ops = load_p2p_native()
+    out_routed_normed = torch.empty_like(routed_partial)
+    out_shared_sum = torch.empty_like(shared_partial)
+    ops.p2p_moe_dual_reduce_rmsnorm(
+        handle,
+        routed_partial,
+        shared_partial,
+        rms_weight,
+        float(eps),
+        out_routed_normed,
+        out_shared_sum,
+        None,
+        None,
+    )
+    return out_routed_normed, out_shared_sum
+
+
+def _moe_dual_reduce_rmsnorm_fake(
+    routed_partial: torch.Tensor,
+    shared_partial: torch.Tensor,
+    rms_weight: torch.Tensor,
+    eps: float,
+    handle: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    torch._check(routed_partial.dtype == torch.bfloat16)
+    torch._check(shared_partial.dtype == torch.bfloat16)
+    torch._check(rms_weight.dtype in (torch.bfloat16, torch.float32))
+    torch._check(routed_partial.dim() == 2)
+    torch._check(shared_partial.dim() == 2)
+    return torch.empty_like(routed_partial), torch.empty_like(shared_partial)
+
+
+direct_register_custom_op(
+    op_name="k31_p2p_allreduce",
+    op_func=_allreduce_impl,
+    mutates_args=[],
+    fake_impl=_allreduce_fake,
+)
+
+direct_register_custom_op(
+    op_name="k31_p2p_allreduce_residual",
+    op_func=_allreduce_residual_impl,
+    mutates_args=[],
+    fake_impl=_allreduce_residual_fake,
+)
+
+direct_register_custom_op(
+    op_name="k31_p2p_moe_dual_reduce_rmsnorm",
+    op_func=_moe_dual_reduce_rmsnorm_impl,
+    mutates_args=[],
+    fake_impl=_moe_dual_reduce_rmsnorm_fake,
+)
+
+
+def _p2p_allreduce(x_partial: torch.Tensor, handle: int) -> torch.Tensor:
+    """Dispatch through the registered custom op (CPU tests point this at
+    ``_allreduce_impl``)."""
+    return torch.ops.vllm.k31_p2p_allreduce(x_partial, handle)
+
+
+def _p2p_allreduce_residual(
+    x_partial: torch.Tensor,
+    residual: torch.Tensor,
+    handle: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    return torch.ops.vllm.k31_p2p_allreduce_residual(x_partial, residual, handle)
+
+
+def _p2p_moe_dual_reduce_rmsnorm(
+    routed_partial: torch.Tensor,
+    shared_partial: torch.Tensor,
+    rms_weight: torch.Tensor,
+    eps: float,
+    handle: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    return torch.ops.vllm.k31_p2p_moe_dual_reduce_rmsnorm(
+        routed_partial, shared_partial, rms_weight, float(eps), handle
+    )
+
+
+# -- Per-TP2-pair lifecycle manager -------------------------------------------
+
+
+class K31P2PCommunicator:
+    """Lifecycle and dispatch manager for one TP=2 ``_k31_p2p_C`` pair.
+
+    Each pipeline stage owns its own independent handle and POSIX SHM name so
+    multiple TP=2 pairs on the same host never collide and never conflict with
+    vLLM NCCL communicators.
+    """
+
+    def __init__(
+        self,
+        tp_group: Any,
+        pp_rank: int = 0,
+        max_bytes: int = DEFAULT_MAX_BYTES,
+        max_rows: int | None = None,
+        force_shm: bool | None = None,
+        timeout_ms: int | None = None,
+        device_ordinal: int | None = None,
+        start_watchdog: bool = True,
+        require_cuda_tensors: bool = True,
+    ) -> None:
+        self.tp_group = tp_group
+        self.tp_size = int(getattr(tp_group, "world_size", 1))
+        self.rank = int(getattr(tp_group, "rank_in_group", 0))
+        self.pp_rank = int(pp_rank)
+        self.tp_group_id = tp_group_identifier(tp_group)
+        self.shm_name = make_shm_name(self.pp_rank, self.tp_group_id)
+        self.max_bytes = int(max_bytes)
+        self.max_rows = configured_max_rows() if max_rows is None else int(max_rows)
+        self.force_shm = (
+            configured_force_shm() if force_shm is None else bool(force_shm)
+        )
+        self.timeout_ms = (
+            configured_timeout_ms() if timeout_ms is None else int(timeout_ms)
+        )
+        self.device_ordinal = (
+            _current_device_ordinal(tp_group)
+            if device_ordinal is None
+            else int(device_ordinal)
+        )
+        self._start_watchdog = bool(start_watchdog)
+        self._require_cuda_tensors = bool(require_cuda_tensors)
+
+        self.handle: int | None = None
+        self.transport: str = "disabled"
+        self.probe_latency_us: float = 0.0
+        self.peer_pid: int = -1
+        self.local_pid_ns: int | None = _pid_ns_inode()
+        self.peer_pid_ns: int | None = None
+        self.active: bool = False
+        self.disabled_reason: str | None = None
+        self._closed: bool = False
+        self._failed: bool = False
+        self._watchdog_aborted: bool = False
+        self._watchdog_reason: str = ""
+        self._stop_event = threading.Event()
+        self._watchdog_thread: threading.Thread | None = None
+        self._ops: Any = None
+
+    def initialize(self) -> bool:
+        """Run collective TP2 setup and byte-moving transport verification."""
+        if self.active:
+            return True
+        if self.tp_size != 2:
+            self.disabled_reason = f"tp_size={self.tp_size} (requires 2)"
+            logger.info_once(
+                "Kimi K3.1 P2P all-reduce inactive: %s; using standard TP all-reduce.",
+                self.disabled_reason,
+            )
+            return False
+
+        cap = _device_capability()
+        local_ready = True
+        local_reason = ""
+        if cap not in SUPPORTED_CAPABILITIES:
+            local_ready = False
+            local_reason = (
+                f"device capability {cap} not in {SUPPORTED_CAPABILITIES}"
+            )
+        elif not library_built():
+            from vllm.sm80.kernels.k31q.p2p_ops import BUILD_COMMAND
+
+            local_ready = False
+            local_reason = f"vllm/{LIBRARY} is not built (build: {BUILD_COMMAND})"
+        else:
+            # If the library file exists on disk, native.load validates
+            # api_version >= 3 and ABI and raises RuntimeError on mismatch.
+            self._ops = load_p2p_native()
+
+        try:
+            readiness = _all_gather_object(self.tp_group, (local_ready, local_reason))
+        except Exception as exc:
+            self.disabled_reason = f"handshake all_gather failed: {exc}"
+            logger.warning(
+                "Kimi K3.1 P2P all-reduce disabled (%s); falling back to standard "
+                "TP all-reduce.",
+                self.disabled_reason,
+            )
+            return False
+
+        if not all(ok for ok, _ in readiness):
+            reasons = [r for ok, r in readiness if not ok and r]
+            self.disabled_reason = "; ".join(reasons) or "peer unavailable"
+            logger.warning(
+                "Kimi K3.1 P2P all-reduce disabled (%s); falling back to standard "
+                "TP all-reduce.",
+                self.disabled_reason,
+            )
+            return False
+
+        ops = self._ops
+        assert ops is not None
+        modes = (True,) if self.force_shm else (False, True)
+        probe_timeout = (
+            min(self.timeout_ms, DEFAULT_PROBE_TIMEOUT_MS)
+            if self.timeout_ms > 0
+            else DEFAULT_PROBE_TIMEOUT_MS
+        )
+
+        for idx, try_shm in enumerate(modes):
+            handle: int | None = None
+            local_meta = b""
+            create_ok = True
+            create_err = ""
+            try:
+                handle, local_meta = ops.create_local(
+                    self.rank, self.device_ordinal, self.max_bytes, self.shm_name
+                )
+            except Exception as exc:
+                create_ok = False
+                create_err = str(exc)
+
+            local_pid_ns = self.local_pid_ns
+            created = _all_gather_object(
+                self.tp_group,
+                (create_ok, local_meta, os.getpid(), local_pid_ns, create_err),
+            )
+            if not all(item[0] for item in created):
+                if handle is not None:
+                    self._safe_destroy(ops, handle)
+                errs = [item[4] for item in created if not item[0] and item[4]]
+                detail = "; ".join(errs) or "unknown"
+                self.disabled_reason = f"create_local failed: {detail}"
+                logger.warning(
+                    "Kimi K3.1 P2P all-reduce disabled (%s); falling back to standard "
+                    "TP all-reduce.",
+                    self.disabled_reason,
+                )
+                return False
+
+            assert handle is not None
+            peer_meta = created[1 - self.rank][1]
+            peer_pid = int(created[1 - self.rank][2])
+            peer_pid_ns = created[1 - self.rank][3]
+
+            connect_ok = True
+            connect_err = ""
+            try:
+                ops.connect_peer(handle, peer_meta, force_shm=try_shm)
+            except Exception as exc:
+                connect_ok = False
+                connect_err = str(exc)
+
+            connected = _all_gather_object(self.tp_group, (connect_ok, connect_err))
+            if not all(ok for ok, _ in connected):
+                self._safe_destroy_collective(ops, handle)
+                errs = [e for ok, e in connected if not ok and e]
+                detail = "; ".join(errs) or "peer error"
+                if not try_shm and idx + 1 < len(modes):
+                    logger.warning(
+                        "Kimi K3.1 P2P connect_peer failed (%s); retrying with "
+                        "mapped POSIX SHM fallback.",
+                        detail,
+                    )
+                    continue
+                self.disabled_reason = f"connect_peer failed: {detail}"
+                logger.warning(
+                    "Kimi K3.1 P2P all-reduce disabled (%s); falling back to standard "
+                    "TP all-reduce.",
+                    self.disabled_reason,
+                )
+                return False
+
+            probe_ok = False
+            probe_us = 0.0
+            transport = "unknown"
+            probe_err = ""
+            try:
+                probe_ok, probe_us, transport = ops.verify_peer_transport(
+                    handle, timeout_ms=probe_timeout
+                )
+            except Exception as exc:
+                probe_ok = False
+                probe_err = str(exc)
+
+            probed = _all_gather_object(
+                self.tp_group, (bool(probe_ok), str(transport), probe_err)
+            )
+            if all(ok for ok, _, _ in probed):
+                ops.set_timeout_ms(handle, self.timeout_ms)
+                self.handle = int(handle)
+                self.transport = transport
+                self.probe_latency_us = float(probe_us)
+                self.peer_pid = peer_pid
+                self.peer_pid_ns = peer_pid_ns
+                self.active = True
+                self.disabled_reason = None
+                self._maybe_start_watchdog()
+                logger.info(
+                    "Kimi K3.1 TP2 P2P all-reduce active: pp_rank=%d tp_rank=%d/2 "
+                    "device=%d transport=%s probe=%.1f us max_rows=%d "
+                    "timeout_ms=%d shm=%s",
+                    self.pp_rank,
+                    self.rank,
+                    self.device_ordinal,
+                    self.transport,
+                    self.probe_latency_us,
+                    self.max_rows,
+                    self.timeout_ms,
+                    self.shm_name,
+                )
+                return True
+
+            self._safe_destroy_collective(ops, handle)
+            details = [
+                f"rank {r}: ok={ok} transport={tr}" + (f" err={err}" if err else "")
+                for r, (ok, tr, err) in enumerate(probed)
+            ]
+            summary = ", ".join(details)
+            if not try_shm and idx + 1 < len(modes):
+                logger.warning(
+                    "Kimi K3.1 P2P verify_peer_transport failed (%s); retrying with "
+                    "mapped POSIX SHM fallback.",
+                    summary,
+                )
+                continue
+
+            self.disabled_reason = f"verify_peer_transport failed ({summary})"
+            logger.warning(
+                "Kimi K3.1 P2P all-reduce disabled (%s); falling back to standard "
+                "TP all-reduce.",
+                self.disabled_reason,
+            )
+            return False
+
+        return False
+
+    @staticmethod
+    def _safe_close_imports(ops: Any, handle: int) -> None:
+        try:
+            ops.set_abort(handle)
+        except Exception:
+            pass
+        close_fn = getattr(ops, "close_peer_imports", None)
+        if callable(close_fn):
+            try:
+                close_fn(handle)
+            except Exception:
+                pass
+
+    @staticmethod
+    def _safe_destroy(ops: Any, handle: int) -> None:
+        K31P2PCommunicator._safe_close_imports(ops, handle)
+        try:
+            ops.destroy(handle)
+        except Exception:
+            pass
+
+    def _safe_destroy_collective(self, ops: Any, handle: int) -> None:
+        """Two-phase Gloo teardown (M3): Phase 1 closes peer imports on both
+        ranks before Phase 2 frees exported device buffers on either rank."""
+        self._safe_close_imports(ops, handle)
+        try:
+            _all_gather_object(self.tp_group, "imports_closed")
+        except Exception:
+            pass
+        try:
+            ops.destroy(handle)
+        except Exception:
+            pass
+
+    def _maybe_start_watchdog(self) -> None:
+        if not self._start_watchdog:
+            return
+        if self.peer_pid <= 0 or self.peer_pid == os.getpid():
+            return
+        # M2: only poll peer PID when both ranks share the exact same PID namespace.
+        if (
+            self.local_pid_ns is None
+            or self.peer_pid_ns is None
+            or self.local_pid_ns != self.peer_pid_ns
+        ):
+            logger.info_once(
+                "Kimi K3.1 P2P peer PID watchdog skipped across distinct PID "
+                "namespaces (local=%s peer=%s); in-kernel timeout and sticky "
+                "error checks remain active.",
+                self.local_pid_ns,
+                self.peer_pid_ns,
+            )
+            return
+        if self._watchdog_thread is not None:
+            return
+
+        peer_pid = self.peer_pid
+        handle = self.handle
+        ops = self._ops
+        stop_event = self._stop_event
+
+        def _watch() -> None:
+            while not stop_event.wait(WATCHDOG_POLL_S):
+                try:
+                    os.kill(peer_pid, 0)
+                except ProcessLookupError:
+                    self._watchdog_aborted = True
+                    self._watchdog_reason = f"peer pid {peer_pid} disappeared"
+                    self.active = False
+                    logger.critical(
+                        "Kimi K3.1 P2P FATAL: peer pid %d disappeared; tripping GPU "
+                        "abort flag on handle %s (next host step check will raise).",
+                        peer_pid,
+                        handle,
+                    )
+                    if handle is not None and ops is not None:
+                        try:
+                            ops.set_abort(handle)
+                        except Exception:
+                            pass
+                    return
+                except PermissionError:
+                    return
+
+        t = threading.Thread(
+            target=_watch,
+            name=f"k31-p2p-watchdog-pp{self.pp_rank}-r{self.rank}",
+            daemon=True,
+        )
+        t.start()
+        self._watchdog_thread = t
+
+    def can_reduce(self, x: torch.Tensor) -> bool:
+        """Whether ``x`` can take the one-shot P2P all-reduce path."""
+        if not self.active or self.handle is None:
+            return False
+        if x.dtype != torch.bfloat16 or x.dim() < 2:
+            return False
+        if self._require_cuda_tensors:
+            if not x.is_cuda or x.device.index != self.device_ordinal:
+                return False
+        hidden = x.shape[-1]
+        if hidden <= 0 or (hidden % 8) != 0:
+            return False
+        rows = x.numel() // hidden
+        return 0 < rows <= self.max_rows
+
+    def can_dual_reduce_rmsnorm(
+        self,
+        routed_partial: torch.Tensor,
+        shared_partial: torch.Tensor,
+        rms_weight: torch.Tensor,
+    ) -> bool:
+        """Whether routed + shared MoE partials + RMSNorm can fuse into one exchange."""
+        if not self.active or self.handle is None:
+            return False
+        if (
+            routed_partial.dtype != torch.bfloat16
+            or shared_partial.dtype != torch.bfloat16
+            or rms_weight.dtype not in (torch.bfloat16, torch.float32)
+        ):
+            return False
+        if (
+            routed_partial.dim() != 2
+            or shared_partial.dim() != 2
+            or rms_weight.dim() != 1
+        ):
+            return False
+        if self._require_cuda_tensors:
+            if (
+                not routed_partial.is_cuda
+                or not shared_partial.is_cuda
+                or not rms_weight.is_cuda
+                or routed_partial.device.index != self.device_ordinal
+                or shared_partial.device.index != self.device_ordinal
+                or rms_weight.device.index != self.device_ordinal
+            ):
+                return False
+        rows = routed_partial.shape[0]
+        h_r = routed_partial.shape[1]
+        h_s = shared_partial.shape[1]
+        if shared_partial.shape[0] != rows or rms_weight.shape[0] != h_r:
+            return False
+        if h_r <= 0 or h_s <= 0 or (h_r % 8) != 0 or (h_s % 8) != 0:
+            return False
+        return 0 < rows <= self.max_rows
+
+    def allreduce(self, x_partial: torch.Tensor) -> torch.Tensor:
+        """One-shot TP2 P2P all-reduce on BF16 ``[..., D]`` (``D % 8 == 0``)."""
+        self.raise_if_error("allreduce")
+        assert self.active and self.handle is not None
+        orig_shape = x_partial.shape
+        flat = x_partial.reshape(-1, orig_shape[-1]).contiguous()
+        out = _p2p_allreduce(flat, self.handle)
+        return out.reshape(orig_shape)
+
+    def allreduce_residual(
+        self,
+        x_partial: torch.Tensor,
+        residual: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """Fused one-shot TP2 P2P all-reduce + residual add.
+
+        Returns ``(out_sum, out_res)`` where ``out_sum = r0 + r1`` and
+        ``out_res = (r0 + r1) + residual`` in BF16 with FP32 accumulation.
+        """
+        self.raise_if_error("allreduce_residual")
+        assert self.active and self.handle is not None
+        orig_shape = x_partial.shape
+        flat_x = x_partial.reshape(-1, orig_shape[-1]).contiguous()
+        flat_r = residual.reshape(-1, orig_shape[-1]).contiguous()
+        out_sum, out_res = _p2p_allreduce_residual(flat_x, flat_r, self.handle)
+        return out_sum.reshape(orig_shape), out_res.reshape(orig_shape)
+
+    def moe_dual_reduce_rmsnorm(
+        self,
+        routed_partial: torch.Tensor,
+        shared_partial: torch.Tensor,
+        rms_weight: torch.Tensor,
+        eps: float,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """Single TP2 P2P exchange for routed + shared partials + FP32 RMSNorm."""
+        self.raise_if_error("moe_dual_reduce_rmsnorm")
+        assert self.active and self.handle is not None
+        return _p2p_moe_dual_reduce_rmsnorm(
+            routed_partial.contiguous(),
+            shared_partial.contiguous(),
+            rms_weight.contiguous(),
+            float(eps),
+            self.handle,
+        )
+
+    def set_abort(self) -> None:
+        if self.handle is not None and self._ops is not None:
+            self._ops.set_abort(self.handle)
+
+    def check_error(self) -> int:
+        if self.handle is None or self._ops is None:
+            return 2 if self._watchdog_aborted else 0
+        err = int(self._ops.check_error(self.handle))
+        if err == 0 and self._watchdog_aborted:
+            return 2
+        return err
+
+    def raise_if_error(self, context: str = "") -> None:
+        """Zero-sync host check of sticky device error and watchdog abort (C1)."""
+        err = self.check_error()
+        if err != 0 or self._watchdog_aborted:
+            self._failed = True
+            self.active = False
+            where = f" during {context}" if context else ""
+            wd = (
+                f" ({self._watchdog_reason})"
+                if self._watchdog_aborted and self._watchdog_reason
+                else ""
+            )
+            raise K31P2PError(
+                f"Kimi K3.1 P2P fatal error{where}: code={err} ({_error_name(err)})"
+                f"{wd} on pp_rank={self.pp_rank} tp_rank={self.rank}; "
+                "teardown, re-handshake, and CUDA graph re-capture are required."
+            )
+
+    def transport_info(self) -> dict[str, Any]:
+        if self.handle is None or self._ops is None:
+            return {
+                "connected": False,
+                "transport": self.transport,
+                "rank": self.rank,
+                "pp_rank": self.pp_rank,
+                "shm_name": self.shm_name,
+                "disabled_reason": self.disabled_reason,
+            }
+        info = dict(self._ops.transport_info(self.handle))
+        info["pp_rank"] = self.pp_rank
+        info["shm_name"] = self.shm_name
+        return info
+
+    def close(self, *, collective: bool = False) -> None:
+        """Close this communicator. When ``collective=True`` (and peer is not
+        watchdog-aborted), runs two-phase Gloo teardown (Phase 1 close peer
+        imports, Gloo barrier, Phase 2 free exported local buffers) so CUDA IPC
+        exported memory is never freed while the importer still holds it (M3).
+        Any CUDA graphs captured against this handle must be dropped before reuse."""
+        if self._closed:
+            return
+        self._closed = True
+        self._stop_event.set()
+        thread = self._watchdog_thread
+        self._watchdog_thread = None
+        if thread is not None and thread.is_alive():
+            thread.join(timeout=0.5)
+        handle = self.handle
+        ops = self._ops
+        self.handle = None
+        self.active = False
+        if handle is not None and ops is not None:
+            if collective and not self._watchdog_aborted:
+                self._safe_destroy_collective(ops, handle)
+            else:
+                self._safe_destroy(ops, handle)
+
+
+# -- Process-level singleton registry (one communicator per PP stage / TP pair)
+
+
+_REGISTRY_LOCK = threading.Lock()
+_COMMUNICATORS: dict[tuple[int, str], K31P2PCommunicator] = {}
+_ATEXIT_REGISTERED = False
+
+
+def _ensure_atexit() -> None:
+    global _ATEXIT_REGISTERED
+    if not _ATEXIT_REGISTERED:
+        atexit.register(close_all_communicators)
+        _ATEXIT_REGISTERED = True
+
+
+def _current_group_key() -> tuple[int, str, Any, int] | None:
+    from vllm.distributed import get_pp_group, get_tp_group
+
+    try:
+        tp_group = get_tp_group()
+    except Exception:
+        return None
+    if int(getattr(tp_group, "world_size", 1)) != 2:
+        return None
+    try:
+        pp_group = get_pp_group()
+        pp_rank = int(getattr(pp_group, "rank_in_group", 0))
+    except Exception:
+        pp_rank = 0
+    tp_id = tp_group_identifier(tp_group)
+    return (pp_rank, tp_id, tp_group, pp_rank)
+
+
+def get_or_init_communicator(
+    tp_group: Any | None = None,
+    pp_rank: int | None = None,
+    *,
+    require_cuda_tensors: bool = True,
+    start_watchdog: bool = True,
+) -> K31P2PCommunicator | None:
+    """Return the initialized TP2 P2P communicator for this stage, or None."""
+    if not is_enabled():
+        return None
+    if tp_group is None:
+        key_info = _current_group_key()
+        if key_info is None:
+            return None
+        key_pp, tp_id, tp_group, resolved_pp = key_info
+    else:
+        if int(getattr(tp_group, "world_size", 1)) != 2:
+            return None
+        resolved_pp = 0 if pp_rank is None else int(pp_rank)
+        tp_id = tp_group_identifier(tp_group)
+        key_pp = resolved_pp
+
+    key = (key_pp, tp_id)
+    comm = _COMMUNICATORS.get(key)
+    if comm is not None:
+        return comm if comm.active else None
+
+    if _is_stream_capturing():
+        return None
+
+    with _REGISTRY_LOCK:
+        comm = _COMMUNICATORS.get(key)
+        if comm is None:
+            _ensure_atexit()
+            comm = K31P2PCommunicator(
+                tp_group=tp_group,
+                pp_rank=resolved_pp,
+                require_cuda_tensors=require_cuda_tensors,
+                start_watchdog=start_watchdog,
+            )
+            comm.initialize()
+            _COMMUNICATORS[key] = comm
+    return comm if comm.active else None
+
+
+def get_active_communicator() -> K31P2PCommunicator | None:
+    """Fast-path lookup for forward(). Initializes lazily on first eager step."""
+    if not is_enabled():
+        return None
+    return get_or_init_communicator()
+
+
+def maybe_init_communicator() -> K31P2PCommunicator | None:
+    """Eagerly run the TP2 handshake after model loading (before graph capture)."""
+    if not is_enabled():
+        return None
+    return get_or_init_communicator()
+
+
+def check_all_communicators(context: str = "") -> None:
+    """Zero-sync post-step check of every active/failed P2P communicator (C1)."""
+    if not _COMMUNICATORS:
+        return
+    with _REGISTRY_LOCK:
+        items = list(_COMMUNICATORS.values())
+    for comm in items:
+        comm.raise_if_error(context)
+
+
+def close_all_communicators() -> None:
+    with _REGISTRY_LOCK:
+        items = list(_COMMUNICATORS.values())
+        _COMMUNICATORS.clear()
+    for comm in items:
+        comm.close()
+
+
+def reset_communicators() -> None:
+    """Close and forget all cached communicators (primarily for tests)."""
+    close_all_communicators()
+
+
+# -- RowParallelLinear TP2 P2P attachment -------------------------------------
+
+
+_P2P_ROW_PARALLEL_CLS: type | None = None
+
+
+def _get_p2p_row_parallel_cls() -> type:
+    global _P2P_ROW_PARALLEL_CLS
+    if _P2P_ROW_PARALLEL_CLS is not None:
+        return _P2P_ROW_PARALLEL_CLS
+
+    import vllm.distributed as vllm_dist
+    from vllm.distributed import split_tensor_along_last_dim
+    from vllm.model_executor.layers.linear import RowParallelLinear, apply_flattened
+
+    class _K31P2PRowParallelLinear(RowParallelLinear):
+        """RowParallelLinear whose TP=2 reduce uses _k31_p2p_C when active.
+
+        Keeps the exact parameter layout, state_dict keys, quantization method,
+        and forward-hook contract of RowParallelLinear (callers and hooks see
+        the exact reduced output). Falls back to
+        ``tensor_model_parallel_all_reduce`` when the batch exceeds
+        ``VLLM_K31_P2P_MAX_ROWS`` or P2P is inactive.
+        """
+
+        def forward(self, input_):
+            comm = get_active_communicator()
+            if comm is None or not self.reduce_results or self.tp_size != 2:
+                return super().forward(input_)
+
+            if self.input_is_parallel:
+                input_parallel = input_
+            else:
+                split_input = split_tensor_along_last_dim(
+                    input_, num_partitions=self.tp_size
+                )
+                input_parallel = split_input[self.tp_rank].contiguous()
+
+            bias_ = None if (self.tp_rank > 0 or self.skip_bias_add) else self.bias
+            apply = partial(self.quant_method.apply, self, bias=bias_)
+            output_parallel = apply_flattened(apply, input_parallel)
+
+            if comm.can_reduce(output_parallel):
+                output = comm.allreduce(output_parallel)
+            else:
+                output = vllm_dist.tensor_model_parallel_all_reduce(output_parallel)
+
+            if not self.return_bias:
+                return output
+            output_bias = self.bias if self.skip_bias_add else None
+            return output, output_bias
+
+    _P2P_ROW_PARALLEL_CLS = _K31P2PRowParallelLinear
+    return _P2P_ROW_PARALLEL_CLS
+
+
+def attach_row_parallel(linear: Any) -> bool:
+    """Enable TP2 P2P all-reduce on a K3.1 ``RowParallelLinear`` module."""
+    if not is_enabled():
+        return False
+    from vllm.model_executor.layers.linear import RowParallelLinear
+
+    if not isinstance(linear, RowParallelLinear):
+        return False
+    if linear.tp_size != 2 or not linear.reduce_results:
+        return False
+    p2p_cls = _get_p2p_row_parallel_cls()
+    if type(linear) is RowParallelLinear:
+        linear.__class__ = p2p_cls
+        return True
+    return isinstance(linear, p2p_cls)
