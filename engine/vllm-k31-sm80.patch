+def _require_sm80_or_sm120_glue() -> None:
+    if not torch.cuda.is_available():
+        pytest.skip("CUDA not available")
+    cap = torch.cuda.get_device_capability()
+    if cap not in ((8, 0), (12, 0)) or not glue.library_built():
+        pytest.skip("Requires sm_80/sm_120 GPU and built _k31_glue_C")
