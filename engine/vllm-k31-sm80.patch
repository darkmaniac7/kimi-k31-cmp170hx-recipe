+def test_coherent_tail_extension_overrides_low_confidence_tail_only():
+    # DSpark and Suffix agree on tokens [0, 1, 2], then DSpark confidence drops
+    # while Suffix continues coherently through slot 7.
+    d_toks = torch.tensor([[10, 20, 30, 40, 50, 60, 70, 80]], dtype=torch.int64)
+    s_toks = torch.tensor([[10, 20, 30, 44, 55, 66, 77, 88]], dtype=torch.int64)
+    d_conf = torch.tensor([[0.99, 0.99, 0.99, 0.20, 0.15, 0.10, 0.05, 0.05]])
+    s_conf = torch.tensor([[0.86, 0.85, 0.84, 0.83, 0.82, 0.81, 0.0, 0.0]])
+    # E_dspark ~ 3.16, E_suffix ~ 3.24 -> make E_dspark > E_suffix on prefix by
+    # setting suffix_num_valid=5 and slightly lower early s_conf so take_whole is False
+    # while tail extension still activates at slot 3!
+    s_conf = torch.tensor([[0.75, 0.74, 0.73, 0.72, 0.71, 0.0, 0.0, 0.0]])
+    num_valid = torch.tensor([5], dtype=torch.int32)
+    match_len = torch.tensor([6], dtype=torch.int64)
+
+    drafts, conf, mask, used = blend_dspark_and_suffix(
+        d_toks, d_conf, s_toks, num_valid, match_len, s_conf, min_match_len=4
+    )
+    assert bool(used[0])
+    # Slots 0..2 kept DSpark (both agree), slots 3..4 switched to Suffix, slots 5..7 kept DSpark.
+    assert mask[0].tolist() == [False, False, False, True, True, False, False, False]
+    assert drafts[0].tolist() == [10, 20, 30, 44, 55, 60, 70, 80]
+    assert conf[0, 3].item() == pytest.approx(0.72)
+    assert conf[0, 4].item() == pytest.approx(0.71)
+    assert conf[0, 0].item() == pytest.approx(0.99)
+
