+        "max_depth": max_depth,
+        "features": ["bias"],
+        "weights": [[20.0] if i < k else [-20.0] for i in range(max_depth)],
+        "costs": {"1": {str(j): round(1.0 + 0.01 * j, 2) for j in range(max_depth + 1)}},
