+        mark, req_id = "N", None
+        chunk_k = _cmp_ps.chunk_k_of(scheduler_output)
+        if marks:
+            assert (
+                len(marks) == 1 and len(scheduler_output.num_scheduled_tokens) == 1
+            ), marks
+            ((req_id, mark),) = marks.items()
+        self._ps_mark = mark
+        self._ps_chunk_k = chunk_k if mark != "N" else 0
+        if not self.is_last_pp_rank:
+            return False
+        req_idx = self.req_states.req_id_to_index[req_id] if req_id else -1
+        if self._ps_expect_b and mark != "B":
+            self._ps_restore_a_drafts()
+        if mark == "A":
+            self._ps_a_req = req_idx
+            self._ps_a_drafts = self.req_states.draft_tokens[
+                req_idx, :chunk_k
+            ].clone()
+            if self._ps_p2_req != req_idx:
+                self._ps_p2 = None
+                self._ps_p2_valid = False
+            return False
+        if mark == "B":
+            assert self._ps_expect_b and req_idx == self._ps_a_req, (
+                self._ps_expect_b,
+                req_idx,
+                self._ps_a_req,
+            )
+            if not self._ps_b_valid:
+                self._ps_skip = [req_id]
+                return True
+            return False
+        if self._ps_p2 is not None:
+            for rid in scheduler_output.num_scheduled_tokens:
+                if self.req_states.req_id_to_index.get(rid) == self._ps_p2_req:
+                    self._ps_p2 = None
+                    self._ps_p2_valid = False
+                    self._ps_p2_req = -1
+                    break
+        return False
+
+    def _ps_restore_a_drafts(self) -> None:
+        if self._ps_a_req >= 0 and self._ps_a_drafts is not None:
+            k = self._ps_a_drafts.shape[0]
+            self.req_states.draft_tokens[self._ps_a_req, :k] = self._ps_a_drafts
+            dl = getattr(self.speculator, "draft_logits", None)
+            if dl is not None:
+                _cmp_ps.set_onehot_restored_draft_logits(
+                    dl, self._ps_a_req, self._ps_a_drafts
+                )
+        self._ps_expect_b = False
+        self._ps_b_valid = False
+        self._ps_pending = None
+        self._ps_p2 = None
+        self._ps_p2_valid = False
+        self._ps_p2_req = -1
+
+    def _ps_forget(self, req_idx: int) -> None:
+        model_state = getattr(self, "model_state", None)
+        forget_fn = (
+            getattr(model_state, "forget_pipespec_request", None)
+            if model_state is not None
+            else None
+        )
+        if forget_fn is not None:
+            forget_fn(req_idx)
+        if hasattr(self, "_ps_full_drafts"):
+            self._ps_full_drafts.pop(req_idx, None)
+        if req_idx in (self._ps_a_req, self._ps_p2_req):
+            self._ps_expect_b = False
+            self._ps_b_valid = False
+            self._ps_a_req = -1
+            self._ps_a_drafts = None
+            self._ps_b_drafts = None
+            self._ps_pending = None
+            self._ps_p2 = None
+            self._ps_p2_valid = False
+            self._ps_p2_req = -1
+
+    def _ps_set_chunk_b_inputs(self, input_batch: InputBatch) -> None:
+        """First rank: feed Chunk B with the previous epoch's P2 tokens if valid.
+
+        Guards against invalid P2 (``p2_valid=False``) or negative sentinel
+        tokens (``< 0``) so ``-1`` never reaches ``input_ids`` / embeddings.
+        """
+        assert self.pp_handler is not None and input_batch.num_reqs == 1
+        n = self._ps_chunk_k + 1
+        start = int(input_batch.query_start_loc_np[0])
+        dst = input_batch.input_ids[start : start + n]
+        req_idx_0 = int(input_batch.idx_mapping_np[0])
+        legacy_entry = self.pp_handler.take_p2_for_chunk_b(req_idx_0)
+        full_fn = getattr(self.pp_handler, "take_full_drafts_for_chunk_b", None)
+        full_entry = full_fn(req_idx_0, self._ps_chunk_k) if full_fn is not None else None
+        entry = (
+            legacy_entry
+            if (legacy_entry is not None and legacy_entry[0].shape[0] == n)
+            else full_entry
+        )
+        if entry is None:
+            dst.clamp_(min=0)
+            return
+        p2, p2_valid = entry
+        p2_slice = p2[:n]
+        if isinstance(p2_valid, bool):
+            if (
+                p2_valid
+                and p2_slice.shape[0] == n
+                and bool((p2_slice >= 0).all().item())
+            ):
+                dst.copy_(p2_slice)
+            else:
+                dst.clamp_(min=0)
+            return
+        # Device-only predicated copy (zero host sync on CUDA).
+        valid_t = p2_valid.to(torch.bool) & (p2_slice >= 0).all()
+        safe_p2 = p2_slice.clamp(min=0).to(dst.dtype)
+        safe_dst = dst.clamp(min=0)
+        dst.copy_(torch.where(valid_t, safe_p2, safe_dst))
+
+    def _ps_decide_chunk_a(
+        self,
+        input_batch: InputBatch,
+        sampler_output: SamplerOutput,
+        num_rejected: torch.Tensor,
+    ) -> bool:
+        """Last rank after verifying Chunk A: Chunk B is valid iff A accepted
+        all chunk_k drafts, P2 is valid (non-negative), and A's bonus equals P2[0]."""
+        k = self._ps_chunk_k
+        req_idx = int(input_batch.idx_mapping_np[0])
+        self._ps_expect_b = True
+        self._ps_b_valid = False
+        self._ps_b_drafts = None
+        self._ps_pending = None
+        p2 = self._ps_p2 if self._ps_p2_req == req_idx else None
+        p2_valid = self._ps_p2_valid if self._ps_p2_req == req_idx else False
+        self._ps_p2 = None
+        self._ps_p2_valid = False
+        self._ps_p2_req = -1
+        full_map = getattr(self, "_ps_full_drafts", None)
+        full_d = full_map.pop(req_idx, None) if full_map is not None else None
+        if full_d is not None:
+            if full_d.shape[0] >= 2 * k + 1:
+                p2 = full_d[k : 2 * k + 1].unsqueeze(0)
+                p2_valid = (
+                    bool((p2 >= 0).all().item()) if not p2.is_cuda else True
+                )
+            else:
+                p2 = None
+                p2_valid = False
+        if (
+            not p2_valid
+            or p2 is None
+            or input_batch.num_reqs != 1
+            or p2.shape[1] < k + 1
+        ):
+            return False
+        p2_nonneg = (p2[:1, : k + 1] >= 0).all(dim=1)
+        ok = p2_nonneg & (num_rejected[:1] == 0) & (
+            sampler_output.sampled_token_ids[:1, k] == p2[:1, 0]
+        )
+        if ok.is_cuda:
+            if self._ps_flag_host is None:
+                self._ps_flag_host = torch.zeros(1, dtype=torch.int32, pin_memory=True)
+                self._ps_flag_event = torch.cuda.Event()
+            assert self._ps_flag_event is not None
+            self._ps_flag_host.copy_(ok.to(torch.int32), non_blocking=True)
+            self._ps_flag_event.record(self.main_stream)
+            self._ps_flag_event.synchronize()
+            valid = bool(self._ps_flag_host[0].item())
+        else:
+            valid = bool(ok[0].item())
+        self._ps_b_valid = valid
+        if valid:
+            self._ps_b_drafts = p2[0, 1 : k + 1]
+        return valid
+
+    def _ps_arm_chunk_b(self, input_batch: InputBatch) -> None:
+        """Last rank: arm Chunk B to verify P2[1 : k + 1]."""
+        assert self._ps_b_drafts is not None
+        k = self._ps_chunk_k
+        req_idx = int(input_batch.idx_mapping_np[0])
+        self.req_states.draft_tokens[req_idx, :k] = self._ps_b_drafts
+        if k < self.req_states.draft_tokens.shape[1]:
+            self.req_states.draft_tokens[req_idx, k:] = -1
+        dl = getattr(self.speculator, "draft_logits", None)
+        if dl is not None:
+            _cmp_ps.shift_draft_logits_for_chunk_b(dl, req_idx, k)
+
+    def _ps_finish_epoch(
+        self,
+        input_batch: InputBatch,
+        draft_tokens: torch.Tensor | None,
+        send_now: bool,
+        num_drafted_width: int | None = None,
+    ) -> None:
+        """Last rank: split the single-pass DSpark block into P1 (next A) and
+        P2 (next B) with an explicit ``p2_valid`` bit in col 0 of the P2 wire
+        row. Sent immediately after valid B; parked for dropped B after failed A."""
+        assert self.pp_handler is not None and draft_tokens is not None
+        k = self._ps_chunk_k
+        num_reqs = input_batch.num_reqs
+        full_k = self.num_speculative_steps
+        p1 = torch.full(
+            (num_reqs, full_k), -1, dtype=torch.int64, device=self.device
+        )
+        # Copy all drafted tokens up to full_k (not just chunk_k) so non-last
+        # PP stages hold valid drafts if the next step exits PipeSpec to a
+        # Normal step of width chunk_k+1..full_k (tail, c>1, or gate exit).
+        avail_p1 = (
+            min(full_k, draft_tokens.shape[1], int(num_drafted_width))
+            if num_drafted_width is not None
+            else min(full_k, draft_tokens.shape[1])
+        )
+        if avail_p1 > 0:
+            p1[:, :avail_p1] = draft_tokens[:num_reqs, :avail_p1]
+            full_map = getattr(self, "_ps_full_drafts", None)
+            if full_map is not None and send_now:
+                for row_i in range(num_reqs):
+                    r_idx = int(input_batch.idx_mapping_np[row_i])
+                    full_map[r_idx] = draft_tokens[row_i, :avail_p1].clone()
+        p2 = torch.full(
+            (num_reqs, k + 1), -1, dtype=torch.int64, device=self.device
+        )
+        if draft_tokens.shape[1] > k:
+            avail_p2 = min(k + 1, draft_tokens.shape[1] - k)
+            p2[:, :avail_p2] = draft_tokens[:num_reqs, k : k + avail_p2]
+        p2_valid_host = (
+            draft_tokens.shape[1] >= 2 * k + 1
+            and (num_drafted_width is None or int(num_drafted_width) >= 2 * k + 1)
+        )
+        p2_nonneg = (p2 >= 0).all(dim=1)
+        if not p2_valid_host:
+            p2_nonneg = torch.zeros_like(p2_nonneg)
+        p2_wire = torch.zeros(
+            (num_reqs, k + 2), dtype=torch.int64, device=self.device
+        )
+        p2_wire[:, 0] = p2_nonneg.to(torch.int64)
+        p2_wire[:, 1:] = torch.where(
+            p2_nonneg.unsqueeze(1), p2.clamp(min=0), torch.zeros_like(p2)
+        )
+        ev1 = self.main_stream.record_event()
+        ev2 = self.main_stream.record_event()
+        if send_now:
+            self.pp_handler.broadcast_rows(p1, ev1)
+            self.pp_handler.broadcast_rows(p2_wire, ev2)
+            self._ps_expect_b = False
+        else:
+            self._ps_pending = (p1, ev1, p2_wire, ev2, k)
+        if num_reqs == 1 and p2_valid_host:
+            self._ps_p2 = p2
+            self._ps_p2_valid = (
+                bool(p2_nonneg[0].item()) if not p2_nonneg.is_cuda else True
+            )
+            self._ps_p2_req = int(input_batch.idx_mapping_np[0])
+        else:
+            self._ps_p2 = None
+            self._ps_p2_valid = False
+            self._ps_p2_req = -1
+
+    def _ps_dropped_chunk_output(self) -> ModelRunnerOutput:
+        """Last rank, dropped Chunk B: broadcast rollback counts + parked P1/P2
+        and report empty sampled tokens for the dropped step."""
+        assert self.pp_handler is not None and self._ps_skip is not None
+        req_ids = self._ps_skip
+        self._ps_skip = None
+        pending = self._ps_pending
+        self._ps_pending = None
+        self._ps_expect_b = False
+        assert pending is not None, "PipeSpec: dropped Chunk B without epoch drafts"
+        p1, ev1, p2, ev2, chunk_k = pending
+        full_map = getattr(self, "_ps_full_drafts", None)
+        if full_map is not None and len(req_ids) == 1 and p1.shape[0] == 1:
+            r_idx = self.req_states.req_id_to_index.get(req_ids[0], -1)
+            if r_idx >= 0:
+                full_map[r_idx] = p1[0].clone()
+        self.pp_handler.broadcast_dropped_chunk(len(req_ids), chunk_k)
+        self.pp_handler.broadcast_rows(p1, ev1)
+        self.pp_handler.broadcast_rows(p2, ev2)
+        return ModelRunnerOutput(
+            req_ids=req_ids,
+            sampled_token_ids=[[] for _ in req_ids],
+        )
+
     def take_draft_token_ids(self) -> DraftTokenIds | None:
         return self.draft_tokens_handler.get_draft_tokens()
 
