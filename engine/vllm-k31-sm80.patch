+def _make_synthetic_93_layer_pair(
+    seed: int = 2026,
+    n_tokens: int = 16,
+    hidden: int = 64,
+    vocab: int = 512,
+    n_logit_pos: int = 12,
+    late_noise_scale: float = 0.42,
+    logit_noise_scale: float = 0.45,
+) -> tuple[cmp_mod.PromptDump, cmp_mod.PromptDump]:
+    """Build a realistic 93-layer KLX (1.95 bpw) vs k31q (1.625 bpw) synthetic pair."""
+    g = torch.Generator().manual_seed(seed)
+    ref_tensors: dict[str, torch.Tensor] = {}
+    cand_tensors: dict[str, torch.Tensor] = {}
+
+    for li in range(93):
+        base = torch.randn((n_tokens, hidden), generator=g, dtype=torch.float32)
+        if li == 0:
+            # Both dense (K6 vs Q5_K/Q6_K): cos ~ 0.999, norm ratio ~ 1.00
+            noise_std = 0.03
+            scale = 1.002
+        elif li <= 15:
+            # Early 2-bit quant drift: cos gradually moves 0.985 -> 0.968
+            frac = (li - 1) / 14.0
+            noise_std = 0.14 + 0.10 * frac
+            scale = 0.99 - 0.02 * frac
+        else:
+            # Mid/late compounded drift: cos gently decays 0.965 -> ~0.91
+            frac = (li - 16) / 76.0
+            noise_std = 0.24 + (late_noise_scale - 0.24) * frac
+            scale = 0.97 + 0.04 * math.sin(li * 0.1)
+
+        noise = torch.randn((n_tokens, hidden), generator=g, dtype=torch.float32) * noise_std
+        ref_tensors[f"L{li}.out"] = base.to(torch.bfloat16)
+        cand_tensors[f"L{li}.out"] = (base * scale + noise).to(torch.bfloat16)
+
+    # Peaked realistic next-token logits
+    rng = np.random.default_rng(seed + 1)
+    ref_scores = rng.normal(0.0, 1.5, size=(n_logit_pos, vocab)).astype(np.float32)
+    for pos in range(n_logit_pos):
+        # Realistic Zipf-like top-10 peaks
+        top_toks = rng.choice(vocab, size=10, replace=False)
+        for rank, tid in enumerate(top_toks):
+            ref_scores[pos, tid] = 11.0 - 1.1 * rank
+
+    cand_scores = ref_scores + rng.normal(0.0, logit_noise_scale, size=ref_scores.shape).astype(np.float32)
+    r_ids, r_vals, r_lse = _make_topk_logits_from_scores(ref_scores, topk=128)
+    c_ids, c_vals, c_lse = _make_topk_logits_from_scores(cand_scores, topk=128)
+
+    prompt_toks = [163584] + list(range(100, 100 + n_tokens - 1))
+    ref_gen = r_ids[:, 0].tolist()
+    cand_gen = c_ids[:, 0].tolist()
+
+    ref_dump = cmp_mod.PromptDump(
+        prompt_id="synth_93L",
+        source_format=cmp_mod.SCHEMA_VERSION,
+        engine="llama.cpp",
+        tensors=ref_tensors,
+        prompt_token_ids=prompt_toks,
+        generated_ids=ref_gen,
+        generated_text="step 1: 23 mod 3 = 2\nstep 2: answer is 23",
+        topk_ids=r_ids,
+        topk_logits=r_vals,
+        logsumexp=r_lse,
+    )
+    cand_dump = cmp_mod.PromptDump(
+        prompt_id="synth_93L",
+        source_format=cmp_mod.SCHEMA_VERSION,
+        engine="vllm-k31q",
+        tensors=cand_tensors,
+        prompt_token_ids=list(prompt_toks),
+        generated_ids=cand_gen,
+        generated_text="step 1: 23 mod 3 = 2\nstep 2: answer is 23",
+        topk_ids=c_ids,
+        topk_logits=c_vals,
+        logsumexp=c_lse,
+    )
+    return ref_dump, cand_dump
