+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Python interface and FakeTensor registrations for _k31_p2p_C (api_version=3, sm_80 + sm_120).
+
+One-shot PCIe P2P all-reduce (TP2) and framed posted-write PP send/recv/drain:
+  - 8-slot ring buffer with single per-handle monotonic op counters + grid
+    completion commit (sticky errors + quiet-NaN poison + op-kind flag tags).
+  - 64-byte PP slot framing header validated before copy, unified
+    alignment-independent 128B-line byte partition, monotonic credit watermark,
+    and p2p_pp_drain() for PipeSpec dropped-B cleanup.
+  - Random 64-bit process nonce for same-process detection, device-mapped
+    generation and timeout_ns words (dynamic inside captured CUDA graphs),
+    and two-phase close_peer_imports() + destroy() teardown.
+
+The compiled extension lives at ``vllm/_k31_p2p_C.abi3.so`` beside
+``vllm/_exl3_C.abi3.so``, imported and validated by
+``vllm.sm80.kernels.k31q.native.load`` (requiring ``abi_version == 1`` and
+``api_version >= 3``).
+"""
+
+from __future__ import annotations
+
+import time
+from typing import Any
+
+import torch
+
+from vllm.sm80.kernels.k31q import native
+
+_ABI_VERSION = 1
+_API_VERSION = 3
+_OPERATORS = (
+    "p2p_allreduce_residual",
+    "p2p_moe_dual_reduce_rmsnorm",
+    "p2p_pp_send",
+    "p2p_pp_recv",
+    "p2p_pp_drain",
+    "set_timeout_ms",
+    "set_abort",
+    "clear_abort",
+    "check_error",
+    "clear_error",
+    "close_peer_imports",
+    "destroy",
+)
+BUILD_COMMAND = (
+    "python csrc/k31_p2p/build_p2p_standalone.py --arch-list \"8.0;12.0\" "
+    "--ptx --out-dir build/k31_p2p && cp build/k31_p2p/_k31_p2p_C.abi3.so vllm/"
+)
+
+ERR_OK = 0
+ERR_TIMEOUT = 1
+ERR_ABORT = 2
+ERR_FRAMING_MISMATCH = 3
+ERR_GENERATION_MISMATCH = 4
+ERR_OP_MISMATCH = 5
+
+_LOADED = False
+_FAKES_REGISTERED = False
+_MODULE: Any = None
+
+
+def ensure_p2p_extension() -> Any:
+    global _LOADED, _FAKES_REGISTERED, _MODULE
+    if _LOADED and _MODULE is not None:
+        return _MODULE
+    _MODULE = native.load(
+        "_k31_p2p_C", _ABI_VERSION, _OPERATORS, BUILD_COMMAND, _API_VERSION
+    )
+    if not _FAKES_REGISTERED:
+        _register_fake_ops()
+        _FAKES_REGISTERED = True
+    _LOADED = True
+    return _MODULE
+
+
+def _register_fake_ops() -> None:
+    @torch.library.register_fake("_k31_p2p_C::p2p_allreduce_residual")
+    def _fake_allreduce_residual(
+        handle: int,
+        x_partial: torch.Tensor,
+        out_sum: torch.Tensor,
+        residual: torch.Tensor | None = None,
+        out_res: torch.Tensor | None = None,
+    ) -> None:
+        return None
+
+    @torch.library.register_fake("_k31_p2p_C::p2p_moe_dual_reduce_rmsnorm")
+    def _fake_moe_dual_reduce_rmsnorm(
+        handle: int,
+        routed_partial: torch.Tensor,
+        shared_partial: torch.Tensor,
+        rms_weight: torch.Tensor,
+        eps: float,
+        out_routed_normed: torch.Tensor,
+        out_shared_sum: torch.Tensor,
+        residual: torch.Tensor | None = None,
+        out_shared_res: torch.Tensor | None = None,
+    ) -> None:
+        return None
+
+    @torch.library.register_fake("_k31_p2p_C::p2p_pp_send")
+    def _fake_pp_send(handle: int, src: torch.Tensor, tag: int = 0) -> None:
+        return None
+
+    @torch.library.register_fake("_k31_p2p_C::p2p_pp_recv")
+    def _fake_pp_recv(handle: int, dst: torch.Tensor, tag: int = 0) -> None:
+        return None
+
+    @torch.library.register_fake("_k31_p2p_C::p2p_pp_drain")
+    def _fake_pp_drain(handle: int) -> None:
+        return None
+
+
+def build_info() -> dict[str, Any]:
+    """Return compiled metadata (abi_version, api_version, torch_version,
+    cuda_version, cxx11_abi)."""
+    mod = ensure_p2p_extension()
+    return dict(mod.build_info())
+
+
+def create_local(
+    rank: int,
+    device_ordinal: int = 0,
+    max_bytes: int = 4 * 1024 * 1024,
+    shm_name: str = "",
+) -> tuple[int, bytes]:
+    mod = ensure_p2p_extension()
+    h, meta = mod.create_local(
+        int(rank), int(device_ordinal), int(max_bytes), str(shm_name)
+    )
+    return int(h), bytes(meta)
+
+
+def connect_peer(
+    local_handle: int, peer_meta: bytes, force_shm: bool = False
+) -> int:
+    """Connect local handle to peer metadata bytes."""
+    mod = ensure_p2p_extension()
+    return int(mod.connect_peer(int(local_handle), bytes(peer_meta), bool(force_shm)))
+
+
+def _probe_bf16_pair(
+    rows: int, cols: int, dev: torch.device
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    n = rows * cols
+    idx = torch.arange(n, dtype=torch.int64, device="cpu")
+    p0 = (((idx * 17 + 3) % 31) - 15).to(torch.float32) * 0.125
+    p1 = (((idx * 23 + 11) % 29) - 14).to(torch.float32) * 0.125
+    t0 = p0.to(torch.bfloat16).view(rows, cols).to(dev).contiguous()
+    t1 = p1.to(torch.bfloat16).view(rows, cols).to(dev).contiguous()
+    expected = (t0.float() + t1.float()).to(torch.bfloat16)
+    return t0, t1, expected
+
+
+def verify_peer_transport(
+    handle: int,
+    timeout_ms: int = 2000,
+) -> tuple[bool, float, str]:
+    """Byte-moving P2P/SHM self-test across the connected TP2 pair (L2).
+
+    Both ranks must invoke this concurrently right after connect_peer.
+    Probes BOTH:
+      1. A full 32-CTA fast exchange ([8, 7168] BF16 = 114,688 bytes, exercising
+         all 32 flag lines and multiple pages); latency_us times this exchange.
+      2. A multi-chunk streaming exchange (> slot_bytes when slot_bytes <= 16 MiB,
+         exercising the 32-CTA stream kernel across multiple ring slots).
+
+    Returns (ok, latency_us, transport).
+    """
+    info = handle_info(handle)
+    transport = str(info["transport"])
+    if not info["connected"]:
+        return False, 0.0, transport
+    rank = int(info["rank"])
+    dev = torch.device(f"cuda:{int(info['device_ordinal'])}")
+    prev_timeout = int(info["timeout_ms"])
+    slot_bytes = int(info.get("slot_bytes", 4 * 1024 * 1024))
+    stream = torch.cuda.current_stream(dev)
+
+    fast_rows, fast_cols = 8, 7168
+    if slot_bytes < fast_rows * fast_cols * 2:
+        fast_cols = 128
+        fast_rows = max(1, min(8, slot_bytes // (fast_cols * 2)))
+    p0_fast, p1_fast, exp_fast = _probe_bf16_pair(fast_rows, fast_cols, dev)
+    x_fast = p0_fast if rank == 0 else p1_fast
+    out_fast = torch.zeros_like(x_fast)
+
+    stream_cols = fast_cols
+    target_stream_bytes = min(slot_bytes + 65536, 16 * 1024 * 1024 + 65536)
+    stream_rows = max(
+        20, (target_stream_bytes + stream_cols * 2 - 1) // (stream_cols * 2)
+    )
+    p0_stream, p1_stream, exp_stream = _probe_bf16_pair(stream_rows, stream_cols, dev)
+    x_stream = p0_stream if rank == 0 else p1_stream
+    out_stream = torch.zeros_like(x_stream)
+
+    set_timeout_ms(handle, int(timeout_ms))
+    try:
+        t0 = time.perf_counter()
+        p2p_allreduce_residual(handle, x_fast, out_fast)
+        stream.synchronize()
+        latency_us = (time.perf_counter() - t0) * 1e6
+        if check_error(handle) != 0 or not bool(torch.equal(out_fast, exp_fast)):
+            return False, latency_us, transport
+
+        p2p_allreduce_residual(handle, x_stream, out_stream)
+        stream.synchronize()
+        ok = (check_error(handle) == 0) and bool(torch.equal(out_stream, exp_stream))
+        return ok, latency_us, transport
+    finally:
+        set_timeout_ms(handle, prev_timeout)
+
+
+def create_loopback_pair(
+    device_ordinal: int = 0,
+    max_bytes: int = 4 * 1024 * 1024,
+) -> tuple[int, int]:
+    mod = ensure_p2p_extension()
+    h0, h1 = mod.create_loopback_pair(int(device_ordinal), int(max_bytes))
+    return int(h0), int(h1)
+
+
+def handle_info(handle: int) -> dict[str, Any]:
+    mod = ensure_p2p_extension()
+    return dict(mod.handle_info(int(handle)))
+
+
+def transport_info(handle: int) -> dict[str, Any]:
+    return handle_info(handle)
+
+
+def set_timeout_ms(handle: int, timeout_ms: int) -> None:
+    ensure_p2p_extension()
+    torch.ops._k31_p2p_C.set_timeout_ms(int(handle), int(timeout_ms))
+
+
+def set_abort(handle: int) -> None:
+    ensure_p2p_extension()
+    torch.ops._k31_p2p_C.set_abort(int(handle))
+
+
+def clear_abort(handle: int) -> None:
+    ensure_p2p_extension()
+    torch.ops._k31_p2p_C.clear_abort(int(handle))
+
+
+def check_error(handle: int) -> int:
+    ensure_p2p_extension()
+    return int(torch.ops._k31_p2p_C.check_error(int(handle)))
+
+
+def clear_error(handle: int) -> None:
+    ensure_p2p_extension()
+    torch.ops._k31_p2p_C.clear_error(int(handle))
+
+
+def close_peer_imports(handle: int) -> None:
+    ensure_p2p_extension()
+    torch.ops._k31_p2p_C.close_peer_imports(int(handle))
+
+
+def destroy(handle: int) -> None:
+    ensure_p2p_extension()
+    torch.ops._k31_p2p_C.destroy(int(handle))
+
+
+def destroy_handle(handle: int) -> None:
+    destroy(handle)
+
+
+def p2p_allreduce_residual(
+    handle: int,
+    x_partial: torch.Tensor,
+    out_sum: torch.Tensor,
+    residual: torch.Tensor | None = None,
+    out_res: torch.Tensor | None = None,
+) -> None:
+    ensure_p2p_extension()
+    torch.ops._k31_p2p_C.p2p_allreduce_residual(
