+@pytest.mark.parametrize("tp,rank", [(1, 0), (2, 0), (2, 1)])
+def test_native_load_keeps_no_canonical_record(
+    monkeypatch, meta_platform, checkpoint, tp, rank
+):
+    fake = FakeVqOps()
+    model, _, report, names = construct.build_and_load(
+        monkeypatch, checkpoint, tp_size=tp, tp_rank=rank, native=fake
+    )
+    assert set(report.ledger) == names
+    assert {use for use, _ in report.ledger.values()} == {"consumed"}
+    width = INTER // tp
+    for layer in VQ_LAYERS:
+        routed = _routed(model, layer)
+        experts = routed.k31_experts
+        assert routed.quant_method.native is fake and experts.vq_native is fake
+        assert experts.blocks == _blocks(rank, layer, tp)
+        assert list(experts.parameters()) == []
+        assert set(dict(experts.named_buffers())) == {"packed_ptrs", "packed_meta"} | {
+            f"{w}_packed_{kind}"
+            for w, _ in fixture.PROJECTIONS
+            for kind in ("idx", "scale")
+        }
+        read = 0
+        for w, role in fixture.PROJECTIONS:
+            assert not hasattr(experts, f"{w}_idx") and not hasattr(
+                experts, f"{w}_scale"
+            )
+            idx, scale = _records(checkpoint, layer, w, experts.blocks)
+            read += idx.nbytes + scale.nbytes
+            out_f, in_f = _shape(role, width)
+            rate = fixture.RATES[fixture.expert_rate(layer, w)]
+            packed = getattr(experts, f"{w}_packed_idx")
+            assert packed.dtype == torch.int32 and tuple(packed.shape) == (
+                EXPERTS,
+                out_f // 16,
+                in_f // 128,
+                words_per_lane(*rate[:2]),
+                32,
+            )
+            packed = getattr(experts, f"{w}_packed_scale")
+            assert tuple(packed.shape) == (EXPERTS, out_f // 16, in_f // 128, 16)
+            for key in (f"{_base(layer)}.{w}.vq_idx", f"{_base(layer)}.{w}.vq_scale"):
+                assert report.ledger[key] == ("consumed", experts.prefix)
+        assert experts.bytes_read == read and experts.loaded
+        # The reference decode needs the records this backend does not keep.
+        with pytest.raises(ValueError, match="only the reference backend keeps"):
+            experts.dequant("w1", 0)
+    # Nowhere in the model: no U8 tensor at all (the records are the only
+    # U8 data of a checkpoint), and nothing of a record's or a scale's shape.
+    held = list(chain(model.named_parameters(), model.named_buffers()))
+    assert not [name for name, tensor in held if tensor.dtype == torch.uint8]
+    record_shapes = {shape for kind, shape in fake.moves if kind == "records"}
+    assert len(record_shapes) >= 4
+    assert not [name for name, tensor in held if tuple(tensor.shape) in record_shapes]
+    # The reference backend, for contrast, registers them.
+    model, _, _, _ = construct.build_and_load(
+        monkeypatch, checkpoint, tp_size=tp, tp_rank=rank
+    )
+    held = list(chain(model.named_parameters(), model.named_buffers()))
+    assert len([n for n, t in held if t.dtype == torch.uint8]) == 3 * len(VQ_LAYERS)
+
+
+def _expected_record_bytes(directory, tp, rank):
+    """Per (layer, projection) in load order: bytes of this rank's canonical
+    records, from the file headers alone."""
+    sizes = []
+    for layer in VQ_LAYERS:
+        header, _ = fixture.st_header(directory / f"layer-{layer:03d}.safetensors")
+        for w, _ in fixture.PROJECTIONS:
+            total = 0
+            for kind in ("vq_idx", "vq_scale"):
+                start, stop = header[f"{_base(layer)}.{w}.{kind}"]["data_offsets"]
+                total += stop - start
+            sizes.append(total // tp)
+    return sizes
+
+
+@pytest.mark.parametrize("tp,rank", [(1, 0), (2, 1)])
+def test_native_load_device_peak_is_one_projection(
+    monkeypatch, meta_platform, checkpoint, tp, rank
+):
+    fake = FakeVqOps()
+    # Kept alive: what the model holds is what counts at the end.
+    model, _, _, _ = construct.build_and_load(
+        monkeypatch, checkpoint, tp_size=tp, tp_rank=rank, native=fake
+    )
+    records = _expected_record_bytes(checkpoint, tp, rank)
+    assert len(fake.packs) == len(records) == 3 * len(VQ_LAYERS)
+    assert [pack["record_bytes"] for pack in fake.packs] == records
+    # One vq_pack per (layer, projection), in order w1, w3, w2, each with
+    # this rank's blocks only.
+    blocks = INTER // 128 // tp
+    for index, pack in enumerate(fake.packs):
+        layer = VQ_LAYERS[index // 3]
+        w, role = fixture.PROJECTIONS[index % 3]
+        dim, bits, group = fixture.RATES[fixture.expert_rate(layer, w)]
+        assert (pack["role"], pack["hidden_size"]) == (int(role != "in_latent"), LATENT)
+        assert (pack["dim"], pack["index_bits"], pack["group_size"]) == (
+            dim,
+            bits,
+            group,
+        )
+        assert pack["idx"][:2] == pack["scale"][:2] == (EXPERTS, blocks)
+    # At every event the device holds the records of at most the projection
+    # being packed, and at its vq_pack exactly those, beside every packed
+    # tensor made so far.
+    packed, pack_events = 0, [e for e in fake.events if e.name.startswith("vq_pack")]
+    assert len(pack_events) == len(records)
+    for event, size, pack in zip(pack_events, records, fake.packs):
+        packed += pack["packed_bytes"]
+        assert (event.records, event.packed) == (size, packed)
+    assert max(event.records for event in fake.events) == max(records)
+    books = {
+        fixture.expert_rate(layer, w)
+        for layer in VQ_LAYERS
+        for w, _ in fixture.PROJECTIONS
+    }
+    book_bytes = sum(
+        2 * (1 << fixture.RATES[b][1]) * fixture.RATES[b][0] for b in books
+    )
+    assert fake.peak == max(
+        size + event.packed + event.codebooks
+        for size, event in zip(records, pack_events)
+    )
+    assert fake.peak <= max(records) + packed + book_bytes
+    # Afterwards: no canonical record is alive, every packed tensor is.
+    after = fake.live()
+    assert (after.records, after.packed, after.codebooks) == (0, packed, book_bytes)
+    assert packed == sum(
+        tensor.nbytes for name, tensor in model.named_buffers() if "_packed_" in name
+    )
+
