+def _make_fake_recurrent_model(
+    arch: str,
+    rank: int,
+    tp: int,
+    vocab: int,
+    h_dim: int,
+    rank_dim: int,
+    seed: int = 17,
+):
+    g = torch.Generator().manual_seed(seed)
+    width = -(-vocab // tp)
+    col_start = rank * width
+
+    w1 = torch.randn(vocab, rank_dim, generator=g).to(torch.bfloat16)
+    w2 = torch.randn(vocab, rank_dim, generator=g).to(torch.bfloat16)
+    lm_w = torch.randn(vocab, h_dim, generator=g).to(torch.bfloat16)
+    emb_w = torch.randn(vocab, h_dim, generator=g).to(torch.bfloat16)
+    conf_w = torch.randn(1, h_dim + rank_dim, generator=g) * 0.1
+
+    if arch == "gru":
+        head = DSparkGRUHead(
+            hidden_size=h_dim, markov_rank=rank_dim, gru_dim=64, trained_k=7
+        ).to(torch.bfloat16)
+    else:
+        head = DSparkAR1Head(
+            mode=arch,
+            hidden_size=h_dim,
+            markov_rank=rank_dim,
+            d_model=64,
+            num_layers=2,
+            num_heads=4,
+            intermediate_size=128,
+            trained_k=7,
+        ).to(torch.bfloat16)
+    _randomize_head(head, seed=seed + 31)
+
+    lm_padded = torch.zeros(tp * width, h_dim, dtype=torch.bfloat16)
+    lm_padded[:vocab] = lm_w
+    lm_shard = lm_padded[col_start : col_start + width].contiguous()
+
+    emb_padded = torch.zeros(tp * width, h_dim, dtype=torch.bfloat16)
+    emb_padded[:vocab] = emb_w
+    emb_shard = emb_padded[col_start : col_start + width].contiguous()
+
+    def precompute_recurrent_hidden(dh_3d: torch.Tensor):
+        if arch == "gru":
+            return ("gru", head.precompute_hidden(dh_3d), None)
+        kv = head.init_kv_cache(dh_3d.shape[0], dh_3d.shape[1], dh_3d.device)
+        return (arch, head.precompute_hidden(dh_3d), kv)
+
+    def recurrent_step(prev_ids: torch.Tensor, rec_state, step: int):
+        e_t = w1[prev_ids.long()]
+        if arch == "gru":
+            hz, hr, hn, hctx = rec_state[1]
+            m_t, next_s = head.step_precomputed(
+                e_t, hz[:, step], hr[:, step], hn[:, step], hctx[:, step], rec_state[2]
+            )
+            return m_t, None, ("gru", rec_state[1], next_s)
+        m_t, vec_t = head.step_precomputed(
+            e_t, rec_state[1][:, step], rec_state[2], step
+        )
+        return m_t, vec_t, rec_state
+
+    model = SimpleNamespace(
+        head_arch=arch,
+        has_recurrent_markov_head=True,
+        supports_shortlist_recurrent=True,
+        lm_head=SimpleNamespace(tp_rank=rank, tp_size=tp),
+        logits_processor=SimpleNamespace(org_vocab_size=vocab, scale=1.0),
+        draft_id_to_target_id=None,
+        map_draft_to_target=lambda ids: ids,
+        compute_draft_logits=lambda h: h.float() @ lm_w.float().T,
+        compute_logits_local=lambda h: (h.float() @ lm_shard.float().T).contiguous(),
+        markov_embed=lambda t: w1[t.long()],
+        markov_bias=lambda m: m.float() @ w2.float().T,
+        markov_bias_local=lambda m, start, n: (
+            m.float() @ w2[start : start + n].float().T
+        ).contiguous(),
+        markov_w2_rows=lambda start, n: w2[start : start + n].contiguous(),
+        embed_rows_local=(
+            (lambda n: emb_shard[:n].contiguous())
+            if arch == "ar1_cand_embed"
+            else (lambda n: None)
+        ),
+        compute_embed_logits=lambda v: v.float() @ emb_w.float().T,
+        compute_embed_logits_local=lambda v, n: (
+            v.float() @ emb_shard[:n].float().T
+        ).contiguous(),
+        precompute_recurrent_hidden=precompute_recurrent_hidden,
+        recurrent_step=recurrent_step,
+        compute_confidence=lambda h, m: torch.sigmoid(
+            (torch.cat([h.float(), m.float()], dim=-1) @ conf_w.T).squeeze(-1)
+        ),
+        model=SimpleNamespace(
+            head_arch=arch,
+            markov_head=SimpleNamespace(markov_w1=SimpleNamespace(weight=w1)),
+            confidence_head=True,
+        ),
+    )
+    return model
+
+
+def _gloo_recurrent_worker(rank: int, tp: int, init_file: str, out_file: str) -> None:
+    import torch.distributed as dist
+
+    from vllm.sm80.spec_decode import markov_shortlist as mt
+    from vllm.sm80.spec_decode import shard_argmax as sa
+    from vllm.v1.worker.gpu.spec_decode.dspark.speculator import DSparkSpeculator
+
+    dist.init_process_group(
+        "gloo", init_method=f"file://{init_file}", rank=rank, world_size=tp
+    )
+
+    def all_reduce(t: torch.Tensor) -> torch.Tensor:
+        f = t.float()
+        dist.all_reduce(f)
+        return f.to(t.dtype)
+
+    sa.BLOCK = mt.BLOCK = 16
+    sa.tensor_model_parallel_all_reduce = all_reduce
+    mt.tensor_model_parallel_all_reduce = all_reduce
+
+    vocab, n_spec, num_reqs, h_dim, rank_dim = 60, 4, 2, 64, 16
+    width = -(-vocab // tp)
+    g = torch.Generator().manual_seed(123)
+    head_hidden = torch.randn(
+        num_reqs * n_spec, h_dim, generator=g, dtype=torch.bfloat16
+    )
+    input_ids = torch.randint(0, vocab, (32,), generator=g, dtype=torch.int32)
+
+    payload = {}
+    for arch in ("gru", "ar1_markov", "ar1_cand_embed", "ar1_fulllm"):
+        model = _make_fake_recurrent_model(
+            arch, rank, tp, vocab, h_dim, rank_dim, seed=55
+        )
+
+        def run_mode(argmax_on: str, cands: int, succ: int):
+            os.environ[ARGMAX_SWITCH] = argmax_on
+            os.environ[SWITCH] = str(cands)
+            os.environ[SUCCESSORS] = str(succ)
+            s = object.__new__(DSparkSpeculator)
+            s.model = model
+            s.num_speculative_steps = n_spec
+            s._step_cols = torch.arange(n_spec, dtype=torch.int32)
+            s.sample_indices = torch.arange(num_reqs * n_spec, dtype=torch.int64)
+            s.sample_idx_mapping = torch.arange(num_reqs * n_spec, dtype=torch.int32)
+            s.sample_pos = torch.ones(num_reqs * n_spec, dtype=torch.int64)
+            s.input_buffers = SimpleNamespace(input_ids=input_ids.clone())
+            s._anchor_idx = torch.arange(num_reqs, dtype=torch.int64) * n_spec
+            s.draft_tokens = torch.zeros(num_reqs, n_spec, dtype=torch.int64)
+            s.draft_token_confidence_probs = torch.zeros(num_reqs, n_spec)
+            s.draft_logits = None
+            s._draft_topk = None
+            s.acceptance_estimator = None
+            s._fuse_markov_bias = False
+            s.use_confidence_head = True
+            s._maybe_predict_acceptance = lambda *a, **kw: None
+            s._sample_sequential(num_reqs, head_hidden)
+            return s.draft_tokens.tolist(), s.draft_token_confidence_probs.tolist()
+
+        ref_tok, ref_conf = run_mode("0", 0, 16)
+        full_tok, full_conf = run_mode("1", 0, 16)
+        sl_tok, sl_conf = run_mode("1", width, width)
+        payload[arch] = {
+            "ref_tok": ref_tok,
+            "full_tok": full_tok,
+            "sl_tok": sl_tok,
+            "ref_conf": ref_conf,
+            "full_conf": full_conf,
+            "sl_conf": sl_conf,
+        }
+
+    with open(out_file, "w", encoding="utf-8") as f:
+        json.dump(payload, f)
+    dist.destroy_process_group()
+
+
+def _run_gloo_recurrent(tmp: str, tp: int = 2) -> list[dict]:
+    import torch.multiprocessing as mp
+
+    files = [os.path.join(tmp, f"r{r}.json") for r in range(tp)]
+    init = os.path.join(tmp, "init")
+    ctx = mp.get_context("spawn")
+    procs = [
+        ctx.Process(target=_gloo_recurrent_worker, args=(r, tp, init, files[r]))
+        for r in range(tp)
+    ]
+    for p in procs:
+        p.start()
+    for p in procs:
+        p.join(900)
+        assert p.exitcode == 0, p.exitcode
+    return [json.loads(Path(f).read_text(encoding="utf-8")) for f in files]
+
+
+def test_recurrent_shortlist_and_fullshard_match_reference_tp2(tmp_path: Path) -> None:
+    env = dict(os.environ, TRITON_INTERPRET="1", CUDA_VISIBLE_DEVICES="")
+    code = (
+        f"import json; from {MODULE} import _run_gloo_recurrent as f; "
+        f"print('RESULT ' + json.dumps(f({str(tmp_path)!r}, 2)))"
+    )
+    done = subprocess.run(
+        [sys.executable, "-c", code],
+        cwd=ROOT,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=1800,
+    )
+    assert done.returncode == 0, done.stderr[-4000:]
+    line = [ln for ln in done.stdout.splitlines() if ln.startswith("RESULT ")][-1]
+    ranks = json.loads(line[len("RESULT ") :])
+    assert len(ranks) == 2
+    for arch in ("gru", "ar1_markov", "ar1_cand_embed", "ar1_fulllm"):
+        r0, r1 = ranks[0][arch], ranks[1][arch]
+        assert r0["full_tok"] == r0["ref_tok"]
+        assert r0["sl_tok"] == r0["ref_tok"]
+        assert r1["full_tok"] == r0["ref_tok"]
+        assert r1["sl_tok"] == r0["ref_tok"]
+        assert torch.allclose(
+            torch.tensor(r0["full_conf"]), torch.tensor(r0["ref_conf"]), atol=1e-4
+        )
+        assert torch.allclose(
+            torch.tensor(r0["sl_conf"]), torch.tensor(r0["ref_conf"]), atol=1e-4
+        )
