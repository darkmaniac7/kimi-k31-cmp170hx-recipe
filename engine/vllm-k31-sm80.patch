+        assert ft.shape == (3, K, bn) and ft.stride() == (K * bn, bn, 1)
+        assert part.is_contiguous() and psq.is_contiguous() and ft.is_contiguous()
+        for i, (view, storage) in enumerate(zip(
+            (part, psq, ft), (owner.part, owner.psq, owner.pack)
+        )):
