@@ -0,0 +1,1029 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Card tests of the sm_80 Kimi K3.1 MLA + indexer path
+(vllm/models/kimi_k3/nvidia/sm80_dsa.py, sm80_model.py): the compiled
+kernels against torch references, and one K3.1 DSA layer at the shape of a
+TP2 rank (48 heads, q_lora 1536, kv_lora 512, 128 + 64, index 32 x 128,
+top-k 2048) with random plain BF16 weights against a torch reference of the
+same math.
+
+Marked ``cuda``: they run only under the GPU lock (tests/sm80/
+gpu_lock_guard.py; set GPU_LOCK_TOKENS) and skip without a CUDA device.
+
+Tie rule of the top-k comparisons. The top-k kernels return an exact top-k
+by score and place entries that tie with the k-th score in arrival order
+(vllm/sm80/kernels/indexer/topk_tiefix.py), so:
+* against the kernel's own logits the selected set must hold every entry
+  that scores above the k-th score, and only entries that score at least it;
+* against the torch reference of the scoring, whose sums run in another
+  order, an entry may differ only if its reference score is within 1e-5 of
+  the row's largest magnitude of the k-th reference score.
+With VLLM_GLM5_TOPK_TIEFIX=1 ties go to the lowest indices; that is tested
+on exactly tied scores.
+"""
+
+import pytest
+import torch
+import torch.nn.functional as F
+
+from tests.models.kimi_k3.sm80 import sm80_dsa_cases as cases
+from vllm.models.kimi_k3.nvidia import sm80_dsa
+
+pytestmark = [
+    pytest.mark.cuda,
+    pytest.mark.skipif(not torch.cuda.is_available(), reason="needs a CUDA device"),
+]
+DEVICE = "cuda"
+D, BLOCK, TOPK = cases.HEAD_DIM, cases.BLOCK, cases.TOPK
+
+
+# -- e4m3 conversion ----------------------------------------------------------
+
+
+@pytest.mark.parametrize("low_bits", cases.SWEEP_LOW_BITS)
+def test_compiled_encode_equals_torch_casts(low_bits):
+    x = cases.fp32_sweep(low_bits, DEVICE)
+    got = cases.triton_encode(x)
+    want = x.cpu().to(torch.float8_e4m3fn).view(torch.uint8)
+    assert torch.equal(got.cpu(), want), cases.first_mismatches(
+        x.cpu(), got.cpu(), want
+    )
+    # torch's cast on the device, the one a GPU reference would use.
+    assert torch.equal(got, x.to(torch.float8_e4m3fn).view(torch.uint8))
+
+
+def test_compiled_decode_all_codes():
+    codes = torch.arange(256, dtype=torch.uint8, device=DEVICE)
+    got = cases.triton_decode(codes).cpu()
+    want = sm80_dsa.e4m3_values_reference(codes.cpu())
+    finite = (codes.cpu() & 0x7F) != 0x7F
+    assert torch.equal(got[finite], want[finite])
+    assert got[0x7F] == 480.0 and got[0xFF] == -480.0
+
+
+# -- key insert and query quantization ----------------------------------------
+
+
+@pytest.mark.parametrize("packed", [False, True])
+@pytest.mark.parametrize("num_tokens", [1, 7, 300, 4100])
+def test_k_insert_kernel(packed, num_tokens):
+    """bfloat16 keys: the LayerNorm sum order may flip a rare bf16 rounding
+    tie against F.layer_norm (upstream's own test allows 1e-3 of the bytes)."""
+    cases.check_k_insert(
+        packed, num_tokens, DEVICE, torch.bfloat16, allowed_fraction=1e-3
+    )
+
+
+def test_k_insert_kernel_fp8_ds_mla_row():
+    cases.check_k_insert(
+        True, 300, DEVICE, torch.bfloat16, cases.MLA_BYTES_FP8_DS, 1e-3
+    )
+
+
+@pytest.mark.parametrize("packed", [False, True])
+def test_k_insert_bytes_are_exact_on_exact_inputs(packed):
+    """Keys whose LayerNorm output is known exactly: balanced +-1 inputs give
+    mean 0 and variance 1 whatever the order of the sums, so the normed key
+    is +-w + b after the bf16 rounding (w, b multiples of 1/16 below 4: the
+    5e-6 relative shrink of rsqrt(1 + eps) cannot cross a bf16 boundary).
+    Every byte and scale of the cache is then determined; ties to even
+    included (values on a 1/16 grid)."""
+    gen = torch.Generator().manual_seed(3)
+    num_tokens, num_pages = 500, 9
+    signs = torch.stack(
+        [
+            torch.cat((torch.ones(D // 2), -torch.ones(D // 2)))[
+                torch.randperm(D, generator=gen)
+            ]
+            for _ in range(num_tokens)
+        ]
+    )
+    # Odd sixteenths against even ones: +-w + b never cancels to zero (where
+    # the shrink of rsqrt(1 + eps) would be all that is left).
+    weight = (2 * torch.randint(0, 32, (D,), generator=gen) + 1).float() / 16
+    bias = 2 * torch.randint(-31, 32, (D,), generator=gen).float() / 16
+    k = signs.to(torch.bfloat16).to(DEVICE)
+    slots = torch.randperm(num_pages * BLOCK, generator=gen)[:num_tokens]
+    slots = slots.to(torch.int64).to(DEVICE)
+    raw, view = cases.make_index_cache(packed, num_pages, DEVICE, fill=0x5A)
+    topk = torch.zeros((num_tokens, TOPK), dtype=torch.int32, device=DEVICE)
+    sm80_dsa.sm80_indexer_k_norm_quant_insert(
+        k, weight.to(DEVICE), bias.to(DEVICE), 1e-5, slots, view, topk, num_tokens
+    )
+
+    y = signs * weight + bias  # exact in fp32 and in bf16
+    assert torch.equal(y.to(torch.bfloat16).float(), y)
+    amax = y.abs().amax(dim=-1).clamp(min=1e-4)
+    scale = torch.exp2(torch.ceil(torch.log2(amax / 448.0)))
+    want_bits = (y / scale[:, None]).to(torch.float8_e4m3fn).view(torch.uint8)
+    got_bits, got_scale = cases.keys_by_page_view(view.cpu())
+    assert torch.equal(got_scale[slots.cpu()], scale)
+    assert torch.equal(got_bits[slots.cpu()], want_bits)
+    untouched = torch.ones(num_pages * BLOCK, dtype=torch.bool)
+    untouched[slots.cpu()] = False
+    assert (got_bits[untouched] == 0x5A).all()
+    assert (topk == -1).all()
+
+
+@pytest.mark.parametrize("packed", [False, True])
+def test_k_insert_matches_upstreams_unfused_cache_op(packed):
+    """Upstream defines the cache bytes by its CUDA op
+    ``indexer_k_quant_and_cache`` (ops/dsa_indexer.py: "Same math as the CUDA
+    indexer_k_quant_and_cache kernel"); the comparison of upstream's own
+    test_dsa_indexer_fused.py, on the sm_80 kernel."""
+    from vllm import _custom_ops as ops
+
+    torch.manual_seed(0)
+    num_tokens, num_pages = 300, 7
+    k = torch.randn(num_tokens, D + 32, dtype=torch.bfloat16, device=DEVICE)[:, :D]
+    weight = torch.rand(D, dtype=torch.float32, device=DEVICE) + 0.5
+    bias = torch.randn(D, dtype=torch.float32, device=DEVICE) * 0.1
+    slots = torch.randperm(num_pages * BLOCK, device=DEVICE)[:num_tokens]
+    slots = slots.to(torch.int64)
+    ref_raw, ref_view = cases.make_index_cache(packed, num_pages, DEVICE)
+    ref_k = F.layer_norm(k.float(), (D,), weight, bias, 1e-5).to(k.dtype)
+    ops.indexer_k_quant_and_cache(ref_k.contiguous(), ref_view, slots, D, "ue8m0")
+    raw, view = cases.make_index_cache(packed, num_pages, DEVICE)
+    topk = torch.zeros((num_tokens, TOPK), dtype=torch.int32, device=DEVICE)
+    sm80_dsa.sm80_indexer_k_norm_quant_insert(
+        k, weight, bias, 1e-5, slots, view, topk, num_tokens
+    )
+    differs = raw != ref_raw
+    assert int(differs.sum()) <= 1e-3 * num_tokens * D
+    step = (raw[differs].to(torch.int16) - ref_raw[differs].to(torch.int16)).abs()
+    assert (step == 1).all()
+
+
+@pytest.mark.parametrize("num_heads", [cases.NUM_HEADS, 20])
+@pytest.mark.parametrize("num_tokens", [1, 33, 1100])
+def test_q_quant_kernel(num_heads, num_tokens):
+    cases.check_q_quant(num_heads, num_tokens, DEVICE)
+
+
+# -- logits and top-k ---------------------------------------------------------
+
+
+@pytest.mark.parametrize("raw_k", ["0", "1"])
+@pytest.mark.parametrize("next_n", [1, 2, 8])
+@pytest.mark.parametrize("packed", [False, True])
+def test_paged_logits_are_exact_on_exact_inputs(packed, next_n, raw_k, monkeypatch):
+    """The fork's paged logits kernel over both cache layouts, bit for bit
+    against a key-by-key reference, on integer inputs whose sums are exact;
+    also with the raw-bit key dequantization the GLM launcher turns on."""
+    monkeypatch.setenv("VLLM_INDEXER_DECODE_RAW_K", raw_k)
+    problem = cases.exact_decode_problem(packed, next_n, DEVICE)
+    want = cases.brute_force_logits(problem)
+    max_model_len = 4 * BLOCK
+    got = sm80_dsa.sm80_paged_mqa_logits(
+        problem.q_bits,
+        problem.view,
+        problem.weights,
+        problem.context_lens,
+        problem.block_table,
+        max_model_len,
+    )
+    assert got.shape == (problem.context_lens.numel(), max_model_len)
+    for row, expected in enumerate(want):
+        assert torch.equal(got[row, : expected.numel()], expected), row
+        # Inside the pages the kernel visited, past the context: -inf.
+        end = -(-expected.numel() // BLOCK) * BLOCK
+        assert (got[row, expected.numel() : end] == float("-inf")).all()
+
+
+@pytest.mark.parametrize("packed", [False, True])
+def test_paged_logits_match_the_torch_reference_on_random_keys(packed):
+    from vllm.sm80.kernels.attention import triton_mqa_logits as mqa
+
+    torch.manual_seed(5)
+    num_pages, batch, heads, length = 80, 4, 32, 4500
+    raw, view = cases.make_index_cache(packed, num_pages, DEVICE)
+    k = torch.randn(num_pages * BLOCK, D, dtype=torch.bfloat16, device=DEVICE)
+    ones = torch.ones(D, device=DEVICE)
+    bits, scale = sm80_dsa.k_norm_quant_reference(k, ones, 0 * ones, 1e-5)
+    slots = torch.arange(num_pages * BLOCK, device=DEVICE)
+    sm80_dsa.index_cache_write_reference(view, slots, bits, scale)
+    q = torch.randn(batch, heads, D, dtype=torch.bfloat16, device=DEVICE)
+    w = torch.randn(batch, heads, dtype=torch.bfloat16, device=DEVICE)
+    q_bits, weights = sm80_dsa.sm80_indexer_q_quant_fold_weights(q, w, 1 / 64, heads)
+    block_table = torch.randperm(num_pages, device=DEVICE).to(torch.int32)
+    block_table = block_table[: batch * 18].view(batch, 18).contiguous()
+    context_lens = torch.tensor(
+        [[1], [777], [BLOCK * 16], [18 * BLOCK]], dtype=torch.int32, device=DEVICE
+    )
+    args = (weights, context_lens, block_table, length)
+    got = sm80_dsa.sm80_paged_mqa_logits(q_bits.view(batch, 1, heads, D), view, *args)
+    want = mqa.fp8_paged_mqa_logits_torch(
+        q_bits.view(batch, 1, heads, D).view(torch.float8_e4m3fn), view, *args
+    )
+    for row in range(batch):
+        n = min(int(context_lens[row, 0]), length)
+        torch.testing.assert_close(got[row, :n], want[row, :n], rtol=2e-5, atol=1e-6)
+
+
+def _decode_topk(logits, context_lens, next_n, tiefix: bool) -> torch.Tensor:
+    """The decode top-k as the indexer step runs it."""
+    from vllm.model_executor.layers.indexer_topk import get_indexer_topk
+    from vllm.sm80.kernels.indexer import topk_tiefix_gate as gate
+
+    out = torch.full((logits.shape[0], TOPK), -7, dtype=torch.int32, device=DEVICE)
+    get_indexer_topk("auto")(
+        logits, context_lens, next_n, out, TOPK, int(context_lens.max())
+    )
+    gate.use_tiefix_topk.cache_clear()
+    gate.use_sorted_topk.cache_clear()
+    if tiefix:
+        gate.tiefix_decode_topk_(logits, out, context_lens, next_n)
+    return out
+
+
+@pytest.mark.parametrize("tiefix", [False, True])
+def test_decode_topk_set_and_tie_rule(tiefix, monkeypatch, workspace_init):
+    """Top-k of exactly known scores with a tied group across the boundary."""
+    monkeypatch.setenv("VLLM_GLM5_TOPK_TIEFIX", "1" if tiefix else "0")
+    torch.manual_seed(11)
+    rows, width = 8, 5000
+    lens = torch.tensor(
+        [[4999], [2048], [2049], [3000], [100], [1], [4096], [2500]],
+        dtype=torch.int32,
+        device=DEVICE,
+    )
+    logits = torch.randint(0, 3000, (rows, width), device=DEVICE).float()
+    # Row 3: 1,500 entries above a group of 1,000 tied entries (548 of them
+    # fit); row 6: every entry tied.
+    logits[3, :3000] = 1.0
+    logits[3, torch.randperm(3000, device=DEVICE)[:1500]] = 9.0
+    logits[3, torch.randperm(3000, device=DEVICE)[:500]] = 0.5
+    logits[6] = 2.0
+    # Past a row's length the kernels must not read: poison it.
+    for row in range(rows):
+        logits[row, int(lens[row, 0]) :] = float("inf")
+    out = _decode_topk(logits, lens, 1, tiefix)
+    for row in range(rows):
+        length = int(lens[row, 0])
+        keep = min(TOPK, length)
+        chosen = out[row, :keep].long()
+        assert (out[row, keep:] == -1).all(), row
+        assert chosen.min() >= 0 and chosen.max() < length, row
+        assert chosen.unique().numel() == keep, row
+        scores = logits[row, :length]
+        kth = scores.topk(keep).values[-1]
+        assert (scores[chosen] >= kth).all(), row
+        above = (scores > kth).nonzero().flatten()
+        assert torch.isin(above, chosen).all(), row
+        if tiefix:
+            # The canonical set: score descending, then index ascending.
+            order = torch.sort(-scores, stable=True).indices[:keep]
+            assert torch.equal(chosen.sort().values, order.sort().values), row
+
+
+# -- one K3.1 MLA + indexer layer ---------------------------------------------
+#
+# The layer runs as in the engine: the platform picks its backend, the two
+# metadata builders of its caches build every step from a batch description,
+# and the caches are bound as the runner binds them (apart, or as strided
+# views of one packed block row).
+#
+# The reference has two parts. The plain stages of the layer (the input and
+# query projections, the two RMSNorms, the gate projection) are captured from
+# the layer by forward hooks and compared with the same operation done here,
+# which pins which tensor feeds which stage. Everything specific to this path
+# is then recomputed in torch from those captured tensors: the key LayerNorm
+# and FP8 bytes, the query quantization and folded weights, the scores, the
+# top-k, the cached rows, the sparse attention with the absorbed kv_b
+# projection, the gate and the output projection.
+
+
+class _Request:
+    def __init__(self, index: int, pages: list[int]):
+        self.index = index
+        self.length = 0
+        self.pages = pages
+        self.latent = []  # per chunk: the row the latent cache must hold
+        self.index_k = []  # per chunk: the indexer key before its norm
+
+
+class _Harness:
+    """One DSA layer with its two caches, metadata builders and a reference."""
+
+    MAX_LEN = 3072
+    MAX_REQUESTS = 8
+    MAX_BATCHED = 4096
+
+    def __init__(
+        self, tmp_path, packed: bool, cache_dtype: str = "auto", drafts: int = 0
+    ):
+        from vllm.config import set_current_vllm_config
+        from vllm.models.kimi_k3.common.dsa_cache import KimiK3IndexerBackend
+        from vllm.models.kimi_k3.nvidia import dsa as upstream_dsa
+        from vllm.models.kimi_k3.nvidia import sm80_model  # noqa: F401 (registers)
+        from vllm.sm80.attention.triton_mla_sparse import TritonMLASparseBackend
+        from vllm.utils.torch_utils import set_default_torch_dtype
+
+        self.packed = packed
+        directory = cases.write_config(tmp_path / "k31", cases.RANK_TEXT)
+        self.config = config = cases.vllm_config(
+            directory,
+            max_model_len=self.MAX_LEN,
+            max_num_batched_tokens=self.MAX_BATCHED,
+            max_num_seqs=self.MAX_REQUESTS,
+        )
+        config.cache_config.block_size = BLOCK
+        config.cache_config.cache_dtype = cache_dtype
+        if drafts:
+            # Verify steps of 1 + drafts rows per request count as decodes.
+            from tests.models.test_native_checkpoint_config_meta import (
+                _runtime_defaults,
+            )
+            from vllm.config import SpeculativeConfig
+
+            config.speculative_config = _runtime_defaults(
+                SpeculativeConfig, num_speculative_tokens=drafts, method="dspark"
+            )
+        self.text = text = config.model_config.hf_text_config
+        assert (text.num_attention_heads, text.q_lora_rank, text.kv_lora_rank) == (
+            48,
+            1536,
+            512,
+        )
+        assert (text.qk_nope_head_dim, text.qk_rope_head_dim) == (128, 64)
+        assert text.dsa_config.index_num_heads == 32 and text.index_topk == TOPK
+        self._context = set_current_vllm_config(config)
+        self._context.__enter__()
+        self.topk = torch.full(
+            (self.MAX_BATCHED, TOPK), -5, dtype=torch.int32, device=DEVICE
+        )
+        prefix = "language_model.model.layers.3.self_attn"
+        with set_default_torch_dtype(torch.bfloat16):
+            layer = upstream_dsa.KimiK3DSAAttention(
+                config=text,
+                hidden_size=text.hidden_size,
+                num_heads=text.num_attention_heads,
+                qk_nope_head_dim=text.qk_nope_head_dim,
+                qk_rope_head_dim=text.qk_rope_head_dim,
+                v_head_dim=text.v_head_dim,
+                q_lora_rank=text.q_lora_rank,
+                kv_lora_rank=text.kv_lora_rank,
+                cache_config=config.cache_config,
+                quant_config=None,
+                prefix=prefix,
+                topk_indices_buffer=self.topk,
+            )
+        layer = layer.to(DEVICE)
+        self._init_weights(layer)
+        self.mla = layer.mla_attn.mla_attn
+        # The platform's own choice for this layer on this card.
+        assert self.mla.get_attn_backend() is TritonMLASparseBackend
+        assert self.mla.kv_cache_dtype == cache_dtype
+        self.layer = sm80_dsa.KimiK3DSAAttention.adopt(layer)
+        self.indexer = layer.dsa_indexer
+        self.mla.process_weights_after_loading()
+        layer.pack_projections()
+        self.captured: dict[str, torch.Tensor] = {}
+        for name, module in (
+            ("qkv", layer.fused_qkv_a_proj),
+            ("q_norm", layer.q_a_layernorm),
+            ("kv_norm", layer.kv_a_layernorm),
+            ("q", layer.q_b_proj),
+            ("index_q", layer.dsa_indexer.wq_index),
+            ("kw", layer.dsa_indexer.wkv_index),
+            ("gate", layer.g_proj),
+        ):
+            module.register_forward_hook(self._capture(name))
+
+        # Caches: one 64-token page per layer and block, packed or apart.
+        self.pages_per_request = self.MAX_LEN // BLOCK
+        num_pages = 1 + self.MAX_REQUESTS * self.pages_per_request
+        mla_bytes = cases.MLA_BYTES_BF16
+        if packed:
+            stride = cases.packed_row_stride(mla_bytes)
+            self.raw = torch.zeros(
+                (num_pages, stride), dtype=torch.uint8, device=DEVICE
+            )
+            mla_view = torch.as_strided(
+                self.raw.view(torch.bfloat16),
+                (num_pages, 1, BLOCK, 576),
+                (stride // 2, BLOCK * 576, 576, 1),
+            )
+            index_view = torch.as_strided(
+                self.raw,
+                (num_pages, 1, BLOCK, cases.ENTRY),
+                (stride, BLOCK * cases.ENTRY, cases.ENTRY, 1),
+                BLOCK * mla_bytes,
+            )
+        else:
+            mla_view = torch.zeros(
+                (num_pages, 1, BLOCK, 576), dtype=torch.bfloat16, device=DEVICE
+            )
+            index_view = torch.zeros(
+                (num_pages, 1, BLOCK, cases.ENTRY), dtype=torch.uint8, device=DEVICE
+            )
+        self.mla.bind_kv_cache(mla_view)
+        self.indexer.k_cache.bind_kv_cache(index_view)
+        assert self.indexer.k_cache.kv_cache.is_contiguous() is not packed
+
+        self.mla_name = self.mla.layer_name
+        self.index_name = self.indexer.k_cache.prefix
+        device = torch.device(DEVICE)
+        self.mla_builder = TritonMLASparseBackend.get_builder_cls()(
+            self.mla.get_kv_cache_config(config).spec, [self.mla_name], config, device
+        )
+        self.index_builder = KimiK3IndexerBackend.get_builder_cls()(
+            self.indexer.k_cache.get_kv_cache_config(config).spec,
+            [self.index_name],
+            config,
+            device,
+            block_table_width=self.pages_per_request,
+        )
+        # Page 0 is never handed out; the others are dealt in a shuffled order.
+        deal = torch.randperm(num_pages - 1, generator=torch.Generator().manual_seed(9))
+        deal = (deal + 1).tolist()
+        per = self.pages_per_request
+        self.requests = [
+            _Request(i, deal[i * per : (i + 1) * per]) for i in range(self.MAX_REQUESTS)
+        ]
+
+    def close(self):
+        self._context.__exit__(None, None, None)
+
+    def _capture(self, name: str):
+        def hook(module, args, output):
+            output = output[0] if isinstance(output, tuple) else output
+            self.captured[name] = output.detach().clone()
+
+        return hook
+
+    @staticmethod
+    def _init_weights(layer):
+        gen = torch.Generator(device=DEVICE).manual_seed(7)
+
+        def normal(shape, std):
+            return torch.randn(shape, generator=gen, device=DEVICE) * std
+
+        with torch.no_grad():
+            for name, param in layer.named_parameters():
+                if name.endswith("norm.weight"):
+                    value = 1 + normal(param.shape, 0.1)
+                elif name.endswith("norm.bias"):
+                    value = normal(param.shape, 0.1)
+                else:
+                    assert param.dim() == 2, name
+                    value = normal(param.shape, param.shape[1] ** -0.5)
+                param.copy_(value.to(param.dtype))
+
+    @staticmethod
+    def _rms(x, weight, eps):
+        x = x.float()
+        y = x * torch.rsqrt(x.pow(2).mean(-1, keepdim=True) + eps) * weight.float()
+        return y.to(torch.bfloat16)
+
+    # -- one engine step ----------------------------------------------------
+
+    def step(self, new_tokens: dict[int, int], seed: int) -> dict:
+        """Run ``new_tokens[request]`` more tokens of each listed request
+        through the layer in one batch. Returns the step's record: the
+        output, both metadata objects and, per request, the captured stage
+        outputs of its rows."""
+        from vllm.forward_context import set_forward_context
+        from vllm.v1.attention.backend import CommonAttentionMetadata
+
+        gen = torch.Generator(device=DEVICE).manual_seed(seed)
+        order = sorted(new_tokens)
+        query_lens, seq_lens, slots, positions, first = [], [], [], [], {}
+        for index in order:
+            request, count = self.requests[index], new_tokens[index]
+            pos = torch.arange(request.length, request.length + count)
+            page = torch.tensor(request.pages)[pos // BLOCK]
+            slots.append(page * BLOCK + pos % BLOCK)
+            positions.append(pos)
+            first[index] = request.length
+            request.length += count
+            query_lens.append(count)
+            seq_lens.append(request.length)
+        num_tokens = sum(query_lens)
+        x = torch.randn(
+            (num_tokens, self.text.hidden_size), generator=gen, device=DEVICE
+        ).to(torch.bfloat16)
+        start = torch.tensor([0] + query_lens).cumsum(0).to(torch.int32)
+        seq = torch.tensor(seq_lens, dtype=torch.int32)
+        common = CommonAttentionMetadata(
+            query_start_loc=start.to(DEVICE),
+            query_start_loc_cpu=start,
+            seq_lens=seq.to(DEVICE),
+            seq_lens_cpu_upper_bound=seq,
+            num_reqs=len(order),
+            num_actual_tokens=num_tokens,
+            max_query_len=max(query_lens),
+            max_seq_len=max(seq_lens),
+            block_table_tensor=torch.tensor(
+                [self.requests[i].pages for i in order], dtype=torch.int32
+            ).to(DEVICE),
+            slot_mapping=torch.cat(slots).to(torch.int64).to(DEVICE),
+            causal=True,
+            positions=torch.cat(positions).to(DEVICE),
+        )
+        mla_metadata = self.mla_builder.build(0, common)
+        index_metadata = self.index_builder.build(0, common)
+        self.topk[:num_tokens] = -5
+        self.captured.clear()
+        with set_forward_context(
+            {self.mla_name: mla_metadata, self.index_name: index_metadata},
+            self.config,
+            slot_mapping={
+                self.mla_name: common.slot_mapping,
+                self.index_name: index_metadata.slot_mapping,
+            },
+        ):
+            out = self.layer(common.positions, x)
+        c = self.captured
+        self._check_plain_stages(x, c)
+        record = {
+            "out": out,
+            "topk": self.topk[:num_tokens].clone(),
+            "mla_metadata": mla_metadata,
+            "index_metadata": index_metadata,
+            "requests": {},
+        }
+        for i, index in enumerate(order):
+            rows = slice(int(start[i]), int(start[i + 1]))
+            request = self.requests[index]
+            request.latent.append(
+                torch.cat((c["kv_norm"][rows], c["qkv"][rows, 2048:]), -1)
+            )
+            request.index_k.append(c["kw"][rows, :D])
+            record["requests"][index] = {
+                "rows": rows,
+                "first": first[index],
+                "q": c["q"][rows],
+                "index_q": c["index_q"][rows],
+                "index_w": c["kw"][rows, D:],
+                "gate": c["gate"][rows],
+            }
+        return record
+
+    def _check_plain_stages(self, x, c) -> None:
+        """Which tensor feeds which stage, and that each stage is what the
+        reference takes it for (same operation on the same batch)."""
+        layer, eps = self.layer, self.text.rms_norm_eps
+
+        def close(name, want, rtol=0.01, atol=2e-3):
+            torch.testing.assert_close(
+                c[name].float(),
+                want.float(),
+                rtol=rtol,
+                atol=atol,
+                msg=lambda m: f"{name}: {m}",
+            )
+
+        assert set(c) == {"qkv", "q_norm", "kv_norm", "q", "index_q", "kw", "gate"}
+        close("qkv", F.linear(x, layer.fused_qkv_a_proj.weight))
+        q_c, kv_c, _ = c["qkv"].split([1536, 512, 64], dim=-1)
+        # A bf16 unit in the last place (2^-8 relative) from the order of products.
+        close("q_norm", self._rms(q_c, layer.q_a_layernorm.weight, eps))
+        close("kv_norm", self._rms(kv_c, layer.kv_a_layernorm.weight, eps))
+        close("q", F.linear(c["q_norm"], layer.q_b_proj.weight))
+        # The indexer query reads the normed q_c; its key and weights the input.
+        close("index_q", F.linear(c["q_norm"], layer.dsa_indexer.wq_index.weight))
+        close("kw", F.linear(x, layer.dsa_indexer.wkv_index.weight))
+        close("gate", F.linear(x, layer.g_proj.weight))
+
+    # -- the reference ------------------------------------------------------
+
+    def reference(self, index: int, data: dict, selected=None) -> dict:
+        """Reference of the rows of request ``index`` in a step: the scores
+        of the indexer, the selected sets (or ``selected``, to score the
+        attention on given sets), the cached rows and keys of the whole
+        request, and the layer output."""
+        layer = self.layer
+        eps = self.text.rms_norm_eps
+        request = self.requests[index]
+        first = data["first"]
+        latent = torch.cat(request.latent)  # [length, 576]
+        length = latent.shape[0]
+        # Keys of every token, as cached: fp32 LayerNorm, bf16, per-key FP8.
+        norm = layer.dsa_indexer.k_index_norm
+        y = F.layer_norm(
+            torch.cat(request.index_k).float(), (D,), norm.weight, norm.bias, eps
+        )
+        y = y.to(torch.bfloat16).float()
+        k_scale = torch.exp2(
+            torch.ceil(torch.log2(y.abs().amax(-1).clamp(min=1e-4) / 448.0))
+        )
+        k_code = (y / k_scale[:, None]).to(torch.float8_e4m3fn)
+        # Queries of the step's rows: per head FP8, the scale folded into the
+        # head weight with 1 / sqrt(head_dim) / sqrt(heads).
+        rows = torch.arange(first, first + data["q"].shape[0], device=DEVICE)
+        iq = data["index_q"].view(-1, 32, D).float()
+        q_scale = torch.exp2(
+            torch.ceil(torch.log2(iq.abs().amax(-1).clamp(min=1e-10) / 448.0))
+        )
+        q_code = (iq / q_scale[..., None]).clamp(-448, 448).to(torch.float8_e4m3fn)
+        folded = data["index_w"].float() * q_scale
+        folded = folded * torch.tensor(D**-0.5 * 32**-0.5, device=DEVICE)
+        scores = torch.einsum(
+            "thd,nd->thn", q_code.float().double(), k_code.float().double()
+        ).relu_()
+        logits = (scores * folded.double()[..., None]).sum(1) * k_scale.double()
+        del scores
+        visible = torch.arange(length, device=DEVICE)[None, :] <= rows[:, None]
+        logits = logits.masked_fill(~visible, float("-inf"))
+
+        # Sparse attention on the latent rows: q_nope goes through W_UK (the
+        # absorbed half of kv_b_proj), the 64 other dims are plain.
+        kv_b = layer.kv_b_proj.weight.float().t().reshape(512, 48, 256)
+        w_uk, w_uv = kv_b[..., :128], kv_b[..., 128:]
+        q = data["q"].view(-1, 48, 192).float()
+        ql = torch.einsum("qnh,lnh->qnl", q[..., :128], w_uk)
+        q_mqa = torch.cat((ql, q[..., 128:]), dim=-1)  # [T, 48, 576]
+        keys = latent.float()
+        out = torch.empty((rows.numel(), 48, 128), device=DEVICE)
+        chosen_sets = []
+        scale = 192**-0.5
+        for i in range(rows.numel()):
+            count = int(rows[i]) + 1
+            if selected is not None:
+                chosen = selected[i]
+            elif count <= TOPK:
+                chosen = torch.arange(count, device=DEVICE)
+            else:
+                chosen = logits[i].topk(TOPK).indices
+            chosen_sets.append(chosen)
+            attn = torch.softmax((q_mqa[i] @ keys[chosen].T) * scale, dim=-1)
+            out[i] = torch.einsum("nl,lnv->nv", attn @ keys[chosen][:, :512], w_uv)
+        gated = (out.flatten(1) * data["gate"].float().sigmoid()).to(torch.bfloat16)
+        return {
+            "final": F.linear(gated, layer.o_proj.weight),
+            "logits": logits,
+            "selected": chosen_sets,
+            "latent": latent,
+            "k_bits": k_code.view(torch.uint8),
+            "k_scale": k_scale,
+        }
+
+    def cached(self, index: int):
+        """(latent rows, key bits, key scales) of a request, read back from
+        the bound caches through its page table."""
+        request = self.requests[index]
+        pos = torch.arange(request.length)
+        slots = torch.tensor(request.pages)[pos // BLOCK] * BLOCK + pos % BLOCK
+        page, off = (slots // BLOCK).to(DEVICE), (slots % BLOCK).to(DEVICE)
+        latent = self.mla.kv_cache[page, off]
+        bits, scale = sm80_dsa.index_cache_read_reference(
+            self.indexer.k_cache.kv_cache, slots.to(DEVICE), D
+        )
+        return latent, bits, scale
+
+
+def _compare_selected(got_row, chosen, logits_row, visible: int):
+    """The engine's top-k row against the reference set: (entries that
+    differ, their largest distance from the k-th reference score relative to
+    the row's largest magnitude). Structure is asserted here."""
+    keep = min(TOPK, visible)
+    got = got_row[:keep].long()
+    assert (got_row[keep:] == -1).all()
+    assert got.min() >= 0 and got.max() < visible
+    assert got.unique().numel() == keep
+    if visible <= TOPK:
+        assert torch.equal(got.sort().values, chosen.sort().values)
+        return 0, 0.0
+    scores = logits_row[:visible]
+    kth = scores[chosen].min()
+    differing = torch.cat(
+        (got[~torch.isin(got, chosen)], chosen[~torch.isin(chosen, got)])
+    )
+    if differing.numel() == 0:
+        return 0, 0.0
+    distance = (scores[differing] - kth).abs().max() / scores.abs().max()
+    return differing.numel() // 2, float(distance)
+
+
+def _check_step(harness, record: dict) -> dict:
+    """Every request of a step against its reference. Returns statistics."""
+    from vllm.config import CUDAGraphMode
+
+    out, topk = record["out"], record["topk"]
+    stats = {"rows": out.shape[0], "selected_rows": 0, "swapped": 0, "band": 0.0}
+    # A pure prefill the backend runs on dense MHA reads no top-k: the
+    # indexer writes its keys and leaves the rows at the insert's -1 fill.
+    scored = not sm80_dsa._skip_scoring(record["mla_metadata"], CUDAGraphMode.NONE)
+    stats["scored"] = scored
+    stats["route"] = getattr(
+        getattr(record["mla_metadata"].prefill, "route", None), "value", "decode"
+    )
+    if not scored:
+        assert (topk == -1).all()
+    worst, worst_on_engine_sets = 0.0, 0.0
+    for index, data in record["requests"].items():
+        ref = harness.reference(index, data)
+        rows, first = data["rows"], data["first"]
+        count = rows.stop - rows.start
+        got = out[rows].float()
+
+        # 1. The caches hold what the reference says, new tokens included.
+        got_latent, got_bits, got_scale = harness.cached(index)
+        assert torch.equal(got_latent, ref["latent"]), f"request {index}: latent cache"
+        assert torch.equal(got_scale, ref["k_scale"]), f"request {index}: key scales"
+        differs = got_bits != ref["k_bits"]
+        assert differs.float().mean().item() <= 1e-3, f"request {index}: key bytes"
+        delta = got_bits[differs].to(torch.int16) - ref["k_bits"][differs].to(
+            torch.int16
+        )
+        assert (delta.abs() == 1).all()
+
+        # 2. The selected sets.
+        engine_sets = []
+        for i in range(count):
+            visible = first + i + 1
+            stats["selected_rows"] += visible > TOPK
+            if scored:
+                swapped, distance = _compare_selected(
+                    topk[rows.start + i], ref["selected"][i], ref["logits"][i], visible
+                )
+                stats["swapped"] += swapped
+                stats["band"] = max(stats["band"], distance)
+                engine_sets.append(topk[rows.start + i, : min(TOPK, visible)].long())
+
+        # 3. The output: on the reference's own sets, and on the engine's
+        # sets (which takes the selection out of the comparison).
+        want = ref["final"].float()
+        rel = ((got - want).norm() / want.norm()).item()
+        worst = max(worst, rel)
+        if scored and stats["swapped"]:
+            again = harness.reference(index, data, selected=engine_sets)[
+                "final"
+            ].float()
+            rel_engine = ((got - again).norm() / again.norm()).item()
+        else:
+            rel_engine = rel
+        worst_on_engine_sets = max(worst_on_engine_sets, rel_engine)
+        stats["rel_l2"] = round(worst, 5)
+        stats["rel_l2_engine_sets"] = round(worst_on_engine_sets, 5)
+        # Sums of the two paths run in another order: an entry may differ
+        # only within 1e-5 of the k-th score (the tie rule in the module
+        # docstring).
+        assert stats["band"] <= 1e-5, f"request {index}: {stats}"
+        assert rel_engine < 0.02, f"request {index}: {stats}"
+        assert rel < 0.02, f"request {index}: {stats}"
+        # No element is far off either (bf16 noise has tails over 10^6 values).
+        torch.testing.assert_close(got, want, rtol=0.05, atol=0.15 * want.std().item())
+    print(f"step: {stats}")
+    return stats
+
+
+@pytest.fixture(params=[False, True], ids=["apart", "packed"])
+def harness(request, tmp_path, dist_init, workspace_init):
+    built = _Harness(tmp_path, request.param)
+    yield built
+    built.close()
