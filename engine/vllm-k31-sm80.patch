+def _decline(op_name: str, enabled_fn, reason: str) -> bool:
+    if enabled_fn():
+        log_decline_once(op_name, reason)
+    return False
+
+
+def can_use_attn_res(
+    prefix: torch.Tensor,
+    delta: torch.Tensor | None,
+    delta2: torch.Tensor | None,
+    blocks: torch.Tensor,
+    norm_weight: torch.Tensor,
+    qk_weight: torch.Tensor,
+    output_norm_weight: torch.Tensor | None,
+    num_blocks: int,
+    block_write_idx: int,
+) -> bool:
+    if not is_available():
+        return _decline("attn_res", attnres_enabled, "native extension unavailable")
+    if not _is_mocked() and not prefix.is_cuda:
+        return _decline("attn_res", attnres_enabled, f"prefix on non-CUDA device {prefix.device}")
+    if (
+        prefix.dtype != torch.bfloat16
+        or blocks.dtype != torch.bfloat16
+        or norm_weight.dtype != torch.bfloat16
+        or qk_weight.dtype != torch.bfloat16
+    ):
+        return _decline("attn_res", attnres_enabled, f"unsupported dtype prefix={prefix.dtype} blocks={blocks.dtype}")
+    if prefix.dim() != 2 or prefix.stride(1) != 1:
+        return _decline("attn_res", attnres_enabled, f"prefix shape/stride unsupported: shape={tuple(prefix.shape)}")
+    M, H = prefix.shape
+    if H <= 0 or (H % 8) != 0:
+        return _decline("attn_res", attnres_enabled, f"hidden_size={H} not positive multiple of 8")
+    if not (0 <= num_blocks <= ATTNRES_MAX_BLOCKS):
+        return _decline("attn_res", attnres_enabled, f"num_blocks={num_blocks} outside [0, {ATTNRES_MAX_BLOCKS}]")
+    if (
+        blocks.dim() != 3
+        or blocks.size(0) < M
+        or blocks.size(2) != H
+        or blocks.stride(2) != 1
+        or num_blocks > blocks.size(1)
+        or not (-1 <= block_write_idx < blocks.size(1))
+    ):
+        return _decline(
+            "attn_res",
+            attnres_enabled,
+            f"blocks shape/stride mismatch: blocks={tuple(blocks.shape)} num_blocks={num_blocks} write={block_write_idx}",
+        )
+    if (
+        norm_weight.numel() != H
+        or not norm_weight.is_contiguous()
+        or qk_weight.numel() != H
+        or not qk_weight.is_contiguous()
+    ):
+        return _decline("attn_res", attnres_enabled, "norm_weight or qk_weight shape/contiguity mismatch")
+    if delta2 is not None and delta is None:
+        return _decline("attn_res", attnres_enabled, "delta2 provided without delta")
+    if delta is not None and (
+        delta.dtype != torch.bfloat16
+        or delta.dim() != 2
+        or delta.shape != (M, H)
+        or delta.stride(1) != 1
+    ):
+        return _decline("attn_res", attnres_enabled, f"delta shape/dtype unsupported: {tuple(delta.shape)} {delta.dtype}")
+    if delta2 is not None and (
+        delta2.dtype != torch.bfloat16
+        or delta2.dim() != 2
+        or delta2.shape != (M, H)
+        or delta2.stride(1) != 1
+    ):
+        return _decline("attn_res", attnres_enabled, f"delta2 shape/dtype unsupported: {tuple(delta2.shape)} {delta2.dtype}")
+    if output_norm_weight is not None and (
+        output_norm_weight.dtype != torch.bfloat16
+        or output_norm_weight.numel() != H
+        or not output_norm_weight.is_contiguous()
+    ):
+        return _decline("attn_res", attnres_enabled, "output_norm_weight shape/dtype/contiguity mismatch")
+    return True
+
+
+def attn_res_rmsnorm(
+    prefix: torch.Tensor,
+    delta: torch.Tensor | None,
+    delta2: torch.Tensor | None,
+    blocks: torch.Tensor,
+    norm_weight: torch.Tensor,
+    qk_weight: torch.Tensor,
+    output_norm_weight: torch.Tensor | None,
+    num_blocks: int,
+    block_write_idx: int,
+    eps: float,
+    output_norm_eps: float,
+) -> torch.Tensor:
+    return _attn_res_rmsnorm_op(
+        prefix,
+        delta,
+        delta2,
+        blocks,
