+def _make_processor(monkeypatch, head_dtype: torch.dtype | None) -> LogitsProcessor:
+    fake_vllm_cfg = SimpleNamespace(
+        model_config=SimpleNamespace(head_dtype=head_dtype)
+    )
+    monkeypatch.setattr(
+        "vllm.model_executor.layers.logits_processor.get_current_vllm_config",
+        lambda: fake_vllm_cfg,
+    )
+    lp = LogitsProcessor(vocab_size=256)
+    Exl3HeadLogitsProcessor.adopt(lp)
+    return lp
