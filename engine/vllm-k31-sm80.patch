+    assert envs.VLLM_K31_GLUE_ATTNRES is False
+    assert envs.VLLM_K31_GLUE_KDA is False
+    assert envs.VLLM_K31_GLUE_ROUTER is False
+    assert envs.VLLM_K31_GLUE_GEMV is False
+    assert not glue.attnres_enabled()
+    assert not glue.kda_enabled()
+    assert not glue.router_enabled()
+    assert not glue.gemv_enabled()
