+int64_t router_workspace_size(int64_t max_rows, int64_t num_experts) {
+  TORCH_CHECK(max_rows >= 1, "max_rows must be >= 1");
+  TORCH_CHECK(num_experts >= 1 && num_experts <= kMaxRouterExperts,
+              "num_experts must be in [1, 1024]");
+  int64_t chunk_rows = max_rows > 16 ? 16 : max_rows;
+  return static_cast<int64_t>(kRouterHeaderFloats) + 2 * chunk_rows * num_experts;
+}
+
+void attn_res_rmsnorm(
+    at::Tensor prefix,
+    const std::optional<at::Tensor>& delta,
+    const std::optional<at::Tensor>& delta2,
+    at::Tensor blocks,
+    const at::Tensor& norm_weight,
+    const at::Tensor& qk_weight,
+    const std::optional<at::Tensor>& output_norm_weight,
+    at::Tensor out,
+    int64_t num_blocks,
+    int64_t block_write_idx,
+    double eps,
+    double output_norm_eps) {
+  TORCH_CHECK(prefix.is_cuda() && prefix.scalar_type() == at::kBFloat16, "prefix must be CUDA BF16");
+  TORCH_CHECK(prefix.dim() == 2 && prefix.stride(1) == 1, "prefix must be [M, H] with stride(-1)==1");
+  const int64_t M = prefix.size(0);
+  const int64_t H = prefix.size(1);
+  if (M == 0) return;
+
+  TORCH_CHECK(H % 8 == 0, "hidden_size must be a multiple of 8");
+  TORCH_CHECK(num_blocks >= 0 && num_blocks <= kMaxAttnResBlocks, "num_blocks must be in [0, 8]");
+  TORCH_CHECK(blocks.is_cuda() && blocks.scalar_type() == at::kBFloat16 && blocks.dim() == 3,
+              "blocks must be CUDA BF16 [M, max_blocks, H]");
+  TORCH_CHECK(blocks.size(0) >= M && blocks.size(2) == H && blocks.stride(2) == 1,
+              "blocks shape/stride mismatch");
+  TORCH_CHECK(block_write_idx >= -1 && block_write_idx < blocks.size(1),
+              "block_write_idx out of range");
+  TORCH_CHECK(num_blocks <= blocks.size(1), "num_blocks exceeds blocks.size(1)");
+  TORCH_CHECK(norm_weight.is_cuda() && norm_weight.scalar_type() == at::kBFloat16 &&
+                  norm_weight.numel() == H && norm_weight.is_contiguous(),
+              "norm_weight must be contiguous CUDA BF16 [H]");
+  TORCH_CHECK(qk_weight.is_cuda() && qk_weight.scalar_type() == at::kBFloat16 &&
+                  qk_weight.numel() == H && qk_weight.is_contiguous(),
+              "qk_weight must be contiguous CUDA BF16 [H]");
+  TORCH_CHECK(out.is_cuda() && out.scalar_type() == at::kBFloat16 &&
+                  out.dim() == 2 && out.size(0) == M && out.size(1) == H && out.stride(1) == 1,
+              "out must be CUDA BF16 [M, H] with stride(-1)==1");
+
+  const bool has_delta = delta.has_value() && delta->defined();
+  const bool has_delta2 = delta2.has_value() && delta2->defined();
+  const bool write_block = block_write_idx >= 0;
+  const bool apply_out_norm = output_norm_weight.has_value() && output_norm_weight->defined();
+  TORCH_CHECK(!has_delta2 || has_delta, "delta2 requires delta");
+
+  const __nv_bfloat16* delta_ptr = nullptr;
+  int64_t sd = 0;
+  if (has_delta) {
+    TORCH_CHECK(delta->is_cuda() && delta->scalar_type() == at::kBFloat16 &&
+                    delta->dim() == 2 && delta->size(0) == M && delta->size(1) == H &&
+                    delta->stride(1) == 1,
+                "delta shape/dtype mismatch");
+    delta_ptr = reinterpret_cast<const __nv_bfloat16*>(delta->data_ptr());
+    sd = delta->stride(0);
+  }
+  const __nv_bfloat16* delta2_ptr = nullptr;
+  int64_t sd2 = 0;
+  if (has_delta2) {
+    TORCH_CHECK(delta2->is_cuda() && delta2->scalar_type() == at::kBFloat16 &&
+                    delta2->dim() == 2 && delta2->size(0) == M && delta2->size(1) == H &&
+                    delta2->stride(1) == 1,
+                "delta2 shape/dtype mismatch");
+    delta2_ptr = reinterpret_cast<const __nv_bfloat16*>(delta2->data_ptr());
+    sd2 = delta2->stride(0);
+  }
+  const __nv_bfloat16* out_nw_ptr = nullptr;
+  if (apply_out_norm) {
+    TORCH_CHECK(output_norm_weight->is_cuda() &&
+                    output_norm_weight->scalar_type() == at::kBFloat16 &&
+                    output_norm_weight->numel() == H && output_norm_weight->is_contiguous(),
+                "output_norm_weight shape/dtype mismatch");
+    out_nw_ptr = reinterpret_cast<const __nv_bfloat16*>(output_norm_weight->data_ptr());
+  }
+
+  const c10::cuda::CUDAGuard device_guard(prefix.device());
+  cudaStream_t stream = at::cuda::getCurrentCUDAStream();
+
+  auto* p_ptr = reinterpret_cast<__nv_bfloat16*>(prefix.data_ptr());
+  auto* b_ptr = reinterpret_cast<__nv_bfloat16*>(blocks.data_ptr());
+  auto* nw_ptr = reinterpret_cast<const __nv_bfloat16*>(norm_weight.data_ptr());
+  auto* qk_ptr = reinterpret_cast<const __nv_bfloat16*>(qk_weight.data_ptr());
+  auto* o_ptr = reinterpret_cast<__nv_bfloat16*>(out.data_ptr());
+
+  TORCH_CHECK(is_aligned_16(p_ptr) && (prefix.stride(0) % 8 == 0),
+              "prefix must be 16-byte aligned with row stride multiple of 8");
+  TORCH_CHECK(is_aligned_16(b_ptr) && (blocks.stride(0) % 8 == 0) && (blocks.stride(1) % 8 == 0),
+              "blocks must be 16-byte aligned with strides multiple of 8");
+  TORCH_CHECK(is_aligned_16(nw_ptr) && is_aligned_16(qk_ptr),
+              "norm_weight and qk_weight must be 16-byte aligned");
+  TORCH_CHECK(is_aligned_16(o_ptr) && (out.stride(0) % 8 == 0),
+              "out must be 16-byte aligned with row stride multiple of 8");
+  if (has_delta) {
+    TORCH_CHECK(is_aligned_16(delta_ptr) && (sd % 8 == 0),
+                "delta must be 16-byte aligned with row stride multiple of 8");
+  }
+  if (has_delta2) {
+    TORCH_CHECK(is_aligned_16(delta2_ptr) && (sd2 % 8 == 0),
+                "delta2 must be 16-byte aligned with row stride multiple of 8");
+  }
+  if (apply_out_norm) {
+    TORCH_CHECK(is_aligned_16(out_nw_ptr), "output_norm_weight must be 16-byte aligned");
+  }
+
+  const float eps_f = static_cast<float>(eps);
+  const float out_eps_f = static_cast<float>(output_norm_eps);
+
+  const int mode = (has_delta ? 1 : 0) | (has_delta2 ? 2 : 0) |
+                   (write_block ? 4 : 0) | (apply_out_norm ? 8 : 0);
+
+#define DISPATCH_AR(HD, HD2, WB, AON)                                                            \
+  launch_attn_res_impl<HD, HD2, WB, AON>(                                                        \
+      p_ptr, delta_ptr, delta2_ptr, b_ptr, nw_ptr, qk_ptr, out_nw_ptr, o_ptr,                    \
+      static_cast<int>(M), static_cast<int>(H), prefix.stride(0), sd, sd2,                       \
+      blocks.stride(0), blocks.stride(1), out.stride(0),                                         \
+      static_cast<int>(num_blocks), static_cast<int>(block_write_idx), eps_f, out_eps_f, stream)
+
+  switch (mode) {
+    case 0:  DISPATCH_AR(false, false, false, false); break;
+    case 1:  DISPATCH_AR(true,  false, false, false); break;
+    case 3:  DISPATCH_AR(true,  true,  false, false); break;
+    case 4:  DISPATCH_AR(false, false, true,  false); break;
+    case 5:  DISPATCH_AR(true,  false, true,  false); break;
+    case 7:  DISPATCH_AR(true,  true,  true,  false); break;
+    case 8:  DISPATCH_AR(false, false, false, true);  break;
+    case 9:  DISPATCH_AR(true,  false, false, true);  break;
+    case 11: DISPATCH_AR(true,  true,  false, true);  break;
+    case 12: DISPATCH_AR(false, false, true,  true);  break;
+    case 13: DISPATCH_AR(true,  false, true,  true);  break;
+    case 15: DISPATCH_AR(true,  true,  true,  true);  break;
+    default: TORCH_CHECK(false, "Invalid attn_res flag combination");
+  }
+#undef DISPATCH_AR
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void fused_router_gemv_topk(
+    const at::Tensor& x,
+    const at::Tensor& w_gate,
+    const at::Tensor& bias,
+    int64_t top_k,
+    bool renormalize,
+    double routed_scaling_factor,
+    at::Tensor topk_weights,
+    at::Tensor topk_ids,
+    at::Tensor workspace) {
+  TORCH_CHECK(x.is_cuda() && x.scalar_type() == at::kBFloat16 && x.dim() == 2 && x.is_contiguous(),
+              "x must be contiguous CUDA BF16 [M, K]");
+  TORCH_CHECK(w_gate.is_cuda() && w_gate.scalar_type() == at::kBFloat16 &&
+                  w_gate.dim() == 2 && w_gate.is_contiguous(),
+              "w_gate must be contiguous CUDA BF16 [E, K]");
+  const int64_t M_total = x.size(0);
+  const int64_t K = x.size(1);
+  const int64_t E = w_gate.size(0);
+  if (M_total == 0) return;
+
+  TORCH_CHECK(w_gate.size(1) == K && (K % 8 == 0), "w_gate K mismatch or not multiple of 8");
+  TORCH_CHECK(E >= 1 && E <= kMaxRouterExperts, "num_experts must be in [1, 1024]");
+  TORCH_CHECK(top_k >= 1 && top_k <= 32 && top_k <= E, "top_k must be in [1, min(32, E)]");
+  TORCH_CHECK(bias.is_cuda() && bias.scalar_type() == at::kFloat &&
+                  bias.numel() == E && bias.is_contiguous(),
+              "bias must be contiguous CUDA FP32 [E]");
+  TORCH_CHECK(topk_weights.is_cuda() && topk_weights.scalar_type() == at::kFloat &&
+                  topk_weights.dim() == 2 && topk_weights.size(0) == M_total &&
+                  topk_weights.size(1) == top_k && topk_weights.is_contiguous(),
+              "topk_weights must be contiguous CUDA FP32 [M, top_k]");
+  TORCH_CHECK(topk_ids.is_cuda() && topk_ids.scalar_type() == at::kInt &&
+                  topk_ids.dim() == 2 && topk_ids.size(0) == M_total &&
+                  topk_ids.size(1) == top_k && topk_ids.is_contiguous(),
+              "topk_ids must be contiguous CUDA INT32 [M, top_k]");
+  const int64_t need_ws = router_workspace_size(M_total, E);
+  TORCH_CHECK(workspace.is_cuda() && workspace.scalar_type() == at::kFloat &&
+                  workspace.numel() >= need_ws && workspace.is_contiguous(),
+              "workspace too small or wrong dtype");
+
+  const c10::cuda::CUDAGuard device_guard(x.device());
+  cudaStream_t stream = at::cuda::getCurrentCUDAStream();
+
+  const int num_ctas = static_cast<int>((E + 7) / 8);
+  const float scale_f = static_cast<float>(routed_scaling_factor);
+
+  const auto* x_base = reinterpret_cast<const __nv_bfloat16*>(x.data_ptr());
+  const auto* w_base = reinterpret_cast<const __nv_bfloat16*>(w_gate.data_ptr());
+  const auto* b_base = bias.data_ptr<float>();
+  auto* ow_base = topk_weights.data_ptr<float>();
+  auto* oi_base = topk_ids.data_ptr<int32_t>();
+  auto* ws_base = workspace.data_ptr<float>();
+
+  TORCH_CHECK(is_aligned_16(x_base) && is_aligned_16(w_base) && is_aligned_16(ws_base),
+              "x, w_gate, and workspace must be 16-byte aligned");
+  // Zero arrival counter asynchronously on current stream (CUDA-Graph safe) so a
+  // fresh or previously faulted workspace can never stall or misfire top-k.
+  TORCH_CHECK(cudaMemsetAsync(ws_base, 0, sizeof(int32_t), stream) == cudaSuccess,
+              "cudaMemsetAsync failed for router arrival counter");
+
+  for (int64_t m0 = 0; m0 < M_total; m0 += 16) {
+    const int M = static_cast<int>(std::min<int64_t>(16, M_total - m0));
+    const auto* xm = x_base + m0 * K;
+    auto* owm = ow_base + m0 * top_k;
+    auto* oim = oi_base + m0 * top_k;
+    k31_fused_router_gemv_topk_mma_kernel<<<num_ctas, 256, 0, stream>>>(
+        xm, w_base, b_base, M, static_cast<int>(K), static_cast<int>(E),
+        static_cast<int>(top_k), renormalize, scale_f, owm, oim, ws_base, num_ctas);
+  }
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void moe_topk_sigmoid(
+    const at::Tensor& logits,
+    const at::Tensor& bias,
+    int64_t top_k,
+    bool renormalize,
+    double routed_scaling_factor,
+    at::Tensor topk_weights,
+    at::Tensor topk_ids) {
+  TORCH_CHECK(logits.is_cuda() && logits.scalar_type() == at::kFloat &&
+                  logits.dim() == 2 && logits.is_contiguous(),
+              "logits must be contiguous CUDA FP32 [M, E]");
+  const int64_t M = logits.size(0);
+  const int64_t E = logits.size(1);
+  if (M == 0) return;
+  TORCH_CHECK(E >= 1 && E <= kMaxRouterExperts, "E must be in [1, 1024]");
+  TORCH_CHECK(top_k >= 1 && top_k <= 32 && top_k <= E, "top_k must be in [1, min(32, E)]");
+  TORCH_CHECK(bias.is_cuda() && bias.scalar_type() == at::kFloat &&
+                  bias.numel() == E && bias.is_contiguous(),
+              "bias must be contiguous CUDA FP32 [E]");
+  TORCH_CHECK(topk_weights.is_cuda() && topk_weights.scalar_type() == at::kFloat &&
+                  topk_weights.size(0) == M && topk_weights.size(1) == top_k &&
+                  topk_weights.is_contiguous(),
+              "topk_weights shape/dtype mismatch");
+  TORCH_CHECK(topk_ids.is_cuda() && topk_ids.scalar_type() == at::kInt &&
+                  topk_ids.size(0) == M && topk_ids.size(1) == top_k &&
+                  topk_ids.is_contiguous(),
+              "topk_ids shape/dtype mismatch");
+
+  const c10::cuda::CUDAGuard device_guard(logits.device());
+  cudaStream_t stream = at::cuda::getCurrentCUDAStream();
+
+  k31_moe_topk_sigmoid_warp_kernel<<<static_cast<int>(M), 256, 0, stream>>>(
+      logits.data_ptr<float>(),
+      bias.data_ptr<float>(),
+      static_cast<int>(E),
+      static_cast<int>(top_k),
+      renormalize,
+      static_cast<float>(routed_scaling_factor),
+      topk_weights.data_ptr<float>(),
+      topk_ids.data_ptr<int32_t>());
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
