+def run_router_check(mini: Path) -> dict[str, Any]:
+    from vllm.model_executor.layers.fused_moe.router import grouped_topk_router as gtr
+
+    device = torch.device("cuda:0")
+    l1_mlp_in, l1_out = gpu.tensors(
+        mini / "ref_acts.safetensors", "L1.mlp_in.q", "L1.out.q", device=device
+    )
+    records: list[dict[str, Any]] = []
+    min_match = 1.0
+    max_w_rel = 0.0
+
+    for lid, act in ((1, l1_mlp_in), (3, l1_out)):
+        w_gate = _load_layer_plain(mini, lid, "block_sparse_moe.gate.weight", device).contiguous()
+        bias = _load_layer_plain(mini, lid, "block_sparse_moe.gate.e_score_correction_bias", device).contiguous()
+        for M in (1, 4, 8, 16, 64):
+            xm = act[:M].contiguous()
+            logits = F.linear(xm.float(), w_gate.float()).contiguous()
+            ref_w, ref_i = ref_moe_topk_sigmoid(logits, bias, 16, True, 1.0)
+            with _glue_switches(VLLM_K31_GLUE_ROUTER=1):
+                got_w, got_i = gtr.grouped_topk(
+                    xm,
+                    logits,
+                    topk=16,
+                    renormalize=True,
+                    num_expert_group=1,
+                    topk_group=1,
+                    scoring_func="sigmoid",
+                    routed_scaling_factor=1.0,
+                    e_score_correction_bias=bias,
+                )
+            exact_matches = int((got_i == ref_i).sum().item())
+            total = int(ref_i.numel())
+            match_rate = exact_matches / total
+            w_rel = _rel_l2(got_w, ref_w)
+            assert match_rate >= BOUND_ROUTER_TOPK_MATCH, f"L{lid} M={M}: match={match_rate}"
+            assert w_rel <= BOUND_ROUTER_WEIGHT_REL_L2, f"L{lid} M={M}: w_rel={w_rel}"
+            min_match = min(min_match, match_rate)
+            max_w_rel = max(max_w_rel, w_rel)
+            records.append(
+                {
+                    "layer": lid,
+                    "M": M,
+                    "exact_id_match": match_rate,
+                    "weight_rel_l2": w_rel,
+                }
+            )
+
+    return {
+        "bound_topk_match": BOUND_ROUTER_TOPK_MATCH,
+        "bound_weight_rel_l2": BOUND_ROUTER_WEIGHT_REL_L2,
+        "min_topk_match": min_match,
+        "max_weight_rel_l2": max_w_rel,
+        "cases": records,
+    }
