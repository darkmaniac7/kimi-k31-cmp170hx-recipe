+def _cpu_post_load(monkeypatch):
+    from vllm.sm80.kernels.exl3 import ops as exl3_ops
+    from vllm.sm80.kernels.exl3.quant import Exl3PackedWeight
+
+    monkeypatch.setattr(exl3_ops, "linear_row_chunk", lambda padded_in, out: 1 << 20)
+    monkeypatch.setattr(
+        Exl3PackedWeight,
+        "parameters",
