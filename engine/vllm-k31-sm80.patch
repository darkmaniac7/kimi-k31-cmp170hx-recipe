@@ -0,0 +1,634 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""EXL3 K6 quantization, manifest, layout, and loader for Qwen3 DSpark drafters.
+
+Activated strictly behind ``VLLM_DSPARK_EXL3_K6=1`` (default 0 leaves Qwen3
+DSpark on the stock BF16 path). Routes all 37 large 128-aligned DSpark linear
+matrices (``fc``, 5 layers of fused ``qkv_proj`` [3-member] / ``o_proj`` /
+``gate_up_proj`` [2-member] / ``down_proj``, and full-vocabulary replicated
+``markov_head.markov_w2``) through ``K31DenseLinearMethod`` and
+``_k31_dense_C.linear_out_k31_multi``, while sharing the target's EXL3 K6
+``lm_head`` and keeping all RMSNorms, ``markov_w1``, and
+``confidence_head.proj`` in plain BF16/FP32.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+import threading
+import time
+from collections import Counter
+from contextlib import ExitStack, contextmanager
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Literal
+
+import torch
+from safetensors import safe_open
+from torch import nn
+
+import vllm.envs as envs
+from vllm.config import get_current_vllm_config, get_current_vllm_config_or_none
+from vllm.distributed import get_tensor_model_parallel_rank
+from vllm.logger import init_logger
+from vllm.model_executor.layers.linear import (
+    LinearBase,
+    UnquantizedLinearMethod,
+)
+from vllm.model_executor.layers.vocab_parallel_embedding import ParallelLMHead
+from vllm.sm80.kernels.exl3.layout import Exl3Layout
+from vllm.sm80.kernels.exl3.quant import Exl3Config, Exl3LinearMethod
+from vllm.sm80.kernels.exl3.utils import (
+    Exl3LoadLedger,
+    Exl3Manifest,
+    PackedMatrix,
+    TensorHeader,
+    _unique_object,
+    read_headers,
+)
+from vllm.sm80.kernels.k31q.manifest import EXL3, PLAIN, _with_markers
+from vllm.sm80.kernels.k31q.quant import (
+    K31DenseLinearMethod,
+    _require_supported_gpu,
+)
+
+logger = init_logger(__name__)
+
+DSPARK_EXL3_QUANT_METHOD = "k31q_dspark_exl3"
+DSPARK_EXL3_MANIFEST_NAME = "k31q_dspark_manifest.json"
+DSPARK_EXL3_FORMAT_VERSION = 1
+DSPARK_EXL3_BITS = 6
+DSPARK_EXL3_BITS_X2 = 12
+DSPARK_EXL3_CODEBOOK = 2  # mul1
+
+_PACKED_SUFFIXES = (".trellis", ".suh", ".svh", ".mcg", ".mul1")
+_LAYER_PREFIX_RE = re.compile(r"^layers\.(\d+)\.(.+)$")
+
+# Parameters intentionally left unloaded in a target-shared DSpark checkpoint
+# (bound from the target model by load_dspark_model, or unused placeholders).
+_SHARED_OR_PLACEHOLDER_PARAMS = frozenset(
+    {
+        "lm_head.weight",
+        "model.embed_tokens.weight",
+        "model.mask_embedding",
+        "draft_id_to_target_id",
+    }
+)
+
+_OFFSET_STATE = threading.local()
+
+
+@contextmanager
+def draft_layer_offset(start_layer_id: int):
+    """Bind the active Qwen3 DSpark ``start_layer_id`` during model init."""
+    stack: list[int] | None = getattr(_OFFSET_STATE, "stack", None)
+    if stack is None:
+        stack = []
+        _OFFSET_STATE.stack = stack
+    stack.append(int(start_layer_id))
+    try:
+        yield
+    finally:
+        stack.pop()
+
+
+def current_draft_layer_offset() -> int | None:
+    stack: list[int] | None = getattr(_OFFSET_STATE, "stack", None)
+    return stack[-1] if stack else None
+
+
+def _require_dspark_k6_enabled() -> None:
+    if not envs.VLLM_DSPARK_EXL3_K6:
+        raise ValueError(
+            f"Checkpoint uses quantization method {DSPARK_EXL3_QUANT_METHOD!r} "
+            "(EXL3 K6 DSpark), which is switch-gated behind "
+            "VLLM_DSPARK_EXL3_K6=1 (default 0 leaves DSpark on stock BF16)."
+        )
+
+
+def _refuse_draft_topk(hf_config: Any) -> None:
+    topk = getattr(hf_config, "dspark_draft_topk", None) if hf_config is not None else None
+    if topk is not None:
+        raise ValueError(
+            f"{DSPARK_EXL3_QUANT_METHOD} requires full-vocabulary EXL3 K6 "
+            f"markov_w2 and does not support dspark_draft_topk={topk!r} "
+            "(top-k pre-filtering degrades MASK-position acceptance)."
+        )
+
+
+class K31DSparkManifest(Exl3Manifest):
+    """CPU-only inventory of a ``k31q_dspark_exl3`` DSpark checkpoint directory.
+
+    Reads ``k31q_dspark_manifest.json`` and the safetensors headers of its
+    weight file without touching tensor payloads. Validates that every
+    quantized matrix is EXL3 K6 (``bits_x2=12``, codebook ``mul1``) and every
+    plain tensor listed by the manifest exists.
+    """
+
+    def __init__(self, directory: str | Path):
+        directory = Path(directory)
+        manifest_path = directory / DSPARK_EXL3_MANIFEST_NAME
+        if not manifest_path.is_file():
+            raise ValueError(
+                f"{DSPARK_EXL3_QUANT_METHOD} checkpoint without "
+                f"{DSPARK_EXL3_MANIFEST_NAME}: {directory}"
+            )
+        self.meta = json.loads(
+            manifest_path.read_text(encoding="utf-8"), object_pairs_hook=_unique_object
+        )
+        if (
+            self.meta.get("format") != DSPARK_EXL3_QUANT_METHOD
+            or self.meta.get("version") != DSPARK_EXL3_FORMAT_VERSION
+        ):
+            raise ValueError(
+                f"Unsupported {DSPARK_EXL3_QUANT_METHOD} manifest: "
+                f"format={self.meta.get('format')!r} version={self.meta.get('version')!r}"
+            )
+        if self.meta.get("bits") != DSPARK_EXL3_BITS:
+            raise ValueError(
+                f"{DSPARK_EXL3_QUANT_METHOD} requires bits={DSPARK_EXL3_BITS}, "
+                f"manifest has {self.meta.get('bits')!r}"
+            )
+        if not self.meta.get("full_vocab_markov", True):
+            raise ValueError(
+                f"{DSPARK_EXL3_QUANT_METHOD} requires full_vocab_markov=true"
+            )
+
+        weight_file_name = self.meta.get("file", "model.safetensors")
+        weight_path = directory / weight_file_name
+        if not weight_path.is_file():
+            raise ValueError(
+                f"{DSPARK_EXL3_QUANT_METHOD} weight file missing: {weight_path}"
+            )
+        expected_bytes = self.meta.get("bytes")
+        actual_bytes = weight_path.stat().st_size
+        if expected_bytes and actual_bytes != expected_bytes:
+            raise ValueError(
+                f"{DSPARK_EXL3_QUANT_METHOD} {weight_file_name}: file holds "
+                f"{actual_bytes} bytes, manifest says {expected_bytes}"
+            )
+
+        self.directory = directory
+        self.weight_path = weight_path
+        self.tensors: dict[str, TensorHeader] = {}
+        self.matrices: dict[str, PackedMatrix] = {}
+        self.unused: dict[str, str] = {}
+        self.unselected = 0
+        self.ple_tables: dict = {}
+
+        for name, header in _with_markers(
+            weight_path, read_headers(weight_path)
+        ).items():
+            if name in self.tensors:
+                raise ValueError(f"Duplicate DSpark EXL3 tensor: {name}")
+            self.tensors[name] = header
+        self.tensors = dict(sorted(self.tensors.items()))
+
+        for name, header in self.tensors.items():
+            if name.endswith(".trellis"):
+                prefix = name.removesuffix(".trellis")
+                matrix = self._matrix(prefix, header)
+                if (
+                    matrix.bits_x2 != DSPARK_EXL3_BITS_X2
+                    or matrix.codebook != DSPARK_EXL3_CODEBOOK
+                ):
+                    raise ValueError(
+                        f"{DSPARK_EXL3_QUANT_METHOD} matrix {prefix}: expected "
+                        f"K6 mul1 (bits_x2=12, codebook=2), got "
+                        f"bits_x2={matrix.bits_x2}, codebook={matrix.codebook}"
+                    )
+                self.matrices[prefix] = matrix
+
+        packed_keys = {k for matrix in self.matrices.values() for k in matrix.keys}
+        for name in self.tensors:
+            if name.endswith((".suh", ".svh", ".mcg", ".mul1")) and name not in packed_keys:
+                raise ValueError(f"Orphan EXL3 quantization tensor: {name}")
+
+        declared_quant = self.meta.get("quantized_matrices", {})
+        if not isinstance(declared_quant, dict) or not declared_quant:
+            raise ValueError(
+                f"{DSPARK_EXL3_QUANT_METHOD} manifest lists no quantized_matrices"
+            )
+        for prefix, spec in declared_quant.items():
+            matrix = self.matrices.get(prefix)
+            if matrix is None:
+                raise ValueError(
+                    f"{DSPARK_EXL3_QUANT_METHOD} matrix missing from safetensors: {prefix}"
+                )
+            shape = spec.get("shape")
+            if shape is not None:
+                matrix.validate_logical(int(shape[1]), int(shape[0]))
+        extra_matrices = sorted(set(self.matrices) - set(declared_quant))
+        if extra_matrices:
+            raise ValueError(
+                f"{DSPARK_EXL3_QUANT_METHOD} undeclared EXL3 matrices: {extra_matrices[:8]}"
+            )
+
+        for plain_name in self.meta.get("plain_tensors", ()):
+            if plain_name not in self.tensors:
+                raise ValueError(
+                    f"{DSPARK_EXL3_QUANT_METHOD} plain tensor missing: {plain_name}"
+                )
+
+
+class K31DSparkLayout(Exl3Layout):
+    """Checkpoint name mapping for Qwen3 DSpark draft modules."""
+
+    def __init__(self, hf_config=None, start_layer_id: int | None = None):
+        super().__init__(hf_config)
+        self.start_layer_id = start_layer_id
+        self.num_hidden_layers = int(getattr(hf_config, "num_hidden_layers", 5) or 5)
+
+    def set_layer_offset(self, start_layer_id: int) -> None:
+        self.start_layer_id = int(start_layer_id)
+
+    def check_manifest(self, manifest) -> None:
+        if not isinstance(manifest, K31DSparkManifest):
+            raise ValueError("K31DSparkLayout reads K31DSparkManifest instances")
+
+    def _effective_start_layer_id(self, layer_idx: int) -> int:
+        active = current_draft_layer_offset()
+        if active is not None:
+            return active
+        if self.start_layer_id is not None:
+            return self.start_layer_id
+        if layer_idx >= self.num_hidden_layers:
+            vllm_cfg = get_current_vllm_config_or_none()
+            if vllm_cfg is not None and vllm_cfg.model_config is not None:
+                target_layers = int(
+                    vllm_cfg.model_config.get_total_num_hidden_layers()
+                )
+                if 0 <= layer_idx - target_layers < self.num_hidden_layers:
+                    return target_layers
+        return 0
+
+    def source_prefix(self, config, prefix: str) -> str:
+        has_model_prefix = prefix.startswith("model.")
+        name = prefix.removeprefix("model.") if has_model_prefix else prefix
+        match = _LAYER_PREFIX_RE.match(name)
+        if match is not None:
+            global_idx = int(match.group(1))
+            rest = match.group(2)
+            offset = self._effective_start_layer_id(global_idx)
+            # If already normalized to checkpoint-local layer indices
+            # (no "model." prefix and global_idx < offset), preserve idempotence.
+            if not has_model_prefix and 0 <= global_idx < self.num_hidden_layers and global_idx < offset:
+                return f"layers.{global_idx}.{rest}"
+            local_idx = global_idx - offset
+            if local_idx < 0:
+                raise ValueError(
+                    f"{DSPARK_EXL3_QUANT_METHOD}: layer index {global_idx} is below "
+                    f"draft start_layer_id={offset} for module {prefix!r}"
+                )
+            return f"layers.{local_idx}.{rest}"
+        return name
+
+    def members(self, config, leaf: str, source: str, outputs: int):
+        if leaf == "qkv_proj":
+            return ["q_proj", "k_proj", "v_proj"]
+        if leaf == "gate_up_proj":
+            return ["gate_proj", "up_proj"]
+        return None
+
+    def is_draft(self, model_config) -> bool:
+        return True
+
+
+class K31DSparkExl3Config(Exl3Config):
+    """Registered as ``k31q_dspark_exl3`` by ``vllm/sm80/plugin.py``.
+
+    Switch-gated behind ``VLLM_DSPARK_EXL3_K6=1``. When enabled, routes all
+    EXL3 K6 DSpark linear layers and ``markov_w2`` through
+    :class:`K31DenseLinearMethod` (``_k31_dense_C.linear_out_k31_multi``),
+    keeps ``confidence_head.proj`` and norms plain, and leaves ``lm_head``
+    unquantized so ``share_target_lm_head`` binds the target's EXL3 K6 head.
+    """
+
+    def __init__(self, bits: int = DSPARK_EXL3_BITS):
+        super().__init__(None)
+        self.bits = int(bits)
+        self.layout: K31DSparkLayout = K31DSparkLayout()
+
+    @classmethod
+    def get_name(cls) -> Literal["k31q_dspark_exl3"]:
+        return "k31q_dspark_exl3"
+
+    @classmethod
+    def override_quantization_method(cls, hf_quant_cfg, user_quant, hf_config=None):
+        if (
+            hf_quant_cfg.get("quant_method") == DSPARK_EXL3_QUANT_METHOD
+            or user_quant == DSPARK_EXL3_QUANT_METHOD
+        ):
+            _require_dspark_k6_enabled()
+            _refuse_draft_topk(hf_config)
+            from vllm.platforms import current_platform
+
+            if not current_platform.is_cuda():
+                raise ValueError(
+                    f"{DSPARK_EXL3_QUANT_METHOD} execution requires the NVIDIA CUDA platform"
+                )
+        return None
+
+    @classmethod
+    def from_config(cls, config: dict[str, Any]) -> "K31DSparkExl3Config":
+        version = config.get("version", DSPARK_EXL3_FORMAT_VERSION)
+        if version != DSPARK_EXL3_FORMAT_VERSION:
+            raise ValueError(
+                f"Unsupported {DSPARK_EXL3_QUANT_METHOD} version: {version!r}"
+            )
+        bits = int(config.get("bits", DSPARK_EXL3_BITS))
+        if bits != DSPARK_EXL3_BITS:
+            raise ValueError(
+                f"{DSPARK_EXL3_QUANT_METHOD} supports bits={DSPARK_EXL3_BITS} only, "
+                f"got {bits!r}"
+            )
+        return cls(bits=bits)
+
+    def maybe_update_config(self, model_name, hf_config=None, revision=None):
+        _require_dspark_k6_enabled()
+        _refuse_draft_topk(hf_config)
+        if not Path(model_name).is_dir():
+            raise ValueError(
+                f"Download the {DSPARK_EXL3_QUANT_METHOD} checkpoint directory before loading"
+            )
+        self.layout = K31DSparkLayout(hf_config)
+        self.manifest = K31DSparkManifest(model_name)
+        self.layout.check_manifest(self.manifest)
+
+    def _member_names(self, source: str, outputs: int) -> list[str]:
+        """Checkpoint module names for fused DSpark projections.
+
+        ``source`` is already in checkpoint-local coordinates (e.g.
+        ``layers.0.self_attn.qkv_proj``), so members stay directly under
+        ``parent`` without re-subtracting ``start_layer_id``.
+        """
+        parent, _, leaf = source.rpartition(".")
+        members = self.layout.members(self, leaf, source, outputs)
+        if members is None:
+            members = self.packed_modules_mapping.get(leaf, [leaf])
+        return [f"{parent}.{member}" if parent else member for member in members]
+
+    def _source_kind(self, source: str) -> str | None:
+        assert self.manifest is not None
+        if source in self.manifest.matrices:
+            return EXL3
+        if f"{source}.weight" in self.manifest.tensors:
+            return PLAIN
+        return None
+
+    def get_quant_method(self, layer: nn.Module, prefix: str):
+        _require_dspark_k6_enabled()
+        _require_supported_gpu()
+        if not isinstance(layer, (LinearBase, ParallelLMHead)):
+            return None
+        assert self.manifest is not None, (
+            f"{DSPARK_EXL3_QUANT_METHOD} manifest must precede model construction"
+        )
+        source = self.source_prefix(prefix)
+        unquantized = (
+            UnquantizedLinearMethod() if isinstance(layer, LinearBase) else None
+        )
+
+        # Shared target lm_head is not shipped in the draft checkpoint; keep
+        # the placeholder unquantized until share_target_lm_head installs the
+        # target's EXL3 K6 lm_head.
+        if source == "lm_head" and self._source_kind(source) is None:
+            return None
+
+        kind = self._source_kind(source)
+        if kind == EXL3:
+            return K31DenseLinearMethod([self.manifest.matrices[source]])
+        if kind == PLAIN:
+            return unquantized
+
+        outputs = len(getattr(layer, "output_sizes", ()))
+        members = self._member_names(source, outputs)
+        kinds = [self._source_kind(member) for member in members]
+        if None in kinds:
+            missing = [m for m, k in zip(members, kinds) if k is None]
+            raise ValueError(
+                f"{DSPARK_EXL3_QUANT_METHOD} checkpoint holds no source of {prefix}: "
+                f"missing {missing}"
+            )
+        if all(k == EXL3 for k in kinds):
+            return K31DenseLinearMethod([self.manifest.matrices[m] for m in members])
+        if all(k == PLAIN for k in kinds):
+            return unquantized
+        raise ValueError(
+            f"{DSPARK_EXL3_QUANT_METHOD} mixed plain/EXL3 members are not supported: "
+            f"{prefix} -> {list(zip(members, kinds))}"
+        )
+
+
+@dataclass
+class K31DSparkLoadReport:
+    """Summary of one TP rank's EXL3 K6 DSpark load."""
+
+    loaded: set[str]
+    ledger: dict[str, tuple[str, str]]
+    tp_rank: int
+    tp_size: int
+    exl3_modules: int
+    exl3_matrices: int
+    plain_tensors: int
+    loaded_bytes: int
+    bf16_equivalent_bytes: int
+    reclaim_bytes: int
+
+    def counts(self) -> Counter:
+        return Counter(disposition for disposition, _ in self.ledger.values())
+
+
+def _resolve_draft_quant_config(model: nn.Module, vllm_config) -> K31DSparkExl3Config:
+    candidates = (
+        getattr(getattr(model, "model", None), "quant_config", None),
+        getattr(model, "quant_config", None),
+        getattr(vllm_config, "quant_config", None) if vllm_config is not None else None,
+    )
+    for cand in candidates:
+        if isinstance(cand, K31DSparkExl3Config) and cand.manifest is not None:
+            return cand
+    for cand in candidates:
+        if isinstance(cand, K31DSparkExl3Config):
+            return cand
+    raise ValueError(
+        f"{DSPARK_EXL3_QUANT_METHOD} weight loading requires K31DSparkExl3Config"
+    )
+
+
+def _release_draft_manifests(model: nn.Module, vllm_config) -> None:
+    seen: set[int] = set()
+    candidates = [
+        getattr(getattr(model, "model", None), "quant_config", None),
+        getattr(model, "quant_config", None),
+        getattr(vllm_config, "quant_config", None) if vllm_config is not None else None,
+    ]
+    for cand in candidates:
+        if isinstance(cand, K31DSparkExl3Config) and id(cand) not in seen:
+            seen.add(id(cand))
+            cand.release_manifest()
+
+
+def load_dspark_k6_weights(
+    model: nn.Module,
+    model_config,
+    *,
+    require_cuda: bool = True,
+) -> K31DSparkLoadReport:
+    """Load an EXL3 K6 DSpark checkpoint into ``Qwen3DSparkForCausalLM``.
+
+    Reads each TP rank's H128 slices directly into ``Exl3PackedWeight``
+    parameters, loads all remaining plain BF16 tensors (norms, ``markov_w1``,
+    ``confidence_head.proj.{weight,bias}``) through the plain weight loader,
+    verifies the complete ledger, and logs Stage-3 VRAM reclaim.
+    """
+    _require_dspark_k6_enabled()
+    if require_cuda:
+        from vllm.sm80.kernels.exl3.ops import ensure_extension
+
+        ensure_extension()
+    t0 = time.perf_counter()
+    vllm_config = get_current_vllm_config_or_none()
+    if vllm_config is None:
+        vllm_config = get_current_vllm_config()
+    quant = _resolve_draft_quant_config(model, vllm_config)
+    manifest = quant.manifest
+    if not isinstance(manifest, K31DSparkManifest):
+        raise ValueError(f"{DSPARK_EXL3_QUANT_METHOD} manifest was not initialized")
+
+    ledger = Exl3LoadLedger(manifest)
+    loaded: set[str] = set()
+    exl3_modules = 0
+    exl3_matrices = 0
+    loaded_bytes = 0
+    bf16_equiv_bytes = 0
+    modules = dict(model.named_modules())
+
+    with ExitStack() as stack:
+        files = {
+            path: stack.enter_context(
+                safe_open(str(path), framework="pt", device="cpu")
+            )
+            for path in sorted({h.path for h in manifest.tensors.values()})
+        }
+
+        # 1. Load EXL3 K6 packed modules (fc, 5x qkv/o/gate_up/down, markov_w2).
+        for name, module in modules.items():
+            method = getattr(module, "quant_method", None)
+            if not isinstance(method, Exl3LinearMethod):
+                continue
+            if getattr(module, "bias", None) is not None:
+                raise ValueError(
+                    f"{DSPARK_EXL3_QUANT_METHOD} module {name} has a bias, which is unsupported"
+                )
+            exl3_modules += 1
+            for weight in module.exl3_weights:
+                weight.load(files, ledger)
+                exl3_matrices += 1
+                loaded_bytes += (
+                    weight.trellis.numel() * weight.trellis.element_size()
+                    + weight.suh.numel() * weight.suh.element_size()
+                    + weight.svh.numel() * weight.svh.element_size()
+                )
+                bf16_equiv_bytes += weight.logical_in * weight.logical_out * 2
+            loaded.update(
+                f"{name}.{key}"
+                for key, _ in module.named_parameters()
+                if key.startswith("exl3_weights.")
+            )
+
+        # 2. Load remaining plain BF16 tensors (norms, markov_w1, confidence_head).
+        plain_items: list[tuple[str, torch.Tensor]] = []
+        plain_names: list[str] = []
+        for name, header in manifest.tensors.items():
+            if name in ledger.entries:
+                continue
+            if name.endswith(_PACKED_SUFFIXES):
+                raise ValueError(
+                    f"{DSPARK_EXL3_QUANT_METHOD} packed tensor has no runtime owner: {name}"
+                )
+            tensor = files[header.path].get_tensor(name)
+            plain_items.append((name, tensor))
+            plain_names.append(name)
+
+        if plain_items:
+            if hasattr(model, "load_plain_weights"):
+                model.load_plain_weights(iter(plain_items))
+            else:
+                from vllm.model_executor.models.qwen3_dspark import (
+                    Qwen3DSparkForCausalLM as UpstreamQwen3DSpark,
+                )
+
+                UpstreamQwen3DSpark.load_weights(model, iter(plain_items))
+            for name, tensor in plain_items:
+                ledger.mark(name, "consumed", "plain")
+                elem = 4 if name.startswith("confidence_head.proj.") else 2
+                nbytes = tensor.numel() * elem
+                loaded_bytes += nbytes
+                bf16_equiv_bytes += nbytes
+
+        # Mark loaded plain parameters (everything outside exl3_weights and
+        # intentionally shared/placeholder parameters).
+        for param_name, _ in model.named_parameters():
+            if param_name in loaded or param_name in _SHARED_OR_PLACEHOLDER_PARAMS:
+                continue
+            if ".exl3_weights." not in param_name:
+                loaded.add(param_name)
+
+        ledger.finish()
+
+    missing = {
+        name
+        for name, _ in model.named_parameters()
+        if name not in loaded and name not in _SHARED_OR_PLACEHOLDER_PARAMS
+    }
+    if missing:
+        raise ValueError(
+            f"Unloaded {DSPARK_EXL3_QUANT_METHOD} runtime parameters: {sorted(missing)[:16]}"
+        )
+    if require_cuda:
+        for param_name, param in model.named_parameters():
+            if param_name in _SHARED_OR_PLACEHOLDER_PARAMS:
+                continue
+            if not param.is_cuda:
+                raise ValueError(
+                    f"{DSPARK_EXL3_QUANT_METHOD} parameter must remain CUDA-owned: {param_name}"
+                )
+
+    tp_size = int(vllm_config.parallel_config.tensor_parallel_size)
+    tp_rank = get_tensor_model_parallel_rank() if tp_size > 1 else 0
+    reclaim_bytes = bf16_equiv_bytes - loaded_bytes
+
+    report = K31DSparkLoadReport(
+        loaded=loaded,
+        ledger=dict(ledger.entries),
+        tp_rank=tp_rank,
+        tp_size=tp_size,
+        exl3_modules=exl3_modules,
+        exl3_matrices=exl3_matrices,
+        plain_tensors=len(plain_names),
+        loaded_bytes=loaded_bytes,
+        bf16_equivalent_bytes=bf16_equiv_bytes,
+        reclaim_bytes=reclaim_bytes,
+    )
+    gib = 2**30
+    logger.info(
+        "DSpark EXL3 K6 loaded (VLLM_DSPARK_EXL3_K6=1) in %.2fs: TP rank %d/%d; "
+        "%d EXL3 K6 modules (%d matrices), %d plain tensors; VRAM %.3f GiB/rank "
+        "(BF16 %.3f GiB/rank, Stage-3 reclaim %.3f GiB/rank); full-vocab markov_w2, "
+        "shared target lm_head.",
+        time.perf_counter() - t0,
+        tp_rank,
+        tp_size,
+        exl3_modules,
+        exl3_matrices,
+        len(plain_names),
+        loaded_bytes / gib,
+        bf16_equiv_bytes / gib,
+        reclaim_bytes / gib,
+    )
+    model._k31_dspark_k6_loaded = True
+    model._k31_dspark_k6_report = report
+    _release_draft_manifests(model, vllm_config)
+    return report
