+def _stage_case(monkeypatch, directory, stage, tp, rank):
+    return construct.build_and_load(
+        monkeypatch,
+        directory,
+        tp_size=tp,
+        tp_rank=rank,
+        pp_size=len(PARTITION),
+        pp_rank=stage,
+        partition=PARTITION,
+    )
+
+
+def _check_stage_model(model, stage):
+    from vllm.model_executor.models.utils import PPMissingLayer
+
+    first = sum(PARTITION[:stage])
+    built = [not isinstance(layer, PPMissingLayer) for layer in model.model.layers]
+    assert built == [first <= n < first + PARTITION[stage] for n in range(LAYERS)]
+    assert isinstance(model.model.embed_tokens, PPMissingLayer) == (stage != 0)
+    last = stage == len(PARTITION) - 1
+    assert isinstance(model.lm_head, PPMissingLayer) == (not last)
+    assert isinstance(model.model.norm, PPMissingLayer) == (not last)
+
+
+@pytest.mark.parametrize("tp,rank", [(1, 0), (2, 0), (2, 1)])
+def test_stages_load_from_views(
+    monkeypatch, meta_platform, checkpoint, views, tp, rank
+):
+    """A stage given only its own files loads, and reads nothing else."""
+    used_books = {
+        stage: {
+            fixture.expert_rate(layer, w)
+            for layer in range(sum(PARTITION[:stage]), sum(PARTITION[: stage + 1]))
+            if layer in VQ_LAYERS
+            for w, _ in fixture.PROJECTIONS
+        }
+        for stage in range(len(PARTITION))
+    }
+    assert used_books[2] == {"vq_d4_b6", "vq_d2_b4"}  # two rates in one layer
+    for stage, view in enumerate(views):
+        model, config, report, names = _stage_case(monkeypatch, view, stage, tp, rank)
+        first = sum(PARTITION[:stage])
+        assert report.layers == (first, first + PARTITION[stage])
+        assert (report.pp_rank, report.pp_size) == (stage, len(PARTITION))
+        _check_stage_model(model, stage)
+        assert set(report.ledger) == names
+        assert not [n for n in names if f".layers.{(first + 2) % LAYERS}." in n]
+        unused = {n for n, (use, _) in report.ledger.items() if use == "unused"}
+        # Only codebooks no layer of the stage uses are left unread.
+        assert unused == {
+            f"vq.{book}" for book in fixture.RATES if book not in used_books[stage]
+        }
+
