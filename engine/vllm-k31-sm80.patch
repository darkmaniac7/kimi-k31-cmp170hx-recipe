+
+    rows = 8
+    g = torch.Generator().manual_seed(99)
+    r0 = (torch.randn((rows, latent), generator=g) / 4).to(torch.bfloat16)
+    r1 = (torch.randn((rows, latent), generator=g) / 4).to(torch.bfloat16)
+    s0 = (torch.randn((rows, hidden), generator=g) / 4).to(torch.bfloat16)
+    s1 = (torch.randn((rows, hidden), generator=g) / 4).to(torch.bfloat16)
+
+    runner0 = model0.model.layers[1].block_sparse_moe.experts
+    runner1 = model1.model.layers[1].block_sparse_moe.experts
+    monkeypatch.setattr(runner0, "_forward_entry", lambda *a, **kw: (s0, r0))
+    monkeypatch.setattr(runner1, "_forward_entry", lambda *a, **kw: (s1, r1))
+
+    def _run(comm, runner):
+        tls.comm = comm
+        return runner(
+            hidden_states=torch.zeros((rows, latent), dtype=torch.bfloat16),
+            router_logits=torch.zeros(
+                (rows, fixture.TEXT["num_experts"]), dtype=torch.float32
+            ),
+            shared_experts_input=torch.zeros((rows, hidden), dtype=torch.bfloat16),
+        )
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        f0 = pool.submit(_run, comm0, runner0)
+        f1 = pool.submit(_run, comm1, runner1)
