+def test_h1_postprocess_pipespec_chunk_b_two_request_lifecycle_and_cuda_branch():
+    """H1: Request X finishes mid-epoch; Request Y commits its own exact block row."""
+    from vllm.v1.worker.gpu.model_runner import GPUModelRunner
+    from vllm.v1.worker.gpu.model_states.mamba_hybrid import MambaHybridModelState
+
+    chunk_k = 5
+    conv = torch.zeros((40, 8, 3 + KMAX), dtype=torch.bfloat16)
+    rec = torch.zeros((40, 2, 4, 4), dtype=torch.float32)
+
+    state = MambaHybridModelState.__new__(MambaHybridModelState)
+    state.device = torch.device("cpu")
+    state.max_num_reqs = 4
+    state.use_recoverssm = False
+    state.recoverssm = None
+    state.num_accepted_tokens_gpu = torch.ones(4, dtype=torch.int32)
+    state._pipespec_chunk_b_k = 0
+    state._pipespec_chunk_b_block_row = {}
+    state._pipespec_req_id_to_idx = {}
+    state.vllm_config = SimpleNamespace(
+        compilation_config=SimpleNamespace(
+            static_forward_context={"kda_0": SimpleNamespace(kv_cache=[(conv, rec)])}
+        )
+    )
+    # DefaultModelState fields needed by super().remove_request
+    state.mm_prefix_ranges = None
+    state.prompt_embeds_state = None
+
+    # Request X (req_idx=0) uses blocks 1..13; fill Bank 0 with sentinel 11.0
+    bt_x = torch.arange(1, KMAX + 2, dtype=torch.int32)
+    conv[1].fill_(11.0)
+    rec[1:7].fill_(11.0)
+    state._pipespec_req_id_to_idx["req_X"] = 0
+    state._pipespec_chunk_b_block_row[0] = bt_x.clone()
+
+    # Request X finishes mid-epoch on a non-last PP rank (never reaches Chunk-B pop).
+    # remove_request cleans up X immediately; _ps_forget also drops by req_idx.
+    state.remove_request("req_X")
+    assert 0 not in state._pipespec_chunk_b_block_row
+
+    # Also test _ps_forget cleanup path on a non-last rank (where _ps_a_req == -1).
+    state._pipespec_chunk_b_block_row[0] = bt_x.clone()
+    runner = GPUModelRunner.__new__(GPUModelRunner)
+    runner.model_state = state
+    runner._ps_a_req = -1
+    runner._ps_p2_req = -1
+    runner._ps_forget(0)
+    assert 0 not in state._pipespec_chunk_b_block_row
+
+    # Request Y (req_idx=1) starts with disjoint blocks 21..33.
+    bt_y = torch.arange(21, 21 + KMAX + 1, dtype=torch.int32)
+    conv[21].fill_(2.0)
+    rec[21:27].fill_(2.0)
+    # Simulate Chunk B Bank-1 outputs for Y (conv at block 27, rec slot k+3=8 at block 29).
+    conv[27].fill_(99.0)
+    rec[29].fill_(77.0)
+    state._pipespec_req_id_to_idx["req_Y"] = 1
+    state._pipespec_chunk_b_block_row[1] = bt_y.clone()
+
+    # CUDA-like idx_mapping: omitting req_idx MUST raise ValueError (no dict pop fallback!).
+    cuda_idx = _CudaLikeIdxMapping([1])
+    with pytest.raises(ValueError, match="explicit host req_idx"):
+        state.postprocess_pipespec_chunk_b(
+            cuda_idx, torch.tensor([3], dtype=torch.int32), chunk_k
+        )
+    # Row 1 still intact!
+    assert 1 in state._pipespec_chunk_b_block_row
+
+    # Passing explicit req_idx=1 commits Y's exact Bank-1 -> Bank-0 without calling .item()!
+    state.postprocess_pipespec_chunk_b(
+        cuda_idx,
+        torch.tensor([3], dtype=torch.int32),
+        chunk_k,
+        req_idx=1,
+    )
+    assert state._pipespec_chunk_b_block_row == {}
+    assert int(state.num_accepted_tokens_gpu[1].item()) == 3
+    assert torch.all(conv[21] == 99.0)
+    assert torch.all(rec[23] == 77.0)  # m_b - 1 = 2 -> bt_y[2] = 23
+    # Request X's old blocks were NEVER mutated!
+    assert torch.all(conv[1] == 11.0)
+    assert torch.all(rec[1:7] == 11.0)
+
