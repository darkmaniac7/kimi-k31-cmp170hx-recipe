+    ms.device = torch.device("cpu")
+    ms.prefix_caching = False
+    ms.num_accepted_tokens_gpu = torch.ones(4, dtype=torch.int32)
+    ms._pipespec_chunk_b_k = 0
+    ms._pipespec_chunk_b_block_row = {}
+    ms._pipespec_req_id_to_idx = {}
+    ms.vllm_config = SimpleNamespace(
+        compilation_config=SimpleNamespace(static_forward_context=static_ctx)
+    )
+    ib = SimpleNamespace(idx_mapping_np=np.array([0], dtype=np.int64))
+    with pytest.raises(RuntimeError, match="layer_names"):
+        ms._prepare_pipespec_chunk_b(ib, block_tables, attn_groups, 3)
+
