+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Build the sm_80 DeepSeek-V4.1 target and DSpark drafter for one TP/EP rank
+on the meta device, from an EXL3 checkpoint directory, without engine
+post-init or process groups (the pattern of
+tests/models/test_native_checkpoint_config_meta.py)."""
+
+import copy
+from dataclasses import dataclass
+
+import torch
+
+from tests.models.test_native_checkpoint_config_meta import _runtime_defaults
+from vllm.config import (
+    CompilationConfig,
+    LoadConfig,
+    ModelConfig,
+    MultiModalConfig,
+    ParallelConfig,
+    SchedulerConfig,
+    SpeculativeConfig,
+    VllmConfig,
+    set_current_vllm_config,
+)
+from vllm.config.engram import EngramConfig
+from vllm.transformers_utils.config import get_config, get_hf_text_config
+from vllm.utils.torch_utils import set_default_torch_dtype
+
+
+@dataclass
+class _Group:
+    """Rank metadata only; no process group or collective is initialized."""
+
+    world_size: int = 1
+    rank_in_group: int = 0
+    device_communicator: object = None
+
+    @property
+    def is_first_rank(self):
+        return self.rank_in_group == 0
+
+    @property
+    def is_last_rank(self):
+        return self.rank_in_group == self.world_size - 1
+
+    @property
+    def device_group(self):
+        return self
+
+    def size(self):
+        return self.world_size
+
+class _NoStream:
+    def __init__(self, *args, **kwargs):
+        pass
+
+
+
+def set_groups(monkeypatch, tp_size: int, tp_rank: int) -> None:
+    """TP ranks with whole-expert EP over the same ranks (DP 1, PP 1)."""
+    import vllm.distributed.parallel_state as ps
+
+    tp = _Group(tp_size, tp_rank)
+    single = _Group()
+    for name, group in {
+        "_TP": tp,
+        "_ETP": tp,
+        "_EP": tp,
+        "_PP": single,
+        "_DP": single,
+        "_DCP": single,
+        "_PCP": single,
+        "_WORLD": tp,
+    }.items():
+        monkeypatch.setattr(ps, name, group)
+    # The backbone and attention create side streams; construction runs none.
+    monkeypatch.setattr(torch.cuda, "Stream", _NoStream)
+
+
+def _model_config(directory: str, hf_config, runner_type: str) -> ModelConfig:
+    config = _runtime_defaults(
+        ModelConfig,
+        model=directory,
+        tokenizer=directory,
+        hf_config=hf_config,
+        hf_text_config=get_hf_text_config(hf_config),
+        dtype=torch.bfloat16,
+        max_model_len=2048,
+        original_max_model_len=2048,
+        runner_type=runner_type,
+        convert_type="none",
+        multimodal_config=None,
+        quantization="exl3",
+        skip_tokenizer_init=True,
+    )
+    config.model_arch_config = config.get_model_arch_config()
+    if runner_type == "generate":
+        # EXL3 runs vision towers data-parallel (--mm-encoder-tp-mode data).
+        config.multimodal_config = MultiModalConfig(mm_encoder_tp_mode="data")
+    return config
+
+
+def _quant_config(directory: str, hf_config):
+    from vllm.sm80.kernels.exl3.quant import Exl3Config
+
+    quant = Exl3Config.from_config(hf_config.quantization_config)
+    quant.maybe_update_config(directory, hf_config=hf_config)
+    return quant
+
+
+def vllm_configs(directory: str, tp_size: int) -> tuple[VllmConfig, VllmConfig]:
+    """The target's config and the DSpark drafter's (its own EXL3 config,
+    as load_dspark_model gives it)."""
+    hf_config = get_config(directory, trust_remote_code=False)
+    target = _model_config(directory, hf_config, "generate")
+    draft_hf = copy.deepcopy(hf_config)
+    draft_hf.architectures = ["DSparkV41DraftModel"]
+    draft = _model_config(directory, draft_hf, "draft")
+    parallel = _runtime_defaults(
+        ParallelConfig,
+        tensor_parallel_size=tp_size,
+        pipeline_parallel_size=1,
+        enable_expert_parallel=True,
+        distributed_executor_backend="mp",
+    )
+    scheduler = SchedulerConfig(
+        max_model_len=2048,
+        max_num_batched_tokens=256,
+        max_num_seqs=8,
+        is_encoder_decoder=False,
+    )
+    speculative = _runtime_defaults(
+        SpeculativeConfig,
+        method="dspark",
+        num_speculative_tokens=4,
+        target_model_config=target,
+        target_parallel_config=parallel,
+        draft_model_config=draft,
+        draft_parallel_config=parallel,
+    )
+
+    def build(model_config, quant):
+        config = _runtime_defaults(
+            VllmConfig,
+            model_config=model_config,
+            parallel_config=parallel,
+            scheduler_config=scheduler,
+            compilation_config=CompilationConfig(
+                mode=0, cudagraph_mode="NONE", custom_ops=["all"]
+            ),
+            load_config=LoadConfig(load_format="exl3"),
+            quant_config=quant,
+            speculative_config=speculative,
+            # Device tables: the meta construction pins no host memory (the
+            # sm_80 Engram storage replaces the table either way).
+            engram_config=EngramConfig(cpu_offload=False),
+        )
+        config.kernel_config.enable_jit_warmup = False
+        config.attention_config.sparse_mla_prefill_workspace_factor = 5
+        return config
+
+    return (
+        build(target, _quant_config(directory, hf_config)),
+        build(draft, _quant_config(directory, draft_hf)),
+    )
+
+
+def build_model(config: VllmConfig) -> torch.nn.Module:
+    """The registered (fork) class of the config's architecture, built."""
+    from vllm.model_executor.models.registry import ModelRegistry
+    from vllm.sm80 import plugin
+
+    plugin.register_models()
+    architecture = config.model_config.hf_config.architectures[0]
+    model_cls = ModelRegistry._try_load_model_cls(architecture)
+    assert model_cls is not None, architecture
+    with set_current_vllm_config(config), set_default_torch_dtype(torch.bfloat16):
+        return model_cls(vllm_config=config, prefix="")
+
+
+class _EngramTable(torch.nn.Module):
+    """A parameter-free Engram table, as the sm_80 Engram storage builds
+    (its rows come from the base checkpoint, not from the EXL3 directory)."""
+
+    def __init__(self, n_hash_cols: int, tp_size: int):
+        super().__init__()
+        self.dp_size = 1
+        self.tp_size = tp_size
+        self.n_hash_cols = n_hash_cols
+        self.part_n_hash_cols = n_hash_cols // tp_size
+        self.cpu_offload = True
+
+
+def stub_engram_tables(monkeypatch, tp_size: int) -> None:
+    """Build Engram layers with :class:`_EngramTable` tables: the sm_80
+    storage opens the base checkpoint's table files, which no construction
+    test has."""
+    from vllm.models.deepseek_v41.common import engram
+
+    def create(self, layout, layer_hash_index):
+        return _EngramTable(
+            (layout.max_ngram_size - 1) * layout.n_heads, tp_size
+        )
+
+    monkeypatch.setattr(engram.Engram, "_create_embedding", create)
+    # The n-gram hash state loads the tokenizer: runtime state, not weights.
+    from vllm.models.deepseek_v41.nvidia import model
+
+    monkeypatch.setattr(model, "NgramHashState", lambda *args, **kwargs: None)
diff --git a/tests/models/deepseek_v41/sm80/dspark_draft_identity.py b/tests/models/deepseek_v41/sm80/dspark_draft_identity.py
new file mode 100644
index 0000000000..e429bbafc8
--- /dev/null
+++ b/tests/models/deepseek_v41/sm80/dspark_draft_identity.py
@@ -0,0 +1,201 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Actual sequential draft IDs on identical fixed logits, before target verification.
+
+The GPU entry uses the served TP communicator and both eager and graph replay.
+The CPU entry uses Gloo and the Triton interpreter. These are synthetic sampling
+inputs, not captured checkpoint trajectories or an acceptance-rate proxy.
+"""
+import argparse
+import json
+import os
+from types import SimpleNamespace
+
+import torch
+import torch.distributed as dist
+
+SWITCH = "VLLM_DSPARK_SHARD_ARGMAX"
+CASES = ("cross_rank_ties", "nan_ties", "signed_zero", "sequential_markov")
+SHAPES = ((1, 5), (4, 3))
+
+
+def assert_identity(records, world, modes):
+    """Gate every actual draft ID, repeat, rank and arm; never target output."""
+    indexed = {}
+    for row in records:
+        key = (row["rank"], row["case"], row["requests"], row["steps"], row["mode"], row["on"])
+        assert key not in indexed, ("duplicate draft case", key)
+        indexed[key] = row
+    expected = {(r, c, n, k, mode, on) for r in range(world) for c in CASES
+                for n, k in SHAPES for mode in modes for on in (False, True)}
+    assert set(indexed) == expected, "incomplete rank/arm/draft fixture coverage"
+    for key, row in indexed.items():
+        ids, confidence = row["draft_ids"], row["confidence"]
+        assert len(ids) >= 2 and len(confidence) == len(ids), ("missing draft repeats", key)
+        assert all(v == ids[0] for v in ids), ("draft repeatability", key)
+        assert all(v == confidence[0] for v in confidence), ("confidence repeatability", key)
+        n, k = row["requests"], row["steps"]
+        assert len(ids[0]) == n and all(len(v) == k for v in ids[0]), ("draft shape", key)
+        ref = indexed[(0, row["case"], n, k, "eager", False)]
+        assert ids[0] == ref["draft_ids"][0], ("draft IDs differ", key)
+        assert confidence[0] == ref["confidence"][0], ("draft confidence differs", key)
+        if row["expected_tie_id"] is not None:
+            assert all(t == row["expected_tie_id"] for req in ids[0] for t in req), ("lowest-index tie", key)
+
+
+def _fixture(rank, world, device, case, requests, steps, small, gather):
+    from vllm.v1.worker.gpu.spec_decode.dspark.speculator import DSparkSpeculator
+
+    width = 25 if small else 32320
+    vocab = width * world - (3 if small else 0)
+    count = requests * steps
+    g = torch.Generator().manual_seed(641)
+    base = torch.randint(-3, 4, (count + 4, vocab), generator=g).float()
+    tie_id = None
+    if case in ("cross_rank_ties", "nan_ties"):
+        base.zero_()
+        ties = [width - 1, width, 2 * width + 1, 3 * width + 2]
+        base[:, ties] = 7.0 if case == "cross_rank_ties" else float("nan")
+        tie_id = ties[0]
+    elif case == "signed_zero":
+        base.zero_()
+        base[:, ::2] = -0.0
+        tie_id = 0
+    # Invalid padded vocabulary columns must never win the local argmax.
+    padded = torch.full((count + 4, width * world), float("nan"))
+    padded[:, :vocab] = base
+    local = padded[:, rank * width:(rank + 1) * width].contiguous().to(device)
+    columns = torch.arange(vocab, device=device)
+
+    def local_logits(hidden):
+        return local[hidden[:, 0].long()]
+
+    def markov_bias(previous):
+        if case == "sequential_markov":
+            return ((previous[:, 0, None].long() + columns[None, :]) % 7 - 3).float()
+        return torch.zeros((previous.shape[0], vocab), device=device)
+
+    model = SimpleNamespace(
+        lm_head=SimpleNamespace(tp_rank=rank, tp_size=world),
+        logits_processor=SimpleNamespace(org_vocab_size=vocab),
+        draft_id_to_target_id=None,
+        compute_logits_local=local_logits,
+        compute_draft_logits=lambda hidden: gather(local_logits(hidden))[:, :vocab],
+        markov_embed=lambda ids: ids[:, None].float(), markov_bias=markov_bias,
+        map_draft_to_target=lambda ids: ids,
+        compute_confidence=lambda hidden, previous: hidden[:, 0] * 1000 + previous[:, 0],
+    )
+    hidden = torch.arange(count + 4, dtype=torch.float32, device=device)[:, None]
+    indices = torch.randperm(count + 4, generator=g)[:count].to(device)
+    input_ids = torch.randint(0, vocab, (count,), generator=g).to(device)
+
+    def make(on):
+        os.environ[SWITCH] = str(int(on))
+        s = object.__new__(DSparkSpeculator)
+        s.model = model
+        s.num_speculative_steps = steps
+        s.sample_indices = indices.clone()
+        s.input_buffers = SimpleNamespace(input_ids=input_ids.clone())
+        s._anchor_idx = torch.arange(requests, device=device) * steps
+        s.sample_idx_mapping = torch.arange(count, device=device)
+        s.sample_pos = torch.arange(count, device=device) + 1
+        s._step_cols = torch.arange(steps, dtype=torch.int32, device=device)
+        s.draft_tokens = torch.full((requests, steps), -1, dtype=torch.int64, device=device)
+        s.draft_token_confidence_probs = torch.zeros((requests, steps), device=device)
+        s.draft_logits = None
+        s._draft_topk = None
+        s.acceptance_estimator = None
+        s.use_confidence_head = True
+        return s
+    return make, hidden, tie_id
+
+
+def run_cases(rank, world, device, cpu):
+    from vllm.sm80.spec_decode import shard_argmax as sa
+
+    if cpu:
+        sa.BLOCK = 8
+        def reduce(slots):
+            fp32 = slots.float()
+            dist.all_reduce(fp32)
+            return fp32.to(slots.dtype)
+        sa.tensor_model_parallel_all_reduce = reduce
+        def gather(local):
+            pieces = [torch.empty_like(local) for _ in range(world)]
+            dist.all_gather(pieces, local)
+            return torch.cat(pieces, dim=-1)
+    else:
+        from vllm.distributed import tensor_model_parallel_all_gather
+        from vllm.distributed.parallel_state import graph_capture
+        gather = tensor_model_parallel_all_gather
+    records = []
+    for case in CASES:
+        for requests, steps in SHAPES:
+            make, hidden, tie_id = _fixture(rank, world, device, case, requests, steps, cpu, gather)
+            for on in (False, True):
+                s = make(on)
+                s._sample_sequential(requests, hidden)
+                assert s._shard_argmax is on, "draft switch did not select the requested arm"
+                for mode in (("eager",) if cpu else ("eager", "graph")):
+                    if mode == "graph":
+                        graph = torch.cuda.CUDAGraph()
+                        with graph_capture(device) as context:
+                            s._sample_sequential(requests, hidden)
+                            context.stream.synchronize()
+                            with torch.cuda.graph(graph, stream=context.stream):
+                                s._sample_sequential(requests, hidden)
+                        replay = graph.replay
+                    else:
+                        replay = lambda: s._sample_sequential(requests, hidden)
+                    ids, confidence = [], []
+                    for _ in range(2):
+                        s.draft_tokens.fill_(-1)
+                        replay()
+                        ids.append(s.draft_tokens.cpu().tolist())
+                        confidence.append(s.draft_token_confidence_probs.cpu().tolist())
+                    records.append(dict(rank=rank, case=case, requests=requests, steps=steps,
+                                        mode=mode, on=on, draft_ids=ids, confidence=confidence,
+                                        expected_tie_id=tie_id))
+    return records
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", required=True)
+    parser.add_argument("--cpu", action="store_true")
+    args = parser.parse_args()
+    rank, world = int(os.environ["RANK"]), int(os.environ["WORLD_SIZE"])
+    assert world == 4
+    if args.cpu:
+        assert os.environ.get("TRITON_INTERPRET") == "1"
+        dist.init_process_group("gloo")
+        device = torch.device("cpu")
+    else:
+        from tests.models.deepseek_v41.sm80.wo_b_allreduce_bits import _engine_like_setup, _refuse_unless_served
+        from vllm.config import VllmConfig, set_current_vllm_config
+        from vllm.distributed import ensure_model_parallel_initialized, init_distributed_environment
+        from vllm.distributed.parallel_state import get_tp_group
+        local_rank = int(os.environ["LOCAL_RANK"])
+        torch.cuda.set_device(local_rank)
+        device = torch.device("cuda", local_rank)
+        _engine_like_setup()
+        with set_current_vllm_config(VllmConfig()):
+            init_distributed_environment(world_size=world, rank=rank, local_rank=local_rank,
+                                         distributed_init_method="env://", backend="nccl")
+            ensure_model_parallel_initialized(world, 1)
+        assert _refuse_unless_served(get_tp_group().device_communicator) is None
+    records = run_cases(rank, world, device, args.cpu)
+    all_records = [None] * world
+    dist.all_gather_object(all_records, records)
+    records = [row for rows in all_records for row in rows]
+    modes = ("eager",) if args.cpu else ("eager", "graph")
+    assert_identity(records, world, modes)
+    if rank == 0:
+        with open(args.out, "w") as file:
+            json.dump(dict(verdict="PASS", world=world, modes=modes, records=records), file, indent=1)
+    dist.barrier()
+    dist.destroy_process_group()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/models/deepseek_v41/sm80/dsv41_ref.py b/tests/models/deepseek_v41/sm80/dsv41_ref.py
