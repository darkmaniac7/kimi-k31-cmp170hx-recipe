+def test_stage3_vram_reclaim_planner_math():
+    """Planner exposes exact ~1.59 GiB/rank Stage-3 VRAM reclaim at TP2 (and 2.79 GiB TP1)."""
+    bf16_tp2 = estimate_dspark_vram_bytes(tp_size=2, k6=False)
+    k6_tp2 = estimate_dspark_vram_bytes(tp_size=2, k6=True)
+    assert bf16_tp2.total_bytes == bf16_tp2.bf16_baseline_bytes
+    assert bf16_tp2.reclaim_bytes == 0
+    assert k6_tp2.bf16_baseline_bytes == bf16_tp2.total_bytes
+    assert 2.70 < bf16_tp2.total_gib < 2.71
+    assert 1.11 < k6_tp2.total_gib < 1.12
+    assert 1.58 < k6_tp2.reclaim_gib < 1.60  # exact 1.592 GiB/rank
+
+    bf16_tp1 = estimate_dspark_vram_bytes(tp_size=1, k6=False)
+    k6_tp1 = estimate_dspark_vram_bytes(tp_size=1, k6=True)
+    assert 4.61 < bf16_tp1.total_gib < 4.63
+    assert 1.82 < k6_tp1.total_gib < 1.84
+    assert 2.78 < k6_tp1.reclaim_gib < 2.80
+
+    # Stage budgets: Stage 0 and middle stages unchanged; Stage 3 reclaims exact delta.
+    assert stage_head_budget_gib(0, 4, dspark_mode="bf16") == pytest.approx(
+        stage_head_budget_gib(0, 4, dspark_mode="exl3-k6")
+    )
+    assert stage_head_budget_gib(1, 4, dspark_mode="exl3-k6") == 0.0
+    s3_bf16 = stage_head_budget_gib(3, 4, dspark_mode="bf16")
+    s3_k6 = stage_head_budget_gib(3, 4, dspark_mode="exl3-k6")
+    assert (s3_bf16 - s3_k6) == pytest.approx(k6_tp2.reclaim_gib, rel=1e-6)
+
