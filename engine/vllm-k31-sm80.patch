+def test_ancestor_mask_matches_paths_on_random_trees():
+    rng = random.Random(7)
+    for _ in range(50):
+        parent: list[int] = []
+        rank: list[int] = []
+        used: dict[int, int] = {}
+        for i in range(rng.randint(1, 12)):
+            p = rng.randint(-1, i - 1)
+            parent.append(p)
+            rank.append(used.get(p, 0))
+            used[p] = used.get(p, 0) + 1
+        tree = dt.DraftTree(tuple(parent), tuple(rank))
+        lay = dt.layout(tree)
+        paths = ((),) + tree.paths
+        for i, j in itertools.product(range(tree.num_rows), repeat=2):
+            is_prefix = paths[i][: len(paths[j])] == paths[j]
+            assert lay.ancestor_mask[i][j] == is_prefix
+        for i in range(tree.num_rows):
+            assert lay.depth[i] == len(paths[i])
+            assert sum(lay.ancestor_mask[i]) == lay.depth[i] + 1
+        # Depth-first order of the same tree never reloads more than this one.
+        dfs = dt.layout(dt.DraftTree.from_paths(tree.paths))
+        assert dfs.num_state_reloads <= lay.num_state_reloads
+        leaves = sum(1 for n in range(tree.num_nodes) if not tree.children(n))
+        assert dfs.num_state_reloads == leaves - 1
