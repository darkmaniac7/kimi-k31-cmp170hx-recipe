+    if (tid < kD) {
+      float o_tot = 0.0f;
+#pragma unroll
+      for (int w = 0; w < kWarps; ++w) {
+        o_tot += s_red_o[w];
+      }
+      float inv_rms = 1.0f / sqrtf(o_tot * kInvD + norm_eps);
+      float g2v = bf16_to_f32(g2_ptr[tok * stride_g2_t + h * kD + tid]);
+      float y = s_o[tid] * inv_rms * s_nw[tid] * sigmoid_f32(g2v);
+      out_ptr[tok * stride_out_t + h * kD + tid] = f32_to_bf16(y);
+    }
+  }
+}
+
+// Split-V Stage 1 (small-batch latency fast path): 1 CTA per (spec_seq, head), 512 threads.
+// Runs varlen 4-tap conv1d + SiLU + BF16 rounding + sliding conv_state update + exact IEEE
+// Q/K L2-norm + KDA decay gate + beta sigmoid ONCE per head, writing ~788 KiB into L2 for
+// Stage 2, and initializes arrive_ptr[bh] = 0 so Stage 2 needs no separate memset.
+__global__ void __launch_bounds__(512) k31_kda_spec_prep_d128_kernel(
+    const __nv_bfloat16* __restrict__ mixed_qkv_ptr,
+    __nv_bfloat16* __restrict__ conv_state_ptr,
+    const void* __restrict__ conv_weight_ptr,
+    const void* __restrict__ conv_bias_ptr,
+    const __nv_bfloat16* __restrict__ raw_g_ptr,
+    const __nv_bfloat16* __restrict__ raw_beta_ptr,
+    const void* __restrict__ a_log_ptr,
+    const void* __restrict__ dt_bias_ptr,
+    const void* __restrict__ spec_state_indices_ptr,
+    const void* __restrict__ query_start_loc_ptr,
+    const void* __restrict__ num_accepted_tokens_ptr,
+    int64_t stride_mixed_t,
+    int64_t stride_cs_slot,
+    int64_t stride_cs_c,
+    int64_t stride_cs_t,
+    int64_t stride_cw_c,
+    int64_t stride_g_t,
+    int64_t stride_beta_t,
+    int64_t stride_ssi_n,
+    int64_t total_tokens,
+    int H,
+    int S_cols,
+    int conv_state_len,
+    bool conv_w_fp32,
+    bool conv_b_fp32,
+    bool a_log_fp32,
+    bool dt_bias_fp32,
+    bool ssi_i64,
+    bool qsl_i64,
+    bool acc_i64,
+    bool use_lower_bound,
+    float lower_bound,
+    float* __restrict__ ws_q,
+    float* __restrict__ ws_k,
+    float* __restrict__ ws_v,
+    float* __restrict__ ws_decay,
+    float* __restrict__ ws_beta,
+    int* __restrict__ arrive_ptr) {
+  constexpr int kD = 128;
+  constexpr float kQScale = 0.08838834764831845f;  // 1 / sqrt(128)
+
+  const int bh = blockIdx.x;
+  const int tid = threadIdx.x;
+  if (tid == 0) {
+    arrive_ptr[bh] = 0;
+  }
+
+  const int i_n = bh / H;
+  const int h = bh - i_n * H;
+  const int warp = tid >> 5;
+  const int lane = tid & 31;
+
+  const int64_t bos = load_index_i32_or_i64(query_start_loc_ptr, i_n, qsl_i64);
+  const int64_t eos = load_index_i32_or_i64(query_start_loc_ptr, i_n + 1, qsl_i64);
+  const int64_t q_len = eos - bos;
+  if (q_len <= 0 || bos < 0 || eos > total_tokens) {
+    return;
+  }
+
+  const int64_t ssi_row = static_cast<int64_t>(i_n) * stride_ssi_n;
+  const int64_t conv_slot = load_index_i32_or_i64(spec_state_indices_ptr, ssi_row, ssi_i64);
+  const int64_t init_tok = load_index_i32_or_i64(num_accepted_tokens_ptr, i_n, acc_i64) - 1;
+  const int64_t init_state_slot =
+      (init_tok >= 0 && init_tok < static_cast<int64_t>(S_cols))
+          ? load_index_i32_or_i64(spec_state_indices_ptr, ssi_row + init_tok, ssi_i64)
+          : 0;
+  if (conv_slot <= 0 || init_state_slot <= 0) {
+    return;
+  }
+
+  __shared__ float s_red_qk[2][8];
+
+  const int proj_size = H * kD;
+  int c_global = 0;
+  __nv_bfloat16* cs_c = nullptr;
+  float cw0 = 0.0f;
+  float cw1 = 0.0f;
+  float cw2 = 0.0f;
+  float cw3 = 0.0f;
+  float cb = 0.0f;
+  float h0 = 0.0f;
+  float h1 = 0.0f;
+  float h2 = 0.0f;
+  float dt_b = 0.0f;
+  float a_val = 0.0f;
+
+  if (tid < 3 * kD) {
+    const int group = tid >> 7;  // 0=Q, 1=K, 2=V
+    const int d = tid & 127;
+    c_global = group * proj_size + h * kD + d;
+    const int64_t cw_off = static_cast<int64_t>(c_global) * stride_cw_c;
+    cw0 = load_f32_or_bf16(conv_weight_ptr, cw_off + 0, conv_w_fp32);
+    cw1 = load_f32_or_bf16(conv_weight_ptr, cw_off + 1, conv_w_fp32);
+    cw2 = load_f32_or_bf16(conv_weight_ptr, cw_off + 2, conv_w_fp32);
+    cw3 = load_f32_or_bf16(conv_weight_ptr, cw_off + 3, conv_w_fp32);
+    cb = conv_bias_ptr ? load_f32_or_bf16(conv_bias_ptr, c_global, conv_b_fp32) : 0.0f;
+
+    cs_c = conv_state_ptr + conv_slot * stride_cs_slot +
+           static_cast<int64_t>(c_global) * stride_cs_c;
+    __nv_bfloat16 bh0 = cs_c[(init_tok + 0) * stride_cs_t];
+    __nv_bfloat16 bh1 = cs_c[(init_tok + 1) * stride_cs_t];
+    __nv_bfloat16 bh2 = cs_c[(init_tok + 2) * stride_cs_t];
+    cs_c[0 * stride_cs_t] = bh1;
+    cs_c[1 * stride_cs_t] = bh2;
+    h0 = bf16_to_f32(bh0);
+    h1 = bf16_to_f32(bh1);
+    h2 = bf16_to_f32(bh2);
+  } else {
+    const int d = tid - 3 * kD;
+    dt_b = load_f32_or_bf16(dt_bias_ptr, static_cast<int64_t>(h) * kD + d, dt_bias_fp32);
+    a_val = expf(load_f32_or_bf16(a_log_ptr, h, a_log_fp32));
+  }
+
+  for (int64_t t = 0; t < q_len; ++t) {
+    const int64_t tok = bos + t;
+    const int64_t th_idx = tok * static_cast<int64_t>(H) + h;
+    const int64_t th_off = th_idx * kD;
+    const int buf = static_cast<int>(t & 1);
+    float val = 0.0f;
+
+    if (tid < 3 * kD) {
+      __nv_bfloat16 xt_bf16 = mixed_qkv_ptr[tok * stride_mixed_t + c_global];
+      if (2 + t < static_cast<int64_t>(conv_state_len)) {
+        cs_c[(2 + t) * stride_cs_t] = xt_bf16;
+      }
+      float xt = bf16_to_f32(xt_bf16);
+      float acc = fmaf(h0, cw0, cb);
+      acc = fmaf(h1, cw1, acc);
+      acc = fmaf(h2, cw2, acc);
+      acc = fmaf(xt, cw3, acc);
+      h0 = h1;
+      h1 = h2;
+      h2 = xt;
+      val = bf16_to_f32(f32_to_bf16(silu_f32(acc)));
+      if (tid < kD) {
+        float qsq = warp_sum_f32(val * val);
+        if (lane == 0) s_red_qk[buf][warp] = qsq;
+      } else if (tid < 2 * kD) {
+        float ksq = warp_sum_f32(val * val);
+        if (lane == 0) s_red_qk[buf][warp] = ksq;
+      } else {
+        ws_v[th_off + (tid - 2 * kD)] = val;
+      }
+    } else {
+      const int d = tid - 3 * kD;
+      float g_val = bf16_to_f32(raw_g_ptr[tok * stride_g_t + h * kD + d]);
+      float g_plus = g_val + dt_b;
+      float log_decay;
+      if (use_lower_bound) {
+        log_decay = lower_bound * sigmoid_f32(a_val * g_plus);
+      } else {
+        float sp = (g_plus > 20.0f) ? g_plus : log1pf(expf(g_plus));
+        log_decay = -a_val * sp;
+      }
+      ws_decay[th_off + d] = expf(log_decay);
+      if (d == 0) {
+        ws_beta[th_idx] = sigmoid_f32(bf16_to_f32(raw_beta_ptr[tok * stride_beta_t + h]));
+      }
+    }
+
+    __syncthreads();
+
+    if (tid < kD) {
+      float q_tot = (s_red_qk[buf][0] + s_red_qk[buf][1]) +
+                    (s_red_qk[buf][2] + s_red_qk[buf][3]);
+      ws_q[th_off + tid] = (val / sqrtf(q_tot + 1.0e-6f)) * kQScale;
+    } else if (tid < 2 * kD) {
+      float k_tot = (s_red_qk[buf][4] + s_red_qk[buf][5]) +
+                    (s_red_qk[buf][6] + s_red_qk[buf][7]);
+      ws_k[th_off + (tid - kD)] = val / sqrtf(k_tot + 1.0e-6f);
+    }
+  }
+}
+
+// Split-V Stage 2 (small-batch latency fast path): kSplitV = 8 CTAs per (spec_seq, head),
+// 128 threads (4 warps) per CTA, 4 V-rows/warp (float4 st[4] = 16 state regs/thread).
+// Saturates all 108-188 SMs at B=1, H=48 (384 CTAs), runs the multi-step delta-rule
+// recurrence with zero __syncthreads() and streaming st.global.cs.v4.f32 checkpoint writes
+// (zero L2 pollution), then self-fuses FusedRMSNormGated(sigmoid) on the last arriving tile
+// via L2-coherent __stcg / __ldcg without a third kernel launch.
+template <int kSplitV>
+__global__ void __launch_bounds__(128, 4) k31_kda_spec_recur_norm_splitv_d128_kernel(
+    const float* __restrict__ ws_q,
+    const float* __restrict__ ws_k,
+    const float* __restrict__ ws_v,
+    const float* __restrict__ ws_decay,
+    const float* __restrict__ ws_beta,
+    const __nv_bfloat16* __restrict__ g2_ptr,
+    const void* __restrict__ norm_w_ptr,
+    float* __restrict__ state_ptr,
+    const void* __restrict__ spec_state_indices_ptr,
+    const void* __restrict__ query_start_loc_ptr,
+    const void* __restrict__ num_accepted_tokens_ptr,
+    int* __restrict__ arrive_ptr,
+    int64_t stride_g2_t,
+    int64_t stride_state_slot,
+    int64_t stride_ssi_n,
+    int64_t stride_out_t,
+    int64_t total_tokens,
+    int H,
+    int S_cols,
+    bool norm_w_fp32,
+    bool ssi_i64,
+    bool qsl_i64,
+    bool acc_i64,
+    float norm_eps,
+    __nv_bfloat16* __restrict__ out_ptr) {
+  constexpr int kD = 128;
+  constexpr int kWarps = 4;
+  constexpr int kRowsPerCta = kD / kSplitV;     // 16 for kSplitV=8
+  constexpr int kRowsPerWarp = kRowsPerCta / kWarps;  // 4
+  constexpr float kInvD = 1.0f / 128.0f;
+
+  const int bh = blockIdx.x / kSplitV;
+  const int v_tile = blockIdx.x - bh * kSplitV;
+  const int i_n = bh / H;
+  const int h = bh - i_n * H;
+  const int tid = threadIdx.x;
+  const int warp = tid >> 5;
+  const int lane = tid & 31;
+
+  const int64_t bos = load_index_i32_or_i64(query_start_loc_ptr, i_n, qsl_i64);
+  const int64_t eos = load_index_i32_or_i64(query_start_loc_ptr, i_n + 1, qsl_i64);
+  const int64_t q_len = eos - bos;
+  if (q_len <= 0 || bos < 0 || eos > total_tokens) {
+    return;
+  }
+
+  const int64_t ssi_row = static_cast<int64_t>(i_n) * stride_ssi_n;
+  const int64_t conv_slot = load_index_i32_or_i64(spec_state_indices_ptr, ssi_row, ssi_i64);
+  const int64_t init_tok = load_index_i32_or_i64(num_accepted_tokens_ptr, i_n, acc_i64) - 1;
+  const int64_t init_state_slot =
+      (init_tok >= 0 && init_tok < static_cast<int64_t>(S_cols))
+          ? load_index_i32_or_i64(spec_state_indices_ptr, ssi_row + init_tok, ssi_i64)
+          : 0;
+
+  if (conv_slot <= 0 || init_state_slot <= 0) {
+    if (v_tile == 0) {
+      const __nv_bfloat16 z = f32_to_bf16(0.0f);
+      for (int64_t t = 0; t < q_len; ++t) {
+        out_ptr[(bos + t) * stride_out_t + static_cast<int64_t>(h) * kD + tid] = z;
+      }
+    }
+    return;
+  }
+
+  const int v_start = v_tile * kRowsPerCta + warp * kRowsPerWarp;
+  float4 st[kRowsPerWarp];
+  const float* init_state_h =
+      state_ptr + init_state_slot * stride_state_slot + static_cast<int64_t>(h) * kD * kD;
+#pragma unroll
+  for (int i = 0; i < kRowsPerWarp; ++i) {
+    st[i] = reinterpret_cast<const float4*>(init_state_h + (v_start + i) * kD)[lane];
+  }
+
+  for (int64_t t = 0; t < q_len; ++t) {
+    const int64_t tok = bos + t;
+    const int64_t th_idx = tok * static_cast<int64_t>(H) + h;
+    const int64_t th_off = th_idx * kD;
+
+    const float4 q4 = __ldg(reinterpret_cast<const float4*>(ws_q + th_off) + lane);
+    const float4 k4 = __ldg(reinterpret_cast<const float4*>(ws_k + th_off) + lane);
+    const float4 dec4 = __ldg(reinterpret_cast<const float4*>(ws_decay + th_off) + lane);
+    const float beta = __ldg(ws_beta + th_idx);
+    const float4 v4 = __ldg(reinterpret_cast<const float4*>(ws_v + th_off + v_start));
+    const float v_arr[4] = {v4.x, v4.y, v4.z, v4.w};
+
+    const int64_t out_slot =
+        (t < static_cast<int64_t>(S_cols))
+            ? load_index_i32_or_i64(spec_state_indices_ptr, ssi_row + t, ssi_i64)
+            : 0;
+    float* out_state_h =
+        (out_slot > 0)
+            ? (state_ptr + out_slot * stride_state_slot + static_cast<int64_t>(h) * kD * kD)
+            : nullptr;
+
+#pragma unroll
+    for (int i = 0; i < kRowsPerWarp; ++i) {
+      const int vr = v_start + i;
+      st[i].x *= dec4.x;
+      st[i].y *= dec4.y;
+      st[i].z *= dec4.z;
+      st[i].w *= dec4.w;
+
+      float kv_part =
+          fmaf(st[i].x, k4.x, fmaf(st[i].y, k4.y, fmaf(st[i].z, k4.z, st[i].w * k4.w)));
+      float kv_pred = warp_sum_f32(kv_part);
+      float dv = (v_arr[i] - kv_pred) * beta;
+
+      st[i].x = fmaf(dv, k4.x, st[i].x);
+      st[i].y = fmaf(dv, k4.y, st[i].y);
+      st[i].z = fmaf(dv, k4.z, st[i].z);
+      st[i].w = fmaf(dv, k4.w, st[i].w);
+
+      if (out_state_h != nullptr) {
+        st_global_cs_f4(out_state_h + vr * kD + lane * 4, st[i]);
+      }
+
+      float o_part =
+          fmaf(st[i].x, q4.x, fmaf(st[i].y, q4.y, fmaf(st[i].z, q4.z, st[i].w * q4.w)));
+      float o_val = warp_sum_f32(o_part);
+      if (lane == 0) {
+        st_global_cg_bf16(
+            out_ptr + tok * stride_out_t + static_cast<int64_t>(h) * kD + vr,
+            f32_to_bf16(o_val));
+      }
+    }
+  }
+
+  __syncthreads();
+  __shared__ int s_is_last;
+  if (tid == 0) {
+    __threadfence();
+    s_is_last = (atomicAdd(arrive_ptr + bh, 1) == (kSplitV - 1)) ? 1 : 0;
+  }
+  __syncthreads();
+  if (!s_is_last) {
+    return;
+  }
+
+  __shared__ float s_red[2][kWarps];
+  const float nw = load_f32_or_bf16(norm_w_ptr, tid, norm_w_fp32);
+  for (int64_t t = 0; t < q_len; ++t) {
+    const int64_t tok = bos + t;
+    const int64_t out_idx = tok * stride_out_t + static_cast<int64_t>(h) * kD + tid;
+    float ov = bf16_to_f32(ld_global_cg_bf16(out_ptr + out_idx));
+    float wsq = warp_sum_f32(ov * ov);
+    const int buf = static_cast<int>(t & 1);
+    if (lane == 0) s_red[buf][warp] = wsq;
+    __syncthreads();
+    float o_tot = (s_red[buf][0] + s_red[buf][1]) + (s_red[buf][2] + s_red[buf][3]);
+    float inv_rms = 1.0f / sqrtf(o_tot * kInvD + norm_eps);
+    float g2v = bf16_to_f32(g2_ptr[tok * stride_g2_t + static_cast<int64_t>(h) * kD + tid]);
+    float y = ov * inv_rms * nw * sigmoid_f32(g2v);
+    out_ptr[out_idx] = f32_to_bf16(y);
+  }
+}
+
+// ============================================================================
+// 6. MLA Glue: Fused q_a + kv_a RMSNorm (1 launch) and Sigmoid*Mul (1 launch)
+// ============================================================================
+
+__global__ void __launch_bounds__(256) k31_fused_q_kv_rmsnorm_kernel(
+    const __nv_bfloat16* __restrict__ q_ptr,
+    const __nv_bfloat16* __restrict__ kv_ptr,
+    const __nv_bfloat16* __restrict__ qw_ptr,
+    const __nv_bfloat16* __restrict__ kvw_ptr,
+    __nv_bfloat16* __restrict__ q_out_ptr,
+    __nv_bfloat16* __restrict__ kv_out_ptr,
+    int64_t sq_m,
+    int64_t skv_m,
+    int64_t sqo_m,
+    int64_t skvo_m,
+    int q_dim,
+    int kv_dim,
+    float q_eps,
+    float kv_eps) {
+  constexpr int kWarps = 8;
+  __shared__ float s_sq[kWarps];
+
+  const int row = blockIdx.x;
+  const int which = blockIdx.y;  // 0 = q_c, 1 = kv_c
+  const int tid = threadIdx.x;
+  const int warp = tid >> 5;
+  const int lane = tid & 31;
+
+  const __nv_bfloat16* in_row = (which == 0)
+                                    ? (q_ptr + static_cast<int64_t>(row) * sq_m)
+                                    : (kv_ptr + static_cast<int64_t>(row) * skv_m);
+  const __nv_bfloat16* w_ptr = (which == 0) ? qw_ptr : kvw_ptr;
+  __nv_bfloat16* out_row = (which == 0)
+                               ? (q_out_ptr + static_cast<int64_t>(row) * sqo_m)
+                               : (kv_out_ptr + static_cast<int64_t>(row) * skvo_m);
+  const int dim = (which == 0) ? q_dim : kv_dim;
+  const float eps = (which == 0) ? q_eps : kv_eps;
+  const int n_vec = dim >> 3;
+
+  const uint4* in_v = reinterpret_cast<const uint4*>(in_row);
+  const uint4* w_v = reinterpret_cast<const uint4*>(w_ptr);
+  uint4* out_v = reinterpret_cast<uint4*>(out_row);
+
+  float sq = 0.0f;
+  for (int v = tid; v < n_vec; v += blockDim.x) {
+    float x[8];
+    unpack_bf16x8(in_v[v], x);
+#pragma unroll
+    for (int i = 0; i < 8; ++i) sq = fmaf(x[i], x[i], sq);
+  }
+  sq = warp_sum_f32(sq);
+  if (lane == 0) s_sq[warp] = sq;
+  __syncthreads();
+  if (tid == 0) {
+    float tot = 0.0f;
+#pragma unroll
+    for (int k = 0; k < kWarps; ++k) tot += s_sq[k];
+    s_sq[0] = rsqrtf(tot / static_cast<float>(dim) + eps);
+  }
+  __syncthreads();
+  const float inv_rms = s_sq[0];
+
+  for (int v = tid; v < n_vec; v += blockDim.x) {
+    float x[8], w[8];
+    unpack_bf16x8(in_v[v], x);
+    unpack_bf16x8(__ldg(&w_v[v]), w);
+#pragma unroll
+    for (int i = 0; i < 8; ++i) x[i] = x[i] * inv_rms * w[i];
+    out_v[v] = pack_bf16x8(x);
+  }
+}
+
+__global__ void __launch_bounds__(256) k31_sigmoid_mul_kernel(
+    const __nv_bfloat16* __restrict__ a_ptr,
+    const __nv_bfloat16* __restrict__ g_ptr,
+    __nv_bfloat16* __restrict__ o_ptr,
+    int64_t n_vec) {
+  const int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+  if (idx >= n_vec) return;
+  const uint4 av = reinterpret_cast<const uint4*>(a_ptr)[idx];
+  const uint4 gv = reinterpret_cast<const uint4*>(g_ptr)[idx];
+  float a[8], g[8];
+  unpack_bf16x8(av, a);
+  unpack_bf16x8(gv, g);
+#pragma unroll
+  for (int i = 0; i < 8; ++i) {
+    a[i] = a[i] * sigmoid_f32(g[i]);
+  }
+  reinterpret_cast<uint4*>(o_ptr)[idx] = pack_bf16x8(a);
+}
+
+// ============================================================================
+// 7. KDA Speculative Verify with Records (api_version = 3)
+// ============================================================================
+
+// Stage 1 (records): 1 CTA per (spec_seq, head), 512 threads.
+// Reads state_mode[fold_src[i, 0]] (read-only across all CTAs in Stage 1 so multi-wave
+// launches never race on state_mode):
+//   - mode == 1: publishes ws_base[i] = fold_src[i, 0], ws_nfold[i] = fold_count.
+//   - mode == 0: copies head h of full block fold_src[i, fold_count] to ssi[i, 0] when
+//                the two blocks differ, and publishes ws_base[i] = ssi[i, 0], ws_nfold[i] = 0.
+// Runs exact varlen 4-tap conv1d + SiLU + BF16 rounding + sliding conv_state update +
+// Q/K L2-norm + KDA decay gate + beta sigmoid into workspace for Stage 2.
+__global__ void __launch_bounds__(512) k31_kda_spec_prep_records_d128_kernel(
+    const __nv_bfloat16* __restrict__ mixed_qkv_ptr,
+    __nv_bfloat16* __restrict__ conv_state_ptr,
+    const void* __restrict__ conv_weight_ptr,
+    const void* __restrict__ conv_bias_ptr,
+    const __nv_bfloat16* __restrict__ raw_g_ptr,
+    const __nv_bfloat16* __restrict__ raw_beta_ptr,
+    const void* __restrict__ a_log_ptr,
+    const void* __restrict__ dt_bias_ptr,
+    float* __restrict__ state_ptr,
+    const int32_t* __restrict__ state_mode_ptr,
+    const void* __restrict__ spec_state_indices_ptr,
+    const void* __restrict__ fold_src_indices_ptr,
+    const void* __restrict__ fold_counts_ptr,
+    const void* __restrict__ query_start_loc_ptr,
+    const void* __restrict__ num_accepted_tokens_ptr,
+    int64_t stride_mixed_t,
+    int64_t stride_cs_slot,
+    int64_t stride_cs_c,
+    int64_t stride_cs_t,
+    int64_t stride_cw_c,
+    int64_t stride_g_t,
+    int64_t stride_beta_t,
+    int64_t stride_state_slot,
+    int64_t stride_ssi_n,
+    int64_t stride_fsrc_n,
+    int64_t total_tokens,
+    int64_t num_blocks,
+    int H,
+    int S_cols,
+    int F_cols,
+    int conv_state_len,
+    bool conv_w_fp32,
+    bool conv_b_fp32,
+    bool a_log_fp32,
+    bool dt_bias_fp32,
+    bool ssi_i64,
+    bool fsrc_i64,
+    bool fc_i64,
+    bool qsl_i64,
+    bool acc_i64,
+    bool use_lower_bound,
+    float lower_bound,
+    float* __restrict__ ws_q,
+    float* __restrict__ ws_k,
+    float* __restrict__ ws_v,
+    float* __restrict__ ws_decay,
+    float* __restrict__ ws_beta,
+    int64_t* __restrict__ ws_base,
+    int32_t* __restrict__ ws_nfold,
+    int* __restrict__ arrive_ptr) {
+  constexpr int kD = 128;
+  constexpr float kQScale = 0.08838834764831845f;  // 1 / sqrt(128)
+
+  const int bh = blockIdx.x;
+  const int tid = threadIdx.x;
+  const int i_n = bh / H;
+  const int h = bh - i_n * H;
+  const int warp = tid >> 5;
+  const int lane = tid & 31;
+
+  if (tid == 0) {
+    arrive_ptr[bh] = 0;
+    if (h == 0) {
+      ws_base[i_n] = 0;
+      ws_nfold[i_n] = 0;
+    }
+  }
+
+  const int64_t bos = load_index_i32_or_i64(query_start_loc_ptr, i_n, qsl_i64);
+  const int64_t eos = load_index_i32_or_i64(query_start_loc_ptr, i_n + 1, qsl_i64);
+  const int64_t q_len = eos - bos;
+  if (q_len <= 0 || bos < 0 || eos > total_tokens) {
+    return;
+  }
+
+  const int64_t ssi_row = static_cast<int64_t>(i_n) * stride_ssi_n;
+  const int64_t conv_slot = load_index_i32_or_i64(spec_state_indices_ptr, ssi_row, ssi_i64);
+  const int64_t init_tok = load_index_i32_or_i64(num_accepted_tokens_ptr, i_n, acc_i64) - 1;
+  const int64_t fsrc_row = static_cast<int64_t>(i_n) * stride_fsrc_n;
+  const int64_t fsrc_base = load_index_i32_or_i64(fold_src_indices_ptr, fsrc_row, fsrc_i64);
+  const int64_t nfold = fold_counts_ptr != nullptr
+                            ? load_index_i32_or_i64(fold_counts_ptr, i_n, fc_i64)
+                            : init_tok;
+
+  if (conv_slot <= 0 || conv_slot >= num_blocks ||
+      init_tok < 0 || (init_tok + 2) >= static_cast<int64_t>(conv_state_len) ||
+      fsrc_base <= 0 || fsrc_base >= num_blocks ||
+      nfold < 0 || nfold >= static_cast<int64_t>(F_cols)) {
+    return;
+  }
+
+  const int32_t mode = state_mode_ptr[fsrc_base];
+  if (mode == 0) {
+    const int64_t start_blk =
+        load_index_i32_or_i64(fold_src_indices_ptr, fsrc_row + nfold, fsrc_i64);
+    if (start_blk <= 0 || start_blk >= num_blocks) {
+      return;
+    }
+    if (start_blk != conv_slot) {
+      const float4* src_h4 = reinterpret_cast<const float4*>(
+          state_ptr + start_blk * stride_state_slot + static_cast<int64_t>(h) * kD * kD);
+      float* dst_h =
+          state_ptr + conv_slot * stride_state_slot + static_cast<int64_t>(h) * kD * kD;
+      float4 cp[8];
+#pragma unroll
+      for (int c = 0; c < 8; ++c) {
+        cp[c] = src_h4[c * 512 + tid];
+      }
+#pragma unroll
+      for (int c = 0; c < 8; ++c) {
+        st_global_cs_f4(dst_h + (c * 512 + tid) * 4, cp[c]);
+      }
+    }
+    if (h == 0 && tid == 0) {
+      ws_base[i_n] = conv_slot;
+      ws_nfold[i_n] = 0;
+    }
+  } else {
+    for (int64_t j = 1; j <= nfold; ++j) {
+      const int64_t r_blk =
+          load_index_i32_or_i64(fold_src_indices_ptr, fsrc_row + j, fsrc_i64);
+      if (r_blk <= 0 || r_blk >= num_blocks) {
+        return;
+      }
+    }
+    if (h == 0 && tid == 0) {
+      ws_base[i_n] = fsrc_base;
+      ws_nfold[i_n] = static_cast<int32_t>(nfold);
+    }
+  }
+
+  __shared__ float s_red_qk[2][8];
+
+  const int proj_size = H * kD;
+  int c_global = 0;
+  __nv_bfloat16* cs_c = nullptr;
+  float cw0 = 0.0f;
+  float cw1 = 0.0f;
+  float cw2 = 0.0f;
+  float cw3 = 0.0f;
+  float cb = 0.0f;
+  float h0 = 0.0f;
+  float h1 = 0.0f;
+  float h2 = 0.0f;
+  float dt_b = 0.0f;
+  float a_val = 0.0f;
+
+  if (tid < 3 * kD) {
+    const int group = tid >> 7;
+    const int d = tid & 127;
+    c_global = group * proj_size + h * kD + d;
+    const int64_t cw_off = static_cast<int64_t>(c_global) * stride_cw_c;
+    cw0 = load_f32_or_bf16(conv_weight_ptr, cw_off + 0, conv_w_fp32);
+    cw1 = load_f32_or_bf16(conv_weight_ptr, cw_off + 1, conv_w_fp32);
+    cw2 = load_f32_or_bf16(conv_weight_ptr, cw_off + 2, conv_w_fp32);
+    cw3 = load_f32_or_bf16(conv_weight_ptr, cw_off + 3, conv_w_fp32);
+    cb = conv_bias_ptr ? load_f32_or_bf16(conv_bias_ptr, c_global, conv_b_fp32) : 0.0f;
+
+    cs_c = conv_state_ptr + conv_slot * stride_cs_slot +
+           static_cast<int64_t>(c_global) * stride_cs_c;
+    __nv_bfloat16 bh0 = cs_c[(init_tok + 0) * stride_cs_t];
+    __nv_bfloat16 bh1 = cs_c[(init_tok + 1) * stride_cs_t];
+    __nv_bfloat16 bh2 = cs_c[(init_tok + 2) * stride_cs_t];
+    cs_c[0 * stride_cs_t] = bh1;
+    cs_c[1 * stride_cs_t] = bh2;
+    h0 = bf16_to_f32(bh0);
+    h1 = bf16_to_f32(bh1);
+    h2 = bf16_to_f32(bh2);
+  } else {
+    const int d = tid - 3 * kD;
+    dt_b = load_f32_or_bf16(dt_bias_ptr, static_cast<int64_t>(h) * kD + d, dt_bias_fp32);
+    a_val = expf(load_f32_or_bf16(a_log_ptr, h, a_log_fp32));
+  }
+
+  for (int64_t t = 0; t < q_len; ++t) {
+    const int64_t tok = bos + t;
+    const int64_t th_idx = tok * static_cast<int64_t>(H) + h;
+    const int64_t th_off = th_idx * kD;
+    const int buf = static_cast<int>(t & 1);
+    float val = 0.0f;
+
+    if (tid < 3 * kD) {
+      __nv_bfloat16 xt_bf16 = mixed_qkv_ptr[tok * stride_mixed_t + c_global];
+      if (2 + t < static_cast<int64_t>(conv_state_len)) {
+        cs_c[(2 + t) * stride_cs_t] = xt_bf16;
+      }
+      float xt = bf16_to_f32(xt_bf16);
+      float acc = fmaf(h0, cw0, cb);
+      acc = fmaf(h1, cw1, acc);
+      acc = fmaf(h2, cw2, acc);
+      acc = fmaf(xt, cw3, acc);
+      h0 = h1;
+      h1 = h2;
+      h2 = xt;
+      val = bf16_to_f32(f32_to_bf16(silu_f32(acc)));
+      if (tid < kD) {
+        float qsq = warp_sum_f32(val * val);
+        if (lane == 0) s_red_qk[buf][warp] = qsq;
+      } else if (tid < 2 * kD) {
+        float ksq = warp_sum_f32(val * val);
+        if (lane == 0) s_red_qk[buf][warp] = ksq;
+      } else {
+        ws_v[th_off + (tid - 2 * kD)] = val;
+      }
+    } else {
+      const int d = tid - 3 * kD;
+      float g_val = bf16_to_f32(raw_g_ptr[tok * stride_g_t + h * kD + d]);
+      float g_plus = g_val + dt_b;
+      float log_decay;
+      if (use_lower_bound) {
+        log_decay = lower_bound * sigmoid_f32(a_val * g_plus);
+      } else {
+        float sp = (g_plus > 20.0f) ? g_plus : log1pf(expf(g_plus));
+        log_decay = -a_val * sp;
+      }
+      ws_decay[th_off + d] = expf(log_decay);
+      if (d == 0) {
+        ws_beta[th_idx] = sigmoid_f32(bf16_to_f32(raw_beta_ptr[tok * stride_beta_t + h]));
+      }
+    }
+
+    __syncthreads();
+
+    if (tid < kD) {
+      float q_tot = (s_red_qk[buf][0] + s_red_qk[buf][1]) +
+                    (s_red_qk[buf][2] + s_red_qk[buf][3]);
+      ws_q[th_off + tid] = (val / sqrtf(q_tot + 1.0e-6f)) * kQScale;
+    } else if (tid < 2 * kD) {
+      float k_tot = (s_red_qk[buf][4] + s_red_qk[buf][5]) +
+                    (s_red_qk[buf][6] + s_red_qk[buf][7]);
+      ws_k[th_off + (tid - kD)] = val / sqrtf(k_tot + 1.0e-6f);
+    }
+  }
+}
+
+// Stage 2 (records): kSplitV = 8 CTAs per (spec_seq, head), 128 threads, 16 V-rows/CTA.
+// Reads ONLY ws_base and ws_nfold (never state_mode), folds j = 1 .. ws_nfold in registers,
+// stores full state only for row 0 (to ssi[i, 0]) and compact 3-row (dv, k, dec) records
+// for rows t >= 1 (to ssi[i, t]), and marks state_mode[ssi[i, 0]] = 1.
+template <int kSplitV>
+__global__ void __launch_bounds__(128, 4) k31_kda_spec_recur_norm_splitv_records_d128_kernel(
+    const float* __restrict__ ws_q,
+    const float* __restrict__ ws_k,
+    const float* __restrict__ ws_v,
+    const float* __restrict__ ws_decay,
+    const float* __restrict__ ws_beta,
+    const int64_t* __restrict__ ws_base,
+    const int32_t* __restrict__ ws_nfold,
+    const __nv_bfloat16* __restrict__ g2_ptr,
+    const void* __restrict__ norm_w_ptr,
+    float* __restrict__ state_ptr,
+    int32_t* __restrict__ state_mode_ptr,
+    const void* __restrict__ spec_state_indices_ptr,
+    const void* __restrict__ fold_src_indices_ptr,
+    const void* __restrict__ query_start_loc_ptr,
+    int* __restrict__ arrive_ptr,
+    int64_t stride_g2_t,
+    int64_t stride_state_slot,
+    int64_t stride_ssi_n,
+    int64_t stride_fsrc_n,
+    int64_t stride_out_t,
+    int64_t total_tokens,
+    int64_t num_blocks,
+    int H,
+    int S_cols,
+    bool norm_w_fp32,
+    bool ssi_i64,
+    bool fsrc_i64,
+    bool qsl_i64,
+    float norm_eps,
+    __nv_bfloat16* __restrict__ out_ptr) {
+  constexpr int kD = 128;
+  constexpr int kWarps = 4;
+  constexpr int kRowsPerCta = kD / kSplitV;           // 16 for kSplitV=8
+  constexpr int kRowsPerWarp = kRowsPerCta / kWarps;  // 4
+  constexpr float kInvD = 1.0f / 128.0f;
+
+  const int bh = blockIdx.x / kSplitV;
+  const int v_tile = blockIdx.x - bh * kSplitV;
+  const int i_n = bh / H;
+  const int h = bh - i_n * H;
+  const int tid = threadIdx.x;
+  const int warp = tid >> 5;
+  const int lane = tid & 31;
+
+  const int64_t bos = load_index_i32_or_i64(query_start_loc_ptr, i_n, qsl_i64);
+  const int64_t eos = load_index_i32_or_i64(query_start_loc_ptr, i_n + 1, qsl_i64);
+  const int64_t q_len = eos - bos;
+  if (q_len <= 0 || bos < 0 || eos > total_tokens) {
+    return;
+  }
+
+  const int64_t ssi_row = static_cast<int64_t>(i_n) * stride_ssi_n;
+  const int64_t conv_slot = load_index_i32_or_i64(spec_state_indices_ptr, ssi_row, ssi_i64);
+  const int64_t base_slot = ws_base[i_n];
+  const int32_t nfold = ws_nfold[i_n];
+
+  if (conv_slot <= 0 || base_slot <= 0) {
+    if (v_tile == 0) {
+      const __nv_bfloat16 z = f32_to_bf16(0.0f);
+      for (int64_t t = 0; t < q_len; ++t) {
+        out_ptr[(bos + t) * stride_out_t + static_cast<int64_t>(h) * kD + tid] = z;
+      }
+    }
+    return;
+  }
+
+  if (h == 0 && v_tile == 0 && tid == 0) {
+    state_mode_ptr[conv_slot] = 1;
+  }
+
+  const int v_start = v_tile * kRowsPerCta + warp * kRowsPerWarp;
+  float4 st[kRowsPerWarp];
+  const float* init_state_h =
+      state_ptr + base_slot * stride_state_slot + static_cast<int64_t>(h) * kD * kD;
+#pragma unroll
+  for (int i = 0; i < kRowsPerWarp; ++i) {
+    st[i] = reinterpret_cast<const float4*>(init_state_h + (v_start + i) * kD)[lane];
+  }
+
+  const int64_t fsrc_row = static_cast<int64_t>(i_n) * stride_fsrc_n;
+  for (int j = 1; j <= nfold; ++j) {
+    const int64_t rec_slot =
+        load_index_i32_or_i64(fold_src_indices_ptr, fsrc_row + j, fsrc_i64);
+    const float* rec_h =
+        state_ptr + rec_slot * stride_state_slot + static_cast<int64_t>(h) * kD * kD;
+    const float4 dv4 = __ldg(reinterpret_cast<const float4*>(rec_h + v_start));
+    const float4 k4 = __ldg(reinterpret_cast<const float4*>(rec_h + kD) + lane);
+    const float4 dec4 = __ldg(reinterpret_cast<const float4*>(rec_h + 2 * kD) + lane);
+    const float dv_j[4] = {dv4.x, dv4.y, dv4.z, dv4.w};
+#pragma unroll
+    for (int i = 0; i < kRowsPerWarp; ++i) {
+      st[i].x *= dec4.x;
+      st[i].y *= dec4.y;
+      st[i].z *= dec4.z;
+      st[i].w *= dec4.w;
+      st[i].x = fmaf(dv_j[i], k4.x, st[i].x);
+      st[i].y = fmaf(dv_j[i], k4.y, st[i].y);
+      st[i].z = fmaf(dv_j[i], k4.z, st[i].z);
+      st[i].w = fmaf(dv_j[i], k4.w, st[i].w);
+    }
+  }
+
+  for (int64_t t = 0; t < q_len; ++t) {
+    const int64_t tok = bos + t;
+    const int64_t th_idx = tok * static_cast<int64_t>(H) + h;
+    const int64_t th_off = th_idx * kD;
+
+    const float4 q4 = __ldg(reinterpret_cast<const float4*>(ws_q + th_off) + lane);
+    const float4 k4 = __ldg(reinterpret_cast<const float4*>(ws_k + th_off) + lane);
+    const float4 dec4 = __ldg(reinterpret_cast<const float4*>(ws_decay + th_off) + lane);
+    const float beta = __ldg(ws_beta + th_idx);
+    const float4 v4 = __ldg(reinterpret_cast<const float4*>(ws_v + th_off + v_start));
+    const float v_arr[4] = {v4.x, v4.y, v4.z, v4.w};
+
+    const int64_t out_slot =
+        (t < static_cast<int64_t>(S_cols))
+            ? load_index_i32_or_i64(spec_state_indices_ptr, ssi_row + t, ssi_i64)
+            : 0;
+    float* out_state_h =
+        (out_slot > 0 && out_slot < num_blocks)
+            ? (state_ptr + out_slot * stride_state_slot + static_cast<int64_t>(h) * kD * kD)
+            : nullptr;
+
+    float dv_out[4];
+#pragma unroll
+    for (int i = 0; i < kRowsPerWarp; ++i) {
+      const int vr = v_start + i;
+      st[i].x *= dec4.x;
+      st[i].y *= dec4.y;
+      st[i].z *= dec4.z;
+      st[i].w *= dec4.w;
+
+      float kv_part =
+          fmaf(st[i].x, k4.x, fmaf(st[i].y, k4.y, fmaf(st[i].z, k4.z, st[i].w * k4.w)));
+      float kv_pred = warp_sum_f32(kv_part);
+      float dv = (v_arr[i] - kv_pred) * beta;
+      dv_out[i] = dv;
+
+      st[i].x = fmaf(dv, k4.x, st[i].x);
+      st[i].y = fmaf(dv, k4.y, st[i].y);
+      st[i].z = fmaf(dv, k4.z, st[i].z);
+      st[i].w = fmaf(dv, k4.w, st[i].w);
+
+      if (t == 0 && out_state_h != nullptr) {
+        st_global_cs_f4(out_state_h + vr * kD + lane * 4, st[i]);
+      }
+
+      float o_part =
+          fmaf(st[i].x, q4.x, fmaf(st[i].y, q4.y, fmaf(st[i].z, q4.z, st[i].w * q4.w)));
+      float o_val = warp_sum_f32(o_part);
+      if (lane == 0) {
+        st_global_cg_bf16(
+            out_ptr + tok * stride_out_t + static_cast<int64_t>(h) * kD + vr,
+            f32_to_bf16(o_val));
+      }
+    }
+    if (t > 0 && out_state_h != nullptr && lane == 0) {
+      st_global_cs_f4(
+          out_state_h + v_start,
+          make_float4(dv_out[0], dv_out[1], dv_out[2], dv_out[3]));
+    }
+  }
+
+  __syncthreads();
+  __shared__ int s_is_last;
+  if (tid == 0) {
+    __threadfence();
+    s_is_last = (atomicAdd(arrive_ptr + bh, 1) == (kSplitV - 1)) ? 1 : 0;
+  }
+  __syncthreads();
+  if (!s_is_last) {
+    return;
+  }
+
+  // All 8 v_tile CTAs have finished reading old k and dec records; write new k and dec
+  // into rows 1 and 2 of ssi[i, t] for t = 1 .. q_len - 1.
+  for (int64_t t = 1; t < q_len; ++t) {
+    const int64_t out_slot =
+        (t < static_cast<int64_t>(S_cols))
+            ? load_index_i32_or_i64(spec_state_indices_ptr, ssi_row + t, ssi_i64)
+            : 0;
+    if (out_slot > 0 && out_slot < num_blocks) {
+      float* out_state_h =
+          state_ptr + out_slot * stride_state_slot + static_cast<int64_t>(h) * kD * kD;
+      const int64_t th_off = ((bos + t) * static_cast<int64_t>(H) + h) * kD;
+      if (warp == 0) {
+        st_global_cs_f4(
+            out_state_h + kD + lane * 4,
+            __ldg(reinterpret_cast<const float4*>(ws_k + th_off) + lane));
+      } else if (warp == 1) {
+        st_global_cs_f4(
+            out_state_h + 2 * kD + lane * 4,
+            __ldg(reinterpret_cast<const float4*>(ws_decay + th_off) + lane));
+      }
+    }
+  }
+
+  __shared__ float s_red[2][kWarps];
+  const float nw = load_f32_or_bf16(norm_w_ptr, tid, norm_w_fp32);
+  for (int64_t t = 0; t < q_len; ++t) {
+    const int64_t tok = bos + t;
+    const int64_t out_idx = tok * stride_out_t + static_cast<int64_t>(h) * kD + tid;
+    float ov = bf16_to_f32(ld_global_cg_bf16(out_ptr + out_idx));
+    float wsq = warp_sum_f32(ov * ov);
+    const int buf = static_cast<int>(t & 1);
+    if (lane == 0) s_red[buf][warp] = wsq;
+    __syncthreads();
+    float o_tot = (s_red[buf][0] + s_red[buf][1]) + (s_red[buf][2] + s_red[buf][3]);
+    float inv_rms = 1.0f / sqrtf(o_tot * kInvD + norm_eps);
+    float g2v = bf16_to_f32(g2_ptr[tok * stride_g2_t + static_cast<int64_t>(h) * kD + tid]);
+    float y = ov * inv_rms * nw * sigmoid_f32(g2v);
+    out_ptr[out_idx] = f32_to_bf16(y);
+  }
+}
+
+// Materialize records into state[ssi[i, acc - 1]][h] for sequences with state_mode[ssi[i, 0]] == 1.
+// Reads state_mode read-only; reset kernel clears state_mode[ssi[i, 0]] = 0 after all heads finish.
+__global__ void __launch_bounds__(512) k31_kda_records_materialize_d128_kernel(
+    float* __restrict__ state_ptr,
+    const int32_t* __restrict__ state_mode_ptr,
+    const void* __restrict__ spec_state_indices_ptr,
+    const void* __restrict__ num_accepted_tokens_ptr,
+    int64_t stride_state_slot,
+    int64_t stride_ssi_n,
+    int64_t num_blocks,
+    int H,
+    int S_cols,
+    bool ssi_i64,
+    bool acc_i64) {
+  constexpr int kD = 128;
+  const int bh = blockIdx.x;
+  const int i_n = bh / H;
+  const int h = bh - i_n * H;
+  const int tid = threadIdx.x;
+  const int warp = tid >> 5;
+  const int lane = tid & 31;
+
+  const int64_t ssi_row = static_cast<int64_t>(i_n) * stride_ssi_n;
+  const int64_t base_slot = load_index_i32_or_i64(spec_state_indices_ptr, ssi_row, ssi_i64);
+  const int64_t nfold = load_index_i32_or_i64(num_accepted_tokens_ptr, i_n, acc_i64) - 1;
+  if (base_slot <= 0 || base_slot >= num_blocks || nfold < 0 || nfold >= static_cast<int64_t>(S_cols)) {
+    return;
+  }
+  if (state_mode_ptr[base_slot] == 0) {
+    return;
+  }
+  const int64_t dst_slot = load_index_i32_or_i64(spec_state_indices_ptr, ssi_row + nfold, ssi_i64);
+  if (dst_slot <= 0 || dst_slot >= num_blocks) {
+    return;
+  }
+  if (nfold == 0 && dst_slot == base_slot) {
+    return;
+  }
+
+  for (int64_t j = 1; j <= nfold; ++j) {
+    const int64_t r_slot = load_index_i32_or_i64(spec_state_indices_ptr, ssi_row + j, ssi_i64);
+    if (r_slot <= 0 || r_slot >= num_blocks) {
+      return;
+    }
+  }
+
+  const int v_start = warp * 8;
+  float4 st[8];
+  const float* base_h =
+      state_ptr + base_slot * stride_state_slot + static_cast<int64_t>(h) * kD * kD;
+#pragma unroll
+  for (int i = 0; i < 8; ++i) {
+    st[i] = reinterpret_cast<const float4*>(base_h + (v_start + i) * kD)[lane];
+  }
+
+  for (int64_t j = 1; j <= nfold; ++j) {
+    const int64_t rec_slot = load_index_i32_or_i64(spec_state_indices_ptr, ssi_row + j, ssi_i64);
+    const float* rec_h =
+        state_ptr + rec_slot * stride_state_slot + static_cast<int64_t>(h) * kD * kD;
+    const float4 dv_lo = __ldg(reinterpret_cast<const float4*>(rec_h + v_start));
+    const float4 dv_hi = __ldg(reinterpret_cast<const float4*>(rec_h + v_start + 4));
+    const float4 k4 = __ldg(reinterpret_cast<const float4*>(rec_h + kD) + lane);
+    const float4 dec4 = __ldg(reinterpret_cast<const float4*>(rec_h + 2 * kD) + lane);
+    const float dv_j[8] = {
+        dv_lo.x, dv_lo.y, dv_lo.z, dv_lo.w,
+        dv_hi.x, dv_hi.y, dv_hi.z, dv_hi.w,
+    };
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+      st[i].x *= dec4.x;
+      st[i].y *= dec4.y;
+      st[i].z *= dec4.z;
+      st[i].w *= dec4.w;
+      st[i].x = fmaf(dv_j[i], k4.x, st[i].x);
+      st[i].y = fmaf(dv_j[i], k4.y, st[i].y);
+      st[i].z = fmaf(dv_j[i], k4.z, st[i].z);
+      st[i].w = fmaf(dv_j[i], k4.w, st[i].w);
+    }
+  }
+
+  // Ensure all 16 warps finish reading records (including rec_slot == dst_slot)
+  // before warp 0 overwrites rows 0..2 of dst_h.
+  __syncthreads();
+
+  float* dst_h =
+      state_ptr + dst_slot * stride_state_slot + static_cast<int64_t>(h) * kD * kD;
+#pragma unroll
+  for (int i = 0; i < 8; ++i) {
+    st_global_cs_f4(dst_h + (v_start + i) * kD + lane * 4, st[i]);
+  }
+}
+
+__global__ void __launch_bounds__(256) k31_kda_reset_state_mode_kernel(
+    int32_t* __restrict__ state_mode_ptr,
+    const void* __restrict__ spec_state_indices_ptr,
+    const void* __restrict__ num_accepted_tokens_ptr,
+    int64_t stride_ssi_n,
+    int64_t num_seq,
+    int64_t num_blocks,
+    int S_cols,
+    bool ssi_i64,
+    bool acc_i64) {
+  const int64_t i_n = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+  if (i_n >= num_seq) return;
+  const int64_t ssi_row = i_n * stride_ssi_n;
+  const int64_t base_slot = load_index_i32_or_i64(spec_state_indices_ptr, ssi_row, ssi_i64);
+  const int64_t nfold = load_index_i32_or_i64(num_accepted_tokens_ptr, i_n, acc_i64) - 1;
+  if (base_slot <= 0 || base_slot >= num_blocks || nfold < 0 || nfold >= static_cast<int64_t>(S_cols)) {
+    return;
+  }
+  const int64_t dst_slot = load_index_i32_or_i64(spec_state_indices_ptr, ssi_row + nfold, ssi_i64);
+  if (dst_slot > 0 && dst_slot < num_blocks) {
+    state_mode_ptr[base_slot] = 0;
+  }
+}
+
+// ============================================================================
+// 8. Adaptive MoE Router Tail-Expert Pruning (1 warp / row, <= 32 top-k)
+// ============================================================================
+
+__global__ void __launch_bounds__(256) k31_moe_prune_topk_kernel(
+    const float* __restrict__ weights_ptr,
+    const void* __restrict__ ids_ptr,
+    float* __restrict__ out_weights_ptr,
+    void* __restrict__ out_ids_ptr,
+    int64_t rows,
+    int K,
+    int max_topk,
+    float rel_thresh,
+    bool renormalize,
+    bool ids_i64) {
+  const int64_t row = static_cast<int64_t>(blockIdx.x) * 8 + (threadIdx.x >> 5);
+  const int lane = threadIdx.x & 31;
+  if (row >= rows) return;
+
+  const int64_t base = row * K;
+  const int64_t my_id = (lane < K) ? load_index_i32_or_i64(ids_ptr, base + lane, ids_i64) : -1;
+  const bool my_valid = (lane < K) && (my_id >= 0);
+  const float my_w = my_valid ? weights_ptr[base + lane] : 0.0f;
+
+  const float orig_sum = warp_sum_f32(my_w);
+  float row_max_w = my_valid ? my_w : -INFINITY;
+#pragma unroll
+  for (int mask = 16; mask >= 1; mask >>= 1) {
+    float other = __shfl_xor_sync(kFullMask, row_max_w, mask);
+    row_max_w = fmaxf(row_max_w, other);
+  }
+
+  int rank = 0;
+  for (int j = 0; j < K; ++j) {
+    const float wj = __shfl_sync(kFullMask, my_w, j);
+    const int vj = __shfl_sync(kFullMask, my_valid ? 1 : 0, j);
+    if (vj && (!my_valid || wj > my_w || (wj == my_w && j < lane))) {
+      ++rank;
+    }
+  }
+
+  const int k_cap = (max_topk > 0 && max_topk < K) ? max_topk : K;
+  const int min_keep = (k_cap < 4) ? k_cap : 4;
+  bool keep = my_valid && (rank < k_cap);
+  if (rel_thresh > 0.0f) {
+    keep = keep && (rank < min_keep || my_w >= rel_thresh * row_max_w);
+  }
+
+  const uint32_t dropped_mask = __ballot_sync(kFullMask, my_valid && !keep);
+  const float kept_sum = warp_sum_f32(keep ? my_w : 0.0f);
+
+  if (lane < K) {
+    float out_w;
+    if (dropped_mask == 0u) {
+      out_w = my_valid ? my_w : 0.0f;
+    } else if (!keep) {
+      out_w = 0.0f;
+    } else if (renormalize && kept_sum > 0.0f) {
+      out_w = my_w * (orig_sum / kept_sum);
+    } else {
+      out_w = my_w;
+    }
+    const int64_t out_id = keep ? my_id : -1;
+    out_weights_ptr[base + lane] = out_w;
+    if (ids_i64) {
+      reinterpret_cast<int64_t*>(out_ids_ptr)[base + lane] = out_id;
+    } else {
+      reinterpret_cast<int32_t*>(out_ids_ptr)[base + lane] = static_cast<int32_t>(out_id);
+    }
+  }
+}
