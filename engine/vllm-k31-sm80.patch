+def test_suffix_hybrid_cuda_async_staging_and_capture_guard(monkeypatch, caplog):
+    """Exercise CUDA non-blocking staging/polling and capture guard on CPU via fake event."""
+    caplog.set_level(logging.INFO, logger="vllm.sm80.spec_decode.dspark_suffix_hybrid")
+    cfg = SimpleNamespace(
+        speculative_config=SimpleNamespace(
+            adaptive_k_config=SimpleNamespace(log_interval=2)
+        )
+    )
+    inst, _ = _make_hybrid(monkeypatch, vllm_config=cfg)
+
+    class _FakeCudaEvent:
+        def __init__(self):
+            self.recorded = 0
+            self.ready = False
+
+        def record(self):
+            self.recorded += 1
+
+        def query(self):
+            return self.ready
+
+    class _FakeCudaDevice:
+        type = "cuda"
+
+        def __eq__(self, other):
+            return True
+
+    fake_event = _FakeCudaEvent()
+    inst._suffix_stats_host = torch.zeros(4, dtype=torch.int64)
+    inst._suffix_stats_event = fake_event
+
+    fake_cuda_dev = _FakeCudaDevice()
+    capturing = [True]
+    monkeypatch.setattr(torch.cuda, "is_current_stream_capturing", lambda: capturing[0])
+
+    class _FakeTensorView:
+        """Minimal wrapper making .device.type == cuda while delegating ops to CPU."""
+
+        def __init__(self, t: torch.Tensor):
+            self._t = t
+            self.device = fake_cuda_dev
+
+        def to(self, *args, **kwargs):
+            return self._t.to(*args, **kwargs)
+
+        def sum(self, *args, **kwargs):
+            return self._t.sum(*args, **kwargs)
+
+        def amax(self, *args, **kwargs):
+            return self._t.amax(*args, **kwargs)
+
+    used = _FakeTensorView(torch.tensor([True, False]))
+    ov = _FakeTensorView(torch.tensor([[True, True, False], [False, False, False]]))
+    ml = _FakeTensorView(torch.tensor([7, 2], dtype=torch.int64))
+
+    # During graph capture: accumulators update on-device, zero staging/polling.
+    inst._record_suffix_telemetry(used, ov, ml)
+    assert inst._suffix_stats.tolist() == [1, 1, 2, 7]
+    assert inst._suffix_steps_since_stage == 0
+    assert fake_event.recorded == 0
+
+    # Outside graph capture: 2 steps stage a non-blocking copy and zero GPU accumulators.
+    capturing[0] = False
+    inst._record_suffix_telemetry(used, ov, ml)
+    assert fake_event.recorded == 0
+    inst._record_suffix_telemetry(used, ov, ml)
+    assert fake_event.recorded == 1
+    assert inst._suffix_copy_pending is True
+    assert inst._suffix_stats.tolist() == [0, 0, 0, 0]
+    assert inst._suffix_stats_host.tolist() == [3, 3, 6, 7]
+
+    # Event not ready yet: no log emitted and pending host buffer is not overwritten.
+    inst._record_suffix_telemetry(used, ov, ml)
+    assert not any("draft slots overridden" in r.getMessage() for r in caplog.records)
+    assert inst._suffix_copy_pending is True
+
+    # Event ready on step 5: logs staged window 1 (3 steps) and immediately stages
+    # window 2 (2 steps) because _suffix_steps_since_stage hit log_interval=2.
+    fake_event.ready = True
+    inst._record_suffix_telemetry(used, ov, ml)
+    periodic_msgs = [
+        r.getMessage() for r in caplog.records if "draft slots overridden" in r.getMessage()
+    ]
+    assert periodic_msgs == [
+        "DSpark Suffix Hybrid: 3 steps, 3 req-hits, "
+        "6 draft slots overridden, max_match_len=7"
+    ]
+    assert fake_event.recorded == 2
+    assert inst._suffix_copy_pending is True
+    assert inst._suffix_stats_host.tolist() == [2, 2, 4, 7]
+
+    # Step 6: logs window 2 and clears pending flag (only 1 step since last stage).
+    inst._record_suffix_telemetry(used, ov, ml)
+    periodic_msgs = [
+        r.getMessage() for r in caplog.records if "draft slots overridden" in r.getMessage()
+    ]
+    assert periodic_msgs[-1] == (
+        "DSpark Suffix Hybrid: 2 steps, 2 req-hits, "
+        "4 draft slots overridden, max_match_len=7"
+    )
+    assert inst._suffix_copy_pending is False
