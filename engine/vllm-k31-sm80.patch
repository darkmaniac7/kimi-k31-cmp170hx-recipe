+
+    norm_w = model0.model.layers[1].block_sparse_moe.routed_expert_norm.weight
+    eps = model0.model.layers[1].block_sparse_moe.routed_expert_norm.variance_epsilon
+    ref_rn = fake_p2p._fp32_rmsnorm_bf16(r0.float() + r1.float(), norm_w, eps)
