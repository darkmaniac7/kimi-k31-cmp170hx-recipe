+GLUON = "vllm.sm80.kernels.thin_gemm.gluon"
+KERNEL = "vllm.sm80.kernels.thin_gemm.thin_gemm_gluon"
+BF16 = torch.bfloat16
+NK = [(336, 10240), (320, 10240), (10240, 320), (512, 2560), (1, 2560), (48, 2560), (12800, 2560)]
