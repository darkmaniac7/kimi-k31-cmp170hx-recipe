new file mode 100755
index 0000000000..68271164a3
--- /dev/null
+++ b/tools/sm80/eval_dspark_k6_acceptance.py
@@ -0,0 +1,1018 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Offline acceptance parity & GPU CUDA-Graph latency check: BF16 vs EXL3 K6 DSpark.
+
+Evaluates a real BF16 Inferact/Kimi-K3.1-Pro-DSpark checkpoint against its
+EXL3 K6 quantized counterpart (produced by ``tools/sm80/quantize_dspark_exl3_k6.py``)
+when both share the real target EXL3 K6 ``lm_head`` (``mini-k31q/head.safetensors``)
+and run through ``_k31_dense_C.linear_out_k31_multi``.
+
+Uses the exact offline speculative acceptance evaluator
+(``work/dspark_distill/eval_offline_acceptance.py:evaluate_model_on_sequences``)
+across:
+  1. Real K3.1 hidden-state activations (``ref_acts.safetensors``, 2x256 tokens)
+  2. Real held-out code + prose prompts from ``eval_prompts.jsonl`` tokenized
+     with Kimi-K3.1-Pro's ``tiktoken.model``
+at both ``K=7`` and ``K=12``, both ``T=0.0`` (greedy) and ``T=1.0, top_p=0.95``
+(analytical + Monte-Carlo rejection sampling), plus confidence-head AUROC /
+10-bin ECE / Brier parity, top-1 agreement, and real GPU CUDA-Graph latency
+for ``K=1, 7, 12`` on TP2 per-rank shapes (including 3-member fused QKV,
+2-member fused gate+up, and zero-Q Phase-1 context KV).
+"""
+
+from __future__ import annotations
+
+import argparse
+import base64
+import json
+import math
+import os
+import sys
+import time
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+from safetensors import safe_open
+
+_REPO_ROOT = Path(__file__).resolve().parents[2]
+if str(_REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(_REPO_ROOT))
+
+
+class _Exl3DenseRuntime:
+    """Shared `_k31_dense_C` wrapper with one persistent FP32 workspace."""
+
+    def __init__(self, device: torch.device, max_rows: int = 32):
+        from vllm.sm80.kernels.k31q import dense_k31_ops
+
+        dense_k31_ops.ensure_dense_k31_extension()
+        self.ops = dense_k31_ops
+        self.device = device
+        self.max_rows = max_rows
+        ws_elems = self.ops.linear_workspace_size_k31(
+            max(max_rows, 16), 35840, 163840, 4
+        )
+        self.ws = torch.empty(ws_elems, dtype=torch.float32, device=device)
+
+    def linear_multi(
+        self,
+        x2d: torch.Tensor,
+        members: list[dict[str, torch.Tensor]],
+        logical_outs: list[int],
+        out: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        x2d = x2d.contiguous()
+        rows = x2d.shape[0]
+        total_out = sum(logical_outs)
+        if out is None:
+            out = torch.empty((rows, total_out), dtype=torch.bfloat16, device=x2d.device)
+        if rows == 0:
+            return out
+        trellises = [m["trellis"] for m in members]
+        suhs = [m["suh"] for m in members]
+        svhs = [m["svh"] for m in members]
+        bits_x2s = [12] * len(members)
+        step = self.max_rows
+        for start in range(0, rows, step):
+            stop = min(rows, start + step)
+            self.ops.linear_out_k31_multi(
+                x2d[start:stop],
+                trellises,
+                suhs,
+                svhs,
+                bits_x2s,
+                logical_outs,
+                out[start:stop],
+                self.ws,
+            )
+        return out
+
+
+class Exl3K6LinearModule(nn.Module):
+    """Drop-in replacement for nn.Linear running EXL3 K6 via `_k31_dense_C`."""
+
+    def __init__(
+        self,
+        runtime: _Exl3DenseRuntime,
+        trellis: torch.Tensor,
+        suh: torch.Tensor,
+        svh: torch.Tensor,
+        logical_out: int,
+        logical_in: int,
+    ) -> None:
+        super().__init__()
+        self.runtime = runtime
+        self.in_features = logical_in
+        self.out_features = logical_out
+        self.packed = {
+            "trellis": trellis.contiguous(),
+            "suh": suh.contiguous(),
+            "svh": svh.contiguous(),
+        }
+        # Expose dtype attribute for callers inspecting `.weight.dtype`
+        self._dtype_sentinel = torch.empty(0, dtype=torch.bfloat16, device=trellis.device)
+
+    @property
+    def weight(self) -> torch.Tensor:
+        return self._dtype_sentinel
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        orig_shape = x.shape[:-1]
+        x2d = x.reshape(-1, x.shape[-1]).to(torch.bfloat16).contiguous()
+        y = self.runtime.linear_multi(x2d, [self.packed], [self.out_features])
+        return y.view(*orig_shape, self.out_features)
+
+
+class Exl3K6LMHeadAdapter:
+    """Target EXL3 K6 lm_head callable attached to DSparkDraftModel."""
+
+    def __init__(
+        self,
+        runtime: _Exl3DenseRuntime,
+        head_safetensors: Path,
+        device: torch.device,
+    ) -> None:
+        self.runtime = runtime
+        with safe_open(str(head_safetensors), framework="pt", device=str(device)) as sf:
+            self.packed = {
+                "trellis": sf.get_tensor("language_model.lm_head.trellis").contiguous(),
+                "suh": sf.get_tensor("language_model.lm_head.suh").contiguous(),
+                "svh": sf.get_tensor("language_model.lm_head.svh").contiguous(),
+            }
+        self.vocab_size = int(self.packed["svh"].shape[0])
+        self.hidden_size = int(self.packed["suh"].shape[0])
+
+    def __call__(self, hidden: torch.Tensor) -> torch.Tensor:
+        orig_shape = hidden.shape[:-1]
+        x2d = hidden.reshape(-1, hidden.shape[-1]).to(torch.bfloat16).contiguous()
+        y = self.runtime.linear_multi(x2d, [self.packed], [self.vocab_size])
+        return y.view(*orig_shape, self.vocab_size)
+
+
+def _attach_k6_lm_head(model: Any, k6_head: Exl3K6LMHeadAdapter) -> None:
+    """Override compute_base_logits on a DSparkDraftModel to use shared EXL3 K6 lm_head."""
+
+    def _compute_base_logits(head_hidden: torch.Tensor, lm_head_weight=None) -> torch.Tensor:
+        if lm_head_weight is not None:
+            return F.linear(head_hidden.to(lm_head_weight.dtype), lm_head_weight)
+        return k6_head(head_hidden)
+
+    model.compute_base_logits = _compute_base_logits
+
+
+def _set_submodule(root: nn.Module, dotted: str, module: nn.Module) -> None:
+    parts = dotted.split(".")
+    parent = root
+    for p in parts[:-1]:
+        parent = getattr(parent, p)
+    setattr(parent, parts[-1], module)
+
+
+def load_bf16_dspark_model(
+    dspark_model_mod: Any,
+    weights_file: Path,
+    config_file: Path,
+    embed_w: torch.Tensor,
+    k6_head: Exl3K6LMHeadAdapter | None,
+    bf16_head: torch.Tensor | None,
+    device: torch.device,
+) -> Any:
+    cfg = dspark_model_mod.DSparkConfig.from_json(config_file)
+    model = dspark_model_mod.DSparkDraftModel(cfg).to(device=device, dtype=torch.bfloat16)
+    sd = {}
+    with safe_open(str(weights_file), framework="pt", device=str(device)) as sf:
+        for k in sf.keys():
+            sd[k] = sf.get_tensor(k)
+    missing, unexpected = model.load_state_dict(sd, strict=True)
+    assert not missing and not unexpected, f"missing={missing} unexpected={unexpected}"
+    model.eval()
+    dummy_lm = bf16_head if bf16_head is not None else torch.empty((1, 1), dtype=torch.bfloat16, device=device)
+    model.attach_target_io(embed_w, dummy_lm)
+    if k6_head is not None:
+        _attach_k6_lm_head(model, k6_head)
+    return model
+
+
+def load_k6_dspark_model(
+    dspark_model_mod: Any,
+    k6_dir: Path,
+    runtime: _Exl3DenseRuntime,
+    embed_w: torch.Tensor,
+    k6_head: Exl3K6LMHeadAdapter | None,
+    bf16_head: torch.Tensor | None,
+    device: torch.device,
+) -> Any:
+    manifest = json.loads((k6_dir / "k31q_dspark_manifest.json").read_text(encoding="utf-8"))
+    cfg = dspark_model_mod.DSparkConfig.from_json(k6_dir / "config.json")
+    model = dspark_model_mod.DSparkDraftModel(cfg).to(device=device, dtype=torch.bfloat16)
+
+    weight_file = k6_dir / manifest["file"]
+    quant_prefixes = sorted(manifest["quantized_matrices"].keys())
+    with safe_open(str(weight_file), framework="pt", device=str(device)) as sf:
+        # 1. Replace all 37 linear modules with Exl3K6LinearModule backed by _k31_dense_C.
+        for prefix in quant_prefixes:
+            shape = manifest["quantized_matrices"][prefix]["shape"]
+            trellis = sf.get_tensor(f"{prefix}.trellis")
+            suh = sf.get_tensor(f"{prefix}.suh")
+            svh = sf.get_tensor(f"{prefix}.svh")
+            mod = Exl3K6LinearModule(
+                runtime, trellis, suh, svh, logical_out=int(shape[0]), logical_in=int(shape[1])
+            )
+            _set_submodule(model, prefix, mod)
+
+        # 2. Load all plain BF16 tensors (norms, markov_w1, confidence_head).
+        plain_sd = {}
+        for key in manifest["plain_tensors"]:
+            plain_sd[key] = sf.get_tensor(key)
+    missing, unexpected = model.load_state_dict(plain_sd, strict=False)
+    # Only replaced EXL3 modules' unused weights should be absent; none of plain_sd unexpected.
+    assert not unexpected, f"unexpected plain keys: {unexpected}"
+    assert not missing, f"missing plain keys: {missing}"
+    model.eval()
+    dummy_lm = bf16_head if bf16_head is not None else torch.empty((1, 1), dtype=torch.bfloat16, device=device)
+    model.attach_target_io(embed_w, dummy_lm)
+    if k6_head is not None:
+        _attach_k6_lm_head(model, k6_head)
+    return model
+
+
+def load_kimi_tiktoken(tiktoken_path: Path):
+    import tiktoken
+
+    ranks: dict[bytes, int] = {}
+    with tiktoken_path.open("r", encoding="utf-8") as f:
+        for line in f:
+            line = line.strip()
+            if not line:
+                continue
+            b64, rank_s = line.split()
+            ranks[base64.b64decode(b64)] = int(rank_s)
+    pat = (
+        r"""[\p{Han}]+|[^\r\n\p{L}\p{N}]?[\p{Lu}\p{Lt}\p{Lm}\p{Lo}\p{M}&&[^\p{Han}]]*"""
+        r"""[\p{Ll}\p{Lm}\p{Lo}\p{M}&&[^\p{Han}]]+(?i:'s|'t|'re|'ve|'m|'ll|'d)?|"""
+        r"""[^\r\n\p{L}\p{N}]?[\p{Lu}\p{Lt}\p{Lm}\p{Lo}\p{M}&&[^\p{Han}]]+"""
+        r"""[\p{Ll}\p{Lm}\p{Lo}\p{M}&&[^\p{Han}]]*(?i:'s|'t|'re|'ve|'m|'ll|'d)?|"""
+        r"""\p{N}{1,3}| ?[^\s\p{L}\p{N}]+[\r\n]*|\s*[\r\n]+|\s+(?!\S)|\s+"""
+    )
+    specials = {f"<|reserved_{i}|>": len(ranks) + i for i in range(256)}
+    return tiktoken.Encoding(
+        name="kimi_k31",
+        pat_str=pat,
+        mergeable_ranks=ranks,
+        special_tokens=specials,
+    )
+
+
+def _select_eval_prompt_texts(
+    eval_jsonl: Path,
+    enc: Any,
+    *,
+    per_domain: int = 4,
+    min_tokens: int = 80,
+    max_tokens: int = 192,
+) -> dict[str, list[list[int]]]:
+    """Tokenize held-out code and prose prompts from eval_prompts.jsonl."""
+    by_domain: dict[str, list[list[int]]] = {"code": [], "prose": []}
+    with eval_jsonl.open("r", encoding="utf-8") as f:
+        for line in f:
+            rec = json.loads(line)
+            dom = rec.get("domain")
+            if dom not in by_domain or len(by_domain[dom]) >= per_domain:
+                continue
+            msgs = rec.get("messages") or []
+            text = "\n".join(m.get("content", "") for m in msgs if isinstance(m, dict))
+            ids = enc.encode(text, disallowed_special=())
+            if len(ids) < min_tokens:
+                continue
+            by_domain[dom].append([163584] + ids[: max_tokens - 1])
+            if all(len(v) >= per_domain for v in by_domain.values()):
+                break
+    return by_domain
+
+
+@torch.no_grad()
+def build_g1_eval_sequences(
+    g1_dataset_mod: Any,
+    ref_model: Any,
+    ref_acts_path: Path,
+    eval_prompts_path: Path,
+    tiktoken_path: Path,
+    device: torch.device,
+    *,
+    topk: int = 128,
+    realistic_noise_std: float = 0.0,
+    gt_boost: float = 0.0,
+    seed: int = 20261123,
+) -> list[Any]:
+    """Construct G1Sequence objects for real ref_acts + held-out code/prose text.
+
+    Every sequence supplies identical ``aux_hidden`` taps and teacher top-128 +
+    exact LSE to both the BF16 DSpark and EXL3 K6 DSpark models.
+
+    When ``realistic_noise_std == 0`` and ``gt_boost == 0``, the teacher is the
+    exact BF16 reference distribution (direct quantization-parity oracle).
+    When ``realistic_noise_std > 0`` / ``gt_boost > 0``, the teacher blends the
+    BF16 reference logits with realistic target divergence + true next-token
+    continuation mass so BF16 DSpark operates in a realistic ~2.5 to 5.0
+    tokens/step regime with both accepted (y=1) and rejected (y=0) outcomes for
+    well-defined confidence-head AUROC, ECE, and Brier score comparisons.
+    """
+    H = 7168
+    with safe_open(str(ref_acts_path), framework="pt", device="cpu") as sf:
+        ref_token_ids = sf.get_tensor("token_ids").long()  # [512]
+        tap_keys = ["L0.out.q", "L1.out.q", "L0.mlp_in.q", "L1.mlp_in.q", "L1.attn_out.q"]
+        raw_taps = [sf.get_tensor(k).to(torch.bfloat16) for k in tap_keys]  # each [512, 7168]
+        ref_aux_512 = torch.cat(raw_taps, dim=-1).contiguous()  # [512, 35840]
+
+    # Pool real K3.1 hidden-state bank to attach realistic tap magnitudes to
+    # held-out eval_prompts sequences.
+    enc = load_kimi_tiktoken(tiktoken_path)
+    prompt_toks = _select_eval_prompt_texts(eval_prompts_path, enc, per_domain=4)
+
+    raw_seqs: list[tuple[str, torch.Tensor, torch.Tensor]] = []
+    # Two real 256-token K3.1 sequences directly from ref_acts.safetensors.
+    raw_seqs.append(("code", ref_token_ids[:256], ref_aux_512[:256]))
+    raw_seqs.append(("prose", ref_token_ids[256:512], ref_aux_512[256:512]))
+    # Held-out code and prose sequences from eval_prompts.jsonl.
+    for dom in ("code", "prose"):
+        for idx, tok_list in enumerate(prompt_toks[dom]):
+            t_ids = torch.tensor(tok_list, dtype=torch.long)
+            L = t_ids.numel()
+            offset = (idx * 64) % max(1, 512 - L)
+            aux = ref_aux_512[offset : offset + L].clone()
+            raw_seqs.append((dom, t_ids, aux))
+
+    rng = torch.Generator(device=device)
+    rng.manual_seed(seed)
+    sequences: list[Any] = []
+
+    for seq_idx, (domain, token_ids, aux_hidden) in enumerate(raw_seqs):
+        L = token_ids.numel()
+        pos_ids = torch.arange(L, dtype=torch.long)
+        aux_gpu = aux_hidden.to(device=device, dtype=torch.bfloat16)
+        pos_gpu = pos_ids.to(device=device)
+        ctx_kv = ref_model.precompute_context_kv(aux_gpu, pos_gpu)
+
+        # Compute teacher top-k + exact LSE at every position 0..L-2 using BF16
+        # reference 1-step conditional logits (+ optional realistic target shift).
+        topk_ids_list = []
+        topk_vals_list = []
+        lse_list = []
+        loss_mask = torch.zeros(L, dtype=torch.bool)
+        loss_mask[8 : L - 1] = True  # >= 8 context tokens before first supervised slot
+
+        for pos in range(L - 1):
+            anchor_tok = int(token_ids[pos].item())
+            hh = ref_model.draft_block_hidden(
+                anchor_tok, pos, ctx_kv, num_draft_tokens=1
+            )  # [1, H]
+            lg = ref_model.compute_base_logits(hh).float().squeeze(0)  # [V]
+            if ref_model.markov_head is not None:
+                prev_t = torch.tensor([anchor_tok], dtype=torch.long, device=device)
+                me = ref_model.markov_head.embed(prev_t)
+                lg = lg + ref_model.markov_head.bias(me).squeeze(0).float()
+
+            if realistic_noise_std > 0.0:
+                lg = lg + torch.randn(lg.shape, generator=rng, device=device, dtype=torch.float32) * realistic_noise_std
+            if gt_boost > 0.0:
+                next_tok = int(token_ids[pos + 1].item())
+                top_val = float(lg.max().item())
+                lg[next_tok] = max(float(lg[next_tok].item()), top_val + gt_boost)
+
+            lse = torch.logsumexp(lg, dim=-1)
+            vals, ids = torch.topk(lg, k=topk, dim=-1)
+            topk_ids_list.append(ids.to(torch.int32).cpu())
+            topk_vals_list.append(vals.to(torch.float16).cpu())
+            lse_list.append(float(lse.item()))
+
+        gen_row_index = torch.full((L,), -1, dtype=torch.long)
+        for p_i in range(L - 1):
+            if loss_mask[p_i]:
+                gen_row_index[p_i] = p_i
+
+        topk_ids_t = torch.stack(topk_ids_list, dim=0)
+        topk_vals_t = torch.stack(topk_vals_list, dim=0)
+        teacher_lse_t = torch.tensor(lse_list, dtype=torch.float32)
+
+        # Create paired T=0.0 (greedy) and T=1.0 (top_p=0.95) evaluation sequences.
+        for temp, top_p in ((0.0, 1.0), (1.0, 0.95)):
+            sequences.append(
+                g1_dataset_mod.G1Sequence(
+                    prompt_id=seq_idx * 10 + (0 if temp == 0.0 else 1),
+                    domain=domain,
+                    temperature=temp,
+                    top_p=top_p,
+                    baseline_accept_len=None,
+                    token_ids=token_ids.clone(),
+                    position_ids=pos_ids.clone(),
+                    loss_mask=loss_mask.clone(),
+                    aux_hidden=aux_hidden.clone(),
+                    gen_row_index=gen_row_index.clone(),
+                    topk_ids=topk_ids_t,
+                    topk_logits=topk_vals_t,
+                    teacher_lse=teacher_lse_t,
+                )
+            )
+    return sequences
+
+
+@torch.no_grad()
+def measure_direct_step_agreement(
+    bf16_model: Any,
+    k6_model: Any,
+    sequences: list[Any],
+    *,
+    k_draft: int,
+    stride: int = 16,
+    max_anchors_per_seq: int = 12,
+    device: torch.device,
+) -> dict[str, Any]:
+    """Direct BF16 vs EXL3 K6 per-position top-1, T=1 TV overlap, and confidence parity."""
+    t0_seqs = [s for s in sequences if s.temperature == 0.0]
+    by_dom: dict[str, dict[str, list[float]]] = {}
+
+    for seq in t0_seqs:
+        dom = seq.domain
+        acc = by_dom.setdefault(
+            dom,
+            {
+                "tf_top1": [],
+                "tf_tv": [],
+                "free_prefix": [],
+                "conf_abs_diff": [],
+                "base_cos": [],
+            },
+        )
+        L = seq.token_ids.numel()
+        anchors = list(range(16, L - k_draft - 1, stride))[:max_anchors_per_seq]
+        if not anchors:
+            continue
+        max_a = max(anchors)
+        aux_ctx = seq.aux_hidden[:max_a].to(device=device)
+        pos_ctx = seq.position_ids[:max_a].to(device=device)
+        kv_bf = bf16_model.precompute_context_kv(aux_ctx, pos_ctx)
+        kv_k6 = k6_model.precompute_context_kv(aux_ctx, pos_ctx)
+
+        for a in anchors:
+            anchor_tok = int(seq.token_ids[a].item())
+            anchor_pos = int(seq.position_ids[a].item())
+            h_bf = bf16_model.draft_block_hidden(anchor_tok, anchor_pos, kv_bf, num_draft_tokens=k_draft)
+            h_k6 = k6_model.draft_block_hidden(anchor_tok, anchor_pos, kv_k6, num_draft_tokens=k_draft)
+            bl_bf = bf16_model.compute_base_logits(h_bf).float()
+            bl_k6 = k6_model.compute_base_logits(h_k6).float()
+            acc["base_cos"].append(
+                float(F.cosine_similarity(bl_bf, bl_k6, dim=-1).mean().item())
+            )
+
+            # Free-running BF16 rollout + teacher-forced K6 comparison + free K6 rollout.
+            prev_bf = torch.tensor([anchor_tok], dtype=torch.long, device=device)
+            prev_k6_free = torch.tensor([anchor_tok], dtype=torch.long, device=device)
+            bf_toks = []
+            k6_free_toks = []
+            for step in range(k_draft):
+                me_bf = bf16_model.markov_head.embed(prev_bf)
+                lg_bf = bl_bf[step] + bf16_model.markov_head.bias(me_bf).squeeze(0).float()
+                tok_bf = int(lg_bf.argmax().item())
+                bf_toks.append(tok_bf)
+
+                # Teacher-forced K6 conditioned on same prev_bf
+                me_k6_tf = k6_model.markov_head.embed(prev_bf)
+                lg_k6_tf = bl_k6[step] + k6_model.markov_head.bias(me_k6_tf).squeeze(0).float()
+                tok_k6_tf = int(lg_k6_tf.argmax().item())
+                acc["tf_top1"].append(1.0 if tok_k6_tf == tok_bf else 0.0)
+                p_bf = torch.softmax(lg_bf, dim=-1)
+                p_k6 = torch.softmax(lg_k6_tf, dim=-1)
+                acc["tf_tv"].append(float(torch.minimum(p_bf, p_k6).sum().item()))
+
+                c_bf = float(torch.sigmoid(bf16_model.confidence_head(h_bf[step : step + 1], me_bf)).item())
+                c_k6 = float(torch.sigmoid(k6_model.confidence_head(h_k6[step : step + 1], me_k6_tf)).item())
+                acc["conf_abs_diff"].append(abs(c_bf - c_k6))
+
+                # Free-running K6
+                me_k6_f = k6_model.markov_head.embed(prev_k6_free)
+                lg_k6_f = bl_k6[step] + k6_model.markov_head.bias(me_k6_f).squeeze(0).float()
+                tok_k6_f = int(lg_k6_f.argmax().item())
+                k6_free_toks.append(tok_k6_f)
+
+                prev_bf = torch.tensor([tok_bf], dtype=torch.long, device=device)
+                prev_k6_free = torch.tensor([tok_k6_f], dtype=torch.long, device=device)
+
+            ml = 0
+            for x, y in zip(bf_toks, k6_free_toks):
+                if x == y:
+                    ml += 1
+                else:
+                    break
+            acc["free_prefix"].append(float(ml))
+
+    out = {}
+    for dom, d in sorted(by_dom.items()):
+        out[dom] = {
+            "base_logits_cos": round(float(np.mean(d["base_cos"])), 6),
+            "markov_tf_top1_agreement": round(float(np.mean(d["tf_top1"])), 4),
+            "markov_tf_tv_overlap_T1": round(float(np.mean(d["tf_tv"])), 5),
+            "free_matched_prefix_len": round(float(np.mean(d["free_prefix"])), 2),
+            "conf_mean_abs_diff": round(float(np.mean(d["conf_abs_diff"])), 5),
+        }
+    return out
+
+
+def _bench_graph_us(fn, warmup: int = 15, iters: int = 80, inner: int = 4) -> float:
+    for _ in range(4):
+        fn()
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        for _ in range(inner):
+            fn()
+    for _ in range(warmup):
+        g.replay()
+    torch.cuda.synchronize()
+    starts = [torch.cuda.Event(enable_timing=True) for _ in range(iters)]
+    ends = [torch.cuda.Event(enable_timing=True) for _ in range(iters)]
+    for i in range(iters):
+        starts[i].record()
+        g.replay()
+        ends[i].record()
+    torch.cuda.synchronize()
+    times = sorted((s.elapsed_time(e) * 1000.0) / inner for s, e in zip(starts, ends))
+    return times[len(times) // 2]
+
+
+@torch.no_grad()
+def bench_tp2_cuda_graph_latency(
+    bf16_weights_file: Path,
+    k6_dir: Path,
+    head_k6_file: Path,
+    runtime: _Exl3DenseRuntime,
+    device: torch.device,
+) -> dict[str, Any]:
+    """Measure real GPU CUDA-Graph latency (ms) for TP2 Stage-3 DSpark (K=1, 7, 12).
+
+    Uses the exact engine wiring from Patch 0002:
+      - Phase 1: fc + zero-Q 4+4+2 grouped context-KV launches (skipping q_proj!)
+      - Phase 2: 5 Qwen3 GQA layers with 3-member fused qkv + 2-member fused gate_up
+      - Phase 3: shared target EXL3 K6 lm_head TP2 shard [81920, 7168]
+      - Phase 4: K sequential full-vocab EXL3 K6 markov_w2 [163840, 512] + FP32 conf
+    """
+    H = 7168
+    n_layers = 5
+    nq, nkv, head_dim = 48, 8, 64  # TP2 per rank
+    q_dim, kv_dim, mlp_dim = nq * head_dim, nkv * head_dim, 14336 // 2
+
+    def _rms(x: torch.Tensor, w: torch.Tensor) -> torch.Tensor:
+        xf = x.float()
+        return (xf * torch.rsqrt(xf.square().mean(dim=-1, keepdim=True) + 1e-5) * w.float()).to(x.dtype)
+
+    # Load TP2 rank-0 H128 slices directly from the quantized checkpoint.
+    k6_pk: dict[str, dict[str, torch.Tensor]] = {}
+    with safe_open(str(k6_dir / "model.safetensors"), framework="pt", device=str(device)) as sf:
+        for prefix in ("fc", "markov_head.markov_w2"):
+            k6_pk[prefix] = {
+                "trellis": sf.get_tensor(f"{prefix}.trellis").contiguous(),
+                "suh": sf.get_tensor(f"{prefix}.suh").contiguous(),
+                "svh": sf.get_tensor(f"{prefix}.svh").contiguous(),
+            }
+        for l in range(n_layers):
+            for suf, dim_out in (
+                ("self_attn.q_proj", q_dim),
+                ("self_attn.k_proj", kv_dim),
+                ("self_attn.v_proj", kv_dim),
+                ("mlp.gate_proj", mlp_dim),
+                ("mlp.up_proj", mlp_dim),
+            ):
+                p = f"layers.{l}.{suf}"
+                k6_pk[p] = {
+                    "trellis": sf.get_tensor(f"{p}.trellis")[:, : dim_out // 16, :].contiguous(),
+                    "suh": sf.get_tensor(f"{p}.suh").contiguous(),
+                    "svh": sf.get_tensor(f"{p}.svh")[:dim_out].contiguous(),
+                }
+            for suf, dim_in in (
+                ("self_attn.o_proj", q_dim),
+                ("mlp.down_proj", mlp_dim),
+            ):
+                p = f"layers.{l}.{suf}"
+                k6_pk[p] = {
+                    "trellis": sf.get_tensor(f"{p}.trellis")[: dim_in // 16, :, :].contiguous(),
+                    "suh": sf.get_tensor(f"{p}.suh")[:dim_in].contiguous(),
+                    "svh": sf.get_tensor(f"{p}.svh").contiguous(),
+                }
+        ln_w = sf.get_tensor("layers.0.input_layernorm.weight").contiguous()
+        conf_w = sf.get_tensor("confidence_head.proj.weight").float().contiguous()
+        conf_b = sf.get_tensor("confidence_head.proj.bias").float().contiguous()
+
+    with safe_open(str(head_k6_file), framework="pt", device=str(device)) as sf:
+        head_k6_tp2 = {
+            "trellis": sf.get_tensor("language_model.lm_head.trellis")[:, : 81920 // 16, :].contiguous(),
+            "suh": sf.get_tensor("language_model.lm_head.suh").contiguous(),
+            "svh": sf.get_tensor("language_model.lm_head.svh")[:81920].contiguous(),
+        }
+
+    # Build BF16 TP2 rank-0 weights for exact side-by-side latency comparison.
+    bf_qkv, bf_o, bf_gu, bf_down, bf_ctx_kv = [], [], [], [], []
+    with safe_open(str(bf16_weights_file), framework="pt", device=str(device)) as sf:
+        bf_fc = sf.get_tensor("fc.weight").contiguous()
+        bf_mw2 = sf.get_tensor("markov_head.markov_w2.weight").contiguous()
+        for l in range(n_layers):
+            wq = sf.get_tensor(f"layers.{l}.self_attn.q_proj.weight")[:q_dim].contiguous()
+            wk = sf.get_tensor(f"layers.{l}.self_attn.k_proj.weight")[:kv_dim].contiguous()
+            wv = sf.get_tensor(f"layers.{l}.self_attn.v_proj.weight")[:kv_dim].contiguous()
+            bf_qkv.append(torch.cat([wq, wk, wv], dim=0).contiguous())
+            bf_ctx_kv.extend([wk, wv])
+            bf_o.append(sf.get_tensor(f"layers.{l}.self_attn.o_proj.weight")[:, :q_dim].contiguous())
+            wg = sf.get_tensor(f"layers.{l}.mlp.gate_proj.weight")[:mlp_dim].contiguous()
+            wu = sf.get_tensor(f"layers.{l}.mlp.up_proj.weight")[:mlp_dim].contiguous()
+            bf_gu.append(torch.cat([wg, wu], dim=0).contiguous())
+            bf_down.append(sf.get_tensor(f"layers.{l}.mlp.down_proj.weight")[:, :mlp_dim].contiguous())
+    bf_ctx_kv_all = torch.cat(bf_ctx_kv, dim=0).contiguous()
+
+    # Zero-Q grouped context KV launches: 4+4+2 members across the 5 layers.
+    kv_members = []
+    for l in range(n_layers):
+        kv_members.append(k6_pk[f"layers.{l}.self_attn.k_proj"])
+        kv_members.append(k6_pk[f"layers.{l}.self_attn.v_proj"])
+    kv_groups = [kv_members[0:4], kv_members[4:8], kv_members[8:10]]
+
+    results: dict[str, Any] = {}
+    L_kv = 1024
+    for K in (1, 7, 12):
+        n_ctx = min(max(4, (K + 1) // 2), 8)
+        x_aux = torch.randn((n_ctx, 5 * H), dtype=torch.bfloat16, device=device)
+        c_out = torch.empty((n_ctx, H), dtype=torch.bfloat16, device=device)
+        kv_outs = [
+            torch.empty((n_ctx, len(g) * kv_dim), dtype=torch.bfloat16, device=device)
+            for g in kv_groups
+        ]
+
+        def p1_bf16():
+            c = F.linear(x_aux, bf_fc)
+            _ = F.linear(c, bf_ctx_kv_all)
+
+        def p1_k6():
+            runtime.linear_multi(x_aux, [k6_pk["fc"]], [H], c_out)
+            for g, o in zip(kv_groups, kv_outs):
+                runtime.linear_multi(c_out, g, [kv_dim] * len(g), o)
+
+        h_in = torch.randn((K, H), dtype=torch.bfloat16, device=device)
+        qkv_out = torch.empty((K, q_dim + 2 * kv_dim), dtype=torch.bfloat16, device=device)
+        o_out = torch.empty((K, H), dtype=torch.bfloat16, device=device)
+        gu_out = torch.empty((K, 2 * mlp_dim), dtype=torch.bfloat16, device=device)
+        dn_out = torch.empty((K, H), dtype=torch.bfloat16, device=device)
+        k_cache = torch.randn((1, nq, L_kv + K, head_dim), dtype=torch.bfloat16, device=device)
+        v_cache = torch.randn((1, nq, L_kv + K, head_dim), dtype=torch.bfloat16, device=device)
+        q_sdpa = torch.randn((1, nq, K, head_dim), dtype=torch.bfloat16, device=device)
+        attn_flat = torch.randn((K, q_dim), dtype=torch.bfloat16, device=device)
+
+        def p2_bf16():
+            h = h_in
+            for l in range(n_layers):
+                hn = _rms(h, ln_w)
+                _ = F.linear(hn, bf_qkv[l])
+                _ = F.scaled_dot_product_attention(q_sdpa, k_cache, v_cache, is_causal=False)
+                h = h + F.linear(attn_flat, bf_o[l])
+                hn2 = _rms(h, ln_w)
+                gu = F.linear(hn2, bf_gu[l])
+                g_p, u_p = gu.split([mlp_dim, mlp_dim], dim=-1)
+                h = h + F.linear(F.silu(g_p) * u_p, bf_down[l])
+
+        def p2_k6():
+            h = h_in
+            for l in range(n_layers):
+                hn = _rms(h, ln_w)
+                runtime.linear_multi(
+                    hn,
+                    [
+                        k6_pk[f"layers.{l}.self_attn.q_proj"],
+                        k6_pk[f"layers.{l}.self_attn.k_proj"],
+                        k6_pk[f"layers.{l}.self_attn.v_proj"],
+                    ],
+                    [q_dim, kv_dim, kv_dim],
+                    qkv_out,
+                )
+                _ = F.scaled_dot_product_attention(q_sdpa, k_cache, v_cache, is_causal=False)
+                runtime.linear_multi(attn_flat, [k6_pk[f"layers.{l}.self_attn.o_proj"]], [H], o_out)
+                h = h + o_out
+                hn2 = _rms(h, ln_w)
+                runtime.linear_multi(
+                    hn2,
+                    [k6_pk[f"layers.{l}.mlp.gate_proj"], k6_pk[f"layers.{l}.mlp.up_proj"]],
+                    [mlp_dim, mlp_dim],
+                    gu_out,
+                )
+                g_p, u_p = gu_out.split([mlp_dim, mlp_dim], dim=-1)
+                mid = (F.silu(g_p) * u_p).contiguous()
+                runtime.linear_multi(mid, [k6_pk[f"layers.{l}.mlp.down_proj"]], [H], dn_out)
+                h = h + dn_out
+
+        z_in = torch.randn((K, H), dtype=torch.bfloat16, device=device)
+        lm_out = torch.empty((K, 81920), dtype=torch.bfloat16, device=device)
+        p3_k6_us = _bench_graph_us(
+            lambda: runtime.linear_multi(z_in, [head_k6_tp2], [81920], lm_out)
+        )
+
+        me_1 = torch.randn((1, 512), dtype=torch.bfloat16, device=device)
+        mw2_out = torch.empty((1, 163840), dtype=torch.bfloat16, device=device)
+        base_lg = torch.randn((K, 163840), dtype=torch.bfloat16, device=device)
+        conf_in = torch.randn((K, 7680), dtype=torch.float32, device=device)
+
+        def p4_bf16():
+            for i in range(K):
+                b = F.linear(me_1, bf_mw2)
+                _ = (base_lg[i : i + 1] + b).argmax(dim=-1)
+            _ = torch.sigmoid(F.linear(conf_in, conf_w, conf_b))
+
+        def p4_k6():
+            for i in range(K):
+                runtime.linear_multi(me_1, [k6_pk["markov_head.markov_w2"]], [163840], mw2_out)
+                _ = (base_lg[i : i + 1] + mw2_out).argmax(dim=-1)
+            _ = torch.sigmoid(F.linear(conf_in, conf_w, conf_b))
+
+        p1_bf = _bench_graph_us(p1_bf16) / 1000.0
+        p1_k6_ms = _bench_graph_us(p1_k6) / 1000.0
+        p2_bf = _bench_graph_us(p2_bf16) / 1000.0
+        p2_k6_ms = _bench_graph_us(p2_k6) / 1000.0
+        p3_k6_ms = p3_k6_us / 1000.0
+        p4_bf = _bench_graph_us(p4_bf16) / 1000.0
+        p4_k6_ms = _bench_graph_us(p4_k6) / 1000.0
+
+        tot_bf = p1_bf + p2_bf + p3_k6_ms + p4_bf
+        tot_k6 = p1_k6_ms + p2_k6_ms + p3_k6_ms + p4_k6_ms
+        results[f"K{K}"] = {
+            "n_ctx": n_ctx,
+            "p1_bf16_ms": round(p1_bf, 3),
+            "p1_k6_zero_q_ms": round(p1_k6_ms, 3),
+            "p2_bf16_ms": round(p2_bf, 3),
+            "p2_k6_fused_ms": round(p2_k6_ms, 3),
+            "p3_shared_k6_head_ms": round(p3_k6_ms, 3),
+            "p4_bf16_ms": round(p4_bf, 3),
+            "p4_k6_full_vocab_ms": round(p4_k6_ms, 3),
+            "total_bf16_draft_k6_head_ms": round(tot_bf, 3),
+            "total_k6_draft_k6_head_ms": round(tot_k6, 3),
+            "speedup": round(tot_bf / max(tot_k6, 1e-6), 3),
+            "saved_ms": round(tot_bf - tot_k6, 3),
+        }
+        print(
+            f"  [GPU TP2 K={K:2d}] P1: {p1_bf:.3f}->{p1_k6_ms:.3f} | "
+            f"P2: {p2_bf:.3f}->{p2_k6_ms:.3f} | P3(K6 head): {p3_k6_ms:.3f} | "
+            f"P4: {p4_bf:.3f}->{p4_k6_ms:.3f} | TOTAL: {tot_bf:.3f} -> {tot_k6:.3f} ms "
+            f"({tot_bf / max(tot_k6, 1e-6):.2f}x, -{tot_bf - tot_k6:.3f} ms)",
+            flush=True,
+        )
+    return results
+
+
+def _summarize_delta(bf16_res: dict[str, Any], k6_res: dict[str, Any]) -> dict[str, Any]:
+    delta_buckets: dict[str, Any] = {}
+    for bucket in sorted(bf16_res["by_bucket"].keys()):
+        b_m = bf16_res["by_bucket"][bucket]
+        k_m = k6_res["by_bucket"][bucket]
+        row: dict[str, Any] = {"n_steps": b_m["n_steps"]}
+        for metric in (
+            "tokens_per_step_T0",
+            "tokens_per_step_T1_analytical",
+            "tokens_per_step_T1_mc",
+            "conf_auroc",
+            "conf_ece",
+            "conf_brier",
+            "conf_pred_mean",
+        ):
+            if metric in b_m and metric in k_m:
+                bv = float(b_m[metric])
+                kv = float(k_m[metric])
+                row[metric] = {
+                    "bf16": round(bv, 4) if math.isfinite(bv) else None,
+                    "k6": round(kv, 4) if math.isfinite(kv) else None,
+                    "delta": round(kv - bv, 4) if (math.isfinite(bv) and math.isfinite(kv)) else None,
+                }
+        delta_buckets[bucket] = row
+    out: dict[str, Any] = {"k_draft": bf16_res["k_draft"], "by_bucket": delta_buckets}
+    for pooled in ("pooled_T0_tokens_per_step", "pooled_T1_tokens_per_step"):
+        if pooled in bf16_res and pooled in k6_res:
+            bv = float(bf16_res[pooled])
+            kv = float(k6_res[pooled])
+            out[pooled] = {
+                "bf16": round(bv, 4),
+                "k6": round(kv, 4),
+                "delta": round(kv - bv, 4),
+            }
+    return out
+
+
