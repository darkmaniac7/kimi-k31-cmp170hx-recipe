+// ---------------------------------------------------------------------------
+// Public host API
+// ---------------------------------------------------------------------------
+
+std::pair<int64_t, std::vector<uint8_t>> create_local(
+    int64_t rank,
+    int64_t device_ordinal,
+    int64_t max_bytes,
+    const std::string& shm_name) {
+  TORCH_CHECK(rank == 0 || rank == 1, "k31_p2p: rank must be 0 or 1, got ", rank);
+  int dev_count = 0;
+  TORCH_CHECK(cudaGetDeviceCount(&dev_count) == cudaSuccess && device_ordinal >= 0 && device_ordinal < dev_count,
+              "k31_p2p: invalid device_ordinal ", device_ordinal, " (count=", dev_count, ")");
+  TORCH_CHECK(max_bytes >= 4096 && max_bytes <= kMaxSlotBytes,
+              "k31_p2p: max_bytes must be in [4096, ", kMaxSlotBytes, "], got ", max_bytes);
+
+  const uint64_t slot_bytes = (static_cast<uint64_t>(max_bytes) + 255ull) & ~255ull;
+  const size_t inbox_total = static_cast<size_t>(kNumSlots) * static_cast<size_t>(slot_bytes);
+  const size_t flags_total = static_cast<size_t>(kTotalFlagLines) * sizeof(FlagLine);
+
+  auto ctx = std::make_unique<P2PContext>();
+  ctx->rank = static_cast<int32_t>(rank);
+  ctx->device_ordinal = static_cast<int32_t>(device_ordinal);
+  ctx->pid = static_cast<int32_t>(getpid());
+  ctx->proc_nonce = get_process_nonce();
+  ctx->generation = g_handle_generation.fetch_add(1, std::memory_order_relaxed);
+  if (ctx->generation == 0u) {
+    ctx->generation = g_handle_generation.fetch_add(1, std::memory_order_relaxed);
+  }
+  ctx->slot_bytes = slot_bytes;
+  ctx->local_shm_name = sanitize_shm_name(shm_name, ctx->rank);
+
+  {
+    DeviceGuard guard(ctx->device_ordinal);
+    preload_kernels_for_device(ctx->device_ordinal);
+    TORCH_CHECK(cudaDeviceGetPCIBusId(ctx->pci_bus_id, static_cast<int>(kPciBusIdMax), ctx->device_ordinal) == cudaSuccess,
+                "k31_p2p: cudaDeviceGetPCIBusId failed");
+
+    cudaError_t err = cudaMalloc(reinterpret_cast<void**>(&ctx->dev_inbox), inbox_total);
+    TORCH_CHECK(err == cudaSuccess, "k31_p2p: cudaMalloc(inbox) failed: ", cudaGetErrorString(err));
+    err = cudaMalloc(reinterpret_cast<void**>(&ctx->dev_flags), flags_total);
+    if (err != cudaSuccess) { cleanup_context(ctx.get()); TORCH_CHECK(false, "cudaMalloc(flags) failed: ", cudaGetErrorString(err)); }
+    err = cudaMalloc(reinterpret_cast<void**>(&ctx->dev_ctrl), sizeof(DeviceControlState));
+    if (err != cudaSuccess) { cleanup_context(ctx.get()); TORCH_CHECK(false, "cudaMalloc(dev_ctrl) failed: ", cudaGetErrorString(err)); }
+
+    TORCH_CHECK(cudaMemset(ctx->dev_inbox, 0, inbox_total) == cudaSuccess, "cudaMemset(inbox) failed");
+    TORCH_CHECK(cudaMemset(ctx->dev_flags, 0, flags_total) == cudaSuccess, "cudaMemset(flags) failed");
+    TORCH_CHECK(cudaMemset(ctx->dev_ctrl, 0, sizeof(DeviceControlState)) == cudaSuccess, "cudaMemset(dev_ctrl) failed");
+    err = cudaStreamCreateWithFlags(&ctx->ctrl_stream, cudaStreamNonBlocking);
+    if (err != cudaSuccess) { cleanup_context(ctx.get()); TORCH_CHECK(false, "cudaStreamCreateWithFlags(ctrl_stream) failed: ", cudaGetErrorString(err)); }
+
+    err = cudaHostAlloc(reinterpret_cast<void**>(&ctx->host_ctrl), sizeof(HostMappedControl), cudaHostAllocMapped);
+    if (err != cudaSuccess) { cleanup_context(ctx.get()); TORCH_CHECK(false, "cudaHostAlloc(host_ctrl) failed: ", cudaGetErrorString(err)); }
+    std::memset(ctx->host_ctrl, 0, sizeof(HostMappedControl));
+    ctx->host_ctrl->generation = ctx->generation;
+    ctx->host_ctrl->timeout_ns = ctx->timeout_ns;
+    TORCH_CHECK(cudaHostGetDevicePointer(reinterpret_cast<void**>(&ctx->host_ctrl_dev), ctx->host_ctrl, 0) == cudaSuccess,
+                "cudaHostGetDevicePointer(host_ctrl) failed");
+    TORCH_CHECK(cudaMemcpy(&ctx->dev_ctrl->dev_generation, &ctx->host_ctrl->generation,
+                           sizeof(uint32_t), cudaMemcpyHostToDevice) == cudaSuccess,
+                "cudaMemcpy(dev_generation) failed");
+
+    cudaError_t ipc_e1 = cudaIpcGetMemHandle(&ctx->my_inbox_ipc, ctx->dev_inbox);
+    cudaError_t ipc_e2 = cudaIpcGetMemHandle(&ctx->my_flags_ipc, ctx->dev_flags);
+    if (ipc_e1 == cudaSuccess && ipc_e2 == cudaSuccess) {
+      ctx->has_ipc = 1;
+    } else {
+      cudaGetLastError();
+      ctx->has_ipc = 0;
+    }
+  }
+
+  PeerMeta meta = {};
+  meta.magic = kPeerMetaMagic;
+  meta.version = kPeerMetaVersion;
+  meta.rank = ctx->rank;
+  meta.device_ordinal = ctx->device_ordinal;
+  meta.pid = ctx->pid;
+  meta.has_ipc = ctx->has_ipc;
+  meta.proc_nonce = ctx->proc_nonce;
+  meta.slot_bytes = ctx->slot_bytes;
+  meta.inbox_raw_ptr = reinterpret_cast<uint64_t>(ctx->dev_inbox);
+  meta.flags_raw_ptr = reinterpret_cast<uint64_t>(ctx->dev_flags);
+  meta.inbox_ipc = ctx->my_inbox_ipc;
+  meta.flags_ipc = ctx->my_flags_ipc;
+  std::strncpy(meta.pci_bus_id, ctx->pci_bus_id, kPciBusIdMax - 1);
+  std::strncpy(meta.shm_name, ctx->local_shm_name.c_str(), kShmNameMax - 1);
+
+  int64_t handle = 0;
+  {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    int free_slot = -1;
+    for (int i = 0; i < kMaxHandles; ++i) {
+      if (!g_owned[i]) {
+        free_slot = i;
+        break;
+      }
+    }
+    if (free_slot < 0) {
+      cleanup_context(ctx.get());
+      TORCH_CHECK(false, "k31_p2p: handle table full (max ", kMaxHandles, ")");
+    }
+    uint64_t gen = g_gen_counter.fetch_add(1, std::memory_order_relaxed);
+    handle = static_cast<int64_t>((gen << 6) | static_cast<uint64_t>(free_slot));
+    ctx->handle_id = handle;
+    P2PContext* raw = ctx.get();
+    g_owned[free_slot] = std::move(ctx);
+    g_slots[free_slot].store(raw, std::memory_order_release);
+  }
+
+  std::vector<uint8_t> bytes(sizeof(PeerMeta));
+  std::memcpy(bytes.data(), &meta, sizeof(PeerMeta));
+  return {handle, std::move(bytes)};
+}
+
+int64_t connect_peer(
+    int64_t local_handle,
+    const uint8_t* peer_meta_ptr,
+    size_t peer_meta_len,
+    bool force_shm_arg) {
+  TORCH_CHECK(peer_meta_len == sizeof(PeerMeta),
+              "k31_p2p: peer_meta length mismatch (got ", peer_meta_len, ", expected ", sizeof(PeerMeta), ")");
+  PeerMeta peer = {};
+  std::memcpy(&peer, peer_meta_ptr, sizeof(PeerMeta));
+  TORCH_CHECK(peer.magic == kPeerMetaMagic && peer.version == kPeerMetaVersion,
+              "k31_p2p: invalid peer_meta header");
+
+  std::lock_guard<std::mutex> lock(g_mutex);
+  P2PContext* ctx = lookup_fast(local_handle);
+  TORCH_CHECK(!ctx->connected, "k31_p2p: handle ", local_handle, " is already connected");
+  TORCH_CHECK(peer.rank == (1 - ctx->rank),
+              "k31_p2p: expected peer rank ", (1 - ctx->rank), ", got ", peer.rank);
+  TORCH_CHECK(peer.slot_bytes == ctx->slot_bytes,
+              "k31_p2p: slot_bytes mismatch (local=", ctx->slot_bytes, ", peer=", peer.slot_bytes, ")");
+
+  DeviceGuard guard(ctx->device_ordinal);
+  const bool force_shm = force_shm_arg || env_force_shm();
+  // Same-process detection uses random 64-bit process nonce, never raw PIDs (M2).
+  const bool same_proc = (peer.proc_nonce == ctx->proc_nonce);
+
+  // Case 1: Same process (loopback on same GPU or same-process multi-GPU P2P).
+  if (same_proc && !force_shm) {
+    if (std::strncmp(peer.pci_bus_id, ctx->pci_bus_id, kPciBusIdMax) == 0) {
+      ctx->peer_device_ordinal = ctx->device_ordinal;
+      ctx->active_my_inbox = ctx->dev_inbox;
+      ctx->active_my_flags = ctx->dev_flags;
+      ctx->active_peer_inbox = reinterpret_cast<uint8_t*>(peer.inbox_raw_ptr);
+      ctx->active_peer_flags = reinterpret_cast<FlagLine*>(peer.flags_raw_ptr);
+      ctx->transport = TransportMode::LOOPBACK;
+      ctx->connected = true;
+      return local_handle;
+    }
+    int peer_local_dev = peer.device_ordinal;
+    int can_p2p = 0;
+    if (cudaDeviceGetByPCIBusId(&peer_local_dev, peer.pci_bus_id) == cudaSuccess &&
+        cudaDeviceCanAccessPeer(&can_p2p, ctx->device_ordinal, peer_local_dev) == cudaSuccess &&
+        can_p2p == 1) {
+      cudaError_t pe = cudaDeviceEnablePeerAccess(peer_local_dev, 0);
+      if (pe == cudaErrorPeerAccessAlreadyEnabled) {
+        cudaGetLastError();
+        pe = cudaSuccess;
+      }
+      if (pe == cudaSuccess) {
+        ctx->peer_device_ordinal = peer_local_dev;
+        ctx->active_my_inbox = ctx->dev_inbox;
+        ctx->active_my_flags = ctx->dev_flags;
+        ctx->active_peer_inbox = reinterpret_cast<uint8_t*>(peer.inbox_raw_ptr);
+        ctx->active_peer_flags = reinterpret_cast<FlagLine*>(peer.flags_raw_ptr);
+        ctx->transport = TransportMode::SAME_PROC_P2P;
+        ctx->connected = true;
+        return local_handle;
+      }
+      cudaGetLastError();
+    } else {
+      cudaGetLastError();
+    }
+  }
+
+  // Case 2: Cross-process direct PCIe BAR1 P2P IPC.
+  if (!same_proc && !force_shm && ctx->has_ipc && peer.has_ipc) {
+    int peer_local_dev = -1;
+    int can_p2p = 0;
+    bool same_gpu = (std::strncmp(peer.pci_bus_id, ctx->pci_bus_id, kPciBusIdMax) == 0);
+    if (!same_gpu &&
+        cudaDeviceGetByPCIBusId(&peer_local_dev, peer.pci_bus_id) == cudaSuccess &&
+        cudaDeviceCanAccessPeer(&can_p2p, ctx->device_ordinal, peer_local_dev) == cudaSuccess &&
+        can_p2p == 1) {
+      cudaError_t pe = cudaDeviceEnablePeerAccess(peer_local_dev, 0);
+      if (pe == cudaErrorPeerAccessAlreadyEnabled) {
+        cudaGetLastError();
+        pe = cudaSuccess;
+      }
+      if (pe == cudaSuccess) {
+        void* p_inbox = nullptr;
+        void* p_flags = nullptr;
+        cudaError_t e1 = cudaIpcOpenMemHandle(&p_inbox, peer.inbox_ipc, cudaIpcMemLazyEnablePeerAccess);
+        cudaError_t e2 = (e1 == cudaSuccess)
+            ? cudaIpcOpenMemHandle(&p_flags, peer.flags_ipc, cudaIpcMemLazyEnablePeerAccess)
+            : e1;
+        if (e1 == cudaSuccess && e2 == cudaSuccess) {
+          ctx->peer_device_ordinal = peer_local_dev;
+          ctx->ipc_peer_inbox = p_inbox;
+          ctx->ipc_peer_flags = p_flags;
+          ctx->active_my_inbox = ctx->dev_inbox;
+          ctx->active_my_flags = ctx->dev_flags;
+          ctx->active_peer_inbox = reinterpret_cast<uint8_t*>(p_inbox);
+          ctx->active_peer_flags = reinterpret_cast<FlagLine*>(p_flags);
+          ctx->transport = TransportMode::P2P_IPC;
+          ctx->connected = true;
+          return local_handle;
+        }
+        if (p_inbox) cudaIpcCloseMemHandle(p_inbox);
+        if (p_flags) cudaIpcCloseMemHandle(p_flags);
+        cudaGetLastError();
+      } else {
+        cudaGetLastError();
+      }
+    } else {
+      cudaGetLastError();
+    }
+  }
+
+  // Case 3: Zero-copy mapped POSIX SHM fallback with per-launch nonce isolation.
+  const std::string eff_shm = (ctx->rank == 0) ? ctx->local_shm_name : std::string(peer.shm_name);
+  TORCH_CHECK(!eff_shm.empty() && eff_shm[0] == '/',
+              "k31_p2p: invalid SHM name for fallback: '", eff_shm, "'");
+
+  const size_t inbox_total = static_cast<size_t>(kNumSlots) * static_cast<size_t>(ctx->slot_bytes);
+  const size_t flags_total = static_cast<size_t>(kTotalFlagLines) * sizeof(FlagLine);
+  const size_t rank_region = ((inbox_total + flags_total) + 4095ull) & ~4095ull;
+  const size_t total_shm = 2ull * rank_region;
+
+  int fd = -1;
+  if (same_proc) {
+    fd = shm_open(eff_shm.c_str(), O_CREAT | O_EXCL | O_RDWR, 0600);
+    if (fd >= 0) {
+      if (ftruncate(fd, static_cast<off_t>(total_shm)) != 0) {
+        int saved = errno;
+        close(fd);
+        shm_unlink(eff_shm.c_str());
+        TORCH_CHECK(false, "k31_p2p: ftruncate(", eff_shm, ", ", total_shm, ") failed: ", std::strerror(saved));
+      }
+    } else if (errno == EEXIST) {
+      fd = shm_open(eff_shm.c_str(), O_RDWR, 0600);
+      TORCH_CHECK(fd >= 0, "k31_p2p: shm_open(", eff_shm, ") failed: ", std::strerror(errno));
+    } else {
+      TORCH_CHECK(false, "k31_p2p: shm_open(", eff_shm, ") failed: ", std::strerror(errno));
+    }
+  } else if (ctx->rank == 0) {
+    shm_unlink(eff_shm.c_str());
+    for (int attempt = 0; attempt < 3; ++attempt) {
+      fd = shm_open(eff_shm.c_str(), O_CREAT | O_EXCL | O_RDWR, 0600);
+      if (fd >= 0) break;
+      if (errno == EEXIST) {
+        shm_unlink(eff_shm.c_str());
+        continue;
+      }
+      break;
+    }
+    TORCH_CHECK(fd >= 0, "k31_p2p: rank 0 shm_open(O_CREAT|O_EXCL, ", eff_shm, ") failed: ", std::strerror(errno));
+    if (ftruncate(fd, static_cast<off_t>(total_shm)) != 0) {
+      int saved = errno;
+      close(fd);
+      shm_unlink(eff_shm.c_str());
+      TORCH_CHECK(false, "k31_p2p: ftruncate(", eff_shm, ", ", total_shm, ") failed: ", std::strerror(saved));
+    }
+  } else {
+    const int max_wait_ms = 10000;
+    int last_err = ENOENT;
+    for (int waited = 0; waited < max_wait_ms; ++waited) {
+      fd = shm_open(eff_shm.c_str(), O_RDWR, 0600);
+      if (fd >= 0) break;
+      last_err = errno;
+      if (last_err != ENOENT) break;
+      usleep(1000);
+    }
+    TORCH_CHECK(fd >= 0, "k31_p2p: rank 1 shm_open(", eff_shm, ") failed after waiting for rank 0: ",
+                std::strerror(last_err));
+    struct stat st = {};
+    bool sized = false;
+    for (int waited = 0; waited < max_wait_ms; ++waited) {
+      if (fstat(fd, &st) == 0 && static_cast<size_t>(st.st_size) >= total_shm) {
+        sized = true;
+        break;
+      }
+      usleep(1000);
+    }
+    if (!sized) {
+      close(fd);
+      TORCH_CHECK(false, "k31_p2p: rank 1 timed out waiting for ftruncate on ", eff_shm,
+                  " (got ", static_cast<size_t>(st.st_size), ", expected ", total_shm, ")");
+    }
+  }
+
+  void* host_ptr = mmap(nullptr, total_shm, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+  if (host_ptr == MAP_FAILED) {
+    int saved = errno;
+    close(fd);
+    if (ctx->rank == 0) shm_unlink(eff_shm.c_str());
+    TORCH_CHECK(false, "k31_p2p: mmap(", eff_shm, ") failed: ", std::strerror(saved));
+  }
+  cudaError_t reg_err = cudaHostRegister(host_ptr, total_shm, cudaHostRegisterMapped);
+  if (reg_err != cudaSuccess) {
+    munmap(host_ptr, total_shm);
+    close(fd);
+    if (ctx->rank == 0) shm_unlink(eff_shm.c_str());
+    TORCH_CHECK(false, "k31_p2p: cudaHostRegister failed: ", cudaGetErrorString(reg_err));
+  }
+  void* dev_base = nullptr;
+  cudaError_t ptr_err = cudaHostGetDevicePointer(&dev_base, host_ptr, 0);
+  if (ptr_err != cudaSuccess) {
+    cudaHostUnregister(host_ptr);
+    munmap(host_ptr, total_shm);
+    close(fd);
+    if (ctx->rank == 0) shm_unlink(eff_shm.c_str());
+    TORCH_CHECK(false, "k31_p2p: cudaHostGetDevicePointer failed: ", cudaGetErrorString(ptr_err));
+  }
+
+  uint8_t* base_u8 = reinterpret_cast<uint8_t*>(dev_base);
+  uint8_t* r0_base = base_u8;
+  uint8_t* r1_base = base_u8 + rank_region;
+  uint8_t* my_base = (ctx->rank == 0) ? r0_base : r1_base;
+  uint8_t* peer_base = (ctx->rank == 0) ? r1_base : r0_base;
+
+  ctx->active_shm_name = eff_shm;
+  ctx->shm_fd = fd;
+  ctx->shm_host_ptr = host_ptr;
+  ctx->shm_total_bytes = total_shm;
+  ctx->shm_registered = true;
+  ctx->peer_device_ordinal = peer.device_ordinal;
+  ctx->active_my_inbox = my_base;
+  ctx->active_my_flags = reinterpret_cast<FlagLine*>(my_base + inbox_total);
+  ctx->active_peer_inbox = peer_base;
+  ctx->active_peer_flags = reinterpret_cast<FlagLine*>(peer_base + inbox_total);
+  ctx->transport = TransportMode::SHM_ZERO_COPY;
+  ctx->connected = true;
+  return local_handle;
+}
+
+std::pair<int64_t, int64_t> create_loopback_pair(int64_t device_ordinal, int64_t max_bytes) {
+  auto [h0, m0] = create_local(0, device_ordinal, max_bytes, "");
+  auto [h1, m1] = create_local(1, device_ordinal, max_bytes, "");
+  connect_peer(h0, m1.data(), m1.size());
+  connect_peer(h1, m0.data(), m0.size());
+  return {h0, h1};
+}
+
+void set_timeout_ms(int64_t handle, int64_t timeout_ms) {
+  TORCH_CHECK(timeout_ms >= 0, "k31_p2p: timeout_ms must be >= 0");
+  P2PContext* ctx = lookup_fast(handle);
+  uint64_t ns = static_cast<uint64_t>(timeout_ms) * 1000000ull;
+  ctx->timeout_ns = ns;
+  __atomic_store_n(&ctx->host_ctrl->timeout_ns, ns, __ATOMIC_RELEASE);
+}
+
+void set_abort(int64_t handle) {
+  P2PContext* ctx = lookup_fast(handle);
+  __atomic_store_n(&ctx->host_ctrl->abort_flag, 1u, __ATOMIC_RELEASE);
+  mirror_ctrl_to_device(ctx, &ctx->dev_ctrl->dev_abort_flag, &ctx->host_ctrl->abort_flag);
+}
+
+void clear_abort(int64_t handle) {
+  P2PContext* ctx = lookup_fast(handle);
+  __atomic_store_n(&ctx->host_ctrl->abort_flag, 0u, __ATOMIC_RELEASE);
+  mirror_ctrl_to_device(ctx, &ctx->dev_ctrl->dev_abort_flag, &ctx->host_ctrl->abort_flag);
+}
+
+int64_t check_error(int64_t handle) {
+  P2PContext* ctx = lookup_fast(handle);
+  return static_cast<int64_t>(__atomic_load_n(&ctx->host_ctrl->err_code, __ATOMIC_ACQUIRE));
+}
+
+void clear_error(int64_t handle) {
+  P2PContext* ctx = lookup_fast(handle);
+  __atomic_store_n(&ctx->host_ctrl->err_code, 0u, __ATOMIC_RELEASE);
+  mirror_ctrl_to_device(ctx, &ctx->dev_ctrl->dev_err_code, &ctx->host_ctrl->err_code);
+}
+
+HandleInfo get_handle_info(int64_t handle) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  P2PContext* ctx = lookup_fast(handle);
+  HandleInfo info;
+  info.rank = ctx->rank;
+  info.device_ordinal = ctx->device_ordinal;
+  info.peer_device_ordinal = ctx->peer_device_ordinal;
+  info.num_slots = kNumSlots;
+  info.slot_bytes = ctx->slot_bytes;
+  info.timeout_ms = __atomic_load_n(&ctx->host_ctrl->timeout_ns, __ATOMIC_ACQUIRE) / 1000000ull;
+  info.error_code = __atomic_load_n(&ctx->host_ctrl->err_code, __ATOMIC_ACQUIRE);
+  info.aborted = __atomic_load_n(&ctx->host_ctrl->abort_flag, __ATOMIC_ACQUIRE);
+  info.generation = __atomic_load_n(&ctx->host_ctrl->generation, __ATOMIC_ACQUIRE);
+  info.proc_nonce = ctx->proc_nonce;
+  info.connected = ctx->connected;
+  info.transport = transport_name(ctx->transport);
+  info.shm_name = !ctx->active_shm_name.empty() ? ctx->active_shm_name : ctx->local_shm_name;
+  return info;
+}
+
+void close_peer_imports(int64_t handle) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  int slot = static_cast<int>(handle & 0x3F);
+  P2PContext* ctx = g_slots[slot].load(std::memory_order_acquire);
+  if (ctx == nullptr || ctx->handle_id != handle) {
+    return;
+  }
+  close_peer_imports_unlocked(ctx);
+}
+
+void destroy(int64_t handle) {
+  std::unique_ptr<P2PContext> victim;
+  {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    int slot = static_cast<int>(handle & 0x3F);
+    P2PContext* ctx = g_slots[slot].load(std::memory_order_acquire);
+    if (ctx == nullptr || ctx->handle_id != handle) {
+      return;
+    }
+    g_slots[slot].store(nullptr, std::memory_order_release);
+    victim = std::move(g_owned[slot]);
+  }
+  cleanup_context(victim.get());
+}
+
+// ---------------------------------------------------------------------------
+// Hot-path CUDA ops (zero mutex, zero host sync, 100% CUDA-Graph safe)
+// ---------------------------------------------------------------------------
+
+void p2p_allreduce_residual(
+    int64_t handle,
+    const at::Tensor& x_partial,
+    at::Tensor out_sum,
+    const std::optional<at::Tensor>& residual,
+    const std::optional<at::Tensor>& out_res) {
+  P2PContext* ctx = lookup_fast(handle);
+  TORCH_CHECK(ctx->connected, "k31_p2p: handle not connected");
+  TORCH_CHECK(x_partial.is_cuda() && out_sum.is_cuda(), "k31_p2p: tensors must be CUDA");
+  TORCH_CHECK(x_partial.device().index() == ctx->device_ordinal &&
+                  out_sum.device().index() == ctx->device_ordinal,
+              "k31_p2p: tensor device != handle device (", ctx->device_ordinal, ")");
+  TORCH_CHECK(x_partial.scalar_type() == at::kBFloat16 && out_sum.scalar_type() == at::kBFloat16,
+              "k31_p2p: x_partial and out_sum must be bfloat16");
+  TORCH_CHECK(x_partial.is_contiguous() && out_sum.is_contiguous(),
+              "k31_p2p: x_partial and out_sum must be contiguous");
+  TORCH_CHECK(x_partial.dim() == 2 && out_sum.sizes() == x_partial.sizes(),
+              "k31_p2p: x_partial and out_sum must be 2D with matching shapes");
+
+  const int64_t M = x_partial.size(0);
+  const int64_t D = x_partial.size(1);
+  TORCH_CHECK((D % 8) == 0, "k31_p2p: D must be a multiple of 8, got ", D);
+
+  const bool has_res = residual.has_value() || out_res.has_value();
+  const uint4* res_ptr = nullptr;
+  uint4* out_res_ptr = nullptr;
+  bool write_sum = true;
+  if (has_res) {
+    TORCH_CHECK(residual.has_value() && out_res.has_value(),
+                "k31_p2p: both residual and out_res must be provided together");
+    const auto& r = *residual;
+    const auto& or_t = *out_res;
+    TORCH_CHECK(r.is_cuda() && or_t.is_cuda(), "k31_p2p: residual and out_res must be CUDA");
+    TORCH_CHECK(r.device().index() == ctx->device_ordinal &&
+                    or_t.device().index() == ctx->device_ordinal,
+                "k31_p2p: residual/out_res device != handle device");
+    TORCH_CHECK(r.scalar_type() == at::kBFloat16 && or_t.scalar_type() == at::kBFloat16,
+                "k31_p2p: residual and out_res must be bfloat16");
+    TORCH_CHECK(r.is_contiguous() && or_t.is_contiguous(),
+                "k31_p2p: residual and out_res must be contiguous");
+    TORCH_CHECK(r.sizes() == x_partial.sizes() && or_t.sizes() == x_partial.sizes(),
+                "k31_p2p: residual and out_res shapes must match x_partial");
+    res_ptr = reinterpret_cast<const uint4*>(r.data_ptr());
+    out_res_ptr = reinterpret_cast<uint4*>(or_t.data_ptr());
+    TORCH_CHECK((reinterpret_cast<uintptr_t>(res_ptr) & 15u) == 0u &&
+                    (reinterpret_cast<uintptr_t>(out_res_ptr) & 15u) == 0u,
+                "k31_p2p: residual and out_res must be 16-byte aligned");
+    write_sum = (out_sum.data_ptr() != or_t.data_ptr());
+  }
+
+  if (M == 0 || D == 0) {
+    return;
+  }
+
+  const int64_t total_vecs = (M * D) / 8;
+  const uint4* x_ptr = reinterpret_cast<const uint4*>(x_partial.data_ptr());
+  uint4* sum_ptr = reinterpret_cast<uint4*>(out_sum.data_ptr());
+  TORCH_CHECK((reinterpret_cast<uintptr_t>(x_ptr) & 15u) == 0u &&
+              (reinterpret_cast<uintptr_t>(sum_ptr) & 15u) == 0u,
+              "k31_p2p: x_partial and out_sum must be 16-byte aligned");
+
+  c10::cuda::CUDAGuard device_guard(x_partial.device());
+  cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+  const bool is_shm = (ctx->transport == TransportMode::SHM_ZERO_COPY);
+
+  if (ctx->rank == 0) {
+    if (!is_shm) {
+      if (!has_res) launch_allreduce_impl<0, false, false>(ctx, x_ptr, res_ptr, sum_ptr, out_res_ptr, total_vecs, write_sum, stream);
+      else          launch_allreduce_impl<0, false, true >(ctx, x_ptr, res_ptr, sum_ptr, out_res_ptr, total_vecs, write_sum, stream);
+    } else {
+      if (!has_res) launch_allreduce_impl<0, true,  false>(ctx, x_ptr, res_ptr, sum_ptr, out_res_ptr, total_vecs, write_sum, stream);
+      else          launch_allreduce_impl<0, true,  true >(ctx, x_ptr, res_ptr, sum_ptr, out_res_ptr, total_vecs, write_sum, stream);
+    }
+  } else {
+    if (!is_shm) {
+      if (!has_res) launch_allreduce_impl<1, false, false>(ctx, x_ptr, res_ptr, sum_ptr, out_res_ptr, total_vecs, write_sum, stream);
+      else          launch_allreduce_impl<1, false, true >(ctx, x_ptr, res_ptr, sum_ptr, out_res_ptr, total_vecs, write_sum, stream);
+    } else {
+      if (!has_res) launch_allreduce_impl<1, true,  false>(ctx, x_ptr, res_ptr, sum_ptr, out_res_ptr, total_vecs, write_sum, stream);
+      else          launch_allreduce_impl<1, true,  true >(ctx, x_ptr, res_ptr, sum_ptr, out_res_ptr, total_vecs, write_sum, stream);
+    }
+  }
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void p2p_moe_dual_reduce_rmsnorm(
+    int64_t handle,
+    const at::Tensor& routed_partial,
+    const at::Tensor& shared_partial,
+    const at::Tensor& rms_weight,
+    double eps,
+    at::Tensor out_routed_normed,
+    at::Tensor out_shared_sum,
+    const std::optional<at::Tensor>& residual,
+    const std::optional<at::Tensor>& out_shared_res) {
+  P2PContext* ctx = lookup_fast(handle);
+  TORCH_CHECK(ctx->connected, "k31_p2p: handle not connected");
+  TORCH_CHECK(routed_partial.is_cuda() && shared_partial.is_cuda() &&
+              rms_weight.is_cuda() && out_routed_normed.is_cuda() && out_shared_sum.is_cuda(),
+              "k31_p2p: all tensors must be CUDA");
+  TORCH_CHECK(routed_partial.device().index() == ctx->device_ordinal &&
+              shared_partial.device().index() == ctx->device_ordinal &&
+              rms_weight.device().index() == ctx->device_ordinal &&
+              out_routed_normed.device().index() == ctx->device_ordinal &&
+              out_shared_sum.device().index() == ctx->device_ordinal,
+              "k31_p2p: all tensors must be on handle device (", ctx->device_ordinal, ")");
+  TORCH_CHECK(routed_partial.scalar_type() == at::kBFloat16 &&
+              shared_partial.scalar_type() == at::kBFloat16 &&
+              out_routed_normed.scalar_type() == at::kBFloat16 &&
+              out_shared_sum.scalar_type() == at::kBFloat16,
+              "k31_p2p: routed/shared partials and outputs must be bfloat16");
+  TORCH_CHECK(rms_weight.scalar_type() == at::kBFloat16 || rms_weight.scalar_type() == at::kFloat,
+              "k31_p2p: rms_weight must be bfloat16 or float32");
+  TORCH_CHECK(routed_partial.is_contiguous() && shared_partial.is_contiguous() &&
+              rms_weight.is_contiguous() && out_routed_normed.is_contiguous() &&
+              out_shared_sum.is_contiguous(),
+              "k31_p2p: all tensors must be contiguous");
+  TORCH_CHECK(routed_partial.dim() == 2 && shared_partial.dim() == 2 && rms_weight.dim() == 1,
+              "k31_p2p: expected 2D partials and 1D rms_weight");
+
+  const int64_t M = routed_partial.size(0);
+  const int64_t H_r = routed_partial.size(1);
+  const int64_t H_s = shared_partial.size(1);
+  TORCH_CHECK(shared_partial.size(0) == M, "k31_p2p: routed and shared row count mismatch");
+  TORCH_CHECK(rms_weight.size(0) == H_r, "k31_p2p: rms_weight length must equal H_r");
+  TORCH_CHECK(out_routed_normed.sizes() == routed_partial.sizes(), "k31_p2p: out_routed_normed shape mismatch");
+  TORCH_CHECK(out_shared_sum.sizes() == shared_partial.sizes(), "k31_p2p: out_shared_sum shape mismatch");
+  TORCH_CHECK((H_r % 8) == 0 && (H_s % 8) == 0, "k31_p2p: H_r and H_s must be multiples of 8");
+
+  const bool has_res = residual.has_value() || out_shared_res.has_value();
+  const uint4* res_ptr = nullptr;
+  uint4* out_sr_ptr = nullptr;
+  bool write_shared_sum = true;
+  if (has_res) {
+    TORCH_CHECK(residual.has_value() && out_shared_res.has_value(),
+                "k31_p2p: both residual and out_shared_res must be provided together");
+    const auto& r = *residual;
+    const auto& osr = *out_shared_res;
+    TORCH_CHECK(r.is_cuda() && osr.is_cuda() && r.is_contiguous() && osr.is_contiguous(),
+                "k31_p2p: residual and out_shared_res must be contiguous CUDA tensors");
+    TORCH_CHECK(r.device().index() == ctx->device_ordinal &&
+                osr.device().index() == ctx->device_ordinal,
+                "k31_p2p: residual and out_shared_res must be on handle device");
+    TORCH_CHECK(r.scalar_type() == at::kBFloat16 && osr.scalar_type() == at::kBFloat16,
+                "k31_p2p: residual and out_shared_res must be bfloat16");
+    TORCH_CHECK(r.sizes() == shared_partial.sizes() && osr.sizes() == shared_partial.sizes(),
+                "k31_p2p: residual and out_shared_res must match shared_partial shape");
+    res_ptr = reinterpret_cast<const uint4*>(r.data_ptr());
+    out_sr_ptr = reinterpret_cast<uint4*>(osr.data_ptr());
+    TORCH_CHECK((reinterpret_cast<uintptr_t>(res_ptr) & 15u) == 0u &&
+                (reinterpret_cast<uintptr_t>(out_sr_ptr) & 15u) == 0u,
+                "k31_p2p: residual and out_shared_res must be 16-byte aligned");
+    write_shared_sum = (out_shared_sum.data_ptr() != osr.data_ptr());
+  }
+
+  if (M == 0) {
+    return;
+  }
+
+  const uint4* routed_ptr = reinterpret_cast<const uint4*>(routed_partial.data_ptr());
+  const uint4* shared_ptr = reinterpret_cast<const uint4*>(shared_partial.data_ptr());
+  uint4* out_r_ptr = reinterpret_cast<uint4*>(out_routed_normed.data_ptr());
+  uint4* out_s_ptr = reinterpret_cast<uint4*>(out_shared_sum.data_ptr());
+  const void* w_ptr = rms_weight.data_ptr();
+  TORCH_CHECK((reinterpret_cast<uintptr_t>(routed_ptr) & 15u) == 0u &&
+              (reinterpret_cast<uintptr_t>(shared_ptr) & 15u) == 0u &&
+              (reinterpret_cast<uintptr_t>(out_r_ptr) & 15u) == 0u &&
+              (reinterpret_cast<uintptr_t>(out_s_ptr) & 15u) == 0u &&
+              (reinterpret_cast<uintptr_t>(w_ptr) & 15u) == 0u,
+              "k31_p2p: routed/shared partials, outputs, and rms_weight must be 16-byte aligned");
+
+  c10::cuda::CUDAGuard device_guard(routed_partial.device());
+  cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+
+  const bool is_shm = (ctx->transport == TransportMode::SHM_ZERO_COPY);
+  const bool w_fp32 = (rms_weight.scalar_type() == at::kFloat);
+  const float eps_f = static_cast<float>(eps);
+  const int r_vecs = static_cast<int>(H_r / 8);
+  const int s_vecs = static_cast<int>(H_s / 8);
+
+  const int key = (ctx->rank << 3) | (is_shm ? 4 : 0) | (has_res ? 2 : 0) | (w_fp32 ? 1 : 0);
+  switch (key) {
+    case  0: launch_moe_dual_impl<0, false, false, false>(ctx, routed_ptr, shared_ptr, w_ptr, res_ptr, out_r_ptr, out_s_ptr, out_sr_ptr, static_cast<int>(M), r_vecs, s_vecs, eps_f, write_shared_sum, stream); break;
+    case  1: launch_moe_dual_impl<0, false, false, true >(ctx, routed_ptr, shared_ptr, w_ptr, res_ptr, out_r_ptr, out_s_ptr, out_sr_ptr, static_cast<int>(M), r_vecs, s_vecs, eps_f, write_shared_sum, stream); break;
+    case  2: launch_moe_dual_impl<0, false, true,  false>(ctx, routed_ptr, shared_ptr, w_ptr, res_ptr, out_r_ptr, out_s_ptr, out_sr_ptr, static_cast<int>(M), r_vecs, s_vecs, eps_f, write_shared_sum, stream); break;
+    case  3: launch_moe_dual_impl<0, false, true,  true >(ctx, routed_ptr, shared_ptr, w_ptr, res_ptr, out_r_ptr, out_s_ptr, out_sr_ptr, static_cast<int>(M), r_vecs, s_vecs, eps_f, write_shared_sum, stream); break;
+    case  4: launch_moe_dual_impl<0, true,  false, false>(ctx, routed_ptr, shared_ptr, w_ptr, res_ptr, out_r_ptr, out_s_ptr, out_sr_ptr, static_cast<int>(M), r_vecs, s_vecs, eps_f, write_shared_sum, stream); break;
+    case  5: launch_moe_dual_impl<0, true,  false, true >(ctx, routed_ptr, shared_ptr, w_ptr, res_ptr, out_r_ptr, out_s_ptr, out_sr_ptr, static_cast<int>(M), r_vecs, s_vecs, eps_f, write_shared_sum, stream); break;
+    case  6: launch_moe_dual_impl<0, true,  true,  false>(ctx, routed_ptr, shared_ptr, w_ptr, res_ptr, out_r_ptr, out_s_ptr, out_sr_ptr, static_cast<int>(M), r_vecs, s_vecs, eps_f, write_shared_sum, stream); break;
+    case  7: launch_moe_dual_impl<0, true,  true,  true >(ctx, routed_ptr, shared_ptr, w_ptr, res_ptr, out_r_ptr, out_s_ptr, out_sr_ptr, static_cast<int>(M), r_vecs, s_vecs, eps_f, write_shared_sum, stream); break;
+    case  8: launch_moe_dual_impl<1, false, false, false>(ctx, routed_ptr, shared_ptr, w_ptr, res_ptr, out_r_ptr, out_s_ptr, out_sr_ptr, static_cast<int>(M), r_vecs, s_vecs, eps_f, write_shared_sum, stream); break;
+    case  9: launch_moe_dual_impl<1, false, false, true >(ctx, routed_ptr, shared_ptr, w_ptr, res_ptr, out_r_ptr, out_s_ptr, out_sr_ptr, static_cast<int>(M), r_vecs, s_vecs, eps_f, write_shared_sum, stream); break;
+    case 10: launch_moe_dual_impl<1, false, true,  false>(ctx, routed_ptr, shared_ptr, w_ptr, res_ptr, out_r_ptr, out_s_ptr, out_sr_ptr, static_cast<int>(M), r_vecs, s_vecs, eps_f, write_shared_sum, stream); break;
+    case 11: launch_moe_dual_impl<1, false, true,  true >(ctx, routed_ptr, shared_ptr, w_ptr, res_ptr, out_r_ptr, out_s_ptr, out_sr_ptr, static_cast<int>(M), r_vecs, s_vecs, eps_f, write_shared_sum, stream); break;
+    case 12: launch_moe_dual_impl<1, true,  false, false>(ctx, routed_ptr, shared_ptr, w_ptr, res_ptr, out_r_ptr, out_s_ptr, out_sr_ptr, static_cast<int>(M), r_vecs, s_vecs, eps_f, write_shared_sum, stream); break;
+    case 13: launch_moe_dual_impl<1, true,  false, true >(ctx, routed_ptr, shared_ptr, w_ptr, res_ptr, out_r_ptr, out_s_ptr, out_sr_ptr, static_cast<int>(M), r_vecs, s_vecs, eps_f, write_shared_sum, stream); break;
+    case 14: launch_moe_dual_impl<1, true,  true,  false>(ctx, routed_ptr, shared_ptr, w_ptr, res_ptr, out_r_ptr, out_s_ptr, out_sr_ptr, static_cast<int>(M), r_vecs, s_vecs, eps_f, write_shared_sum, stream); break;
+    case 15: launch_moe_dual_impl<1, true,  true,  true >(ctx, routed_ptr, shared_ptr, w_ptr, res_ptr, out_r_ptr, out_s_ptr, out_sr_ptr, static_cast<int>(M), r_vecs, s_vecs, eps_f, write_shared_sum, stream); break;
+  }
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void p2p_pp_send(int64_t handle, const at::Tensor& src, int64_t tag) {
+  P2PContext* ctx = lookup_fast(handle);
+  TORCH_CHECK(ctx->connected, "k31_p2p: handle not connected");
+  TORCH_CHECK(src.is_cuda(), "k31_p2p: p2p_pp_send src must be a CUDA tensor");
+  TORCH_CHECK(src.device().index() == ctx->device_ordinal,
+              "k31_p2p: p2p_pp_send src device (", src.device().index(),
+              ") != handle device (", ctx->device_ordinal, ")");
+  TORCH_CHECK(src.is_contiguous(), "k31_p2p: p2p_pp_send src must be contiguous");
+
+  const int64_t total_bytes = static_cast<int64_t>(src.nbytes());
+  if (total_bytes == 0) {
+    return;
+  }
+
+  c10::cuda::CUDAGuard device_guard(src.device());
+  cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+  const bool is_shm = (ctx->transport == TransportMode::SHM_ZERO_COPY);
+  const uint8_t* src_ptr = reinterpret_cast<const uint8_t*>(src.data_ptr());
+  FlagLine* peer_pp_flags = ctx->active_peer_flags + kPpFlagOffset;
+  const FlagLine* my_pp_ack = ctx->active_my_flags + kPpAckOffset;
+  const uint32_t tag_u32 = static_cast<uint32_t>(tag);
+
+  const int64_t payload_cap = static_cast<int64_t>(compute_pp_payload_cap(ctx->slot_bytes));
+  const int64_t first_chunk = (total_bytes < payload_cap) ? total_bytes : payload_cap;
+  const int launch_ctas = compute_pp_active_ctas(first_chunk);
+
+  if (!is_shm) {
+    p2p_pp_send_kernel<false><<<launch_ctas, kBlockThreads, 0, stream>>>(
+        src_ptr, ctx->active_peer_inbox, peer_pp_flags, my_pp_ack,
+        ctx->dev_ctrl, ctx->host_ctrl_dev,
+        ctx->slot_bytes, ctx->generation, total_bytes, tag_u32);
+  } else {
+    p2p_pp_send_kernel<true><<<launch_ctas, kBlockThreads, 0, stream>>>(
+        src_ptr, ctx->active_peer_inbox, peer_pp_flags, my_pp_ack,
+        ctx->dev_ctrl, ctx->host_ctrl_dev,
+        ctx->slot_bytes, ctx->generation, total_bytes, tag_u32);
+  }
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void p2p_pp_recv(int64_t handle, at::Tensor dst, int64_t tag) {
+  P2PContext* ctx = lookup_fast(handle);
+  TORCH_CHECK(ctx->connected, "k31_p2p: handle not connected");
+  TORCH_CHECK(dst.is_cuda(), "k31_p2p: p2p_pp_recv dst must be a CUDA tensor");
+  TORCH_CHECK(dst.device().index() == ctx->device_ordinal,
+              "k31_p2p: p2p_pp_recv dst device (", dst.device().index(),
+              ") != handle device (", ctx->device_ordinal, ")");
+  TORCH_CHECK(dst.is_contiguous(), "k31_p2p: p2p_pp_recv dst must be contiguous");
+
+  const int64_t total_bytes = static_cast<int64_t>(dst.nbytes());
+  if (total_bytes == 0) {
+    return;
+  }
+
+  c10::cuda::CUDAGuard device_guard(dst.device());
+  cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+  const bool is_shm = (ctx->transport == TransportMode::SHM_ZERO_COPY);
+  uint8_t* dst_ptr = reinterpret_cast<uint8_t*>(dst.data_ptr());
+  const FlagLine* my_pp_flags = ctx->active_my_flags + kPpFlagOffset;
+  FlagLine* peer_pp_ack = ctx->active_peer_flags + kPpAckOffset;
+  const uint32_t tag_u32 = static_cast<uint32_t>(tag);
+  const int64_t payload_cap = static_cast<int64_t>(compute_pp_payload_cap(ctx->slot_bytes));
+  const int64_t first_chunk = (total_bytes < payload_cap) ? total_bytes : payload_cap;
+  const int launch_ctas = compute_pp_active_ctas(first_chunk);
+
+  if (!is_shm) {
+    p2p_pp_recv_kernel<false><<<launch_ctas, kBlockThreads, 0, stream>>>(
+        dst_ptr, ctx->active_my_inbox, my_pp_flags, peer_pp_ack,
+        ctx->dev_ctrl, ctx->host_ctrl_dev,
+        ctx->slot_bytes, ctx->generation, total_bytes, tag_u32);
+  } else {
+    p2p_pp_recv_kernel<true><<<launch_ctas, kBlockThreads, 0, stream>>>(
+        dst_ptr, ctx->active_my_inbox, my_pp_flags, peer_pp_ack,
+        ctx->dev_ctrl, ctx->host_ctrl_dev,
+        ctx->slot_bytes, ctx->generation, total_bytes, tag_u32);
+  }
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void p2p_pp_drain(int64_t handle) {
+  P2PContext* ctx = lookup_fast(handle);
+  TORCH_CHECK(ctx->connected, "k31_p2p: handle not connected");
+  c10::cuda::CUDAGuard device_guard(c10::Device(c10::DeviceType::CUDA, ctx->device_ordinal));
+  cudaStream_t stream = at::cuda::getCurrentCUDAStream(ctx->device_ordinal).stream();
+  const bool is_shm = (ctx->transport == TransportMode::SHM_ZERO_COPY);
+  const FlagLine* my_pp_flags = ctx->active_my_flags + kPpFlagOffset;
+  FlagLine* peer_pp_ack = ctx->active_peer_flags + kPpAckOffset;
+
+  if (!is_shm) {
+    p2p_pp_drain_kernel<false><<<1, 32, 0, stream>>>(
+        ctx->active_my_inbox, my_pp_flags, peer_pp_ack,
+        ctx->dev_ctrl, ctx->host_ctrl_dev,
+        ctx->slot_bytes, ctx->generation);
+  } else {
+    p2p_pp_drain_kernel<true><<<1, 32, 0, stream>>>(
+        ctx->active_my_inbox, my_pp_flags, peer_pp_ack,
+        ctx->dev_ctrl, ctx->host_ctrl_dev,
+        ctx->slot_bytes, ctx->generation);
+  }
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
