+template <int TOPK_MODE>
+__global__ void combine_slots_to_bf16_v3_kernel(
+    const float2* __restrict__ slot_out_v2,
+    const int32_t* __restrict__ slot_to_dst,
+    const float* __restrict__ topk_weights,
+    uint32_t* __restrict__ out_bf16_v2,
+    int H_v2, int topk
+) {
+  const int chunks_per_row = H_v2 >> 5;
+  const int row = blockIdx.x / chunks_per_row;
+  const int chunk = blockIdx.x % chunks_per_row;
+  const int lane = threadIdx.x;
+  const int col_v2 = chunk * 32 + lane;
+
+  float sx = 0.0f, sy = 0.0f;
+  const int row_slot_base = row * topk;
+
+  if constexpr (TOPK_MODE > 0) {
+    const int k_lim = (TOPK_MODE == 16) ? 16 : topk;
+    const int my_dst = (lane < k_lim) ? slot_to_dst[row_slot_base + lane] : -1;
+    const float my_wt = (lane < k_lim && my_dst >= 0) ? topk_weights[row_slot_base + lane] : 0.0f;
+#pragma unroll
+    for (int kb = 0; kb < 16; kb += 4) {
+      if (TOPK_MODE != 16 && kb >= k_lim) break;
+      const int d0 = __shfl_sync(0xffffffffu, my_dst, kb + 0);
+      const int d1 = __shfl_sync(0xffffffffu, my_dst, kb + 1);
+      const int d2 = __shfl_sync(0xffffffffu, my_dst, kb + 2);
+      const int d3 = __shfl_sync(0xffffffffu, my_dst, kb + 3);
+      const float w0 = __shfl_sync(0xffffffffu, my_wt, kb + 0);
+      const float w1 = __shfl_sync(0xffffffffu, my_wt, kb + 1);
+      const float w2 = __shfl_sync(0xffffffffu, my_wt, kb + 2);
+      const float w3 = __shfl_sync(0xffffffffu, my_wt, kb + 3);
+      const float2 v0 = (d0 >= 0) ? __ldg(slot_out_v2 + static_cast<int64_t>(d0) * H_v2 + col_v2) : make_float2(0.0f, 0.0f);
+      const float2 v1 = (d1 >= 0) ? __ldg(slot_out_v2 + static_cast<int64_t>(d1) * H_v2 + col_v2) : make_float2(0.0f, 0.0f);
+      const float2 v2 = (d2 >= 0) ? __ldg(slot_out_v2 + static_cast<int64_t>(d2) * H_v2 + col_v2) : make_float2(0.0f, 0.0f);
+      const float2 v3 = (d3 >= 0) ? __ldg(slot_out_v2 + static_cast<int64_t>(d3) * H_v2 + col_v2) : make_float2(0.0f, 0.0f);
+      sx = fmaf(w0, v0.x, fmaf(w1, v1.x, fmaf(w2, v2.x, fmaf(w3, v3.x, sx))));
+      sy = fmaf(w0, v0.y, fmaf(w1, v1.y, fmaf(w2, v2.y, fmaf(w3, v3.y, sy))));
+    }
+  } else {
+    for (int base_k = 0; base_k < topk; base_k += 32) {
+      const int k_idx = base_k + lane;
+      const int my_dst = (k_idx < topk) ? slot_to_dst[row_slot_base + k_idx] : -1;
+      const float my_wt = (k_idx < topk && my_dst >= 0) ? topk_weights[row_slot_base + k_idx] : 0.0f;
+      const int lim = (topk - base_k < 32) ? (topk - base_k) : 32;
+#pragma unroll 4
+      for (int k = 0; k < lim; ++k) {
+        const int dst = __shfl_sync(0xffffffffu, my_dst, k);
+        const float wt = __shfl_sync(0xffffffffu, my_wt, k);
