+    monkeypatch.setenv(DECODE, "1")
+    monkeypatch.setenv(MID, "1")
+    monkeypatch.setattr(decode, "_is_sm80", lambda _device: True)
+    monkeypatch.setattr(decode, "warmup", lambda *a, **k: None)
+    from vllm.logger import _print_info_once
