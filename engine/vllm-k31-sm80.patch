+    cs_c[0 * stride_cs_t] = x1;
+    cs_c[1 * stride_cs_t] = x2;
+    cs_c[2 * stride_cs_t] = x3;
+
+    float acc = conv_bias_ptr ? load_f32_or_bf16(conv_bias_ptr, c_global, conv_b_fp32) : 0.0f;
+    acc = fmaf(bf16_to_f32(x0), load_f32_or_bf16(conv_weight_ptr, cw_off + 0, conv_w_fp32), acc);
+    acc = fmaf(bf16_to_f32(x1), load_f32_or_bf16(conv_weight_ptr, cw_off + 1, conv_w_fp32), acc);
+    acc = fmaf(bf16_to_f32(x2), load_f32_or_bf16(conv_weight_ptr, cw_off + 2, conv_w_fp32), acc);
+    acc = fmaf(bf16_to_f32(x3), load_f32_or_bf16(conv_weight_ptr, cw_off + 3, conv_w_fp32), acc);
+    // Match BF16 intermediate rounding between causal_conv1d_update and KDA recurrence.
+    out_val = bf16_to_f32(f32_to_bf16(silu_f32(acc)));
+  };
+
+  if (tid < kD) {
+    float qv = 0.0f;
+    run_conv_channel(h * kD + tid, qv);
+    s_q[tid] = qv;
+
+    float vv = 0.0f;
+    run_conv_channel(2 * proj_size + h * kD + tid, vv);
+    s_v[tid] = vv;
+  } else {
+    int d = tid - kD;
+    float kv = 0.0f;
+    run_conv_channel(proj_size + h * kD + d, kv);
+    s_k[d] = kv;
+  }
+  __syncthreads();
+
+  // Step 2: Q/K L2-norm + KDA decay gate.
+  if (tid < kD) {
+    float qv = s_q[tid];
+    float qsq = warp_sum_f32(qv * qv);
+    if (lane == 0) s_red[warp] = qsq;
+  } else {
+    int d = tid - kD;
+    float kv = s_k[d];
+    float ksq = warp_sum_f32(kv * kv);
+    if (lane == 0) s_red[warp] = ksq;
+  }
+  __syncthreads();
+
+  if (tid < kD) {
+    float q_tot = s_red[0] + s_red[1] + s_red[2] + s_red[3];
+    s_q[tid] = (s_q[tid] / sqrtf(q_tot + 1.0e-6f)) * kQScale;
+
+    float g_val = bf16_to_f32(raw_g_ptr[static_cast<int64_t>(b) * stride_g_b + h * kD + tid]);
+    float bias_val = load_f32_or_bf16(dt_bias_ptr, h * kD + tid, dt_bias_fp32);
+    float a_val = expf(load_f32_or_bf16(a_log_ptr, h, a_log_fp32));
