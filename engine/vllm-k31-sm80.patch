+
+    p2p_ops.ensure_p2p_extension()
+    info = p2p_ops.build_info()
+    assert info["api_version"] >= 3
+
+    dev = torch.device("cuda:0")
+    h0, h1 = p2p_ops.create_loopback_pair(0, 4 * 1024 * 1024)
+    try:
+        s0 = torch.cuda.Stream(device=dev)
+        s1 = torch.cuda.Stream(device=dev)
+        rows = 8
+        # Generate test tensors on CPU so shared inputs never depend on per-GPU SM count.
+        gen = torch.Generator().manual_seed(2026)
+        r0 = torch.randn((rows, 3584), generator=gen, dtype=torch.bfloat16).to(dev)
+        r1 = torch.randn((rows, 3584), generator=gen, dtype=torch.bfloat16).to(dev)
+        sh0 = torch.randn((rows, 7168), generator=gen, dtype=torch.bfloat16).to(dev)
+        sh1 = torch.randn((rows, 7168), generator=gen, dtype=torch.bfloat16).to(dev)
+        w = torch.randn((3584,), generator=gen, dtype=torch.bfloat16).to(dev)
+
+        out_r0 = torch.empty_like(r0)
+        out_r1 = torch.empty_like(r1)
+        out_s0 = torch.empty_like(sh0)
+        out_s1 = torch.empty_like(sh1)
+
+        torch.cuda.synchronize(dev)
+        with torch.cuda.stream(s0):
+            p2p_ops.p2p_moe_dual_reduce_rmsnorm(
+                h0, r0, sh0, w, 1e-5, out_r0, out_s0
+            )
