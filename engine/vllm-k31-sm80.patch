+    p1 = torch.full((1, KMAX), -1, dtype=torch.int64)
+    p1[0, :chunk_k] = torch.arange(100, 100 + chunk_k)
+    p2_toks = torch.arange(200, 200 + chunk_k + 1, dtype=torch.int64).view(1, chunk_k + 1)
+    p2_wire = torch.cat([torch.ones((1, 1), dtype=torch.int64), p2_toks], dim=1)
+    ev = object()
+    last.broadcast_rows(p1, ev)
