+def test_multi_request_batch_masking_and_probabilistic_draft_logits(monkeypatch):
+    inst, suffix = _make_hybrid(monkeypatch, min_match_len=4, conf_floor=0.90)
+    # 3 requests at slots [1, 3, 5]:
+    #   batch 0 (slot 1): strong suffix hit -> overridden
+    #   batch 1 (slot 3): no suffix hit -> 100% bit-identical DSpark
+    #   batch 2 (slot 5): strong partial suffix hit (6 valid tokens) -> slots 0..5 overridden
+    d0 = list(range(10, 22))
+    d1 = list(range(30, 42))
+    d2 = list(range(50, 62))
+    inst.draft_tokens[:3] = torch.tensor([d0, d1, d2], dtype=torch.int64)
+    inst.draft_token_confidence_probs[:3] = torch.full((3, 12), 0.3, dtype=torch.float32)
+
+    # Sharded-like DraftLogitsCache: rank owns slots 1 (row 0) and 5 (row 1); slot 3 -> -1.
+    vocab = 1024
+    cache_vals = torch.full((2, 12, vocab), 1.25, dtype=torch.float32)
+    row_map = torch.full((8,), -1, dtype=torch.int32)
+    row_map[1] = 0
+    row_map[5] = 1
+    inst.draft_logits = SimpleNamespace(values=cache_vals, row_mapping=row_map)
+
+    s0 = list(range(700, 712))
+    s2 = list(range(800, 806))
+    suffix.set_match(0, 1, s0, match_len=8, bucket=6)
+    suffix.set_match(1, 3, [999] * 12, match_len=1, bucket=0)
+    suffix.set_match(2, 5, s2, match_len=7, bucket=6)
+
+    out = _call_propose(inst, [1, 3, 5])
+    assert out[0].tolist() == s0
+    assert out[1].tolist() == d1  # untouched bit-identical DSpark
+    assert out[2, :6].tolist() == s2
+    assert out[2, 6:].tolist() == d2[6:]
+    assert inst._last_suffix_used.tolist() == [True, False, True]
+    assert suffix.last_bucket[1].item() == 6
+    assert suffix.last_bucket[3].item() == -1
+    assert suffix.last_bucket[5].item() == 6
+
+    # Check one-hot draft_logits on overridden slots of owned rows 0 and 1,
+    # and untouched 1.25 on non-overridden tail of row 1 (slots 6..11).
+    assert cache_vals[0, 0, s0[0]].item() == pytest.approx(0.0)
+    assert cache_vals[0, 0, 0].item() == pytest.approx(-1e4)
+    assert cache_vals[1, 5, s2[5]].item() == pytest.approx(0.0)
+    assert cache_vals[1, 6, 0].item() == pytest.approx(1.25)
+
