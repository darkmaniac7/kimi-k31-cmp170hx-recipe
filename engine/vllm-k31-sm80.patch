+void sigmoid_mul(
+    const at::Tensor& attn_out,
+    const at::Tensor& gate,
+    at::Tensor out) {
+  TORCH_CHECK(attn_out.is_cuda() && attn_out.scalar_type() == at::kBFloat16 &&
+                  attn_out.is_contiguous(),
+              "attn_out must be contiguous CUDA BF16");
+  TORCH_CHECK(gate.is_cuda() && gate.scalar_type() == at::kBFloat16 && gate.is_contiguous() &&
+                  gate.numel() == attn_out.numel(),
+              "gate shape/dtype mismatch");
+  TORCH_CHECK(out.is_cuda() && out.scalar_type() == at::kBFloat16 && out.is_contiguous() &&
+                  out.numel() == attn_out.numel(),
+              "out shape/dtype mismatch");
+  const int64_t n = attn_out.numel();
+  if (n == 0) return;
+  TORCH_CHECK(n % 8 == 0, "numel must be a multiple of 8");
+  TORCH_CHECK(is_aligned_16(attn_out.data_ptr()) && is_aligned_16(gate.data_ptr()) &&
+                  is_aligned_16(out.data_ptr()),
+              "attn_out, gate, and out must be 16-byte aligned");
+
+  const c10::cuda::CUDAGuard device_guard(attn_out.device());
+  cudaStream_t stream = at::cuda::getCurrentCUDAStream();
+
+  const int64_t n_vec = n >> 3;
+  const int grid_x = static_cast<int>((n_vec + 255) / 256);
+  k31_sigmoid_mul_kernel<<<grid_x, 256, 0, stream>>>(
+      reinterpret_cast<const __nv_bfloat16*>(attn_out.data_ptr()),
+      reinterpret_cast<const __nv_bfloat16*>(gate.data_ptr()),
+      reinterpret_cast<__nv_bfloat16*>(out.data_ptr()),
+      n_vec);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
