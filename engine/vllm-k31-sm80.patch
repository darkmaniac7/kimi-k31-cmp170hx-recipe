+    if (tid < kD) {
+      out_h[tid] = f32_to_bf16(0.0f);
+    }
+    return;
+  }
+
+  __shared__ float s_q[kD];
+  __shared__ float s_k[kD];
+  __shared__ float s_v[kD];
+  __shared__ float s_decay[kD];
+  __shared__ float s_o[kD];
+  __shared__ float s_red[kWarps];
+
+  const int proj_size = H * kD;
+  const __nv_bfloat16* x_b = mixed_qkv_ptr + static_cast<int64_t>(b) * stride_mixed_b;
+  __nv_bfloat16* cs_slot = conv_state_ptr + slot * stride_cs_slot;
+
