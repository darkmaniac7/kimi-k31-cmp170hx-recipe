+def _make_dspark_vllm_config(
+    monkeypatch,
+    ckpt_dir: Path,
+    *,
+    quantized: bool,
+    tp_size: int = 1,
+    tp_rank: int = 0,
+    target_layers: int = _TINY_TARGET_LAYERS,
+    head_dtype: str | None = None,
+    load_format: str = "k31q",
+    draft_load_config: LoadConfig | None = None,
+) -> tuple[VllmConfig, ModelConfig]:
+    from vllm.model_executor.layers import quantization as quant_mod
+    from vllm.model_executor.model_loader import weight_utils
+
+    plugin._register_k31q()
+    # Resolve registered custom quant methods before upstream
+    # get_quantization_config eagerly imports unrelated CUDA-only model packages
+    # (deepseek_v41 / flashmla / tilelang) during CPU-only tests.
+    orig_get_qcfg = quant_mod.get_quantization_config
+
+    def _custom_first_get_qcfg(name: str):
+        if name in quant_mod._CUSTOMIZED_METHOD_TO_QUANT_CONFIG:
+            return quant_mod._CUSTOMIZED_METHOD_TO_QUANT_CONFIG[name]
+        return orig_get_qcfg(name)
+
+    monkeypatch.setattr(weight_utils, "get_quantization_config", _custom_first_get_qcfg)
+    _parallel_groups(monkeypatch, tp_size, tp_rank, 1, 0)
+    raw = json.loads((ckpt_dir / "config.json").read_text(encoding="utf-8"))
+    extracted = SpeculatorsConfig.extract_transformers_pre_trained_config(raw)
+    draft_hf = SpeculatorsConfig(**extracted)
+
+    draft_mc = _runtime_defaults(
+        ModelConfig,
+        model=str(ckpt_dir),
+        tokenizer=str(ckpt_dir),
+        hf_config=draft_hf,
+        hf_text_config=draft_hf,
+        dtype=torch.bfloat16,
+        max_model_len=2048,
+        original_max_model_len=2048,
+        runner_type="draft",
+        convert_type="none",
+        multimodal_config=None,
+        quantization=DSPARK_EXL3_QUANT_METHOD if quantized else None,
+        skip_tokenizer_init=True,
+    )
+    target_hf = SimpleNamespace(
+        num_hidden_layers=target_layers,
+        hidden_size=_TINY_H,
+        vocab_size=_TINY_VOCAB,
+        head_dtype=head_dtype,
+    )
+    target_mc = _runtime_defaults(
+        ModelConfig,
+        model=str(ckpt_dir),
+        tokenizer=str(ckpt_dir),
+        hf_config=target_hf,
+        hf_text_config=target_hf,
+        dtype=torch.bfloat16,
+        max_model_len=2048,
+        original_max_model_len=2048,
+        runner_type="generate",
+        convert_type="none",
+        multimodal_config=None,
+        quantization=None,
+        skip_tokenizer_init=True,
+    )
+    target_mc.model_arch_config = SimpleNamespace(
+        total_num_hidden_layers=target_layers,
+        vocab_size=_TINY_VOCAB,
+        hidden_size=_TINY_H,
+        quantization_config=None,
+        num_experts=0,
+    )
+    draft_mc.model_arch_config = SimpleNamespace(
+        total_num_hidden_layers=_TINY_LAYERS,
+        vocab_size=_TINY_VOCAB,
+        hidden_size=_TINY_H,
+        quantization_config=getattr(draft_hf, "quantization_config", None),
+        num_experts=0,
+    )
+    spec_cfg = SimpleNamespace(
+        draft_model_config=draft_mc,
+        target_model_config=target_mc,
+        num_speculative_tokens=7,
+        draft_parallel_config=SimpleNamespace(tensor_parallel_size=tp_size),
+        draft_load_config=draft_load_config,
+    )
+    parallel = _runtime_defaults(
+        ParallelConfig,
+        tensor_parallel_size=tp_size,
+        pipeline_parallel_size=1,
+        distributed_executor_backend="mp",
+    )
+    scheduler = SchedulerConfig(
+        max_model_len=2048, max_num_batched_tokens=64, max_num_seqs=4, is_encoder_decoder=False
+    )
+    load_cfg = LoadConfig(load_format=load_format)
+    qcfg = None
+    if quantized:
+        qcfg = K31DSparkExl3Config.from_config(draft_hf.quantization_config)
+        qcfg.maybe_update_config(str(ckpt_dir), hf_config=draft_hf)
+    vcfg = _runtime_defaults(
+        VllmConfig,
+        model_config=target_mc,
+        parallel_config=parallel,
+        scheduler_config=scheduler,
+        compilation_config=CompilationConfig(mode=0, cudagraph_mode="NONE", custom_ops=["all"]),
+        load_config=load_cfg,
+        quant_config=qcfg,
+        speculative_config=spec_cfg,
+    )
+    return vcfg, draft_mc
