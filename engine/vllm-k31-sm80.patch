+            t.type = GGML_TYPE_F32;
+            t.buffer = non_host ? reinterpret_cast<ggml_backend_buffer *>(0x1) : nullptr;
+            t.ne[0] = H; t.ne[1] = T; t.ne[2] = 1; t.ne[3] = 1;
+            t.nb[0] = 4; t.nb[1] = (size_t)H * 4; t.nb[2] = t.nb[1] * (size_t)T; t.nb[3] = t.nb[2];
