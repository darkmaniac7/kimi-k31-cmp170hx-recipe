+def test_allreduce_residual_lifecycle_and_fake_tensor(monkeypatch, meta_platform):
+    """Verify fused residual add, set_abort/check_error/transport_info, and
+    FakeTensorMode tracing of registered vllm::k31_p2p_* ops."""
+    from torch._subclasses.fake_tensor import FakeTensorMode
+
+    monkeypatch.setenv("VLLM_K31_P2P_ALLREDUCE", "1")
+    ops = fake_p2p.FakeP2POps().install(monkeypatch)
+    c0, c1, ok = _run_pair_init(ops, timeout_ms=3500)
+    assert ok == [True, True]
+
+    g = torch.Generator().manual_seed(42)
+    r0 = (torch.randn((4, 64), generator=g) / 4).to(torch.bfloat16)
+    r1 = (torch.randn((4, 64), generator=g) / 4).to(torch.bfloat16)
+    res = (torch.randn((4, 64), generator=g) / 4).to(torch.bfloat16)
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        f0 = pool.submit(c0.allreduce_residual, r0, res)
+        f1 = pool.submit(c1.allreduce_residual, r1, res)
+        (s0, sr0), (s1, sr1) = f0.result(timeout=10), f1.result(timeout=10)
+
+    expected_sum = (r0.float() + r1.float()).to(torch.bfloat16)
+    expected_res = ((r0.float() + r1.float()) + res.float()).to(torch.bfloat16)
+    assert torch.equal(s0, s1) and torch.equal(s0, expected_sum)
+    assert torch.equal(sr0, sr1) and torch.equal(sr0, expected_res)
+    assert ops.allreduce_calls[0]["has_residual"] is True
+
+    # Transport info and abort/error lifecycle.
+    info0 = c0.transport_info()
+    assert info0["connected"] is True
+    assert info0["transport"] == "p2p_ipc"
+    assert info0["timeout_ms"] == 3500
+    assert c0.check_error() == 0
+    c0.set_abort()
+    assert c0.check_error() == 2
+    assert c0.handle in ops.abort_calls
+
+    c0.close()
+    c1.close()
+
+    # FakeTensorMode tracing of all three registered custom ops.
+    with FakeTensorMode():
+        fx = torch.empty((4, 7168), dtype=torch.bfloat16)
+        fres = torch.empty((4, 7168), dtype=torch.bfloat16)
+        fr = torch.empty((4, 3584), dtype=torch.bfloat16)
+        fw = torch.empty((3584,), dtype=torch.bfloat16)
+
+        y = torch.ops.vllm.k31_p2p_allreduce(fx, 100)
+        assert y.shape == (4, 7168) and y.dtype == torch.bfloat16
+
+        ys, yr = torch.ops.vllm.k31_p2p_allreduce_residual(fx, fres, 100)
+        assert ys.shape == (4, 7168) and yr.shape == (4, 7168)
+
+        rn, ss = torch.ops.vllm.k31_p2p_moe_dual_reduce_rmsnorm(fr, fx, fw, 1e-5, 100)
+        assert rn.shape == (4, 3584) and rn.dtype == torch.bfloat16
+        assert ss.shape == (4, 7168) and ss.dtype == torch.bfloat16
