+def test_kda_records_state_mode_reset_and_mixed_batch_materialize(monkeypatch):
+    from vllm.models.kimi_k3.nvidia import kda as kda_mod
+    from vllm.models.kimi_k3.nvidia.kda_metadata import KimiK3KDAMetadata
+
+    _clear_env(monkeypatch)
+    events: list[str] = []
+
+    class V3StandIn:
+        @staticmethod
+        def build_info():
+            return {"abi_version": 1, "api_version": 3}
+
+        @staticmethod
+        def fused_kda_spec_verify_records(
+            mixed_qkv,
+            conv_state,
+            conv_weight,
+            conv_bias,
+            raw_g,
+            raw_beta,
+            A_log,
+            dt_bias,
