+        q = core.prepare_layer(cfg, weights, caches, batch, a["qr_kv"].to(dev), None,
+                               None, fused=True)
+        core.attend_layer(cfg, weights, caches, batch, q, out, fused=True)
+        results.append((out, caches.swa))
