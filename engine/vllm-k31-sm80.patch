+
+    torch.manual_seed(300 + W + int(dim_first))
+    H, D, N = 2, 128, 2
+    q_lens = [W, max(1, W - 2)]
+    T = sum(q_lens)
+    attn = _make_spec_kda_stub(H=H, D=D, W=W, slots=40, dim_first=dim_first)
+
+    # Extra trailing rows in metadata (like CUDA-graph padded buffers) verify exact slicing.
+    ssi_full = torch.zeros((N + 2, W), dtype=torch.int32)
+    ssi_full[0] = torch.arange(1, 1 + W, dtype=torch.int32)
+    ssi_full[1] = torch.arange(1 + W, 1 + 2 * W, dtype=torch.int32)
+    qsl_full = torch.tensor([0, q_lens[0], T, T, T], dtype=torch.int32)
+    acc_full = torch.tensor([1, min(3, W), 1, 1], dtype=torch.int32)
+
+    meta = KimiK3KDAMetadata(
+        num_prefills=0,
+        num_prefill_tokens=0,
+        num_decodes=0,
+        num_decode_tokens=0,
+        num_actual_tokens=T,
+        num_spec_decodes=N,
+        num_spec_decode_tokens=T,
+        spec_state_indices_tensor=ssi_full,
+        spec_query_start_loc=qsl_full,
+        num_accepted_tokens=acc_full,
+    )
+    monkeypatch.setattr(
+        kda_mod,
+        "get_forward_context",
+        lambda: SimpleNamespace(attn_metadata={attn.prefix: meta}),
+    )
+
+    # Token-padded inputs (T + 2) verify num_actual_tokens slicing.
+    mixed = torch.randn((T + 2, 3 * H * D), dtype=torch.bfloat16) * 0.3
+    g1 = torch.randn((1, T + 2, H, D), dtype=torch.bfloat16) * 0.3
+    g2 = torch.randn((T + 2, H, D), dtype=torch.bfloat16) * 0.3
+    beta = torch.randn((1, T + 2, H), dtype=torch.bfloat16) * 0.3
+    out = torch.empty((1, T + 2, H, D), dtype=torch.bfloat16)
+
+    cs_orig = attn.kv_cache[0].clone()
+    rs_orig = attn.kv_cache[1].clone()
+    ref_o, ref_cs, ref_rs = ref_triton_spec_verify(
+        mixed[:T],
+        cs_orig if dim_first else cs_orig.transpose(-1, -2),
+        attn.conv1d.weight.view(-1, 4),
+        attn.conv1d.bias,
+        g1[0, :T],
+        beta[0, :T],
+        attn.A_log,
+        attn.dt_bias,
+        g2[:T],
+        attn.o_norm.weight,
+        rs_orig,
+        ssi_full[:N],
+        qsl_full[: N + 1],
+        acc_full[:N],
+        -5.0,
+        1e-5,
+    )
+
+    attn._forward(mixed, g1, g2, beta, out)
+
+    calls = fake.calls_for("fused_kda_spec_verify")
+    assert len(calls) == 1
+    assert calls[0]["tokens"] == T
+    assert calls[0]["seqs"] == N
+    assert calls[0]["s_cols"] == W
+    assert calls[0]["lower_bound"] == -5.0
+    assert torch.equal(calls[0]["spec_state_indices"], ssi_full[:N])
+    assert torch.equal(calls[0]["query_start_loc"], qsl_full[: N + 1])
+    assert torch.equal(calls[0]["num_accepted_tokens"], acc_full[:N])
+    # Early return must skip self.o_norm completely.
+    assert attn._o_norm_called == 0
+    assert torch.allclose(out[0, :T].float(), ref_o.float(), atol=1e-2, rtol=1e-2)
+    cs_got = attn.kv_cache[0] if dim_first else attn.kv_cache[0].transpose(-1, -2)
+    assert torch.equal(cs_got, ref_cs)
+    assert torch.allclose(attn.kv_cache[1], ref_rs, atol=1e-6, rtol=1e-5)
