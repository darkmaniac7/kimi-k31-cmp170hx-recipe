+        "-O3",
+        "-std=c++20",
+        "-fPIC",
+        abi_flag,
+        "-DTORCH_EXTENSION_NAME=_k31_p2p_C",
+        *inc_flags,
+        "-c",
+        str(src_dir / "p2p_module.cpp"),
+        "-o",
+        str(cpp_obj),
+    ]
+    link_cmd = [
+        "g++",
+        "-shared",
+        "-fPIC",
+        str(cu_obj),
+        str(cpp_obj),
+        *lib_flags,
+        "-lc10",
+        "-lc10_cuda",
