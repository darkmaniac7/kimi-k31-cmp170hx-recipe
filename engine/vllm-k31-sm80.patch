+    # 3) draft_logits present (matching vocab width) -> active (dense), not direct
+    r_dl = _runner(
+        [SamplingParams(temperature=0.0)],
+        masked_token_ids=None,
+        speculator=SimpleNamespace(draft_logits=torch.zeros(1, 3, 97)),
+    )
+    with ta.step(r_dl, batch, None):
+        assert ta.active() and not ta.direct_active()
+
+    # 4) RejectionSampler with synthetic rates / fly_window_size / adaptive_verification
+    for attr, val in [
+        ("synthetic_conditional_rates", torch.tensor([0.8, 0.8, 0.8])),
+        ("fly_window_size", 2),
+        ("enable_adaptive_verification", True),
