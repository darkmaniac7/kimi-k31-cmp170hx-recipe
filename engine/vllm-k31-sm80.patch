+def _run_composite_layer3(mini: Path) -> dict[str, Any]:
+    from vllm.model_executor.layers.fused_moe.router import grouped_topk_router as gtr
+    import importlib; ar_mod = importlib.import_module('vllm.models.kimi_k3.nvidia.ops.attn_res')
+    from vllm.sm80.kernels.exl3.utils import Exl3LoadLedger
+    from vllm.sm80.kernels.k31q import vq_ops
+    from vllm.sm80.kernels.k31q.manifest import K31QManifest
+
+    device = torch.device("cuda:0")
+    manifest = K31QManifest(mini)
+    embed, l1_ao, l1_out = gpu.tensors(
+        mini / "ref_acts.safetensors", "embed", "L1.attn_out.q", "L1.out.q", device=device
+    )
+    layer_path = mini / "layer-003.safetensors"
+
+    from vllm.sm80.kernels.k31q.moe import K31VqLauncher
+
+    vq_ops.ensure_vq_extension()
+    experts, _ = gpu.load_experts(mini, layer=3, tp_size=1, tp_rank=0, native=vq_ops, device=device)
+    vq_launcher = K31VqLauncher(experts, 16, 16, 4.0, 25.0)
+    vq_ws = torch.empty(vq_launcher.workspace_elements, dtype=torch.float32, device=device)
+    expert_map = torch.arange(896, dtype=torch.int32, device=device)
+
+    with ExitStack() as stack:
+        files = {layer_path: stack.enter_context(safe_open(str(layer_path), framework="pt", device="cpu"))}
+        ledger = Exl3LoadLedger(manifest)
+        pfx = f"{LAYER_PREFIX}3."
+        qa_kva_l, _ = _load_exl3_launcher(
+            manifest, files, ledger,
+            [pfx + "self_attn.q_a_proj", pfx + "self_attn.kv_a_proj_with_mqa"],
+            [1536, 576], 7168,
+        )
+        qb_l, _ = _load_exl3_launcher(manifest, files, ledger, [pfx + "self_attn.q_b_proj"], [18432], 1536)
+        g_l, _ = _load_exl3_launcher(manifest, files, ledger, [pfx + "self_attn.g_proj"], [12288], 7168)
+        o_l, _ = _load_exl3_launcher(manifest, files, ledger, [pfx + "self_attn.o_proj"], [7168], 12288)
+        r_down_l, _ = _load_exl3_launcher(manifest, files, ledger, [pfx + "block_sparse_moe.routed_expert_down_proj"], [3584], 7168)
+        r_up_l, _ = _load_exl3_launcher(manifest, files, ledger, [pfx + "block_sparse_moe.routed_expert_up_proj"], [7168], 3584)
+        sh_gu_l, _ = _load_exl3_launcher(
+            manifest, files, ledger,
+            [pfx + "block_sparse_moe.shared_experts.gate_proj", pfx + "block_sparse_moe.shared_experts.up_proj"],
+            [6144, 6144], 7168,
+        )
+        sh_down_l, _ = _load_exl3_launcher(manifest, files, ledger, [pfx + "block_sparse_moe.shared_experts.down_proj"], [7168], 6144)
+
+        in_ln = _load_layer_plain(mini, 3, "input_layernorm.weight", device).contiguous()
+        post_ln = _load_layer_plain(mini, 3, "post_attention_layernorm.weight", device).contiguous()
+        ar_attn_nw = _load_layer_plain(mini, 3, "self_attention_res_norm.weight", device).contiguous()
+        ar_attn_qk = _load_layer_plain(mini, 3, "self_attention_res_proj.weight", device).squeeze(0).contiguous()
+        ar_mlp_nw = _load_layer_plain(mini, 3, "mlp_res_norm.weight", device).contiguous()
+        ar_mlp_qk = _load_layer_plain(mini, 3, "mlp_res_proj.weight", device).squeeze(0).contiguous()
+        qa_ln = _load_layer_plain(mini, 3, "self_attn.q_a_layernorm.weight", device).contiguous()
+        kva_ln = _load_layer_plain(mini, 3, "self_attn.kv_a_layernorm.weight", device).contiguous()
+        kv_b_w = _load_layer_plain(mini, 3, "self_attn.kv_b_proj.weight", device).contiguous()
+        r_norm_w = _load_layer_plain(mini, 3, "block_sparse_moe.routed_expert_norm.weight", device).contiguous()
+        gate_w = _load_layer_plain(mini, 3, "block_sparse_moe.gate.weight", device).contiguous()
+        gate_b = _load_layer_plain(mini, 3, "block_sparse_moe.gate.e_score_correction_bias", device).contiguous()
+
+        # W_UK [96, 128, 512] and W_UV [96, 128, 512] from kv_b_proj [24576, 512]
+        kv_b_heads = kv_b_w.view(96, 256, 512)
+        w_uk = kv_b_heads[:, :128, :].contiguous()
+        w_uv = kv_b_heads[:, 128:, :].contiguous()
+
+        results = {}
+        for M in (1, 4, 8):
+            torch.manual_seed(3000 + M)
+            kv_cache_ctx = torch.randn((M, 16, 512), dtype=torch.bfloat16, device=device) * 0.2
+            pref0 = l1_ao[:M].contiguous()
+            delta0 = l1_out[:M].contiguous()
+            blocks0 = torch.zeros((M, 8, 7168), dtype=torch.bfloat16, device=device)
+            blocks0[:, 0, :] = embed[:M]
+
+            def make_step(mode: str, capture: dict[str, torch.Tensor] | None = None):
+                pref_buf = pref0.clone()
+                blk_buf = blocks0.clone()
+
+                def call_ar(pref, d, blk, nw, qk, onw, nb, bi, eps, oeps, d2=None):
+                    if mode == "fp32ar":
+                        h_ref, pref_new, blk_new = ref_attn_res_rmsnorm(
+                            pref, d, d2, blk, nw, qk, onw, nb, bi, eps, oeps
+                        )
+                        pref.copy_(pref_new)
+                        blk.copy_(blk_new)
+                        return h_ref
+                    if d2 is not None and mode != "glue":
+                        return ar_mod.attn_res(pref, d + d2, blk, nw, qk, onw, nb, bi, eps, oeps)
+                    return ar_mod.attn_res(pref, d, blk, nw, qk, onw, nb, bi, eps, oeps, delta2=d2)
+
+                def step():
+                    pref_buf.copy_(pref0)
+                    h = call_ar(pref_buf, delta0, blk_buf, ar_attn_nw, ar_attn_qk, in_ln, 1, -1, 1e-5, 1e-5)
+                    qkv_a = qa_kva_l(h, torch.bfloat16)
+                    q_c = _rmsnorm(qkv_a[:, :1536], qa_ln)
+                    kv_c = _rmsnorm(qkv_a[:, 1536 : 1536 + 512], kva_ln)
+                    q_full = qb_l(q_c, torch.bfloat16).view(M, 96, 192)
+                    q_nope = q_full[:, :, :128]  # [M, 96, 128]
+                    # Absorbed decode attention over cached latent KV
+                    q_lat = torch.einsum("mhd,hdl->mhl", q_nope, w_uk)
+                    kv_all = torch.cat([kv_cache_ctx, kv_c.unsqueeze(1)], dim=1)  # [M, 17, 512]
+                    scores = torch.einsum("mhl,msl->mhs", q_lat.float(), kv_all.float()) * (128.0 ** -0.5)
+                    probs = torch.softmax(scores, dim=-1).to(torch.bfloat16)
+                    ctx_lat = torch.einsum("mhs,msl->mhl", probs, kv_all)
+                    attn_val = torch.einsum("mhl,hdl->mhd", ctx_lat, w_uv).reshape(M, 12288)
+                    gate = g_l(h, torch.bfloat16)
+                    attn_gated = (attn_val.float() * torch.sigmoid(gate.float())).to(torch.bfloat16)
+                    attn_out = o_l(attn_gated, torch.bfloat16)
+                    if capture is not None:
+                        capture["h"] = h.clone()
+                        capture["pref_post_attn"] = pref_buf.clone()
+                        capture["attn_out"] = attn_out.clone()
+
+                    h_moe = call_ar(pref_buf, attn_out, blk_buf, ar_mlp_nw, ar_mlp_qk, post_ln, 1, -1, 1e-5, 1e-5)
+                    logits = F.linear(h_moe, gate_w).float()
+                    tw, ti = gtr.grouped_topk(
+                        h_moe, logits, topk=16, renormalize=True,
+                        num_expert_group=1, topk_group=1, scoring_func="sigmoid",
+                        routed_scaling_factor=1.0, e_score_correction_bias=gate_b,
+                    )
+                    z = r_down_l(h_moe, torch.bfloat16)
+                    routed_lat = torch.empty_like(z)
+                    vq_launcher(z, ti.to(torch.int64), tw, expert_map, routed_lat, vq_ws)
+                    routed_up = r_up_l(_rmsnorm(routed_lat, r_norm_w), torch.bfloat16)
+                    sh_out = sh_down_l(_situ_and_mul(sh_gu_l(h_moe, torch.bfloat16)), torch.bfloat16)
+                    return call_ar(
+                        pref_buf, routed_up, blk_buf, ar_attn_nw, ar_attn_qk, None, 1, -1, 1e-5, 0.0,
+                        d2=sh_out,
+                    )
+
+                return step
+
+            def run_post_mla_moe(mode: str, pref_in: torch.Tensor, attn_out_in: torch.Tensor):
+                pref_buf = pref_in.clone()
+                blk_buf = blocks0.clone()
+                if mode == "fp32ar":
+                    h_moe, pref_buf, blk_buf = ref_attn_res_rmsnorm(
+                        pref_buf, attn_out_in, None, blk_buf, ar_mlp_nw, ar_mlp_qk, post_ln, 1, -1, 1e-5, 1e-5
+                    )
+                else:
+                    h_moe = ar_mod.attn_res(pref_buf, attn_out_in, blk_buf, ar_mlp_nw, ar_mlp_qk, post_ln, 1, -1, 1e-5, 1e-5)
+                logits = F.linear(h_moe, gate_w).float()
+                tw, ti = gtr.grouped_topk(
+                    h_moe, logits, topk=16, renormalize=True,
+                    num_expert_group=1, topk_group=1, scoring_func="sigmoid",
+                    routed_scaling_factor=1.0, e_score_correction_bias=gate_b,
+                )
+                z = r_down_l(h_moe, torch.bfloat16)
+                routed_lat = torch.empty_like(z)
+                vq_launcher(z, ti.to(torch.int64), tw, expert_map, routed_lat, vq_ws)
+                routed_up = r_up_l(_rmsnorm(routed_lat, r_norm_w), torch.bfloat16)
+                sh_out = sh_down_l(_situ_and_mul(sh_gu_l(h_moe, torch.bfloat16)), torch.bfloat16)
+                if mode == "fp32ar":
+                    out, _, _ = ref_attn_res_rmsnorm(
+                        pref_buf, routed_up, sh_out, blk_buf, ar_attn_nw, ar_attn_qk, None, 1, -1, 1e-5, 0.0
+                    )
+                    return out
+                if mode == "glue":
+                    return ar_mod.attn_res(
+                        pref_buf, routed_up, blk_buf, ar_attn_nw, ar_attn_qk, None, 1, -1, 1e-5, 0.0,
+                        delta2=sh_out,
+                    )
+                return ar_mod.attn_res(
+                    pref_buf, routed_up + sh_out, blk_buf, ar_attn_nw, ar_attn_qk, None, 1, -1, 1e-5, 0.0,
+                )
+
+            cap_fp32: dict[str, torch.Tensor] = {}
+            cap_tri: dict[str, torch.Tensor] = {}
+            cap_glue: dict[str, torch.Tensor] = {}
+            with _glue_switches():
+                out_off_fp32 = make_step("fp32ar", cap_fp32)()
+                out_off_tri = make_step("triton", cap_tri)()
+                moe_off_fp32 = run_post_mla_moe("fp32ar", cap_fp32["pref_post_attn"], cap_fp32["attn_out"])
+                moe_off_tri = run_post_mla_moe("triton", cap_fp32["pref_post_attn"], cap_fp32["attn_out"])
+            with _glue_switches(VLLM_K31_GLUE_ALL=1):
+                out_on = make_step("glue", cap_glue)()
+                moe_on = run_post_mla_moe("glue", cap_fp32["pref_post_attn"], cap_fp32["attn_out"])
+
+            h_rel_fp32 = _rel_l2(cap_glue["h"], cap_fp32["h"])
+            h_tri_fp32 = _rel_l2(cap_tri["h"], cap_fp32["h"])
+            rel_fp32 = _rel_l2(out_on, out_off_fp32)
+            rel_tri = _rel_l2(out_on, out_off_tri)
+            tri_vs_fp32 = _rel_l2(out_off_tri, out_off_fp32)
+            cos_fp32 = _cosine(out_on, out_off_fp32)
+            moe_rel_fp32 = _rel_l2(moe_on, moe_off_fp32)
+            moe_rel_tri = _rel_l2(moe_on, moe_off_tri)
+
+            assert h_rel_fp32 <= BOUND_ATTNRES_REL_L2, f"L3 M={M}: pre-attn h rel_l2={h_rel_fp32}"
+            assert moe_rel_fp32 <= BOUND_COMPOSITE_REL_L2, f"L3 M={M}: post-MLA MoE rel_l2={moe_rel_fp32}"
+            if M == 1:
+                assert rel_fp32 <= BOUND_COMPOSITE_REL_L2, f"L3 M=1: composite rel_l2={rel_fp32}"
+            else:
+                assert rel_fp32 <= 5e-3 and cos_fp32 >= 0.99999, (
+                    f"L3 M={M}: composite rel_l2={rel_fp32}, cos={cos_fp32}"
+                )
+
+            with _glue_switches():
+                us_off = _bench_graph_us(make_step("triton"))
+            with _glue_switches(VLLM_K31_GLUE_ALL=1):
+                us_on = _bench_graph_us(make_step("glue"))
+            results[str(M)] = {
+                "rel_l2": rel_fp32,
+                "cos": cos_fp32,
+                "rel_l2_vs_triton_attnres": rel_tri,
+                "triton_vs_fp32_attnres": tri_vs_fp32,
+                "pre_attn_h_rel_l2": h_rel_fp32,
+                "pre_attn_h_triton_vs_fp32": h_tri_fp32,
+                "post_mla_moe_rel_l2": moe_rel_fp32,
+                "post_mla_moe_rel_l2_vs_triton": moe_rel_tri,
+                "graph_off_us": round(us_off, 1),
+                "graph_on_us": round(us_on, 1),
+                "delta_us": round(us_off - us_on, 1),
+            }
+
+    del experts, vq_launcher, vq_ws
+    gc.collect()
+    torch.cuda.empty_cache()
+    return results
+
+
+def run_all_mini_ref_checks(mini: Path) -> dict[str, Any]:
+    from vllm.config import VllmConfig, set_current_vllm_config
+    from vllm.sm80.kernels.k31q import dense_k31_ops, glue_ops, vq_ops
+
+    glue_ops.ensure_glue_extension()
+    dense_k31_ops.ensure_dense_k31_extension()
+    vq_ops.ensure_vq_extension()
+    _init_workspace_manager()
+    with set_current_vllm_config(VllmConfig()):
+        return _run_all_mini_ref_checks_body(mini, glue_ops)
+
+
+def _run_all_mini_ref_checks_body(mini: Path, glue_ops) -> dict[str, Any]:
+
+    props = torch.cuda.get_device_properties(0)
+    report: dict[str, Any] = {
+        "gpu": props.name,
+        "sms": props.multi_processor_count,
+        "cc": f"sm_{props.major}{props.minor}",
+        "glue_build_info": glue_ops.build_info(),
+        "bounds": {
+            "attnres_rel_l2": BOUND_ATTNRES_REL_L2,
+            "attnres_cos": BOUND_ATTNRES_COS,
+            "kda_out_rel_l2": BOUND_KDA_OUT_REL_L2,
+            "kda_state_rel_l2": BOUND_KDA_STATE_REL_L2,
+            "router_topk_match": BOUND_ROUTER_TOPK_MATCH,
+            "router_weight_rel_l2": BOUND_ROUTER_WEIGHT_REL_L2,
+            "gemv_rel_l2": BOUND_GEMV_REL_L2,
+            "composite_rel_l2": BOUND_COMPOSITE_REL_L2,
+        },
+    }
+    import time
+    for k, fn in (
+        ("attnres", run_attnres_check),
+        ("kda", run_kda_check),
+        ("router", run_router_check),
+        ("gemv", run_gemv_check),
+    ):
+        t0 = time.perf_counter()
+        report[k] = fn(mini)
+        print(f"[mini-ref] {k} OK ({time.perf_counter() - t0:.1f}s)", flush=True)
+    comp = {}
+    for k, fn in (
+        ("L0", _run_composite_layer0),
+        ("L1", _run_composite_layer1),
+        ("L3", _run_composite_layer3),
+    ):
+        t0 = time.perf_counter()
+        comp[k] = fn(mini)
+        print(f"[mini-ref] composite {k} OK ({time.perf_counter() - t0:.1f}s)", flush=True)
+    report["composite"] = comp
+    out_json = os.environ.get("K31_GLUE_REF_JSON", "")
+    if out_json:
+        Path(out_json).write_text(json.dumps(report, indent=2) + "\n")
+    return report
+
+
+def test_k31_glue_mini_k31q_tp1_reference():
+    from vllm.sm80.kernels.k31q import dense_k31_ops, glue_ops, vq_ops
+
+    mini = _require_mini_dir()
+    gpu.require_library(glue_ops.ensure_glue_extension, "_k31_glue_C")
+    gpu.require_library(dense_k31_ops.ensure_dense_k31_extension, "_k31_dense_C")
+    gpu.require_library(vq_ops.ensure_vq_extension, "_k31_vq_C")
+    report = run_all_mini_ref_checks(mini)
+    assert report["attnres"]["max_rel_l2"] <= BOUND_ATTNRES_REL_L2
+    assert report["kda"]["max_out_rel_l2"] <= BOUND_KDA_OUT_REL_L2
+    assert report["kda"]["max_state_rel_l2"] <= BOUND_KDA_STATE_REL_L2
+    assert report["router"]["min_topk_match"] >= BOUND_ROUTER_TOPK_MATCH
+    assert report["router"]["max_weight_rel_l2"] <= BOUND_ROUTER_WEIGHT_REL_L2
+    assert report["gemv"]["max_rel_l2"] <= BOUND_GEMV_REL_L2
+    for lid in ("L0", "L1"):
