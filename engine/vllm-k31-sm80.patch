+        topk_weights.dim() != 2
+        or topk_ids.dim() != 2
+        or topk_weights.shape != topk_ids.shape
+        or topk_weights.dtype != torch.float32
+        or topk_ids.dtype not in (torch.int32, torch.int64)
+    ):
+        return False
+    K = topk_weights.size(1)
+    return 1 <= K <= 32
+
+
+def moe_prune_topk(
+    topk_weights: torch.Tensor,
+    topk_ids: torch.Tensor,
+    max_topk: int,
+    rel_thresh: float,
+    renormalize: bool,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    return torch.ops.vllm.k31_glue_moe_prune_topk(
+        topk_weights,
+        topk_ids,
+        int(max_topk),
+        float(rel_thresh),
+        bool(renormalize),
+    )
