+def test_commit_plan_moves_only_off_chain_rows():
+    lay = dt.layout(_example())
+    # The greedy chain already sits at its final rows.
+    plan = dt.commit_plan(lay, (1, 2, 3))
+    assert plan == dt.CommitPlan(3, (), (1, 2, 3))
+    # Root -> a -> ab: ab (row 4) belongs at row 2.
+    plan = dt.commit_plan(lay, (1, 4))
+    assert plan.state_row == 4 and plan.kv_moves == ((4, 2),)
+    assert plan.conv_history == (0, 1, 4)
+    # Root -> b: b (row 5) belongs at row 1.
+    plan = dt.commit_plan(lay, (5,))
+    assert plan == dt.CommitPlan(5, ((5, 1),), (-1, 0, 5))
+    # Nothing accepted.
+    assert dt.commit_plan(lay, ()) == dt.CommitPlan(0, (), (-2, -1, 0))
+    with pytest.raises(ValueError):
+        dt.commit_plan(lay, (2,))
+    with pytest.raises(ValueError):
