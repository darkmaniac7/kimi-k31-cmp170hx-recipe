+def cuda_homes(w) -> tuple[str, str]:
+    native = w.resolve()["child_env"]["CUDA_HOME"]["value"]
+    container = w.resolve("--runtime", "container", "--tree", w.tree)["child_env"]["CUDA_HOME"]["value"]
+    return native, container
