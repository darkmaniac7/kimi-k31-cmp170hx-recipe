+def _hc_self(args):
+    return types.SimpleNamespace(norm_eps=args.norm_eps, hc_mult=args.hc_mult,
+                                 hc_sinkhorn_iters=args.hc_sinkhorn_iters, hc_eps=args.hc_eps)
