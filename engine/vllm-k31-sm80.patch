@@ -0,0 +1,44 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The sm_80 fused decode router (``VLLM_MOE_DECODE_ROUTE_V2``) at the gate.
+
+Registered out of tree for ``GateLinear`` (``vllm.sm80.plugin``) while
+VLLM_MOE_DECODE_ROUTE_V2 is set, so every
+``GateLinear`` is built as :class:`Sm80GateLinear`. Only a gate that a
+``MoERunner`` holds and calls itself (``MoERunner._forward_impl``, the
+unfused-gate branch) is given its router (:meth:`attach_router`, called by
+``vllm.sm80.layers.moe.runner.Sm80MoERunner`` with the switch on). Such a gate
+runs gate GEMV + top-k + block alignment in one op when
+``vllm.sm80.kernels.moe.maybe_moe_route_v2`` allows it, returning the fp32
+logits in place of its GEMM output; the router and the Marlin experts pick up
+the stashed top-k and alignment. Every other call, and every gate without a
+router, is upstream's ``GateLinear.forward``.
+"""
+
+import torch
+from torch.nn import Parameter
+
+from vllm.model_executor.layers.fused_moe.router.gate_linear import GateLinear
+
+
+class Sm80GateLinear(GateLinear):
+    """``GateLinear`` that can run the sm_80 fused decode router."""
+
+    # Set per instance by `attach_router`; never a submodule (routers are
+    # not modules), so parameter names and the module tree are unchanged.
+    _route_v2_router = None
+
+    def attach_router(self, router) -> None:
+        self._route_v2_router = router
+
+    def forward(
+        self, x: torch.Tensor
+    ) -> torch.Tensor | tuple[torch.Tensor, Parameter | None]:
+        router = self._route_v2_router
+        if router is not None:
+            from vllm.sm80.kernels.moe import maybe_moe_route_v2
+
+            router_logits = maybe_moe_route_v2(self, router, x)
+            if router_logits is not None:
+                return self._return(router_logits)
+        return super().forward(x)
diff --git a/vllm/sm80/layers/moe/routed_experts.py b/vllm/sm80/layers/moe/routed_experts.py
new file mode 100644
index 0000000000..bb89d78438
--- /dev/null
+++ b/vllm/sm80/layers/moe/routed_experts.py
@@ -0,0 +1,100 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The MoE padding mask (``VLLM_MOE_MASK_PADDING``).
+
+Registered out of tree for ``RoutedExperts`` (``vllm.sm80.plugin``) while
+VLLM_MOE_MASK_PADDING is set, so every
+``RoutedExperts`` is built as :class:`Sm80RoutedExperts`. Its
+``forward_modular`` - called by ``MoERunner._apply_quant_method`` right after
+``router.select_experts`` - masks the top-k ids of the padding rows
+(:func:`mask_padding_topk_ids`) and then runs upstream's ``forward_modular``.
+With the switch off the ids pass through untouched.
+"""
+
+import torch
+
+from vllm.forward_context import get_forward_context, is_forward_context_available
+from vllm.logger import init_logger
+from vllm.model_executor.layers.fused_moe.routed_experts import RoutedExperts
+
+logger = init_logger(__name__)
+
+_MASK_PADDING: bool | None = None
+_MASK_MIN_ROWS = 0
+
+
+def mask_padding_topk_ids(topk_ids: torch.Tensor) -> torch.Tensor:
+    """With VLLM_MOE_MASK_PADDING=1, set the expert ids of padding rows
+    (forward context is_padding) to -1, in place, so the alignment drops them;
+    the real rows then get the same expert blocks whatever the padding rows
+    hold. In place keeps the tensor's identity, which the sm_80 fused decode
+    routing uses to hand over its own alignment. Batches of at most
+    VLLM_MOE_MASK_PADDING_MAX_TOKENS rows (the fused router's range) are
+    skipped whether or not VLLM_AMPERE_DECODE_KERNELS is on; a cutoff of 0
+    masks every batch. A larger batch that the fused router v2 covered (up to
+    32 rows) had its alignment computed before the mask; that handoff is
+    dropped here so the alignment is recomputed from the masked ids, unless
+    the router already masked exactly these rows inside its launch
+    (VLLM_GLM5_MOE_ROUTE_V2_MASK), in which case the ids and its alignment
+    are already the masked ones and nothing is done. Returns topk_ids."""
+    global _MASK_PADDING, _MASK_MIN_ROWS
+    if _MASK_PADDING is None:
+        import vllm.envs as envs
+
+        _MASK_PADDING = bool(envs.VLLM_MOE_MASK_PADDING)
+        _MASK_MIN_ROWS = int(envs.VLLM_MOE_MASK_PADDING_MAX_TOKENS)
+        if _MASK_PADDING:
+            logger.info_once(
+                "MoE padding mask active: padding rows are routed to no "
+                "expert (VLLM_MOE_MASK_PADDING=1; set 0 to disable)"
+            )
+    if not _MASK_PADDING or topk_ids.shape[0] <= _MASK_MIN_ROWS:
+        return topk_ids
+    if not is_forward_context_available():
+        return topk_ids
+    is_padding = get_forward_context().is_padding
+    # Only a call that sees the whole (padded) batch can be masked row for
+    # row: a caller that runs the MoE on row slices of an unpadded batch must
+    # not take the first rows of the batch's mask.
+    if is_padding is None or is_padding.shape[0] != topk_ids.shape[0]:
+        return topk_ids
+    from vllm.sm80.kernels.moe import drop_fused_align, fused_align_is_masked
+
+    if fused_align_is_masked(topk_ids, is_padding):
+        # Route v2 routed these padding rows to no expert in its own launch
+        # and aligned the masked ids: the fill below would rewrite the same
+        # -1s and the handoff is valid.
+        return topk_ids
+    topk_ids.masked_fill_(is_padding.unsqueeze(1), -1)
+    # The sm_80 fused decode router (VLLM_MOE_DECODE_ROUTE_V2, up to 32
+    # rows) stashed a block alignment of these ids before the mask; drop it
+    # so the alignment is recomputed from the masked ids. Which rows are
+    # padding is only known on the device, so this is decided by the call
+    # shape alone and is the same in eager mode and in a captured graph.
+    if drop_fused_align(topk_ids):
+        logger.info_once(
+            "MoE padding mask: the fused router's block alignment is "
+            "recomputed from the masked ids (VLLM_MOE_MASK_PADDING=1)"
+        )
+    return topk_ids
+
+
+class Sm80RoutedExperts(RoutedExperts):
+    """``RoutedExperts`` that masks the padding rows' top-k ids."""
+
+    def forward_modular(
+        self,
+        x: torch.Tensor,
+        topk_weights: torch.Tensor,
+        topk_ids: torch.Tensor,
+        shared_experts=None,
+        shared_experts_input: torch.Tensor | None = None,
+    ):
+        topk_ids = mask_padding_topk_ids(topk_ids)
+        return super().forward_modular(
+            x=x,
+            topk_weights=topk_weights,
+            topk_ids=topk_ids,
+            shared_experts=shared_experts,
+            shared_experts_input=shared_experts_input,
+        )
diff --git a/vllm/sm80/layers/moe/router.py b/vllm/sm80/layers/moe/router.py
new file mode 100644
index 0000000000..08adcc274b
--- /dev/null
+++ b/vllm/sm80/layers/moe/router.py
@@ -0,0 +1,129 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The sm_80 fused decode routing behind upstream's grouped top-k router.
+
+:class:`Sm80GroupedTopKRouter` adds two paths in front of upstream's
+``GroupedTopKRouter._compute_routing``:
+
+- ``VLLM_MOE_DECODE_ROUTE_V2``: the fused router already routed these exact
+  logits at the gate's call site (``vllm.sm80.kernels.moe.maybe_moe_route_v2``
+  via ``vllm.sm80.layers.moe.gate``); its top-k is taken from the stash.
+- ``VLLM_GLM5_DECODE_MOE_ROUTING``: one fused kernel for the routing and the
+  block alignment that ``fused_marlin_moe`` asks for later
+  (``vllm/model_executor/layers/fused_moe/moe_align_block_size.py``: the two
+  call sites are far apart, so the alignment is handed over through the
+  single-slot stash keyed by the topk_ids identity).
+
+Every other call is upstream's. ``vllm.sm80.layers.moe.runner.Sm80MoERunner``
+swaps every router of exactly this upstream class to it.
+"""
+
+import torch
+
+import vllm.envs as envs
+from vllm.model_executor.layers.fused_moe.router.grouped_topk_router import (
+    GroupedTopKRouter,
+)
+
+
+class Sm80GroupedTopKRouter(GroupedTopKRouter):
+    """``GroupedTopKRouter`` with the sm_80 fused decode routing paths."""
+
+    @classmethod
+    def adopt(cls, router: GroupedTopKRouter) -> "Sm80GroupedTopKRouter":
+        """Turn an upstream ``GroupedTopKRouter`` into this class in place."""
+        assert type(router) is GroupedTopKRouter, type(router)
+        router.__class__ = cls
+        return router
+
+    def _compute_routing(
+        self,
+        hidden_states: torch.Tensor,
+        router_logits: torch.Tensor,
+        indices_type: torch.dtype | None,
+        *,
+        input_ids: torch.Tensor | None = None,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        if envs.VLLM_MOE_DECODE_ROUTE_V2 and indices_type in (None, torch.int32):
+            from vllm.sm80.kernels.moe import take_fused_routing
+
+            pre = take_fused_routing(router_logits)
+            if pre is not None:
+                return pre
+
+        fused = self._maybe_fused_route_align(router_logits, indices_type)
+        if fused is not None:
+            return fused
+        return super()._compute_routing(
+            hidden_states, router_logits, indices_type, input_ids=input_ids
+        )
+
+    def _valid_grouping(self, router_logits: torch.Tensor) -> bool:
+        # The same test as upstream's `_compute_routing`: an invalid grouping
+        # takes upstream's fused_topk(_bias) branch before the grouped path.
+        num_experts = router_logits.shape[-1]
+        if num_experts <= self.num_expert_group:
+            return False
+        return num_experts % self.num_expert_group == 0
+
+    def _maybe_fused_route_align(
+        self, router_logits: torch.Tensor, indices_type: torch.dtype | None
+    ) -> tuple[torch.Tensor, torch.Tensor] | None:
+        """Route and align in one kernel when its gate allows, else None."""
+        if not self._valid_grouping(router_logits):
+            return None
+        from vllm.sm80.kernels.moe import (
+            marlin_block_size_m,
+            stash_fused_align,
+            use_ampere_moe_routing,
+        )
+
+        bias = self.e_score_correction_bias
+        if not (
+            bias is not None
+            and not self.skip_padding
+            and self.eplb_state is None
+            and self.num_fused_shared_experts == 0
+            and indices_type in (None, torch.int32)
+            and router_logits.dim() == 2
+            and router_logits.dtype == torch.float32
+            and bias.dtype == torch.float32
+            and use_ampere_moe_routing(
+                router_logits.shape[0],
+                router_logits.shape[-1],
+                self.top_k,
+                scoring_func=self.scoring_func,
+                num_expert_group=self.num_expert_group,
+                topk_group=self.topk_group,
+                renormalize=self.renormalize,
+            )
+        ):
+            return None
+        from vllm.sm80.kernels.moe.routing import fused_route_align
+
+        num_experts = router_logits.shape[-1]
+        block_size = marlin_block_size_m(
+            router_logits.shape[0], self.top_k, num_experts
+        )
+        (
+            topk_weights,
+            topk_ids,
+            sorted_ids,
+            expert_ids,
+            num_tokens_post_pad,
+        ) = fused_route_align(
+            router_logits,
+            bias.data,
+            topk=self.top_k,
+            block_size=block_size,
+            num_experts=num_experts,
+            renormalize=self.renormalize,
+            routed_scaling_factor=self.routed_scaling_factor,
+        )
+        stash_fused_align(
+            topk_ids,
+            block_size,
+            num_experts,
+            (sorted_ids, expert_ids, num_tokens_post_pad),
+        )
+        return topk_weights, topk_ids
diff --git a/vllm/sm80/layers/moe/runner.py b/vllm/sm80/layers/moe/runner.py
new file mode 100644
index 0000000000..5b80576d2e
--- /dev/null
+++ b/vllm/sm80/layers/moe/runner.py
@@ -0,0 +1,177 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The fork's ``MoERunner`` (registered out of tree by ``vllm.sm80.plugin``).
+
+While one of its switches is set (``vllm.sm80.plugin.MOE_LAYERS``), every
+``MoERunner`` is built as :class:`Sm80MoERunner`. Its ``__init__`` runs
+upstream's unchanged and then changes the class of children upstream built or
+was handed, so no module is constructed in a different order and no parameter
+is renamed:
+
+- the ``SharedExperts`` -> ``vllm.sm80.layers.moe.shared_experts`` (the
+  re-ordered aux-stream overlap, ``VLLM_SHARED_EXPERT_REORDER``);
+- a router of exactly ``GroupedTopKRouter`` -> ``vllm.sm80.layers.moe.router``
+  (the sm_80 fused decode routing);
+- a gate it calls itself gets its router (``vllm.sm80.layers.moe.gate``,
+  ``VLLM_MOE_DECODE_ROUTE_V2``).
+
+With ``VLLM_AMPERE_DECODE_IDX_GLUE`` set, :meth:`_select_forward` wraps the
+custom-op entry for the "moesum" part: the routed experts' final ``moe_sum``
+is deferred and fused with the shared-expert add (``moe_sum_add``). Without it
+the entry is upstream's.
+
+Subclasses of ``MoERunner`` (the Transformers backend's runner, Kimi's latent
+runners) are looked up under their own names and stay upstream's.
+"""
+
+from collections.abc import Callable
+from functools import partial
+from typing import cast
+
+import torch
+
+import vllm.envs as envs
+from vllm.model_executor.layers.fused_moe.router.grouped_topk_router import (
+    GroupedTopKRouter,
+)
+from vllm.model_executor.layers.fused_moe.runner.moe_runner import (
+    MoERunner,
+    _unpack,
+)
+from vllm.model_executor.layers.fused_moe.runner.shared_experts import (
+    SharedExperts,
+)
+from vllm.sm80.layers.moe.gate import Sm80GateLinear
+from vllm.sm80.layers.moe.router import Sm80GroupedTopKRouter
+from vllm.sm80.layers.moe.shared_experts import Sm80SharedExperts
+
+
+class Sm80MoERunner(MoERunner):
+    """``MoERunner`` with the fork's MoE paths (see the module docstring)."""
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        if type(self._shared_experts) is SharedExperts:
+            Sm80SharedExperts.adopt(self._shared_experts)
+        if type(self.router) is GroupedTopKRouter:
+            Sm80GroupedTopKRouter.adopt(self.router)
+        if (
+            envs.VLLM_MOE_DECODE_ROUTE_V2
+            and isinstance(self.gate, Sm80GateLinear)
+            and not self._fse_fuse_gate
+        ):
+            self.gate.attach_router(self.router)
+
+    def _select_forward(self) -> Callable:
+        entry = super()._select_forward()
+        # The hidden-dim truncation recorded by `_maybe_pad_hidden_states` for
+        # the moesum gate; set before the first forward.
+        self._moe_sum_og_pre = None
+        self._moe_sum_glue = bool(envs.VLLM_AMPERE_DECODE_IDX_GLUE)
+        if not self._moe_sum_glue:
+            return entry
+        return partial(self._moe_sum_forward_entry, entry)
+
+    def _maybe_pad_hidden_states(
+        self,
+        shared_experts_input: torch.Tensor | None,
+        hidden_states: torch.Tensor,
+    ) -> tuple[torch.Tensor, int | None, int | None]:
+        result = super()._maybe_pad_hidden_states(shared_experts_input, hidden_states)
+        if self._moe_sum_glue:
+            self._moe_sum_og_pre = result[1]
+        return result
+
+    def _moe_sum_forward_entry(
+        self,
+        entry: Callable,
+        hidden_states: torch.Tensor,
+        router_logits: torch.Tensor,
+        shared_experts_input: torch.Tensor | None,
+        input_ids: torch.Tensor | None,
+        layer_name,
+        hidden_dim_unpadded: int,
+    ):
+        """`entry` with the routed moe_sum deferred into the shared add.
+
+        When :meth:`_idx_glue_arm_moe_sum` allows it, the experts leave the
+        routed sum to this wrapper, which returns ``(None, shared + routed)``
+        computed by one ``moe_sum_add`` (bitwise the routed sum, bf16-rounded
+        as before, plus the add). Under that gate everything ``forward`` does
+        between the entry and ``shared + routed`` is the identity, so the
+        result and the kernels are those of doing the add there.
+        """
+        glue_moe_sum = self._idx_glue_arm_moe_sum(
+            hidden_states, self._moe_sum_og_pre
+        )
+        if glue_moe_sum:
+            from vllm.sm80.kernels.moe.sum import MOE_SUM_DEFERRAL
+
+            MOE_SUM_DEFERRAL.arm()
+        try:
+            result = entry(
+                hidden_states,
+                router_logits,
+                shared_experts_input,
+                input_ids,
+                layer_name,
+                hidden_dim_unpadded,
+            )
+        finally:
+            pending_moe_sum = MOE_SUM_DEFERRAL.take() if glue_moe_sum else None
+        if pending_moe_sum is None:
+            return result
+        shared_output, fused_output = _unpack(result)
+        fused_output = cast(torch.Tensor, fused_output)
+        if not self._idx_glue_can_fuse_moe_sum(pending_moe_sum[0], shared_output):
+            # Not fusable after all: do the deferred sum where it would have
+            # gone (and into fused_output, should the experts' finalize have
+            # copied the unsummed buffer), then carry on unchanged.
+            from vllm.sm80.kernels.moe.routing import moe_sum as ampere_moe_sum
+
+            ampere_moe_sum(pending_moe_sum[0], out=pending_moe_sum[1])
+            if fused_output.data_ptr() != pending_moe_sum[1].data_ptr():
+                ampere_moe_sum(pending_moe_sum[0], out=fused_output)
+            return result
+        from vllm.sm80.kernels.moe.sum import moe_sum_add
+
+        assert shared_output is not None
+        return None, moe_sum_add(pending_moe_sum[0], shared_output)
+
+    def _idx_glue_arm_moe_sum(
+        self, hidden_states: torch.Tensor, og_hidden_dim_pre_xform
+    ) -> bool:
+        """Host gate: may the routed moe_sum be deferred into the shared add?
+
+        Everything between the experts' sum and ``shared + routed`` must be the
+        identity: no routed scale, no output transform, no reduction of the
+        routed output before the add, no hidden-dim padding. Decode sizes only
+        (M <= 32, the captured thin-GEMM region).
+        """
+        if (
+            self._shared_experts is None
+            or self.routed_scaling_factor != 1.0
+            or self.routed_output_transform is not None
+            or og_hidden_dim_pre_xform is not None
+            or self._fused_output_is_reduced
+            or hidden_states.dim() != 2
+            or hidden_states.shape[0] > 32
+            or hidden_states.dtype != torch.bfloat16
+        ):
+            return False
+        from vllm.sm80.kernels.idx_glue_gate import use_idx_glue
+
+        return use_idx_glue("moesum")
+
+    @staticmethod
+    def _idx_glue_can_fuse_moe_sum(
+        moe_inp: torch.Tensor, shared_output: torch.Tensor | None
+    ) -> bool:
+        return (
+            shared_output is not None
+            and shared_output.dim() == 2
+            and moe_inp.dim() == 3
+            and shared_output.dtype == moe_inp.dtype
+            and shared_output.shape[0] == moe_inp.shape[0]
+            and shared_output.shape[1] == moe_inp.shape[2]
+        )
diff --git a/vllm/sm80/layers/moe/shared_experts.py b/vllm/sm80/layers/moe/shared_experts.py
new file mode 100644
index 0000000000..4245d7b02d
--- /dev/null
+++ b/vllm/sm80/layers/moe/shared_experts.py
@@ -0,0 +1,134 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The re-ordered multi-stream shared-expert overlap (``VLLM_SHARED_EXPERT_REORDER``).
+
+Upstream (#52033) submits the shared experts to the aux stream in
+``maybe_forward_async``, which ``MoERunner._forward_impl`` calls before the
+gate and the routed dispatch, and joins in ``wait``, which
+``MoERunner._apply_quant_method`` calls after the routed experts. That leaves
+the aux branch resident long before the routed kernels are submitted, so it
+barely overlaps under breakable cudagraphs.
+
+With the flag on, :class:`Sm80SharedExperts` keeps those two call sites and
+changes what they do: ``maybe_forward_async`` only marks the aux stream's start
+point (the aux stream waits for everything the main stream has submitted so
+far) and returns True, and ``wait`` runs the shared experts on the aux stream,
+now behind the gate, the router and the routed experts, then joins the main
+stream back onto it. Enqueue order only: the same kernels read the same
+tensors, and the join still precedes every read of the shared-expert output.
+
+``vllm.sm80.layers.moe.runner.Sm80MoERunner`` swaps every ``SharedExperts`` it
+builds to this class. With the flag off both methods are upstream's.
+"""
+
+import torch
+
+import vllm.envs as envs
+from vllm.logger import init_logger
+from vllm.model_executor.layers.fused_moe.runner.shared_experts import (
+    SharedExperts,
+    SharedExpertsOrder,
+)
+from vllm.utils.torch_utils import current_stream
+
+logger = init_logger(__name__)
+
+
+def _capture_underway() -> bool:
+    """True while the current stream is capturing a CUDA graph.
+
+    Returns False when CUDA is unavailable or not initialised, so the callers
+    below stay importable and testable on a host with no visible device.
+    """
+    try:
+        return torch.cuda.is_current_stream_capturing()
+    except Exception:
+        return False
+
+
+def _log_shared_experts_order_once(reordered: bool) -> None:
+    """Announce which multi-stream enqueue order this process is using."""
+    if reordered:
+        logger.info_once(
+            "MoE shared experts: re-ordered aux-stream overlap "
+            "(mark aux stream, enqueue routed experts, then run shared "
+            "experts on the aux stream and join) "
+            "[VLLM_SHARED_EXPERT_REORDER=1]"
+        )
+    else:
+        logger.info_once(
+            "MoE shared experts: upstream aux-stream overlap "
+            "(shared experts enqueued on the aux stream before routed "
+            "dispatch, joined after) "
+            "[VLLM_SHARED_EXPERT_REORDER=0]"
+        )
+
+
+class Sm80SharedExperts(SharedExperts):
+    """``SharedExperts`` with the re-ordered aux-stream overlap.
+
+    Instances are made by changing the class of an upstream ``SharedExperts``
+    (:meth:`adopt`); nothing else about the module changes.
+    """
+
+    @classmethod
+    def adopt(cls, shared: SharedExperts) -> "Sm80SharedExperts":
+        """Turn an upstream ``SharedExperts`` into this class in place."""
+        assert type(shared) is SharedExperts, type(shared)
+        shared.__class__ = cls
+        # Read once, like every other switch of this module.
+        shared._reorder_after_routed = bool(envs.VLLM_SHARED_EXPERT_REORDER)
+        # One input per DBO ubatch id, held from the aux-stream mark to `wait`.
+        shared._pending_input = [None, None]
+        return shared
+
+    def maybe_forward_async(self, shared_experts_input: torch.Tensor) -> bool:
+        """Upstream's enqueue, or under VLLM_SHARED_EXPERT_REORDER only the
+        aux stream's start point; True when `wait` has work to finish."""
+        if not self._reorder_after_routed:
+            enqueued = super().maybe_forward_async(shared_experts_input)
+            if enqueued:
+                _log_shared_experts_order_once(False)
+            return enqueued
+        if shared_experts_input is None or (
+            self._determine_shared_experts_order(shared_experts_input)
+            != SharedExpertsOrder.MULTI_STREAM_OVERLAPPED
+        ):
+            return False
+        assert self._stream is not None
+        _log_shared_experts_order_once(True)
+        idx = self._output_idx
+        assert self._output[idx] is None and self._pending_input[idx] is None
+        # The aux stream reads the input after the main stream has queued
+        # more work, so hint the caching allocator not to hand the block to
+        # another main-stream allocation in the meantime. The caller holds
+        # the tensor alive across the whole region anyway, so this is belt
+        # and braces; it is skipped while a cudagraph is being captured,
+        # where it is an allocator hint with no counterpart in the replayed
+        # graph. The fork below, and the join in `wait`, are ordinary event
+        # edges and are what actually order the two streams.
+        if not _capture_underway():
+            shared_experts_input.record_stream(self._stream)
+        self._stream.wait_stream(current_stream())
+        self._pending_input[idx] = shared_experts_input
+        return True
+
+    def wait(self) -> None:
+        """Upstream's join, or under VLLM_SHARED_EXPERT_REORDER the shared
+        experts on the aux stream behind the routed experts, then the join."""
+        if not self._reorder_after_routed:
+            super().wait()
+            return
+        assert self._stream is not None
+        idx = self._output_idx
+        shared_experts_input = self._pending_input[idx]
+        assert shared_experts_input is not None and self._output[idx] is None
+        self._pending_input[idx] = None
+        with torch.cuda.stream(self._stream):
+            output = self._layer(shared_experts_input)
+        # Join before the caller reads `output`. The output block belongs to
+        # the aux stream, exactly as in upstream's path; the next layer's aux
+        # fork waits on the main stream, so a later aux-stream reuse of the
+        # block cannot precede the main stream's reads of it.
+        current_stream().wait_stream(self._stream)
+        self._output[idx] = output
