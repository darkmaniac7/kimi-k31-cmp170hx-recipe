+def test_vllm_stage_tap_collector_hooks_mock_model(tmp_path: Path) -> None:
+    """Test _StageTapCollector forward hooks + compute_logits hook on a mock KimiLinearModel."""
+
+    class _MockAttn(torch.nn.Module):
+        def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
+            return hidden_states * 0.25
+
+    class _MockMLP(torch.nn.Module):
+        def forward(self, x: torch.Tensor) -> torch.Tensor:
+            return x * 0.5
+
+    class _MockLayer(torch.nn.Module):
+        def __init__(self) -> None:
+            super().__init__()
+            self.self_attn = _MockAttn()
+            self.mlp = _MockMLP()
+
+        def forward(self, x: torch.Tensor, prefix_sum: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+            a = self.self_attn(hidden_states=x)
+            new_ps = prefix_sum + a
+            m = self.mlp(new_ps)
+            return m, new_ps, new_ps
+
+    class _MockText(torch.nn.Module):
+        def __init__(self) -> None:
+            super().__init__()
+            self.embed_tokens = torch.nn.Embedding(64, 16)
+            self.layers = torch.nn.ModuleList([_MockLayer(), _MockLayer()])
+            self.norm = lambda x, _res=None: x
+
+        def forward(self, ids: torch.Tensor) -> torch.Tensor:
+            h = self.embed_tokens(ids)
+            ps = h
+            for layer in self.layers:
+                m, ps, _ = layer(h, ps)
+                h = ps + m
+            return h
+
+    class _MockLM(torch.nn.Module):
+        def __init__(self) -> None:
+            super().__init__()
+            self.model = _MockText()
+            self.needs_norm_in_logits = True
+            self.head = torch.nn.Linear(16, 64, bias=False)
+
+        def compute_logits(self, hidden_states: torch.Tensor) -> torch.Tensor:
+            return self.head(self.model.norm(hidden_states, None))
+
+    lm = _MockLM()
+    collector = vllm_dump_mod._StageTapCollector(
+        model=lm,
+        taps={"embed", "out", "attn_out", "mlp_out", "final_norm"},
+        save_dtype=torch.bfloat16,
+        topk=8,
+        is_first_pp=True,
+        is_last_pp=True,
+    )
+    collector.reset_prompt(armed=True)
+    h_final = lm.model(torch.tensor([1, 2, 3, 4], dtype=torch.long))
+    _ = lm.compute_logits(h_final)
+    # Decode step (1 token): prefill tensors must not be overwritten, logits must append
+    h_dec = lm.model(torch.tensor([5], dtype=torch.long))
+    _ = lm.compute_logits(h_dec)
+
+    shard = tmp_path / "p0.pp0tp0.safetensors"
+    collector.save_stage_shard(shard, "p0")
+    out_dir = tmp_path / "merged"
+    vllm_dump_mod.merge_stage_shards_to_canonical(
+        staging_dir=tmp_path,
+        out_dir=out_dir,
+        prompt_spec={"id": "p0", "category": "unit", "prompt_text": "hi", "token_ids": [1, 2, 3, 4]},
+        generated_ids=[5, 6],
+        generated_text="ok",
+        model_path="mock",
+        dtype_name="bf16",
+        n_predict=2,
+        topk=8,
+    )
+    with safe_open(str(out_dir / "p0.safetensors"), framework="pt") as f:
+        assert tuple(f.get_tensor("L0.out").shape) == (4, 16)
+        assert tuple(f.get_tensor("L1.out").shape) == (4, 16)
+        assert tuple(f.get_tensor("topk_ids").shape) == (2, 8)
+        assert tuple(f.get_tensor("logsumexp").shape) == (2,)
+
