+# 4. Multi-PP-stage g3taps native loading + AttnRes l_out reconstruction
+# ---------------------------------------------------------------------------
+def test_g3taps_multi_pp_stage_reconstruction_and_compare(tmp_path: Path) -> None:
+    """Verify g3taps .pp0tp0.pt + .pp1tp0.pt reconstruct exact l_out across block & PP boundaries."""
+    g = torch.Generator().manual_seed(42)
+    T, H = 12, 32
+    n_layers = 16  # spans block 0 (0..11), AttnRes boundary at L12, and PP boundary at L14
+
+    attn_outs: dict[int, torch.Tensor] = {}
+    mlp_outs: dict[int, torch.Tensor] = {}
+    true_l_outs: dict[int, torch.Tensor] = {}
+
+    for li in range(n_layers):
+        a = torch.randn((T, H), generator=g, dtype=torch.float32) * 0.4
+        m = torch.randn((T, H), generator=g, dtype=torch.float32) * 0.4
+        attn_outs[li] = a
+        mlp_outs[li] = m
+        if li % 12 == 0:
+            true_l_outs[li] = a + m
+        else:
+            true_l_outs[li] = true_l_outs[li - 1] + a + m
+
+    # Write PP stage 0 (layers 0..13) and PP stage 1 (layers 14..15, NOT a multiple of 12!)
+    rec0: dict[str, Any] = {"positions": torch.arange(T, dtype=torch.int64)}
+    for li in range(14):
+        rec0[f"L{li}.attn_out"] = attn_outs[li].to(torch.bfloat16)
+        rec0[f"L{li}.out"] = mlp_outs[li].to(torch.bfloat16)
+    rec0["relay.hidden_states"] = true_l_outs[13].to(torch.bfloat16)
+
+    rec1: dict[str, Any] = {
+        "positions": torch.arange(T, dtype=torch.int64),
+        "relay_in.hidden_states": true_l_outs[13].to(torch.bfloat16),
+    }
+    for li in range(14, n_layers):
+        rec1[f"L{li}.attn_out"] = attn_outs[li].to(torch.bfloat16)
+        rec1[f"L{li}.out"] = mlp_outs[li].to(torch.bfloat16)
+
+    g3_dir = tmp_path / "g3taps"
+    g3_dir.mkdir()
+    torch.save({"meta": {"pp": 0, "tp": 0, "layers": list(range(14))}, "records": [rec0], "flags": [{"captured": False}]},
+               g3_dir / "prefill.pp0tp0.pt")
+    torch.save({"meta": {"pp": 1, "tp": 0, "layers": [14, 15]}, "records": [rec1], "flags": [{"captured": False}]},
+               g3_dir / "prefill.pp1tp0.pt")
+
+    # Reference llama.cpp canonical dump with exact true l_out, attn_out, mlp_out
+    klx_tensors: dict[str, torch.Tensor] = {}
+    for li in range(n_layers):
+        klx_tensors[f"L{li}.out"] = true_l_outs[li].to(torch.bfloat16)
+        klx_tensors[f"L{li}.attn_out"] = attn_outs[li].to(torch.bfloat16)
+        klx_tensors[f"L{li}.mlp_out"] = mlp_outs[li].to(torch.bfloat16)
+    klx_dump = cmp_mod.PromptDump(
+        prompt_id="prefill",
+        source_format=cmp_mod.SCHEMA_VERSION,
+        engine="llama.cpp",
+        tensors=klx_tensors,
+    )
+    klx_dir = tmp_path / "klx"
+    _save_canonical_dump(klx_dir, klx_dump)
+
+    # Compare directly without manual conversion (g3taps omits token IDs, so opt in)
+    rep = cmp_mod.compare_dumps(
+        str(klx_dir),
+        str(g3_dir),
+        pp_boundaries=(14,),
+        allow_missing_token_ids=True,
+    )
+    assert rep["overall_status"] == "PASS"
+    pr = rep["prompts"][0]
+    assert pr["compared_layers"] == list(range(n_layers))
+    for lr in pr["layer_results"]:
+        assert lr["metrics"]["cos_mean"] > 0.9999
+
+    # Standalone Stage 1 alone fails full-layer coverage by default, and passes with opt-in
+    rep_stage1_strict = cmp_mod.compare_dumps(
+        str(klx_dir),
+        str(g3_dir / "prefill.pp1tp0.pt"),
+        pp_boundaries=(14,),
+        allow_missing_token_ids=True,
+    )
+    assert rep_stage1_strict["overall_status"] == "FAIL"
+    assert any("incomplete layer coverage" in e for e in rep_stage1_strict["prompts"][0]["hard_errors"])
+
+    rep_stage1 = cmp_mod.compare_dumps(
+        str(klx_dir),
+        str(g3_dir / "prefill.pp1tp0.pt"),
+        pp_boundaries=(14,),
+        allow_partial_layers=True,
+        allow_missing_token_ids=True,
+    )
+    assert rep_stage1["overall_status"] == "PASS"
+    assert rep_stage1["prompts"][0]["compared_layers"] == [14, 15]
+
+    # Also test vllm_k31_layer_dump.py --convert-g3taps CLI
+    conv_dir = tmp_path / "converted"
+    rc = vllm_dump_mod.main(["--convert-g3taps", str(g3_dir), "--out", str(conv_dir), "--g3-prompt-id", "prefill"])
+    assert rc == 0
+    val = dump_mod.validate_k31_dump_dir(conv_dir)
+    assert val["prompts"]["prefill"]["layers_with_out"] == list(range(n_layers))
+
