+def test_verify_peer_transport_asymmetric_failure_and_shm_fallback(
+    monkeypatch, meta_platform
+):
+    """Asymmetric BAR1 probe failure on rank 1 triggers coordinated destroy +
+    SHM retry on BOTH ranks; failure of both transports cleanly disables P2P."""
+    monkeypatch.setenv("VLLM_K31_P2P_ALLREDUCE", "1")
+
+    # Case A: BAR1 P2P passes on rank 0, FAILS on rank 1; SHM passes on both.
+    ops = fake_p2p.FakeP2POps(
+        probe_outcomes={
+            (False, 0): True,
+            (False, 1): False,
+            (True, 0): True,
+            (True, 1): True,
+        }
+    ).install(monkeypatch)
+    c0, c1, ok = _run_pair_init(ops, force_shm=False)
+    assert ok == [True, True]
+    assert c0.active and c1.active
+    assert c0.transport == "shm_zero_copy"
+    assert c1.transport == "shm_zero_copy"
+    # First pair (BAR1) was created, connected, probed, and BOTH handles destroyed.
+    assert len(ops.create_calls) == 4
+    assert len(ops.destroy_calls) == 2
+    assert [c["force_shm"] for c in ops.connect_calls] == [False, False, True, True]
+    c0.close()
+    c1.close()
+    assert len(ops.destroy_calls) == 4
+
+    # Case B: Both BAR1 and SHM probes fail on rank 0 -> both ranks disable cleanly.
+    ops_fail = fake_p2p.FakeP2POps(
+        probe_outcomes={
+            (False, 0): False,
+            (False, 1): True,
+            (True, 0): False,
+            (True, 1): True,
+        }
+    ).install(monkeypatch)
+    c0, c1, ok = _run_pair_init(ops_fail, force_shm=False)
+    assert ok == [False, False]
+    assert not c0.active and not c1.active
+    assert c0.handle is None and c1.handle is None
+    assert len(ops_fail.destroy_calls) == 4
+    assert "verify_peer_transport failed" in (c0.disabled_reason or "")
+
+    # Case C: VLLM_K31_P2P_FORCE_SHM=1 skips BAR1 attempt and connects SHM directly.
+    monkeypatch.setenv("VLLM_K31_P2P_FORCE_SHM", "1")
+    ops_shm = fake_p2p.FakeP2POps().install(monkeypatch)
+    c0, c1, ok = _run_pair_init(ops_shm)
+    assert ok == [True, True]
+    assert c0.transport == "shm_zero_copy" and c1.transport == "shm_zero_copy"
+    assert [c["force_shm"] for c in ops_shm.connect_calls] == [True, True]
+    assert len(ops_shm.create_calls) == 2
+    c0.close()
+    c1.close()
