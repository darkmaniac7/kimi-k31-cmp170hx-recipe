+def _build(monkeypatch, directory, tp=(1, 0), pp=(1, 0), partition=None, cls=None):
+    """The text model of one (TP rank, PP stage), on the CPU, through the
+    registry unless ``cls`` is given."""
+    from vllm.config import set_current_vllm_config
+    from vllm.model_executor.models import utils
+    from vllm.utils.torch_utils import set_default_torch_dtype
+
+    _parallel_groups(monkeypatch, tp[0], tp[1], pp[0], pp[1])
+    if partition is None:
+        monkeypatch.delenv("VLLM_PP_LAYER_PARTITION", raising=False)
+    else:
+        monkeypatch.setenv("VLLM_PP_LAYER_PARTITION", ",".join(map(str, partition)))
+    monkeypatch.setattr(torch.cuda, "Stream", _NoStream)
+    monkeypatch.setattr(torch.cuda, "Event", _NoStream)
+    monkeypatch.setattr(utils, "_model_to_pp_missing_layer_names", {})
+    config = cases.vllm_config(directory, tp[0], pp[0])
+    if cls is None:
