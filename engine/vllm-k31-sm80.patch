index 0000000000..097bbc4a85
--- /dev/null
+++ b/tests/sm80/test_indexer_deep_gemm_gates.py
@@ -0,0 +1,57 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The DSA indexer's DeepGEMM gates on sm_80.
+
+The vendored DeepGEMM package makes ``has_deep_gemm()`` true on sm_80 although
+DeepGEMM cannot run there (``is_deep_gemm_supported()`` is false). Only the
+metadata builder must ask ``is_deep_gemm_supported()``: it would otherwise
+build DeepGEMM schedule metadata that the Triton paged MQA logits kernel never
+reads. The capability helpers require SM90 or SM100 anyway, so on sm_80 they
+give the same answer with either predicate.
+"""
+
+import inspect
+
+import pytest
+
+from vllm.platforms import current_platform
+from vllm.v1.attention.backends.mla import indexer
+
+
+def _set_sm80(monkeypatch, has_deep_gemm: bool):
+    monkeypatch.setattr(current_platform, "is_cuda", lambda: True)
+    monkeypatch.setattr(
+        current_platform,
+        "is_device_capability_family",
+        lambda capability, device_id=0: capability // 10 == 8,
+    )
+    monkeypatch.setattr(indexer, "has_deep_gemm", lambda: has_deep_gemm)
+    monkeypatch.setattr(indexer, "is_deep_gemm_supported", lambda: False)
+
+
+@pytest.mark.parametrize("has_deep_gemm", [True, False])
+def test_capability_helpers_on_sm80_whatever_deep_gemm_reports(
+    monkeypatch, has_deep_gemm
+):
+    _set_sm80(monkeypatch, has_deep_gemm)
+    assert not indexer._supports_varlen_paged_mqa_logits()
+    assert not indexer._supports_flattened_device_query_lens()
+    assert [indexer._supports_native_decode(n) for n in range(1, 9)] == [
+        n in (1, 2) for n in range(1, 9)
+    ]
+
+
+def test_every_deep_gemm_predicate_the_module_calls_is_imported():
+    # Each name the module calls must be bound at import, not only on the
+    # paths a CPU test reaches.
+    assert callable(indexer.has_deep_gemm)
+    assert callable(indexer.is_deep_gemm_supported)
+
+
+def test_metadata_builder_asks_whether_deep_gemm_can_run():
+    # The one fork edit left in this upstream file: with has_deep_gemm() here,
+    # sm_80 would build DeepGEMM schedule metadata on every decode step.
+    source = inspect.getsource(indexer.DeepseekV32IndexerMetadataBuilder.build)
+    assert "is_deep_gemm_supported()" in source
+    assert "has_deep_gemm()" not in source
+    assert source.count("get_paged_mqa_logits_metadata(") == 1
diff --git a/tests/sm80/test_k31_stage_timing.py b/tests/sm80/test_k31_stage_timing.py
new file mode 100644
index 0000000000..3d487bc563
--- /dev/null
+++ b/tests/sm80/test_k31_stage_timing.py
@@ -0,0 +1,319 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""VLLM_K31_STAGE_TIMING (vllm/sm80/worker/stage_timing.py), CPU only: the
+probe reads a step's CUDA timing events only once they have completed, never
+waits, and reports GPU segments, host segments, the step period and how often
+the host was late."""
+
+import inspect
+
+import pytest
+
+from vllm.sm80.worker import stage_timing
+from vllm.sm80.worker.stage_timing import StageTimer, make_stage_timer
+from vllm.v1.worker.gpu.model_runner import GPUModelRunner
+from vllm.v1.worker.gpu_worker import Worker
+
+
+class _Gpu:
+    """A fake device clock: an event completes once the clock passes the time
+    it was recorded for. ``schedule`` gives the completion time of the next
+    recorded events (the stream may run behind the host)."""
+
+    def __init__(self):
+        self.now = 0.0
+        self.schedule: list[float] = []
+        self.created = 0
+        self.queries = 0
+
+    def event(self):
+        gpu = self
+        gpu.created += 1
+
+        class _Event:
+            at = None
+
+            def record(self):
+                self.at = gpu.schedule.pop(0)
+
+            def query(self):
+                gpu.queries += 1
+                return self.at <= gpu.now
+
+            def elapsed_time(self, other):
+                assert self.query() and other.query(), "read before completion"
+                return other.at - self.at
+
+            def synchronize(self):
+                raise AssertionError("the probe must never wait for the GPU")
+
+            wait = synchronize
+
+        return _Event()
+
+
+class _Host:
+    def __init__(self):
+        self.t = 0.0
+
+    def __call__(self):
+        return self.t
+
+
+def _timer(interval=2):
+    gpu, host, lines = _Gpu(), _Host(), []
+    timer = StageTimer(
+        interval, label="pp=0 tp=0", event_factory=gpu.event, clock=host, emit=lines.append
+    )
+    return timer, gpu, host, lines
+
+
+def _step(timer, gpu, host, marks, kind="N", rows=8, late=()):
+    """Run one step: ``marks`` = [(name, host_seconds, gpu_ms or None)]."""
+    timer.begin(rows)
+    timer.set_kind(kind)
+    for name, host_t, gpu_t in marks:
+        host.t = host_t
+        if gpu_t is None:
+            timer.mark(name, gpu=False)
+        else:
+            gpu.schedule.append(gpu_t)
+            timer.mark(name)
+        for at, dep in late:
+            if at == name:
+                timer.late(name, dep)
+    timer.end()
+
+
+FIRST_STAGE = [
+    ("x0", 0.0000, None),
+    ("bc", 0.0002, 40.0),
+    ("f0", 0.0009, 40.3),
+    ("f1", 0.0010, 50.1),
+    ("tx", 0.0011, 50.2),
+]
+
+
+def _shift(marks, host_dt, gpu_dt):
+    return [(n, h + host_dt, None if g is None else g + gpu_dt) for n, h, g in marks]
+
+
+def test_reads_nothing_before_the_events_complete_and_never_waits():
+    timer, gpu, host, lines = _timer(interval=1)
+    _step(timer, gpu, host, FIRST_STAGE)
+    assert not lines  # the stream has not reached the marks yet
+    gpu.now = 45.0  # part of the step's events are done
+    timer.drain()
+    assert not lines
+    gpu.now = 60.0
+    timer.drain()
+    assert len(lines) == 1 and "n=1" in lines[0]
+
+
+def test_gpu_and_host_segments_period_and_log_cadence():
+    timer, gpu, host, lines = _timer(interval=2)
+    for i in range(3):
+        gpu.now = 41.0 * i + 39.0  # the previous step is done by now
+        _step(timer, gpu, host, _shift(FIRST_STAGE, 0.041 * i, 41.0 * i))
+    # Steps 0 and 1 resolved while steps 1 and 2 were recorded.
+    assert len(lines) == 1
+    line = lines[0]
+    assert line.startswith("K31_STAGE_TIMING pp=0 tp=0 | N rows=8 n=2")
+    assert "period=41.00/41.00" in line  # f0 to f0, one period for two steps
+    assert "bc>f0=0.300/0.300" in line
+    assert "f0>f1=9.800/9.800" in line
+    assert "f1>tx=0.100/0.100" in line
+    assert "x0>bc=0.200" in line and "bc>f0=0.700" in line and "f1>tx=0.100" in line
+    assert "x0" not in line.split("gpu[")[1].split("]")[0]  # host-only mark
+    gpu.now = 1000.0
+    timer.drain()
+    timer.flush()
+    assert len(lines) == 2 and "n=1" in lines[1] and "period=41.00" in lines[1]
+
+
+def test_mean_and_max_over_steps():
+    timer, gpu, host, lines = _timer(interval=2)
+    gpu.now = 1e9
+    _step(timer, gpu, host, [("f0", 0.0, 10.0), ("f1", 0.001, 19.0)])
+    _step(timer, gpu, host, [("f0", 0.050, 60.0), ("f1", 0.052, 71.0)])
+    assert "f0>f1=10.000/11.000" in lines[0]
+    assert "host[f0>f1=1.500]" in lines[0]
+    assert "period=50.00/50.00" in lines[0]
+
+
+def test_late_counts_when_the_input_arrived_before_the_launch_returned():
+    timer, gpu, host, lines = _timer(interval=3)
+    # Step 1: the host is ahead; the input (bc) is still pending at f1.
+    gpu.now = 0.0
+    _step(timer, gpu, host, FIRST_STAGE, late=[("f1", "bc")])
+    # Step 2: the broadcast had landed (bc done) before the launch returned.
+    gpu.now = 100.0
+    marks = _shift(FIRST_STAGE, 0.041, 41.0)
+    _step(timer, gpu, host, marks, late=[("f1", "bc")])
+    gpu.now = 200.0
+    _step(timer, gpu, host, _shift(FIRST_STAGE, 0.082, 82.0), late=[("f1", "bc")])
+    timer.drain()
+    assert len(lines) == 1 and "late[f1=2/3]" in lines[0]
+
+
+def test_late_takes_the_first_input_mark_the_step_recorded():
+    timer, gpu, host, lines = _timer(interval=2)
+    # First stage with the split draft event: counts (bc) long arrived, the
+    # drafts (dr) not yet: the host is not late.
+    gpu.now = 41.0
+    timer.begin(8)
+    gpu.schedule += [40.0, 43.0, 43.1, 52.0]
+    for name in ("bc", "dr", "f0", "f1"):
+        timer.mark(name)
+    timer.late("f1", "rx", "dr", "bc")
+    timer.end()
+    # Without the split there is no dr mark: bc is the input.
+    gpu.now = 90.0
+    timer.begin(8)
+    gpu.schedule += [81.0, 95.0, 99.0]
+    for name in ("bc", "f0", "f1"):
+        timer.mark(name)
+    timer.late("f1", "rx", "dr", "bc")
+    timer.end()
+    gpu.now = 1e9
+    timer.drain()
+    assert "late[f1=1/2]" in lines[0]
+    assert "bc>dr=3.000/3.000" in lines[0] and "dr>f0=0.100/0.100" in lines[0]
+
+
+def test_late_against_a_missing_or_host_only_mark_is_ignored():
+    timer, gpu, host, lines = _timer(interval=1)
+    gpu.now = 1e9
+    timer.begin(4)
+    gpu.schedule.append(1.0)
+    timer.mark("x0", gpu=False)
+    timer.mark("f1")
+    timer.late("f1", "rx")  # never recorded
+    timer.late("f1", "x0")  # host only
+    timer.end()
+    assert "late[]" in lines[0]
+
+
+def test_kinds_and_row_counts_are_reported_apart():
+    timer, gpu, host, lines = _timer(interval=4)
+    gpu.now = 1e9
+    _step(timer, gpu, host, [("f0", 0.0, 0.0), ("f1", 0.0, 9.0)], kind="A", rows=4)
+    _step(timer, gpu, host, [("f0", 0.0, 10.0), ("f1", 0.0, 21.0)], kind="B", rows=4)
+    _step(timer, gpu, host, [("f0", 0.0, 50.0), ("f1", 0.0, 62.0)], kind="N", rows=8)
+    _step(timer, gpu, host, [("f0", 0.0, 90.0), ("f1", 0.0, 99.0)], kind="A", rows=4)
+    assert len(lines) == 3
+    by_kind = {line.split("|")[1].split()[0]: line for line in lines}
+    assert "rows=4 n=2" in by_kind["A"] and "rows=4 n=1" in by_kind["B"]
+    assert "rows=8 n=1" in by_kind["N"]
+    # A period belongs to the step it started with: A to B, B to N, N to A.
+    assert "period=10.00/10.00" in by_kind["A"]
+    assert "period=40.00/40.00" in by_kind["B"]
+    assert "period=40.00/40.00" in by_kind["N"]
+
+
+def test_marks_outside_a_step_are_ignored_and_an_unfinished_step_is_dropped():
+    timer, gpu, host, lines = _timer(interval=1)
+    timer.mark("f0")  # no step begun: an empty or dummy step
+    timer.late("f1", "bc")
+    timer.end()
+    assert gpu.created == 0 and not lines
+    gpu.now = 1e9
+    timer.begin(8)
+    gpu.schedule.append(1.0)
+    timer.mark("f0")
+    timer.begin(8)  # the previous step never ended (it raised)
+    gpu.schedule += [5.0, 6.0]
+    timer.mark("f0")
+    timer.mark("f1")
+    timer.end()
+    assert "n=1" in lines[0] and "dropped=1" in lines[0]
+    timer.begin(8)
+    timer.abort()  # a dropped PipeSpec chunk ran no forward
+    timer.end()
+    assert len(lines) == 1
+
+
+def test_events_are_reused_after_their_step_was_read():
+    timer, gpu, host, lines = _timer(interval=100)
+    for i in range(20):
+        gpu.now = 41.0 * i + 39.0
+        _step(timer, gpu, host, _shift(FIRST_STAGE, 0.041 * i, 41.0 * i))
+    # Four events a step; the pool settles after the first few steps.
+    assert gpu.created <= 12
+
+
+def test_pending_steps_are_bounded_when_the_stream_stops():
+    timer, gpu, host, lines = _timer(interval=1)
+    for i in range(stage_timing.MAX_PENDING + 10):
+        _step(timer, gpu, host, [("f0", 0.0, 1.0), ("f1", 0.0, 2.0)])
+    assert len(timer._pending) == stage_timing.MAX_PENDING and timer.dropped == 10
+    assert not lines
+
+
+def test_a_cuda_error_turns_the_probe_off_without_raising():
+    calls = []
+
+    class _Bad:
+        def record(self):
+            calls.append(1)
+            raise RuntimeError("CUDA error: an illegal memory access")
+
+    timer = StageTimer(1, event_factory=_Bad, clock=lambda: 0.0, emit=calls.append)
+    timer.begin(8)
+    timer.mark("f0")
+    assert timer.failed
+    timer.mark("f1")
+    timer.late("f1", "f0")
+    timer.end()
+    timer.begin(8)
+    timer.mark("f0")
+    timer.end()
+    assert calls == [1]
+
+
+def test_switch_default_off_and_interval(monkeypatch):
+    monkeypatch.delenv("VLLM_K31_STAGE_TIMING", raising=False)
+    assert make_stage_timer(0, 0) is None
+    monkeypatch.setenv("VLLM_K31_STAGE_TIMING", "0")
+    assert make_stage_timer(0, 0) is None
+    monkeypatch.setenv("VLLM_K31_STAGE_TIMING", "64")
+    timer = make_stage_timer(3, 1)
+    assert isinstance(timer, StageTimer)
+    assert timer.interval == 64 and timer.label == "pp=3 tp=1"
+    # Without ranks it asks the worker's groups, and only when it is on.
+    from types import SimpleNamespace
+
+    from vllm.distributed import parallel_state
