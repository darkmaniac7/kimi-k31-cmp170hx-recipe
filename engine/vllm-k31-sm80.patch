+// ============================================================================
+// 3. ULTRA-FAST PREFILL KERNELS (M > 32 -> 100%-COALESCED DEQUANT + cuBLAS!)
+// ============================================================================
+__global__ void k31_prefill_h128_in_bf16_kernel(
+    const __nv_bfloat16* __restrict__ x,
+    const half* __restrict__ suh,
+    int64_t rows, int64_t logical_in, int64_t padded_in,
+    __nv_bfloat16* __restrict__ x_h
+) {
+  const int warp = threadIdx.x >> 5;
+  const int lane = threadIdx.x & 31;
+  const int64_t blocks = padded_in / 128;
+  const int64_t task = static_cast<int64_t>(blockIdx.x) * (blockDim.x >> 5) + warp;
+  if (task >= rows * blocks) return;
+
+  const int64_t row = task / blocks;
+  const int64_t base = (task % blocks) * 128 + lane;
+  float v[4];
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    const int64_t col = base + 32 * i;
+    v[i] = (col < logical_in)
+        ? (__bfloat162float(x[row * logical_in + col]) * __half2float(__ldg(suh + col)))
+        : 0.0f;
+  }
+  hadamard128_warp(v, lane);
+  __nv_bfloat16* dst = x_h + row * padded_in + base;
+#pragma unroll
+  for (int i = 0; i < 4; ++i) dst[32 * i] = __float2bfloat16_rn(v[i]);
+}
+
+template <int kBitsX2>
+__global__ void k31_dequant_trellis_kn_bf16_kernel(
+    const uint16_t* __restrict__ trellis,
+    int64_t tiles_k, int64_t tiles_n_total, int64_t nt_start, int64_t nt_chunk,
+    __nv_bfloat16* __restrict__ w_kn
+) {
+  using Ring = TileRing<kBitsX2>;
+  const int64_t n_blocks_128 = nt_chunk / 8;
+  const int64_t blk_idx = blockIdx.x;
+  if (blk_idx >= tiles_k * n_blocks_128) return;
+
+  const int64_t nb = blk_idx % n_blocks_128;
+  const int64_t kt = blk_idx / n_blocks_128;
+  const int warp = threadIdx.x >> 5;
+  const int lane = threadIdx.x & 31;
+  const int64_t nt = nt_start + nb * 8 + warp;
+
+  __shared__ __align__(16) __nv_bfloat16 sh_tile[16][136];  // +8 BF16 (16B) stride avoids 4-way SMEM bank conflicts!
+
+  const uint16_t* tile_ptr = trellis + (kt * tiles_n_total + nt) * Ring::kTileHalfwords;
+  const uint32_t* tile_u32 = reinterpret_cast<const uint32_t*>(tile_ptr);
+  const LaneWindow<kBitsX2> win(lane);
+  uint32_t words[Ring::kLoadWords];
+#pragma unroll
+  for (int i = 0; i < Ring::kLoadWords; ++i) words[i] = __ldg(tile_u32 + win.word[i]);
+
+  uint32_t pair[4];
+  decode_lane_h2<kBitsX2>(words, win.shift, pair);
+
+  const int g = lane >> 2;
+  const int q = lane & 3;
+  const int col0 = warp * 16 + g;
+  auto store_pair_kn = [&](int k0, int c, uint32_t h2_u) {
+    const __half2 hv = *reinterpret_cast<const __half2*>(&h2_u);
+    const float2 fv = __half22float2(hv);
+    sh_tile[k0][c]     = __float2bfloat16_rn(fv.x);
+    sh_tile[k0 + 1][c] = __float2bfloat16_rn(fv.y);
+  };
+  store_pair_kn(2 * q,     col0,     pair[0]);
+  store_pair_kn(2 * q + 8, col0,     pair[1]);
+  store_pair_kn(2 * q,     col0 + 8, pair[2]);
+  store_pair_kn(2 * q + 8, col0 + 8, pair[3]);
+  __syncthreads();
+
+  const int r_loc = threadIdx.x >> 4;
+  const int c_u4  = threadIdx.x & 15;
+  const int64_t n_chunk_u4 = nt_chunk * 2;
+  uint4* dst = reinterpret_cast<uint4*>(w_kn) + (kt * 16 + r_loc) * n_chunk_u4 + nb * 16 + c_u4;
+  *dst = reinterpret_cast<const uint4*>(&sh_tile[r_loc][0])[c_u4];
+}
+
+template <typename OutT>
+__global__ void k31_prefill_h128_out_kernel(
+    const __nv_bfloat16* __restrict__ y_h,
+    const half* __restrict__ svh,
+    int64_t rows, int64_t chunk_col_start, int64_t chunk_pad_out,
+    int64_t logical_out, int64_t total_logical_out, int64_t out_offset,
+    OutT* __restrict__ out
+) {
+  const int warp = threadIdx.x >> 5;
+  const int lane = threadIdx.x & 31;
+  const int64_t blocks = chunk_pad_out / 128;
+  const int64_t task = static_cast<int64_t>(blockIdx.x) * (blockDim.x >> 5) + warp;
+  if (task >= rows * blocks) return;
+
+  const int64_t row = task / blocks;
+  const int64_t blk = task % blocks;
+  const __nv_bfloat16* src = y_h + row * chunk_pad_out + blk * 128 + lane;
+  float v[4];
+#pragma unroll
+  for (int i = 0; i < 4; ++i) v[i] = __bfloat162float(src[32 * i]);
+  hadamard128_warp(v, lane);
+
+  OutT* dst = out + row * total_logical_out + out_offset;
+  const int64_t col_base = chunk_col_start + blk * 128 + lane;
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    const int64_t c = col_base + 32 * i;
+    if (c < logical_out) store_out(dst + c, v[i] * __half2float(__ldg(svh + c)));
+  }
+}
