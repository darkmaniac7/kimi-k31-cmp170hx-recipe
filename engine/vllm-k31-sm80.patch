+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""K3.1 PipeSpec Chunk B without KDA state copies
+(VLLM_K31_PIPESPEC_BANK_FLIP, cmp_pipespec.KDAPipeSpecSlotFlip).
+
+Covers:
+1. Bit-exact equivalence of the slot permutation with both the Bank-0 /
+   Bank-1 copies (KDAPipeSpecStateManager) and plain sequential decoding, over
+   random programs of normal steps and PipeSpec epochs (valid B, B dropped
+   after a partial A, B dropped after a full A, per-epoch chunk_k), for both
+   convolution state layouts and several KDA layers.
+2. No recurrent state is read or written outside the verify kernel, and the
+   convolution copy is three columns of one line.
+3. The predicated commit: valid, dropped and masked requests.
+4. MambaHybridModelState wiring: multi-group prepare and commit, the batch
+   rows of the permutation, request reuse, and the switch-off path.
+
+CPU only.
+"""
+
+from __future__ import annotations
+
+import inspect
+import random
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+
+from vllm.v1.cmp_pipespec import KDAPipeSpecSlotFlip, KDAPipeSpecStateManager
+
+pytestmark = pytest.mark.cpu_test
+
+K_MAX = 11  # num_speculative_tokens
+SLOTS = K_MAX + 1  # spec_state_slots
+HEADS, D = 2, 4
+DIM = 3 * HEADS * D  # q, k, v channels of one TP rank
+NUM_BLOCKS = 40
+
+
+def _line(conv: torch.Tensor, block: int, token_dim: int) -> torch.Tensor:
+    """The [dim, columns] view of one convolution line."""
+    return conv[block] if token_dim == 2 else conv[block].transpose(0, 1)
+
+
+def _verify_step(
+    x: torch.Tensor,  # [rows, DIM]
+    conv: torch.Tensor,
+    conv_w: torch.Tensor,  # [DIM, 4]
+    rec: torch.Tensor,  # [blocks, HEADS, D, D]
+    state_indices: torch.Tensor,  # [slots]
+    num_accepted: int,
+    token_dim: int,
+) -> torch.Tensor:
+    """The state semantics shared by the KDA verify kernels
+    (causal_conv1d_update + fused_recurrent_kda, and
+    _k31_glue_C.fused_kda_spec_verify): the convolution history is columns
+    ``a - 1 .. a + 1`` of the line of ``state_indices[0]``, the line becomes
+    ``[h1, h2, x_0 ..]``, the recurrent state starts from
+    ``state_indices[a - 1]`` and row ``t`` stores its state in
+    ``state_indices[t]`` when that block id is positive."""
+    rows = x.shape[0]
+    offset = num_accepted - 1
+    line = _line(conv, int(state_indices[0]), token_dim)
+    prior = line[:, offset : offset + 3].clone()
+    seq = torch.cat([prior, x.T], dim=1)
+    conv_out = torch.stack([(seq[:, t : t + 4] * conv_w).sum(dim=1) for t in range(rows)])
+    line[:, 0:2] = prior[:, 1:3]
+    line[:, 2 : 2 + rows] = x.T
+
+    init = int(state_indices[offset])
+    assert init > 0, "a verify step never starts from the null block"
+    h = rec[init].clone()
+    outs = []
+    for t in range(rows):
+        q, k, v = conv_out[t].view(3, HEADS, D)
+        k = k / torch.sqrt((k * k).sum(dim=-1, keepdim=True) + 1e-6)
+        h = h * torch.sigmoid(q)[:, None, :]
+        dv = (v - (h * k[:, None, :]).sum(dim=-1)) * 0.5
+        h = h + dv[:, :, None] * k[:, None, :]
+        outs.append((h * q[:, None, :]).sum(dim=-1).reshape(-1))
+        dst = int(state_indices[t])
+        if dst > 0:
+            rec[dst].copy_(h)
+    return torch.stack(outs)
+
+
+class _System:
+    """One request's KDA state on one PP stage: several layers, one block
+    table row, the accepted count the next step starts from."""
+
+    def __init__(self, convs, recs, token_dim):
+        self.convs = [c.clone() for c in convs]
+        self.recs = [r.clone() for r in recs]
+        self.token_dim = token_dim
+        self.acc = torch.ones(3, dtype=torch.int32)
+        # Request index 1 of 3; blocks 5 .. 5 + SLOTS - 1.
+        self.block_table = torch.arange(5, 5 + SLOTS, dtype=torch.int32).unsqueeze(0)
+        self.perm = KDAPipeSpecSlotFlip.identity(3, SLOTS, torch.device("cpu"))
+        self.req = torch.tensor([1], dtype=torch.int32)
+
+    def run(self, x, conv_ws, state_indices, num_accepted):
+        return [
+            _verify_step(x, c, w, r, state_indices, num_accepted, self.token_dim)
+            for c, r, w in zip(self.convs, self.recs, conv_ws)
+        ]
+
+    def pairs(self):
+        return list(zip(self.convs, self.recs))
+
+
+def _initial_state(token_dim: int, num_layers: int):
+    convs, recs = [], []
+    for _ in range(num_layers):
+        shape = (NUM_BLOCKS, DIM, 3 + K_MAX) if token_dim == 2 else (
+            NUM_BLOCKS, 3 + K_MAX, DIM
+        )
+        convs.append(torch.randn(shape))
+        recs.append(torch.randn(NUM_BLOCKS, HEADS, D, D))
+    return convs, recs
+
+
+@pytest.mark.parametrize("token_dim", [2, 1])
+@pytest.mark.parametrize("seed", [0, 1, 2, 3])
+def test_slot_flip_is_bit_exact_with_copies_and_sequential(token_dim, seed):
+    torch.manual_seed(100 + seed)
+    rng = random.Random(seed)
+    num_layers = 3
+    convs, recs = _initial_state(token_dim, num_layers)
+    conv_ws = [torch.randn(DIM, 4) for _ in range(num_layers)]
+    ref = _System(convs, recs, token_dim)  # sequential, never runs a dropped B
+    cp = _System(convs, recs, token_dim)  # Bank-0 / Bank-1 copies
+    fl = _System(convs, recs, token_dim)  # slot permutation
+    full = ref.block_table[0, :SLOTS]
+
+    num_valid_b = num_dropped_partial = num_dropped_full = 0
+    for _ in range(60):
+        if rng.random() < 0.35:
+            # Normal step: any width, any accepted count.
+            rows = rng.randint(1, SLOTS)
+            m = rng.randint(1, rows)
+            x = torch.randn(rows, DIM)
+            out_ref = ref.run(x, conv_ws, full, int(ref.acc[1]))
+            out_cp = cp.run(x, conv_ws, full, int(cp.acc[1]))
+            logical = KDAPipeSpecSlotFlip.logical_block_table(fl.block_table, fl.perm[1:2])
+            out_fl = fl.run(x, conv_ws, logical[0], int(fl.acc[1]))
+            for a, b, c in zip(out_ref, out_cp, out_fl):
+                assert torch.equal(a, b) and torch.equal(a, c)
+            ref.acc[1] = cp.acc[1] = fl.acc[1] = m
+            continue
+
+        # PipeSpec epoch with this epoch's own chunk_k.
+        ck = rng.choice([1, 2, 3, 4, 5])
+        assert 2 * (ck + 1) <= SLOTS
+        m_a = ck + 1 if rng.random() < 0.6 else rng.randint(1, ck)
+        m_b = rng.randint(1, ck + 1) if (m_a == ck + 1 and rng.random() < 0.7) else 0
+        if m_b:
+            num_valid_b += 1
+        elif m_a == ck + 1:
+            num_dropped_full += 1
+        else:
+            num_dropped_partial += 1
+        x_a = torch.randn(ck + 1, DIM)
+        x_b = torch.randn(ck + 1, DIM)
+
+        # Chunk A.
+        out_ref_a = ref.run(x_a, conv_ws, full, int(ref.acc[1]))
+        out_cp_a = cp.run(x_a, conv_ws, full, int(cp.acc[1]))
+        logical = KDAPipeSpecSlotFlip.logical_block_table(fl.block_table, fl.perm[1:2])
+        out_fl_a = fl.run(x_a, conv_ws, logical[0], int(fl.acc[1]))
+        for a, b, c in zip(out_ref_a, out_cp_a, out_fl_a):
+            assert torch.equal(a, b) and torch.equal(a, c)
+
+        # Chunk B runs before A's result is known (full accept assumed).
+        KDAPipeSpecStateManager.prepare_chunk_b(cp.pairs(), cp.block_table[0], ck)
+        b_cp = KDAPipeSpecStateManager.build_chunk_b_state_indices(
+            cp.block_table, ck, SLOTS
+        )
+        out_cp_b = cp.run(x_b, conv_ws, b_cp[0], ck + 1)
+
+        recs_before = [r.clone() for r in fl.recs]
+        convs_before = [c.clone() for c in fl.convs]
+        KDAPipeSpecSlotFlip.prepare_chunk_b(
+            fl.convs, logical[0], ck, token_dim=token_dim
+        )
+        for r, r0 in zip(fl.recs, recs_before):
+            assert torch.equal(r, r0), "prepare must not touch a recurrent state"
+        dst_block = int(logical[0, ck + 1])
+        for c, c0 in zip(fl.convs, convs_before):
+            changed = (c != c0).nonzero()
+            assert set(changed[:, 0].tolist()) <= {dst_block}
+            assert set(changed[:, token_dim].tolist()) <= {ck + 1, ck + 2, ck + 3}
+        b_fl = KDAPipeSpecSlotFlip.build_chunk_b_state_indices(logical, ck, SLOTS)
+        out_fl_b = fl.run(
+            x_b, conv_ws, b_fl[0], ck + KDAPipeSpecSlotFlip.ACCEPTED_OFFSET
+        )
+        # Same speculative B in both designs, valid or not.
+        for b, c in zip(out_cp_b, out_fl_b):
+            assert torch.equal(b, c)
+
+        # Results: A first, then B commits or rolls back.
+        ref.acc[1] = cp.acc[1] = fl.acc[1] = m_a
+        if m_b:
+            out_ref_b = ref.run(x_b, conv_ws, full, int(ref.acc[1]))
+            for a, c in zip(out_ref_b, out_fl_b):
+                assert torch.equal(a, c)
+            ref.acc[1] = m_b
+        sampled_b = torch.tensor([m_b], dtype=torch.int32)
+        KDAPipeSpecStateManager.commit_or_rollback_chunk_b(
+            cp.pairs(), cp.block_table[0], ck, sampled_b, cp.acc, cp.req
+        )
+        recs_before = [r.clone() for r in fl.recs]
+        convs_before = [c.clone() for c in fl.convs]
+        KDAPipeSpecSlotFlip.commit_or_rollback_chunk_b(
+            fl.perm, ck, sampled_b, fl.acc, fl.req
+        )
+        for r, r0, c, c0 in zip(fl.recs, recs_before, fl.convs, convs_before):
+            assert torch.equal(r, r0) and torch.equal(c, c0), (
+                "commit must not touch KDA state"
+            )
+        assert int(cp.acc[1]) == int(ref.acc[1]) == int(fl.acc[1])
+        assert sorted(fl.perm[1].tolist()) == list(range(SLOTS))
+        # Other request rows never move.
+        assert fl.perm[0].tolist() == list(range(SLOTS))
+        assert fl.perm[2].tolist() == list(range(SLOTS))
+
+    assert num_valid_b and num_dropped_partial and num_dropped_full
+
+
+def test_chunk_b_state_indices_and_bounds():
+    bt = torch.arange(1, 13, dtype=torch.int32).unsqueeze(0)
+    perm = KDAPipeSpecSlotFlip.identity(1, 12, torch.device("cpu"))
+    logical = KDAPipeSpecSlotFlip.logical_block_table(bt, perm)
+    assert torch.equal(logical, bt)
+    out = KDAPipeSpecSlotFlip.build_chunk_b_state_indices(logical, 3, 12)
+    # Rows 0..3 write logical slots 4..7; column 4 is the start state (slot 3).
+    assert out[0].tolist() == [5, 6, 7, 8, 4, 0, 0, 0, 0, 0, 0, 0]
+    with pytest.raises(ValueError, match="needs 12 state slots"):
+        KDAPipeSpecSlotFlip.build_chunk_b_state_indices(logical[:, :10], 5, 12)
+    with pytest.raises(ValueError, match="needs 12 state slots"):
+        KDAPipeSpecSlotFlip.build_chunk_b_state_indices(logical, 5, 10)
+    with pytest.raises(ValueError, match="covers 12 state slots"):
+        KDAPipeSpecSlotFlip.logical_block_table(bt[:, :8], perm)
+    # A line too short for the shifted history is refused.
+    with pytest.raises(ValueError, match="reads convolution columns"):
+        KDAPipeSpecSlotFlip.prepare_chunk_b(
+            [torch.zeros(16, 4, 6)], logical[0], 3, token_dim=2
+        )
+
+
+def test_commit_is_predicated_and_composes():
+    perm = KDAPipeSpecSlotFlip.identity(4, 8, torch.device("cpu"))
+    acc = torch.tensor([1, 4, 1, 1], dtype=torch.int32)
+    # Dropped B: nothing moves.
+    KDAPipeSpecSlotFlip.commit_or_rollback_chunk_b(
+        perm, 3, torch.tensor([0]), acc, torch.tensor([1])
+    )
+    assert perm[1].tolist() == list(range(8)) and acc.tolist() == [1, 4, 1, 1]
+    # Masked request (freed since the receive): nothing moves, row 0 included.
+    KDAPipeSpecSlotFlip.commit_or_rollback_chunk_b(
+        perm, 3, torch.tensor([2]), acc, torch.tensor([-1])
+    )
+    assert perm[0].tolist() == list(range(8)) and acc.tolist() == [1, 4, 1, 1]
+    # Valid B with chunk_k = 3.
+    KDAPipeSpecSlotFlip.commit_or_rollback_chunk_b(
+        perm, 3, torch.tensor([2]), acc, torch.tensor([1])
+    )
+    assert perm[1].tolist() == [4, 5, 6, 7, 0, 1, 2, 3]
+    assert acc.tolist() == [1, 2, 1, 1]
+    # A later epoch with chunk_k = 1 swaps logical 0..1 with 2..3.
+    KDAPipeSpecSlotFlip.commit_or_rollback_chunk_b(
+        perm, 1, torch.tensor([1]), acc, torch.tensor([1])
+    )
+    assert perm[1].tolist() == [6, 7, 4, 5, 0, 1, 2, 3]
+    # update_accepted=False leaves the count to the caller.
+    KDAPipeSpecSlotFlip.commit_or_rollback_chunk_b(
+        perm, 3, torch.tensor([4]), acc, torch.tensor([1]), update_accepted=False
+    )
+    assert perm[1].tolist() == [0, 1, 2, 3, 6, 7, 4, 5]
+    assert acc.tolist() == [1, 1, 1, 1]
+    with pytest.raises(ValueError, match="needs 10 state slots"):
+        KDAPipeSpecSlotFlip.commit_or_rollback_chunk_b(
+            perm, 4, torch.tensor([1]), acc, torch.tensor([1])
+        )
+
+
+def _make_model_state(flip: bool, num_spec: int = 7):
+    from vllm.v1.worker.gpu.model_states.mamba_hybrid import MambaHybridModelState
+
+    static_ctx = {}
+    attn_groups = []
+    block_tables = []
+    group_ranges = [(1, 9), (9, 17), (17, 25)]
+    for gid, (b0, b1) in enumerate(group_ranges):
+        names = [f"kda_g{gid}_l0", f"kda_g{gid}_l1"]
+        for name in names:
+            conv = torch.randn(32, 4, 3 + num_spec)
+            rec = torch.randn(32, 2, 4, 4)
+            static_ctx[name] = SimpleNamespace(kv_cache=(conv, rec))
+        builder = SimpleNamespace(_supports_pipespec_chunk_b=True, layer_names=names)
+        attn_groups.append(
+            [
+                SimpleNamespace(
+                    layer_names=names,
+                    get_metadata_builder=lambda _i, b=builder: b,
+                )
+            ]
+        )
+        block_tables.append(torch.arange(b0, b1, dtype=torch.int32).unsqueeze(0))
+    mla_builder = SimpleNamespace(_supports_pipespec_chunk_b=False)
+    attn_groups.append([SimpleNamespace(get_metadata_builder=lambda _i: mla_builder)])
+    block_tables.append(torch.arange(1, 5, dtype=torch.int32).unsqueeze(0))
+
+    ms = object.__new__(MambaHybridModelState)
+    ms.device = torch.device("cpu")
+    ms.prefix_caching = False
+    ms.num_accepted_tokens_gpu = torch.ones(4, dtype=torch.int32)
+    ms._pipespec_chunk_b_k = 0
+    ms._pipespec_chunk_b_block_row = {}
+    ms._pipespec_req_id_to_idx = {}
+    ms.vllm_config = SimpleNamespace(
+        compilation_config=SimpleNamespace(static_forward_context=static_ctx),
+        num_speculative_tokens=num_spec,
+    )
+    if flip:
+        ms._pipespec_bank_flip = True
+        ms._pipespec_slot_perm = None
+        ms._pipespec_flip_reqs = set()
+    return ms, static_ctx, attn_groups, tuple(block_tables), group_ranges
+
+
+def test_model_state_flip_prepare_and_commit_touch_no_recurrent_state(monkeypatch):
+    import vllm.model_executor.layers.mamba.mamba_utils as mamba_utils
+
+    monkeypatch.setattr(mamba_utils, "is_conv_state_dim_first", lambda: True)
+    torch.manual_seed(5)
+    chunk_k = 3
+    ms, static_ctx, attn_groups, block_tables, group_ranges = _make_model_state(True)
+    before = {k: (v.kv_cache[0].clone(), v.kv_cache[1].clone()) for k, v in static_ctx.items()}
+    assert ms._pipespec_chunk_b_accepted_offset() == 2
+
+    ib = SimpleNamespace(
+        idx_mapping_np=np.array([2], dtype=np.int64),
+        idx_mapping=torch.tensor([2], dtype=torch.int64),
+        num_reqs=1,
+    )
+    # No Chunk B yet: the stock block table is used (no permutation rows).
+    assert ms._pipespec_slot_perm_rows(ib, 1, 0) is None
+    ms._prepare_pipespec_chunk_b(ib, block_tables, attn_groups, chunk_k)
+    for gid, (b0, _) in enumerate(group_ranges):
+        for layer in range(2):
+            key = f"kda_g{gid}_l{layer}"
+            conv, rec = static_ctx[key].kv_cache
+            conv0, rec0 = before[key]
+            assert torch.equal(rec, rec0)
+            # History columns 3..5 of slot 0's line, one column later in the
+            # line of slot 4; nothing else moves.
+            assert torch.equal(conv[b0 + 4][:, 4:7], conv0[b0][:, 3:6])
+            mask = torch.ones_like(conv, dtype=torch.bool)
+            mask[b0 + 4, :, 4:7] = False
+            assert torch.equal(conv[mask], conv0[mask])
+    rows = ms._pipespec_slot_perm_rows(ib, 2, chunk_k)
+    assert rows.tolist() == [list(range(8)), list(range(8))]
+
+    snapshot = {k: (v.kv_cache[0].clone(), v.kv_cache[1].clone()) for k, v in static_ctx.items()}
+    # Dropped B.
+    ms.postprocess_pipespec_chunk_b(
+        torch.tensor([2], dtype=torch.int32), torch.tensor([0], dtype=torch.int32),
+        chunk_k, req_idx=2,
+    )
+    assert ms._pipespec_slot_perm[2].tolist() == list(range(8))
+    assert int(ms.num_accepted_tokens_gpu[2]) == 1
+    # Valid B.
+    ms._prepare_pipespec_chunk_b(ib, block_tables, attn_groups, chunk_k)
+    snapshot = {k: (v.kv_cache[0].clone(), v.kv_cache[1].clone()) for k, v in static_ctx.items()}
+    ms.postprocess_pipespec_chunk_b(
+        torch.tensor([2], dtype=torch.int32), torch.tensor([3], dtype=torch.int32),
+        chunk_k, req_idx=2,
+    )
+    assert ms._pipespec_slot_perm[2].tolist() == [4, 5, 6, 7, 0, 1, 2, 3]
+    assert int(ms.num_accepted_tokens_gpu[2]) == 3
+    assert ms._pipespec_chunk_b_block_row == {}
+    for key, value in static_ctx.items():
+        assert torch.equal(value.kv_cache[0], snapshot[key][0])
+        assert torch.equal(value.kv_cache[1], snapshot[key][1])
+
+    # Later steps of that request read the permuted table; padding rows and
+    # other requests keep the stock order.
+    rows = ms._pipespec_slot_perm_rows(ib, 3, 0)
+    assert rows.tolist() == [
+        [4, 5, 6, 7, 0, 1, 2, 3], list(range(8)), list(range(8)),
+    ]
+    other = SimpleNamespace(
+        idx_mapping_np=np.array([1], dtype=np.int64),
+        idx_mapping=torch.tensor([1], dtype=torch.int64),
+        num_reqs=1,
+    )
+    assert ms._pipespec_slot_perm_rows(other, 1, 0) is None
+    # The next Chunk B of the request prepares from its logical slots.
+    ms._prepare_pipespec_chunk_b(ib, block_tables, attn_groups, chunk_k)
+    b0 = group_ranges[1][0]
+    conv = static_ctx["kda_g1_l0"].kv_cache[0]
+    # Logical slot 0 is physical column 4, logical slot 4 is physical column 0.
+    assert torch.equal(conv[b0][:, 4:7], conv[b0 + 4][:, 3:6])
+
+    # A new request on the same index starts from the stock order.
+    ms._reset_pipespec_slot_perm(2)
+    assert ms._pipespec_slot_perm[2].tolist() == list(range(8))
+    assert ms._pipespec_slot_perm_rows(ib, 1, 0) is None
+    ms._pipespec_flip_reqs.add(1)
+    ms._pipespec_slot_perm[1].copy_(torch.tensor([4, 5, 6, 7, 0, 1, 2, 3]))
+    ms._reset_pipespec_slot_perm()
+    assert ms._pipespec_slot_perm[1].tolist() == list(range(8))
+    assert not ms._pipespec_flip_reqs
+
+
+def test_model_state_switch_off_keeps_the_copies():
+    chunk_k = 3
+    ms, static_ctx, attn_groups, block_tables, group_ranges = _make_model_state(False)
+    assert ms._pipespec_chunk_b_accepted_offset() == 1
+    ib = SimpleNamespace(
+        idx_mapping_np=np.array([0], dtype=np.int64),
+        idx_mapping=torch.tensor([0], dtype=torch.int64),
+        num_reqs=1,
+    )
+    assert ms._pipespec_slot_perm_rows(ib, 1, chunk_k) is None
+    ms._prepare_pipespec_chunk_b(ib, block_tables, attn_groups, chunk_k)
+    for gid, (b0, _) in enumerate(group_ranges):
+        conv, rec = static_ctx[f"kda_g{gid}_l0"].kv_cache
+        assert torch.equal(conv[b0 + 4], conv[b0])
+        assert torch.equal(rec[b0 + 7], rec[b0 + 3])
+    ms.postprocess_pipespec_chunk_b(
+        torch.tensor([0], dtype=torch.int32), torch.tensor([2], dtype=torch.int32),
+        chunk_k, req_idx=0,
+    )
+    assert int(ms.num_accepted_tokens_gpu[0]) == 2
+    assert getattr(ms, "_pipespec_slot_perm", None) is None
+    # Requests of a state built without the switch reset cleanly.
+    ms._reset_pipespec_slot_perm(0)
+    ms._reset_pipespec_slot_perm()
+
+
+def test_attn_metadata_passes_the_permutation_to_supporting_builders_only():
+    from vllm.v1.attention.backends.gdn_attn import GDNAttentionMetadataBuilder
+    from vllm.v1.worker.gpu.model_states.mamba_hybrid import MambaHybridAttnMetadata
+
+    perm = KDAPipeSpecSlotFlip.identity(3, 8, torch.device("cpu"))
+    meta = MambaHybridAttnMetadata(
+        is_prefilling=torch.zeros(3, dtype=torch.bool),
+        num_accepted_tokens=torch.ones(3, dtype=torch.int32),
+        pipespec_slot_perm=perm,
+    )
+    plain = object.__new__(GDNAttentionMetadataBuilder)
+    assert "pipespec_slot_perm" not in meta.get_extra_attn_kwargs(plain, 2)
+    kda = object.__new__(GDNAttentionMetadataBuilder)
+    kda._supports_pipespec_slot_perm = True
+    extra = meta.get_extra_attn_kwargs(kda, 2)
+    assert extra["pipespec_slot_perm"].shape == (2, 8)
+    meta.pipespec_slot_perm = None
+    assert "pipespec_slot_perm" not in meta.get_extra_attn_kwargs(kda, 2)
+
+
+def test_kimi_kda_builder_takes_the_permutation():
+    from vllm.models.kimi_k3.nvidia.kda_metadata import KimiK3KDAMetadataBuilder
+
+    assert KimiK3KDAMetadataBuilder._supports_pipespec_slot_perm is True
+    params = inspect.signature(KimiK3KDAMetadataBuilder.build).parameters
+    assert params["pipespec_slot_perm"].default is None
+
+
+def test_switch_reads_the_environment(monkeypatch):
+    from vllm.v1 import cmp_pipespec
+
+    monkeypatch.setattr(
+        cmp_pipespec.envs, "VLLM_K31_PIPESPEC_BANK_FLIP", False, raising=False
+    )
+    assert cmp_pipespec.bank_flip_enabled() is False
+    monkeypatch.setattr(
