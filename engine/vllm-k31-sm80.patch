+def test_native_loader_refuses_an_older_interface_release(monkeypatch):
+    """A library of release 1 (build_info without api_version) or of an
+    older api_version than the tree asks for stops with the build command;
+    the asked version and newer ones load."""
+    from vllm.sm80.kernels.k31q import native
+
+    info = native.runtime_build_info(1)
+    library = types.ModuleType("vllm._k31_test_C")
+    monkeypatch.setitem(sys.modules, "vllm._k31_test_C", library)
+    for reported in (None, 1, "2"):
+        built = info if reported is None else info | {"api_version": reported}
+        library.build_info = lambda built=built: built
+        with pytest.raises(RuntimeError, match="api_version mismatch") as error:
+            native.load("_k31_test_C", 1, (), "BUILD-COMMAND", 2)
+        assert "BUILD-COMMAND" in str(error.value)
+        assert f"extension {reported!r}" in str(error.value)
+    for reported in (2, 3):
+        library.build_info = lambda reported=reported: info | {"api_version": reported}
+        assert native.load("_k31_test_C", 1, (), "BUILD-COMMAND", 2) is library
+    # Without an asked version the field is not required (the EXL3 pattern).
+    library.build_info = lambda: info
+    assert native.load("_k31_test_C", 1, (), "BUILD-COMMAND") is library
+
