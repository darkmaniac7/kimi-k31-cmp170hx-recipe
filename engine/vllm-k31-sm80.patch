+#pragma once
+#include <torch/types.h>
+#include <tuple>
+
+namespace k31_vq {
+
+// Pack canonical k31q v1 on-disk per-rank VQ record slices (Section 3) into
+// warp-coalesced MMA-native GPU buffers (zero SMEM, zero bank conflicts).
+//   idx_records:   [E, n_blocks, record_bytes] U8 CUDA
+//   scale_records: [E, n_blocks, n_scales]     F16 CUDA
+//   codebook:      [2^index_bits, dim]         F16 CUDA (validated, returned unchanged by caller)
+//   role:          0 = w1/w3 ([n_blocks*128, hidden_size]), 1 = w2 ([hidden_size, n_blocks*128])
+std::tuple<torch::Tensor, torch::Tensor> vq_pack(
+    const torch::Tensor& idx_records,
+    const torch::Tensor& scale_records,
+    const torch::Tensor& codebook,
+    int64_t role,
+    int64_t hidden_size,
+    int64_t dim,
+    int64_t index_bits,
+    int64_t group_size = 128);
+
+// Exact FP32 reference dequantizer from native packed buffers -> FP32 [E, out_features, in_features].
+torch::Tensor vq_dequant_reference(
+    const torch::Tensor& packed_idx,
+    const torch::Tensor& packed_scale,
+    const torch::Tensor& codebook,
+    int64_t out_features,
+    int64_t in_features,
+    int64_t dim,
+    int64_t index_bits,
+    int64_t group_size = 128);
+
+// Pure CPU arithmetic workspace sizing (in FP32 elements), matching moe_workspace_size_k31.
+int64_t moe_workspace_size_vq(
+    int64_t max_rows,
+    int64_t hidden_size,
+    int64_t intermediate_size,
+    int64_t topk,
+    int64_t local_experts);
+
+// Decode MoE kernel (1..64 rows, CUDA-graph safe, zero D2H sync, mirrors moe_out_k31).
+//   packed_ptrs: int64 CUDA [local_experts, 9]
+//                for expert e, proj q in {0=w1, 1=w3, 2=w2}:
+//                  [e, q*3 + 0] = data_ptr(packed_idx[e])   (uint32 [out/16, in/128, WPL, 32], 16B aligned)
+//                  [e, q*3 + 1] = data_ptr(packed_scale[e]) (f16    [out/16, in/128, 16],      16B aligned)
+//                  [e, q*3 + 2] = data_ptr(codebook_f16)    (f16    [2^index_bits, dim],       16B aligned)
+//   packed_meta: int64 CUDA [local_experts, 12]
+//                for expert e, proj q in {0=w1, 1=w3, 2=w2}:
+//                  [e, q*4 + 0] = in_features  (H for w1/w3, I for w2)
+//                  [e, q*4 + 1] = out_features (I for w1/w3, H for w2)
+//                  [e, q*4 + 2] = dim          (2 or 4)
+//                  [e, q*4 + 3] = index_bits   (3, 4, 5, or 6)
+//   expert_map:  int32/int64 CUDA [global_experts] -> local expert id (< 0 skipped).
+//   topk_ids:    int32/int64 CUDA [rows, topk] (< 0 skipped for DSpark row mask).
+//   Supports arbitrary I multiple of 128 (I = 1536 TP2 and I = 3072 TP1 natively).
+void moe_out_vq(
+    const torch::Tensor& x,
+    const torch::Tensor& topk_ids,
+    const torch::Tensor& topk_weights,
+    const torch::Tensor& packed_ptrs,
+    const torch::Tensor& packed_meta,
+    const torch::Tensor& expert_map,
+    int64_t intermediate_size,
+    torch::Tensor& out,
+    torch::Tensor& workspace,
+    double situ_beta = 4.0,
+    double situ_linear_beta = 25.0,
+    double swiglu_limit = 0.0,
+    int64_t rate_id_gu = -1,
+    int64_t rate_id_dn = -1);
+
+// Prefill MoE kernel (up to 2,048 rows, CUDA-graph safe, zero D2H sync, mirrors moe_out_prefill_k31).
+void moe_out_prefill_vq(
+    const torch::Tensor& x,
+    const torch::Tensor& topk_ids,
+    const torch::Tensor& topk_weights,
+    const torch::Tensor& packed_ptrs,
+    const torch::Tensor& packed_meta,
+    const torch::Tensor& expert_map,
+    int64_t intermediate_size,
+    torch::Tensor& out,
+    torch::Tensor& workspace,
+    double situ_beta = 4.0,
+    double situ_linear_beta = 25.0,
+    double swiglu_limit = 0.0,
+    int64_t rate_id_gu = -1,
+    int64_t rate_id_dn = -1);
+
+}  // namespace k31_vq
