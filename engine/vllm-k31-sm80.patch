+              f"{max(c['max_abs'] for c in rows):.3e}, max rel "
+              f"{max(c['max_rel'] for c in rows):.3e}; torch FP32 max abs "
+              f"{max(c['torch_max_abs'] for c in rows):.3e}, max rel "
