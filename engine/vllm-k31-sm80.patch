+# ---------------------------------------------------------------------------
+# 1. Switch defaults & independence from VLLM_K31_GLUE_ALL
+# ---------------------------------------------------------------------------
+
+
+def test_kda_spec_switch_default_off_and_independent_of_glue_all(monkeypatch):
+    _clear_glue_env(monkeypatch)
+    assert envs.VLLM_K31_GLUE_KDA_SPEC is False
+    assert glue.kda_spec_enabled() is False
+
+    # VLLM_K31_GLUE_ALL=1 must NOT enable VLLM_K31_GLUE_KDA_SPEC (preserves Arm B v1 compat).
+    monkeypatch.setenv("VLLM_K31_GLUE_ALL", "1")
+    assert glue.kda_enabled() is True
+    assert glue.attnres_enabled() is True
+    assert glue.router_enabled() is True
+    assert glue.gemv_enabled() is True
+    assert envs.VLLM_K31_GLUE_KDA_SPEC is False
+    assert glue.kda_spec_enabled() is False
+
+    # Explicit VLLM_K31_GLUE_KDA_SPEC=1 turns on ONLY kda_spec_enabled.
+    monkeypatch.delenv("VLLM_K31_GLUE_ALL", raising=False)
+    monkeypatch.setenv("VLLM_K31_GLUE_KDA_SPEC", "1")
+    assert envs.VLLM_K31_GLUE_KDA_SPEC is True
+    assert glue.kda_spec_enabled() is True
+    assert glue.kda_enabled() is False
+    assert glue.attnres_enabled() is False
+    assert glue.router_enabled() is False
+    assert glue.gemv_enabled() is False
