+class _Recorder:
+    """Stands in for the Triton kernel: records the launch."""
+
+    def __init__(self):
+        self.calls = []
+
+    def __getitem__(self, grid):
+        def launch(**kw):
+            self.calls.append((grid, kw))
+        return launch
+
