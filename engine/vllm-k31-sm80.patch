+++ b/tests/v1/spec_decode/test_k31_width_worker.py
@@ -0,0 +1,176 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""K3.1 lever 3, worker side of the width tiers: the last rank hands the
+drafter's confidences to the step output, the output carries them to the
+host, and the DSpark drafter runs its confidence head only when the tier
+policy reads it. CPU only."""
+
+from contextlib import nullcontext
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+
+from vllm.sm80.spec_decode import adaptive_k as ak
+from vllm.sm80.spec_decode.adaptive_k import AdaptiveKConfig
+from vllm.v1.outputs import ModelRunnerOutput
+
+pytestmark = pytest.mark.cpu_test
+
+TIERS = [3, 5, 7, 9, 12]
+THRESHOLDS = [1.5, 2.5, 3.5, 4.5]
+KMAX = 12
+
+
+def _raw(tiers=TIERS, **conf):
+    c = {"thresholds": THRESHOLDS, "hysteresis": 0.0, "accept_weight": 0.0}
+    c.update(conf)
+    return {"tiers": list(tiers), "confidence": c}
+
+
+# ------------------------------------------------------ worker plumbing
+
+
+class _Capture:
+    def __init__(self):
+        self.calls = []
+
+    def add_draft_confidences(self, rows, main_stream, copy_stream):
+        self.calls.append((rows, main_stream, copy_stream))
+
+
+def test_the_last_rank_attaches_a_clone_of_the_drafted_rows():
+    probs = torch.arange(8 * KMAX, dtype=torch.float32).view(8, KMAX)
+    spec = SimpleNamespace(
+        use_confidence_head=True, draft_token_confidence_probs=probs,
+        num_speculative_steps=KMAX,
+    )
+    out = _Capture()
+    assert ak.attach_draft_confidences(out, spec, 3, "main", "copy")
+    (rows, main, copy), = out.calls
+    assert (main, copy) == ("main", "copy")
+    assert torch.equal(rows, probs[:3])
+    probs.fill_(-1.0)  # the next draft step rewrites the buffer
+    assert rows[0, 1].item() == 1.0
+    # Head off, or prefill context parallelism: nothing attached.
+    out = _Capture()
+    assert not ak.attach_draft_confidences(
+        out, SimpleNamespace(use_confidence_head=False), 3, "m", "c"
+    )
+    assert not ak.attach_draft_confidences(out, spec, 3, "m", "c", pcp=True)
+    assert out.calls == []
+
+
+def test_the_async_output_carries_the_confidences_to_the_host(monkeypatch):
+    from vllm.v1.worker.gpu import async_utils
+
+    events = []
+    monkeypatch.setattr(async_utils, "stream", lambda to, frm: nullcontext())
+    output = async_utils.AsyncOutput.__new__(async_utils.AsyncOutput)
+    output.copy_event = SimpleNamespace(
+        record=lambda s: events.append(("record", s)),
+        synchronize=lambda: events.append(("sync", None)),
+    )
+    output.model_runner_output = ModelRunnerOutput(req_ids=["a", "b"])
+    output.sampled_token_ids = np.array([[1, 2], [3, 4]])
+    output.num_sampled_tokens_np = np.array([2, 1])
+    output.num_drafted_tokens_per_req_np = None
+    output.num_verified_tokens_per_req_np = None
+    output.sampling_mask_tensors = None
+    output.num_nans = None
+    output.logprobs_tensors = None
+    output.prompt_logprobs_dict = {}
+    output.prompt_token_id_logprobs_dict = {}
+    output.pending_aux_output = None
+    output.failed_tokens = None
+    output._has_fault = None
+    output.draft_confidences_np = None
+    copy = SimpleNamespace(wait_stream=lambda s: events.append(("wait", s)))
+    rows = torch.tensor([[0.5, 0.25], [0.75, 0.125]])
+    output.add_draft_confidences(rows, "main", copy)
+    # The copy stream waits for the drafter, then the event covers the copy.
+    assert events == [("wait", "main"), ("record", copy)]
+    result = output.get_output()
+    assert events[-1] == ("sync", None)
+    assert result.draft_confidences == [[0.5, 0.25], [0.75, 0.125]]
+    assert result.sampled_token_ids == [[1, 2], [3]]
+
+
+def test_switch_off_leaves_the_output_without_confidences():
+    assert ModelRunnerOutput(req_ids=["a"]).draft_confidences is None
+    assert not ak.wants_draft_confidence(
+        SimpleNamespace(speculative_config=SimpleNamespace(adaptive_k_config=None))
+    )
+    cfg = AdaptiveKConfig.from_dict({"tiers": TIERS}, KMAX)
+    assert not ak.wants_draft_confidence(
+        SimpleNamespace(speculative_config=SimpleNamespace(adaptive_k_config=cfg))
+    )
+    cfg = AdaptiveKConfig.from_dict(_raw(), KMAX)
+    assert ak.wants_draft_confidence(
+        SimpleNamespace(speculative_config=SimpleNamespace(adaptive_k_config=cfg))
+    )
+
+
+def _dspark(monkeypatch, adaptive_k_config, head):
+    from vllm.v1.worker.gpu.spec_decode.dspark import speculator as dspark
+
+    def init(self, config, device):
+        self.vllm_config = config
+        self.enable_adaptive_verification = False
+        self.use_draft_logits = False
+        self.use_acceptance_estimator = False
+        self.use_confidence_head = False
+
+    monkeypatch.setattr(dspark.DSparkSpeculator, "__init__", init)
+    monkeypatch.setattr(
+        dspark,
+        "load_dspark_model",
+        lambda target, config: SimpleNamespace(
+            model=SimpleNamespace(confidence_head=head), draft_id_to_target_id=None
+        ),
+    )
+    config = SimpleNamespace(
+        speculative_config=SimpleNamespace(adaptive_k_config=adaptive_k_config)
+    )
+    drafter = dspark.DSparkSpeculator(config, "cpu")
+    return drafter
+
+
+def test_the_drafter_runs_its_confidence_head_only_when_the_tiers_read_it(monkeypatch):
+    conf = AdaptiveKConfig.from_dict(_raw(), KMAX)
+    drafter = _dspark(monkeypatch, conf, head=object())
+    drafter.load_draft_model(None, set())
+    assert drafter.use_confidence_head
+    # Off switch: no adaptive_k, no head run (as on k31-main).
+    drafter = _dspark(monkeypatch, None, head=object())
+    drafter.load_draft_model(None, set())
+    assert not drafter.use_confidence_head
+    # Acceptance alone: no head needed or run.
+    accept_only = AdaptiveKConfig.from_dict(_raw(accept_weight=1.0), KMAX)
+    drafter = _dspark(monkeypatch, accept_only, head=None)
+    drafter.load_draft_model(None, set())
+    assert not drafter.use_confidence_head
+    # The policy reads a head the drafter lacks: refused at load.
+    drafter = _dspark(monkeypatch, conf, head=None)
+    with pytest.raises(ValueError, match="confidence head"):
+        drafter.load_draft_model(None, set())
+
+
+def test_context_kv_only_skips_attaching_stale_confidences():
+    """Regression for P0 #5: context_kv_only=True must never ship stale probs."""
+    probs = torch.full((4, KMAX), 0.99, dtype=torch.float32)
+    spec = SimpleNamespace(
+        use_confidence_head=True,
+        context_kv_only=True,
+        draft_token_confidence_probs=probs,
+        num_speculative_steps=KMAX,
+    )
+    out = _Capture()
+    assert not ak.attach_draft_confidences(out, spec, 2, "main", "copy")
+    assert out.calls == []
+    # Also verify model_runner's call site carries the context_kv_only gate.
+    from pathlib import Path
+
+    mr = Path("vllm/v1/worker/gpu/model_runner.py").read_text(encoding="utf-8")
+    assert 'not getattr(self.speculator, "context_kv_only", False)' in mr
