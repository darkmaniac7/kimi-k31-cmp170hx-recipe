@@ -0,0 +1,568 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Lightweight zero-upstream-edit vLLM Kimi-K3.1 per-layer dump helper for G4 Track 2.
+
+Two modes:
+  1. Direct vLLM capture (`--model ... --prompts ... --out ...`):
+     Installs `K31NumericsTapExtension` via vLLM's native `worker_extension_cls`
+     hook (same pattern as `g3taps.py`,
+     zero edits to vLLM core). On every PP stage (`tp_rank == 0`), captures exact:
+       - `embed` (PP stage 0)
+       - `L{i}.out` = exact post-layer residual stream `prefix_sum + mlp_out`
+         (matching llama.cpp `l_out-{i}` directly!)
+       - `L{i}.attn_out`, `L{i}.mlp_out`, `L{i}.attn_in`, `L{i}.mlp_in`
+       - `final_pre_norm`, `final_norm`, `topk_ids`, `topk_logits`, `logsumexp`
+         (last PP stage, hooking `compute_logits`)
+     Runs each prompt from `track2_fixed_prompts.json` using exact pre-tokenized
+     `prompt_token_ids` with greedy decoding (`temperature=0.0`), then merges all
+     PP stage shards into canonical `k31_layer_dump_v1` `<out_dir>/<prompt_id>.safetensors`
+     + `<prompt_id>.meta.json` + `manifest.json`.
+  2. Convert / merge existing `g3taps` `.pp<stage>tp0.pt` dumps (`--convert-g3taps`):
+     Reconstructs exact `L{i}.out` (`l_out`) via Kimi-K3.1 AttnRes recurrence and
+     writes a canonical `k31_layer_dump_v1` directory.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+from pathlib import Path
+from typing import Any
+
+import torch
+from safetensors import safe_open
+from safetensors.torch import save_file
+
+from tools.sm80.compare_k31_layer_dumps import (
+    SCHEMA_VERSION,
+    _load_g3taps_files,
+)
+
+SCRIPT_DIR = Path(__file__).resolve().parent
+DEFAULT_PROMPTS_PATH = SCRIPT_DIR / "track2_fixed_prompts.json"
+
+_DTYPE_MAP = {
+    "bf16": torch.bfloat16,
+    "fp16": torch.float16,
+    "fp32": torch.float32,
+}
+
+
+def _ranks() -> tuple[int, int, int, int]:
+    from vllm.distributed import (
+        get_pp_group,
+        get_tensor_model_parallel_rank,
+        get_tensor_model_parallel_world_size,
+    )
+
+    pp = get_pp_group()
+    return (
+        pp.rank_in_group,
+        pp.world_size,
+        get_tensor_model_parallel_rank(),
+        get_tensor_model_parallel_world_size(),
+    )
+
+
+def _text_model(model: Any) -> Any:
+    lm = getattr(model, "language_model", model)
+    return lm.model
+
+
+def _lm_root(model: Any) -> Any:
+    return getattr(model, "language_model", model)
+
+
+def _extract_topk_and_lse_torch(logits_2d: torch.Tensor, topk: int) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Compute exact FP64 logsumexp + top-K IDs/logits on [N, V] logits tensor."""
+    x = logits_2d.detach().float()
+    if x.ndim == 1:
+        x = x.unsqueeze(0)
+    k = min(max(int(topk), 1), x.shape[-1])
+    x64 = x.to(torch.float64)
+    lse = torch.logsumexp(x64, dim=-1).to(torch.float32).cpu()
+    vals, ids = torch.topk(x, k=k, dim=-1, largest=True, sorted=True)
+    return ids.to(torch.int32).cpu(), vals.to(torch.float32).cpu(), lse
+
+
+class _StageTapCollector:
+    """Forward hooks attached to KimiLinearModel + compute_logits on one PP stage (tp_rank == 0)."""
+
+    def __init__(
+        self,
+        model: Any,
+        taps: set[str],
+        save_dtype: torch.dtype,
+        topk: int,
+        is_first_pp: bool,
+        is_last_pp: bool,
+    ) -> None:
+        self.taps = taps
+        self.save_dtype = save_dtype
+        self.topk = topk
+        self.is_first_pp = is_first_pp
+        self.is_last_pp = is_last_pp
+
+        self.armed = False
+        self.prefill_captured = False
+        self.tensors: dict[str, torch.Tensor] = {}
+        self.topk_ids_steps: list[torch.Tensor] = []
+        self.topk_logits_steps: list[torch.Tensor] = []
+        self.lse_steps: list[torch.Tensor] = []
+        self.layers: list[int] = []
+        self.handles: list[Any] = []
+        self._orig_compute_logits: Any = None
+        self._lm = _lm_root(model)
+        self._text = _text_model(model)
+
+        if is_first_pp and "embed" in taps and hasattr(self._text, "embed_tokens"):
+            self.handles.append(
+                self._text.embed_tokens.register_forward_hook(self._make_prefill_hook("embed"))
+            )
+
+        for idx, layer in enumerate(self._text.layers):
+            if not hasattr(layer, "self_attn"):
+                continue
+            self.layers.append(idx)
+            p = f"L{idx}"
+            if "attn_in" in taps:
+                self.handles.append(
+                    layer.self_attn.register_forward_pre_hook(
+                        self._make_prefill_kw_hook(f"{p}.attn_in", "hidden_states"),
+                        with_kwargs=True,
+                    )
+                )
+            if "attn_out" in taps:
+                self.handles.append(
+                    layer.self_attn.register_forward_hook(self._make_prefill_hook(f"{p}.attn_out"))
+                )
+            if "mlp_in" in taps:
+                self.handles.append(
+                    layer.mlp.register_forward_pre_hook(self._make_prefill_arg_hook(f"{p}.mlp_in"))
+                )
+            if "mlp_out" in taps:
+                self.handles.append(
+                    layer.mlp.register_forward_hook(self._make_prefill_hook(f"{p}.mlp_out"))
+                )
+            if "out" in taps:
+                self.handles.append(
+                    layer.register_forward_hook(self._make_layer_l_out_hook(f"{p}.out"))
+                )
+
+        if is_last_pp:
+            if "final_pre_norm" in taps:
+                self.handles.append(
+                    self._text.register_forward_hook(self._make_prefill_hook("final_pre_norm"))
+                )
+            if hasattr(self._lm, "compute_logits"):
+                orig = self._lm.compute_logits
+                self._orig_compute_logits = orig
+
+                def wrapped_compute_logits(hidden_states: torch.Tensor, *args: Any, **kwargs: Any) -> Any:
+                    if self.armed and "final_norm" in self.taps and not self.prefill_captured:
+                        if getattr(self._lm, "needs_norm_in_logits", True) and hasattr(self._text, "norm"):
+                            fn = self._text.norm(hidden_states, None)
+                            if isinstance(fn, tuple):
+                                fn = fn[0]
+                            self._append_prefill("final_norm", fn)
+                    logits = orig(hidden_states, *args, **kwargs)
+                    if self.armed and torch.is_tensor(logits):
+                        last_row = logits[-1:].detach()
+                        tids, tvals, lse = _extract_topk_and_lse_torch(last_row, self.topk)
+                        self.topk_ids_steps.append(tids)
+                        self.topk_logits_steps.append(tvals)
+                        self.lse_steps.append(lse)
+                        self.prefill_captured = True
+                    return logits
+
+                self._lm.compute_logits = wrapped_compute_logits
+
+    def reset_prompt(self, armed: bool = True) -> None:
+        self.tensors.clear()
+        self.topk_ids_steps.clear()
+        self.topk_logits_steps.clear()
+        self.lse_steps.clear()
+        self.prefill_captured = False
+        self.armed = armed
+
+    def disarm(self) -> None:
+        self.armed = False
+
+    def _append_prefill(self, key: str, tensor: torch.Tensor) -> None:
+        t = tensor.detach().to(device="cpu", dtype=self.save_dtype).contiguous()
+        if key in self.tensors:
+            self.tensors[key] = torch.cat([self.tensors[key], t], dim=0)
+        else:
+            self.tensors[key] = t
+
+    def _can_record_prefill(self) -> bool:
+        if not self.armed or self.prefill_captured:
+            return False
+        if torch.cuda.is_available() and torch.cuda.is_current_stream_capturing():
+            return False
+        return True
+
+    def _make_prefill_hook(self, key: str):
+        def hook(_mod: Any, _args: Any, output: Any) -> None:
+            if not self._can_record_prefill():
+                return
+            val = output[0] if isinstance(output, tuple) else output
+            if torch.is_tensor(val):
+                self._append_prefill(key, val)
+
+        return hook
+
+    def _make_prefill_arg_hook(self, key: str):
+        def hook(_mod: Any, args: Any) -> None:
+            if not self._can_record_prefill() or not args:
+                return
+            if torch.is_tensor(args[0]):
+                self._append_prefill(key, args[0])
+
+        return hook
+
+    def _make_prefill_kw_hook(self, key: str, kw_name: str):
+        def hook(_mod: Any, args: Any, kwargs: Any) -> None:
+            if not self._can_record_prefill():
+                return
+            val = kwargs.get(kw_name, args[0] if args else None)
+            if torch.is_tensor(val):
+                self._append_prefill(key, val)
+
+        return hook
+
+    def _make_layer_l_out_hook(self, key: str):
+        def hook(_mod: Any, _args: Any, output: Any) -> None:
+            if not self._can_record_prefill():
+                return
+            if isinstance(output, tuple) and len(output) >= 2 and torch.is_tensor(output[0]):
+                mlp_out = output[0]
+                prefix_sum = output[1]
+                if torch.is_tensor(prefix_sum):
+                    l_out = (prefix_sum.float() + mlp_out.float()).to(mlp_out.dtype)
+                else:
+                    l_out = mlp_out
+                self._append_prefill(key, l_out)
+            elif torch.is_tensor(output):
+                self._append_prefill(key, output)
+
+        return hook
+
+    def save_stage_shard(self, shard_path: Path, prompt_id: str) -> dict[str, Any]:
+        payload: dict[str, torch.Tensor] = dict(self.tensors)
+        if self.topk_ids_steps:
+            payload["topk_ids"] = torch.cat(self.topk_ids_steps, dim=0)
+            payload["topk_logits"] = torch.cat(self.topk_logits_steps, dim=0)
+            payload["logsumexp"] = torch.cat(self.lse_steps, dim=0)
+        shard_path.parent.mkdir(parents=True, exist_ok=True)
+        tmp = shard_path.with_suffix(".safetensors.tmp")
+        save_file(payload, str(tmp), metadata={"schema": SCHEMA_VERSION, "prompt_id": prompt_id})
+        os.replace(tmp, shard_path)
+        return {
+            "prompt_id": prompt_id,
+            "layers": self.layers,
+            "keys": sorted(payload.keys()),
+            "shard_file": str(shard_path),
+        }
+
+
+class K31NumericsTapExtension:
+    """vLLM worker extension for zero-upstream-edit Track 2 layer dumping."""
+
+    def init_worker_extension(self) -> None:
+        self._k31_collector: _StageTapCollector | None = None
+        self._k31_staging_dir = os.environ.get("VLLM_K31_NUMERICS_STAGING_DIR", "")
+        taps = {
+            t.strip()
+            for t in os.environ.get("VLLM_K31_NUMERICS_TAPS", "out,attn_out,mlp_out,final_norm").split(",")
+            if t.strip()
+        }
+        dtype_name = os.environ.get("VLLM_K31_NUMERICS_DTYPE", "bf16")
+        save_dtype = _DTYPE_MAP.get(dtype_name, torch.bfloat16)
+        topk = int(os.environ.get("VLLM_K31_NUMERICS_TOPK", "128"))
+
+        runner = self.model_runner
+        orig_load = runner.load_model
+
+        def wrapped_load(*args: Any, **kwargs: Any) -> Any:
+            res = orig_load(*args, **kwargs)
+            pp, pp_size, tp, _ = _ranks()
+            if self._k31_staging_dir and tp == 0:
+                self._k31_collector = _StageTapCollector(
+                    model=runner.model,
+                    taps=taps,
+                    save_dtype=save_dtype,
+                    topk=topk,
+                    is_first_pp=(pp == 0),
+                    is_last_pp=(pp == pp_size - 1),
+                )
+            return res
+
+        runner.load_model = wrapped_load
+
+    def k31_num_arm(self, prompt_id: str) -> dict[str, Any]:
+        pp, _, tp, _ = _ranks()
+        if self._k31_collector is not None:
+            self._k31_collector.reset_prompt(armed=True)
+            return {"pp": pp, "tp": tp, "armed": True, "prompt_id": prompt_id}
+        return {"pp": pp, "tp": tp, "armed": False, "prompt_id": prompt_id}
+
+    def k31_num_flush(self, prompt_id: str) -> dict[str, Any]:
+        pp, _, tp, _ = _ranks()
+        if self._k31_collector is None:
+            return {"pp": pp, "tp": tp, "written": False}
+        self._k31_collector.disarm()
+        shard_p = Path(self._k31_staging_dir) / f"{prompt_id}.pp{pp}tp{tp}.safetensors"
+        info = self._k31_collector.save_stage_shard(shard_p, prompt_id)
+        return {"pp": pp, "tp": tp, "written": True, **info}
+
+
+def merge_stage_shards_to_canonical(
+    staging_dir: Path,
+    out_dir: Path,
+    prompt_spec: dict[str, Any],
+    generated_ids: list[int],
+    generated_text: str,
+    model_path: str,
+    dtype_name: str,
+    n_predict: int,
+    topk: int,
+    engine_name: str = "vllm-k31q",
+) -> Path:
+    """Merge per-PP-stage shard safetensors into one canonical `<out_dir>/<prompt_id>.safetensors`."""
+    pid = prompt_spec["id"]
+    shards = sorted(staging_dir.glob(f"{pid}.pp*tp0.safetensors"))
+    if not shards:
+        raise FileNotFoundError(f"No stage shards found for prompt {pid} in {staging_dir}")
+
+    merged: dict[str, torch.Tensor] = {}
+    for sp in shards:
+        with safe_open(str(sp), framework="pt") as f:
+            for k in f.keys():
+                merged[k] = f.get_tensor(k)
+
+    toks = prompt_spec.get("token_ids", [])
+    merged["prompt_token_ids"] = torch.tensor(toks, dtype=torch.int32)
+    merged["generated_ids"] = torch.tensor(generated_ids, dtype=torch.int32)
+
+    out_dir.mkdir(parents=True, exist_ok=True)
+    st_path = out_dir / f"{pid}.safetensors"
+    meta_path = out_dir / f"{pid}.meta.json"
+
+    st_meta = {
+        "schema": SCHEMA_VERSION,
+        "engine": engine_name,
+        "prompt_id": pid,
+        "dtype": dtype_name,
+    }
+    tmp_st = st_path.with_suffix(".safetensors.tmp")
+    save_file(merged, str(tmp_st), metadata=st_meta)
+    os.replace(tmp_st, st_path)
+
+    layers = sorted(
+        int(m.group(1))
+        for k in merged
+        if (m := re.match(r"^L(\d+)\.out$", k))
+    )
+    meta = {
+        "schema": SCHEMA_VERSION,
+        "engine": engine_name,
+        "prompt_id": pid,
+        "category": prompt_spec.get("category", "unknown"),
+        "prompt_text": prompt_spec.get("prompt_text", ""),
+        "model_path": model_path,
+        "dtype": dtype_name,
+        "n_predict": n_predict,
+        "topk": topk,
+        "layers": layers,
+        "prompt_token_ids": toks,
+        "generated_ids": generated_ids,
+        "generated_text": generated_text,
+        "safetensors_file": st_path.name,
+        "merged_stage_shards": [s.name for s in shards],
+    }
+    meta_path.write_text(json.dumps(meta, indent=2) + "\n")
+    return st_path
+
+
+def convert_g3taps_to_canonical(
+    g3taps_input: str,
+    out_dir: Path,
+    prompt_id: str = "g3taps_prompt",
+    dtype_name: str = "bf16",
+    record_idx: int | None = None,
+) -> Path:
+    """Convert g3taps `.pp<stage>tp0.pt` file(s) or directory into canonical `k31_layer_dump_v1`."""
+    p = Path(g3taps_input)
+    if p.is_dir():
+        pt_files = sorted(p.glob("*.pt"))
+    elif "," in g3taps_input:
+        pt_files = [Path(s.strip()) for s in g3taps_input.split(",") if s.strip()]
+    else:
+        pt_files = [p]
+
+    pd = _load_g3taps_files(pt_files, record_idx=record_idx, prompt_id_override=prompt_id)
+    save_dt = _DTYPE_MAP[dtype_name]
+    tensors = {
+        k: (v.to(save_dt).contiguous() if v.is_floating_point() else v.contiguous())
+        for k, v in pd.tensors.items()
+    }
+    out_dir.mkdir(parents=True, exist_ok=True)
+    st_path = out_dir / f"{prompt_id}.safetensors"
+    meta_path = out_dir / f"{prompt_id}.meta.json"
+    save_file(tensors, str(st_path), metadata={"schema": SCHEMA_VERSION, "engine": "vllm-g3taps", "prompt_id": prompt_id})
+
+    layers = sorted(int(m.group(1)) for k in tensors if (m := re.match(r"^L(\d+)\.out$", k)))
+    meta = {
+        "schema": SCHEMA_VERSION,
+        "engine": "vllm-g3taps",
+        "prompt_id": prompt_id,
+        "dtype": dtype_name,
+        "layers": layers,
+        "safetensors_file": st_path.name,
+        "g3taps_meta": pd.meta,
+    }
+    meta_path.write_text(json.dumps(meta, indent=2) + "\n")
+    manifest = {
+        "schema": SCHEMA_VERSION,
+        "engine": "vllm-g3taps",
+        "prompts": [prompt_id],
+        "converted_from": g3taps_input,
+    }
+    (out_dir / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    return st_path
+
+
+def run_offline_vllm_dump(args: argparse.Namespace) -> None:
+    from vllm import LLM, SamplingParams
+
+    suite = json.loads(args.prompts.read_text())
+    prompts = suite["prompts"] if isinstance(suite, dict) else suite
+    wanted = set(args.prompt_ids.split(",")) if args.prompt_ids else None
+    selected = [p for p in prompts if wanted is None or p["id"] in wanted]
+    if not selected:
+        raise ValueError("No prompts selected")
+
+    staging_dir = args.out / "_stage_shards"
+    staging_dir.mkdir(parents=True, exist_ok=True)
+
+    os.environ["VLLM_K31_NUMERICS_STAGING_DIR"] = str(staging_dir)
+    os.environ["VLLM_K31_NUMERICS_TAPS"] = args.taps
+    os.environ["VLLM_K31_NUMERICS_DTYPE"] = args.dtype
+    os.environ["VLLM_K31_NUMERICS_TOPK"] = str(args.topk)
+
+    llm_kwargs: dict[str, Any] = {
+        "model": args.model,
+        "tensor_parallel_size": args.tp,
+        "pipeline_parallel_size": args.pp,
+        "enable_prefix_caching": False,
+        "enforce_eager": args.enforce_eager,
+        "trust_remote_code": True,
+        "worker_extension_cls": "tools.sm80.vllm_k31_layer_dump.K31NumericsTapExtension",
+    }
+    if args.max_model_len:
+        llm_kwargs["max_model_len"] = args.max_model_len
+    if args.quantization:
+        llm_kwargs["quantization"] = args.quantization
+
+    llm = LLM(**llm_kwargs)
+    done_ids: list[str] = []
+
+    for p in selected:
+        pid = p["id"]
+        toks = p["token_ids"]
+        if args.max_tokens > 0:
+            toks = toks[: args.max_tokens]
+            p = {**p, "token_ids": toks}
+
+        llm.collective_rpc("k31_num_arm", args=(pid,))
+        sp = SamplingParams(
+            temperature=0.0,
+            max_tokens=max(1, args.n_predict),
+            ignore_eos=args.ignore_eos,
+        )
+        outs = llm.generate([{"prompt_token_ids": toks}], sp, use_tqdm=False)
+        llm.collective_rpc("k31_num_flush", args=(pid,))
+
+        gen_ids = list(outs[0].outputs[0].token_ids)
+        gen_text = outs[0].outputs[0].text
+        merge_stage_shards_to_canonical(
+            staging_dir=staging_dir,
+            out_dir=args.out,
+            prompt_spec=p,
+            generated_ids=gen_ids,
+            generated_text=gen_text,
+            model_path=args.model,
+            dtype_name=args.dtype,
+            n_predict=args.n_predict,
+            topk=args.topk,
+        )
+        done_ids.append(pid)
+
+    manifest = {
+        "schema": SCHEMA_VERSION,
+        "engine": "vllm-k31q",
+        "model_path": args.model,
+        "prompts_file": str(args.prompts),
+        "dtype": args.dtype,
+        "n_predict": args.n_predict,
+        "topk": args.topk,
+        "tp": args.tp,
+        "pp": args.pp,
+        "prompts": done_ids,
+    }
+    (args.out / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    print(f"Wrote canonical vLLM dump ({len(done_ids)} prompts) to {args.out}")
+
+
+def build_arg_parser() -> argparse.ArgumentParser:
+    p = argparse.ArgumentParser(
+        description="Dump per-layer hidden states and logits from vLLM Kimi-K3.1 into k31_layer_dump_v1."
+    )
+    p.add_argument("--model", default=None, help="Path to k31q checkpoint directory.")
+    p.add_argument("--prompts", type=Path, default=DEFAULT_PROMPTS_PATH, help="Fixed prompt suite JSON.")
+    p.add_argument("--out", type=Path, required=True, help="Output directory for k31_layer_dump_v1.")
+    p.add_argument("--taps", default="out,attn_out,mlp_out,final_norm", help="Comma-separated taps.")
+    p.add_argument("--dtype", choices=["bf16", "fp16", "fp32"], default="bf16")
+    p.add_argument("--n-predict", type=int, default=32)
+    p.add_argument("--topk", type=int, default=128)
+    p.add_argument("--prompt-ids", default=None)
+    p.add_argument("--max-tokens", type=int, default=0)
+    p.add_argument("--ignore-eos", action="store_true")
+    p.add_argument("--tp", type=int, default=2)
+    p.add_argument("--pp", type=int, default=4)
+    p.add_argument("--max-model-len", type=int, default=4096)
+    p.add_argument("--quantization", default=None)
+    p.add_argument("--enforce-eager", action="store_true", default=True)
+    p.add_argument(
+        "--convert-g3taps",
+        default=None,
+        help="Convert existing g3taps .pt file(s)/dir to k31_layer_dump_v1 without launching vLLM.",
+    )
+    p.add_argument("--g3-prompt-id", default="g3taps_prompt")
+    p.add_argument("--g3-record-idx", type=int, default=None)
+    return p
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = build_arg_parser().parse_args(argv)
+    if args.convert_g3taps:
+        out_st = convert_g3taps_to_canonical(
+            args.convert_g3taps,
+            args.out,
+            prompt_id=args.g3_prompt_id,
+            dtype_name=args.dtype,
+            record_idx=args.g3_record_idx,
+        )
+        print(f"Converted g3taps dump -> {out_st}")
+        return 0
+    if not args.model:
+        raise SystemExit("ERROR: --model is required unless --convert-g3taps is set")
+    run_offline_vllm_dump(args)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
