@@ -0,0 +1,207 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The header-level load plan (vllm/sm80/kernels/k31q/plan.py).
+
+On the tiny checkpoint the plan's bytes per rank and layer equal what the
+loader really read and holds for that rank, so the plan can stand in for a
+load where no model can be built. :func:`check_checkpoint` is that stand-in:
+manifest validation and a plan per tensor-parallel rank. It runs here on the
+tiny checkpoint and on a non-contiguous subset of its layers, and on the real
+mini checkpoint when that is on the host (K31Q_MINI_CHECKPOINT, default
+/tmp/k31q-mini-checkpoint, with a file DONE beside the
+manifest); without it that test is skipped.
+"""
+
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+from tests.models.kimi_k3.sm80 import construct
+from tests.models.kimi_k3.sm80 import k31q_fixture as fixture
+from vllm.sm80.kernels.k31q.manifest import K31QManifest
+from vllm.sm80.kernels.k31q.plan import plan, plan_layer
+from vllm.transformers_utils.config import get_config, get_hf_text_config
+
+MINI = Path(
+    os.environ.get(
+        "K31Q_MINI_CHECKPOINT", "/tmp/k31q-mini-checkpoint"
+    )
+)
+LAYERS = fixture.TEXT["num_hidden_layers"]
+
+
+@pytest.fixture(scope="module")
+def checkpoint(tmp_path_factory):
+    directory = tmp_path_factory.mktemp("k31q")
+    fixture.write_checkpoint(directory)
+    return directory
+
+
+def _text_config(directory):
+    hf_config = get_config(str(directory), trust_remote_code=False)
+    return hf_config, get_hf_text_config(hf_config)
+
+
+def check_checkpoint(directory, kernel_intermediate=None) -> list[str]:
+    """Validate a k31q directory from its headers and plan every rank of
+    tensor parallel size 1 and 2. Returns one report line per layer."""
+    manifest = K31QManifest(directory)
+    hf_config, text = _text_config(directory)
+    quantization = getattr(hf_config, "quantization_config", None) or {}
+    assert quantization.get("quant_method") == "k31q", (
+        "config.json must carry quantization_config.quant_method = k31q (top level, "
+        "or in text_config with no top-level record)"
+    )
+    assert max(manifest.layers) < text.num_hidden_layers
+    blocks = text.moe_intermediate_size // 128
+    lines = []
+    whole = plan(manifest, text, 1, 0)
+    pair = [plan(manifest, text, 2, rank) for rank in range(2)]
+    for layer in sorted(manifest.layers):
+        one, halves = whole[layer], [ranks[layer] for ranks in pair]
+        has_experts = layer >= text.first_k_dense_replace
+        assert (one.expert_method is not None) == has_experts
+        # The ranks hold the same plain tensors and split the cut matrices.
+        assert halves[0].plain_bytes == halves[1].plain_bytes == one.plain_bytes
+        assert halves[0].dense_bytes == halves[1].dense_bytes
+        assert one.dense_bytes / 2 <= halves[0].dense_bytes <= one.dense_bytes
+        if has_experts:
+            assert one.expert_blocks == slice(0, blocks)
+            # Rank r holds chunk (r + layer) mod 2; together every I-block once.
+            spans = sorted(
+                (h.expert_blocks.start, h.expert_blocks.stop) for h in halves
+            )
+            assert spans == [(0, blocks // 2), (blocks // 2, blocks)]
+            assert halves[layer % 2].expert_blocks.start == 0
+            assert halves[0].expert_bytes == halves[1].expert_bytes
+            if kernel_intermediate is not None:
+                assert text.moe_intermediate_size // 2 == kernel_intermediate
+            rates = sorted(
+                {
+                    (p.dim, p.index_bits, p.group_size)
+                    for (at, _), p in manifest.expert_projections.items()
+                    if at == layer and p.method == "vq"
+                }
+            )
+        lines.append(
+            f"layer {layer:3d} experts={one.expert_method or '-':4s} "
+            f"rank GiB: experts {halves[0].expert_bytes / 2**30:8.3f} "
+            f"dense {halves[0].dense_bytes / 2**30:7.3f} "
+            f"plain {one.plain_bytes / 2**30:7.3f}"
+            + (f" rates {rates}" if has_experts and rates else "")
+        )
+    return lines
+
+
+def test_check_on_the_tiny_checkpoint(checkpoint):
+    lines = check_checkpoint(checkpoint)
+    assert (
+        len(lines) == LAYERS and "experts=exl3" in lines[fixture.EXL3_EXPERT_LAYERS[0]]
+    )
+
+
+def test_check_on_non_contiguous_layers(checkpoint, tmp_path):
+    """A mini checkpoint holds a handful of layers, not a contiguous range:
+    the manifest reader takes whatever layers it lists."""
+    keep = (0, 1, 3, 5)
+    mini = tmp_path / "mini"
+    mini.mkdir()
+    manifest = json.loads((checkpoint / "k31q_manifest.json").read_text())
+    index = json.loads((checkpoint / "model.safetensors.index.json").read_text())
+    files = {f"layer-{layer:03d}.safetensors" for layer in keep} | set(
+        manifest["other"]
+    )
+    for name in sorted(files) + ["config.json"]:
+        os.symlink(checkpoint / name, mini / name)
+    manifest["layers"] = {str(layer): manifest["layers"][str(layer)] for layer in keep}
+    index["weight_map"] = {n: f for n, f in index["weight_map"].items() if f in files}
+    (mini / "k31q_manifest.json").write_text(json.dumps(manifest))
+    (mini / "model.safetensors.index.json").write_text(json.dumps(index))
+    assert sorted(K31QManifest(mini).layers) == list(keep)
+    assert len(check_checkpoint(mini)) == len(keep)
+
+
+@pytest.mark.skipif(
+    not (MINI / "DONE").is_file(), reason=f"no finished mini checkpoint at {MINI}"
+)
+def test_check_on_the_real_mini_checkpoint():
+    lines = check_checkpoint(MINI, kernel_intermediate=1536)
+    print("\n".join([f"k31q mini checkpoint {MINI}"] + lines))
+    _, text = _text_config(MINI)
+    assert (text.num_experts, text.routed_expert_hidden_size) == (896, 3584)
+    assert text.moe_intermediate_size == 3072
+
+
+@pytest.mark.parametrize("tp,rank", [(1, 0), (2, 0), (2, 1)])
+def test_plan_equals_what_the_loader_holds(
+    monkeypatch, meta_platform, checkpoint, tp, rank
+):
+    from vllm.model_executor.layers.fused_moe import RoutedExperts
+
+    model, _, _, _ = construct.build_and_load(
+        monkeypatch, checkpoint, tp_size=tp, tp_rank=rank
+    )
+    _, text = _text_config(checkpoint)
+    plans = plan(K31QManifest(checkpoint), text, tp, rank)
+    assert sorted(plans) == list(range(LAYERS))
+    for index, layer in enumerate(model.model.layers):
+        held, experts = 0, None
+        for module in layer.modules():
+            if isinstance(module, RoutedExperts):
+                experts = module.k31_experts
+            for weight in getattr(module, "exl3_weights", []):
+                held += sum(p.nbytes for p in weight.parameters())
+        assert plans[index].dense_bytes == held
+        if experts is None:
+            assert plans[index].expert_method is None and plans[index].expert_bytes == 0
+            continue
+        assert plans[index].expert_method == experts.method
+        assert plans[index].expert_blocks == experts.blocks
+        assert plans[index].expert_bytes == experts.bytes_read
+
+
+def test_plan_refuses_what_the_loader_could_not_serve(checkpoint, tmp_path):
+    _, text = _text_config(checkpoint)
+    manifest = K31QManifest(checkpoint)
+    # A cut that does not fall on whole 128 blocks (four ranks, 256 outputs).
+    with pytest.raises(ValueError, match="cannot be cut for 4 ranks"):
+        plan_layer(manifest, 1, text, 4, 0)
+    # Experts that do not fit the model.
+    text.num_experts += 1
+    with pytest.raises(ValueError, match="experts"):
+        plan_layer(manifest, 1, text, 2, 0)
+    text.num_experts -= 1
+    prefix = f"{fixture.P}layers.1.self_attn."
+
+    def as_exl3(name):
+        def mutate(tensors):
+            import numpy as np
+
+            del tensors[prefix + name + ".weight"]
+            rng = np.random.default_rng(0)
+            for suffix, value in fixture.exl3_synthetic(256, 128, 6, rng).items():
+                tensors[f"{prefix}{name}.{suffix}"] = value
+
+        return mutate
+
+    # The KDA key gate as EXL3: the model reads it as a dense weight.
+    broken = fixture.copy_checkpoint(checkpoint, tmp_path / "f_b")
+    fixture.edit_file(broken, "layer-001.safetensors", as_exl3("f_b_proj"))
+    with pytest.raises(ValueError, match="f_b_proj is stored as EXL3"):
+        plan_layer(K31QManifest(broken), 1, text, 2, 0)
+    # An EXL3 matrix the model has no module for.
+    broken = fixture.copy_checkpoint(checkpoint, tmp_path / "unknown")
+
+    def add(tensors):
+        import numpy as np
+
+        for suffix, value in fixture.exl3_synthetic(
+            256, 256, 6, np.random.default_rng(0)
+        ).items():
+            tensors[f"{prefix}x_proj.{suffix}"] = value
