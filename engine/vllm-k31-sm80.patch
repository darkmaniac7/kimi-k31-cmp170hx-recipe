+_API_VERSION_V2 = 2
+_OPERATORS_V2 = _OPERATORS + ("fused_kda_spec_verify",)
+_API_VERSION_V3 = 3
+_OPERATORS_V3 = _OPERATORS_V2 + (
+    "fused_kda_spec_verify_records",
+    "kda_records_materialize",
+    "moe_prune_topk",
+)
+BUILD_COMMAND = (
+    "python csrc/k31_glue/build_glue_standalone.py --arch-list \"8.0;12.0\" --ptx "
+    "--out-dir build/k31_glue && cp build/k31_glue/_k31_glue_C.abi3.so vllm/"
+)
+
+_LOADED = False
+_LOADED_V2 = False
+_LOADED_V3 = False
+_FAKES_REGISTERED = False
+_FAKES_V2_REGISTERED = False
+_FAKES_V3_REGISTERED = False
+_MODULE: Any = None
+
+
+def _torch_major_minor(version: str) -> tuple[str, ...]:
+    base = version.split("+", 1)[0]
+    parts = base.split(".")
+    return tuple(parts[:2])
+
+
+def validate_torch_version(info: dict[str, Any]) -> None:
+    """Verify extension ``build_info()['torch_version']`` matches runtime major.minor."""
+    built = str(info.get("torch_version", "")).strip()
+    runtime = torch.__version__.split("+", 1)[0]
+    if not built or _torch_major_minor(built) != _torch_major_minor(runtime):
+        raise ValueError(
+            f"torch_version mismatch for _k31_glue_C: extension built against "
+            f"{built!r}, running PyTorch {runtime!r}. Rebuild with: {BUILD_COMMAND}"
+        )
+
+
+def ensure_glue_extension() -> Any:
+    """Import and validate ``vllm._k31_glue_C`` once and register FakeTensor ops."""
+    global _LOADED, _FAKES_REGISTERED, _MODULE
+    if _LOADED and _MODULE is not None:
+        return _MODULE
+    mod = native.load(
+        "_k31_glue_C", _ABI_VERSION, _OPERATORS, BUILD_COMMAND, _API_VERSION
+    )
+    validate_torch_version(dict(mod.build_info()))
+    _MODULE = mod
+    if not _FAKES_REGISTERED:
+        _register_fake_ops()
+        _FAKES_REGISTERED = True
+    _LOADED = True
+    return _MODULE
+
