+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""VLLM_PP_SPLIT_DRAFT_EVENT, CPU only: a stage before the last consumes a
+normal step's sampled tokens and counts behind one event and defers the draft
+tokens (broadcast after the last stage's drafter ran) behind their own event
+until right before the forward, where the input ids are rewritten. The values
+that reach the request state and the input ids are those of the switch-off
+path; only the order of the waits changes.
+"""
+
+import inspect
+from collections import deque
+from contextlib import nullcontext
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+
+import vllm.v1.worker.gpu.model_runner as mr
+from vllm.sm80 import guard as sm80_guard
+from vllm.v1.worker.gpu import pp_utils
+from vllm.v1.worker.gpu.model_runner import GPUModelRunner
+from vllm.v1.worker.gpu.pp_utils import PendingRecv, PPHandler
+
+K = 3
+
+
+class _Stream:
+    """Records what is enqueued on it, in order."""
+
+    def __init__(self, log, name):
+        self.log, self.name = log, name
+        self.n_events = 0
+
+    def wait_stream(self, other):
+        self.log.append((self.name, "wait_stream"))
+
+    def wait_event(self, event):
+        self.log.append((self.name, "wait_event", event))
+
+    def record_event(self):
+        self.n_events += 1
+        event = f"{self.name}-ev{self.n_events}"
+        self.log.append((self.name, "record_event", event))
+        return event
+
+
+def _handler(monkeypatch, *, split=True, is_last=False, k=K):
+    log: list = []
+    streams = iter([_Stream(log, "main"), _Stream(log, "bcast")])
+    monkeypatch.setenv("VLLM_PP_SPLIT_DRAFT_EVENT", "1" if split else "0")
+    monkeypatch.setattr(torch.cuda, "current_stream", lambda device=None: next(streams))
+    monkeypatch.setattr(torch.cuda, "Stream", lambda device=None: next(streams))
+    monkeypatch.setattr(torch.cuda, "stream", lambda s: nullcontext())
+    monkeypatch.setattr(torch.Tensor, "record_stream", lambda self, s: None)
+    # No pinned staging on a host without a device.
+    monkeypatch.setattr(
+        pp_utils,
+        "async_tensor_h2d",
+        lambda data, device=None, dtype=None, out=None: torch.as_tensor(
+            data, dtype=dtype
+        ),
+    )
+    monkeypatch.setattr(
+        torch.distributed,
+        "broadcast",
+        lambda t, src, group: log.append(("bcast", "broadcast", tuple(t.shape))),
+    )
+    group = SimpleNamespace(
+        is_last_rank=is_last,
+        last_rank=3,
+        world_size=4,
+        make_sibling_device_group=lambda group_desc: object(),
+    )
+    monkeypatch.setattr(pp_utils, "get_pp_group", lambda: group)
+    handler = PPHandler(max_num_reqs=8, num_speculative_steps=k, device="cpu")
+    return handler, log
+
+
+def _batch(idx, k=K):
+    n = len(idx)
+    return SimpleNamespace(
+        num_reqs=n,
+        num_draft_tokens=n * k,
+        num_computed_tokens_np=np.full(n, 64, dtype=np.int32),
+        prefill_len_np=np.full(n, 8, dtype=np.int32),
+        num_scheduled_tokens=np.full(n, 1 + k, dtype=np.int32),
+        is_prefilling_np=np.zeros(n, dtype=np.bool_),
+        max_seq_len_np=None,
+        idx_mapping=torch.tensor(idx, dtype=torch.int64),
+        idx_mapping_np=np.array(idx, dtype=np.int32),
+    )
+
+
+def _slot(idx, drafts, *, split=True, need=None):
+    n = len(idx)
+    return PendingRecv(
+        event="counts",
+        sampled_tokens=torch.zeros(n, K + 1, dtype=torch.int64),
+        num_sampled=torch.ones(n, dtype=torch.int32),
+        num_rejected=torch.zeros(n, dtype=torch.int32),
+        idx_mapping=torch.tensor(idx, dtype=torch.int64),
+        idx_mapping_np=np.array(idx, dtype=np.int32),
+        need_sampled_mask=(
+            np.ones(n, dtype=bool) if need is None else np.array(need, dtype=bool)
+        ),
+        gen_at_receive_np=np.zeros(n, dtype=np.int32),
+        draft_tokens=torch.tensor(drafts, dtype=torch.int64),
+        draft_event="drafts" if split else None,
+    )
+
+
+def _queue(handler, *slots):
+    handler.queue = deque(slots)
+
+
+def _post_update_scatter(state, idx_mapping, drafts):
+    """The draft part of _post_update_kernel: rows with a negative index are
+    skipped, every other row is copied into its request's row."""
+    for row, req in enumerate(idx_mapping.tolist()):
+        if req >= 0:
+            state[req] = drafts[row]
+
+
+def test_switch_is_ported_and_off_by_default(monkeypatch):
+    assert "VLLM_PP_SPLIT_DRAFT_EVENT" not in sm80_guard.UNPORTED_SWITCHES
+    for name in sm80_guard.UNPORTED_SWITCHES:
+        monkeypatch.delenv(name, raising=False)
+    monkeypatch.setenv("VLLM_PP_SPLIT_DRAFT_EVENT", "1")
+    sm80_guard.check_unported_switches()
+    on, _ = _handler(monkeypatch, split=True)
+    assert on.split_draft_event
+    off, _ = _handler(monkeypatch, split=False)
+    assert not off.split_draft_event
+    monkeypatch.delenv("VLLM_PP_SPLIT_DRAFT_EVENT")
+    monkeypatch.setattr(
+        torch.cuda, "current_stream", lambda device=None: _Stream([], "main")
+    )
+    monkeypatch.setattr(torch.cuda, "Stream", lambda device=None: _Stream([], "b"))
+    assert not PPHandler(8, K, "cpu").split_draft_event  # default
+    # The last stage sends the drafts; it never defers them. Nor does a
+    # configuration without speculative decoding.
+    last, _ = _handler(monkeypatch, split=True, is_last=True)
+    assert not last.split_draft_event
+    none, _ = _handler(monkeypatch, split=True, k=0)
+    assert not none.split_draft_event
+
+
+def test_receive_records_the_counts_event_before_the_draft_broadcast(monkeypatch):
+    h, log = _handler(monkeypatch)
+    assert h.receive(_batch([2]), recv_drafts=True)
+    slot = h.queue[-1]
+    assert slot.event == "bcast-ev1" and slot.draft_event == "bcast-ev2"
+    ops = [e[1:] for e in log if e[0] == "bcast"]
+    assert ops == [
+        ("wait_stream",),
+        ("broadcast", (1, K + 1)),  # sampled tokens
+        ("broadcast", (2, 1)),  # counts
+        ("record_event", "bcast-ev1"),
+        ("broadcast", (1, K)),  # drafts, after the last stage's drafter
+        ("record_event", "bcast-ev2"),
+    ]
+
+
+def test_receive_keeps_one_event_without_drafts_and_for_pipespec_chunks(monkeypatch):
+    h, _ = _handler(monkeypatch)
+    h.receive(_batch([2], k=0), recv_drafts=False)
+    assert h.queue[-1].draft_event is None and h.queue[-1].draft_tokens is None
+    h.receive(_batch([2]), recv_drafts=True, fmt="A", chunk_k=1)
+    assert h.queue[-1].draft_event is None and h.queue[-1].draft_tokens is None
+    h.receive(_batch([2]), recv_drafts=True, fmt="B", chunk_k=1)
+    slot = h.queue[-1]
+    assert slot.draft_event is None and slot.draft_tokens is not None
+    assert slot.event2 is not None
+
+
+def test_receive_switch_off_is_the_stock_single_event(monkeypatch):
+    h, log = _handler(monkeypatch, split=False)
+    h.receive(_batch([2]), recv_drafts=True)
+    slot = h.queue[-1]
+    assert slot.draft_event is None and slot.event == "bcast-ev1"
+    ops = [e[1] for e in log if e[0] == "bcast"]
+    assert ops == ["wait_stream", "broadcast", "broadcast", "broadcast", "record_event"]
+
+
+def test_consume_waits_counts_only_and_defers_drafts(monkeypatch):
+    h, log = _handler(monkeypatch)
+    _queue(h, _slot([3, 5], [[11, 12, 13], [21, 22, 23]]))
+    state = torch.zeros(8, K, dtype=torch.int64)
+    out = h.get_prev_sampled_outputs()
+    assert out is not None and out["draft_tokens"] is None  # post_update: no scatter
+    waits = [e[2] for e in log if e[:2] == ("main", "wait_event")]
+    assert waits == ["counts"]
+    assert h.has_pending_drafts() and not state.any()
+    h.apply_pending_drafts(state, after_wait=lambda: log.append(("main", "mark")))
+    waits = [e[2] for e in log if e[:2] == ("main", "wait_event")]
+    assert waits == ["counts", "drafts"]
+    assert log[-1] == ("main", "mark") and log[-2] == ("main", "wait_event", "drafts")
+    assert state[3].tolist() == [11, 12, 13] and state[5].tolist() == [21, 22, 23]
+    assert not h.has_pending_drafts()
+    h.apply_pending_drafts(state)  # nothing pending: no wait, no write
+    assert [e[2] for e in log if e[:2] == ("main", "wait_event")] == waits
+
