@@ -0,0 +1,537 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Build and load the Kimi K3.1 text model from a tiny k31q checkpoint on the
+CPU: tensor parallel size 1, each rank of size 2, and a three-stage pipeline
+from stage views and from the whole directory.
+
+Every case runs the k31q loader end to end (``load_k31q_weights``): packed
+slices, the fused KDA in-projection, this rank's I-blocks of the stacked
+expert tensors, and every plain tensor through ``model.load_weights``. The
+ledger then accounts for every tensor of the directory exactly once and no
+runtime parameter stays unloaded (the loader raises otherwise). The checks
+below add what the loader cannot know: that each module took the method its
+storage class calls for, that a rank holds the bytes of its own cut, and that
+across ranks and stages every tensor has the owners it should.
+"""
+
+import numpy as np
+import pytest
+import torch
+
+from tests.models.kimi_k3.sm80 import construct
+from tests.models.kimi_k3.sm80 import k31q_fixture as fixture
+
+LAYERS = fixture.TEXT["num_hidden_layers"]
+PARTITION = (2, 2, 2)
+EXL3_LAYER = fixture.EXL3_EXPERT_LAYERS[0]
+VQ_LAYERS = [n for n in range(1, LAYERS) if n != EXL3_LAYER]
+MLA_LAYER = 3
+
+
+@pytest.fixture(scope="module")
+def checkpoint(tmp_path_factory):
+    directory = tmp_path_factory.mktemp("k31q")
+    reference = fixture.write_checkpoint(directory)
+    return directory, reference
+
+
+@pytest.fixture(scope="module")
+def views(tmp_path_factory, checkpoint):
+    return fixture.build_views(
+        checkpoint[0], tmp_path_factory.mktemp("views"), PARTITION
+    )
+
+
+def _layer(model, index):
+    return model.model.layers[index]
+
+
+def _experts(model, index):
+    return _layer(model, index).block_sparse_moe.experts.routed_experts
+
+
+def _file(directory, layer):
+    return directory / f"layer-{layer:03d}.safetensors"
+
+
+def _bits(tensor: torch.Tensor) -> np.ndarray:
+    """Raw 16-bit patterns of a BF16 or F16 tensor."""
+    return tensor.detach().contiguous().view(torch.int16).numpy().view(np.uint16)
+
+
+def test_methods_follow_the_storage_classes(monkeypatch, meta_platform, checkpoint):
+    from vllm.model_executor.layers.linear import UnquantizedLinearMethod
+    from vllm.sm80.kernels.exl3.quant import Exl3LinearMethod
+    from vllm.sm80.kernels.k31q.moe import K31Exl3MoEMethod, K31VqMoEMethod
+    from vllm.sm80.kernels.k31q.quant import (
+        K31DenseLinearMethod,
+        K31FusedLinearMethod,
+        K31PlainLinearMethod,
+    )
+
+    directory, _ = checkpoint
+    model, config, report, names = construct.build_and_load(monkeypatch, directory)
+    assert report.layers == (0, LAYERS) and (report.tp_size, report.pp_size) == (1, 1)
+    # The ledger accounts for every tensor; at one rank and one stage all are consumed.
+    assert set(report.ledger) == names
+    assert {use for use, _ in report.ledger.values()} == {"consumed"}
+
+    kda, mla = _layer(model, 1).self_attn, _layer(model, MLA_LAYER).self_attn
+    assert type(kda.in_proj_qkvgfab.quant_method) is K31FusedLinearMethod
+    for module in (
+        kda.o_proj,
+        mla.fused_qkv_a_proj,
+        mla.q_b_proj,
+        mla.o_proj,
+        mla.g_proj,
+    ):
+        assert type(module.quant_method) is K31DenseLinearMethod
+    # The K3.1 dense method keeps the EXL3 method's weights and loader.
+    assert issubclass(K31DenseLinearMethod, Exl3LinearMethod)
+    # KDA f_b_proj uses the row-count-invariant plain linear subclass; other
+    # plain quantizable linears stay UnquantizedLinearMethod.
+    assert type(kda.f_b_proj.quant_method) is K31PlainLinearMethod
+    assert issubclass(K31PlainLinearMethod, UnquantizedLinearMethod)
+    for module in (mla.kv_b_proj, mla.dsa_indexer.wq_index):
+        assert type(module.quant_method) is UnquantizedLinearMethod
+    assert type(_layer(model, 0).mlp.gate_up_proj.quant_method) is K31DenseLinearMethod
+    moe = _layer(model, 1).block_sparse_moe
+    for module in (
+        moe.shared_experts.gate_up_proj,
+        moe.shared_experts.down_proj,
+        moe.routed_expert_down_proj,
+        moe.routed_expert_up_proj,
+        model.lm_head,
+    ):
+        assert type(module.quant_method) is K31DenseLinearMethod
+    for layer in VQ_LAYERS:
+        assert type(_experts(model, layer).quant_method) is K31VqMoEMethod
+    assert type(_experts(model, EXL3_LAYER).quant_method) is K31Exl3MoEMethod
+    # One owner per MoE layer, no module per expert.
+    for layer in range(1, LAYERS):
+        modules = [n for n, _ in _experts(model, layer).named_modules() if n]
+        assert modules == ["k31_experts"]
+    # The fused KDA in-projection: q, k, v, g as EXL3, f_a and b plain, padding.
+    method = kda.in_proj_qkvgfab.quant_method
+    assert [kind for kind, _ in method.segments] == ["exl3"] * 4 + ["plain"] * 2
+    heads, dim = 2, 128
+    assert kda.in_proj_qkvgfab.plain_weight.shape == (dim + heads, 256)
+    # Never the merged matrix: only the zero-column weight upstream's padding needs.
+    assert kda.in_proj_qkvgfab.weight.numel() == 0
+
+
+def test_a_layer_without_weights_needs_no_manifest_after_the_load(
+    monkeypatch, meta_platform, checkpoint
+):
+    """The loader releases the manifest; upstream's MLA attention layer then
+    asks the config for a method of its own (process_weights_after_loading,
+    for KV-cache scales). The engine's first load of an MLA layer from a k31q
+    checkpoint stopped there with "k31q manifest must precede model
+    construction"."""
+    from vllm.model_executor.layers.attention.mla_attention import MLAAttention
+    from vllm.model_executor.layers.quantization.base_config import (
+        resolve_quant_method,
+    )
+
+    directory, _ = checkpoint
+    model, config, _, _ = construct.build_and_load(monkeypatch, directory)
+    quant = config.quant_config
+    assert quant.manifest is None
+    assert quant.get_quant_method(torch.nn.Identity(), "model.layers.3.x") is None
+    attention = [m for m in model.modules() if isinstance(m, MLAAttention)]
+    assert attention, "the fixture has an MLA layer"
+    for module in attention:
+        assert module.quant_config is quant
+        assert resolve_quant_method(quant, module, prefix=module.layer_name) is None
+    # A layer that holds weights still needs it.
+    mla = _layer(model, MLA_LAYER).self_attn
+    with pytest.raises(AssertionError, match="manifest must precede"):
+        quant.get_quant_method(mla.o_proj, "model.layers.3.self_attn.o_proj")
+
