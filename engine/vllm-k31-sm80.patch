+  // Threads 0..127 do Q then V; threads 128..255 do K.
+  auto run_conv_channel = [&](int c_global, float& out_val) {
+    __nv_bfloat16* cs_c = cs_slot + static_cast<int64_t>(c_global) * stride_cs_c;
+    const int64_t cw_off = static_cast<int64_t>(c_global) * stride_cw_c;
+    __nv_bfloat16 x0 = cs_c[0 * stride_cs_t];
+    __nv_bfloat16 x1 = cs_c[1 * stride_cs_t];
+    __nv_bfloat16 x2 = cs_c[2 * stride_cs_t];
+    __nv_bfloat16 x3 = x_b[c_global];
+
