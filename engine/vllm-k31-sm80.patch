+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""K3.1 lever 3: the DSpark confidence dump on the merged tree. Rows pair per
+request, so pipeline-parallel micro-batches that interleave their propose
+calls on the last rank still pair each block with its own verification; the
+draft-logit statistics follow upstream's separate Markov bias. CPU only."""
+
+import pytest
+import torch
+
+from tests.v1.spec_decode.test_dspark_confidence_dump import (  # noqa: F401
+    _fake_draft_step,
+    _propose_positional,
+    _rows,
+    make,
+)
+from vllm.sm80.spec_decode import dspark_confidence as dump_module
+from vllm.v1.worker.gpu.spec_decode.dspark import speculator as upstream
+
+pytestmark = pytest.mark.cpu_test
+
+
+def test_interleaved_micro_batches_pair_each_request_with_its_own_block(
+    make, monkeypatch, tmp_path
+):
+    _fake_draft_step(monkeypatch)
+    drafter = make()
+    drafter.load_draft_model(None, set())
+    # Two micro-batches alternate on the last rank (PP): a, b, a, b, ...
+    _propose_positional(drafter, ["a"], [1], [0])  # call 1: a prefill, drafts
+    _propose_positional(drafter, ["b"], [1], [0])  # call 2: b prefill, drafts
+    _propose_positional(drafter, ["a"], [3], [2])  # call 3: a verified call 1's block
+    _propose_positional(drafter, ["b"], [2], [3])  # call 4: b verified call 2's block
+    _propose_positional(drafter, ["a"], [6], [0])  # call 5: a verified call 3's block
+    drafter._confidence_dump.close()
+    rows = _rows(tmp_path)
+    got = [(r["req"], r["verified"], r["accepted"], r["conf"][0]) for r in rows]
+    assert got == [
+        ("a", 4, 2, pytest.approx(1.0)),
+        ("b", 4, 1, pytest.approx(2.0)),
+        ("a", 5, 5, pytest.approx(3.0)),
+    ]
+
+
+def test_a_request_drafted_long_ago_is_still_paired(make, monkeypatch, tmp_path):
+    # More micro-batches than staging rounds between a request's two calls.
+    _fake_draft_step(monkeypatch)
+    drafter = make()
+    drafter.load_draft_model(None, set())
+    _propose_positional(drafter, ["a"], [1], [0])
+    for i in range(dump_module.NUM_SLOTS + 5):
+        _propose_positional(drafter, [f"x{i}"], [1], [0])
+    _propose_positional(drafter, ["a"], [2], [4])
+    drafter._confidence_dump.close()
+    (row,) = [r for r in _rows(tmp_path) if r["req"] == "a"]
+    assert (row["verified"], row["accepted"]) == (5, 1)
+    assert row["conf"][0] == pytest.approx(1.0)
+
+
+def test_draft_stats_include_the_markov_bias_passed_separately(make, monkeypatch, tmp_path):
+    seen = []
+
+    def upstream_sample(self, logits, idx_map, sample_pos, step, bias=None):
+        seen.append(bias)
+        return logits.argmax(dim=-1)
+
+    monkeypatch.setattr(upstream.DSparkSpeculator, "_sample_logits", upstream_sample,
+                        raising=False)
+    drafter = make()
+    drafter.load_draft_model(None, set())
+    logits = torch.zeros(1, 4)
+    bias = torch.tensor([[50.0, 0.0, 0.0, 0.0]])
+    # Upstream's Markov loop passes the bias as a fifth argument.
+    drafter._sample_logits(logits, None, None, 0, bias)
+    drafter._sample_logits(logits, None, None, 1)
+    assert seen[0] is bias and seen[1] is None
+    # Position 0 saw the biased (sharp) logits, position 1 the flat ones.
+    assert drafter._draft_stats[0, 0, 0].item() == pytest.approx(1.0, abs=1e-6)
+    assert drafter._draft_stats[0, 0, 1].item() == pytest.approx(0.25, abs=1e-6)
+
