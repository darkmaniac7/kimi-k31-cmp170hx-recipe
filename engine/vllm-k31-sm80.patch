+def test_every_dense_module_launches_its_members_once(
+    monkeypatch, meta_platform, checkpoint, manager
+):
+    """TP 1: every dense module of the model runs on the k31 backend, one
+    launch per call with its members in shard order, and gives the EXL3
+    path's bits; per layer: KDA + MoE 6 launches, MLA + MoE 8, layer 0 (KDA
+    + dense MLP) 4, the head 1."""
+    from vllm.sm80.kernels.k31q import dense
+    from vllm.sm80.kernels.k31q.quant import K31FusedLinearMethod
+
+    ops = fake_dense.FakeDenseOps().install(monkeypatch)
+    old_calls = _old_path(monkeypatch)
+    model, _ = _build(monkeypatch, checkpoint, ops)
+    modules = _dense_modules(model)
+    rows = dense.backends(model)
+    assert {backend for _, backend, _, _ in rows} == {"k31"}
+    # 5 KDA layers x 2, 5 MoE layers x 4, the layer 0 MLP 2, the MLA layer 4, the head.
+    assert len(rows) == len(modules) == 5 * 2 + 5 * 4 + 2 + 4 + 1
+
+    launches_per_layer = {}
+    for name, module in modules.items():
+        kind = _kind(name)
+        method = module.quant_method
+        launcher, reason, members = method.k31_dense_state()
+        assert reason is None and launcher is not None
+        wanted = ["lm_head"] if kind == "lm_head" else EXPECTED_MEMBERS[kind]
+        assert [_leaf(m) for m in members] == wanted, name
+        # VLLM_K31Q_DENSE_PREFILL=exl3 (default): calls of up to 32 rows.
+        assert launcher.launch_rows == launcher.max_rows == dense.DECODE_MAX_ROWS
+        for count in (1, 8):
+            x = _inputs(module, count, seed=count)
+            ops.calls.clear()
+            old_calls.clear()
+            with construct.no_host_reads(monkeypatch):
+                new, old = _same_as_old_path(module, x)
+            assert torch.equal(new, old), f"{name} {count} rows"
+            (call,) = ops.calls
+            assert [_leaf(m) for m in call["members"]] == wanted
+            assert call["rows"] == count and call["cols"] == x.shape[1]
+            widths = [w.logical_out for w in module.exl3_weights]
+            assert call["logical_outs"] == widths
+            assert call["bits_x2s"] == [w.matrix.bits_x2 for w in module.exl3_weights]
+            assert len(old_calls) == len(wanted)
+            if isinstance(method, K31FusedLinearMethod):
+                # q, k, v, g from the launch, then f_a, b and the padding.
+                assert (
+                    new.shape[-1]
+                    == sum(widths) + module.plain_weight.shape[0] + method.padding
+                )
+        layer = (
+            "head"
+            if kind == "lm_head"
+            else int(name.split(".layers.")[1].split(".")[0])
+        )
+        launches_per_layer[layer] = launches_per_layer.get(layer, 0) + 1
+    layers = fixture.TEXT["num_hidden_layers"]
+    assert launches_per_layer == {
+        0: 4,
+        **{n: 6 for n in range(1, layers) if n != MLA_LAYER},
+        MLA_LAYER: 8,
+        "head": 1,
+    }
+
