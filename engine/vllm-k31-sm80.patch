+                    prev_s = prev_buf
+                m_t, _ = ar1_markov_head.step_precomputed(
+                    w1[prev_s], hb[:, s_i], kv, s_i
+                )
+                slots = mt.recurrent_step_slots(
+                    state_base, s_i, prev_s, m_t, local, tc, tv, None, k_steps, 0, 0, 2
+                )
+            mt.last_drafts(slots, out_a, k_steps, 2, vocab)
+
+        def run_ar1_embed():
+            tc, tv = mt.top_candidates(local, width, cands)
+            hb = ar1_embed_head.precompute_hidden(dh)
+            kv = ar1_embed_head.init_kv_cache(1, k_steps, device)
+            slots = None
+            for s_i in range(k_steps):
+                if s_i == 0:
+                    prev_s = input_ids[anchors].long()
+                else:
+                    mt.pick_prev_drafts(slots, out_e, prev_buf, s_i, k_steps, 2, vocab)
+                    prev_s = prev_buf
+                m_t, vec_t = ar1_embed_head.step_precomputed(
+                    w1[prev_s], hb[:, s_i], kv, s_i
+                )
+                cand_all = torch.cat(
+                    [tc[s_i::k_steps], succ_cols[prev_s.clamp(0, vocab - 1)]], dim=-1
+                ).clamp(min=0).long()
+                extra = (
+                    torch.bmm(embed_rows[cand_all], vec_t.unsqueeze(-1))
+                    .squeeze(-1)
+                    .float()
+                )
+                slots = mt.recurrent_step_slots(
+                    state_base, s_i, prev_s, m_t, local, tc, tv, extra, k_steps, 0, 0, 2
+                )
+            mt.last_drafts(slots, out_e, k_steps, 2, vocab)
+
+        run_gru()
+        eager_g = out_g.clone()
+        us_v = bench_us(run_vanilla)
+        us_g = bench_us(run_gru)
+        assert torch.equal(out_g, eager_g)
+        run_ar1_embed()
+        eager_e = out_e.clone()
+        us_a = bench_us(run_ar1_markov)
+        us_e = bench_us(run_ar1_embed)
+        assert torch.equal(out_e, eager_e)
+        print(f"{k_steps:2d}   {us_v:10.1f}   {us_g:10.1f}   {us_a:13.1f}   {us_e:17.1f}")
