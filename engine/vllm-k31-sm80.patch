+        num_spec_decodes=1,
+        num_spec_decode_tokens=W,
+        spec_state_indices_tensor=torch.tensor([[1, 2, 3, 4]], dtype=torch.int32),
+        spec_query_start_loc=torch.tensor([0, W], dtype=torch.int32),
+        num_accepted_tokens=None if case == "missing_acc" else torch.tensor([1], dtype=torch.int32),
+        spec_token_start=0 if case in ("mixed_prefill", "mixed_decode") else None,
+        non_spec_token_start=W if case in ("mixed_prefill", "mixed_decode") else None,
+    )
+    monkeypatch.setattr(
+        kda_mod,
+        "get_forward_context",
+        lambda: SimpleNamespace(attn_metadata={attn.prefix: meta}),
+    )
+
+    class _FallbackHit(RuntimeError):
+        pass
+
+    def _trip(*args, **kwargs):
+        raise _FallbackHit(case)
+
+    monkeypatch.setattr(kda_mod, "causal_conv1d_update", _trip)
