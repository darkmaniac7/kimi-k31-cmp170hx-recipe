+        assert not any(op == "wait_event" for _, op, _ in streams.log)
+        assert torch.equal(project_kv(a, hashes), hashes.float() * 3)
+        assert torch.equal(project_kv(b, hashes + 1), (hashes.float() + 1) * 3)
