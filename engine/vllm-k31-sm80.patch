@@ -0,0 +1,360 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Python interface, packed table builder, and FakeTensor registrations for
+_k31_vq_C (sm_80 + sm_120).
+
+Mirrors vllm/sm80/kernels/exl3/ops.py moe_out_k31 / moe_out_prefill_k31 /
+moe_workspace_size_k31 so K31VqMoEMethod plugs cleanly alongside EXL3 MoE
+without engine changes.
+
+This is the kernel owner's ``vq_ops.py`` of release 2 (api_version 2;
+csrc/k31_vq holds the package's sources unchanged) with one change: the
+library is not searched for beside this file or in a build directory. It is
+``vllm/_k31_vq_C.abi3.so`` beside ``vllm/_exl3_C.abi3.so``, imported and
+checked by vllm/sm80/kernels/k31q/native.py as ops.py checks ``_exl3_C``; a
+build of release 1 (no api_version) is refused with the build command.
+
+Release 2 keeps every signature and the k31q on-disk format. ``vq_pack``
+writes a new packed layout (pair-packed indices) into the same tensor shapes,
+so a caller that packs through ``vq_pack`` needs no change; buffers packed by
+a release 1 library must not be read by release 2 kernels. The decode op is
+bitwise deterministic from run to run (no atomic accumulation).
+
+Interface (README of the package):
+  ``vq_pack``  canonical per-rank record slices U8 [E, n_blocks, record_bytes]
+      and F16 [E, n_blocks, n_scales] (CUDA) -> packed int32 [E, out / 16,
+      in / 128, WPL, 32] and F16 [E, out / 16, in / 128, 16]; ``role`` 0 for
+      w1 and w3 ([I, H]), 1 for w2 ([H, I]).
+  ``packed_ptrs``  int64 [local_experts, 9]: per projection q in (0 = w1,
+      1 = w3, 2 = w2) the addresses [q * 3 + 0] of the expert's packed
+      indices, [q * 3 + 1] of its packed scales and [q * 3 + 2] of the F16
+      codebook, each 16-byte aligned.
+  ``packed_meta``  int64 [local_experts, 12]: per projection [q * 4 + 0]
+      in_features, [q * 4 + 1] out_features, [q * 4 + 2] dim, [q * 4 + 3]
+      index_bits.
+  ``moe_out_vq`` (1 to 64 rows) and ``moe_out_prefill_vq`` (up to 2,048 rows)
+      take them with ``rate_id_gu`` and ``rate_id_dn`` (:func:`vq_rate_id`)
+      for a layer of one static rate, or -1 to read the rates from
+      ``packed_meta`` on the device.
+"""
+
+from __future__ import annotations
+
+import torch
+
+from vllm.sm80.kernels.k31q import native
+
+# Interface versions of the library (csrc/k31_vq/vq_module.cpp build_info)
+# and the operators this tree calls; a library without one of them, or with an
+# api_version below _API_VERSION (or none), is refused.
+_ABI_VERSION = 1
+_API_VERSION = 2
+_OPERATORS = (
+    "vq_pack",
+    "vq_dequant_reference",
+    "moe_workspace_size_vq",
+    "moe_out_vq",
+    "moe_out_prefill_vq",
+)
+# build/ is git-ignored; the script leaves its objects in <out-dir>/obj.
+BUILD_COMMAND = (
+    "python csrc/k31_vq/build_vq_standalone.py --out-dir build/k31_vq && "
+    "cp build/k31_vq/_k31_vq_C.abi3.so vllm/"
+)
+
+_LOADED = False
+_FAKES_REGISTERED = False
+_MODULE = None
+
+
+def ensure_vq_extension() -> None:
+    global _LOADED, _FAKES_REGISTERED, _MODULE
+    if _LOADED:
+        return
+    _MODULE = native.load(
+        "_k31_vq_C", _ABI_VERSION, _OPERATORS, BUILD_COMMAND, _API_VERSION
+    )
+    if not _FAKES_REGISTERED:
+        _register_fake_ops()
+        _FAKES_REGISTERED = True
+    _LOADED = True
+
+
+def build_info() -> dict:
+    """The loaded library's build metadata (abi_version, api_version,
+    torch_version, cuda_version, cxx11_abi)."""
+    ensure_vq_extension()
+    return dict(_MODULE.build_info())
+
+
+def _register_fake_ops() -> None:
+    @torch.library.register_fake("_k31_vq_C::vq_pack")
+    def _fake_pack(
+        idx_records: torch.Tensor,
+        scale_records: torch.Tensor,
+        codebook: torch.Tensor,
+        role: int,
+        hidden_size: int,
+        dim: int,
+        index_bits: int,
+        group_size: int = 128,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        E, nb = idx_records.shape[0], idx_records.shape[1]
+        out_f = nb * 128 if role == 0 else hidden_size
+        in_f = hidden_size if role == 0 else nb * 128
+        bpt = 4 * index_bits if dim == 2 else 2 * index_bits
+        wpl = (8 * bpt + 31) // 32
+        out_idx = idx_records.new_empty(
+            (E, out_f // 16, in_f // 128, wpl, 32), dtype=torch.int32
+        )
+        out_sc = scale_records.new_empty(
+            (E, out_f // 16, in_f // 128, 16), dtype=torch.float16
+        )
+        return out_idx, out_sc
+
+    @torch.library.register_fake("_k31_vq_C::vq_dequant_reference")
+    def _fake_dequant(
+        packed_idx: torch.Tensor,
+        packed_scale: torch.Tensor,
+        codebook: torch.Tensor,
+        out_features: int,
+        in_features: int,
+        dim: int,
+        index_bits: int,
+        group_size: int = 128,
+    ) -> torch.Tensor:
+        return packed_idx.new_empty(
+            (packed_idx.shape[0], out_features, in_features), dtype=torch.float32
+        )
+
+    @torch.library.register_fake("_k31_vq_C::moe_out_vq")
+    def _fake_decode(
+        x,
+        topk_ids,
+        topk_weights,
+        packed_ptrs,
+        packed_meta,
+        expert_map,
+        intermediate_size,
+        out,
+        workspace,
+        situ_beta=4.0,
+        situ_linear_beta=25.0,
+        swiglu_limit=0.0,
+        rate_id_gu=-1,
+        rate_id_dn=-1,
+    ) -> None:
+        return None
+
+    @torch.library.register_fake("_k31_vq_C::moe_out_prefill_vq")
+    def _fake_prefill(
+        x,
+        topk_ids,
+        topk_weights,
+        packed_ptrs,
+        packed_meta,
+        expert_map,
+        intermediate_size,
+        out,
+        workspace,
+        situ_beta=4.0,
+        situ_linear_beta=25.0,
+        swiglu_limit=0.0,
+        rate_id_gu=-1,
+        rate_id_dn=-1,
+    ) -> None:
+        return None
+
+
+def vq_pack(
+    idx_records: torch.Tensor,
+    scale_records: torch.Tensor,
+    codebook: torch.Tensor,
+    role: int,
+    hidden_size: int,
+    dim: int,
+    index_bits: int,
+    group_size: int = 128,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    ensure_vq_extension()
+    return torch.ops._k31_vq_C.vq_pack(
+        idx_records,
+        scale_records,
+        codebook,
+        role,
+        hidden_size,
+        dim,
+        index_bits,
+        group_size,
+    )
+
+
+def vq_dequant_reference(
+    packed_idx: torch.Tensor,
+    packed_scale: torch.Tensor,
+    codebook: torch.Tensor,
+    out_features: int,
+    in_features: int,
+    dim: int,
+    index_bits: int,
+    group_size: int = 128,
+) -> torch.Tensor:
+    ensure_vq_extension()
+    return torch.ops._k31_vq_C.vq_dequant_reference(
+        packed_idx,
+        packed_scale,
+        codebook,
+        out_features,
+        in_features,
+        dim,
+        index_bits,
+        group_size,
+    )
+
+
+def build_vq_expert_tables(
+    w1_idx: torch.Tensor,
+    w1_sc: torch.Tensor,
+    w1_cb: torch.Tensor,
+    w1_dim: int,
+    w1_bits: int,
+    w3_idx: torch.Tensor,
+    w3_sc: torch.Tensor,
+    w3_cb: torch.Tensor,
+    w3_dim: int,
+    w3_bits: int,
+    w2_idx: torch.Tensor,
+    w2_sc: torch.Tensor,
+    w2_cb: torch.Tensor,
+    w2_dim: int,
+    w2_bits: int,
+    hidden_size: int,
+    intermediate_size: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Construct exact GPU packed_ptrs [E, 9] and packed_meta [E, 12] tables
+    for moe_out_vq.
+
+    Caller must keep w1_idx/sc/cb, w3_idx/sc/cb, w2_idx/sc/cb alive for the
+    lifetime of the tables.
+
+    The engine builds its tables in K31Experts (vllm/sm80/kernels/k31q/moe.py);
+    this is the kernel owner's builder, kept as the layout's second
+    definition (the GPU tests compare the two).
+    """
+    E = w1_idx.shape[0]
+    dev = w1_idx.device
+    ptrs = torch.empty((E, 9), dtype=torch.int64, device="cpu")
+    meta = torch.empty((E, 12), dtype=torch.int64, device="cpu")
+    specs = (
+        (0, w1_idx, w1_sc, w1_cb, hidden_size, intermediate_size, w1_dim, w1_bits),
+        (1, w3_idx, w3_sc, w3_cb, hidden_size, intermediate_size, w3_dim, w3_bits),
+        (2, w2_idx, w2_sc, w2_cb, intermediate_size, hidden_size, w2_dim, w2_bits),
+    )
+    for q, idx_t, sc_t, cb_t, in_f, out_f, dim, bits in specs:
+        idx_stride = idx_t.stride(0) * idx_t.element_size()
+        sc_stride = sc_t.stride(0) * sc_t.element_size()
+        idx_base = idx_t.data_ptr()
+        sc_base = sc_t.data_ptr()
+        cb_ptr = cb_t.data_ptr()
+        offs = torch.arange(E, dtype=torch.int64)
+        ptrs[:, q * 3 + 0] = idx_base + offs * idx_stride
+        ptrs[:, q * 3 + 1] = sc_base + offs * sc_stride
+        ptrs[:, q * 3 + 2] = cb_ptr
+        meta[:, q * 4 + 0] = in_f
+        meta[:, q * 4 + 1] = out_f
+        meta[:, q * 4 + 2] = dim
+        meta[:, q * 4 + 3] = bits
+    return ptrs.to(dev), meta.to(dev)
+
+
+def moe_workspace_size_vq(
+    max_rows: int,
+    hidden_size: int,
+    intermediate_size: int,
+    topk: int,
+    local_experts: int,
+) -> int:
+    ensure_vq_extension()
+    return int(
+        torch.ops._k31_vq_C.moe_workspace_size_vq(
+            max_rows, hidden_size, intermediate_size, topk, local_experts
+        )
+    )
+
+
+def vq_rate_id(dim: int, index_bits: int) -> int:
+    """Return kernel rate_id hint (0:d2_b3, 1:d2_b4, 2:d2_b5, 3:d4_b5,
+    4:d4_b6; -1 if unknown)."""
+    return {(2, 3): 0, (2, 4): 1, (2, 5): 2, (4, 5): 3, (4, 6): 4}.get(
+        (dim, index_bits), -1
+    )
+
+
+def moe_out_vq(
+    x: torch.Tensor,
+    topk_ids: torch.Tensor,
+    topk_weights: torch.Tensor,
+    packed_ptrs: torch.Tensor,
+    packed_meta: torch.Tensor,
+    expert_map: torch.Tensor,
+    intermediate_size: int,
+    out: torch.Tensor,
+    workspace: torch.Tensor,
+    situ_beta: float = 4.0,
+    situ_linear_beta: float = 25.0,
+    swiglu_limit: float = 0.0,
+    rate_id_gu: int = -1,
+    rate_id_dn: int = -1,
+) -> None:
+    ensure_vq_extension()
+    torch.ops._k31_vq_C.moe_out_vq(
+        x,
