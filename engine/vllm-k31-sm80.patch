+
+def _speculator(**model_overrides):
+    w1 = torch.zeros(16, 4, dtype=torch.bfloat16)
+    model = SimpleNamespace(
+        markov_w2_rows=lambda start, n: torch.zeros(n, 4, dtype=torch.bfloat16),
+        logits_processor=SimpleNamespace(org_vocab_size=16),
+        model=SimpleNamespace(
+            markov_head=SimpleNamespace(markov_w1=SimpleNamespace(weight=w1))
+        ),
+    )
+    for k, v in model_overrides.items():
+        if v is None:
+            delattr(model, k)
+        else:
+            setattr(model, k, v)
+    return SimpleNamespace(model=model)
