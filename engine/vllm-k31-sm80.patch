+    situ_linear_beta: float = 25.0,
+    swiglu_limit: float = 0.0,
+) -> None:
+    """K3.1 TP2 decode/verify EXL3 MoE (1..64 rows at top_k=16, mixed K1/K2/K3)."""
+    require_moe_k31()
