+    conv_b_fp32 = (conv_bias->scalar_type() == at::kFloat);
+  }
+
+  TORCH_CHECK(raw_g.is_cuda() && raw_g.scalar_type() == at::kBFloat16 &&
+                  raw_g.dim() == 3 && raw_g.size(0) == T && raw_g.size(1) == H &&
+                  raw_g.size(2) == D && raw_g.stride(2) == 1 && raw_g.stride(1) == D,
+              "raw_g must be CUDA BF16 [T, H, 128]");
+  TORCH_CHECK(raw_beta.is_cuda() && raw_beta.scalar_type() == at::kBFloat16 &&
+                  raw_beta.dim() == 2 && raw_beta.size(0) == T && raw_beta.size(1) == H &&
+                  raw_beta.stride(1) == 1,
+              "raw_beta must be CUDA BF16 [T, H]");
+  TORCH_CHECK(g2.is_cuda() && g2.scalar_type() == at::kBFloat16 &&
+                  g2.dim() == 3 && g2.size(0) == T && g2.size(1) == H &&
+                  g2.size(2) == D && g2.stride(2) == 1 && g2.stride(1) == D,
+              "g2 must be CUDA BF16 [T, H, 128]");
+  TORCH_CHECK(out.is_cuda() && out.scalar_type() == at::kBFloat16 &&
+                  out.dim() == 3 && out.size(0) == T && out.size(1) == H &&
+                  out.size(2) == D && out.stride(2) == 1 && out.stride(1) == D,
+              "out must be CUDA BF16 [T, H, 128]");
+
+  TORCH_CHECK(A_log.is_cuda() && A_log.is_contiguous() && A_log.numel() == H &&
+                  (A_log.scalar_type() == at::kFloat || A_log.scalar_type() == at::kBFloat16),
+              "A_log must be CUDA FP32/BF16 [H]");
+  TORCH_CHECK(dt_bias.is_cuda() && dt_bias.is_contiguous() && dt_bias.numel() == H * D &&
+                  (dt_bias.scalar_type() == at::kFloat || dt_bias.scalar_type() == at::kBFloat16),
+              "dt_bias must be CUDA FP32/BF16 [H*128]");
+  TORCH_CHECK(norm_weight.is_cuda() && norm_weight.is_contiguous() && norm_weight.numel() == D &&
+                  (norm_weight.scalar_type() == at::kFloat ||
+                   norm_weight.scalar_type() == at::kBFloat16),
+              "norm_weight must be CUDA FP32/BF16 [128]");
+
+  const c10::cuda::CUDAGuard device_guard(mixed_qkv.device());
+  cudaStream_t stream = at::cuda::getCurrentCUDAStream();
+
+  TORCH_CHECK(is_aligned_16(recurrent_state.data_ptr()) && (recurrent_state.stride(0) % 4 == 0),
+              "recurrent_state must be 16-byte aligned with slot stride multiple of 4 floats");
+  constexpr int kSplitV = 8;
+  const int64_t bh_total = N * H;
+  const int64_t th_total = T * H;
+  TORCH_CHECK(bh_total * kSplitV <= 2147483647LL, "N * H * 8 exceeds CUDA gridDim.x limit");
+
+  const bool a_log_fp32 = (A_log.scalar_type() == at::kFloat);
+  const bool dt_bias_fp32 = (dt_bias.scalar_type() == at::kFloat);
+  const bool norm_w_fp32 = (norm_weight.scalar_type() == at::kFloat);
+  const bool ssi_i64 = (spec_state_indices.scalar_type() == at::kLong);
+  const bool qsl_i64 = (query_start_loc.scalar_type() == at::kLong);
+  const bool acc_i64 = (num_accepted_tokens.scalar_type() == at::kLong);
+  const bool use_lower_bound = (lower_bound < 0.0);
+
+  auto align4 = [](int64_t x) -> int64_t { return (x + 3) & ~3LL; };
+  const int64_t qkv_elems = align4(th_total * D);
+  const int64_t beta_elems = align4(th_total);
+  const int64_t base_floats = align4(N * 2);
+  const int64_t nfold_floats = align4(N);
+  const int64_t arrive_floats = align4(bh_total);
+  const int64_t ws_floats =
+      4 * qkv_elems + beta_elems + base_floats + nfold_floats + arrive_floats;
+
+  at::Tensor ws = at::empty(
+      {ws_floats},
+      at::TensorOptions().dtype(at::kFloat).device(mixed_qkv.device()));
+  TORCH_CHECK(is_aligned_16(ws.data_ptr()), "workspace allocation must be 16-byte aligned");
+
+  float* ws_q = ws.data_ptr<float>();
+  float* ws_k = ws_q + qkv_elems;
+  float* ws_v = ws_k + qkv_elems;
+  float* ws_decay = ws_v + qkv_elems;
+  float* ws_beta = ws_decay + qkv_elems;
+  int64_t* ws_base = reinterpret_cast<int64_t*>(ws_beta + beta_elems);
+  int32_t* ws_nfold = reinterpret_cast<int32_t*>(ws_beta + beta_elems + base_floats);
+  int* arrive_ptr =
+      reinterpret_cast<int*>(ws_beta + beta_elems + base_floats + nfold_floats);
+
+  k31_kda_spec_prep_records_d128_kernel<<<static_cast<int>(bh_total), 512, 0, stream>>>(
+      reinterpret_cast<const __nv_bfloat16*>(mixed_qkv.data_ptr()),
+      reinterpret_cast<__nv_bfloat16*>(conv_state.data_ptr()),
+      conv_weight.data_ptr(),
+      cb_ptr,
+      reinterpret_cast<const __nv_bfloat16*>(raw_g.data_ptr()),
+      reinterpret_cast<const __nv_bfloat16*>(raw_beta.data_ptr()),
+      A_log.data_ptr(),
+      dt_bias.data_ptr(),
+      recurrent_state.data_ptr<float>(),
+      state_mode.data_ptr<int32_t>(),
+      spec_state_indices.data_ptr(),
+      fsrc_ptr,
+      fc_ptr,
+      query_start_loc.data_ptr(),
+      num_accepted_tokens.data_ptr(),
+      mixed_qkv.stride(0),
+      stride_cs_slot,
+      stride_cs_c,
+      stride_cs_t,
+      conv_weight.stride(0),
+      raw_g.stride(0),
+      raw_beta.stride(0),
+      recurrent_state.stride(0),
+      spec_state_indices.stride(0),
+      stride_fsrc_n,
+      T,
+      num_blocks,
+      static_cast<int>(H),
+      static_cast<int>(S_cols),
+      static_cast<int>(F_cols),
+      static_cast<int>(conv_state_len),
+      conv_w_fp32,
+      conv_b_fp32,
+      a_log_fp32,
+      dt_bias_fp32,
+      ssi_i64,
+      fsrc_i64,
+      fc_i64,
+      qsl_i64,
+      acc_i64,
+      use_lower_bound,
+      static_cast<float>(lower_bound),
+      ws_q,
+      ws_k,
+      ws_v,
+      ws_decay,
+      ws_beta,
+      ws_base,
+      ws_nfold,
+      arrive_ptr);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+
+  k31_kda_spec_recur_norm_splitv_records_d128_kernel<kSplitV>
+      <<<static_cast<int>(bh_total * kSplitV), 128, 0, stream>>>(
+          ws_q,
+          ws_k,
+          ws_v,
+          ws_decay,
+          ws_beta,
+          ws_base,
+          ws_nfold,
+          reinterpret_cast<const __nv_bfloat16*>(g2.data_ptr()),
+          norm_weight.data_ptr(),
+          recurrent_state.data_ptr<float>(),
+          state_mode.data_ptr<int32_t>(),
+          spec_state_indices.data_ptr(),
+          fsrc_ptr,
+          query_start_loc.data_ptr(),
+          arrive_ptr,
+          g2.stride(0),
+          recurrent_state.stride(0),
+          spec_state_indices.stride(0),
+          stride_fsrc_n,
+          out.stride(0),
+          T,
+          num_blocks,
+          static_cast<int>(H),
+          static_cast<int>(S_cols),
+          norm_w_fp32,
+          ssi_i64,
+          fsrc_i64,
+          qsl_i64,
+          static_cast<float>(norm_eps),
+          reinterpret_cast<__nv_bfloat16*>(out.data_ptr()));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void kda_records_materialize(
+    at::Tensor recurrent_state,
+    at::Tensor state_mode,
+    const at::Tensor& spec_state_indices,
+    const at::Tensor& num_accepted_tokens) {
+  TORCH_CHECK(recurrent_state.is_cuda() && recurrent_state.scalar_type() == at::kFloat &&
+                  recurrent_state.dim() == 4,
+              "recurrent_state must be CUDA FP32 [cache, H, 128, 128]");
+  const int64_t num_blocks = recurrent_state.size(0);
+  const int64_t H = recurrent_state.size(1);
+  const int64_t D = recurrent_state.size(2);
+  TORCH_CHECK(D == 128 && recurrent_state.size(3) == 128,
+              "kda_records_materialize requires head_dim==128");
+  TORCH_CHECK(recurrent_state.stride(3) == 1 && recurrent_state.stride(2) == 128 &&
+                  recurrent_state.stride(1) == 128 * 128,
+              "recurrent_state must be contiguous within each slot");
+  TORCH_CHECK(is_aligned_16(recurrent_state.data_ptr()) && (recurrent_state.stride(0) % 4 == 0),
+              "recurrent_state must be 16-byte aligned with slot stride multiple of 4 floats");
+  TORCH_CHECK(state_mode.is_cuda() && state_mode.scalar_type() == at::kInt &&
+                  state_mode.dim() == 1 && state_mode.is_contiguous() &&
+                  state_mode.size(0) >= num_blocks,
+              "state_mode must be contiguous CUDA INT32 [>=num_blocks]");
+  TORCH_CHECK(spec_state_indices.is_cuda() && spec_state_indices.dim() == 2 &&
+                  spec_state_indices.size(1) >= 1 && spec_state_indices.stride(1) == 1 &&
+                  (spec_state_indices.scalar_type() == at::kInt ||
+                   spec_state_indices.scalar_type() == at::kLong),
+              "spec_state_indices must be CUDA INT32/INT64 [N, S_cols>=1] with stride(1)==1");
+
+  const int64_t N = spec_state_indices.size(0);
+  const int64_t S_cols = spec_state_indices.size(1);
+  if (N == 0) return;
+
+  TORCH_CHECK(num_accepted_tokens.is_cuda() && num_accepted_tokens.is_contiguous() &&
+                  num_accepted_tokens.dim() == 1 && num_accepted_tokens.size(0) >= N &&
+                  (num_accepted_tokens.scalar_type() == at::kInt ||
+                   num_accepted_tokens.scalar_type() == at::kLong),
+              "num_accepted_tokens must be contiguous CUDA INT32/INT64 [>=N]");
+
+  const c10::cuda::CUDAGuard device_guard(recurrent_state.device());
+  cudaStream_t stream = at::cuda::getCurrentCUDAStream();
+
+  const int64_t bh_total = N * H;
+  TORCH_CHECK(bh_total <= 2147483647LL, "N * H exceeds CUDA gridDim.x limit");
+  const bool ssi_i64 = (spec_state_indices.scalar_type() == at::kLong);
+  const bool acc_i64 = (num_accepted_tokens.scalar_type() == at::kLong);
+
+  k31_kda_records_materialize_d128_kernel<<<static_cast<int>(bh_total), 512, 0, stream>>>(
+      recurrent_state.data_ptr<float>(),
+      state_mode.data_ptr<int32_t>(),
+      spec_state_indices.data_ptr(),
+      num_accepted_tokens.data_ptr(),
+      recurrent_state.stride(0),
+      spec_state_indices.stride(0),
+      num_blocks,
+      static_cast<int>(H),
+      static_cast<int>(S_cols),
+      ssi_i64,
+      acc_i64);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+
+  const int reset_grid = static_cast<int>((N + 255) / 256);
+  k31_kda_reset_state_mode_kernel<<<reset_grid, 256, 0, stream>>>(
+      state_mode.data_ptr<int32_t>(),
+      spec_state_indices.data_ptr(),
+      num_accepted_tokens.data_ptr(),
+      spec_state_indices.stride(0),
+      N,
+      num_blocks,
+      static_cast<int>(S_cols),
+      ssi_i64,
+      acc_i64);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void moe_prune_topk(
+    const at::Tensor& topk_weights,
+    const at::Tensor& topk_ids,
+    int64_t max_topk,
+    double rel_thresh,
+    bool renormalize,
+    at::Tensor out_weights,
+    at::Tensor out_ids) {
+  TORCH_CHECK(topk_weights.is_cuda() && topk_weights.scalar_type() == at::kFloat &&
+                  topk_weights.dim() == 2 && topk_weights.is_contiguous(),
+              "topk_weights must be contiguous CUDA FP32 [rows, K]");
+  TORCH_CHECK(topk_ids.is_cuda() && topk_ids.dim() == 2 && topk_ids.is_contiguous() &&
+                  topk_ids.sizes() == topk_weights.sizes() &&
+                  (topk_ids.scalar_type() == at::kInt || topk_ids.scalar_type() == at::kLong),
+              "topk_ids must be contiguous CUDA INT32/INT64 matching topk_weights");
+  TORCH_CHECK(out_weights.is_cuda() && out_weights.scalar_type() == at::kFloat &&
+                  out_weights.sizes() == topk_weights.sizes() && out_weights.is_contiguous(),
+              "out_weights must be contiguous CUDA FP32 matching topk_weights");
+  TORCH_CHECK(out_ids.is_cuda() && out_ids.scalar_type() == topk_ids.scalar_type() &&
+                  out_ids.sizes() == topk_ids.sizes() && out_ids.is_contiguous(),
+              "out_ids must be contiguous CUDA matching topk_ids");
+
+  const int64_t rows = topk_weights.size(0);
+  const int64_t K = topk_weights.size(1);
+  if (rows == 0 || K == 0) return;
+  TORCH_CHECK(K >= 1 && K <= 32, "moe_prune_topk requires K in [1, 32]");
+
+  const c10::cuda::CUDAGuard device_guard(topk_weights.device());
+  cudaStream_t stream = at::cuda::getCurrentCUDAStream();
+
+  const int grid = static_cast<int>((rows + 7) / 8);
+  k31_moe_prune_topk_kernel<<<grid, 256, 0, stream>>>(
+      topk_weights.data_ptr<float>(),
+      topk_ids.data_ptr(),
+      out_weights.data_ptr<float>(),
+      out_ids.data_ptr(),
+      rows,
+      static_cast<int>(K),
+      static_cast<int>(max_topk),
+      static_cast<float>(rel_thresh),
+      renormalize,
+      topk_ids.scalar_type() == at::kLong);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+}  // namespace k31_glue
diff --git a/csrc/k31_glue/glue_k31.h b/csrc/k31_glue/glue_k31.h
new file mode 100644
index 0000000000..5199473f63
--- /dev/null
+++ b/csrc/k31_glue/glue_k31.h
@@ -0,0 +1,173 @@
+#pragma once
+
+#include <ATen/Tensor.h>
+#include <cstdint>
+#include <optional>
+
+namespace k31_glue {
+
+// Workspace size (in FP32 elements) for k31_fused_router_gemv_topk.
+// Header (32 floats = 128 B) holds the self-resetting arrival counter, followed by
+// L2 staging buffers for biased scores and sigmoid weights.
+int64_t router_workspace_size(int64_t max_rows, int64_t num_experts);
+
+// Fused Kimi-K3.1 AttnRes (prefix += delta (+ optional delta2), optional block write,
+// RMS-normalized softmax mix over 0..8 historical blocks + updated prefix, optional
+// final RMSNorm) in a single sm_80/sm_120 CUDA kernel.
+// Exact IEEE FP32 math, zero FP64, <= 48 KB SMEM, bitwise deterministic, CUDA-Graph safe.
+void attn_res_rmsnorm(
+    at::Tensor prefix,
+    const std::optional<at::Tensor>& delta,
+    const std::optional<at::Tensor>& delta2,
+    at::Tensor blocks,
+    const at::Tensor& norm_weight,
+    const at::Tensor& qk_weight,
+    const std::optional<at::Tensor>& output_norm_weight,
+    at::Tensor out,
+    int64_t num_blocks,
+    int64_t block_write_idx,
+    double eps,
+    double output_norm_eps);
+
+// Fused Kimi-K3.1 MoE router: BF16 [M, K] x [E, K]^T (fixed K-order FP32 accumulate)
+// + sigmoid + e_score_correction_bias + exact deterministic top-k + renorm + scale
+// in a single CUDA launch (no intermediate logits round-trip, no grouped_topk launch).
+// Workspace element 0 (arrival counter) is zeroed asynchronously on the current stream
+// before each launch (CUDA-Graph safe) and self-resets after each 16-row chunk.
+void fused_router_gemv_topk(
+    const at::Tensor& x,
+    const at::Tensor& w_gate,
+    const at::Tensor& bias,
+    int64_t top_k,
+    bool renormalize,
+    double routed_scaling_factor,
+    at::Tensor topk_weights,
+    at::Tensor topk_ids,
+    at::Tensor workspace);
+
+// Standalone multi-warp deterministic top-k for Kimi-K3.1 sigmoid+bias routing
+// (used for prefill M > 32 or standalone logits [M, E] FP32 -> topk_weights, topk_ids).
+void moe_topk_sigmoid(
+    const at::Tensor& logits,
+    const at::Tensor& bias,
+    int64_t top_k,
+    bool renormalize,
+    double routed_scaling_factor,
+    at::Tensor topk_weights,
+    at::Tensor topk_ids);
+
+// Bitwise-deterministic narrow-N BF16 GEMV (fixed K-order FP32 accumulate) writing
+// directly to two separate contiguous output tensors (eliminates split-K cuBLAS
+// row-count drift and torch.cat for KDA f_a+b [128+48/96, 7168] and MLA wkv_index [128+32, 7168]).
+void bf16_gemv_split2(
+    const at::Tensor& x,
+    const at::Tensor& w,
+    int64_t n0,
+    at::Tensor out0,
+    at::Tensor out1);
+
+// Fused SM80/SM120 KDA decode: 4-tap causal conv1d + SiLU + conv_state update +
+// Q/K L2-norm + KDA decay gate + delta-rule recurrent_state update + FusedRMSNormGated(sigmoid)
+// in 1 single CUDA launch (replaces 4 separate launches on SM80).
+void fused_kda_decode(
+    const at::Tensor& mixed_qkv,
+    at::Tensor conv_state,
+    const at::Tensor& conv_weight,
+    const std::optional<at::Tensor>& conv_bias,
+    const at::Tensor& raw_g,
+    const at::Tensor& raw_beta,
+    const at::Tensor& A_log,
+    const at::Tensor& dt_bias,
+    const at::Tensor& g2,
+    const at::Tensor& norm_weight,
+    at::Tensor recurrent_state,
+    const at::Tensor& state_indices,
+    double lower_bound,
+    double norm_eps,
+    at::Tensor out);
+
+// Fused SM80/SM120 speculative KDA verify: varlen 4-tap causal conv1d + SiLU +
+// sliding conv_state update + Q/K L2-norm + KDA decay gate + multi-step
+// register-resident delta-rule recurrence with per-step state checkpointing +
+// FusedRMSNormGated(sigmoid) in 1 single CUDA launch.
+void fused_kda_spec_verify(
+    const at::Tensor& mixed_qkv,
+    at::Tensor conv_state,
+    const at::Tensor& conv_weight,
+    const std::optional<at::Tensor>& conv_bias,
+    const at::Tensor& raw_g,
+    const at::Tensor& raw_beta,
+    const at::Tensor& A_log,
+    const at::Tensor& dt_bias,
+    const at::Tensor& g2,
+    const at::Tensor& norm_weight,
+    at::Tensor recurrent_state,
+    const at::Tensor& spec_state_indices,
+    const at::Tensor& query_start_loc,
+    const at::Tensor& num_accepted_tokens,
+    double lower_bound,
+    double norm_eps,
+    at::Tensor out);
+
+// Fused MLA q_a_layernorm(1536) + kv_a_layernorm(512) in 1 launch.
+void fused_q_kv_rmsnorm(
+    const at::Tensor& q_c,
+    const at::Tensor& kv_c,
+    const at::Tensor& q_weight,
+    const at::Tensor& kv_weight,
+    double q_eps,
+    double kv_eps,
+    at::Tensor q_out,
+    at::Tensor kv_out);
+
+// Fused MLA output gate: out = bf16(fp32(attn_out) * sigmoid(fp32(gate))) in 1 launch.
+void sigmoid_mul(
+    const at::Tensor& attn_out,
+    const at::Tensor& gate,
+    at::Tensor out);
+
+// Fused SM80/SM120 speculative KDA verify with single full-state base store + compact
+// 3-row (dv, k, dec) records for rows t >= 1, register-folded on the next step.
+void fused_kda_spec_verify_records(
+    const at::Tensor& mixed_qkv,
+    at::Tensor conv_state,
+    const at::Tensor& conv_weight,
+    const std::optional<at::Tensor>& conv_bias,
+    const at::Tensor& raw_g,
+    const at::Tensor& raw_beta,
+    const at::Tensor& A_log,
+    const at::Tensor& dt_bias,
+    const at::Tensor& g2,
+    const at::Tensor& norm_weight,
+    at::Tensor recurrent_state,
+    const at::Tensor& spec_state_indices,
+    const at::Tensor& query_start_loc,
+    const at::Tensor& num_accepted_tokens,
+    double lower_bound,
+    double norm_eps,
+    at::Tensor out,
+    at::Tensor state_mode,
+    const std::optional<at::Tensor>& fold_src_indices,
+    const std::optional<at::Tensor>& fold_counts);
+
+// Materialize compact KDA verify records into full state at spec_state_indices[i, acc - 1]
+// for sequences in records mode (state_mode[ssi[i, 0]] == 1) and reset mode to 0.
+void kda_records_materialize(
+    at::Tensor recurrent_state,
+    at::Tensor state_mode,
+    const at::Tensor& spec_state_indices,
+    const at::Tensor& num_accepted_tokens);
+
+// CUDA-Graph-safe single-launch adaptive MoE tail-expert pruning: keeps top max_topk
+// experts and drops tail experts below rel_thresh * row_max_w (keeping >= 4 valid),
+// renormalizing kept weights by orig_sum / kept_sum and writing -1 to dropped topk_ids.
+void moe_prune_topk(
+    const at::Tensor& topk_weights,
+    const at::Tensor& topk_ids,
+    int64_t max_topk,
+    double rel_thresh,
+    bool renormalize,
+    at::Tensor out_weights,
+    at::Tensor out_ids);
+
+}  // namespace k31_glue
