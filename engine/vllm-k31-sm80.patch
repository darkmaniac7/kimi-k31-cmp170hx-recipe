+    torch.testing.assert_close(yb[0], x.float() @ fb.t(), rtol=2e-3, atol=2e-3)
+
+    # and re-running the first one still gives the first answer
+    ya2, _ = hc_prenorm_gemm(x, fa)
+    torch.cuda.synchronize()
