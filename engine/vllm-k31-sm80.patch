+def test_k31_fp32_head_env_switch_and_bf16_tiebreak_resolution(monkeypatch):
+    """Verify VLLM_K31_FP32_HEAD=1 upgrades target KimiK3 Exl3HeadLogitsProcessor
+    to float32 while leaving DSpark (qwen3_dspark) in bfloat16, and prevents
+    BF16 rounding at logit ~20.0 (ULP=0.125) from collapsing 'Q' (id=48) into
+    a tie won by lower token ID 'I' (id=40)."""
+    monkeypatch.setenv("VLLM_K31_FP32_HEAD", "1")
