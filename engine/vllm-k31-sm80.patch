+#!/usr/bin/env bash
+# Fast out-of-tree build of llama-k31-dump against an existing llama.cpp build.
+# Zero edits to llama.cpp core and zero rebuild of libggml-cuda.so.
+#
+# Usage:
+#   ./build.sh [LLAMA_CPP_DIR] [LLAMA_CPP_BUILD_DIR] [OUT_BIN]
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+LLAMA_CPP_DIR="${1:-${LLAMA_CPP_DIR:-/opt/llama.cpp}}"
+LLAMA_CPP_BUILD_DIR="${2:-${LLAMA_CPP_BUILD_DIR:-${LLAMA_CPP_DIR}/build-cuda}}"
+OUT_BIN="${3:-${OUT_BIN:-${SCRIPT_DIR}/llama-k31-dump}}"
+CXX_BIN="${CXX:-c++}"
+
+LIB_DIR="${LLAMA_CPP_BUILD_DIR}/bin"
+if [[ ! -d "${LIB_DIR}" ]]; then
+    echo "ERROR: llama.cpp built shared libraries not found at ${LIB_DIR}" >&2
+    exit 1
+fi
+for hdr in "${LLAMA_CPP_DIR}/include/llama.h" "${LLAMA_CPP_DIR}/ggml/include/ggml.h" "${LLAMA_CPP_DIR}/common/common.h"; do
+    if [[ ! -f "${hdr}" ]]; then
+        echo "ERROR: missing required header: ${hdr}" >&2
+        exit 1
+    fi
+done
+
+mkdir -p "$(dirname "${OUT_BIN}")"
+
+"${CXX_BIN}" -std=c++17 -O3 -DNDEBUG -Wall -Wextra \
+    -DGGML_SHARED -DGGML_BACKEND_SHARED -DLLAMA_SHARED \
+    -I"${LLAMA_CPP_DIR}/include" \
+    -I"${LLAMA_CPP_DIR}/ggml/include" \
+    -I"${LLAMA_CPP_DIR}/common" \
+    "${SCRIPT_DIR}/llama-k31-dump.cpp" \
+    -L"${LIB_DIR}" \
+    -Wl,-rpath,"${LIB_DIR}" \
+    -Wl,--allow-shlib-undefined \
+    -lllama-common -lllama -lggml -lggml-base -lpthread \
+    -o "${OUT_BIN}"
+
+echo "Built ${OUT_BIN} against ${LLAMA_CPP_DIR} (${LIB_DIR})"
