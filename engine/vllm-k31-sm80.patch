+        for index, (scenario, rows, scale) in enumerate(SCENARIOS)
+    ]
+    mean, worst = _pool_rule(synthetic, cases, f"bits_x2={synthetic.bits_x2}").check()
+    record_property("mean_ratio", mean)
+    record_property("max_ratio", worst)
