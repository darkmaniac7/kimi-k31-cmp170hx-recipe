+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU and CUDA tests for VLLM_K31_GLUE_KDA_RECORDS (_k31_glue_C api_version 3).
+
+Covers:
+  1. Switch defaults (VLLM_K31_GLUE_KDA_RECORDS=0), independence from
+     VLLM_K31_GLUE_ALL, and graceful fallback to fused_kda_spec_verify when
+     _k31_glue_C has api_version < 3.
+  2. FakeTensorMode tracing for fused_kda_spec_verify_records and
+     kda_records_materialize.
+  3. KimiK3DeltaAttention state_mode allocation on bind_kv_cache, reset to 0 on
+     has_initial_state == False (new request / reused block), and
+     kda_records_materialize dispatch before Triton mixed-batch fallback.
+  4. CPU reference simulation of PipeSpec VLLM_K31_PIPESPEC_BANK_FLIP=1 +
+     VLLM_K31_GLUE_KDA_RECORDS=1 over random Chunk A / Chunk B accept & reject
+     programs (bitwise identical to full-state sequential verification).
+  5. GPU silicon invariants on sm_80 / sm_120:
+     - Invariant 1: bitwise exact row-0 base store vs legacy fused_kda_spec_verify.
+     - Invariant 2: bitwise exact step T -> T+1 outputs and base block across
+       every acc in 1..M (both conv_state layouts, int32/int64 indices).
+     - Invariant 3: bitwise exact mode transitions
+       legacy -> records -> materialize -> legacy -> records.
+     - Invariant 4: B=4, H=48 (1,536 recurrence CTAs, multi-wave) bitwise exactness.
+     - PipeSpec BANK_FLIP=1 Chunk A -> Chunk B accept and reject bitwise exactness.
+     - CUDA Graph capture and replay bitwise exactness.
+"""
+
+from __future__ import annotations
+
+import os
+import random
+from types import SimpleNamespace
+
+import pytest
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+from torch._subclasses.fake_tensor import FakeTensorMode
+
+from vllm import envs
+from vllm.sm80.kernels.k31q import glue, glue_ops
+from vllm.v1.cmp_pipespec import KDAPipeSpecSlotFlip
+
+
+def _clear_env(monkeypatch) -> None:
+    for var in (
+        "VLLM_K31_GLUE_ALL",
+        "VLLM_K31_GLUE_KDA",
+        "VLLM_K31_GLUE_KDA_SPEC",
+        "VLLM_K31_GLUE_KDA_RECORDS",
+    ):
+        monkeypatch.delenv(var, raising=False)
+        if var in vars(envs):
+            monkeypatch.delattr(envs, var, raising=False)
+    glue._reset_state()
+
+
+def _make_kda_stub(H: int = 2, D: int = 128):
+    from vllm.models.kimi_k3.nvidia.kda import KimiK3DeltaAttention
+
+    attn = KimiK3DeltaAttention.__new__(KimiK3DeltaAttention)
+    nn.Module.__init__(attn)
+    attn.prefix = "model.layers.0.self_attn"
+    attn.head_dim = D
+    attn.local_num_heads = H
+    attn.local_projection_size = H * D
+    attn.conv_size = 4
+    attn.use_recoverssm = False
+    attn.kda_decode_backend = "triton"
+    attn.kda_spec_decode_backend = "triton"
+    attn.kda_prefill_backend = "triton"
+    attn.gate_lower_bound = -5.0
+    attn.decode_conv1d_weight = None
+    attn.decode_norm_weight = None
+    attn.state_mode = None
+    attn._state_mode_dirty = False
+    attn._triton_checkpoint_spec = None
+    attn._checkpoint_exporter = None
+
+    C = 3 * H * D
+    conv = nn.Module()
+    conv.weight = nn.Parameter(torch.randn((C, 1, 4), dtype=torch.float32) * 0.1)
+    conv.bias = None
+    attn.conv1d = conv
+    attn.A_log = nn.Parameter(torch.randn((H,), dtype=torch.float32) * 0.1)
+    attn.dt_bias = nn.Parameter(torch.randn((H * D,), dtype=torch.float32) * 0.1)
+
+    o_norm = nn.Module()
+    o_norm.weight = nn.Parameter(torch.ones((D,), dtype=torch.float32))
+    o_norm.eps = 1e-6
+    o_norm.activation = "sigmoid"
+    o_norm.forward = lambda x, g: x
+    attn.o_norm = o_norm
+    return attn
+
+
+# ---------------------------------------------------------------------------
+# Reference CPU KDA full-state & records step (IEEE FP32 matching glue_k31.cu)
+# ---------------------------------------------------------------------------
+
+
+def _ref_kda_prep_row(
+    x_bf16: torch.Tensor,
+    h0: torch.Tensor,
+    h1: torch.Tensor,
+    h2: torch.Tensor,
+    cw: torch.Tensor,
+    cb: torch.Tensor | None,
+    raw_g_bf16: torch.Tensor,
+    raw_beta_bf16: torch.Tensor,
+    A_log: torch.Tensor,
+    dt_bias: torch.Tensor,
+    lower_bound: float,
+    H: int,
+    D: int,
+):
+    xt = x_bf16.float()
+    acc = h0 * cw[:, 0] + (0.0 if cb is None else cb.float())
+    acc = h1 * cw[:, 1] + acc
+    acc = h2 * cw[:, 2] + acc
+    acc = xt * cw[:, 3] + acc
+    silu = acc / (1.0 + torch.exp(-acc))
+    val = silu.to(torch.bfloat16).float()
+    q_raw, k_raw, v = val.view(3, H, D).unbind(0)
+    q = (q_raw / torch.sqrt((q_raw * q_raw).sum(dim=-1, keepdim=True) + 1e-6)) * (
+        D**-0.5
+    )
+    k = k_raw / torch.sqrt((k_raw * k_raw).sum(dim=-1, keepdim=True) + 1e-6)
+
+    g_plus = raw_g_bf16.float() + dt_bias.float().view(H, D)
+    a_val = torch.exp(A_log.float()).view(H, 1)
+    if lower_bound < 0.0:
+        log_dec = lower_bound * torch.sigmoid(a_val * g_plus)
+    else:
+        log_dec = -a_val * F.softplus(g_plus)
+    dec = torch.exp(log_dec)
+    beta = torch.sigmoid(raw_beta_bf16.float())
+    return xt, q, k, v, dec, beta
+
+
+def ref_kda_spec_verify_legacy_cpu(
+    mixed_qkv: torch.Tensor,
+    conv_state: torch.Tensor,
+    conv_weight: torch.Tensor,
+    conv_bias: torch.Tensor | None,
+    raw_g: torch.Tensor,
+    raw_beta: torch.Tensor,
+    A_log: torch.Tensor,
+    dt_bias: torch.Tensor,
+    g2: torch.Tensor,
+    norm_weight: torch.Tensor,
+    recurrent_state: torch.Tensor,
+    spec_state_indices: torch.Tensor,
+    query_start_loc: torch.Tensor,
+    num_accepted_tokens: torch.Tensor,
+    lower_bound: float,
+    norm_eps: float,
+    out: torch.Tensor,
+    *,
+    dim_first: bool = True,
+) -> None:
+    N = query_start_loc.numel() - 1
+    _, H, D, _ = recurrent_state.shape
+    S_cols = spec_state_indices.size(1)
+    cs_len = conv_state.size(2) if dim_first else conv_state.size(1)
+    cw = conv_weight.float()
+    nw = norm_weight.float()
+
+    for i_n in range(N):
+        bos = int(query_start_loc[i_n])
+        eos = int(query_start_loc[i_n + 1])
+        q_len = eos - bos
+        if q_len <= 0:
+            continue
+        conv_slot = int(spec_state_indices[i_n, 0])
+        init_tok = int(num_accepted_tokens[i_n]) - 1
+        init_slot = (
+            int(spec_state_indices[i_n, init_tok]) if 0 <= init_tok < S_cols else 0
+        )
+        if conv_slot <= 0 or init_slot <= 0:
+            out[bos:eos].zero_()
+            continue
+        line = conv_state[conv_slot] if dim_first else conv_state[conv_slot].T
+        bh0 = line[:, init_tok + 0].clone()
+        bh1 = line[:, init_tok + 1].clone()
+        bh2 = line[:, init_tok + 2].clone()
+        line[:, 0] = bh1
+        line[:, 1] = bh2
+        h0, h1, h2 = bh0.float(), bh1.float(), bh2.float()
+
+        st = recurrent_state[init_slot].clone()
+        for t in range(q_len):
+            tok = bos + t
+            if 2 + t < cs_len:
+                line[:, 2 + t] = mixed_qkv[tok]
+            xt, q, k, v, dec, beta = _ref_kda_prep_row(
+                mixed_qkv[tok],
+                h0,
+                h1,
+                h2,
+                cw,
+                conv_bias,
+                raw_g[tok],
+                raw_beta[tok],
+                A_log,
+                dt_bias,
+                lower_bound,
+                H,
+                D,
+            )
+            h0, h1, h2 = h1, h2, xt
+            st = st * dec.unsqueeze(1)
+            kv_pred = (st * k.unsqueeze(1)).sum(dim=-1)
+            dv = (v - kv_pred) * beta.unsqueeze(1)
+            st = st + dv.unsqueeze(2) * k.unsqueeze(1)
+            out_slot = int(spec_state_indices[i_n, t]) if t < S_cols else 0
+            if out_slot > 0:
+                recurrent_state[out_slot].copy_(st)
+            o_bf16 = (st * q.unsqueeze(1)).sum(dim=-1).to(torch.bfloat16)
+            ov = o_bf16.float()
+            inv_rms = torch.rsqrt((ov * ov).mean(dim=-1, keepdim=True) + norm_eps)
+            y = ov * inv_rms * nw.unsqueeze(0) * torch.sigmoid(g2[tok].float())
+            out[tok].copy_(y.to(torch.bfloat16))
+
+
+def ref_kda_spec_verify_records_cpu(
+    mixed_qkv: torch.Tensor,
+    conv_state: torch.Tensor,
+    conv_weight: torch.Tensor,
+    conv_bias: torch.Tensor | None,
+    raw_g: torch.Tensor,
+    raw_beta: torch.Tensor,
+    A_log: torch.Tensor,
+    dt_bias: torch.Tensor,
+    g2: torch.Tensor,
+    norm_weight: torch.Tensor,
+    recurrent_state: torch.Tensor,
+    spec_state_indices: torch.Tensor,
+    query_start_loc: torch.Tensor,
+    num_accepted_tokens: torch.Tensor,
+    lower_bound: float,
+    norm_eps: float,
+    out: torch.Tensor,
+    state_mode: torch.Tensor,
+    fold_src_indices: torch.Tensor | None = None,
+    fold_counts: torch.Tensor | None = None,
+    *,
+    dim_first: bool = True,
+) -> None:
+    N = query_start_loc.numel() - 1
+    _, H, D, _ = recurrent_state.shape
+    S_cols = spec_state_indices.size(1)
+    fsrc = spec_state_indices if fold_src_indices is None else fold_src_indices
+    cs_len = conv_state.size(2) if dim_first else conv_state.size(1)
+    cw = conv_weight.float()
+    nw = norm_weight.float()
+
+    # Stage 1: read state_mode strictly before mutating any state_mode words.
+    ws_base = [0] * N
+    ws_nfold = [0] * N
+    modes = [0] * N
+    for i_n in range(N):
+        fsrc_base = int(fsrc[i_n, 0])
+        modes[i_n] = int(state_mode[fsrc_base]) if fsrc_base > 0 else 0
+
+    for i_n in range(N):
+        bos = int(query_start_loc[i_n])
+        eos = int(query_start_loc[i_n + 1])
+        q_len = eos - bos
+        if q_len <= 0:
+            continue
+        conv_slot = int(spec_state_indices[i_n, 0])
+        init_tok = int(num_accepted_tokens[i_n]) - 1
+        fsrc_base = int(fsrc[i_n, 0])
+        nfold = int(fold_counts[i_n]) if fold_counts is not None else init_tok
+        if conv_slot <= 0 or fsrc_base <= 0:
+            out[bos:eos].zero_()
+            continue
+        if modes[i_n] == 0:
+            start_blk = int(fsrc[i_n, nfold])
+            if start_blk <= 0:
+                out[bos:eos].zero_()
+                continue
+            if start_blk != conv_slot:
+                recurrent_state[conv_slot].copy_(recurrent_state[start_blk])
+            ws_base[i_n] = conv_slot
+            ws_nfold[i_n] = 0
+        else:
+            ws_base[i_n] = fsrc_base
+            ws_nfold[i_n] = nfold
+
+    # Stage 2: fold + token recurrence + write records + set state_mode=1.
+    for i_n in range(N):
+        bos = int(query_start_loc[i_n])
+        eos = int(query_start_loc[i_n + 1])
+        q_len = eos - bos
+        if q_len <= 0 or ws_base[i_n] <= 0:
+            continue
+        conv_slot = int(spec_state_indices[i_n, 0])
+        init_tok = int(num_accepted_tokens[i_n]) - 1
+        state_mode[conv_slot] = 1
+
+        line = conv_state[conv_slot] if dim_first else conv_state[conv_slot].T
+        bh0 = line[:, init_tok + 0].clone()
+        bh1 = line[:, init_tok + 1].clone()
+        bh2 = line[:, init_tok + 2].clone()
+        line[:, 0] = bh1
+        line[:, 1] = bh2
+        h0, h1, h2 = bh0.float(), bh1.float(), bh2.float()
+
+        st = recurrent_state[ws_base[i_n]].clone()
+        for j in range(1, ws_nfold[i_n] + 1):
+            rec_slot = int(fsrc[i_n, j])
+            rec = recurrent_state[rec_slot]
+            dv_j = rec[:, 0, :]
+            k_j = rec[:, 1, :]
+            dec_j = rec[:, 2, :]
+            st = st * dec_j.unsqueeze(1) + dv_j.unsqueeze(2) * k_j.unsqueeze(1)
+
+        new_records: list[tuple[int, torch.Tensor, torch.Tensor, torch.Tensor]] = []
+        for t in range(q_len):
+            tok = bos + t
+            if 2 + t < cs_len:
+                line[:, 2 + t] = mixed_qkv[tok]
+            xt, q, k, v, dec, beta = _ref_kda_prep_row(
+                mixed_qkv[tok],
+                h0,
+                h1,
+                h2,
+                cw,
+                conv_bias,
+                raw_g[tok],
+                raw_beta[tok],
+                A_log,
+                dt_bias,
+                lower_bound,
+                H,
+                D,
+            )
+            h0, h1, h2 = h1, h2, xt
+            st = st * dec.unsqueeze(1)
+            kv_pred = (st * k.unsqueeze(1)).sum(dim=-1)
+            dv = (v - kv_pred) * beta.unsqueeze(1)
+            st = st + dv.unsqueeze(2) * k.unsqueeze(1)
+            out_slot = int(spec_state_indices[i_n, t]) if t < S_cols else 0
+            if out_slot > 0:
+                if t == 0:
+                    recurrent_state[out_slot].copy_(st)
+                else:
+                    new_records.append((out_slot, dv.clone(), k.clone(), dec.clone()))
+            o_bf16 = (st * q.unsqueeze(1)).sum(dim=-1).to(torch.bfloat16)
+            ov = o_bf16.float()
+            inv_rms = torch.rsqrt((ov * ov).mean(dim=-1, keepdim=True) + norm_eps)
+            y = ov * inv_rms * nw.unsqueeze(0) * torch.sigmoid(g2[tok].float())
+            out[tok].copy_(y.to(torch.bfloat16))
+
+        for out_slot, dv_rec, k_rec, dec_rec in new_records:
+            recurrent_state[out_slot, :, 0, :].copy_(dv_rec)
+            recurrent_state[out_slot, :, 1, :].copy_(k_rec)
+            recurrent_state[out_slot, :, 2, :].copy_(dec_rec)
+
+
+def ref_kda_records_materialize_cpu(
+    recurrent_state: torch.Tensor,
+    state_mode: torch.Tensor,
+    spec_state_indices: torch.Tensor,
+    num_accepted_tokens: torch.Tensor,
+) -> None:
+    N = spec_state_indices.size(0)
+    for i_n in range(N):
+        base_slot = int(spec_state_indices[i_n, 0])
+        nfold = int(num_accepted_tokens[i_n]) - 1
+        if base_slot <= 0 or nfold < 0:
+            continue
+        dst_slot = int(spec_state_indices[i_n, nfold])
+        if dst_slot <= 0:
+            continue
+        if int(state_mode[base_slot]) != 0:
+            if not (nfold == 0 and dst_slot == base_slot):
+                st = recurrent_state[base_slot].clone()
+                for j in range(1, nfold + 1):
+                    rec = recurrent_state[int(spec_state_indices[i_n, j])]
+                    st = st * rec[:, 2, :].unsqueeze(1) + rec[:, 0, :].unsqueeze(
+                        2
+                    ) * rec[:, 1, :].unsqueeze(1)
+                recurrent_state[dst_slot].copy_(st)
+            state_mode[base_slot] = 0
+
+
+# ---------------------------------------------------------------------------
+# 1. CPU Plumbing, Fallback, FakeTensor, and PipeSpec BANK_FLIP Simulation
+# ---------------------------------------------------------------------------
+
+
+def test_kda_records_switch_defaults_off_and_independent_of_glue_all(monkeypatch):
+    _clear_env(monkeypatch)
+    assert glue.kda_records_enabled() is False
+
+    monkeypatch.setenv("VLLM_K31_GLUE_ALL", "1")
+    assert glue.kda_records_enabled() is False
+
+    monkeypatch.setenv("VLLM_K31_GLUE_KDA_RECORDS", "1")
+    assert glue.kda_records_enabled() is True
+
+    monkeypatch.setenv("VLLM_K31_GLUE_KDA_RECORDS", "0")
+    assert glue.kda_records_enabled() is False
+
+    monkeypatch.setattr(envs, "VLLM_K31_GLUE_KDA_RECORDS", True, raising=False)
+    assert glue.kda_records_enabled() is True
+
+
+def test_kda_records_graceful_fallback_to_v2_spec_verify(monkeypatch):
+    """When _k31_glue_C has api_version=2 (no fused_kda_spec_verify_records),
+    VLLM_K31_GLUE_KDA_RECORDS=1 logs once and falls back to fused_kda_spec_verify."""
+    from vllm.models.kimi_k3.nvidia import kda as kda_mod
+    from vllm.models.kimi_k3.nvidia.kda_metadata import KimiK3KDAMetadata
+
+    _clear_env(monkeypatch)
+    v2_calls: list[dict] = []
+
+    class V2StandIn:
+        @staticmethod
+        def build_info():
+            return {"abi_version": 1, "api_version": 2}
+
+        @staticmethod
+        def fused_kda_spec_verify(
+            mixed_qkv,
+            conv_state,
+            conv_weight,
+            conv_bias,
+            raw_g,
+            raw_beta,
+            A_log,
+            dt_bias,
+            g2,
+            norm_weight,
+            recurrent_state,
+            spec_state_indices,
+            query_start_loc,
+            num_accepted_tokens,
+            lower_bound,
+            norm_eps,
+            out,
+        ):
+            v2_calls.append({"T": mixed_qkv.size(0)})
+            out.fill_(1.25)
+
+    standin = V2StandIn()
+    monkeypatch.setattr(glue, "load_glue_native", lambda: standin)
+    monkeypatch.setenv("VLLM_K31_GLUE_KDA_RECORDS", "1")
+    monkeypatch.setattr(kda_mod, "is_conv_state_dim_first", lambda: True)
+
+    H, D, M = 2, 128, 4
+    attn = _make_kda_stub(H=H, D=D)
+    attn.kv_cache = (
+        torch.zeros((16, 3 * H * D, 10), dtype=torch.bfloat16),
+        torch.zeros((16, H, D, D), dtype=torch.float32),
+    )
+    meta = KimiK3KDAMetadata(
+        num_prefills=0,
+        num_prefill_tokens=0,
+        num_decodes=0,
+        num_decode_tokens=0,
+        num_spec_decodes=1,
+        num_spec_decode_tokens=M,
+        num_actual_tokens=M,
+        spec_state_indices_tensor=torch.tensor([[1, 2, 3, 4]], dtype=torch.int32),
+        spec_query_start_loc=torch.tensor([0, M], dtype=torch.int32),
+        num_accepted_tokens=torch.tensor([1], dtype=torch.int32),
+    )
+    monkeypatch.setattr(
+        kda_mod,
+        "get_forward_context",
+        lambda: SimpleNamespace(attn_metadata={attn.prefix: meta}),
+    )
+    out = torch.empty((1, M, H, D), dtype=torch.bfloat16)
+    attn._forward(
+        torch.randn((M, 3 * H * D), dtype=torch.bfloat16),
+        torch.randn((1, M, H, D), dtype=torch.bfloat16),
+        torch.randn((M, H, D), dtype=torch.bfloat16),
+        torch.randn((1, M, H), dtype=torch.bfloat16),
+        out,
+    )
+    assert len(v2_calls) == 1
+    assert v2_calls[0]["T"] == M
+    assert torch.all(out == 1.25)
+
+
+def test_kda_records_custom_ops_faketensor_tracing():
+    H, D, T, C = 2, 128, 5, 3 * 2 * 128
+    with FakeTensorMode():
+        mixed_qkv = torch.empty((T, C), dtype=torch.bfloat16)
+        conv_state = torch.empty((16, C, 10), dtype=torch.bfloat16)
+        conv_weight = torch.empty((C, 4), dtype=torch.float32)
+        raw_g = torch.empty((T, H, D), dtype=torch.bfloat16)
+        raw_beta = torch.empty((T, H), dtype=torch.bfloat16)
+        A_log = torch.empty((H,), dtype=torch.float32)
+        dt_bias = torch.empty((H * D,), dtype=torch.float32)
+        g2 = torch.empty((T, H, D), dtype=torch.bfloat16)
+        norm_weight = torch.empty((D,), dtype=torch.float32)
+        recurrent_state = torch.empty((16, H, D, D), dtype=torch.float32)
