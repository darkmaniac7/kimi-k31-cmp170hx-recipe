+LAYOUTS = {
+    "tp1": 'schema = "launch-layout/1"\nname = "tp1"\ntp = 1\npp = 1\ncards = 1\ncard_ids = "0"\n'
+           '[args]\nmax-num-batched-tokens = { value = 2048, why = "One prefill chunk." }\n',
+    "tp2": 'schema = "launch-layout/1"\nname = "tp2"\ntp = 2\npp = 1\ncards = 2\ncard_ids = "0,1"\n'
+           '[args]\nmax-num-batched-tokens = { value = 4096, why = "Two prefill chunks." }\n'
