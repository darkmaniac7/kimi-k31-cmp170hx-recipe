+        if not x.is_cuda:
+            return self.forward_native(x, residual)
+        return orig_forward(self, x, residual)
+
+    monkeypatch.setattr(RMSNorm, "forward", _cpu_safe_forward)
+
+
+def _build_tp_model(monkeypatch, checkpoint, dense_ops, tp_size, tp_rank):
+    model, config, _, _ = construct.build_and_load(
+        monkeypatch, checkpoint, tp_size=tp_size, tp_rank=tp_rank
+    )
+    _cpu_post_load(monkeypatch)
+    dense_ops.name(model)
+    for module in model.modules():
+        method = getattr(module, "quant_method", None)
+        if hasattr(method, "k31_dense_state"):
+            method.process_weights_after_loading(module)
+    return model, config
+
+
+def _run_pair_init(
+    ops: fake_p2p.FakeP2POps,
+    pp_rank: int = 0,
+    ranks: tuple[int, int] = (0, 1),
+    max_rows: int | None = None,
+    force_shm: bool | None = None,
+    timeout_ms: int | None = None,
+):
+    from vllm.sm80.kernels.k31q.p2p import K31P2PCommunicator
+
+    group = fake_p2p.FakeTP2Group(ranks=ranks)
+    comms = [
+        K31P2PCommunicator(
+            tp_group=group.view(r, device_index=r),
+            pp_rank=pp_rank,
+            max_rows=max_rows,
+            force_shm=force_shm,
+            timeout_ms=timeout_ms,
+            start_watchdog=False,
+            require_cuda_tensors=False,
+        )
+        for r in (0, 1)
+    ]
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        futs = [pool.submit(c.initialize) for c in comms]
+        results = [f.result(timeout=10) for f in futs]
+    return comms[0], comms[1], results
+
