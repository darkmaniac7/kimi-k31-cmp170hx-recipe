+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Loading of the K3.1 sibling CUDA extensions.
+
+``vllm/_k31_vq_C`` (csrc/k31_vq: the VQ routed-expert ops) and
+``vllm/_k31_dense_C`` (csrc/k31_dense: the fused EXL3 dense ops) are libraries
+of their own beside ``vllm/_exl3_C``, whose kernels they leave untouched. Each
+is a Python extension module that registers its operators through
+TORCH_LIBRARY when it is imported and reports how it was built.
+:func:`load` imports one and applies the checks
+vllm/sm80/kernels/exl3/ops.py applies to ``_exl3_C``: a library built against
+another PyTorch, CUDA major or C++ ABI, or with another interface version, is
+refused, and so is one that lacks an operator this tree calls. Both packages
+also report an ``api_version`` (release 2 of the kernel owner's packages is
+version 2: the same operator signatures, new kernels and, for the VQ ops, a
+new packed layout that ``vq_pack`` produces); a library that reports none or
+an older one than the tree asks for is refused too, so a stale build of
+release 1 cannot serve with this tree. A library that is absent or refused
+stops with the command that builds it.
+"""
+
+import importlib
+
+import torch
+
+
+def runtime_build_info(abi_version: int) -> dict:
+    """What a library's ``build_info()`` must say to serve this process."""
+    cuda = torch.version.cuda
+    major, minor = (int(v) for v in cuda.split(".")[:2]) if cuda else (0, 0)
+    return {
+        "abi_version": abi_version,
+        "torch_version": torch.__version__.split("+")[0],
+        "cuda_version": major * 1000 + minor * 10,
+        "cxx11_abi": int(torch._C._GLIBCXX_USE_CXX11_ABI),
+    }
+
+
+def validate(
+    module, namespace: str, abi_version: int, operators, api_version: int | None = None
+) -> None:
+    built = module.build_info()
+    if api_version is not None:
+        actual = built.get("api_version")
+        if not isinstance(actual, int) or actual < api_version:
+            raise ValueError(
+                f"api_version mismatch: extension {actual!r}, this tree needs "
+                f"{api_version} or newer (an older release of the package)"
+            )
+    for key, expected in runtime_build_info(abi_version).items():
+        actual = built.get(key)
+        # CUDA minor toolkits within one major share the runtime ABI.
+        if key == "cuda_version" and isinstance(actual, int):
+            actual, expected = actual // 1000, expected // 1000
+        if actual != expected:
+            raise ValueError(
+                f"{key} mismatch: extension {built.get(key)!r}, runtime {expected!r}"
+            )
+    for name in operators:
+        torch._C._dispatch_find_schema_or_throw(f"{namespace}::{name}", "")
+
+
+def load(
+    namespace: str,
+    abi_version: int,
+    operators,
+    build_command: str,
+    api_version: int | None = None,
+):
+    """Import ``vllm.<namespace>`` and check it; return the module.
+    ``api_version``: the oldest interface release the tree accepts (None:
+    the library need not report one)."""
+    try:
+        module = importlib.import_module(f"vllm.{namespace}")
+        validate(module, namespace, abi_version, operators, api_version)
+    except (ImportError, OSError, AttributeError, RuntimeError, ValueError) as exc:
+        raise RuntimeError(
+            f"The Kimi K3.1 kernels need the compiled vllm.{namespace} extension, "
+            f"built for the running PyTorch: build it with {build_command} (in "
+            f"the vLLM source tree). Detail: {exc}"
+        ) from exc
+    return module
