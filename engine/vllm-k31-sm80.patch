+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The native VQ path of the routed experts on the CPU, with a recording
+stand-in for the ops module (tests/models/kimi_k3/sm80/fake_vq.py).
+
+What the engine side must get right without a kernel in the room:
+  * in native mode no canonical record is a parameter or a buffer, anywhere;
+  * loading moves one projection's records to the device, packs them and
+    drops them before the next, so the device peak is one projection's
+    records beside what is already packed (the stand-in counts every device
+    copy and every packed tensor while it is alive);
+  * ``packed_ptrs`` [experts, 9] and ``packed_meta`` [experts, 12] are the
+    documented layout: the bytes behind each pointer are those of the right
+    expert, projection and I-block range of the checkpoint file;
+  * one device copy of each codebook per process;
+  * launches: the decode op up to 64 rows, the prefill op above, row chunks
+    above 2,048 or VLLM_K31Q_MOE_CHUNK_ROWS, the layer's static rate ids, a
+    workspace sized once, no host read of a tensor value in the forward;
+  * a build without the library stops at construction with the build command.
+The kernels themselves run in test_k31q_vq_native_gpu.py.
+"""
+
+import importlib.util
+import re
+import sys
+import types
+from itertools import chain
+from pathlib import Path
+
+import numpy as np
+import pytest
+import torch
+
+from tests.models.kimi_k3.sm80 import construct
+from tests.models.kimi_k3.sm80 import k31q_fixture as fixture
+from tests.models.kimi_k3.sm80.fake_vq import (
+    RATE_IDS,
+    FakeVqOps,
+    fingerprint,
+    words_per_lane,
+)
+
+TEXT = fixture.TEXT
+EXPERTS, TOPK = TEXT["num_experts"], TEXT["num_experts_per_token"]
+LATENT, INTER = TEXT["routed_expert_hidden_size"], TEXT["moe_intermediate_size"]
+LAYERS = TEXT["num_hidden_layers"]
+EXL3_LAYER = fixture.EXL3_EXPERT_LAYERS[0]
+VQ_LAYERS = [n for n in range(1, LAYERS) if n != EXL3_LAYER]
+BETA, LINEAR_BETA = 4.0, 25.0
+REPO = Path(__file__).parents[4]
+
+
+@pytest.fixture(scope="module")
+def checkpoint(tmp_path_factory):
+    directory = tmp_path_factory.mktemp("k31q")
+    fixture.write_checkpoint(directory)
+    return directory
+
+
+def _routed(model, layer):
+    return model.model.layers[layer].block_sparse_moe.experts.routed_experts
+
+
+def _base(layer):
+    return f"{fixture.P}layers.{layer}.block_sparse_moe.experts"
+
+
+def _blocks(rank, layer, tp):
+    blocks = INTER // 128
+    chunk = (rank + layer) % tp
+    return slice(chunk * blocks // tp, (chunk + 1) * blocks // tp)
+
+
+def _records(directory, layer, w, blocks):
+    """This rank's canonical records of one projection, from the file."""
+    path = directory / f"layer-{layer:03d}.safetensors"
+    idx = fixture.st_read(path, f"{_base(layer)}.{w}.vq_idx")[:, blocks]
+    scale = fixture.st_read(path, f"{_base(layer)}.{w}.vq_scale")[:, blocks]
+    return idx, scale
+
+
+def _shape(role, width):
+    """[out, in] of one expert matrix of this rank."""
+    return (width, LATENT) if role == "in_latent" else (LATENT, width)
+
+
+def _inputs(rows, seed=0):
+    generator = torch.Generator().manual_seed(seed)
+    x = (torch.randn((rows, LATENT), generator=generator) * 4).to(torch.bfloat16)
+    ids = torch.randint(0, EXPERTS, (rows, TOPK), generator=generator).to(torch.int32)
+    weights = torch.rand((rows, TOPK), generator=generator).to(torch.float32)
+    return x, ids, weights
+
+
+def _apply(kernel, x, ids, weights):
+    """Call a kernel object as upstream's modular MoE kernel does."""
+    rows = x.shape[0]
+    _, shape2, out_shape = kernel.workspace_shapes(
+        rows, 0, LATENT, TOPK, EXPERTS, EXPERTS, None, None
+    )
+    output = torch.empty(out_shape, dtype=torch.bfloat16)
+    workspace2 = torch.empty(shape2, dtype=torch.bfloat16)
+    kernel.apply(
+        output=output,
+        hidden_states=x,
+        w1=None,
+        w2=None,
+        topk_weights=weights,
+        topk_ids=ids,
+        activation=None,
+        global_num_experts=EXPERTS,
+        expert_map=None,
+        a1q_scale=None,
+        a2_scale=None,
+        workspace13=None,
+        workspace2=workspace2,
+        expert_tokens_meta=None,
+        apply_router_weight_on_input=False,
+    )
+    return output, workspace2
+
+
+# -- the library and its loader --------------------------------------------------
+
+
+def test_construction_stops_without_the_library(monkeypatch, meta_platform, checkpoint):
+    """The default backend is the native ops: a build without the library
+    refuses the first VQ layer, naming the build command and the switch."""
+    from vllm.sm80.kernels.k31q import moe, vq_ops
+
+    if importlib.util.find_spec("vllm._k31_vq_C") is not None:
+        pytest.skip("vllm/_k31_vq_C is built here")
+    construct.set_groups(monkeypatch, 1, 0)
+    monkeypatch.delenv("VLLM_K31Q_VQ_BACKEND", raising=False)
+    monkeypatch.setattr(vq_ops, "_LOADED", False)
+    config = construct.vllm_config(checkpoint)
+    with pytest.raises(moe.K31VqNativeUnavailable) as error:
+        construct.build_model(config)
+    message = str(error.value)
+    assert "vllm._k31_vq_C" in message and vq_ops.BUILD_COMMAND in message
+    assert "VLLM_K31Q_VQ_BACKEND=reference" in message
+    assert "csrc/k31_vq/build_vq_standalone.py" in vq_ops.BUILD_COMMAND
+    assert (REPO / "csrc/k31_vq/build_vq_standalone.py").is_file()
+    monkeypatch.setenv("VLLM_K31Q_VQ_BACKEND", "fast")
+    with pytest.raises(ValueError, match="VLLM_K31Q_VQ_BACKEND must be one of"):
+        construct.build_model(construct.vllm_config(checkpoint))
+
