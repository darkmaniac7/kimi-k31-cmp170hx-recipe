+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""K3.1 Lever 3 GPU + PP2 verification tests (2-GPU PP2).
+
+Skipped cleanly on CPU-only runs (``CUDA_VISIBLE_DEVICES=""``). When run on
+a 2-GPU host:
+  1. Verifies CUDA-Graph-safe DSpark+Suffix hybrid blending and KDA Bank-0/
+     Bank-1 PipeSpec state commit/rollback directly on CUDA (zero host sync).
+  2. Verifies PP2 2-process NCCL broadcast/receive wire protocol for PipeSpec
+     formats N/A/B and dropped Chunk B across GPU 0 and GPU 1.
+  3. Smoke-checks ``/tmp/gem-k31/out/mini-k31q`` availability and verifies
+     Adaptive-K + PipeSpec config compatibility for the mini checkpoint.
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+import torch.distributed as dist
+import torch.multiprocessing as mp
+
+from vllm.sm80.spec_decode.adaptive_k import AdaptiveKConfig
+from vllm.sm80.spec_decode.dspark_suffix_hybrid import (
+    blend_dspark_and_suffix,
+    compute_suffix_confidence,
+)
+from vllm.v1.cmp_pipespec import KDAPipeSpecStateManager, resolve_chunk_k
+
+pytestmark = [
+    pytest.mark.cuda,
+    pytest.mark.skipif(
+        not torch.cuda.is_available(),
+        reason="CUDA GPU required for Lever 3 GPU/PP2 tests",
+    ),
+]
+
+MINI_K31Q_DIR = Path(
+    os.environ.get("VLLM_K31Q_MINI_DIR", "/tmp/gem-k31/out/mini-k31q")
+)
+
+
+def test_cuda_graph_safe_suffix_hybrid_and_kda_bank_isolation():
+    """Verify zero-sync CUDA Graph replay of suffix blending and KDA Bank-0/1."""
+    device = torch.device("cuda:0")
+    num_reqs, k_max, chunk_k = 2, 12, 5
+    d_toks = torch.arange(num_reqs * k_max, device=device, dtype=torch.int64).view(
+        num_reqs, k_max
+    )
+    s_toks = d_toks + 100
+    d_conf = torch.full((num_reqs, k_max), 0.35, device=device, dtype=torch.float32)
+    num_valid = torch.tensor([12, 0], device=device, dtype=torch.int32)
+    match_len = torch.tensor([8, 1], device=device, dtype=torch.int64)
+
+    # Warmup then capture in a CUDA Graph (any host sync raises inside capture!).
+    s_conf = compute_suffix_confidence(match_len, num_valid, k_max)
+    blend_dspark_and_suffix(d_toks, d_conf, s_toks, num_valid, match_len, s_conf)
+    torch.cuda.synchronize(device)
+
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        sc = compute_suffix_confidence(match_len, num_valid, k_max)
+        out_toks, out_conf, _, out_used = blend_dspark_and_suffix(
+            d_toks, d_conf, s_toks, num_valid, match_len, sc
+        )
+    g.replay()
+    torch.cuda.synchronize(device)
+    assert out_used.tolist() == [True, False]
+    assert torch.equal(out_toks[0], s_toks[0])
+    assert torch.equal(out_toks[1], d_toks[1])
+    assert float(out_conf[0].mean()) > 0.80
+
+    # KDA Bank-0 / Bank-1 commit & rollback under CUDA Graph capture.
+    conv = torch.randn(16, 32, 3 + k_max, device=device, dtype=torch.bfloat16)
+    rec = torch.randn(16, 4, 16, 16, device=device, dtype=torch.float32)
+    bt = torch.arange(1, k_max + 2, device=device, dtype=torch.int32)
+    num_sampled_b = torch.tensor([0], device=device, dtype=torch.int32)
+    acc_gpu = torch.tensor([3], device=device, dtype=torch.int32)
+    req_idx = torch.tensor([0], device=device, dtype=torch.int32)
+    bank0_conv_orig = conv[1].clone()
+    bank0_rec_orig = rec[1:7].clone()
+
+    KDAPipeSpecStateManager.prepare_chunk_b([(conv, rec)], bt, chunk_k)
+    conv[7].fill_(9.0)
+    rec[7:13].fill_(9.0)
+    g2 = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g2):
+        KDAPipeSpecStateManager.commit_or_rollback_chunk_b(
+            [(conv, rec)], bt, chunk_k, num_sampled_b, acc_gpu, req_idx
+        )
+    g2.replay()
+    torch.cuda.synchronize(device)
+    # Dropped B (num_sampled_b=0) preserved Bank 0 and acc_gpu=3 bit-exactly!
+    assert int(acc_gpu[0].item()) == 3
+    assert torch.equal(conv[1], bank0_conv_orig)
+    assert torch.equal(rec[1:7], bank0_rec_orig)
+
+    # Valid B (num_sampled_b=4) commits Bank 1 -> Bank 0 slot 3!
+    num_sampled_b.fill_(4)
+    g2.replay()
+    torch.cuda.synchronize(device)
+    assert int(acc_gpu[0].item()) == 4
+    assert torch.equal(conv[1], conv[7])
+    assert torch.equal(rec[4], rec[10])
+
+
+def _pp2_worker(rank: int, port: int, result_q):
+    os.environ["MASTER_ADDR"] = "127.0.0.1"
+    os.environ["MASTER_PORT"] = str(port)
+    torch.cuda.set_device(rank)
+    dist.init_process_group(backend="nccl", rank=rank, world_size=2)
+    try:
+        from vllm.v1.worker.gpu import pp_utils
+
+        group = SimpleNamespace(
+            is_last_rank=(rank == 1),
+            last_rank=1,
+            world_size=2,
+            make_sibling_device_group=lambda group_desc: dist.new_group([0, 1]),
+        )
+        orig_get = pp_utils.get_pp_group
+        pp_utils.get_pp_group = lambda: group
+        try:
+            k_max, chunk_k = 12, 5
+            handler = pp_utils.PPHandler(
+                max_num_reqs=4,
+                num_speculative_steps=k_max,
+                device=torch.device(f"cuda:{rank}"),
+            )
+            batch = SimpleNamespace(
+                num_reqs=1,
+                num_draft_tokens=chunk_k,
+                num_computed_tokens_np=np.array([64], dtype=np.int32),
+                prefill_len_np=np.array([8], dtype=np.int32),
+                num_scheduled_tokens=np.array([1 + chunk_k], dtype=np.int32),
+                is_prefilling_np=np.array([False], dtype=np.bool_),
+                max_seq_len_np=None,
+                idx_mapping=torch.tensor([0], dtype=torch.int32, device=f"cuda:{rank}"),
+                idx_mapping_np=np.array([0], dtype=np.int32),
+            )
+            if rank == 1:
+                sampled_a = torch.arange(
+                    k_max + 1, dtype=torch.int64, device="cuda:1"
+                ).view(1, k_max + 1)
+                handler.broadcast(
+                    sampled_a,
+                    torch.tensor([chunk_k + 1], dtype=torch.int32, device="cuda:1"),
+                    torch.tensor([0], dtype=torch.int32, device="cuda:1"),
+                    batch,
+                )
+                handler.broadcast_dropped_chunk(1, chunk_k)
+                p1 = torch.full((1, k_max), -1, dtype=torch.int64, device="cuda:1")
+                p1[0, :chunk_k] = torch.arange(100, 100 + chunk_k, device="cuda:1")
+                p2_toks = torch.arange(
+                    200, 200 + chunk_k + 1, dtype=torch.int64, device="cuda:1"
+                ).view(1, chunk_k + 1)
+                p2 = torch.cat(
+                    [torch.ones((1, 1), dtype=torch.int64, device="cuda:1"), p2_toks],
+                    dim=1,
+                )
+                ev = torch.cuda.current_stream("cuda:1").record_event()
+                handler.broadcast_rows(p1, ev)
+                handler.broadcast_rows(p2, ev)
+                torch.cuda.synchronize("cuda:1")
+                result_q.put((rank, "ok"))
+            else:
+                handler.get_prev_sampled_outputs()
+                handler.receive(batch, recv_drafts=True, fmt="A", chunk_k=chunk_k)
+                handler.get_prev_sampled_outputs()
+                handler.receive(batch, recv_drafts=True, fmt="B", chunk_k=chunk_k)
+                out_a = handler.get_prev_sampled_outputs()
+                out_b = handler.take_chunk_b_outputs()
+                assert out_a is not None and out_b is not None
+                assert int(out_a["num_sampled"][0].item()) == chunk_k + 1
+                assert int(out_b["num_sampled"][0].item()) == 0
+                assert int(out_b["num_rejected"][0].item()) == chunk_k + 1
+                assert out_b["draft_tokens"][0, :chunk_k].tolist() == list(
+                    range(100, 100 + chunk_k)
+                )
+                assert handler.get_prev_sampled_outputs() is None
+                got_entry = handler.take_p2_for_chunk_b(0)
+                assert got_entry is not None
+                got_p2, got_valid = got_entry
+                assert bool(got_valid.item()) is True
+                assert got_p2.tolist() == list(range(200, 200 + chunk_k + 1))
+                torch.cuda.synchronize("cuda:0")
+                result_q.put((rank, "ok"))
+        finally:
+            pp_utils.get_pp_group = orig_get
+    finally:
+        dist.destroy_process_group()
+
+
+@pytest.mark.skipif(
+    torch.cuda.device_count() < 2,
+    reason="Requires 2 GPUs (GPU 0 + GPU 1) for PP2 NCCL verification",
+)
+def test_pp2_two_gpu_nccl_pipespec_wire_protocol():
+    """Real 2-process NCCL PipeSpec broadcast/receive test across GPU 0 + GPU 1."""
+    import socket
+
+    with socket.socket() as s:
+        s.bind(("127.0.0.1", 0))
+        port = s.getsockname()[1]
+
+    ctx = mp.get_context("spawn")
+    q = ctx.Queue()
+    procs = [ctx.Process(target=_pp2_worker, args=(r, port, q)) for r in (0, 1)]
+    for p in procs:
+        p.start()
+    results = [q.get(timeout=60) for _ in (0, 1)]
+    for p in procs:
+        p.join(timeout=30)
+        if p.is_alive():
+            p.kill()
+        assert p.exitcode == 0
+    assert sorted(results) == [(0, "ok"), (1, "ok")]
+
+
+@pytest.mark.skipif(
+    not MINI_K31Q_DIR.is_dir(),
+    reason="mini-k31q checkpoint directory not present",
+)
+def test_mini_k31q_lever3_config_readiness():
+    """Validate Lever 3 Adaptive-K + PipeSpec config against mini-k31q layout."""
+    manifest = MINI_K31Q_DIR / "k31q_manifest.json"
+    assert manifest.is_file(), f"Missing {manifest}"
+    safe_cfg = AdaptiveKConfig.from_dict(
+        {
+            "tier_preset": "safe",
+            "confidence": {"thresholds": [1.5, 2.5, 3.5], "accept_weight": 0.0},
+        },
+        9,
+    )
+    full_cfg = AdaptiveKConfig.from_dict(
+        {
+            "tier_preset": "full",
+            "confidence": {"thresholds": [1.5, 2.5, 3.5, 4.5], "accept_weight": 0.0},
+        },
+        12,
+    )
+    assert resolve_chunk_k(9, safe_cfg, override_k=0) == 3
+    assert resolve_chunk_k(12, full_cfg, override_k=0) == 5
