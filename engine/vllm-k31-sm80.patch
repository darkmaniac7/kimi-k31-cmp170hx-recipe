+    path, rec, name, capture, layer, root = calls["exl3_moe_out_prefill_v2"]
+    _routed_other_rows(root, name)
+    with pytest.raises(ValueError, match="rank 2"):
+        F.expert_tp_cases([Path(r) for r in roots], directory)
