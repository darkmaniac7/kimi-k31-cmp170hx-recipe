+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU tests for Kimi K3.1 MoE and MLA performance switches:
+
+1. VLLM_K31Q_SHARD_ROUTED_UP=0|1 (column-sharded routed_expert_up_proj folded
+   into the shared-expert all-reduce).
+2. VLLM_K31Q_MLA_FUSE_G_PROJ=0|1 (3-member fused MLA q_a + kv_a + g_proj
+   decode launch via linear_out_k31_multi).
+"""
+
+import json
+import types
+
+import numpy as np
+import pytest
+import torch
+
+from tests.models.kimi_k3.sm80 import construct, fake_dense
+from tests.models.kimi_k3.sm80 import k31q_fixture as fixture
+from tests.models.test_native_checkpoint_config_meta import _parallel_groups
+
+MLA_LAYER = 3
+
+
+@pytest.fixture(scope="module")
+def checkpoint(tmp_path_factory):
+    directory = tmp_path_factory.mktemp("k31q-perf")
+    fixture.write_checkpoint(directory)
+    return directory
+
+
+@pytest.fixture
+def manager(monkeypatch):
+    """A private CPU workspace manager for k31 dense launches."""
+    from vllm.v1.worker import workspace
+
+    ws = workspace.WorkspaceManager(torch.device("cpu"))
+    monkeypatch.setattr(workspace, "_manager", ws)
+    return ws
+
+
+def _cpu_post_load(monkeypatch):
+    from vllm.sm80.kernels.exl3 import ops as exl3_ops
+    from vllm.sm80.kernels.exl3.quant import Exl3PackedWeight
+
+    monkeypatch.setattr(exl3_ops, "linear_row_chunk", lambda padded_in, out: 1 << 20)
+    monkeypatch.setattr(
+        Exl3PackedWeight,
+        "parameters",
+        lambda self, recurse=True: iter([types.SimpleNamespace(is_cuda=True)]),
+    )
+
+
+def _install_old_exl3(monkeypatch):
+    from vllm.sm80.kernels.exl3 import ops  # defines vllm::exl3_linear
+    from vllm.sm80.kernels.k31q import quant
+
+    assert ops.LINEAR_OUT_DTYPES
+    calls = []
+
+    def exl3_linear(
+        x, trellis, suh, svh, bits_x2, codebook, logical_out, chunk, dt=torch.bfloat16
+    ):
+        calls.append((x.shape[0], logical_out))
+        return fake_dense.old_path_output(
+            x, trellis, suh, svh, bits_x2, codebook, logical_out, chunk, dt
+        )
+
+    monkeypatch.setattr(torch.ops.vllm, "exl3_linear", exl3_linear, raising=False)
+    monkeypatch.setattr(
+        quant,
+        "_exl3_linear",
+        lambda x, w, chunk, dt: exl3_linear(
+            x, w.trellis, w.suh, w.svh, w.matrix.bits_x2, 2, w.logical_out, chunk, dt
+        ),
+    )
+    return calls
+
+
+def _process_dense(model):
+    for module in model.modules():
+        method = getattr(module, "quant_method", None)
+        if hasattr(method, "k31_dense_state"):
+            method.process_weights_after_loading(module)
+
+
+def _bits(tensor: torch.Tensor) -> np.ndarray:
+    return tensor.detach().contiguous().view(torch.int16).numpy().view(np.uint16)
+
+
+def _leaf(prefix: str) -> str:
+    return prefix.rsplit(".", 1)[-1]
+
