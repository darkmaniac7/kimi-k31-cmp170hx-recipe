+            "connected": True,
+            "transport": "p2p_ipc",
+            "rank": 0,
+            "device_ordinal": 2,
+            "slot_bytes": slot_bytes,
+            "timeout_ms": 5000,
+        }
+
+    def _fake_set_timeout(handle, ms):
+        calls["timeouts"].append(int(ms))
+
+    class _FakeStream:
+        def synchronize(self):
+            pass
+
+    def _fake_current_stream(dev):
+        calls["sync_devs"].append(str(dev))
+        return _FakeStream()
+
+    _orig_device = torch.device
+
+    def _cpu_device(spec):
+        calls["requested_dev"] = [str(spec)]
+        return _orig_device("cpu")
+
+    def _fake_ar(handle, x_in, out):
+        calls["shapes"].append(tuple(x_in.shape))
+        _, p1, _ = p2p_ops._probe_bf16_pair(
+            int(x_in.shape[0]), int(x_in.shape[1]), x_in.device
+        )
+        out.copy_((x_in.float() + p1.float()).to(torch.bfloat16))
