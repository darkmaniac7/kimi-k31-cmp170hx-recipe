+    if (use_lower_bound) {
+      log_decay = lower_bound * sigmoid_f32(a_val * g_plus);
+    } else {
+      float sp = (g_plus > 20.0f) ? g_plus : log1pf(expf(g_plus));
+      log_decay = -a_val * sp;
+    }
+    s_decay[tid] = expf(log_decay);
+  } else {
+    int d = tid - kD;
+    float k_tot = s_red[4] + s_red[5] + s_red[6] + s_red[7];
+    s_k[d] = s_k[d] / sqrtf(k_tot + 1.0e-6f);
+  }
+  __syncthreads();
+
+  const float beta = sigmoid_f32(bf16_to_f32(raw_beta_ptr[static_cast<int64_t>(b) * stride_beta_b + h]));
+
+  // Preload each lane's 4 elements of q, k, decay into registers once (reused for 16 V-rows!).
+  const float4 q4 = reinterpret_cast<const float4*>(s_q)[lane];
+  const float4 k4 = reinterpret_cast<const float4*>(s_k)[lane];
+  const float4 dec4 = reinterpret_cast<const float4*>(s_decay)[lane];
+
+  float* state_h = state_ptr + slot * stride_state_slot + static_cast<int64_t>(h) * kD * kD;
+
+  // Step 3: 8 warps x 16 V-rows = 128 V-rows, 100% coalesced 128-bit float4 R/W.
+  const int v_start = warp * 16;
+  for (int i = 0; i < 16; ++i) {
+    const int vr = v_start + i;
+    float4* s_row = reinterpret_cast<float4*>(state_h + vr * kD);
+    float4 st = s_row[lane];
+
+    st.x *= dec4.x;
+    st.y *= dec4.y;
+    st.z *= dec4.z;
+    st.w *= dec4.w;
+
+    float kv_part = fmaf(st.x, k4.x, fmaf(st.y, k4.y, fmaf(st.z, k4.z, st.w * k4.w)));
+    float kv_pred = warp_sum_f32(kv_part);
+    float dv = (s_v[vr] - kv_pred) * beta;
+
+    st.x = fmaf(dv, k4.x, st.x);
+    st.y = fmaf(dv, k4.y, st.y);
+    st.z = fmaf(dv, k4.z, st.z);
+    st.w = fmaf(dv, k4.w, st.w);
+
+    s_row[lane] = st;
+
+    float o_part = fmaf(st.x, q4.x, fmaf(st.y, q4.y, fmaf(st.z, q4.z, st.w * q4.w)));
+    float o_val = warp_sum_f32(o_part);
+    if (lane == 0) {
+      // Match BF16 intermediate before FusedRMSNormGated.
+      s_o[vr] = bf16_to_f32(f32_to_bf16(o_val));
+    }
+  }
+  __syncthreads();
+
+  // Step 4: FusedRMSNormGated(128, activation="sigmoid").
+  if (tid < kD) {
+    float ov = s_o[tid];
+    float osq = warp_sum_f32(ov * ov);
+    if (lane == 0) s_red[warp] = osq;
+  }
+  __syncthreads();
+
+  if (tid < kD) {
+    float o_tot = (s_red[0] + s_red[1]) + (s_red[2] + s_red[3]);
+    float inv_rms = 1.0f / sqrtf(o_tot * kInvD + norm_eps);
+    float nw = load_f32_or_bf16(norm_w_ptr, tid, norm_w_fp32);
+    float g2v = bf16_to_f32(g2_ptr[static_cast<int64_t>(b) * stride_g2_b + h * kD + tid]);
+    float y = s_o[tid] * inv_rms * nw * sigmoid_f32(g2v);
+    out_h[tid] = f32_to_bf16(y);
+  }
+}
+
+// D = 128, conv_width = 4. 1 CTA per (spec_seq, head), 512 threads = 16 warps.
