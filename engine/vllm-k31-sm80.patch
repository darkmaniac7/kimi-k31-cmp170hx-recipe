+// ============================================================================
+// 5. Fused SM80/SM120 KDA Decode (Conv1d+SiLU + Recurrence + RMSNormGated)
+// ============================================================================
+
+// D = 128, conv_width = 4. 1 CTA per (batch_item, head), 256 threads = 8 warps.
+// Replaces 4 separate launches on SM80: causal_conv1d_update + Triton KDA recurrence
+// + D2D output copy + Triton FusedRMSNormGated(sigmoid).
+__global__ void __launch_bounds__(256) k31_fused_kda_decode_d128_kernel(
+    const __nv_bfloat16* __restrict__ mixed_qkv_ptr,
+    __nv_bfloat16* __restrict__ conv_state_ptr,
+    const void* __restrict__ conv_weight_ptr,
+    const void* __restrict__ conv_bias_ptr,
+    const __nv_bfloat16* __restrict__ raw_g_ptr,
+    const __nv_bfloat16* __restrict__ raw_beta_ptr,
+    const void* __restrict__ a_log_ptr,
+    const void* __restrict__ dt_bias_ptr,
+    const __nv_bfloat16* __restrict__ g2_ptr,
+    const void* __restrict__ norm_w_ptr,
+    float* __restrict__ state_ptr,
+    const void* __restrict__ state_indices_ptr,
+    int64_t stride_mixed_b,
+    int64_t stride_cs_slot,
+    int64_t stride_cs_c,
+    int64_t stride_cs_t,
+    int64_t stride_cw_c,
+    int64_t stride_g_b,
+    int64_t stride_beta_b,
+    int64_t stride_g2_b,
+    int64_t stride_state_slot,
+    int64_t stride_out_b,
+    int H,
+    bool conv_w_fp32,
+    bool conv_b_fp32,
+    bool a_log_fp32,
+    bool dt_bias_fp32,
+    bool norm_w_fp32,
+    bool indices_i64,
+    bool use_lower_bound,
+    float lower_bound,
+    float norm_eps,
+    __nv_bfloat16* __restrict__ out_ptr) {
+  constexpr int kD = 128;
+  constexpr int kWarps = 8;
+  constexpr float kQScale = 0.08838834764831845f;  // 1 / sqrt(128)
+  constexpr float kInvD = 1.0f / 128.0f;
