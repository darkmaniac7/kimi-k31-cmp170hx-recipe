+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The K3.1 dense backend (vllm/sm80/kernels/k31q/dense.py) on the CPU, on
+the tiny k31q checkpoint, with a recording stand-in for the library
+(tests/models/kimi_k3/sm80/fake_dense.py).
+
+The stand-in fills each member's columns with a function of the input rows,
+the member's svh and its trellis, and the EXL3 path is replaced by the same
+function per matrix. So the two backends give equal bits when, and only
+when, the new launches take the right members in the right order, with the
+right logical widths, and the module puts every column where the EXL3 path
+puts it (the plain f_a and b of the KDA in-projection and its padding are
+computed for real by both). What runs on a card is tested in
+test_k31q_dense_gpu.py.
+
+Checked: which module launches which members, with which shapes, and how
+many launches a KDA layer, an MLA layer, layer 0 and the head take; row
+chunking above the launch rows; one workspace per stream from the workspace
+manager, never allocated again; no host read in the forward; the EXL3
+fallback for matrices the library does not take; the switch; the startup
+line; tensor parallel ranks and pipeline stages.
+"""
+
+import types
+
+import pytest
+import torch
+
+from tests.models.kimi_k3.sm80 import construct, fake_dense
+from tests.models.kimi_k3.sm80 import k31q_fixture as fixture
+
+MLA_LAYER = 3
+MAX_ROWS = construct.MAX_BATCHED_TOKENS  # the launch rows of these models
+P = "model.layers."
+
+
+@pytest.fixture(scope="module")
+def checkpoint(tmp_path_factory):
+    directory = tmp_path_factory.mktemp("k31q-dense")
+    fixture.write_checkpoint(directory)
+    return directory
+
+
+@pytest.fixture
+def manager(monkeypatch):
+    """A workspace manager of its own on the CPU."""
+    from vllm.v1.worker import workspace
+
+    manager = workspace.WorkspaceManager(torch.device("cpu"))
+    monkeypatch.setattr(workspace, "_manager", manager)
+    return manager
+
+
+def _cpu_post_load(monkeypatch):
+    """process_weights_after_loading runs on the CPU: the EXL3 extension's
+    row chunk is not needed by the stand-ins, and the methods' check that
+    packed weights sit on CUDA is answered yes."""
+    from vllm.sm80.kernels.exl3 import ops as exl3_ops
+    from vllm.sm80.kernels.exl3.quant import Exl3PackedWeight
+
+    monkeypatch.setattr(exl3_ops, "linear_row_chunk", lambda padded_in, out: 1 << 20)
+    monkeypatch.setattr(
+        Exl3PackedWeight,
+        "parameters",
+        lambda self, recurse=True: iter([types.SimpleNamespace(is_cuda=True)]),
+    )
+
+
+def _old_path(monkeypatch):
+    """The EXL3 path, per matrix, as the stand-in's function."""
+    from vllm.sm80.kernels.exl3 import ops  # defines vllm::exl3_linear first
+    from vllm.sm80.kernels.k31q import quant
+
+    assert ops.LINEAR_OUT_DTYPES
+
+    calls = []
+
+    def exl3_linear(
+        x, trellis, suh, svh, bits_x2, codebook, logical_out, chunk, dt=torch.bfloat16
+    ):
+        calls.append(x.shape[0])
+        return fake_dense.old_path_output(
+            x, trellis, suh, svh, bits_x2, codebook, logical_out, chunk, dt
+        )
+
+    monkeypatch.setattr(torch.ops.vllm, "exl3_linear", exl3_linear, raising=False)
+    monkeypatch.setattr(
+        quant,
+        "_exl3_linear",
+        lambda x, w, chunk, dt: exl3_linear(
+            x, w.trellis, w.suh, w.svh, w.matrix.bits_x2, 2, w.logical_out, chunk, dt
+        ),
+    )
+    return calls
+
+
+def _dense_modules(model):
+    return {
+        name: module
+        for name, module in model.named_modules()
+        if hasattr(getattr(module, "quant_method", None), "k31_dense_state")
+    }
+
+
+def _build(monkeypatch, directory, ops, tp_size=1, tp_rank=0, **stage):
+    model, config, _, _ = construct.build_and_load(
+        monkeypatch, directory, tp_size=tp_size, tp_rank=tp_rank, **stage
+    )
+    _cpu_post_load(monkeypatch)
+    if ops is not None:
+        ops.name(model)
+    for module in _dense_modules(model).values():
+        module.quant_method.process_weights_after_loading(module)
+    return model, config
+
+
+def _forward(module, x):
+    """The module's projection (its method's apply; the module forward adds
+    only the tensor-parallel reduce, which has no process group here)."""
+    return module.quant_method.apply(module, x)
+
+
+def _inputs(module, rows, seed=0):
+    width = (
+        getattr(module, "input_size_per_partition", None)
+        or getattr(module, "input_size", None)
+        or module.embedding_dim
+    )
+    generator = torch.Generator().manual_seed(seed)
+    return (torch.randn((rows, width), generator=generator) / 8).to(torch.bfloat16)
+
+
+def _same_as_old_path(module, x):
+    """The module's output on the k31 backend and on the EXL3 path."""
+    method = module.quant_method
+    new = _forward(module, x)
+    launcher, method.launcher = method.launcher, None
+    try:
+        old = _forward(module, x)
+    finally:
+        method.launcher = launcher
+    return new, old
+
+
+def _leaf(prefix: str) -> str:
+    return prefix.rsplit(".", 1)[-1]
+
+
