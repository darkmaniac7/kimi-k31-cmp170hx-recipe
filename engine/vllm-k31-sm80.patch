+def test_pipespec_multi_mamba_group_kda_bit_exact():
+    """Regression: Kimi K3.1 splits KDA layers across 3 Mamba KV cache groups
+    with disjoint block tables; every group must prepare and commit using its
+    own block table row without aliasing or clobbering sibling groups."""
+    from types import SimpleNamespace
+    import numpy as np
+    from vllm.v1.worker.gpu.model_states.mamba_hybrid import MambaHybridModelState
+
+    torch.manual_seed(1234)
+    chunk_k = 3
+    num_blocks = 32
+    static_ctx = {}
+    attn_groups = []
+    block_tables = []
+
+    # 3 Mamba groups (2 layers each) with disjoint block IDs [1..8], [9..16], [17..24]
+    group_ranges = [(1, 9), (9, 17), (17, 25)]
+    for gid, (b0, b1) in enumerate(group_ranges):
+        names = [f"kda_g{gid}_l0", f"kda_g{gid}_l1"]
+        for name in names:
+            conv = torch.randn(num_blocks, 4, 10, dtype=torch.float32)
+            rec = torch.randn(num_blocks, 2, 4, 4, dtype=torch.float32)
+            static_ctx[name] = SimpleNamespace(kv_cache=(conv, rec))
+        builder = SimpleNamespace(_supports_pipespec_chunk_b=True, layer_names=names)
+        group = SimpleNamespace(
+            layer_names=names,
+            get_metadata_builder=lambda _i, b=builder: b,
+        )
+        attn_groups.append([group])
+        bt = torch.arange(b0, b1, dtype=torch.int32).unsqueeze(0)
+        block_tables.append(bt)
+
+    # Add a non-Mamba MLA group at gid=3
+    mla_builder = SimpleNamespace(_supports_pipespec_chunk_b=False)
+    attn_groups.append([SimpleNamespace(get_metadata_builder=lambda _i: mla_builder)])
+    block_tables.append(torch.arange(1, 5, dtype=torch.int32).unsqueeze(0))
+
+    ms = object.__new__(MambaHybridModelState)
+    ms.device = torch.device("cpu")
+    ms.prefix_caching = False
+    ms.num_accepted_tokens_gpu = torch.ones(4, dtype=torch.int32)
+    ms._pipespec_chunk_b_k = 0
+    ms._pipespec_chunk_b_block_row = {}
+    ms._pipespec_req_id_to_idx = {}
+    ms.vllm_config = SimpleNamespace(
+        compilation_config=SimpleNamespace(static_forward_context=static_ctx)
+    )
+
+    # Snapshot unrelated block 5 (bt0[4]) in gid=1,2 to prove zero cross-group clobber
+    g1_b5_before = static_ctx["kda_g1_l0"].kv_cache[0][5].clone()
+    g2_b5_before = static_ctx["kda_g2_l0"].kv_cache[0][5].clone()
+
+    # Run prepare_chunk_b and verify each group copied its OWN Bank 0 -> Bank 1
+    ib = SimpleNamespace(idx_mapping_np=np.array([0], dtype=np.int64))
+    ms._prepare_pipespec_chunk_b(ib, tuple(block_tables), attn_groups, chunk_k)
+
+    assert torch.equal(static_ctx["kda_g1_l0"].kv_cache[0][5], g1_b5_before)
+    assert torch.equal(static_ctx["kda_g2_l0"].kv_cache[0][5], g2_b5_before)
+    for gid, (b0, _) in enumerate(group_ranges):
+        for l in range(2):
+            conv, rec = static_ctx[f"kda_g{gid}_l{l}"].kv_cache
+            assert torch.equal(conv[b0 + 4], conv[b0])
+            assert torch.equal(rec[b0 + 7], rec[b0 + 3])
+
+    # Mutate Bank-1 slots to simulate Chunk B forward on each group
+    expected_conv = {}
+    expected_rec = {}
+    m_b = 3
+    for gid, (b0, _) in enumerate(group_ranges):
+        for l in range(2):
+            key = f"kda_g{gid}_l{l}"
+            conv, rec = static_ctx[key].kv_cache
+            conv[b0 + 4] = torch.randn_like(conv[b0 + 4])
+            rec[b0 + 3 + m_b] = torch.randn_like(rec[b0 + 3 + m_b])
+            expected_conv[key] = conv[b0 + 4].clone()
+            expected_rec[key] = rec[b0 + 3 + m_b].clone()
+
+    # Commit valid Chunk B (m_b = 3)
+    ms.postprocess_pipespec_chunk_b(
+        torch.tensor([0], dtype=torch.int32),
+        torch.tensor([m_b], dtype=torch.int32),
+        chunk_k,
+        req_idx=0,
+    )
+    assert int(ms.num_accepted_tokens_gpu[0].item()) == m_b
+    for gid, (b0, _) in enumerate(group_ranges):
+        for l in range(2):
+            key = f"kda_g{gid}_l{l}"
+            conv, rec = static_ctx[key].kv_cache
+            assert torch.equal(conv[b0], expected_conv[key])
+            assert torch.equal(rec[b0 + m_b - 1], expected_rec[key])
+
+    # Verify dropped Chunk B (m_b = 0) leaves all 3 groups' Bank 0 untouched
+    ms._prepare_pipespec_chunk_b(ib, tuple(block_tables), attn_groups, chunk_k)
+    for gid, (b0, _) in enumerate(group_ranges):
+        for l in range(2):
+            conv, rec = static_ctx[f"kda_g{gid}_l{l}"].kv_cache
+            conv[b0 + 4].fill_(999.0)
+            rec[b0 + 4].fill_(999.0)
+    ms.postprocess_pipespec_chunk_b(
+        torch.tensor([0], dtype=torch.int32),
+        torch.tensor([0], dtype=torch.int32),
+        chunk_k,
+        req_idx=0,
+    )
+    assert int(ms.num_accepted_tokens_gpu[0].item()) == m_b
+    for gid, (b0, _) in enumerate(group_ranges):
+        for l in range(2):
+            key = f"kda_g{gid}_l{l}"
+            conv, rec = static_ctx[key].kv_cache
+            assert torch.equal(conv[b0], expected_conv[key])
+            assert torch.equal(rec[b0 + m_b - 1], expected_rec[key])
