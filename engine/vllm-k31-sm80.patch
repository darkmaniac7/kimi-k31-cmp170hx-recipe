+
+__device__ __forceinline__ uint32_t atomic_add_acq_rel_gpu(uint32_t* ptr, uint32_t val) {
+  uint32_t old;
+  asm volatile("atom.acq_rel.gpu.global.add.u32 %0, [%1], %2;"
+               : "=r"(old) : "l"(ptr), "r"(val) : "memory");
+  return old;
+}
+
+__device__ __forceinline__ uint32_t atomic_cas_acq_rel_gpu_u32(
+    uint32_t* ptr, uint32_t cmp, uint32_t val) {
+  uint32_t old;
+  asm volatile("atom.acq_rel.gpu.global.cas.b32 %0, [%1], %2, %3;"
+               : "=r"(old) : "l"(ptr), "r"(cmp), "r"(val) : "memory");
+  return old;
+}
+
+// Sticky error recorder: uses local-GPU CAS (zero PCIe host atomics) so the first
+// error code wins and is published to host-mapped err_code with release.sys ordering.
+__device__ __forceinline__ uint32_t set_err_sticky(
+    DeviceControlState* dev_ctrl,
+    HostMappedControl* host_ctrl,
+    uint32_t code) {
+  uint32_t old = atomic_cas_acq_rel_gpu_u32(&dev_ctrl->dev_err_code, 0u, code);
+  if (old == 0u) {
+    st_release_sys_u32(&host_ctrl->err_code, code);
+    return code;
+  }
+  return old;
+}
+
+__device__ __forceinline__ uint32_t check_entry_status(
+    DeviceControlState* dev_ctrl,
+    HostMappedControl* host_ctrl,
+    uint32_t expected_gen) {
+  // Local-HBM control check only (zero PCIe host-RAM reads on the hot path).
+  // Host mutators (set_abort, clear_abort, clear_error, close_peer_imports)
+  // mirror changes into dev_ctrl via non-blocking ctrl_stream DMA, while
+  // wait_for_peer_flag / wait_for_pp_credit still poll host_ctrl on stalls.
+  uint32_t err = ld_acquire_gpu_u32(&dev_ctrl->dev_err_code);
+  if (err != 0u) return err;
+  if (ld_acquire_gpu_u32(&dev_ctrl->dev_generation) != expected_gen) {
+    return set_err_sticky(dev_ctrl, host_ctrl, kErrGenerationMismatch);
+  }
+  if (ld_acquire_gpu_u32(&dev_ctrl->dev_abort_flag) != 0u) {
+    return set_err_sticky(dev_ctrl, host_ctrl, kErrAbort);
+  }
+  return 0u;
+}
+
+__device__ __forceinline__ uint4 ld_local_v4(const uint4* ptr) {
+  uint4 v;
+  asm volatile("ld.global.v4.u32 {%0, %1, %2, %3}, [%4];"
+               : "=r"(v.x), "=r"(v.y), "=r"(v.z), "=r"(v.w)
+               : "l"(ptr));
+  return v;
+}
+
+__device__ __forceinline__ void st_local_v4(uint4* ptr, uint4 v) {
+  asm volatile("st.global.v4.u32 [%0], {%1, %2, %3, %4};"
+               :: "l"(ptr), "r"(v.x), "r"(v.y), "r"(v.z), "r"(v.w));
+}
+
+template <bool IS_SHM>
+__device__ __forceinline__ uint4 ld_peer_v4(const uint4* ptr) {
+  uint4 v;
+  if constexpr (IS_SHM) {
+    asm volatile("ld.global.cv.v4.u32 {%0, %1, %2, %3}, [%4];"
+                 : "=r"(v.x), "=r"(v.y), "=r"(v.z), "=r"(v.w)
+                 : "l"(ptr)
+                 : "memory");
+  } else {
+    asm volatile("ld.global.cg.v4.u32 {%0, %1, %2, %3}, [%4];"
+                 : "=r"(v.x), "=r"(v.y), "=r"(v.z), "=r"(v.w)
+                 : "l"(ptr)
+                 : "memory");
+  }
+  return v;
+}
+
+// Weak write-combining peer store (STG.E.128, not STG.E.128.STRONG.SYS from .wt).
+// System-scope visibility and PCIe ordering are enforced by the CTA barrier plus
+// st.release.sys.global.u64 on the peer flag line.
+template <bool IS_SHM>
+__device__ __forceinline__ void st_peer_v4(uint4* ptr, uint4 v) {
+  (void)IS_SHM;
+  asm volatile("st.global.v4.u32 [%0], {%1, %2, %3, %4};"
+               :: "l"(ptr), "r"(v.x), "r"(v.y), "r"(v.z), "r"(v.w)
+               : "memory");
+}
+
+__device__ __forceinline__ void st_peer_u8(uint8_t* ptr, uint8_t val) {
+  uint32_t v = static_cast<uint32_t>(val);
+  asm volatile("st.global.u8 [%0], %1;" :: "l"(ptr), "r"(v) : "memory");
+}
+
+template <bool IS_SHM>
+__device__ __forceinline__ uint8_t ld_peer_u8(const uint8_t* ptr) {
+  uint32_t v;
+  if constexpr (IS_SHM) {
+    asm volatile("ld.global.cv.u8 %0, [%1];" : "=r"(v) : "l"(ptr) : "memory");
+  } else {
+    asm volatile("ld.global.cg.u8 %0, [%1];" : "=r"(v) : "l"(ptr) : "memory");
+  }
+  return static_cast<uint8_t>(v);
+}
+
+// Quiet-NaN poison helpers (0x7FC0 is quiet NaN in BF16 and FP16; 0x7FC07FC0 is quiet NaN in FP32).
+__device__ __forceinline__ void poison_v4_stripe(
+    uint4* ptr, int64_t v_start, int v_count, int tid) {
+  const uint4 nan_v = make_uint4(0x7FC07FC0u, 0x7FC07FC0u, 0x7FC07FC0u, 0x7FC07FC0u);
+  for (int i = tid; i < v_count; i += kBlockThreads) {
+    st_local_v4(ptr + v_start + i, nan_v);
+  }
+}
+
+__device__ __forceinline__ void poison_u8_stripe(
+    uint8_t* ptr, int b_start, int b_count, int tid) {
+  for (int i = tid; i < b_count; i += kBlockThreads) {
+    const int pos = b_start + i;
+    ptr[pos] = ((pos & 1) == 0) ? static_cast<uint8_t>(0xC0u) : static_cast<uint8_t>(0x7Fu);
+  }
+}
+
+__device__ __forceinline__ float2 bf16x2_to_f32x2(uint32_t raw) {
+  __nv_bfloat162 b;
+  memcpy(&b, &raw, sizeof(b));
+  return __bfloat1622float2(b);
+}
+
+__device__ __forceinline__ uint32_t f32x2_to_bf16x2(float a, float b) {
+  __nv_bfloat162 v = __floats2bfloat162_rn(a, b);
+  uint32_t raw;
+  memcpy(&raw, &v, sizeof(raw));
+  return raw;
+}
+
+template <int RANK>
+__device__ __forceinline__ float2 fixed_add_pair(uint32_t loc_raw, uint32_t peer_raw) {
+  float2 l = bf16x2_to_f32x2(loc_raw);
+  float2 p = bf16x2_to_f32x2(peer_raw);
+  float2 v0 = (RANK == 0) ? l : p;
+  float2 v1 = (RANK == 0) ? p : l;
+  return make_float2(v0.x + v1.x, v0.y + v1.y);
+}
+
+template <int RANK, bool HAS_RES>
+__device__ __forceinline__ void reduce_and_store_v4(
+    uint4 loc,
+    uint4 peer,
+    uint4 res,
+    uint4* out_sum,
+    uint4* out_res,
+    bool write_sum) {
+  float2 s0 = fixed_add_pair<RANK>(loc.x, peer.x);
+  float2 s1 = fixed_add_pair<RANK>(loc.y, peer.y);
+  float2 s2 = fixed_add_pair<RANK>(loc.z, peer.z);
+  float2 s3 = fixed_add_pair<RANK>(loc.w, peer.w);
+
+  if (write_sum) {
+    uint4 sum_out;
+    sum_out.x = f32x2_to_bf16x2(s0.x, s0.y);
+    sum_out.y = f32x2_to_bf16x2(s1.x, s1.y);
+    sum_out.z = f32x2_to_bf16x2(s2.x, s2.y);
+    sum_out.w = f32x2_to_bf16x2(s3.x, s3.y);
+    st_local_v4(out_sum, sum_out);
+  }
+
+  if constexpr (HAS_RES) {
+    float2 r0 = bf16x2_to_f32x2(res.x);
+    float2 r1 = bf16x2_to_f32x2(res.y);
+    float2 r2 = bf16x2_to_f32x2(res.z);
+    float2 r3 = bf16x2_to_f32x2(res.w);
+    uint4 res_out;
+    res_out.x = f32x2_to_bf16x2(s0.x + r0.x, s0.y + r0.y);
+    res_out.y = f32x2_to_bf16x2(s1.x + r1.x, s1.y + r1.y);
+    res_out.z = f32x2_to_bf16x2(s2.x + r2.x, s2.y + r2.y);
+    res_out.w = f32x2_to_bf16x2(s3.x + r3.x, s3.y + r3.y);
+    st_local_v4(out_res, res_out);
+  }
+}
+
+__device__ __forceinline__ uint32_t wait_for_peer_flag(
+    const FlagLine* __restrict__ my_flags,
+    int slot,
+    int flag_cta,
+    uint64_t expected_flag,
+    DeviceControlState* __restrict__ dev_ctrl,
+    HostMappedControl* __restrict__ host_ctrl,
+    uint32_t expected_gen) {
+  const uint64_t* flag_ptr = &my_flags[slot * kFixedGrid + flag_cta].val;
+  const uint64_t expected_seq = expected_flag >> 8;
+  uint64_t t0 = 0ull;
+  uint64_t next_host_check = 0ull;
+  uint32_t iters = 0u;
+  while (true) {
+    const uint64_t got = ld_acquire_sys_u64(flag_ptr);
+    if (got == expected_flag) {
+      return 0u;
+    }
+    if ((got >> 8) == expected_seq && got != expected_flag) {
+      return set_err_sticky(dev_ctrl, host_ctrl, kErrOpMismatch);
+    }
+    ++iters;
+    if ((iters & 63u) == 0u) {
+      uint32_t existing = ld_acquire_gpu_u32(&dev_ctrl->dev_err_code);
+      if (existing != 0u) return existing;
+      uint64_t now = read_globaltimer_ns();
+      if (t0 == 0ull) {
+        t0 = now;
+        next_host_check = now + kHostPollIntervalNs;
+      } else if (now >= next_host_check) {
+        next_host_check = now + kHostPollIntervalNs;
+        if (ld_acquire_sys_u32(&host_ctrl->generation) != expected_gen) {
+          return set_err_sticky(dev_ctrl, host_ctrl, kErrGenerationMismatch);
+        }
+        if (ld_acquire_sys_u32(&host_ctrl->abort_flag) != 0u) {
+          return set_err_sticky(dev_ctrl, host_ctrl, kErrAbort);
+        }
+        uint64_t timeout_ns = ld_acquire_sys_u64(&host_ctrl->timeout_ns);
+        if (timeout_ns > 0ull && (now - t0) >= timeout_ns) {
+          return set_err_sticky(dev_ctrl, host_ctrl, kErrTimeout);
+        }
+      }
+    }
+    if (iters >= 512u) {
+      asm volatile("nanosleep.u32 64;");
+    }
+  }
+}
+
+__device__ __forceinline__ uint32_t wait_for_pp_credit(
+    const FlagLine* __restrict__ my_pp_ack_flag,
+    uint64_t seq,
+    DeviceControlState* __restrict__ dev_ctrl,
+    HostMappedControl* __restrict__ host_ctrl,
+    uint32_t expected_gen) {
+  const uint64_t* ack_ptr = &my_pp_ack_flag->val;
+  uint64_t t0 = 0ull;
+  uint64_t next_host_check = 0ull;
+  uint32_t iters = 0u;
+  while (ld_acquire_sys_u64(ack_ptr) + static_cast<uint64_t>(kNumSlots) < seq) {
+    ++iters;
+    if ((iters & 63u) == 0u) {
+      uint32_t existing = ld_acquire_gpu_u32(&dev_ctrl->dev_err_code);
+      if (existing != 0u) return existing;
+      uint64_t now = read_globaltimer_ns();
+      if (t0 == 0ull) {
+        t0 = now;
+        next_host_check = now + kHostPollIntervalNs;
+      } else if (now >= next_host_check) {
+        next_host_check = now + kHostPollIntervalNs;
+        if (ld_acquire_sys_u32(&host_ctrl->generation) != expected_gen) {
+          return set_err_sticky(dev_ctrl, host_ctrl, kErrGenerationMismatch);
+        }
+        if (ld_acquire_sys_u32(&host_ctrl->abort_flag) != 0u) {
+          return set_err_sticky(dev_ctrl, host_ctrl, kErrAbort);
+        }
+        uint64_t timeout_ns = ld_acquire_sys_u64(&host_ctrl->timeout_ns);
+        if (timeout_ns > 0ull && (now - t0) >= timeout_ns) {
+          return set_err_sticky(dev_ctrl, host_ctrl, kErrTimeout);
+        }
+      }
+    }
+    if (iters >= 512u) {
+      asm volatile("nanosleep.u32 64;");
+    }
+  }
+  return 0u;
+}
+
+__device__ __forceinline__ void ar_grid_commit(
+    DeviceControlState* __restrict__ dev_ctrl,
+    uint64_t next_seq,
+    int tid) {
+  __syncthreads();
+  if (tid == 0) {
+    if (gridDim.x == 1u) {
+      if (ld_acquire_gpu_u32(&dev_ctrl->dev_err_code) == 0u) {
+        st_release_gpu_u64(&dev_ctrl->ar_op_seq, next_seq);
+      }
+      return;
+    }
+    uint32_t prev = atomic_add_acq_rel_gpu(&dev_ctrl->ar_done_cnt, 1u);
+    if (prev + 1u == gridDim.x) {
+      dev_ctrl->ar_done_cnt = 0u;
+      if (ld_acquire_gpu_u32(&dev_ctrl->dev_err_code) == 0u) {
+        st_release_gpu_u64(&dev_ctrl->ar_op_seq, next_seq);
+      }
+    }
+  }
+}
+
+__device__ __forceinline__ float block_reduce_sum_deterministic(
+    float val, float* __restrict__ s_warp_sq) {
+  const int tid = threadIdx.x;
+  const int lane = tid & 31;
+  const int warp = tid >> 5;
+  val += __shfl_xor_sync(0xffffffffu, val, 16);
+  val += __shfl_xor_sync(0xffffffffu, val, 8);
+  val += __shfl_xor_sync(0xffffffffu, val, 4);
+  val += __shfl_xor_sync(0xffffffffu, val, 2);
+  val += __shfl_xor_sync(0xffffffffu, val, 1);
+  if (lane == 0) {
+    s_warp_sq[warp] = val;
+  }
+  __syncthreads();
+  float total = 0.0f;
+#pragma unroll
+  for (int w = 0; w < (kBlockThreads / 32); ++w) {
+    total += s_warp_sq[w];
+  }
+  return total;
+}
+
+// ---------------------------------------------------------------------------
+// Kernel 1a: p2p_allreduce_residual (decode register-cached fast path)
+// ---------------------------------------------------------------------------
+
+template <int RANK, bool IS_SHM, bool HAS_RES>
+__global__ __launch_bounds__(kBlockThreads, 2)
+void p2p_allreduce_residual_fast_kernel(
+    const uint4* x_partial,
+    const uint4* residual,
+    uint4* out_sum,
+    uint4* out_res,
+    uint8_t* __restrict__ my_inbox,
+    FlagLine* __restrict__ my_flags,
+    uint8_t* __restrict__ peer_inbox,
+    FlagLine* __restrict__ peer_flags,
+    DeviceControlState* __restrict__ dev_ctrl,
+    HostMappedControl* __restrict__ host_ctrl,
+    uint64_t slot_bytes,
+    uint32_t expected_gen,
+    int total_vecs,
+    int active_ctas,
+    bool write_sum) {
+  __shared__ uint64_t s_base_seq;
+  __shared__ uint32_t s_err;
+  static_assert(sizeof(s_base_seq) + sizeof(s_err) <= 48 * 1024, "SMEM cap");
+
+  const int bid = blockIdx.x;
+  const int tid = threadIdx.x;
+
+  if (tid == 0) {
+    s_base_seq = ld_acquire_gpu_u64(&dev_ctrl->ar_op_seq);
+    s_err = check_entry_status(dev_ctrl, host_ctrl, expected_gen);
+  }
+  __syncthreads();
+
+  const uint64_t seq = s_base_seq + 1ull;
+  if (bid < active_ctas) {
+    int v_start = 0, v_count = 0;
+    partition_aligned_128b(total_vecs, active_ctas, bid, v_start, v_count);
+
+    if (s_err != 0u) {
+      if (write_sum) poison_v4_stripe(out_sum, v_start, v_count, tid);
+      if constexpr (HAS_RES) poison_v4_stripe(out_res, v_start, v_count, tid);
+    } else {
+      const int slot = static_cast<int>(seq & kSlotMask);
+      const uint64_t flag_val = pack_flag(seq, kOpKindArFast);
+      uint4* peer_slot = reinterpret_cast<uint4*>(peer_inbox + static_cast<size_t>(slot) * slot_bytes);
+      const uint4* my_slot = reinterpret_cast<const uint4*>(my_inbox + static_cast<size_t>(slot) * slot_bytes);
+
+      // Register-cache up to 8*256 = 2048 uint4 vectors (32 KiB) per CTA.
+      // Pairwise load->store starts PCIe BAR1 traffic immediately while hiding L2 latency.
+      uint4 loc[kArFastMaxIters];
+#pragma unroll
+      for (int k = 0; k < kArFastMaxIters; k += 2) {
+        const int idx0 = tid + k * kBlockThreads;
+        const int idx1 = tid + (k + 1) * kBlockThreads;
+        const bool h0 = (idx0 < v_count);
+        const bool h1 = (idx1 < v_count);
+        if (h0) loc[k] = ld_local_v4(x_partial + v_start + idx0);
+        if (h1) loc[k + 1] = ld_local_v4(x_partial + v_start + idx1);
+        if (h0) st_peer_v4<IS_SHM>(peer_slot + v_start + idx0, loc[k]);
+        if (h1) st_peer_v4<IS_SHM>(peer_slot + v_start + idx1, loc[k + 1]);
+      }
+
+      __syncthreads();
+      if (tid == 0) {
+        st_release_sys_u64(&peer_flags[slot * kFixedGrid + bid].val, flag_val);
+        s_err = wait_for_peer_flag(my_flags, slot, bid, flag_val, dev_ctrl, host_ctrl, expected_gen);
+      }
+      __syncthreads();
+      if (s_err != 0u) {
+        if (write_sum) poison_v4_stripe(out_sum, v_start, v_count, tid);
+        if constexpr (HAS_RES) poison_v4_stripe(out_res, v_start, v_count, tid);
+      } else {
+        // Pairwise peer load overlaps L2/SHM read latency; residual is read before any
+        // store so all in-place aliasing modes (out_sum/out_res/x_partial/residual) are safe.
+#pragma unroll
+        for (int k = 0; k < kArFastMaxIters; k += 2) {
+          const int idx0 = tid + k * kBlockThreads;
+          const int idx1 = tid + (k + 1) * kBlockThreads;
+          const bool h0 = (idx0 < v_count);
+          const bool h1 = (idx1 < v_count);
+          uint4 p0 = {}, p1 = {};
+          uint4 r0 = {}, r1 = {};
+          if (h0) p0 = ld_peer_v4<IS_SHM>(my_slot + v_start + idx0);
+          if (h1) p1 = ld_peer_v4<IS_SHM>(my_slot + v_start + idx1);
+          if constexpr (HAS_RES) {
+            if (h0) r0 = ld_local_v4(residual + v_start + idx0);
+            if (h1) r1 = ld_local_v4(residual + v_start + idx1);
+          }
+          if (h0) {
+            reduce_and_store_v4<RANK, HAS_RES>(
+                loc[k], p0, r0, out_sum + v_start + idx0,
+                HAS_RES ? (out_res + v_start + idx0) : nullptr, write_sum);
+          }
+          if (h1) {
+            reduce_and_store_v4<RANK, HAS_RES>(
+                loc[k + 1], p1, r1, out_sum + v_start + idx1,
+                HAS_RES ? (out_res + v_start + idx1) : nullptr, write_sum);
+          }
+        }
+      }
+    }
+  }
+
+  ar_grid_commit(dev_ctrl, seq, tid);
+}
+
+// ---------------------------------------------------------------------------
+// Kernel 1b: p2p_allreduce_residual (chunked streaming path)
+// ---------------------------------------------------------------------------
+
+template <int RANK, bool IS_SHM, bool HAS_RES>
+__global__ __launch_bounds__(kBlockThreads, 4)
+void p2p_allreduce_residual_stream_kernel(
+    const uint4* x_partial,
+    const uint4* residual,
+    uint4* out_sum,
+    uint4* out_res,
+    uint8_t* __restrict__ my_inbox,
+    FlagLine* __restrict__ my_flags,
+    uint8_t* __restrict__ peer_inbox,
+    FlagLine* __restrict__ peer_flags,
+    DeviceControlState* __restrict__ dev_ctrl,
+    HostMappedControl* __restrict__ host_ctrl,
+    uint64_t slot_bytes,
+    uint32_t expected_gen,
+    int64_t total_vecs,
+    int64_t max_chunk_vecs,
+    bool write_sum) {
+  __shared__ uint64_t s_base_seq;
+  __shared__ uint32_t s_err;
+
+  const int bid = blockIdx.x;
+  const int tid = threadIdx.x;
+  if (tid == 0) {
+    s_base_seq = ld_acquire_gpu_u64(&dev_ctrl->ar_op_seq);
+    s_err = check_entry_status(dev_ctrl, host_ctrl, expected_gen);
+  }
+  __syncthreads();
+  const uint64_t base_seq = s_base_seq;
+
+  uint64_t chunk_idx = 0ull;
+  for (int64_t chunk_off = 0; chunk_off < total_vecs; chunk_off += max_chunk_vecs, ++chunk_idx) {
+    const int cur_vecs = static_cast<int>(
+        (total_vecs - chunk_off < max_chunk_vecs) ? (total_vecs - chunk_off) : max_chunk_vecs);
+    const uint64_t seq = base_seq + 1ull + chunk_idx;
+    const int slot = static_cast<int>(seq & kSlotMask);
+    const uint64_t flag_val = pack_flag(seq, kOpKindArStream);
+
+    int v_start = 0, v_count = 0;
+    partition_aligned_128b(cur_vecs, kFixedGrid, bid, v_start, v_count);
+    if (v_count <= 0) continue;
+
+    if (s_err != 0u) {
+      if (write_sum) poison_v4_stripe(out_sum, chunk_off + v_start, v_count, tid);
+      if constexpr (HAS_RES) poison_v4_stripe(out_res, chunk_off + v_start, v_count, tid);
+      continue;
+    }
+
+    uint4* peer_slot = reinterpret_cast<uint4*>(peer_inbox + static_cast<size_t>(slot) * slot_bytes);
+    const uint4* my_slot = reinterpret_cast<const uint4*>(my_inbox + static_cast<size_t>(slot) * slot_bytes);
+
+    int i = tid;
+    for (; i + kBlockThreads < v_count; i += 2 * kBlockThreads) {
+      uint4 v0 = ld_local_v4(x_partial + chunk_off + v_start + i);
+      uint4 v1 = ld_local_v4(x_partial + chunk_off + v_start + i + kBlockThreads);
+      st_peer_v4<IS_SHM>(peer_slot + v_start + i, v0);
+      st_peer_v4<IS_SHM>(peer_slot + v_start + i + kBlockThreads, v1);
+    }
+    if (i < v_count) {
+      uint4 v0 = ld_local_v4(x_partial + chunk_off + v_start + i);
+      st_peer_v4<IS_SHM>(peer_slot + v_start + i, v0);
+    }
+
+    __syncthreads();
+    if (tid == 0) {
+      st_release_sys_u64(&peer_flags[slot * kFixedGrid + bid].val, flag_val);
+      s_err = wait_for_peer_flag(my_flags, slot, bid, flag_val, dev_ctrl, host_ctrl, expected_gen);
+    }
+    __syncthreads();
+    if (s_err != 0u) {
+      if (write_sum) poison_v4_stripe(out_sum, chunk_off + v_start, v_count, tid);
+      if constexpr (HAS_RES) poison_v4_stripe(out_res, chunk_off + v_start, v_count, tid);
+      continue;
+    }
+
+    for (int j = tid; j < v_count; j += kBlockThreads) {
+      int64_t gidx = chunk_off + v_start + j;
+      uint4 loc = ld_local_v4(x_partial + gidx);
+      uint4 peer = ld_peer_v4<IS_SHM>(my_slot + v_start + j);
+      uint4 res = {};
+      if constexpr (HAS_RES) {
+        res = ld_local_v4(residual + gidx);
+      }
+      reduce_and_store_v4<RANK, HAS_RES>(
+          loc, peer, res, out_sum + gidx,
+          HAS_RES ? (out_res + gidx) : nullptr, write_sum);
+    }
+    __syncthreads();
+  }
+
+  ar_grid_commit(dev_ctrl, base_seq + chunk_idx, tid);
+}
+
+// ---------------------------------------------------------------------------
+// Weight load helpers for RMSNorm (BF16 or FP32)
+// ---------------------------------------------------------------------------
+
+template <bool WEIGHT_FP32>
+__device__ __forceinline__ void load_rms_weight_8(
+    const void* __restrict__ w_ptr, int vec_idx, float w_out[8]) {
+  if constexpr (WEIGHT_FP32) {
+    const float4* wf = reinterpret_cast<const float4*>(w_ptr);
+    float4 a = wf[vec_idx * 2];
+    float4 b = wf[vec_idx * 2 + 1];
+    w_out[0] = a.x; w_out[1] = a.y; w_out[2] = a.z; w_out[3] = a.w;
+    w_out[4] = b.x; w_out[5] = b.y; w_out[6] = b.z; w_out[7] = b.w;
+  } else {
+    const uint4* wb = reinterpret_cast<const uint4*>(w_ptr);
+    uint4 raw = ld_local_v4(wb + vec_idx);
+    float2 p0 = bf16x2_to_f32x2(raw.x);
+    float2 p1 = bf16x2_to_f32x2(raw.y);
+    float2 p2 = bf16x2_to_f32x2(raw.z);
+    float2 p3 = bf16x2_to_f32x2(raw.w);
+    w_out[0] = p0.x; w_out[1] = p0.y;
+    w_out[2] = p1.x; w_out[3] = p1.y;
+    w_out[4] = p2.x; w_out[5] = p2.y;
+    w_out[6] = p3.x; w_out[7] = p3.y;
+  }
+}
