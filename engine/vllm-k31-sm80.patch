+    mode_lo, k_lo = select_optimal_action(
+        probs=probs_lo,
+        accept_rate=0.35,
+        accept_weight=0.15,
+        allowed_k=(1, 3, 4, 5, 7, 9),
+        legal_cks=cks,
+        costs=costs,
