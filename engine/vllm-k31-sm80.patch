+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""K31QManifest on a good tiny checkpoint, on its stage views and on
+checkpoints broken one way each; and the byte-range reader."""
+
+import dataclasses
+import json
+
+import numpy as np
+import pytest
+
+from tests.models.kimi_k3.sm80 import k31q_fixture as fixture
+from vllm.sm80.kernels.k31q.manifest import K31QManifest, layer_of, read_rows
+
+LAYERS = fixture.TEXT["num_hidden_layers"]
+L1 = f"{fixture.P}layers.1."
+EXPERTS1 = L1 + "block_sparse_moe.experts"
+BOOK1 = fixture.expert_rate(1)
+# Record bytes of layer 1 w1 (gate): 128 rows of latent / dim vectors.
+RECORD1 = fixture.vq_record_bytes(
+    "in_latent",
+    fixture.TEXT["routed_expert_hidden_size"],
+    fixture.RATES[BOOK1][0],
+    fixture.RATES[BOOK1][1],
+    fixture.RATES[BOOK1][2],
+)
+
+
+@pytest.fixture(scope="module")
+def checkpoint(tmp_path_factory):
+    directory = tmp_path_factory.mktemp("k31q")
+    fixture.write_checkpoint(directory)
+    return directory
+
+
+def test_good_checkpoint(checkpoint):
+    manifest = K31QManifest(checkpoint)
+    assert sorted(manifest.layers) == list(range(LAYERS)) and manifest.stage is None
+    assert set(manifest.codebooks) == set(fixture.RATES)
+    assert [manifest.expert_method(n) for n in range(1, LAYERS)] == [
+        "exl3" if n in fixture.EXL3_EXPERT_LAYERS else "vq" for n in range(1, LAYERS)
+    ]
+    with pytest.raises(ValueError, match="holds no routed experts"):
+        manifest.expert_method(0)
+    assert manifest.layer_prefix(3) == f"{fixture.P}layers.3."
+    assert manifest.tensor_layer(L1 + "input_layernorm.weight") == 1
+    assert manifest.tensor_layer(fixture.P + "embed_tokens.weight") is None
+    assert (
+        layer_of(L1 + "self_attn.o_proj.trellis") == 1
+        and layer_of("vq." + BOOK1) is None
+    )
+
+    text = fixture.TEXT
+    experts, latent, inter = (
+        text["num_experts"],
+        text["routed_expert_hidden_size"],
+        text["moe_intermediate_size"],
+    )
+    for name, role in fixture.PROJECTIONS:
+        projection = manifest.expert_projections[1, name]
+        dim, bits, group = fixture.RATES[BOOK1]
+        assert (projection.method, projection.role, projection.codebook) == (
+            "vq",
+            role,
+            BOOK1,
+        )
+        assert (projection.dim, projection.index_bits, projection.group_size) == (
+            2,
+            3,
+            128,
+        )
+        assert (projection.experts, projection.blocks) == (experts, inter // 128)
+        assert projection.geometry(latent).record_bytes == fixture.vq_record_bytes(
+            role, latent, dim, bits, group
+        )
+        assert projection.keys == (
+            f"{EXPERTS1}.{name}.vq_idx",
+            f"{EXPERTS1}.{name}.vq_scale",
+        )
+        projection.validate(experts, latent, inter)
+        for wrong, match in (
+            ((experts + 1, latent, inter), "experts"),
+            ((experts, 2 * latent, inter), "expected"),
+            ((experts, latent, 2 * inter), "I-blocks"),
+        ):
+            with pytest.raises(ValueError, match=match):
+                projection.validate(*wrong)
+    # The projections of one layer may differ in rate; the method is shared.
+    mixed = [manifest.expert_projections[4, w].codebook for w in ("w1", "w3", "w2")]
+    assert (
+        mixed == ["vq_d4_b6", "vq_d4_b6", "vq_d2_b4"]
+        and manifest.expert_method(4) == "vq"
+    )
+    fallback = manifest.expert_projections[fixture.EXL3_EXPERT_LAYERS[0], "w2"]
+    assert (fallback.method, fallback.experts, fallback.blocks) == (
+        "exl3",
+        experts,
+        inter // 128,
+    )
+    assert len(fallback.keys) == 4 * experts
+    fallback.validate(experts, latent, inter)
+    # Dense: EXL3 by the fork's header rules, plain where the format says plain.
+    assert manifest.matrices[L1 + "self_attn.o_proj"].bits_x2 == 12
+    assert manifest.matrices[L1 + "self_attn.q_proj"].bits_x2 == 10
+    for plain in ("f_a_proj", "b_proj", "f_b_proj"):
+        assert L1 + f"self_attn.{plain}" not in manifest.matrices
+        assert L1 + f"self_attn.{plain}.weight" in manifest.tensors
