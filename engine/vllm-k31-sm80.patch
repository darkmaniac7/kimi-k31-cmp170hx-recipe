+def run_kda_check(mini: Path) -> dict[str, Any]:
+    from vllm.model_executor.layers.mamba.ops.causal_conv1d import causal_conv1d_update
+    from vllm.models.kimi_k3.nvidia.ops.third_party.kda import (
+        fused_recurrent_kda_packed_decode,
+    )
+    from vllm.sm80.kernels.exl3.utils import Exl3LoadLedger
+    from vllm.sm80.kernels.k31q import glue
+    from vllm.sm80.kernels.k31q.manifest import K31QManifest
+    from vllm.third_party.flash_linear_attention.ops.kda import FusedRMSNormGated
+
+    device = torch.device("cuda:0")
+    manifest = K31QManifest(mini)
+    H, D = 96, 128
+    C = 3 * H * D
+    records: list[dict[str, Any]] = []
+    max_rel_o = 0.0
+    max_rel_s = 0.0
+
+    for lid in (0, 1):
+        attn_in = gpu.tensors(mini / "ref_acts.safetensors", f"L{lid}.attn_in.q", device=device)[0]
+        layer_path = mini / f"layer-{lid:03d}.safetensors"
+        with ExitStack() as stack:
+            files = {layer_path: stack.enter_context(safe_open(str(layer_path), framework="pt", device="cpu"))}
+            ledger = Exl3LoadLedger(manifest)
+            qkvg_prefixes = [f"{LAYER_PREFIX}{lid}.self_attn.{p}" for p in ("q_proj", "k_proj", "v_proj", "g_proj")]
+            qkvg_launcher, _ = _load_exl3_launcher(manifest, files, ledger, qkvg_prefixes, [12288] * 4, 7168)
+
+            f_a_w = _load_layer_plain(mini, lid, "self_attn.f_a_proj.weight", device).contiguous()
+            b_w = _load_layer_plain(mini, lid, "self_attn.b_proj.weight", device).contiguous()
+            f_b_w = _load_layer_plain(mini, lid, "self_attn.f_b_proj.weight", device).contiguous()
+            qc = _load_layer_plain(mini, lid, "self_attn.q_conv1d.weight", device).view(-1, 4).to(torch.bfloat16)
+            kc = _load_layer_plain(mini, lid, "self_attn.k_conv1d.weight", device).view(-1, 4).to(torch.bfloat16)
+            vc = _load_layer_plain(mini, lid, "self_attn.v_conv1d.weight", device).view(-1, 4).to(torch.bfloat16)
+            conv_w = torch.cat([qc, kc, vc], dim=0).contiguous()
+            a_log = _load_layer_plain(mini, lid, "self_attn.A_log", device)[:H].contiguous()
+            dt_bias = _load_layer_plain(mini, lid, "self_attn.dt_bias", device).contiguous()
+            o_norm_w = _load_layer_plain(mini, lid, "self_attn.o_norm.weight", device).contiguous()
+
+            o_norm_mod = FusedRMSNormGated(D, activation="sigmoid", eps=1e-5, device=device, dtype=torch.float32)
+            o_norm_mod.weight.data.copy_(o_norm_w)
+
+            for M in (1, 4, 8):
+                x = attn_in[:M].contiguous()
+                qkvg = qkvg_launcher(x, torch.bfloat16)
+                mixed_qkv = qkvg[:, :C].contiguous()
+                g2 = qkvg[:, C:].view(M, H, D).contiguous()
+                f_a = F.linear(x, f_a_w)
+                raw_beta = F.linear(x, b_w).contiguous()
+                raw_g = F.linear(f_a, f_b_w).view(M, H, D).contiguous()
+
+                torch.manual_seed(700 + lid * 32 + M)
+                slots = 12
+                cs0 = torch.randn((slots, C, 3), dtype=torch.bfloat16, device=device) * 0.25
+                rs0 = torch.randn((slots, H, D, D), dtype=torch.float32, device=device) * 0.03
+                sidx = torch.arange(M, dtype=torch.int32, device=device) + 1
+
+                # 1. Exact PyTorch FP32 reference
+                ref_o, ref_cs, ref_rs = ref_fused_kda_decode(
+                    mixed_qkv, cs0, conv_w, None, raw_g, raw_beta, a_log, dt_bias, g2,
+                    o_norm_w, rs0, sidx, -5.0, 1e-5,
+                )
+
+                # 2a. Stock vLLM SM80 Triton recurrence + FusedRMSNormGated fed
+                # exact FP32-accumulated conv1d (isolating causal_conv1d.py:1078
+                # BF16 tap product `matrix_x * matrix_w` rounding).
+                fp32_post = torch.empty_like(mixed_qkv)
+                for bi in range(M):
+                    sl = int(sidx[bi].item())
+                    cat4 = torch.cat([cs0[sl], mixed_qkv[bi].unsqueeze(-1)], dim=-1).float()
+                    fp32_post[bi] = F.silu((cat4 * conv_w.float()).sum(dim=-1)).to(torch.bfloat16)
+                rs_tri_rec = rs0.clone()
+                tri_raw_rec = torch.empty((1, M, H, D), dtype=torch.bfloat16, device=device)
+                fused_recurrent_kda_packed_decode(
+                    mixed_qkv=fp32_post,
+                    raw_g=raw_g.unsqueeze(0),
+                    raw_beta=raw_beta.unsqueeze(0),
+                    A_log=a_log,
+                    dt_bias=dt_bias,
+                    lower_bound=-5.0,
+                    initial_state=rs_tri_rec,
+                    state_indices=sidx,
+                    out=tri_raw_rec,
+                )
+                tri_o_rec = o_norm_mod(tri_raw_rec, g2)[0]
+
+                # 2b. Full unmodified Triton 4-kernel path (incl. BF16-mul conv1d)
+                cs_tri = cs0.clone()
+                rs_tri = rs0.clone()
+                conv_out = torch.empty_like(mixed_qkv)
+                post_qkv = causal_conv1d_update(
+                    mixed_qkv, cs_tri, conv_w, None, activation="silu",
+                    conv_state_indices=sidx, validate_data=True, out=conv_out,
+                )
+                tri_raw = torch.empty((1, M, H, D), dtype=torch.bfloat16, device=device)
+                fused_recurrent_kda_packed_decode(
+                    mixed_qkv=post_qkv,
+                    raw_g=raw_g.unsqueeze(0),
+                    raw_beta=raw_beta.unsqueeze(0),
+                    A_log=a_log,
+                    dt_bias=dt_bias,
+                    lower_bound=-5.0,
+                    initial_state=rs_tri,
+                    state_indices=sidx,
+                    out=tri_raw,
+                )
+                tri_o = o_norm_mod(tri_raw, g2)[0]
+
+                # 3. Glue 1-launch fused_kda_decode
+                cs_glue = cs0.clone()
+                rs_glue = rs0.clone()
+                glue_o = torch.empty((M, H, D), dtype=torch.bfloat16, device=device)
+                glue.fused_kda_decode(
+                    mixed_qkv, cs_glue, conv_w, None, raw_g, raw_beta, a_log, dt_bias, g2,
+                    o_norm_w, rs_glue, sidx, -5.0, 1e-5, glue_o,
+                )
+
+                rel_o_fp32 = _rel_l2(glue_o, ref_o)
+                rel_s_fp32 = _rel_l2(rs_glue, ref_rs)
+                rel_o_tri_rec = _rel_l2(glue_o, tri_o_rec)
+                rel_s_tri_rec = _rel_l2(rs_glue, rs_tri_rec)
+                rel_o_tri_bf16conv = _rel_l2(glue_o, tri_o)
+                rel_s_tri_bf16conv = _rel_l2(rs_glue, rs_tri)
+                assert torch.equal(cs_glue, ref_cs), f"L{lid} M={M}: conv_state mismatch vs ref"
+                assert torch.equal(cs_glue, cs_tri), f"L{lid} M={M}: conv_state mismatch vs Triton"
+                assert rel_o_fp32 <= BOUND_KDA_OUT_REL_L2, f"L{lid} M={M}: rel_o={rel_o_fp32}"
+                assert rel_o_tri_rec <= BOUND_KDA_OUT_REL_L2, f"L{lid} M={M}: rel_o_tri_rec={rel_o_tri_rec}"
+                assert rel_s_fp32 <= BOUND_KDA_STATE_REL_L2, f"L{lid} M={M}: rel_s={rel_s_fp32}"
+                assert rel_s_tri_rec <= BOUND_KDA_STATE_REL_L2, f"L{lid} M={M}: rel_s_tri_rec={rel_s_tri_rec}"
+                max_rel_o = max(max_rel_o, rel_o_fp32, rel_o_tri_rec)
+                max_rel_s = max(max_rel_s, rel_s_fp32, rel_s_tri_rec)
+                records.append(
+                    {
+                        "layer": lid,
+                        "M": M,
+                        "rel_out_vs_fp32": rel_o_fp32,
+                        "rel_out_vs_triton_rec": rel_o_tri_rec,
+                        "rel_state_vs_fp32": rel_s_fp32,
+                        "rel_state_vs_triton_rec": rel_s_tri_rec,
+                        "rel_out_vs_triton_bf16conv": rel_o_tri_bf16conv,
+                        "rel_state_vs_triton_bf16conv": rel_s_tri_bf16conv,
+                    }
+                )
+        gc.collect()
+        torch.cuda.empty_cache()
+
+    return {
+        "bound_out_rel_l2": BOUND_KDA_OUT_REL_L2,
+        "bound_state_rel_l2": BOUND_KDA_STATE_REL_L2,
+        "max_out_rel_l2": max_rel_o,
+        "max_state_rel_l2": max_rel_s,
+        "cases": records,
+    }
+
