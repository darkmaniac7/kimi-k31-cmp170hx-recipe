+# ------------------------------------------------------------------ GPU
+def gpu_test_small_stack_bitwise():
+    """Real kernel, one card: with the switch against without, on the same
+    inputs, bitwise: outputs (normed and SKIP_NORM), records, the conv window
+    and the state slot, for nseq 1..8, T 1..8 and n accepted 1, T // 2, T.
+    Today's verify: verify k -> commit(n) -> verify k + 1. The fold's: FOLD
+    verify k (nothing owed) -> FOLD verify k + 1 owing n."""
+    from tests.kernels.test_ampere_kda_recover import _context, _inputs
+    from vllm.sm80.kernels.kda import recover as kr
+
+    def v2(k2, p, conv, rec, ssm, acc, T, records, fold=None, skip=False):
+        nseq = ssm.shape[0]
+        out = torch.empty(1, nseq * T, H, D, device="cuda", dtype=torch.bfloat16)
+        return k2.kda_decode_v2(p.qkv, p.beta, p.fa, p.ga, p.wf, p.wg, conv.transpose(-1, -2),
+                                p.cw, None, p.nw, rec, ssm[:, 0], ssm, acc, p.qsl, 8, p.al,
+                                p.gb, out=out, records=records, skip_norm=skip, fold=fold)
+
+    def run(small, fold, nseq, T, n, skip):
+        k2 = _fresh_switch("1" if small else None)
+        k2.warmup(plans=((nseq, T),), recover=True, width=8, fold=fold)
+        nslot = 2 + nseq * 8
+        p = _inputs(nseq, T, 7000 + 10 * T + nseq, nslot)
+        p2 = _inputs(nseq, T, 9000 + 10 * T + nseq, nslot)
+        p.qsl = p2.qsl = torch.arange(0, nseq + 1, device="cuda", dtype=torch.int32) * T
+        ssm = torch.tensor([[1 + 8 * s] for s in range(nseq)], device="cuda",
+                           dtype=torch.int32)
+        ones = torch.ones(nseq, device="cuda", dtype=torch.int32)
+        pool = torch.full((1, 3, 8, kr.WS_T, H, D), float("nan"), device="cuda")
+        rec, conv = p.rec.clone(), p.conv.clone()
+        recs = kr.layer_records(pool, 0)
+        if fold:
+            slots = torch.tensor([(3 * s + 5) % 8 for s in range(nseq)], device="cuda",
+                                 dtype=torch.int32)
+            zero = torch.zeros(nseq, device="cuda", dtype=torch.int32)
+            v2(k2, p, conv, rec, ssm, ones, T, recs, fold=(zero, slots))
+            owed = torch.full((nseq,), n, device="cuda", dtype=torch.int32)
+            y = v2(k2, p2, conv, rec, ssm, ones, T, recs, fold=(owed, slots), skip=skip)
+        else:
+            v2(k2, p, conv, rec, ssm, ones, T, recs)
+            ctx = _context(conv, rec, pool)
+            ctx.commit(torch.full((nseq,), n, device="cuda", dtype=torch.int32),
+                       ssm[:, 0].contiguous(), p.qsl)
+            y = v2(k2, p2, conv, rec, ssm, ones, T, recs, skip=skip)
+        torch.cuda.synchronize()
+        rows = [1 + 8 * s for s in range(nseq)]
+        return (y.view(torch.int16), pool.view(torch.int32), conv[rows].view(torch.int16),
+                rec[rows].view(torch.int32))
+
+    saved = os.environ.pop("VLLM_AMPERE_KDA_SMALL_STACK", None)
+    nfail = checks = 0
+    try:
+        for fold in (False, True):
+            for nseq in range(1, 9):
+                for T in range(1, 9):
+                    for n in sorted({1, max(1, T // 2), T}):
+                        for skip in (False, True):
+                            a = run(False, fold, nseq, T, n, skip)
+                            b = run(True, fold, nseq, T, n, skip)
+                            checks += 1
+                            if not all(torch.equal(x, y) for x, y in zip(a, b)):
+                                nfail += 1
+                                print(f"  FAIL fold={fold} nseq={nseq} T={T} n={n} skip={skip}")
+    finally:
+        _fresh_switch(saved)
+    print(f"  {checks - nfail}/{checks} bitwise")
+    assert nfail == 0
+
+
+# Every shape where the small-stack rule changed from 8 to 16 rows at 16 heads:
+# nseq 7-8 (the only one-warp 32-row configs), every token tile, today's
+# RecoverSSM verify and the fold's.
+GRID_16_VS_8 = [(fold, nseq, T) for fold in (False, True) for nseq in (7, 8)
+                for T in range(1, 9)]
+
+
+def _bitwise_16_vs_8(fold, nseq, T):
+    """Failures of the 16-row small-stack config against the 8-row one (switch
+    on, one warp each) at (nseq, T), max_query_len T, width-8 state index
+    rows, normed and SKIP_NORM, n accepted / owed in {1, T}. Today's verify:
+    verify k -> commit(n) -> verify k + 1. The fold's: FOLD verify k (nothing
+    owed) -> FOLD verify k + 1 owing n. After every step, bitwise (integer
+    views): out, records c / k / e, the whole conv cache and state pool."""
+    from tests.kernels.test_ampere_kda_recover import _context, _inputs
+    from vllm.sm80.kernels.kda import recover as kr
+
+    def snap(out, pool, conv, rec):
+        torch.cuda.synchronize()
+        s = {"c": pool[0, 0].view(torch.int32).clone(),
+             "k": pool[0, 1].view(torch.int32).clone(),
+             "e": pool[0, 2].view(torch.int32).clone(),
+             "conv": conv.view(torch.int16).clone(), "state": rec.view(torch.int32).clone()}
+        if out is not None:
+            s["out"] = out.view(torch.int16).clone()
+        return s
+
+    def run(k2, rows, n, skip):
+        k2.SMALL_STACK_ROWS_MAX = rows
+        assert k2._select(nseq, H, D, small_stack=True) == (rows, 1)
+        nslot = 2 + nseq * 8
+        p = _inputs(nseq, T, 7100 + 10 * T + nseq, nslot)
+        p2 = _inputs(nseq, T, 9100 + 10 * T + nseq, nslot)
+        p.qsl = p2.qsl = torch.arange(0, nseq + 1, device="cuda", dtype=torch.int32) * T
+        ssm = torch.tensor([[1 + 8 * s + t for t in range(8)] for s in range(nseq)],
+                           device="cuda", dtype=torch.int32)
+        ones = torch.ones(nseq, device="cuda", dtype=torch.int32)
+        pool = torch.full((1, 3, 8, kr.WS_T, H, D), float("nan"), device="cuda")
+        rec, conv = p.rec.clone(), p.conv.clone()
+        recs = kr.layer_records(pool, 0)
+        slots = torch.tensor([(3 * s + 5) % 8 for s in range(nseq)], device="cuda",
+                             dtype=torch.int32)
+
+        def verify(q, owed):
+            out = torch.empty(1, nseq * T, H, D, device="cuda", dtype=torch.bfloat16)
+            k2.kda_decode_v2(q.qkv, q.beta, q.fa, q.ga, q.wf, q.wg, conv.transpose(-1, -2),
+                             q.cw, None, q.nw, rec, ssm[:, 0], ssm, ones, q.qsl, T, q.al,
+                             q.gb, out=out, records=recs, skip_norm=skip,
+                             fold=None if owed is None else (
+                                 torch.full((nseq,), owed, device="cuda", dtype=torch.int32),
+                                 slots))
+            return snap(out, pool, conv, rec)
+
+        if fold:
+            return [("verify owed 0", verify(p, 0)), (f"verify owed {n}", verify(p2, n))]
+        steps = [("verify", verify(p, None))]
+        _context(conv, rec, pool).commit(
+            torch.full((nseq,), n, device="cuda", dtype=torch.int32),
+            ssm[:, 0].contiguous(), p.qsl)
+        steps.append((f"commit {n}", snap(None, pool, conv, rec)))
+        steps.append(("verify", verify(p2, None)))
+        return steps
+
+    saved = os.environ.pop("VLLM_AMPERE_KDA_SMALL_STACK", None)
+    k2 = _fresh_switch("1")
+    saved_rows = k2.SMALL_STACK_ROWS_MAX
+    fails, checks = [], 0
+    try:
+        for n in sorted({1, T}):
+            for skip in (False, True):
+                a, b = run(k2, 8, n, skip), run(k2, 16, n, skip)
+                for (step, sa), (_, sb) in zip(a, b):
+                    checks += 1
+                    bad = [key for key in sa if not torch.equal(sa[key], sb[key])]
+                    if bad:
+                        fails.append(f"fold={fold} nseq={nseq} T={T} n={n} skip={skip} "
+                                     f"{step}: {bad}")
+    finally:
+        k2.SMALL_STACK_ROWS_MAX = saved_rows
+        _fresh_switch(saved)
+    return fails, checks
+
+
+def gpu_test_16_rows_bitwise_8_rows():
+    """Real kernel, one card: _bitwise_16_vs_8 over GRID_16_VS_8."""
+    nfail = checks = 0
+    for case in GRID_16_VS_8:
+        fails, n = _bitwise_16_vs_8(*case)
+        checks += n
+        nfail += len(fails)
+        for f in fails:
+            print(f"  FAIL {f}")
+    print(f"  {checks - nfail}/{checks} bitwise (16 rows vs 8 rows)")
+    assert nfail == 0
+
+
+CPU_TESTS = (test_select_pinned, test_switch_and_configs, test_banner_and_set_but_off,
+             test_verify_stack, test_small_stack_config_stack)
+GPU_TESTS = (gpu_test_small_stack_bitwise, gpu_test_16_rows_bitwise_8_rows)
+
+if pytest is not None:
+    _needs_gpu = pytest.mark.skipif(not torch.cuda.is_available(), reason="needs an sm_80 GPU")
+    test_gpu_small_stack_bitwise = _needs_gpu(gpu_test_small_stack_bitwise)
+
+    @_needs_gpu
+    @pytest.mark.parametrize("fold,nseq,T", GRID_16_VS_8, ids=[
+        f"{'fold' if f else 'nofold'}-n{n}-t{t}" for f, n, t in GRID_16_VS_8])
+    def test_gpu_16_rows_bitwise_8_rows(fold, nseq, T):
+        fails, checks = _bitwise_16_vs_8(fold, nseq, T)
+        print(f"  {checks - len(fails)}/{checks} bitwise (16 rows vs 8 rows)")
+        assert not fails, fails
+
+
+def _main():
+    import traceback
+
+    tests = list(CPU_TESTS)
+    if os.environ.get("CUDA_VISIBLE_DEVICES", "") != "" and torch.cuda.is_available():
+        tests += list(GPU_TESTS)
+    failed = skipped = 0
+    skips = (unittest.SkipTest,) + ((pytest.skip.Exception,) if pytest is not None else ())
+    for t in tests:
+        try:
+            t()
+            print(f"PASS {t.__name__}", flush=True)
+        except skips as e:
+            skipped += 1
+            print(f"SKIP {t.__name__}: {e}", flush=True)
+        except Exception:
+            failed += 1
+            print(f"FAIL {t.__name__}", flush=True)
+            traceback.print_exc()
+    print(f"\n{len(tests) - failed - skipped}/{len(tests)} passed, {skipped} skipped")
+    sys.exit(1 if failed else 0)
+
+
+if __name__ == "__main__":
+    _main()
diff --git a/tests/kernels/test_ampere_kda_step_tile.py b/tests/kernels/test_ampere_kda_step_tile.py
new file mode 100644
index 0000000000..18ed011dca
--- /dev/null
+++ b/tests/kernels/test_ampere_kda_step_tile.py
@@ -0,0 +1,193 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Tests for the step tile of the fused KDA decode kernel (token tile from the
+step's max tokens per request; always on, no switch of its own).
+
+CPU part: the tile helper, the metadata field default.
+GPU part (skipped without CUDA): for the v2 kernel and the v2 recover verify
+(normed and SKIP_NORM), max_query_len = the step's tokens per
+request (tile 1/2/4/8) gives bitwise the result of max_query_len = 8 (the
+full window, what is launched today): outputs, recurrent state, conv state,
+records.
+
+    CUDA_VISIBLE_DEVICES=<gpu> python tests/kernels/test_ampere_kda_step_tile.py
+"""
+
+import importlib.util
+import os
+
+try:
+    import pytest
+except ImportError:
+    pytest = None
+import torch
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+
+def _rec_tests():
+    spec = importlib.util.spec_from_file_location(
+        "_trec", os.path.join(HERE, "test_ampere_kda_recover.py"))
+    m = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(m)
+    return m
+
+
+# ------------------------------------------------------------------ CPU tests
+
+def test_no_switch_of_its_own():
+    """The former VLLM_GLM5_DECODE_KDA_STEP_TILE switch is gone (validated in
+    1.7.0)."""
+    from vllm import envs
+
+    assert "VLLM_GLM5_DECODE_KDA_STEP_TILE" not in envs.environment_variables
+
+
+def test_tile_helper():
+    from vllm.models.glm5next.nvidia.ops.kda_decode import _kda_tile
+
+    assert _kda_tile(None, 8) == 8
+    assert _kda_tile(4, 8) == 4
+    assert _kda_tile(12, 8) == 8          # mixed step: prefill rows raise the bound
+    assert _kda_tile(0, 8) == 1
+    # recover verify: the window unless the token tile shrinks
+    assert _kda_tile(4, 8, keep_same_rows=True) == 4
+    assert _kda_tile(6, 8, keep_same_rows=True) == 8
+    assert _kda_tile(5, 8, keep_same_rows=True) == 8
+    assert _kda_tile(2, 4, keep_same_rows=True) == 2
+    assert _kda_tile(3, 4, keep_same_rows=True) == 4
+
+
+def test_metadata_field_default():
+    from vllm.sm80.kernels.kda.recover import Glm5NextGDNAttentionMetadata
+
+    f = {x.name: x for x in
+         __import__("dataclasses").fields(Glm5NextGDNAttentionMetadata)}
+    assert "spec_max_query_len" in f and f["spec_max_query_len"].default is None
+
+
+# ------------------------------------------------------------------ GPU tests
+
+def _eq(a, b):
+    return torch.equal(a.view(torch.int32) if a.dtype == torch.float32 else a,
+                       b.view(torch.int32) if b.dtype == torch.float32 else b)
+
+
+def gpu_test_tile_is_bitwise_the_full_window():
+    from vllm.models.glm5next.nvidia.ops import kda_decode as k2
+    from vllm.sm80.kernels.kda import recover as kr
+
+    tr = _rec_tests()
+    H, D = tr.H, tr.D
+    bad = []
+    for T in range(1, 9):
+        for nseq in (1, 4, 8):
+            nslot = 2 + nseq * 8
+            p = tr._inputs(nseq, T, 300 + 10 * T + nseq, nslot)
+            p.qsl = torch.arange(0, nseq + 1, device="cuda", dtype=torch.int32) * T
+            ssm8 = torch.as_tensor([[1 + s * 8 + t for t in range(8)] for s in range(nseq)],
+                                   device="cuda", dtype=torch.int32)
+            acc = torch.as_tensor([1 + (s * 3) % T for s in range(nseq)], device="cuda",
+                                  dtype=torch.int32)
+            M = nseq * T
+            for q in sorted({T, 8}):
+                k2.warmup(plans=((nseq, q),), width=8)
+                k2.warmup(plans=((nseq, q),), recover=True)
+
+            def run(kind, q):
+                rec, conv = p.rec.clone(), p.conv.clone()
+                out = torch.zeros(1, M, H, D, device="cuda", dtype=torch.bfloat16)
+                pool = torch.zeros(1, 3, 8, kr.WS_T, H, D, device="cuda")
+                if kind == "v2":
+                    k2.kda_decode_v2(p.qkv, p.beta, p.fa, p.ga, p.wf, p.wg,
+                                     conv.transpose(-1, -2), p.cw, None, p.nw, rec,
+                                     ssm8[:, 0], ssm8, acc, p.qsl, q, p.al, p.gb, out=out)
+                else:
+                    ssm1 = ssm8[:, :1].contiguous()
+                    ones = torch.ones(nseq, device="cuda", dtype=torch.int32)
+                    k2.kda_decode_v2(p.qkv, p.beta, p.fa, p.ga, p.wf, p.wg,
+                                     conv.transpose(-1, -2), p.cw, None, p.nw, rec,
+                                     ssm1[:, 0], ssm1, ones, p.qsl, q, p.al, p.gb, out=out,
+                                     records=kr.layer_records(pool, 0),
+                                     skip_norm=(kind == "recover_skip"))
+                torch.cuda.synchronize()
+                return out, rec, conv, pool
+
+            for kind in ("v2", "recover", "recover_skip"):
+                a, b = run(kind, T), run(kind, 8)
+                if not all(_eq(x, y) for x, y in zip(a, b)):
+                    bad.append((kind, T, nseq))
+    assert not bad, bad
+    print("  tile = tokens per request is bitwise the 8-row window for v2, recover, "
+          "recover SKIP_NORM at T 1..8 x nseq 1/4/8")
+
+
+def gpu_test_warmup_covers_every_tile():
+    """The v2 warmup compiles (nseq, t) for t = 1..num_spec+1 where the v2 gate
+    admits it."""
+    import types
+
+    from vllm.sm80.kernels import _platform
+    from vllm.models.glm5next.nvidia.ops import kda_decode
+
+    w = torch.zeros(16 * 128, 128, device="cuda", dtype=torch.bfloat16)
+    layer = types.SimpleNamespace(_conv_state_dim_first=False, local_num_heads=16,
+                                  head_dim=128, num_spec=3, _kda_step_tile=True,
+                                  _kda_v2=True, _kda_wide=False, _kda_recover=False,
+                                  f_b_proj=types.SimpleNamespace(weight=w),
+                                  g_b_proj=types.SimpleNamespace(weight=w))
+    model = torch.nn.Module()
+    worker = types.SimpleNamespace(vllm_config=types.SimpleNamespace(
+        scheduler_config=types.SimpleNamespace(max_num_seqs=2)))
+    saved = kda_decode.find_module
+    kda_decode.find_module = lambda model, attr: layer
+    old = {k: os.environ.get(k) for k in ("VLLM_AMPERE_DECODE_KERNELS",)}
+    os.environ.update(VLLM_AMPERE_DECODE_KERNELS="1")
+    sm80 = _platform._SM80_CACHE
+    _platform._SM80_CACHE = True
+    try:
+        kda_decode._WARMED.clear()
+        kda_decode._warmup_kda_v2(worker, model, "cuda", [1, 2, 4, 8])
+        got = sorted({(k[0], k[1]) for k in kda_decode._WARMED})
+        assert got == [(n, t) for n in (1, 2) for t in (1, 2, 3, 4)], got
+    finally:
+        kda_decode.find_module = saved
+        _platform._SM80_CACHE = sm80
+        for k, v in old.items():
+            if v is None:
+                os.environ.pop(k, None)
+            else:
+                os.environ[k] = v
+
+
+CPU_TESTS = (test_no_switch_of_its_own, test_tile_helper, test_metadata_field_default)
+GPU_TESTS = (gpu_test_tile_is_bitwise_the_full_window, gpu_test_warmup_covers_every_tile)
+
+if pytest is not None:
+    _needs_gpu = pytest.mark.skipif(not torch.cuda.is_available(), reason="needs an sm_80 GPU")
+    test_gpu_tile_is_bitwise_the_full_window = _needs_gpu(gpu_test_tile_is_bitwise_the_full_window)
+    test_gpu_warmup_covers_every_tile = _needs_gpu(gpu_test_warmup_covers_every_tile)
+
+
+def _main():
+    import sys
+    import traceback
+
+    tests = list(CPU_TESTS)
+    if os.environ.get("CUDA_VISIBLE_DEVICES", "") != "" and torch.cuda.is_available():
+        tests += list(GPU_TESTS)
+    failed = 0
+    for t in tests:
+        try:
+            t()
+            print(f"PASS {t.__name__}")
+        except Exception:
+            failed += 1
+            print(f"FAIL {t.__name__}")
+            traceback.print_exc()
+    print(f"\n{len(tests) - failed}/{len(tests)} passed")
+    sys.exit(1 if failed else 0)
+
+
+if __name__ == "__main__":
+    _main()
diff --git a/tests/kernels/test_ampere_marlin_decode_v2.py b/tests/kernels/test_ampere_marlin_decode_v2.py
