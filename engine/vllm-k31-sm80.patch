+  int cur_t = (warp > 0 ? sh_warp_tsum[warp - 1] : 0) + (wt - sum_t);
+  int loc_gu_mask = 0, loc_dn_mask = 0;
+#pragma unroll
+  for (int k = 0; k < 4; ++k) {
+    const int e = tid * 4 + k;
+    if (e < E) {
+      sh_pos[e] = cur_c;
+      const int c = c4[k];
+      if (c > 0) {
+        uint32_t rids;
+        if (fast_rate) {
+          rids = fast_rids;
+        } else {
+          const int r1 = expert_rate_id(routing.packed_meta, e, 0);
+          const int r3 = expert_rate_id(routing.packed_meta, e, 1);
+          const int r2 = expert_rate_id(routing.packed_meta, e, 2);
+          loc_gu_mask |= (r1 == r3) ? (1 << r1) : (1 << 5);
+          loc_dn_mask |= (1 << r2);
+          rids = static_cast<uint32_t>(r1) | (static_cast<uint32_t>(r3) << 8) | (static_cast<uint32_t>(r2) << 16);
+        }
+        for (int s = 0; s < c; s += 8) {
+          tasks[cur_t++] = TileTask{e, cur_c + s, (c - s < 8) ? (c - s) : 8, rids};
+        }
+      }
+      cur_c += c;
+    }
+  }
+  if (!fast_rate) {
+    if (loc_gu_mask) atomicOr(&sh_masks[0], loc_gu_mask);
+    if (loc_dn_mask) atomicOr(&sh_masks[1], loc_dn_mask);
+  }
+  __syncthreads();
+
+  if (tid == 0) {
+    const int n_tasks = sh_warp_tsum[7];
+    header[0] = n_tasks;
+    if (fast_rate) {
+      header[1] = (n_tasks > 0) ? (1 << rate_id_gu) : 0;
+      header[2] = (n_tasks > 0) ? (1 << rate_id_dn) : 0;
+    } else {
+      header[1] = sh_masks[0];
+      header[2] = sh_masks[1];
+    }
+    header[3] = 0;
+  }
