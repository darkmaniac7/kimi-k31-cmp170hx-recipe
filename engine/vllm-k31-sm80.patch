+"""Shared inputs of the sm_80 Kimi K3.1 DSA tests (test_sm80_dsa_*.py,
+test_sm80_k31_registry.py): fp32 sweeps for the e4m3 conversion, indexer
+caches in both layouts, and Kimi K3.1 configs built from the real
+config.json (fixtures/config.json) with the dimensions a test needs.
+"""
+
+import copy
+import json
+from dataclasses import dataclass
+from pathlib import Path
+
+import torch
+
+from vllm.sm80.kernels.attention.triton_e4m3 import (
+    e4m3_bits_to_f32_fast,
+    f32_to_e4m3_bits,
+)
+from vllm.triton_utils import tl, triton
+
+REAL_CONFIG = Path(__file__).parent / "fixtures" / "config.json"
+
+HEAD_DIM = 128  # index_head_dim of K3.1
+NUM_HEADS = 32  # index_num_heads of K3.1
+ENTRY = HEAD_DIM + 4  # FP8 values + one fp32 scale per key
+BLOCK = 64  # K3.1 kernel page of the indexer cache
+TOPK = 2048
+# Latent bytes per token and layer ahead of the indexer page in a packed
+# block row: 576 bf16 values (the cache the Triton sparse MLA backend reads)
+# or the 656 B of fp8_ds_mla (upstream's default).
+MLA_BYTES_BF16 = 1152
+MLA_BYTES_FP8_DS = 656
+
+
+def packed_row_stride(mla_bytes: int) -> int:
+    """Bytes of one packed block row holding one DSA layer's 64-token MLA
+    page and indexer page, rounded up to whole MLA rows as the sparse MLA
+    backends ask (``align_blocks_to_rows``): 82,944 for bf16, 50,512 for
+    fp8_ds_mla (the constant of upstream's test_dsa_indexer_fused.py)."""
+    row = BLOCK * (mla_bytes + ENTRY)
+    return -(-row // mla_bytes) * mla_bytes
+
+
+def make_index_cache(
+    packed: bool,
+    num_pages: int,
+    device: str | torch.device = "cpu",
+    mla_bytes: int = MLA_BYTES_BF16,
+    fill: int = 0,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """(backing bytes, indexer cache view ``[num_pages, BLOCK, ENTRY]``)."""
+    if not packed:
+        raw = torch.full(
+            (num_pages, BLOCK, ENTRY), fill, dtype=torch.uint8, device=device
+        )
+        return raw, raw
+    stride = packed_row_stride(mla_bytes)
+    raw = torch.full((num_pages, stride), fill, dtype=torch.uint8, device=device)
+    view = torch.as_strided(
+        raw,
+        size=(num_pages, BLOCK, ENTRY),
+        stride=(stride, ENTRY, 1),
+        storage_offset=BLOCK * mla_bytes,
+    )
+    return raw, view
+
+
+def page_bytes(view: torch.Tensor) -> torch.Tensor:
+    """``[num_pages, BLOCK * ENTRY]`` copy of the pages of a cache view, by
+    plain indexing of the view (no layout arithmetic)."""
+    return torch.stack([view[p].reshape(-1) for p in range(view.shape[0])])
+
+
+def keys_by_page_view(view: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """(bits ``[num_pages * BLOCK, HEAD_DIM]``, scale ``[num_pages * BLOCK]``)
+    of every slot, read page by page through the view."""
+    pages = page_bytes(view)
+    bits = pages[:, : BLOCK * HEAD_DIM].reshape(-1, HEAD_DIM)
+    scale = pages[:, BLOCK * HEAD_DIM :].contiguous().view(torch.float32).reshape(-1)
+    return bits, scale
+
+
+def fp32_sweep(low_bits: int, device: str | torch.device = "cpu") -> torch.Tensor:
+    """Every fp32 value whose low 12 mantissa bits are ``low_bits``: 2^20
+    values over both signs and every exponent, zeros, subnormals, infinities
+    and NaNs included. A rounding boundary of float8_e4m3fn (3 mantissa bits)
+    has its low 19 bits zero, so the sweeps with low bits 0x000, 0x001 and
+    0xFFF hold every tie, its successor and its predecessor."""
+    bits = (torch.arange(1 << 20, dtype=torch.int64) << 12) | low_bits
+    bits = torch.where(bits >= 2**31, bits - 2**32, bits).to(torch.int32)
+    return bits.view(torch.float32).contiguous().to(device)
+
+
+SWEEP_LOW_BITS = (0x000, 0x001, 0x7FF, 0x800, 0x801, 0xFFF)
