+    prefix = "language_model.model.layers.1.block_sparse_moe.routed_expert_up_proj"
+    raw = fixture.exl3_synthetic(hidden, latent, bits, rng)
+    tensors = {f"{prefix}.{k}": v for k, v in raw.items()}
+    layer_file = tmp_path / "layer-001.safetensors"
+    fixture.st_write(layer_file, tensors)
+    index = {
+        "metadata": {},
+        "weight_map": {name: "layer-001.safetensors" for name in tensors},
+    }
+    (tmp_path / "model.safetensors.index.json").write_text(json.dumps(index))
+    manifest_data = {
+        "format": "k31q",
+        "version": 1,
+        "source": {"repo": "synthetic", "revision": "k6-up-proj"},
+        "abliteration": {"applied": False},
+        "codebooks": {},
+        "layers": {
+            "1": {
+                "file": ["layer-001.safetensors"],
+                "bytes": layer_file.stat().st_size,
+                "sha256": [fixture.sha256_file(layer_file)],
+                "dense": {
+                    "block_sparse_moe.routed_expert_up_proj": {
+                        "method": "exl3",
+                        "bits": bits,
+                        "shape": [hidden, latent],
+                    }
+                },
+                "experts": {},
+            }
+        },
+        "other": {},
+    }
+    (tmp_path / "k31q_manifest.json").write_text(json.dumps(manifest_data))
+
+    full_trellis = raw["trellis"][1]
+    full_suh = raw["suh"][1]
+    full_svh = raw["svh"][1]
+    full_bytes = full_trellis.nbytes + full_suh.nbytes + full_svh.nbytes
+    assert full_bytes == 19_289_088
+
+    for rank in (0, 1):
+        _parallel_groups(monkeypatch, tp_size=2, tp_rank=rank)
+        quant = K31QConfig()
+        quant.manifest = K31QManifest(tmp_path)
+        layer = ColumnParallelLinear(
+            latent,
+            hidden,
+            bias=False,
+            gather_output=False,
+            params_dtype=torch.bfloat16,
+            quant_config=quant,
+            prefix="model.layers.1.block_sparse_moe.routed_expert_up_proj",
+        )
+        assert type(layer.quant_method) is K31DenseLinearMethod
+        assert len(layer.exl3_weights) == 1
+        w = layer.exl3_weights[0]
+        assert w.logical_in == latent and w.logical_out == hidden // 2
+        assert w.padded_in == latent and w.padded_out == hidden // 2
+        assert w.output_slices == [slice(rank * 3584, (rank + 1) * 3584)]
+        assert tuple(w.trellis.shape) == (224, 224, 96)
+        assert tuple(w.suh.shape) == (3584,)
+        assert tuple(w.svh.shape) == (3584,)
+
+        ledger = Exl3LoadLedger(quant.manifest)
+        with safe_open(str(layer_file), framework="pt", device="cpu") as sf:
+            w.load({layer_file: sf}, ledger)
+        ledger.finish()
+
+        shard_bytes = sum(p.nbytes for p in w.parameters())
+        assert shard_bytes == 9_648_128
+        assert full_bytes - shard_bytes == 9_640_960
+        assert np.array_equal(
+            w.trellis.numpy(), full_trellis[:, rank * 224 : (rank + 1) * 224, :]
+        )
+        assert np.array_equal(_bits(w.suh), full_suh.view(np.uint16))
+        assert np.array_equal(
+            _bits(w.svh), full_svh[rank * 3584 : (rank + 1) * 3584].view(np.uint16)
+        )
