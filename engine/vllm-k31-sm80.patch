+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""K3.1 lever 3: host-side verify width tiers (adaptive_k ``tiers`` and
+``confidence``). CPU only: config refusals, the summary and hysteresis, the
+per-request policy with fresh and stale confidences, the scheduler under
+synchronous and async + pipeline-parallel scheduling, the capture list and
+the pipeline broadcast shapes (worker side: test_k31_width_worker.py)."""
+
+from collections import deque
+from contextlib import nullcontext
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+
+from tests.v1.core.utils import create_requests, create_scheduler
+from vllm.config import SpeculativeConfig
+from vllm.sm80.spec_decode.adaptive_k import (
+    AdaptiveKConfig,
+    AdaptiveKPolicy,
+    expected_accepted,
+    tier_index,
+    width_summary,
+)
+from vllm.v1.core.sched.async_scheduler import AsyncScheduler
+from vllm.v1.core.sched.scheduler import Scheduler
+from vllm.v1.outputs import DraftTokenIds, ModelRunnerOutput
+from vllm.v1.structured_output import StructuredOutputManager
+
+pytestmark = pytest.mark.cpu_test
+
+TIERS = [3, 5, 7, 9, 12]
+THRESHOLDS = [1.5, 2.5, 3.5, 4.5]
+KMAX = 12
+
+
+def _raw(tiers=TIERS, **conf):
+    c = {"thresholds": THRESHOLDS, "hysteresis": 0.0, "accept_weight": 0.0}
+    c.update(conf)
+    return {"tiers": list(tiers), "confidence": c}
+
+
+def _block(summary: float) -> list[float]:
+    """A KMAX-wide confidence vector whose expected accepted drafts is
+    exactly ``summary``."""
+    m = int(summary)
+    f = summary - m
+    out = [1.0] * m
+    if m < KMAX:
+        out += [f] + [0.0] * (KMAX - m - 1)
+    return out
+
+
+def _tier_of(summary: float) -> int:
+    return TIERS[sum(1 for t in THRESHOLDS if summary >= t)]
+
+
+# --------------------------------------------------------------- config
+
+
+def test_tiers_are_the_captured_counts_and_the_load_never_narrows():
+    c = AdaptiveKConfig.from_dict({"tiers": TIERS}, KMAX)
+    assert c.allowed == tuple(TIERS)
+    assert c.by_load == (KMAX,)
+    assert c.confidence is None
+    assert [c.max_reqs_for(k, 16) for k in TIERS] == [16] * len(TIERS)
+    assert c.max_reqs_for(4, 16) == 0
+
+
+def test_a_load_table_may_cap_the_tiers():
+    c = AdaptiveKConfig.from_dict(dict(_raw(), by_load=[12, 7, 3]), KMAX)
+    assert c.allowed == tuple(TIERS) and c.by_load == (12, 7, 3)
+    assert c.k_for_load(2) == 7
+
+
+@pytest.mark.parametrize(
+    "raw, match",
+    [
+        ({"tiers": [5, 3]}, "strictly increasing"),
+        ({"tiers": [3, 3]}, "strictly increasing"),
+        ({"tiers": [0, 3]}, "outside"),
+        ({"tiers": [3, 13]}, "outside"),
+        ({"tiers": [3, True]}, "integers"),
+        ({"tiers": []}, "non-empty"),
+        ({"tiers": TIERS, "accept": {"costs": [1.0] * 10}}, "accept"),
+        ({"confidence": {"thresholds": THRESHOLDS}, "accept": {"costs": [1.0] * 10}}, "accept"),
+        ({"tiers": TIERS, "by_load": [12, 8]}, "does not"),
+        (dict(_raw(), draft_by_load=True), "draft_by_load"),
+        ({"tiers": TIERS, "confidence": {}}, "needs thresholds"),
+        (_raw(thresholds=[1, 2, 3]), "needs 4 values"),
+        (_raw(thresholds=[1, 3, 2, 4]), "nondecreasing"),
+        (_raw(thresholds=[1, 2, float("nan"), 4]), "finite"),
+        (_raw(bogus=1), "Unknown"),
+        (_raw(accept_weight=1.5), "accept_weight"),
+        (_raw(max_age=-1), "max_age"),
+        (_raw(hysteresis=-0.1), "hysteresis"),
+        (_raw(prior=1.0), "prior"),
+    ],
+)
+def test_startup_refuses_combinations_that_cannot_work(raw, match):
+    with pytest.raises(ValueError, match=match):
+        AdaptiveKConfig.from_dict(raw, KMAX)
+
+
+def test_confidence_without_tiers_takes_the_default_list():
+    c = AdaptiveKConfig.from_dict({"confidence": {"thresholds": THRESHOLDS}}, KMAX)
+    assert c.tiers == c.allowed == (3, 5, 7, 9, 12) and c.by_load == (12,)
+    with pytest.raises(ValueError, match="default tiers"):
+        AdaptiveKConfig.from_dict({"confidence": {"thresholds": THRESHOLDS}}, 7)
+    # The default needs four thresholds like any five tiers.
+    with pytest.raises(ValueError, match="needs 4 values"):
+        AdaptiveKConfig.from_dict({"confidence": {"thresholds": [1.0]}}, KMAX)
+
+
+def test_the_confidence_head_needs_a_dspark_drafter():
+    with pytest.raises(ValueError, match="dspark"):
+        SpeculativeConfig(model="ngram", num_speculative_tokens=KMAX, adaptive_k=_raw())
+    # Acceptance alone needs no head, so any drafter serves.
+    spec = SpeculativeConfig(
+        model="ngram", num_speculative_tokens=KMAX, adaptive_k=_raw(accept_weight=1.0)
+    )
+    assert spec.adaptive_k_config.confidence.needs_draft_confidence is False
+
