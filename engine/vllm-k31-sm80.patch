+        #define LAUNCH_DN_1N_I(R, P, G, SI) vq_moe_down_decode_1n_kernel<R, true, P, SI><<<G, 64, 0, stream>>>(mp_v4, tasks, header, sorted_rows, sorted_weights, ptrs, out_buf, (int)H, (int)I, zero_slot_idx)
+        #define LAUNCH_DN_1N(R, P, G) do { if (I == 768) { LAUNCH_DN_1N_I(R, P, G, 768); } else if (I == 1536) { LAUNCH_DN_1N_I(R, P, G, 1536); } else { LAUNCH_DN_1N_I(R, P, G, 0); } } while (0)
+        if (r_dn >= 0 && r_dn <= 4) {
+          switch (r_dn) {
+            case 0: LAUNCH_DN_1N(0, false, dn_full); break;
+            case 1: LAUNCH_DN_1N(1, false, dn_full); break;
+            case 2: LAUNCH_DN_1N(2, false, dn_full); break;
+            case 3: LAUNCH_DN_1N(3, false, dn_full); break;
+            case 4: LAUNCH_DN_1N(4, false, dn_full); break;
+          }
+        } else {
+          LAUNCH_DN_1N_I(0, true, dn_cap, 0); LAUNCH_DN_1N_I(1, true, dn_cap, 0); LAUNCH_DN_1N_I(2, true, dn_cap, 0); LAUNCH_DN_1N_I(3, true, dn_cap, 0); LAUNCH_DN_1N_I(4, true, dn_cap, 0);
+        }
+        #undef LAUNCH_DN_1N
+        #undef LAUNCH_DN_1N_I
+      }
+
+      const int comb_grid = static_cast<int>(rows * (H / 64));
+      if (topk == 16) {
+        combine_slots_to_bf16_v3_kernel<16><<<comb_grid, 32, 0, stream>>>(
+            reinterpret_cast<const float2*>(out_buf), slot_to_dst, topk_weights.data_ptr<float>(),
+            reinterpret_cast<uint32_t*>(out.data_ptr<at::BFloat16>()), static_cast<int>(H / 2), 16);
+      } else if (topk > 0 && topk < 16) {
+        combine_slots_to_bf16_v3_kernel<1><<<comb_grid, 32, 0, stream>>>(
+            reinterpret_cast<const float2*>(out_buf), slot_to_dst, topk_weights.data_ptr<float>(),
+            reinterpret_cast<uint32_t*>(out.data_ptr<at::BFloat16>()), static_cast<int>(H / 2), static_cast<int>(topk));
+      } else {
+        combine_slots_to_bf16_v3_kernel<0><<<comb_grid, 32, 0, stream>>>(
+            reinterpret_cast<const float2*>(out_buf), slot_to_dst, topk_weights.data_ptr<float>(),
+            reinterpret_cast<uint32_t*>(out.data_ptr<at::BFloat16>()), static_cast<int>(H / 2), static_cast<int>(topk));
+      }
+    } else {
+      const dim3 dn_full(max_tasks * static_cast<int>(H / 64));
+      const dim3 dn_cap(std::min<int>(max_tasks * static_cast<int>(H / 64), sms * 10));
+      #define LAUNCH_DN_ATOM(R, P, G) vq_moe_down_decode_2n_kernel<R, false, P><<<G, 64, 0, stream>>>(mp_v4, tasks, header, sorted_rows, sorted_weights, ptrs, out_buf, (int)H, (int)I, zero_slot_idx)
+      if (r_dn >= 0 && r_dn <= 4) {
+        switch (r_dn) {
+          case 0: LAUNCH_DN_ATOM(0, false, dn_full); break;
+          case 1: LAUNCH_DN_ATOM(1, false, dn_full); break;
+          case 2: LAUNCH_DN_ATOM(2, false, dn_full); break;
+          case 3: LAUNCH_DN_ATOM(3, false, dn_full); break;
+          case 4: LAUNCH_DN_ATOM(4, false, dn_full); break;
+        }
+      } else {
+        LAUNCH_DN_ATOM(0, true, dn_cap); LAUNCH_DN_ATOM(1, true, dn_cap); LAUNCH_DN_ATOM(2, true, dn_cap); LAUNCH_DN_ATOM(3, true, dn_cap); LAUNCH_DN_ATOM(4, true, dn_cap);
+      }
+      #undef LAUNCH_DN_ATOM
+
+      f32_to_bf16_vec4_kernel<<<(n_v4 + 255) / 256, 256, 0, stream>>>(
+          reinterpret_cast<const float4*>(out_buf),
+          reinterpret_cast<uint2*>(out.data_ptr<at::BFloat16>()),
+          n_v4);
+    }
+  } else {
+    zero_and_cast_prefill_kernel<<<(n_v4 + 255) / 256, 256, 0, stream>>>(
+        reinterpret_cast<const uint2*>(x.data_ptr<at::BFloat16>()),
+        reinterpret_cast<uint2*>(x_f16), reinterpret_cast<float4*>(out_buf), n_v4);
+    cudaMemsetAsync(counts, 0, E * sizeof(int32_t), stream);
+    const int r_grd = (total_slots + 255) / 256;
+    route_count_kernel<<<r_grd, 256, 0, stream>>>(routing, counts, total_slots);
+    route_scan_and_tasks_kernel<<<1, 32, 0, stream>>>(routing, counts, write_pos, tasks, header, TILE_M, r_gu, r_dn);
+    route_scatter_kernel<<<r_grd, 256, 0, stream>>>(routing, topk_weights.data_ptr<float>(), write_pos, sorted_rows, sorted_weights, slot_to_dst, total_slots, false);
+
+    const dim3 gu_grid(max_tasks * static_cast<int>(I / 128));
+    const dim3 dn_grid(max_tasks * static_cast<int>(H / 128));
+    #define LAUNCH_GU_P(R) vq_moe_gate_up_prefill_kernel<R><<<gu_grid, 256, 0, stream>>>(x_f16, tasks, header, sorted_rows, ptrs, mid_buf, (int)H, (int)I, sb, slb, lim)
+    if (r_gu >= 0 && r_gu <= 4) {
+      switch (r_gu) {
+        case 0: LAUNCH_GU_P(0); break;
+        case 1: LAUNCH_GU_P(1); break;
+        case 2: LAUNCH_GU_P(2); break;
+        case 3: LAUNCH_GU_P(3); break;
+        case 4: LAUNCH_GU_P(4); break;
+      }
+    } else {
+      LAUNCH_GU_P(0); LAUNCH_GU_P(1); LAUNCH_GU_P(2); LAUNCH_GU_P(3); LAUNCH_GU_P(4);
+      vq_moe_gate_up_prefill_mixed_kernel<<<gu_grid, 256, 0, stream>>>(x_f16, tasks, header, sorted_rows, ptrs, mid_buf, (int)H, (int)I, sb, slb, lim);
+    }
+    #undef LAUNCH_GU_P
+    #define LAUNCH_DN_P(R) vq_moe_down_prefill_kernel<R><<<dn_grid, 256, 0, stream>>>(mid_buf, tasks, header, sorted_rows, sorted_weights, ptrs, out_buf, (int)H, (int)I)
+    if (r_dn >= 0 && r_dn <= 4) {
+      switch (r_dn) {
+        case 0: LAUNCH_DN_P(0); break;
+        case 1: LAUNCH_DN_P(1); break;
+        case 2: LAUNCH_DN_P(2); break;
+        case 3: LAUNCH_DN_P(3); break;
+        case 4: LAUNCH_DN_P(4); break;
+      }
+    } else {
+      LAUNCH_DN_P(0); LAUNCH_DN_P(1); LAUNCH_DN_P(2); LAUNCH_DN_P(3); LAUNCH_DN_P(4);
+    }
+    #undef LAUNCH_DN_P
+
+    f32_to_bf16_vec4_kernel<<<(n_v4 + 255) / 256, 256, 0, stream>>>(
+        reinterpret_cast<const float4*>(out_buf),
+        reinterpret_cast<uint2*>(out.data_ptr<at::BFloat16>()),
+        n_v4);
+  }
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+}  // namespace
+
+std::tuple<torch::Tensor, torch::Tensor> vq_pack(
+    const torch::Tensor& idx_records, const torch::Tensor& scale_records, const torch::Tensor& codebook,
+    int64_t role, int64_t hidden_size, int64_t dim, int64_t index_bits, int64_t group_size
+) {
+  TORCH_CHECK(idx_records.is_cuda() && idx_records.dtype() == at::kByte && idx_records.dim() == 3);
+  TORCH_CHECK(scale_records.is_cuda() && scale_records.dtype() == at::kHalf && scale_records.dim() == 3);
+  TORCH_CHECK(codebook.is_cuda() && codebook.dim() == 2 && codebook.size(0) == (1LL << index_bits) && codebook.size(1) == dim);
+  TORCH_CHECK(group_size == 128 && hidden_size % 128 == 0 && (role == 0 || role == 1));
+  const int rid = rate_id(static_cast<int>(dim), static_cast<int>(index_bits));
+  TORCH_CHECK(rid >= 0, "Unsupported VQ rate (dim=", dim, ", index_bits=", index_bits, ")");
+
+  const int64_t E = idx_records.size(0), nb = idx_records.size(1), rec_bytes = idx_records.size(2), ns_per_rec = scale_records.size(2);
+  const int64_t out_f = (role == 0) ? (nb * 128) : hidden_size;
+  const int64_t in_f  = (role == 0) ? hidden_size : (nb * 128);
+  const int64_t N_tiles = out_f / 16, K_groups = in_f / 128;
+  const int wpl = words_per_lane(static_cast<int>(dim), static_cast<int>(index_bits));
+
+  const c10::cuda::CUDAGuard guard(idx_records.device());
+  torch::Tensor out_idx = torch::empty({E, N_tiles, K_groups, wpl, 32}, idx_records.options().dtype(at::kInt));
+  torch::Tensor out_sc  = torch::empty({E, N_tiles, K_groups, 16}, scale_records.options().dtype(at::kHalf));
+
+  const int64_t n_units = (K_groups >> 1) + (K_groups & 1);
+  const int64_t total_warps = E * N_tiles * n_units;
+  const dim3 grid(static_cast<unsigned int>((total_warps + 7) / 8));
+  const cudaStream_t stream = at::cuda::getCurrentCUDAStream(idx_records.get_device()).stream();
+  auto idx_c = idx_records.contiguous(), sc_c = scale_records.contiguous();
+
+  #define PACK_CASE(R) \
+    case R: \
+      vq_pack_kernel<R><<<grid, 256, 0, stream>>>( \
+          idx_c.data_ptr<uint8_t>(), reinterpret_cast<const half*>(sc_c.data_ptr<at::Half>()), \
+          reinterpret_cast<uint32_t*>(out_idx.data_ptr<int32_t>()), \
+          reinterpret_cast<uint32_t*>(out_sc.data_ptr<at::Half>()), \
+          static_cast<int>(E), static_cast<int>(nb), static_cast<int>(rec_bytes), static_cast<int>(ns_per_rec), \
+          static_cast<int>(role), static_cast<int>(hidden_size)); \
+      break;
+  switch (rid) { PACK_CASE(0) PACK_CASE(1) PACK_CASE(2) PACK_CASE(3) PACK_CASE(4) default: TORCH_CHECK(false); }
+  #undef PACK_CASE
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+  return std::make_tuple(out_idx, out_sc);
+}
+
+torch::Tensor vq_dequant_reference(
+    const torch::Tensor& packed_idx, const torch::Tensor& packed_scale, const torch::Tensor& codebook,
+    int64_t out_features, int64_t in_features, int64_t dim, int64_t index_bits, int64_t group_size
+) {
+  TORCH_CHECK(packed_idx.is_cuda() && packed_scale.is_cuda() && codebook.is_cuda());
+  TORCH_CHECK(group_size == 128 && out_features % 16 == 0 && in_features % 128 == 0);
+  const int rid = rate_id(static_cast<int>(dim), static_cast<int>(index_bits));
+  TORCH_CHECK(rid >= 0);
+
+  const int64_t E = packed_idx.size(0);
+  const c10::cuda::CUDAGuard guard(packed_idx.device());
+  torch::Tensor out = torch::empty({E, out_features, in_features}, packed_idx.options().dtype(at::kFloat));
+  const int64_t total_warps = E * (out_features / 16) * (in_features / 128);
+  const dim3 grid(static_cast<unsigned int>((total_warps + 7) / 8));
+  const cudaStream_t stream = at::cuda::getCurrentCUDAStream(packed_idx.get_device()).stream();
+  auto cb_c = codebook.to(at::kHalf).contiguous();
+
+  #define DEQ_CASE(R) \
+    case R: \
+      vq_dequant_ref_kernel<R><<<grid, 256, 0, stream>>>( \
+          reinterpret_cast<const uint32_t*>(packed_idx.data_ptr()), \
+          reinterpret_cast<const uint32_t*>(packed_scale.data_ptr()), \
+          reinterpret_cast<const half*>(cb_c.data_ptr<at::Half>()), \
+          out.data_ptr<float>(), static_cast<int>(E), static_cast<int>(out_features), static_cast<int>(in_features)); \
+      break;
+  switch (rid) { DEQ_CASE(0) DEQ_CASE(1) DEQ_CASE(2) DEQ_CASE(3) DEQ_CASE(4) default: TORCH_CHECK(false); }
+  #undef DEQ_CASE
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+  return out;
+}
+
+int64_t moe_workspace_size_vq(int64_t max_rows, int64_t hidden_size, int64_t intermediate_size, int64_t topk, int64_t local_experts) {
+  auto align4 = [](int64_t n) { return ((n + 3) / 4) * 4; };
+  const int64_t total_slots = max_rows * topk;
+  const int64_t max_tasks = std::min<int64_t>(total_slots, local_experts + total_slots / 8 + 1);
+  const int64_t out_region_rows = std::max<int64_t>(max_rows, std::min<int64_t>(max_rows, 64) * topk);
+  int64_t n = 0;
+  n += align4(out_region_rows * hidden_size);                  // out_f32 or L2 slot_out (rows <= 64)
+  n += align4(((max_rows + 1) * hidden_size + 1) / 2);         // x_f16 / x_perm_v4 (+1 zero row)
+  n += align4(((total_slots + 1) * intermediate_size + 1) / 2);// mid_buf / mid_perm_v4 (+1 zero slot)
+  n += align4(local_experts) * 2;                              // counts + write_pos
+  n += align4(total_slots) * 3;                                // sorted_rows + sorted_weights + slot_to_dst
+  n += align4(max_tasks * 4) + 16;                             // tasks (alignas(16)) + header
+  return n;
+}
+
+void moe_out_vq(
+    const torch::Tensor& x, const torch::Tensor& topk_ids, const torch::Tensor& topk_weights,
+    const torch::Tensor& packed_ptrs, const torch::Tensor& packed_meta, const torch::Tensor& expert_map,
+    int64_t intermediate_size, torch::Tensor& out, torch::Tensor& workspace,
+    double situ_beta, double situ_linear_beta, double swiglu_limit,
+    int64_t rate_id_gu, int64_t rate_id_dn
+) {
+  moe_vq_run_impl<false>(
+      x, topk_ids, topk_weights, packed_ptrs, packed_meta, expert_map,
+      intermediate_size, out, workspace, situ_beta, situ_linear_beta, swiglu_limit,
+      rate_id_gu, rate_id_dn);
+}
+
+void moe_out_prefill_vq(
+    const torch::Tensor& x, const torch::Tensor& topk_ids, const torch::Tensor& topk_weights,
+    const torch::Tensor& packed_ptrs, const torch::Tensor& packed_meta, const torch::Tensor& expert_map,
+    int64_t intermediate_size, torch::Tensor& out, torch::Tensor& workspace,
+    double situ_beta, double situ_linear_beta, double swiglu_limit,
+    int64_t rate_id_gu, int64_t rate_id_dn
+) {
+  moe_vq_run_impl<true>(
+      x, topk_ids, topk_weights, packed_ptrs, packed_meta, expert_map,
+      intermediate_size, out, workspace, situ_beta, situ_linear_beta, swiglu_limit,
+      rate_id_gu, rate_id_dn);
+}
+
+}  // namespace k31_vq
