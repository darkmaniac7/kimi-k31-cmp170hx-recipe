@@ -0,0 +1,170 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Python interface and FakeTensor registrations for _k31_dense_C (sm_80 + sm_120).
+
+Sibling EXL3 dense linear path for Kimi-K3.1-Pro (leaves Qwen/DeepSeek
+dense_mma.cu untouched). Supports 1..4 fused EXL3 members in a single call
+(KDA q/k/v/g, Shared gate+up, MLA q_a+kv_a, and all single projections),
+PP-safe, SM-count-driven with optional VLLM_K31_DENSE_REF_SMS pin for
+bit-exact TP2 across unequal SM-count cards, per-workspace arrival counters
+(zero device globals, concurrent-stream safe), plus bit-exact
+row-count-invariant BF16 plain linears (KDA f_a, b, f_b).
+
+This is the kernel owner's ``dense_k31_ops.py`` of release 4 (api_version 4;
+csrc/k31_dense holds the package's sources) with one change: the library is
+``vllm/_k31_dense_C.abi3.so`` beside ``vllm/_exl3_C.abi3.so``, imported and
+checked by vllm/sm80/kernels/k31q/native.py as ops.py checks ``_exl3_C``; an
+older build is refused with the build command. The K3.1 dense and plain linear
+methods call it through vllm/sm80/kernels/k31q/dense.py.
+
+What the caller must know about ``linear_out_k31_multi`` (release 4):
+  - 1 to 4 EXL3 members (codebook mul1, 5, 6 or 7 bits) sharing ``x`` BF16
+    [rows, logical_in] contiguous; ``out`` BF16 or FP32 [rows, sum of the
+    members' logical outputs] contiguous; the members' outputs are written
+    side by side in member order.
+  - Up to 32 rows and members of one bitrate: the decode path, two launches
+    (input transform + per-workspace arrival zeroing, then one fused
+    stream-K/exact-split MMA with the output transform). Identical summation
+    order across M=1..16 (kKW=4); kKW switches 4 -> 2 at M=17..32.
+    Otherwise the prefill path: per member an input transform, the trellis
+    dequantized in column chunks of at most 8,192 into the workspace, a
+    cuBLAS BF16 GEMM (FP32 reduction enforced) and an output transform.
+  - ``workspace`` FP32 of at least ``linear_workspace_size_k31(rows,
+    padded_in, total padded out, members)`` elements. Includes 4,096 ints
+    (16 KB, 128B aligned) at offset 0 for per-workspace arrival counters so
+    concurrent streams with distinct workspaces are 100% isolated. When
+    ``max_rows <= 32``, ``linear_workspace_size_k31`` returns decode-only
+    sizing without reserving prefill buffers.
+  - Optional env ``VLLM_K31_DENSE_REF_SMS`` (cached once on first launch, or
+    set via ``set_ref_sms_k31``) pins split planning across unequal SM-count
+    TP ranks (e.g. 122 + 108 or 124 + 122) for bit-exact replicated outputs.
+  - No host synchronization; CUDA-graph safe.
+
+What the caller must know about ``linear_plain_invariant_k31`` (release 4):
+  - Plain BF16 linear ``x @ weight.T (+ bias)`` whose K-reduction tree depends
+    only on ``K`` (never on ``M``, ``N``, or SM count), producing 0-ULP
+    bitwise-identical outputs for the same input row across all batch sizes
+    1..2048 and row positions.
+  - Zero workspace, zero global counters, CUDA-graph safe, supports BF16 or
+    FP32 output and optional BF16/FP32 bias.
+  - ``linear_plain_invariant_k31_multi`` accepts 1..4 BF16 weight matrices
+    sharing ``x`` and writes concatenated outputs with 0-ULP bit identity to
+    separate or concatenated weight calls.
+"""
+
+from __future__ import annotations
+
+import torch
+
+from vllm.sm80.kernels.k31q import native
+
+_ABI_VERSION = 1
+_API_VERSION = 4
+_OPERATORS = (
+    "linear_workspace_size_k31",
+    "set_ref_sms_k31",
+    "get_ref_sms_k31",
+    "linear_out_k31_multi",
+    "linear_plain_invariant_k31",
+    "linear_plain_invariant_k31_multi",
+)
+BUILD_COMMAND = (
+    "python csrc/k31_dense/build_dense_k31_standalone.py --arch-list \"8.0;12.0\" "
+    "--ptx --out-dir build/k31_dense && cp build/k31_dense/_k31_dense_C.abi3.so vllm/"
+)
+
+_LOADED = False
+_FAKES_REGISTERED = False
+_MODULE = None
+
+
+def ensure_dense_k31_extension() -> None:
+    global _LOADED, _FAKES_REGISTERED, _MODULE
+    if _LOADED:
+        return
+    _MODULE = native.load(
+        "_k31_dense_C", _ABI_VERSION, _OPERATORS, BUILD_COMMAND, _API_VERSION
+    )
+    if not _FAKES_REGISTERED:
+        _register_fake_ops()
+        _FAKES_REGISTERED = True
+    _LOADED = True
+
+
+def build_info() -> dict:
+    """The loaded library's build metadata (abi_version, api_version,
+    torch_version, cuda_version, cxx11_abi)."""
+    ensure_dense_k31_extension()
+    return dict(_MODULE.build_info())
+
+
+def _register_fake_ops() -> None:
+    @torch.library.register_fake("_k31_dense_C::linear_out_k31_multi")
+    def _fake_linear(
+        x, trellises, suhs, svhs, bits_x2s, logical_outs, out, workspace
+    ) -> None:
+        return None
+
+    @torch.library.register_fake("_k31_dense_C::linear_plain_invariant_k31")
+    def _fake_plain_linear(x, weight, bias, out) -> None:
+        return None
+
+    @torch.library.register_fake("_k31_dense_C::linear_plain_invariant_k31_multi")
+    def _fake_plain_linear_multi(x, weights, out) -> None:
+        return None
+
+
+def linear_workspace_size_k31(
+    max_rows: int, padded_in: int, total_padded_out: int, num_members: int = 1
+) -> int:
+    ensure_dense_k31_extension()
+    return int(
+        torch.ops._k31_dense_C.linear_workspace_size_k31(
+            max_rows, padded_in, total_padded_out, num_members
+        )
+    )
+
+
+def set_ref_sms_k31(ref_sms: int) -> None:
+    ensure_dense_k31_extension()
+    torch.ops._k31_dense_C.set_ref_sms_k31(int(ref_sms))
+
+
+def get_ref_sms_k31() -> int:
+    ensure_dense_k31_extension()
+    return int(torch.ops._k31_dense_C.get_ref_sms_k31())
+
+
+def linear_out_k31_multi(
+    x: torch.Tensor,
+    trellises: list[torch.Tensor],
+    suhs: list[torch.Tensor],
+    svhs: list[torch.Tensor],
+    bits_x2s: list[int],
+    logical_outs: list[int],
+    out: torch.Tensor,
+    workspace: torch.Tensor,
+) -> None:
+    ensure_dense_k31_extension()
+    torch.ops._k31_dense_C.linear_out_k31_multi(
+        x, trellises, suhs, svhs, bits_x2s, logical_outs, out, workspace
+    )
+
+
+def linear_plain_invariant_k31(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None,
+    out: torch.Tensor,
+) -> None:
+    ensure_dense_k31_extension()
+    torch.ops._k31_dense_C.linear_plain_invariant_k31(x, weight, bias, out)
+
+
+def linear_plain_invariant_k31_multi(
+    x: torch.Tensor,
+    weights: list[torch.Tensor],
+    out: torch.Tensor,
+) -> None:
+    ensure_dense_k31_extension()
+    torch.ops._k31_dense_C.linear_plain_invariant_k31_multi(x, weights, out)
