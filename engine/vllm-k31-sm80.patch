+    monkeypatch.setenv(SWITCH, "1")
+    s = _speculator(**overrides)
+    calls = []
+    wrapped = sa.shard_argmax_sampling(lambda self, n, h: calls.append(n))
+    with pytest.raises(ValueError, match=f"{SWITCH}: .*{reason}"):
