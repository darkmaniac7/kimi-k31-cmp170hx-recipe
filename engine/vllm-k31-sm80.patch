+def test_pipespec_bank_flip_with_kda_records_cpu_program_bit_exact(
+    dim_first: bool, seed: int
+):
+    """End-to-end equivalence of BANK_FLIP=1 + KDA_RECORDS=1 against legacy
+    full-state verify across random programs of normal steps and PipeSpec
+    Chunk A / Chunk B accept and reject."""
+    rng = random.Random(seed)
+    g = torch.Generator().manual_seed(100 + seed)
+    H, D = 2, 128
+    C = 3 * H * D
+    slots = 10
+    num_blocks = 24
+    token_dim = 2 if dim_first else 1
+    cs_shape = (num_blocks, C, 2 + slots) if dim_first else (num_blocks, 2 + slots, C)
+
+    conv_leg = (torch.randn(cs_shape, generator=g) * 0.2).to(torch.bfloat16)
+    rec_leg = torch.randn((num_blocks, H, D, D), generator=g) * 0.05
+    conv_rec = conv_leg.clone()
+    rec_rec = rec_leg.clone()
+    state_mode = torch.zeros((num_blocks,), dtype=torch.int32)
+
+    cw = torch.randn((C, 4), generator=g) * 0.1
+    A_log = torch.randn((H,), generator=g) * 0.1
+    dt_bias = torch.randn((H * D,), generator=g) * 0.1
+    norm_w = torch.ones((D,), dtype=torch.float32)
+
+    bt = torch.arange(2, 2 + slots, dtype=torch.int32).unsqueeze(0)
+    perm_leg = KDAPipeSpecSlotFlip.identity(1, slots, torch.device("cpu"))
+    perm_rec = perm_leg.clone()
+    acc_leg = torch.ones((1,), dtype=torch.int32)
+    acc_rec = torch.ones((1,), dtype=torch.int32)
+    req_idx = torch.tensor([0], dtype=torch.int32)
+
+    def rand_inputs(rows: int):
+        return (
+            (torch.randn((rows, C), generator=g) * 0.2).to(torch.bfloat16),
+            (torch.randn((rows, H, D), generator=g) * 0.2).to(torch.bfloat16),
+            (torch.randn((rows, H), generator=g) * 0.2).to(torch.bfloat16),
+            (torch.randn((rows, H, D), generator=g) * 0.2).to(torch.bfloat16),
+        )
+
+    for step in range(14):
+        kind = rng.choice(["normal", "ps_accept", "ps_reject_partial", "ps_reject_full"])
+        if kind == "normal":
+            rows = rng.randint(1, 5)
+            mqkv, rg, rb, g2 = rand_inputs(rows)
+            qsl = torch.tensor([0, rows], dtype=torch.int32)
+            L_leg = KDAPipeSpecSlotFlip.logical_block_table(bt, perm_leg)
+            L_rec = KDAPipeSpecSlotFlip.logical_block_table(bt, perm_rec)
+            out_leg = torch.empty((rows, H, D), dtype=torch.bfloat16)
+            out_rec = torch.empty((rows, H, D), dtype=torch.bfloat16)
+
+            ref_kda_spec_verify_legacy_cpu(
+                mqkv, conv_leg, cw, None, rg, rb, A_log, dt_bias, g2, norm_w,
+                rec_leg, L_leg, qsl, acc_leg, -5.0, 1e-6, out_leg, dim_first=dim_first,
+            )
+            ref_kda_spec_verify_records_cpu(
+                mqkv, conv_rec, cw, None, rg, rb, A_log, dt_bias, g2, norm_w,
+                rec_rec, L_rec, qsl, acc_rec, -5.0, 1e-6, out_rec, state_mode,
+                dim_first=dim_first,
+            )
+            assert torch.equal(out_rec, out_leg), f"step {step} normal mismatch"
+            accepted = rng.randint(1, rows)
+            acc_leg.fill_(accepted)
+            acc_rec.fill_(accepted)
+        else:
+            chunk_k = rng.choice([2, 3, 4])
+            rows_a = chunk_k + 1
+            mqkv_a, rg_a, rb_a, g2_a = rand_inputs(rows_a)
+            qsl_a = torch.tensor([0, rows_a], dtype=torch.int32)
+            L_leg = KDAPipeSpecSlotFlip.logical_block_table(bt, perm_leg)
+            L_rec = KDAPipeSpecSlotFlip.logical_block_table(bt, perm_rec)
+            out_a_leg = torch.empty((rows_a, H, D), dtype=torch.bfloat16)
+            out_a_rec = torch.empty((rows_a, H, D), dtype=torch.bfloat16)
+
+            ref_kda_spec_verify_legacy_cpu(
+                mqkv_a, conv_leg, cw, None, rg_a, rb_a, A_log, dt_bias, g2_a, norm_w,
+                rec_leg, L_leg, qsl_a, acc_leg, -5.0, 1e-6, out_a_leg, dim_first=dim_first,
+            )
+            ref_kda_spec_verify_records_cpu(
+                mqkv_a, conv_rec, cw, None, rg_a, rb_a, A_log, dt_bias, g2_a, norm_w,
+                rec_rec, L_rec, qsl_a, acc_rec, -5.0, 1e-6, out_a_rec, state_mode,
+                dim_first=dim_first,
+            )
+            assert torch.equal(out_a_rec, out_a_leg), f"step {step} chunk A mismatch"
+
+            # Prepare Chunk B on both systems
+            KDAPipeSpecSlotFlip.prepare_chunk_b(
+                [conv_leg], L_leg[0], chunk_k, token_dim=token_dim
+            )
+            KDAPipeSpecSlotFlip.prepare_chunk_b(
+                [conv_rec], L_rec[0], chunk_k, token_dim=token_dim
+            )
+            ssi_b_leg = KDAPipeSpecSlotFlip.build_chunk_b_state_indices(
+                L_leg, chunk_k, slots
+            )
+            ssi_b_rec = L_rec[:, chunk_k + 1 :].contiguous()
+            fold_src_b = L_rec[:, : chunk_k + 1].contiguous()
+            fold_cnt_b = torch.tensor([chunk_k], dtype=torch.int32)
+            acc_b = torch.tensor([chunk_k + 2], dtype=torch.int32)
+
+            rows_b = chunk_k + 1
+            mqkv_b, rg_b, rb_b, g2_b = rand_inputs(rows_b)
+            qsl_b = torch.tensor([0, rows_b], dtype=torch.int32)
+            out_b_leg = torch.empty((rows_b, H, D), dtype=torch.bfloat16)
+            out_b_rec = torch.empty((rows_b, H, D), dtype=torch.bfloat16)
+
+            ref_kda_spec_verify_legacy_cpu(
+                mqkv_b, conv_leg, cw, None, rg_b, rb_b, A_log, dt_bias, g2_b, norm_w,
+                rec_leg, ssi_b_leg, qsl_b, acc_b, -5.0, 1e-6, out_b_leg,
+                dim_first=dim_first,
+            )
+            ref_kda_spec_verify_records_cpu(
+                mqkv_b, conv_rec, cw, None, rg_b, rb_b, A_log, dt_bias, g2_b, norm_w,
+                rec_rec, ssi_b_rec, qsl_b, acc_b, -5.0, 1e-6, out_b_rec, state_mode,
+                fold_src_indices=fold_src_b, fold_counts=fold_cnt_b,
+                dim_first=dim_first,
+            )
+            assert torch.equal(out_b_rec, out_b_leg), f"step {step} chunk B mismatch"
+
+            if kind == "ps_accept":
+                m_a = chunk_k + 1
+                m_b = rng.randint(1, rows_b)
+            elif kind == "ps_reject_partial":
+                m_a = rng.randint(1, chunk_k)
+                m_b = 0
+            else:
+                m_a = chunk_k + 1
+                m_b = 0
+
+            acc_leg.fill_(m_a)
+            acc_rec.fill_(m_a)
+            num_sampled_b = torch.tensor([m_b], dtype=torch.int32)
+            KDAPipeSpecSlotFlip.commit_or_rollback_chunk_b(
+                perm_leg, chunk_k, num_sampled_b, acc_leg, req_idx
+            )
+            KDAPipeSpecSlotFlip.commit_or_rollback_chunk_b(
+                perm_rec, chunk_k, num_sampled_b, acc_rec, req_idx
+            )
+            assert torch.equal(perm_rec, perm_leg)
+            assert torch.equal(acc_rec, acc_leg)
