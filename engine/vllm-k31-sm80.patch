+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU regression tests for the K3.1 DSpark boot warmup overflow fix and
+RoPE position bounds guards (VLLM_K31_ROPE_GUARDS).
+"""
+
+import inspect
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+
+from vllm.sm80 import rope_guard
+from vllm.sm80.rope_guard import K31RopeGuardError
+from vllm.sm80.spec_decode import warmup as spec_warmup
+from vllm.v1.attention.backends.utils import PAD_SLOT_ID
+from vllm.v1.worker.gpu.input_batch import InputBatch, InputBuffers
+from vllm.v1.worker.gpu.spec_decode.dflash import speculator as dflash_mod
+from vllm.v1.worker.gpu.spec_decode.dflash.speculator import (
+    DFlashSpeculator,
+    prepare_dflash_inputs,
+)
+from vllm.v1.worker.gpu.spec_decode.dspark.speculator import DSparkSpeculator
+
+
+class _KernelRecorder:
+    def __init__(self, kernel):
+        self.arg_names = list(inspect.signature(kernel.fn).parameters)
+        self.calls: list[dict] = []
+
+    def __getitem__(self, grid):
+        def _launch(*args, **kwargs):
+            bound = dict(zip(self.arg_names, args))
+            bound.update(kwargs)
+            bound["_grid"] = grid
+            self.calls.append(bound)
+
+        return _launch
+
+
+def _make_k31_dspark_speculator(
+    *,
+    max_num_reqs: int = 4,
+    max_num_tokens: int = 2048,
+    max_model_len: int = 8192,
+    num_speculative_steps: int = 7,
+    block_size: int = 6144,
+    kernel_block_stride: int = 3,
+    kernel_block_size: int = 2048,
+):
+    device = torch.device("cpu")
+    spec = object.__new__(DSparkSpeculator)
+    spec.device = device
+    spec.max_num_reqs = max_num_reqs
+    spec.max_num_tokens = max_num_tokens
+    spec.vllm_config = SimpleNamespace(
+        model_config=SimpleNamespace(max_model_len=max_model_len)
+    )
+    spec.num_speculative_steps = num_speculative_steps
+    spec.num_query_per_req = num_speculative_steps
+    spec.sample_from_anchor = True
+    spec.parallel_drafting_token_id = 163839
+    spec.dcp_size = 1
+    spec.input_buffers = InputBuffers(max_num_reqs, max_num_tokens, device)
+    spec.context_positions = torch.zeros(max_num_tokens, dtype=torch.int64, device=device)
+    spec._context_slot_mappings = torch.full(
+        (1, max_num_tokens), PAD_SLOT_ID, dtype=torch.int64, device=device
+    )
+    max_sampled = max_num_reqs * num_speculative_steps
+    spec.sample_indices = torch.zeros(max_sampled, dtype=torch.int64, device=device)
+    spec.sample_pos = torch.zeros(max_sampled, dtype=torch.int64, device=device)
+    spec.sample_idx_mapping = torch.full(
+        (max_sampled,), -1, dtype=torch.int64, device=device
+    )
+    spec.temperature = torch.zeros(max_num_reqs, dtype=torch.float32, device=device)
+    spec.seeds = torch.zeros(max_num_reqs, dtype=torch.int64, device=device)
+    spec.draft_kv_cache_group_ids = [1]
+    spec.attn_groups = [
+        [],
+        [
+            SimpleNamespace(
+                kernel_block_stride=kernel_block_stride,
+                kernel_block_size=kernel_block_size,
+            )
+        ],
+    ]
+    spec.block_tables = SimpleNamespace(
+        slot_mappings={
+            1: torch.zeros(max_num_tokens, dtype=torch.int64, device=device)
+        },
+        input_block_tables={
+            1: torch.zeros((max_num_reqs, 4), dtype=torch.int32, device=device)
+        },
+        block_sizes={1: block_size},
+        cp_rank=0,
+        cp_interleave=1,
+    )
+    return spec
+
+
+def test_warm_dflash_prepare_k31_exact_bounds_and_clean_reset(monkeypatch) -> None:
+    """Regression for the sm_80 DSpark Xid 13 crash: _warm_dflash_prepare must
+    pass block_stride and real buffer bounds into prepare_dflash_inputs, and
+    leave context_positions and query positions clean afterward."""
+    spec = _make_k31_dspark_speculator()
+    # Poison context_positions and query positions before warmup to verify reset.
+    spec.context_positions.fill_(0x0101010101010101)
+    spec.input_buffers.positions.fill_(0x0101010101010101)
+
+    device = torch.device("cpu")
+    runner = SimpleNamespace(
+        speculator=spec,
+        device=device,
+        max_num_tokens=spec.max_num_tokens,
+        input_buffers=InputBuffers(spec.max_num_reqs, spec.max_num_tokens, device),
+        req_states=SimpleNamespace(
+            last_sampled_tokens=torch.zeros(spec.max_num_reqs, dtype=torch.int32),
+            next_prefill_tokens=torch.zeros(spec.max_num_reqs, dtype=torch.int32),
+        ),
+        sampler=SimpleNamespace(
+            sampling_states=SimpleNamespace(
+                temperature=SimpleNamespace(
+                    gpu=torch.zeros(spec.max_num_reqs, dtype=torch.float32)
+                ),
+                seeds=SimpleNamespace(
+                    gpu=torch.zeros(spec.max_num_reqs, dtype=torch.int64)
+                ),
+            )
+        ),
+    )
+
+    rec = _KernelRecorder(dflash_mod._prepare_dflash_inputs_kernel)
+    monkeypatch.setattr(dflash_mod, "_prepare_dflash_inputs_kernel", rec)
+
+    spec_warmup._warm_dflash_prepare(runner, spec)
+
+    assert len(rec.calls) > 0
+    for call in rec.calls:
+        assert call["block_size"] == 6144
+        assert call["block_stride"] == 6144
+        assert call["cp_rank"] == 0
+        assert call["CP_SIZE"] == 1
+        assert call["CP_INTERLEAVE"] == 1
+        assert call["parallel_drafting_token_id"] == 163839
+        assert call["num_query_per_req"] == 7
+        assert call["num_speculative_steps"] == 7
+        assert call["max_num_reqs"] == 4
+        assert call["max_num_tokens"] == 2048
+        assert call["max_model_len"] == 8192
+        assert call["SAMPLE_FROM_ANCHOR"] is True
+        assert call["num_reqs"] == 1
+
+    assert torch.all(spec.context_positions == 0)
+    assert torch.all(spec.input_buffers.positions == 0)
+    assert torch.all(spec._context_slot_mappings == PAD_SLOT_ID)
+
+
+def test_prepare_dflash_inputs_refuses_buffer_overflow_before_launch(
+    monkeypatch,
+) -> None:
+    """Shifted or oversized max_num_tokens / max_num_reqs / block_stride must
+    fail in Python before _prepare_dflash_inputs_kernel is launched."""
+    spec = _make_k31_dspark_speculator()
+    batch = InputBatch.make_dummy(1, 8, InputBuffers(4, 2048, torch.device("cpu")))
+    rec = _KernelRecorder(dflash_mod._prepare_dflash_inputs_kernel)
+    monkeypatch.setattr(dflash_mod, "_prepare_dflash_inputs_kernel", rec)
+
+    base_kw = dict(
+        input_buffers=spec.input_buffers,
+        query_slot_mapping=spec.block_tables.slot_mappings[1],
+        context_positions=spec.context_positions,
+        context_slot_mapping=spec._context_slot_mappings[0],
+        sample_indices=spec.sample_indices,
+        sample_pos=spec.sample_pos,
+        sample_idx_mapping=spec.sample_idx_mapping,
+        temperature=spec.temperature,
+        seeds=spec.seeds,
+        input_batch=batch,
+        num_sampled=torch.ones(1, dtype=torch.int32),
+        num_rejected=torch.zeros(1, dtype=torch.int32),
+        last_sampled=torch.zeros(4, dtype=torch.int32),
+        next_prefill_tokens=torch.zeros(4, dtype=torch.int32),
+        input_temperature=torch.zeros(4, dtype=torch.float32),
+        input_seeds=torch.zeros(4, dtype=torch.int64),
+        block_table=spec.block_tables.input_block_tables[1],
+        block_size=6144,
+        block_stride=6144,
+        cp_rank=0,
+        cp_size=1,
+        cp_interleave=1,
+        parallel_drafting_token_id=163839,
+        num_query_per_req=7,
+        num_speculative_steps=7,
+        max_num_reqs=4,
+        max_num_tokens=2048,
+        max_model_len=8192,
+        sample_from_anchor=True,
+    )
+
+    # Exact shifted values from the overnight bug must be refused before launch.
+    for bad_override in (
+        {"max_num_tokens": 8192},
+        {"max_num_reqs": 2048},
+        {"block_stride": 0},
+        {"sample_indices": torch.zeros(4, dtype=torch.int64)},
+        {"query_slot_mapping": torch.zeros(1024, dtype=torch.int64)},
+        {"context_positions": torch.zeros(4, dtype=torch.int64)},
+    ):
+        with pytest.raises(AssertionError):
+            prepare_dflash_inputs(**{**base_kw, **bad_override})
+    assert rec.calls == []
+
+    # Valid call launches once.
+    prepare_dflash_inputs(**base_kw)
+    assert len(rec.calls) == 1
+
+
+def test_dflash_capture_clears_poisoned_positions_sentinel(monkeypatch) -> None:
+    """Fill context_positions with 0x0101010101010101 and query positions with
+    0x8080808080808080 before capture() and verify every rotary_embedding call
+    under VLLM_K31_ROPE_GUARDS=1 sees clean int64 zeros in range."""
+    monkeypatch.setenv("VLLM_K31_ROPE_GUARDS", "1")
+    from vllm import _custom_ops as ops
+    from vllm.model_executor.models.qwen3_dflash import DFlashQwen3Model
+
+    spec = _make_k31_dspark_speculator(max_num_reqs=2, max_num_tokens=64)
+    # Signed int64 representation of 0x0101010101010101 and 0x8080808080808080.
+    poison_01 = 0x0101010101010101
+    poison_80 = -0x7F7F7F7F7F7F7F80
+    spec.context_positions.fill_(poison_01)
+    spec.input_buffers.positions.fill_(poison_80)
+    spec.hidden_states = torch.zeros(64, 64, dtype=torch.bfloat16)
+    spec._aux_staging = None
+    spec._num_rejected = None
+    spec.target_input_buffers = InputBuffers(2, 64, torch.device("cpu"))
+    spec.supports_decode_metadata_update = False
+    spec._layer_group_idx = None
+    spec._group_causal = True
+    spec.kv_cache_config = None
+    spec.max_width = 7
+    spec.widths = (7,)
+    spec.width = 7
+    spec._full_draft_tokens = torch.zeros(2, 7, dtype=torch.int64)
+    spec._draft_token_views = {7: spec._full_draft_tokens}
+    spec._sample_cols = {7: torch.arange(7, dtype=torch.int32).repeat(2)}
+    spec._cg_managers = {}
+
+    rope_cache = torch.zeros(8192, 64, dtype=torch.bfloat16)
+    recorded_rope_positions: list[torch.Tensor] = []
+
+    def _rec_rotary(positions, query, key, head_size, cos_sin_cache, is_neox, *a):
+        recorded_rope_positions.append(positions.clone())
+
+    monkeypatch.setattr(ops, "rotary_embedding", _rec_rotary)
+
+    fake_inner = object.__new__(DFlashQwen3Model)
+    fake_inner._rope_cos_sin_cache = rope_cache
+    fake_inner._rope_head_size = 64
+    fake_inner._rope_is_neox = True
+
+    def _precompute(hidden_states, context_positions, context_slots):
+        all_k = torch.zeros(5, context_positions.shape[0], 2, 64, dtype=torch.bfloat16)
+        fake_inner._apply_context_rope(all_k, context_positions)
+
+    spec.model = SimpleNamespace(
+        model=fake_inner,
+        precompute_and_store_context_kv=_precompute,
+    )
+
+    def _fake_generate(num_reqs, num_tokens, attn_metadata, slot_mappings, dp, mode):
+        from vllm.kernels import vllm_c
+
+        pos = spec.input_buffers.positions[:num_tokens]
+        q = torch.zeros(num_tokens, 64, dtype=torch.bfloat16)
+        k = torch.zeros(num_tokens, 64, dtype=torch.bfloat16)
+        vllm_c.rotary_embedding.impl_fn(pos, q, k, 64, rope_cache, True)
+
+    spec._generate_draft = _fake_generate
+
+    class _FakeCGManager:
+        def capture(
+            self,
+            forward_fn,
+            input_buffers,
+            block_tables,
+            attn_groups,
+            kv_cache_config,
+            max_model_len,
+            causal,
+            prepare_forward,
+            progress_bar_desc="",
+        ):
+            for num_reqs in (2, 1):
+                num_tokens = num_reqs * spec.num_query_per_req
+                InputBatch.make_dummy(num_reqs, num_tokens, input_buffers)
+                prepare_forward(num_reqs, None)
+                forward_fn(num_reqs, num_tokens, None, None, None, None)
+
+    spec.query_cudagraph_manager = _FakeCGManager()
+    spec._cg_managers = {7: spec.query_cudagraph_manager}
+
+    spec.capture()
+
+    # 2 sizes * (1 context rope + 1 query rope) = 4 rotary calls.
+    assert len(recorded_rope_positions) == 4
+    for pos in recorded_rope_positions:
+        assert pos.dtype == torch.int64
+        assert int(pos.min().item()) >= 0
+        assert int(pos.max().item()) < rope_cache.size(0)
+        assert torch.all(pos == 0)
+
+
+def test_rope_guard_catches_bad_positions_and_skips_when_off_or_capturing(
+    monkeypatch,
+) -> None:
+    cache = torch.zeros(8192, 64, dtype=torch.bfloat16)
+
+    # Off by default: bad position does not raise.
+    monkeypatch.delenv("VLLM_K31_ROPE_GUARDS", raising=False)
+    bad_01 = torch.tensor([0x0101010101010101], dtype=torch.int64)
+    rope_guard.check_positions("test_off", bad_01, cache)
+
+    # Enabled: catches 0x0101010101010101 with exact hex diagnostic.
+    monkeypatch.setenv("VLLM_K31_ROPE_GUARDS", "1")
+    with pytest.raises(K31RopeGuardError, match=r"0x0101010101010101"):
+        rope_guard.check_positions("ctx_rope", bad_01, cache)
+
+    # Catches negative and == limit.
+    with pytest.raises(K31RopeGuardError, match=r"positions\[1\]=-1"):
+        rope_guard.check_positions(
+            "neg", torch.tensor([0, -1, 2], dtype=torch.int64), cache
+        )
+    with pytest.raises(K31RopeGuardError, match=r"positions\[0\]=8192"):
+        rope_guard.check_positions(
+            "oob", torch.tensor([8192], dtype=torch.int64), cache
+        )
+
+    # Catches wrong dtype and non-contiguous slices.
+    with pytest.raises(K31RopeGuardError, match=r"expected torch\.int64"):
+        rope_guard.check_positions("dtype", torch.zeros(4, dtype=torch.int32), cache)
+    with pytest.raises(K31RopeGuardError, match=r"contiguous"):
+        rope_guard.check_positions(
+            "stride", torch.arange(8, dtype=torch.int64)[::2], cache
+        )
+
+    # Passes valid positions including boundaries 0 and limit-1.
+    rope_guard.check_positions(
+        "valid", torch.tensor([0, 17, 8191], dtype=torch.int64), cache
+    )
+
+    # Skips during CUDA graph capture and torch.compile.
+    monkeypatch.setattr(rope_guard, "_is_capturing", lambda t: True)
+    rope_guard.check_positions("capturing", bad_01, cache)
