+def _odd_boundary(rows: int, seed: int = 0):
+    """A boundary whose segments leave alignment gaps: int64 positions with
+    an odd row count, a 3-byte-per-row uint8 tensor and BF16 states."""
+    gen = torch.Generator().manual_seed(seed)
+    return {
+        "aux_hidden_states_0": torch.randn(rows, 5, generator=gen).to(torch.bfloat16),
+        "hidden_states": torch.randn(rows, 6, generator=gen).to(torch.bfloat16),
+        "mask3": torch.randint(0, 255, (rows, 3), generator=gen, dtype=torch.uint8),
+        "pp_positions": torch.randint(0, 1 << 40, (rows, 1), generator=gen),
+        "residual": torch.randn(rows, 3, 6, generator=gen).to(torch.bfloat16),
+    }
+
+
+@pytest.mark.parametrize("rows", [1, 2, 3, 5, 8, 9, 10])
+def test_cat_pack_matches_the_copy_pack_on_every_segment(rows):
+    tensors = _odd_boundary(rows + 2, seed=rows)  # padded rows past the count
+    layout = HopLayout.from_tensors(tensors)
+    stock = layout.pack(tensors, rows)
+    cat = layout.pack(tensors, rows, cat=True)
+    assert cat.dtype == torch.uint8 and cat.shape == stock.shape
+    covered = torch.zeros(layout.nbytes(rows), dtype=torch.bool)
+    for _, offset, nbytes in layout.segments(rows):
+        assert torch.equal(cat[offset : offset + nbytes], stock[offset : offset + nbytes])
+        covered[offset : offset + nbytes] = True
+    # The gap bytes are zero and nothing else differs.
+    assert (~covered).any() or rows % 2 == 0
+    assert not cat[~covered].any()
+    out = layout.unpack(cat, rows)
+    for k, v in tensors.items():
+        assert out[k].dtype == v.dtype and torch.equal(out[k], v[:rows])
+
+
+def test_cat_pack_is_one_concatenation_and_no_copy(monkeypatch):
+    tensors = _k31_boundary(rows=9, num_blocks=7)
+    layout = HopLayout.from_tensors(tensors)
+    cats, copies = [], []
+    real_cat, real_copy = torch.cat, torch.Tensor.copy_
+    monkeypatch.setattr(torch, "cat", lambda parts, *a, **k: (cats.append(len(parts)), real_cat(parts, *a, **k))[1])
+    monkeypatch.setattr(
+        torch.Tensor, "copy_", lambda self, *a, **k: (copies.append(1), real_copy(self, *a, **k))[1]
+    )
+    flat = layout.pack(tensors, 8, cat=True)
+    assert cats == [len(tensors)] and not copies  # BF16 rows of even width: no gaps
+    cats.clear()
+    stock = layout.pack(tensors, 8)
+    assert not cats and len(copies) == len(tensors)
+    assert torch.equal(flat, stock)
+
+
+@pytest.mark.parametrize("no_metadata", [False, True])
+def test_cat_pack_hop_round_trip(no_metadata):
+    wire = _Wire()
+    g0, d0 = wire.group(0)
+    g1, d1 = wire.group(1)
+    sender = PackedHop(g0, no_metadata=no_metadata, dist=d0, cat_pack=True)
+    receiver = PackedHop(g1, no_metadata=no_metadata, dist=d1)
+    for rows in (1, 3, 8, 5):
+        tensors = _odd_boundary(rows + 1, seed=rows)
+        layout = HopLayout.from_tensors(tensors)
+        assert len(sender.send(tensors, rows=rows)) == 1
+        got, _ = receiver.recv(layout, rows=rows)
+        for k, v in tensors.items():
+            assert torch.equal(got[k], v[:rows])
+    assert wire.n_isend == 4
+
