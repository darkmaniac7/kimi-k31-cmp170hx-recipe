+# -- checks shared by the CPU (Triton interpreter) and the GPU tests ----------
+
+
+@triton.jit
+def _encode_kernel(x_ptr, out_ptr, n, BLOCK: tl.constexpr):
+    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < n
+    x = tl.load(x_ptr + offs, mask=mask, other=0.0)
+    tl.store(out_ptr + offs, f32_to_e4m3_bits(x), mask=mask)
+
+
+@triton.jit
+def _decode_kernel(bits_ptr, out_ptr, n, BLOCK: tl.constexpr):
+    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < n
+    bits = tl.load(bits_ptr + offs, mask=mask, other=0)
+    tl.store(out_ptr + offs, e4m3_bits_to_f32_fast(bits), mask=mask)
+
+
+def triton_encode(x: torch.Tensor) -> torch.Tensor:
+    """fp32 -> e4m3 bits through the fork helper ``f32_to_e4m3_bits``
+    (interpreted or compiled, as the process runs Triton)."""
+    out = torch.empty(x.numel(), dtype=torch.uint8, device=x.device)
+    block = 1 << 16
+    _encode_kernel[(triton.cdiv(x.numel(), block),)](x, out, x.numel(), BLOCK=block)
+    return out
+
+
+def triton_decode(bits: torch.Tensor) -> torch.Tensor:
+    """e4m3 bits -> fp32 through the fork helper ``e4m3_bits_to_f32_fast``."""
+    out = torch.empty(bits.numel(), dtype=torch.float32, device=bits.device)
+    _decode_kernel[(1,)](bits, out, bits.numel(), BLOCK=256)
+    return out
+
+
+def first_mismatches(x: torch.Tensor, got: torch.Tensor, want: torch.Tensor) -> str:
+    bad = (got != want).nonzero().flatten()[:5].tolist()
+    return ", ".join(
+        f"{x[i].item()!r} ({x[i : i + 1].view(torch.int32).item() & 0xFFFFFFFF:#010x})"
+        f" -> {got[i].item():#04x}, want {want[i].item():#04x}"
+        for i in bad
+    )
+
+
+def check_k_insert(
+    packed: bool,
+    num_tokens: int,
+    device: str,
+    key_dtype: torch.dtype,
+    mla_bytes: int = MLA_BYTES_BF16,
+    allowed_fraction: float = 1e-4,
+) -> None:
+    """The key insert kernel against the torch reference of its math and an
+    image of the cache written by plain indexing of the view.
+
+    The kernel's LayerNorm sums in another order than ``F.layer_norm``, so a
+    key byte may differ by one code where the difference crosses a rounding
+    boundary; at most ``allowed_fraction`` of the written value bytes may,
+    and nothing else may differ at all.
+    """
+    from vllm.models.kimi_k3.nvidia import sm80_dsa
+
+    torch.manual_seed(num_tokens)
+    num_pages = (num_tokens + 2 * BLOCK - 1) // BLOCK + 1
+    # The merged wkv GEMM output is [k | weights]; k is a strided view of it.
+    kw = torch.randn(num_tokens, HEAD_DIM + NUM_HEADS, dtype=key_dtype, device=device)
+    k = kw[:, :HEAD_DIM]
+    weight = torch.rand(HEAD_DIM, dtype=torch.float32, device=device) + 0.5
+    bias = torch.randn(HEAD_DIM, dtype=torch.float32, device=device) * 0.1
+    eps = 1e-5
+    # Fewer slots than rows (graph padding), plus a padded (-1) slot.
+    num_slots = max(num_tokens - 1, 1)
+    slots = torch.randperm(num_pages * BLOCK, device=device)[:num_slots]
+    slots = slots.to(torch.int64)
+    if num_slots > 2:
+        slots[1] = -1
+
+    raw, view = make_index_cache(packed, num_pages, device, mla_bytes, fill=0x5A)
+    topk = torch.full((num_tokens + 3, TOPK), 7, dtype=torch.int32, device=device)
+    sm80_dsa.sm80_indexer_k_norm_quant_insert(
+        k, weight, bias, eps, slots, view, topk, num_tokens
+    )
+
+    bits, scale = sm80_dsa.k_norm_quant_reference(k, weight, bias, eps)
+    want_raw, want_view = make_index_cache(packed, num_pages, device, mla_bytes, 0x5A)
+    value_raw, value_view = make_index_cache(packed, num_pages, device, mla_bytes)
+    written = 0
+    for i, slot in enumerate(slots.tolist()):
+        if slot < 0:
+            continue
+        page, off = divmod(slot, BLOCK)
+        flat = want_view[page].reshape(-1)
+        flat[off * HEAD_DIM : (off + 1) * HEAD_DIM] = bits[i]
+        at = BLOCK * HEAD_DIM + off * 4
+        flat[at : at + 4] = scale[i : i + 1].view(torch.uint8)
+        value_view[page].reshape(-1)[off * HEAD_DIM : (off + 1) * HEAD_DIM] = 1
+        written += HEAD_DIM
+    value_byte = value_raw != 0
+
+    differs = raw != want_raw
+    assert not (differs & ~value_byte).any(), (
+        "bytes outside the written keys' values changed (scales, other slots, "
+        "the MLA section of a packed row)"
+    )
+    count = int(differs.sum())
+    assert count <= allowed_fraction * written, f"{count} of {written} bytes differ"
+    step = (raw[differs].to(torch.int16) - want_raw[differs].to(torch.int16)).abs()
+    assert (step == 1).all(), "a differing key byte is more than one code away"
+    assert (topk[:num_tokens] == -1).all()
+    assert (topk[num_tokens:] == 7).all()
+
+
+def check_q_quant(num_heads: int, num_tokens: int, device: str) -> None:
+    """The query quantization kernel: bytes and folded weights equal the
+    torch reference exactly, and they satisfy the properties of the format
+    stated without that reference."""
+    from vllm.models.kimi_k3.nvidia import sm80_dsa
+
+    torch.manual_seed(num_heads * 1000 + num_tokens)
+    padded = 32
+    q = torch.randn(
+        num_tokens, num_heads * HEAD_DIM, dtype=torch.bfloat16, device=device
+    ).view(num_tokens, num_heads, HEAD_DIM)
+    # Heads of very different magnitude, and an all-zero head (the amax floor).
+    q = q * torch.logspace(-3, 3, num_heads, device=device, dtype=torch.float32).to(
+        torch.bfloat16
+    ).view(1, num_heads, 1)
+    q[0, 0].zero_()
+    w = torch.randn(
+        num_tokens, HEAD_DIM + num_heads, dtype=torch.bfloat16, device=device
+    )[:, HEAD_DIM:]
+    weight_scale = HEAD_DIM**-0.5 * num_heads**-0.5
+
+    q_bits, weights = sm80_dsa.sm80_indexer_q_quant_fold_weights(
+        q, w, weight_scale, padded
+    )
+    want_bits, want_weights = sm80_dsa.q_quant_fold_weights_reference(
+        q, w, weight_scale, padded
+    )
+    assert q_bits.dtype == torch.uint8 and q_bits.shape == (
+        num_tokens,
+        padded,
+        HEAD_DIM,
+    )
+    assert weights.dtype == torch.float32 and weights.shape == (num_tokens, padded)
+    assert torch.equal(q_bits, want_bits)
+    assert torch.equal(weights, want_weights)
+    if padded != num_heads:
+        assert torch.count_nonzero(q_bits[:, num_heads:]) == 0
+        assert torch.count_nonzero(weights[:, num_heads:]) == 0
+
+    # Properties, without the reference: the scale is the power of two that
+    # puts the head's largest magnitude in (224, 448], and every value is
+    # within half an e4m3 step (1/16 relative, 2^-10 of the scale absolute).
+    amax = q.float().abs().amax(dim=-1)
+    folded = w.float() * weight_scale
+    live = (amax > 0) & (folded != 0)
+    scale = (weights[:, :num_heads] / folded)[live]
+    assert torch.equal(scale, torch.exp2(torch.log2(scale).round()))
+    ratio = amax[live] / scale
+    assert (ratio > 224 * (1 - 1e-6)).all() and (ratio <= 448).all()
+    values = sm80_dsa.e4m3_values_reference(q_bits[:, :num_heads])
+    scale_all = torch.where(live, weights[:, :num_heads] / folded, 0.0)
+    error = (values * scale_all[..., None] - q.float()).abs()
+    bound = torch.maximum(q.float().abs() / 16, scale_all[..., None] * 2.0**-10)
+    assert (error[live] <= bound[live]).all()
+    assert torch.count_nonzero(q_bits[0, 0]) == 0
+
+
+@dataclass
+class DecodeProblem:
+    """A paged decode scoring problem and the plain values behind it."""
+
+    view: torch.Tensor  # the indexer cache, written
+    values: torch.Tensor  # [slots, D] key values before their scale
+    scale: torch.Tensor  # [slots] key scales
+    q_values: torch.Tensor  # [B, next_n, H, D]
+    q_bits: torch.Tensor
+    weights: torch.Tensor  # [B * next_n, H]
+    block_table: torch.Tensor  # [B, pages] int32
+    context_lens: torch.Tensor  # [B, next_n] int32
+
+
+def exact_decode_problem(
+    packed: bool, next_n: int, device: str = "cpu", seed: int = 0
+) -> DecodeProblem:
+    """A decode problem whose logits are exact in fp32 whatever the order of
+    the sums: small integer key and query values, power-of-two weights and
+    scales. Three requests of 1, 2 and 2 pages over a permuted page table."""
+    from vllm.models.kimi_k3.nvidia import sm80_dsa
+
+    gen = torch.Generator().manual_seed(seed)
+    num_pages, batch, heads = 6, 3, 8
+    _, view = make_index_cache(packed, num_pages, device, fill=0x5A)
+    slots = torch.arange(num_pages * BLOCK, dtype=torch.int64, device=device)
+    values = torch.randint(-4, 5, (num_pages * BLOCK, HEAD_DIM), generator=gen)
+    values = values.float().to(device)
+    scale = torch.exp2(
+        torch.randint(-12, -6, (num_pages * BLOCK,), generator=gen).float()
+    ).to(device)
+    sm80_dsa.index_cache_write_reference(
+        view, slots, sm80_dsa.e4m3_bits_reference(values), scale
+    )
+    q_values = torch.randint(-4, 5, (batch, next_n, heads, HEAD_DIM), generator=gen)
+    q_values = q_values.float().to(device)
+    q_bits = sm80_dsa.e4m3_bits_reference(q_values)
+    sign = torch.randint(0, 2, (batch * next_n, heads), generator=gen) * 2 - 1
+    weights = torch.exp2(
+        torch.randint(-3, 4, (batch * next_n, heads), generator=gen).float()
+    )
+    weights = (weights * sign).to(device)
+    block_table = torch.tensor(
+        [[4, 0, 0], [2, 5, 0], [1, 3, 0]], dtype=torch.int32, device=device
+    )
+    last = torch.tensor([37, 2 * BLOCK, BLOCK + 1], dtype=torch.int32)
+    offsets = torch.arange(next_n - 1, -1, -1, dtype=torch.int32)
+    context_lens = (last[:, None] - offsets[None, :]).contiguous().to(device)
+    return DecodeProblem(
+        view, values, scale, q_values, q_bits, weights, block_table, context_lens
+    )
+
+
+def brute_force_logits(problem: DecodeProblem) -> list[torch.Tensor]:
+    """Per row, ``sum_h w[h] * relu(q[h] . k[n]) * scale[n]`` over the row's
+    context, key by key through the page table (none of the layout
+    arithmetic of the module under test)."""
+    batch, next_n = problem.context_lens.shape
+    rows = []
+    for b in range(batch):
+        for t in range(next_n):
+            length = int(problem.context_lens[b, t])
+            pos = torch.arange(length, device=problem.values.device)
+            slot = problem.block_table[b, pos // BLOCK].long() * BLOCK + pos % BLOCK
+            score = (problem.q_values[b, t] @ problem.values[slot].T).relu()
+            row = (score * problem.weights[b * next_n + t][:, None]).sum(0)
+            rows.append(row * problem.scale[slot])
+    return rows
