+__host__ __device__ __forceinline__ uint64_t compute_pp_payload_cap(uint64_t slot_bytes) {
+  return (slot_bytes - static_cast<uint64_t>(kPpHeaderBytes)) & ~127ull;
+}
+
+// ---------------------------------------------------------------------------
+// Device memory-ordering, unified 128B partitioning, NaN poison & vectorized I/O
+// ---------------------------------------------------------------------------
+
+__host__ __device__ __forceinline__ int compute_pp_active_ctas(int64_t chunk_bytes) {
+  if (chunk_bytes <= 4096) return 1;
+  int64_t ctas = (chunk_bytes + 4095) / 4096;
+  if (ctas > kFixedGrid) ctas = kFixedGrid;
+  return static_cast<int>(ctas);
+}
+
+__device__ __forceinline__ uint64_t pack_flag(uint64_t seq, uint64_t op_kind) {
+  return (seq << 8) | (op_kind & 0xFFull);
+}
+
+__device__ __forceinline__ void partition_aligned_128b(
+    int total_vecs, int num_ctas, int bid, int& v_start, int& v_count) {
+  const int total_lines = (total_vecs + 7) >> 3;
+  const int base_lines = total_lines / num_ctas;
+  const int rem_lines = total_lines % num_ctas;
+  const int start_line = bid * base_lines + (bid < rem_lines ? bid : rem_lines);
+  const int count_lines = base_lines + (bid < rem_lines ? 1 : 0);
+  v_start = start_line << 3;
+  if (v_start >= total_vecs) {
+    v_start = total_vecs;
+    v_count = 0;
+  } else {
+    int end = (start_line + count_lines) << 3;
+    if (end > total_vecs) end = total_vecs;
+    v_count = end - v_start;
+  }
+}
+
+// Unified alignment-independent 128B-line byte partition for PP send and recv (M1).
+// Both sender and receiver always map the exact same [b_start, b_start + b_count)
+// to CTA `bid` regardless of src/dst pointer alignment; b_start is always 128B-aligned.
+__device__ __forceinline__ void partition_pp_bytes_128b(
+    int cur_bytes, int num_ctas, int bid, int& b_start, int& b_count) {
+  const int total_lines = (cur_bytes + 127) >> 7;
+  const int base_lines = total_lines / num_ctas;
+  const int rem_lines = total_lines % num_ctas;
+  const int start_line = bid * base_lines + (bid < rem_lines ? bid : rem_lines);
+  const int count_lines = base_lines + (bid < rem_lines ? 1 : 0);
+  b_start = start_line << 7;
+  if (b_start >= cur_bytes) {
+    b_start = cur_bytes;
+    b_count = 0;
+  } else {
+    int end = (start_line + count_lines) << 7;
+    if (end > cur_bytes) end = cur_bytes;
+    b_count = end - b_start;
+  }
+}
+
+__device__ __forceinline__ uint64_t read_globaltimer_ns() {
+  uint64_t t;
+  asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t));
