+class _MiniNorm(nn.Module):
+    def __init__(self, hidden: int, eps: float = 1e-5):
+        super().__init__()
+        self.weight = nn.Parameter(torch.ones(hidden, dtype=torch.bfloat16))
+        self.variance_epsilon = eps
+
+
+class _MiniProj(nn.Module):
+    def __init__(self, hidden: int):
+        super().__init__()
+        self.weight = nn.Parameter(
+            torch.randn((1, hidden), dtype=torch.bfloat16) * 0.1
+        )
+
+
+class _MiniMoEMLP(nn.Module):
+    """Minimal MoE stub exercising ``forward`` vs ``forward_deferred_shared``."""
+
+    def __init__(self, hidden: int, seed: int):
+        super().__init__()
+        g = torch.Generator().manual_seed(seed)
+        self.w_routed = nn.Parameter(
+            torch.randn((hidden, hidden), generator=g, dtype=torch.bfloat16) * 0.05
+        )
+        self.w_shared = nn.Parameter(
+            torch.randn((hidden, hidden), generator=g, dtype=torch.bfloat16) * 0.05
+        )
+        self.experts = nn.Module()
+
+    def can_defer_shared_add(self) -> bool:
+        return True
+
+    def forward_deferred_shared(
+        self, hidden_states: torch.Tensor
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        routed = F.linear(hidden_states.float(), self.w_routed.float()).to(
+            torch.bfloat16
+        )
+        shared = F.linear(hidden_states.float(), self.w_shared.float()).to(
+            torch.bfloat16
+        )
+        return routed, shared
+
+    def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        routed, shared = self.forward_deferred_shared(hidden_states)
+        return (routed.float() + shared.float()).to(torch.bfloat16)
+
+
+class _MiniDenseMLP(nn.Module):
+    def __init__(self, hidden: int, seed: int):
+        super().__init__()
+        g = torch.Generator().manual_seed(seed)
+        self.w = nn.Parameter(
+            torch.randn((hidden, hidden), generator=g, dtype=torch.bfloat16) * 0.05
+        )
+
+    def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        return F.linear(hidden_states.float(), self.w.float()).to(torch.bfloat16)
+
+
+def _build_mini_kimi_model(hidden: int = 64):
+    """Build a 3-layer CPU KimiLinearModel (L0 dense, L1 MoE, L2 MoE) with real
+    KimiDecoderLayer AttnRes logic."""
+    from vllm.models.kimi_k3.nvidia.model import KimiDecoderLayer, KimiLinearModel
+
+    model = KimiLinearModel.__new__(KimiLinearModel)
+    nn.Module.__init__(model)
+    model.config = SimpleNamespace(hidden_size=hidden, rms_norm_eps=1e-5)
+    model.attn_res_block_size = 12
+    model.use_attn_res = True
+    model.use_sequence_parallel = False
+    model.start_layer = 0
+    model.end_layer = 3
+    model.num_attn_res_blocks = 1
+    model.aux_hidden_state_layers = ()
+    model.output_attn_res_norm = _MiniNorm(hidden)
+    model.output_attn_res_proj = _MiniProj(hidden)
+
+    layers = nn.ModuleList()
+    for lid in range(3):
+        layer = KimiDecoderLayer.__new__(KimiDecoderLayer)
+        nn.Module.__init__(layer)
+        layer.hidden_size = hidden
+        layer.layer_idx = lid
+        layer.use_attn_res = True
+        layer.attn_res_block_size = 12
+        layer.is_block_write_layer = lid % 12 == 0
+        layer.block_write_idx = lid // 12
+        layer.prev_valid_blocks = (lid + 11) // 12
+        layer.use_sequence_parallel = False
+        layer.is_moe_layer = lid >= 1
+        layer.input_layernorm = _MiniNorm(hidden)
+        layer.post_attention_layernorm = _MiniNorm(hidden)
+        layer.self_attention_res_norm = _MiniNorm(hidden)
+        layer.self_attention_res_proj = _MiniProj(hidden)
+        layer.mlp_res_norm = _MiniNorm(hidden)
+        layer.mlp_res_proj = _MiniProj(hidden)
+        g = torch.Generator().manual_seed(200 + lid)
+        attn_w = torch.randn((hidden, hidden), generator=g, dtype=torch.bfloat16) * 0.05
+        layer._run_self_attn = lambda positions, h, w=attn_w: F.linear(
+            h.float(), w.float()
+        ).to(torch.bfloat16)
+        layer.mlp = (
+            _MiniDenseMLP(hidden, 300 + lid)
+            if lid == 0
+            else _MiniMoEMLP(hidden, 300 + lid)
+        )
+        layers.append(layer)
+    model.layers = layers
+    return model
+
+
+def _run_model_cpu_ref(model, x, monkeypatch, is_last_rank=True, aux_stream=False):
+    """Run ``model.forward`` with VLLM_K31_GLUE_ATTNRES=0 using exact CPU ref attn_res."""
+    from vllm.models.kimi_k3.nvidia import model as model_mod
+
+    _clear_glue_env(monkeypatch)
+    monkeypatch.setenv("VLLM_KIMI_K3_AUX_ATTN_RES_STREAM", "1" if aux_stream else "0")
+    monkeypatch.setattr(
+        model_mod,
+        "get_pp_group",
+        lambda: SimpleNamespace(is_first_rank=True, is_last_rank=is_last_rank),
+    )
+
+    def _cpu_attn_res(
+        prefix,
+        delta,
+        blocks,
+        nw,
+        qkw,
+        onw,
+        num_blocks,
+        block_write_idx,
+        eps,
+        output_norm_eps,
+        *,
+        delta2=None,
+    ):
+        out, new_p, new_b = ref_attn_res_rmsnorm(
+            prefix,
+            delta,
+            delta2,
+            blocks,
+            nw,
+            qkw,
+            onw,
+            num_blocks,
+            block_write_idx,
+            eps,
+            output_norm_eps,
+        )
+        if delta is not None:
+            prefix.copy_(new_p)
+        if block_write_idx >= 0:
+            blocks.copy_(new_b)
+        return out
+
+    monkeypatch.setattr(model_mod, "attn_res", _cpu_attn_res)
+    positions = torch.arange(x.shape[0], dtype=torch.long)
+    return model.forward(None, positions, None, inputs_embeds=x.clone())
+
+
+def test_model_delta2_fold_and_aux_hidden_states_and_hooks(monkeypatch):
+    from vllm.models.kimi_k3.nvidia import model as model_mod
+    import importlib; ar_mod = importlib.import_module('vllm.models.kimi_k3.nvidia.ops.attn_res')
+
+    torch.manual_seed(77)
+    x = torch.randn((4, 64), dtype=torch.bfloat16) * 0.5
+    positions = torch.arange(4, dtype=torch.long)
+
+    # Case A: glue ON, no hooks, no aux -> L1 defers into L2, L2 defers into output norm.
+    model = _build_mini_kimi_model(hidden=64)
+    ref_out = _run_model_cpu_ref(model, x, monkeypatch, is_last_rank=True)
+
+    _clear_glue_env(monkeypatch)
+    fake = FakeGlueOps().install(monkeypatch)
+    monkeypatch.setenv("VLLM_K31_GLUE_ATTNRES", "1")
+    monkeypatch.setattr(model_mod, "attn_res", ar_mod.attn_res)
+    monkeypatch.setattr(
+        model_mod,
+        "get_pp_group",
+        lambda: SimpleNamespace(is_first_rank=True, is_last_rank=True),
+    )
+    got_out = model.forward(None, positions, None, inputs_embeds=x.clone())
+
+    ar_calls = fake.calls_for("attn_res_rmsnorm")
+    assert len(ar_calls) == 7
+    assert ar_calls[4]["has_delta2"] is True
+    assert ar_calls[6]["has_delta2"] is True
+    assert torch.equal(got_out, ref_out)
+
+    # Case B: aux_hidden_state_layers=(2,) (DSpark tap after L1) in both modes.
+    for aux_stream in (False, True):
+        model.aux_hidden_state_layers = (2,)
+        ref_out_aux, ref_aux = _run_model_cpu_ref(
+            model, x, monkeypatch, is_last_rank=True, aux_stream=aux_stream
+        )
+
+        _clear_glue_env(monkeypatch)
+        fake = FakeGlueOps().install(monkeypatch)
+        monkeypatch.setenv("VLLM_K31_GLUE_ATTNRES", "1")
+        monkeypatch.setenv(
+            "VLLM_KIMI_K3_AUX_ATTN_RES_STREAM", "1" if aux_stream else "0"
+        )
+        monkeypatch.setattr(model_mod, "attn_res", ar_mod.attn_res)
+        monkeypatch.setattr(
+            model_mod,
+            "get_pp_group",
+            lambda: SimpleNamespace(is_first_rank=True, is_last_rank=True),
+        )
+        got_out_aux, got_aux = model.forward(
+            None, positions, None, inputs_embeds=x.clone()
+        )
+        assert torch.equal(got_out_aux, ref_out_aux)
+        assert len(got_aux) == 1 and torch.equal(got_aux[0], ref_aux[0])
+        delta2_calls = [c for c in fake.calls_for("attn_res_rmsnorm") if c["has_delta2"]]
+        assert len(delta2_calls) == 1
+        assert delta2_calls[0]["apply_out_norm"] is False
+
+    # Case C: forward hook on L1.mlp (simulating g3taps.py) disables delta2 on L1.
+    model.aux_hidden_state_layers = ()
+    hook_seen = []
+    handle = model.layers[1].mlp.register_forward_hook(
+        lambda mod, inp, out: hook_seen.append(out.clone())
+    )
+    try:
+        _clear_glue_env(monkeypatch)
+        fake = FakeGlueOps().install(monkeypatch)
+        monkeypatch.setenv("VLLM_K31_GLUE_ATTNRES", "1")
+        monkeypatch.setattr(model_mod, "attn_res", ar_mod.attn_res)
+        monkeypatch.setattr(
+            model_mod,
+            "get_pp_group",
+            lambda: SimpleNamespace(is_first_rank=True, is_last_rank=True),
+        )
+        got_hooked = model.forward(None, positions, None, inputs_embeds=x.clone())
+        assert len(hook_seen) == 1
+        assert isinstance(hook_seen[0], torch.Tensor) and hook_seen[0].shape == (4, 64)
+        assert torch.equal(got_hooked, ref_out)
+        calls = fake.calls_for("attn_res_rmsnorm")
+        assert calls[4]["has_delta2"] is False
+        assert calls[6]["has_delta2"] is True
+    finally:
+        handle.remove()
+
+    # Case D: non-final PP rank never defers L2 across the PP boundary.
+    ref_pp = _run_model_cpu_ref(model, x, monkeypatch, is_last_rank=False)
+    _clear_glue_env(monkeypatch)
+    fake = FakeGlueOps().install(monkeypatch)
+    monkeypatch.setenv("VLLM_K31_GLUE_ATTNRES", "1")
+    monkeypatch.setattr(model_mod, "attn_res", ar_mod.attn_res)
+    monkeypatch.setattr(
+        model_mod,
+        "get_pp_group",
+        lambda: SimpleNamespace(is_first_rank=True, is_last_rank=False),
+    )
+    got_pp = model.forward(None, positions, None, inputs_embeds=x.clone())
+    assert torch.equal(got_pp["hidden_states"], ref_pp["hidden_states"])
+    assert torch.equal(got_pp["residual"], ref_pp["residual"])
+
