+void fused_q_kv_rmsnorm(
+    const at::Tensor& q_c,
+    const at::Tensor& kv_c,
+    const at::Tensor& q_weight,
+    const at::Tensor& kv_weight,
+    double q_eps,
+    double kv_eps,
+    at::Tensor q_out,
+    at::Tensor kv_out) {
+  TORCH_CHECK(q_c.is_cuda() && q_c.scalar_type() == at::kBFloat16 &&
+                  q_c.dim() == 2 && q_c.stride(1) == 1,
+              "q_c must be CUDA BF16 [M, q_dim]");
+  TORCH_CHECK(kv_c.is_cuda() && kv_c.scalar_type() == at::kBFloat16 &&
+                  kv_c.dim() == 2 && kv_c.stride(1) == 1,
+              "kv_c must be CUDA BF16 [M, kv_dim]");
+  const int64_t M = q_c.size(0);
+  if (M == 0) return;
+  const int64_t qd = q_c.size(1);
+  const int64_t kvd = kv_c.size(1);
+  TORCH_CHECK(kv_c.size(0) == M && (qd % 8 == 0) && (kvd % 8 == 0), "dim mismatch");
+  TORCH_CHECK(q_weight.is_cuda() && q_weight.scalar_type() == at::kBFloat16 &&
+                  q_weight.numel() == qd && q_weight.is_contiguous(),
+              "q_weight mismatch");
+  TORCH_CHECK(kv_weight.is_cuda() && kv_weight.scalar_type() == at::kBFloat16 &&
+                  kv_weight.numel() == kvd && kv_weight.is_contiguous(),
+              "kv_weight mismatch");
+  TORCH_CHECK(q_out.is_cuda() && q_out.scalar_type() == at::kBFloat16 &&
+                  q_out.size(0) == M && q_out.size(1) == qd && q_out.stride(1) == 1,
+              "q_out mismatch");
+  TORCH_CHECK(kv_out.is_cuda() && kv_out.scalar_type() == at::kBFloat16 &&
+                  kv_out.size(0) == M && kv_out.size(1) == kvd && kv_out.stride(1) == 1,
+              "kv_out mismatch");
+
+  TORCH_CHECK(is_aligned_16(q_c.data_ptr()) && (q_c.stride(0) % 8 == 0),
+              "q_c must be 16-byte aligned with row stride multiple of 8");
+  TORCH_CHECK(is_aligned_16(kv_c.data_ptr()) && (kv_c.stride(0) % 8 == 0),
+              "kv_c must be 16-byte aligned with row stride multiple of 8");
+  TORCH_CHECK(is_aligned_16(q_weight.data_ptr()) && is_aligned_16(kv_weight.data_ptr()),
+              "q_weight and kv_weight must be 16-byte aligned");
+  TORCH_CHECK(is_aligned_16(q_out.data_ptr()) && (q_out.stride(0) % 8 == 0),
+              "q_out must be 16-byte aligned with row stride multiple of 8");
+  TORCH_CHECK(is_aligned_16(kv_out.data_ptr()) && (kv_out.stride(0) % 8 == 0),
+              "kv_out must be 16-byte aligned with row stride multiple of 8");
+
+  const c10::cuda::CUDAGuard device_guard(q_c.device());
+  cudaStream_t stream = at::cuda::getCurrentCUDAStream();
+
+  dim3 grid(static_cast<unsigned>(M), 2);
+  k31_fused_q_kv_rmsnorm_kernel<<<grid, 256, 0, stream>>>(
+      reinterpret_cast<const __nv_bfloat16*>(q_c.data_ptr()),
+      reinterpret_cast<const __nv_bfloat16*>(kv_c.data_ptr()),
+      reinterpret_cast<const __nv_bfloat16*>(q_weight.data_ptr()),
+      reinterpret_cast<const __nv_bfloat16*>(kv_weight.data_ptr()),
+      reinterpret_cast<__nv_bfloat16*>(q_out.data_ptr()),
+      reinterpret_cast<__nv_bfloat16*>(kv_out.data_ptr()),
+      q_c.stride(0), kv_c.stride(0), q_out.stride(0), kv_out.stride(0),
+      static_cast<int>(qd), static_cast<int>(kvd),
+      static_cast<float>(q_eps), static_cast<float>(kv_eps));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
