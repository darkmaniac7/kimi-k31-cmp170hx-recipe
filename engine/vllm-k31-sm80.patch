+# ------------------------------------------------------------ policy
+
+
+def _policy(raw=None):
+    return AdaptiveKPolicy(AdaptiveKConfig.from_dict(raw or _raw(), KMAX))
+
+
+def _round(policy, conf, req="r"):
+    """One synchronous round: the step is scheduled and its output (with
+    ``conf`` for the next block) comes back before the next schedule."""
+    so = SimpleNamespace(num_scheduled_tokens={req: 1 + KMAX})
+    policy.note_scheduled(so)
+    policy.observe_confidence(req, policy.take_stamps(so).get(req), conf)
+
+
+def test_a_fresh_confidence_picks_the_tier_its_summary_falls_in():
+    policy = _policy()
+    for s in (0.4, 2.0, 3.0, 4.0, 6.0, 1.0):
+        _round(policy, _block(s))
+        assert policy.confidence_age("r") == 0
+        assert policy.select_by_confidence(["r"], KMAX) == _tier_of(s)
+
+
+def test_a_summary_oscillating_around_a_threshold_does_not_flap():
+    chosen = {}
+    for h in (0.0, 0.3):
+        policy = _policy(_raw(hysteresis=h))
+        picks = []
+        for s in (2.6, 2.4, 2.6, 2.4, 2.6, 2.4, 2.6):
+            _round(policy, _block(s))
+            picks.append(policy.select_by_confidence(["r"], KMAX))
+        chosen[h] = picks
+    # Control: without a margin every crossing moves the tier.
+    assert chosen[0.0] == [7, 5, 7, 5, 7, 5, 7]
+    assert chosen[0.3] == [7] * 7
+    # A clear change still moves it, several tiers at once.
+    policy = _policy(_raw(hysteresis=0.3))
+    _round(policy, _block(2.6))
+    assert policy.select_by_confidence(["r"], KMAX) == 7
+    _round(policy, _block(0.5))
+    assert policy.select_by_confidence(["r"], KMAX) == 3
+    _round(policy, _block(6.0))
+    assert policy.select_by_confidence(["r"], KMAX) == 12
+
+
+def test_in_flight_steps_age_the_confidence_and_max_age_drops_it():
+    policy = _policy(_raw(max_age=1))
+    _round(policy, _block(6.0))
+    assert policy.confidence_age("r") == 0
+    assert policy.select_by_confidence(["r"], KMAX) == 12
+    # One step scheduled whose output is still out: the newest confidence
+    # describes the block that step verifies, one older than the next one.
+    in_flight = SimpleNamespace(num_scheduled_tokens={"r": 1 + KMAX})
+    policy.note_scheduled(in_flight)
+    assert policy.confidence_age("r") == 1
+    assert policy.select_by_confidence(["r"], KMAX) == 12
+    policy.note_scheduled(SimpleNamespace(num_scheduled_tokens={"r": 1 + KMAX}))
+    assert policy.confidence_age("r") == 2
+    # Past max_age acceptance alone decides: prior 0.75 at 12 positions gives
+    # 2.905 expected drafts, tier 7, not the stale block's 12.
+    assert policy.select_by_confidence(["r"], KMAX) == 7
+    # The late output of the in-flight step is older than nothing on hand but
+    # newer than the stored one, so it is taken.
+    policy.observe_confidence("r", policy.take_stamps(in_flight)["r"], _block(0.5))
+    assert policy.confidence_age("r") == 1
+    assert policy.select_by_confidence(["r"], KMAX) == 3
+
+
+def test_an_older_output_never_replaces_a_newer_confidence():
+    policy = _policy()
+    first = SimpleNamespace(num_scheduled_tokens={"r": 1})
+    second = SimpleNamespace(num_scheduled_tokens={"r": 1})
+    policy.note_scheduled(first)
+    policy.note_scheduled(second)
+    policy.observe_confidence("r", policy.take_stamps(second)["r"], _block(6.0))
+    policy.observe_confidence("r", policy.take_stamps(first)["r"], _block(0.5))
+    assert policy.select_by_confidence(["r"], KMAX) == 12
+
+
+def test_the_step_takes_the_widest_request_tier_capped_by_the_load():
+    policy = _policy(dict(_raw(), by_load=[12, 7]))
+    _round(policy, _block(0.5), req="a")
+    _round(policy, _block(6.0), req="b")
+    assert policy.select_by_confidence(["a"], 12) == 3
+    assert policy.select_by_confidence(["a", "b"], 12) == 12
+    assert policy.select_by_confidence(["a", "b"], 7) == 7
+    # A cap between tiers snaps down to a captured tier.
+    assert policy.select_by_confidence(["a", "b"], 8) == 7
+
+
+def test_acceptance_moves_the_summary_and_forget_clears_everything():
+    policy = _policy(_raw(accept_weight=1.0))
+    _round(policy, _block(6.0))
+    # accept_weight 1.0: the confidence is never read; the prior decides.
+    assert policy.select_by_confidence(["r"], KMAX) == 7
+    for _ in range(6):
+        policy.observe("r", 12, 12)
+    assert policy.select_by_confidence(["r"], KMAX) == 12
+    for _ in range(40):
+        policy.observe("r", 12, 0)
+    assert policy.select_by_confidence(["r"], KMAX) == 3
+    policy.forget("r")
+    assert not policy._steps and not policy._conf and not policy._tier
+    # An output arriving after forget does not resurrect the request.
+    policy.observe_confidence("r", 7, _block(6.0))
+    assert "r" not in policy._conf
+
