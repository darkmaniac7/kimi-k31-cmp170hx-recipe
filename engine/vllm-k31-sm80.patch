@@ -0,0 +1,183 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The opt-in PCIe peer-to-peer leg of the custom all-reduce topology check.
+
+Upstream's ``is_fully_connected`` answers yes only for NVLink, and
+``CustomAllreduce`` refuses more than two GPUs that are not fully connected.
+With ``VLLM_CUSTOM_ALLREDUCE_PCIE_P2P=1`` the fork's CUDA platform
+(``vllm.sm80.platform``) also counts a group whose every pair reports working
+PCIe peer-to-peer. The bytes-moving ``gpu_p2p_access_check`` probe stays
+mandatory behind it: ``VLLM_SKIP_P2P_CHECK`` is not honoured under the flag.
+
+NVML handles, the device count and the visible-to-physical map are read from
+``vllm.platforms.cuda`` at call time, so this module imports no CUDA code.
+"""
+
+import os
+
+import torch
+
+import vllm.envs as envs
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+
+def pcie_p2p_custom_allreduce_allowed() -> bool:
+    """Whether the opt-in PCIe peer-to-peer custom all-reduce may be used.
+
+    VLLM_CUSTOM_ALLREDUCE_PCIE_P2P asks for it. This also refuses when
+    PyTorch's expandable_segments allocator is on, because the two cannot work
+    together: CustomAllreduce takes legacy CUDA IPC handles on its captured
+    CUDA-graph buffers (``cudaIpcGetMemHandle`` in ``get_graph_buffer_ipc_meta``),
+    and that call returns ``cudaErrorInvalidValue`` for VMM-backed expandable
+    allocations. Left unguarded the combination kills every worker part-way
+    through startup, reporting only ``Cuda error ... 'invalid argument'`` from
+    custom_all_reduce.cuh with nothing to connect it to the allocator.
+
+    Refusing here instead leaves the host-staged path serving (with
+    VLLM_HOST_ALLREDUCE=1; NCCL otherwise), so the flag is safe to leave
+    set: it simply does nothing until the allocator allows it.
+    """
+    if not envs.VLLM_CUSTOM_ALLREDUCE_PCIE_P2P:
+        return False
+    if "expandable_segments:True" in os.environ.get("PYTORCH_CUDA_ALLOC_CONF", ""):
+        logger.warning_once(
+            "VLLM_CUSTOM_ALLREDUCE_PCIE_P2P=1 is ignored because "
+            "PYTORCH_CUDA_ALLOC_CONF contains expandable_segments:True. The "
+            "custom all-reduce needs legacy CUDA IPC handles for its captured "
+            "graph buffers and the VMM allocator cannot provide them. Unset "
+            "expandable_segments to use the device-memory path; until then the "
+            "host-staged all-reduce keeps serving."
+        )
+        return False
+    return True
+
+
+def nvml_caps_index(name: str) -> int | None:
+    """The integer value of a pynvml P2P caps-index constant, or None.
+
+    ``nvmlDeviceGetP2PStatus`` passes this straight to ctypes, so it has to be
+    a real int. vLLM's vendored pynvml declares
+    ``NVML_P2P_CAPS_INDEX_READ = (0,)`` -- a 1-tuple, from a stray trailing
+    comma -- which ctypes refuses to convert. Unwrap that spelling rather than
+    depend on the typo being fixed, and treat anything else as absent so the
+    caller falls back to torch.
+    """
+    from vllm.platforms import cuda as cuda_platform
+
+    value = getattr(cuda_platform.pynvml, name, None)
+    if isinstance(value, tuple) and len(value) == 1:
+        value = value[0]
+    if isinstance(value, bool) or not isinstance(value, int):
+        return None
+    return value
+
+
+def _nvml_pcie_p2p_fully_connected(physical_device_ids: list[int]) -> bool:
+    """True when NVML reports READ *and* WRITE P2P OK for every ordered pair.
+
+    Returns False -- not an error -- when this pynvml does not expose the READ
+    and WRITE caps indices, so the caller can fall back to torch's peer query.
+    """
+    from vllm.platforms import cuda as cuda_platform
+
+    pynvml = cuda_platform.pynvml
+    read_index = nvml_caps_index("NVML_P2P_CAPS_INDEX_READ")
+    write_index = nvml_caps_index("NVML_P2P_CAPS_INDEX_WRITE")
+    if read_index is None or write_index is None:
+        logger.debug(
+            "pynvml exposes no usable NVML_P2P_CAPS_INDEX_READ/_WRITE; using"
+            " torch.cuda.can_device_access_peer for the PCIe P2P check."
+        )
+        return False
+    try:
+        handles = [pynvml.nvmlDeviceGetHandleByIndex(i) for i in physical_device_ids]
+        for i, handle in enumerate(handles):
+            for j, peer_handle in enumerate(handles):
+                if i == j:
+                    continue
+                for caps_index in (read_index, write_index):
+                    status = pynvml.nvmlDeviceGetP2PStatus(
+                        handle, peer_handle, caps_index
+                    )
+                    if status != pynvml.NVML_P2P_STATUS_OK:
+                        return False
+    except Exception as exc:
+        # Deliberately broad. Besides NVMLError this has to survive a pynvml
+        # whose constants or signatures do not match the loaded libnvidia-ml,
+        # which surfaces as ctypes.ArgumentError rather than NVMLError. The
+        # torch fallback below answers the same question; a driver quirk here
+        # must never be the reason a server fails to start.
+        logger.debug("NVML PCIe P2P query failed (%s).", exc)
+        return False
+    return True
+
+
+def _torch_p2p_fully_connected(physical_device_ids: list[int]) -> bool:
+    """True when torch reports peer access both ways for every pair.
+
+    ``can_device_access_peer`` takes visible ordinals, so the physical IDs are
+    translated back through the device-control env var first.
+    """
+    from vllm.platforms import cuda as cuda_platform
+
+    try:
+        physical_to_visible = {
+            cuda_platform.CudaPlatformBase.visible_device_id_to_physical_device_id(
+                visible
+            ): visible
+            for visible in range(cuda_platform._cuda_device_count_stateless())
+        }
+        ordinals = [physical_to_visible[pid] for pid in physical_device_ids]
+    except Exception as exc:
+        logger.debug("PCIe P2P check: cannot map physical device ids (%s).", exc)
+        return False
+    for i, a in enumerate(ordinals):
+        for j, b in enumerate(ordinals):
+            if i == j:
+                continue
+            try:
+                if not torch.cuda.can_device_access_peer(a, b):
+                    return False
+            except Exception as exc:
+                logger.debug("PCIe P2P check failed for %d->%d (%s).", a, b, exc)
+                return False
+    return True
+
+
+def pcie_p2p_fully_connected(
+    physical_device_ids: list[int], *, use_nvml: bool
+) -> bool:
+    """The opt-in PCIe leg of ``is_fully_connected``.
+
+    Gated on VLLM_CUSTOM_ALLREDUCE_PCIE_P2P. A True here only says the
+    driver *advertises* peer access; it never stands alone. CustomAllreduce
+    still has to pass ``gpu_p2p_access_check``, the probe that actually moves
+    bytes between the cards, and the same env makes that probe mandatory.
+    """
+    if not pcie_p2p_custom_allreduce_allowed():
+        return False
+    if len(physical_device_ids) < 2:
+        return False
+    connected = use_nvml and _nvml_pcie_p2p_fully_connected(physical_device_ids)
+    if not connected:
+        connected = _torch_p2p_fully_connected(physical_device_ids)
+    # `*_once` de-duplicates on the arguments, so they have to be hashable.
+    device_list = ", ".join(str(i) for i in physical_device_ids)
+    if connected:
+        logger.info_once(
+            "VLLM_CUSTOM_ALLREDUCE_PCIE_P2P=1 and every pair of devices"
+            " [%s] reports working PCIe peer-to-peer, so this group counts as"
+            " fully connected for the custom all-reduce. The"
+            " gpu_p2p_access_check probe still has to pass before it is used.",
+            device_list,
+        )
+    else:
+        logger.warning_once(
+            "VLLM_CUSTOM_ALLREDUCE_PCIE_P2P=1, but PCIe peer-to-peer is not"
+            " available for every pair of devices [%s]. The custom all-reduce"
+            " stays disabled for more than two GPUs.",
+            device_list,
+        )
+    return connected
diff --git a/vllm/sm80/distributed/round_once_all_reduce.py b/vllm/sm80/distributed/round_once_all_reduce.py
new file mode 100644
index 0000000000..41cd755e9c
--- /dev/null
+++ b/vllm/sm80/distributed/round_once_all_reduce.py
@@ -0,0 +1,171 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Round-once all-reduce of large messages over grouped NCCL send/recv.
+
+Why this exists
+---------------
+NCCL's ring all-reduce of a BF16 (or FP16) message stores every hop's partial
+sum in the message dtype, so with N ranks an element is rounded N - 1 times
+and the result depends on the ring order. At TP4 about a third of the elements
+of a prefill-sized message differ from the correctly rounded sum (CPU emulation
+of the ring, calibrated against a measured TP4 run). Two ranks are the
+exception: one hop, one rounding.
+
+What it does
+------------
+The same payload bytes and collectives as the ring, with one rounding:
+
+  1. reduce-scatter as one grouped set of NCCL send/recv: the flat message is
+     cut into N equal chunks (the last one zero-padded) and rank r receives
+     every rank's chunk r, in the message dtype;
+  2. rank r sums its N chunks in FP64 in rank order and rounds the sum once to
+     the message dtype (round to odd into FP32, then round to nearest even:
+     a correct rounding of the FP64 sum);
+  3. all-gather of the rounded chunks (NCCL), in the message dtype;
+     unsupported elements carry a NaN poison flag in that same payload.
+
+Exactness: the FP64 sum of N BF16 (FP16) values is exact while their nonzero
+magnitudes lie within a factor 2^(45 - ceil(log2 N)) (2^(42 - ceil(log2 N)))
+of each other. Each owner checks this bound per element, ignoring zero
+summands. Nonfinite inputs and spans outside the bound set the same sticky
+device error on every rank after the existing result all-gather. Serving
+raises ValueError at the existing output-copy completion event on every
+rank, before publishing tokens; no additional collective, host sync or
+device trap is used. CPU transports refuse directly after the data gather.
+A small summand could otherwise be lost (BF16 [1, 2**-60, -1, 0], for
+example). Messages of other dtypes are not taken.
+
+Used only outside CUDA graph capture (the call sites ask for it on eager
+prefill steps), with the TP group's PyNccl communicator. Model call sites opt
+in through their own switches; VLLM_ROUND_ONCE_ALLREDUCE_GROUPED selects this
+transport for them (see vllm/sm80/envs.py).
+"""
+
+from collections.abc import Callable
+
+import torch
+
+ROUND_ONCE_DTYPES = (torch.bfloat16, torch.float16)
+
+
+def round_from_fp64(x: torch.Tensor, dtype: torch.dtype) -> torch.Tensor:
+    """``x`` (FP64) correctly rounded to ``dtype`` (BF16 or FP16; round to
+    nearest, ties to even): first rounded to odd into FP32 (truncate towards
+    zero, then set the last bit when inexact), which keeps the conversion to
+    the narrower format correctly rounded, FP32 having at least 13 more
+    significand bits."""
+    f = x.float()
+    back = f.double()
+    inexact = back != x
+    away = inexact & (back.abs() > x.abs())
+    bits = f.view(torch.int32)
+    bits = torch.where(away, bits - 1, bits)
+    bits = torch.where(inexact, bits | 1, bits)
+    return bits.view(torch.float32).to(dtype)
+
+
+# exchange(send_chunks, recv_chunks): rank r sends send_chunks[j] to rank j and
+# receives rank j's chunk r into recv_chunks[j], for every j != r (one group).
+Exchange = Callable[[list[torch.Tensor], list[torch.Tensor]], None]
+# all_gather(out, chunk): out = the ranks' chunks in rank order.
+AllGather = Callable[[torch.Tensor, torch.Tensor], None]
+
+
+def round_once_all_reduce_with(
+    t: torch.Tensor,
+    rank: int,
+    world: int,
+    exchange: Exchange,
+    all_gather: AllGather,
+) -> torch.Tensor:
+    """The round-once all-reduce of ``t`` over ``world`` ranks with the given
+    transports (NCCL in serving, gloo in the CPU tests). Returns a new tensor
+    like ``t``; ``t`` is not modified. CUDA callers must consume the deferred
+    error via ``step_errors`` at their existing host-copy completion boundary."""
+    if t.dtype not in ROUND_ONCE_DTYPES:
+        raise TypeError(f"round-once all-reduce of {t.dtype}")
+    flat = t.reshape(-1)
+    numel = flat.numel()
+    chunk = -(-numel // world)
+    if chunk == 0:
+        return t.clone()
+    if chunk * world != numel:
+        padded = torch.zeros(chunk * world, dtype=t.dtype, device=t.device)
+        padded[:numel] = flat
+        flat = padded
+    sends = list(flat.view(world, chunk).unbind(0))
+    recv = torch.empty((world, chunk), dtype=t.dtype, device=t.device)
+    recvs = list(recv.unbind(0))
+    recvs[rank].copy_(sends[rank])
+    if world > 1:
+        exchange(sends, recvs)
+    if t.is_cuda:
+        from .round_once_kernels import reduce_scattered
+        mine = reduce_scattered(recv)
+    else:
+        acc = recv[0].double()
+        largest = acc.abs()
+        smallest = torch.where(largest == 0, float("inf"), largest)
+        for j in range(1, world):
+            part = recv[j].double()
+            acc += part
+            magnitude = part.abs_()
+            torch.maximum(largest, magnitude, out=largest)
+            magnitude.masked_fill_(magnitude == 0, float("inf"))
+            torch.minimum(smallest, magnitude, out=smallest)
+        span_bits = (45 if t.dtype == torch.bfloat16 else 42) - (world - 1).bit_length()
+        invalid = ~torch.isfinite(largest) | (largest > smallest * 2.0**span_bits)
+        mine = torch.where(invalid, float("nan"), round_from_fp64(acc, t.dtype))
+    gathered = torch.empty(chunk * world, dtype=t.dtype, device=t.device)
+    if world > 1:
+        all_gather(gathered, mine)
+    else:
+        gathered.copy_(mine)
+    if t.is_cuda:
+        from .round_once_kernels import record_error
+        from .step_errors import error_buffer
+        record_error(gathered, error_buffer(t.device))
+    elif bool(torch.isnan(gathered).any()):
+        raise ValueError("round-once all-reduce requires a finite exponent span on all ranks")
+    return gathered[:numel].view(t.shape)
+
+
+def nccl_round_once_all_reduce(t: torch.Tensor, pynccl) -> torch.Tensor:
+    """:func:`round_once_all_reduce_with` over a vLLM ``PyNcclCommunicator``
+    on the current stream: one NCCL group of sends and receives and one
+    output all-gather. Device validation is deferred to the existing
+    output-copy boundary; it does not synchronize or add a collective."""
+    rank, world = pynccl.rank, pynccl.world_size
+    stream = torch.cuda.current_stream()
+
+    def exchange(sends, recvs):
+        pynccl.group_start()
+        for j in range(world):
+            if j != rank:
+                pynccl.send(sends[j], j, stream)
+                pynccl.recv(recvs[j], j, stream)
+        pynccl.group_end()
+
+    def all_gather(out, chunk):
+        pynccl.all_gather(out, chunk, stream)
+
+    return round_once_all_reduce_with(t, rank, world, exchange, all_gather)
+
+
+def grouped_round_once_takes(t: torch.Tensor, comm) -> bool:
+    """Whether :func:`nccl_round_once_all_reduce` can reduce ``t`` on the
+    device communicator ``comm``: a contiguous message of a round-once dtype,
+    an enabled PyNccl communicator of more than one rank on ``t``'s device,
+    and no CUDA graph being captured."""
+    pynccl = getattr(comm, "pynccl_comm", None)
+    return (
+        t.is_cuda
+        and t.dtype in ROUND_ONCE_DTYPES
+        and t.is_contiguous()
+        and t.numel() > 0
+        and pynccl is not None
+        and not pynccl.disabled
+        and pynccl.world_size > 1
+        and t.device == pynccl.device
+        and not torch.cuda.is_current_stream_capturing()
+    )
