@@ -0,0 +1,315 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The K3.1 dense backend against the EXL3 path on a card, on real mini
+checkpoint weights, module by module.
+
+For every dense EXL3 module of mini layers 0 (KDA + dense MLP), 1 (KDA +
+MoE) and 3 (MLA + MoE) and the LM head, cut for tensor parallel size 1 and
+for each rank of 2 the way the methods cut them, the output of the engine's
+K3.1 launcher (vllm/sm80/kernels/k31q/dense.py, through the registered
+operator vllm::k31_dense_linear and the library vllm/_k31_dense_C) is
+compared with the output of the EXL3 path (vllm::exl3_linear per matrix,
+concatenated), on the same BF16 input, at 1 to 32 rows (the library's decode
+path), 33, 256 and 2,100 rows (its prefill path; 2,100 is two launches of at
+most 2,048).
+
+Tolerance, fixed before the first run: relative L2 distance at most 0.006
+(the lane's tolerance for one dense op; the kernel owner measured 0.0017 to
+0.0039 between the two kernels). Also: a CUDA graph replay of a launch gives
+the eager bits, and repeated eager calls give the same bits.
+
+Needs a CUDA device, the built libraries (_k31_dense_C, _exl3_C) and the
+mini checkpoint.
+"""
+
+from contextlib import ExitStack
+
+import pytest
+import torch
+from safetensors import safe_open
+
+from tests.models.kimi_k3.sm80 import gpu
+
+pytestmark = gpu.CUDA_MARKS
+
+TOLERANCE = 0.006
+ROWS = (1, 4, 8, 16, 32, 33, 256, 2100)
+HEAD_ROWS = (1, 8, 64)
+LAUNCH_ROWS = 2048
+L = "language_model.model.layers."
+# (name, layer, members, cut, logical in, logical outs, input) per module;
+# cut: "column" cuts outputs, "row" cuts inputs, "whole" holds the matrix on
+# every rank. Input: a reference activation of the layer, or random.
+A = "self_attn."
+SE = "block_sparse_moe.shared_experts."
+MOE = "block_sparse_moe."
+MODULES = (
+    ("L1 KDA q+k+v+g", 1, [A + "q_proj", A + "k_proj", A + "v_proj", A + "g_proj"],
+     "column", 7168, [12288] * 4, "attn_in"),
+    ("L1 KDA o_proj", 1, [A + "o_proj"], "row", 12288, [7168], None),
+    ("L1 shared gate+up", 1, [SE + "gate_proj", SE + "up_proj"],
+     "column", 7168, [6144] * 2, "mlp_in"),
+    ("L1 shared down", 1, [SE + "down_proj"], "row", 6144, [7168], None),
+    ("L1 latent down", 1, [MOE + "routed_expert_down_proj"],
+     "whole", 7168, [3584], "mlp_in"),
+    ("L1 latent up", 1, [MOE + "routed_expert_up_proj"],
+     "whole", 3584, [7168], None),
+    ("L0 MLP gate+up", 0, ["mlp.gate_proj", "mlp.up_proj"],
+     "column", 7168, [33792] * 2, "mlp_in"),
+    ("L0 MLP down", 0, ["mlp.down_proj"], "row", 33792, [7168], None),
+    ("L3 MLA q_a+kv_a", 3, [A + "q_a_proj", A + "kv_a_proj_with_mqa"],
+     "whole", 7168, [1536, 576], "attn_in"),
+    ("L3 MLA q_b", 3, [A + "q_b_proj"], "column", 1536, [18432], None),
+    ("L3 MLA g_proj", 3, [A + "g_proj"], "column", 7168, [12288], "attn_in"),
+    ("L3 MLA o_proj", 3, [A + "o_proj"], "row", 12288, [7168], None),
+)  # fmt: skip
+TP_CASES = [(1, 0), (2, 0), (2, 1)]
+
+
+@pytest.fixture(scope="module")
+def libraries():
+    from vllm.sm80.kernels.exl3 import ops as exl3_ops
+    from vllm.sm80.kernels.k31q import dense, dense_k31_ops
+
+    gpu.require_library(dense_k31_ops.ensure_dense_k31_extension, "_k31_dense_C")
+    gpu.require_library(exl3_ops.ensure_extension, "_exl3_C")
+    return dense, exl3_ops
+
+
+@pytest.fixture
+def manager(monkeypatch):
+    from vllm.v1.worker import workspace
+
+    manager = workspace.WorkspaceManager(torch.device("cuda:0"))
+    monkeypatch.setattr(workspace, "_manager", manager)
+    return manager
+
+
+def _weights(manifest, files, ledger, prefixes, cut, logical_in, outs, tp, rank):
+    """Exl3PackedWeight of each member, cut for (tp, rank) as the K3.1
+    methods cut them (vllm/sm80/kernels/exl3/quant.py create_weights)."""
+    from vllm.sm80.kernels.exl3.quant import Exl3PackedWeight
+    from vllm.sm80.kernels.exl3.utils import aligned_shard
+
+    weights = []
+    for prefix, full_out in zip(prefixes, outs):
+        matrix = manifest.matrices[prefix]
+        if cut == "column":
+            inputs = slice(0, matrix.padded_in)
+            outputs = aligned_shard(full_out, matrix.padded_out, rank, tp)
+            local_in, local_out = logical_in, full_out // tp
+        elif cut == "row":
+            inputs = aligned_shard(logical_in, matrix.padded_in, rank, tp)
+            outputs = slice(0, matrix.padded_out)
+            local_in, local_out = logical_in // tp, full_out
+        else:
+            inputs, outputs = slice(0, matrix.padded_in), slice(0, matrix.padded_out)
+            local_in, local_out = logical_in, full_out
+        with torch.device("cuda:0"):
+            weight = Exl3PackedWeight(matrix, local_in, local_out, inputs, [outputs])
+        weight.load(files, ledger)
+        weights.append(weight)
+    return weights
+
+
+def _old_path(exl3_ops, x, weights, out_dtype):
+    outputs = [
+        torch.ops.vllm.exl3_linear(
+            x,
+            w.trellis,
+            w.suh,
+            w.svh,
+            w.matrix.bits_x2,
+            w.matrix.codebook,
+            w.logical_out,
+            exl3_ops.linear_row_chunk(w.padded_in, w.padded_out),
+            out_dtype,
+        )
+        for w in weights
+    ]
+    return outputs[0] if len(outputs) == 1 else torch.cat(outputs, dim=-1)
+
+
+def _input(source, refs, rows, width, seed):
+    """Reference rows of layer 1 (``attn_in`` or ``mlp_in``, repeated past
+    its 512 rows) or random rows."""
+    if source is not None:
+        base = refs[source]
+        reps = -(-rows // base.shape[0])
+        return base.repeat(reps, 1)[:rows].contiguous()
+    generator = torch.Generator(device="cuda").manual_seed(seed)
+    x = torch.randn((rows, width), generator=generator, device="cuda") * 0.5
+    return x.to(torch.bfloat16)
+
+
+def _open(stack, manifest):
+    return {
+        path: stack.enter_context(safe_open(str(path), framework="pt", device="cpu"))
+        for path in sorted({h.path for h in manifest.tensors.values()})
+    }
+
+
+@pytest.mark.parametrize(("tp", "rank"), TP_CASES)
+def test_modules_match_the_exl3_path(libraries, manager, tp, rank):
+    from vllm.sm80.kernels.exl3.utils import Exl3LoadLedger
+    from vllm.sm80.kernels.k31q import dense_k31_ops
+    from vllm.sm80.kernels.k31q.manifest import K31QManifest
+
+    dense, exl3_ops = libraries
+    mini = gpu.require_mini()
+    manifest = K31QManifest(mini)
+    # The reference activations cover layers 0 and 1; layer 1's are the
+    # inputs of every module that reads the hidden state.
+    refs = {
+        source: tensor.to(torch.bfloat16).contiguous()
+        for source, tensor in zip(
+            ("attn_in", "mlp_in"),
+            gpu.tensors(mini / "ref_acts.safetensors", "L1.attn_in.q", "L1.mlp_in.q"),
+        )
+    }
+    worst = {}
+    with ExitStack() as stack:
+        files = _open(stack, manifest)
+        for name, layer, members, cut, logical_in, outs, source in MODULES:
+            prefixes = [f"{L}{layer}.{m}" for m in members]
+            weights = _weights(
+                manifest,
+                files,
+                Exl3LoadLedger(manifest),
+                prefixes,
+                cut,
+                logical_in,
+                outs,
+                tp,
+                rank,
+            )
+            launcher = dense.K31DenseLauncher(dense_k31_ops, weights, LAUNCH_ROWS)
+            assert len(launcher.groups) == 1 and launcher.groups[0].logical_outs == [
+                w.logical_out for w in weights
+            ]
+            width = weights[0].logical_in
+            for rows in ROWS:
+                x = _input(source, refs, rows, width, seed=rows + 7 * rank)
+                new = launcher(x, torch.bfloat16)
+                old = _old_path(exl3_ops, x, weights, torch.bfloat16)
+                assert (
+                    new.shape
+                    == old.shape
+                    == (rows, sum(w.logical_out for w in weights))
+                )
+                rel = gpu.rel_l2(new, old)
+                worst[name] = max(worst.get(name, 0.0), rel)
+                print(f"TP{tp} rank {rank} {name} rows {rows}: rel_l2 {rel:.5f}")
+                assert rel <= TOLERANCE, f"{name} TP{tp} rank {rank} rows {rows}: {rel}"
+            del weights, launcher
+            torch.cuda.empty_cache()
+    print(f"TP{tp} rank {rank} worst per module: {worst}")
+
+
+@pytest.mark.parametrize(("tp", "rank"), TP_CASES)
+def test_lm_head_matches_the_exl3_path(libraries, manager, tp, rank):
+    """The head's rank columns (vocabulary cut in whole blocks), BF16 and FP32
+    logits."""
+    from vllm.sm80.kernels.exl3.utils import Exl3LoadLedger
+    from vllm.sm80.kernels.k31q import dense_k31_ops
+    from vllm.sm80.kernels.k31q.manifest import K31QManifest
+
+    dense, exl3_ops = libraries
+    mini = gpu.require_mini()
+    manifest = K31QManifest(mini)
+    (hidden,) = gpu.tensors(mini / "ref_acts.safetensors", "L1.mlp_in.q")
+    with ExitStack() as stack:
+        files = _open(stack, manifest)
+        weights = _weights(
+            manifest,
+            files,
+            Exl3LoadLedger(manifest),
+            ["language_model.lm_head"],
+            "column",
+            7168,
+            [163840],
+            tp,
+            rank,
+        )
+        launcher = dense.K31DenseLauncher(dense_k31_ops, weights, LAUNCH_ROWS)
+        for out_dtype in (torch.bfloat16, torch.float32):
+            for rows in HEAD_ROWS:
+                x = hidden[:rows].to(torch.bfloat16).contiguous()
+                new = launcher(x, out_dtype)
+                old = _old_path(exl3_ops, x, weights, out_dtype)
+                assert new.dtype == old.dtype == out_dtype
+                rel = gpu.rel_l2(new, old)
+                what = f"TP{tp} rank {rank} lm_head {out_dtype} rows {rows}"
+                print(f"{what}: rel_l2 {rel:.5f}")
+                assert rel <= TOLERANCE
+
+
+def test_graph_replay_and_repeated_calls_give_the_same_bits(libraries, manager):
+    """The KDA in-projection launch at 1, 8 and 32 rows: five eager calls and
+    a CUDA graph replay (the workspace allocated by the first eager call, as
+    the engine's profile run does) give the same bits; so does a launch on
+    the auxiliary stream, which takes the second isolated workspace buffer (H4)."""
+    from vllm.sm80.kernels.exl3.utils import Exl3LoadLedger
+    from vllm.sm80.kernels.k31q import dense_k31_ops
+    from vllm.sm80.kernels.k31q.manifest import K31QManifest
+    from vllm.utils.torch_utils import aux_stream
+
+    dense, _ = libraries
+    mini = gpu.require_mini()
+    manifest = K31QManifest(mini)
+    (x_all,) = gpu.tensors(mini / "ref_acts.safetensors", "L1.attn_in.q")
+    name, layer, members, cut, logical_in, outs, _ = MODULES[0]
+    with ExitStack() as stack:
+        files = _open(stack, manifest)
+        weights = _weights(
+            manifest,
+            files,
+            Exl3LoadLedger(manifest),
+            [f"{L}{layer}.{m}" for m in members],
+            cut,
+            logical_in,
+            outs,
+            1,
+            0,
+        )
+    launcher = dense.K31DenseLauncher(dense_k31_ops, weights, LAUNCH_ROWS)
+    for rows in (1, 8, 32):
+        x = x_all[:rows].to(torch.bfloat16).contiguous()
+        first = launcher(x, torch.bfloat16)
+        for _ in range(5):
+            assert torch.equal(launcher(x, torch.bfloat16), first)
+        static_x = x.clone()
+        torch.cuda.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            graphed = launcher(static_x, torch.bfloat16)
+        for _ in range(3):
+            graph.replay()
+            torch.cuda.synchronize()
+            assert torch.equal(graphed, first)
+        stream = aux_stream()
+        stream.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(stream):
+            on_aux = launcher(x, torch.bfloat16)
+        torch.cuda.current_stream().wait_stream(stream)
+        torch.cuda.synchronize()
+        assert torch.equal(on_aux, first)
+    buffers = manager._persistent_resources[0]
+    (key,) = [k for k in buffers if k[0] == dense.WORKSPACE_KEY]
+    assert len(buffers[key]) == 2  # compute stream and auxiliary stream (H4 isolated arrival counters)
+
+
+
+def test_r71_workspace_decode_vs_prefill_sizing(libraries):
+    """R7.1: linear_workspace_size_k31 returns decode-only sizing when
+    max_rows <= 32, reclaiming >406 MiB/rank (2 streams) on Stage 0 Blackwell."""
+    from vllm.sm80.kernels.k31q import dense_k31_ops
+
+    # Layer 0 mlp.down_proj TP2: padded_in=16896, padded_out=7168, 1 member.
+    dec_down = dense_k31_ops.linear_workspace_size_k31(32, 16896, 7168, 1)
+    pre_down = dense_k31_ops.linear_workspace_size_k31(2048, 16896, 7168, 1)
+    assert dec_down * 4 < 30 * 2**20, f"decode down_proj too large: {dec_down * 4 / 2**20:.1f} MiB"
+    assert pre_down * 4 > 250 * 2**20
+    # Largest Stage 0 TP2 decode module: L0 mlp.gate_up_proj (2 members, 7168 -> 33792).
+    dec_gu = dense_k31_ops.linear_workspace_size_k31(32, 7168, 33792, 2)
+    assert dec_gu * 4 < 30 * 2**20, f"decode gate_up too large: {dec_gu * 4 / 2**20:.1f} MiB"
