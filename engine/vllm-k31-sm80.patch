+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Pre-fixed tolerance comparator for Kimi-K3.1 vLLM (k31q) vs llama.cpp (KLX) dumps.
+
+Compares per-layer residual stream hidden states, optional sub-taps, outlier
+statistics, architectural boundary transitions, final logits (top-128 + exact
+full-vocab logsumexp), and greedy token rollouts.
+
+Natively reads ALL three lab dump formats without manual adapters:
+  1. `k31_layer_dump_v1`: directory (`manifest.json` + `<prompt_id>.safetensors`
+     + `<prompt_id>.meta.json`) or single `.safetensors` file.
+  2. `g3taps`: `.pt` file(s) emitted by `g3taps.py`
+     (`<tag>.pp<stage>tp<rank>.pt`). Automatically merges PP stages, maps g3taps
+     `L{i}.out` (MLP output delta) -> `L{i}.mlp_out`, and reconstructs exact
+     post-layer residual stream `L{i}.out` (`l_out` block prefix_sum) via Kimi-K3.1's
+     AttnRes block recurrence (`attn_res_block_size = 12`).
+  3. `ref_acts.safetensors` (`format == "k31q_ref_acts"`): supports `.orig` vs `.q`
+     variants directly, maps `L{i}.out` -> `L{i}.mlp_out`, and reconstructs
+     `L0.out` / `L1.out` residual stream hidden states.
+
+Exit codes:
+  0 = PASS
+  2 = WARN (within drift band, needs inspection, no hard failure)
+  1 = FAIL (hard gate violation, cliff, norm blowup, NaN/Inf, or broken logits)
+"""
+
+from __future__ import annotations
+
+import argparse
+import difflib
+import json
+import math
+import re
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import torch
+from safetensors import safe_open
+
+SCHEMA_VERSION = "k31_layer_dump_v1"
+
+# ---------------------------------------------------------------------------
+# Kimi-K3.1-Pro Architectural Map (93 layers: 0..92, hidden=7168, vocab=163840)
+# Verified against mini-k31q/config.json, KLX GGUF header, and ref-abl/EDIT.json.
+# ---------------------------------------------------------------------------
+K31_NUM_LAYERS = 93
+K31_ATTNRES_BLOCK_SIZE = 12
+K31_DENSE_LAYERS = frozenset({0})
+K31_MLA_DSA_LAYERS = frozenset(
+    {3, 7, 11, 15, 19, 23, 27, 31, 35, 39, 43, 47, 51, 55, 59, 63, 67, 71, 75, 79, 83, 87, 91, 92}
+)
+K31_ATTNRES_BOUNDARIES = frozenset(range(0, K31_NUM_LAYERS, K31_ATTNRES_BLOCK_SIZE))
+K31_ABLITERATED_LAYERS = frozenset(range(48, 85))
+DEFAULT_PP_BOUNDARIES = (27, 50, 73)
+
+# ---------------------------------------------------------------------------
+# Pre-Fixed Tolerances (calibrated BEFORE running for KLX 1.95 bpw vs k31q 1.625/1.80 bpw)
+# ---------------------------------------------------------------------------
+TOLERANCES_V1: dict[str, Any] = {
+    "version": "k31_numerics_tol_v1",
+    "calibration_basis": "KLX IQ2_XXS (1.95 bpw mean) vs k31q VQ/EXL3 (1.625-1.80 bpw)",
+    "hard_gates": {
+        "max_nan_count": 0,
+        "max_inf_count": 0,
+        "require_matching_token_ids": True,
+        "require_token_ids_present": True,
+        "require_full_layer_coverage": True,
+    },
+    "layer_out_cosine": {
+        "L0": {"pass_min": 0.995, "warn_min": 0.985, "cos_min_floor": 0.950, "cos_min_pass_min": 0.980, "cos_min_warn_min": 0.950},
+        "L1_15": {"pass_min": 0.950, "warn_min": 0.900, "cos_min_floor": 0.800, "cos_min_pass_min": 0.880, "cos_min_warn_min": 0.800},
+        "L16_92": {"pass_min": 0.850, "warn_min": 0.780, "cos_min_floor": 0.600, "cos_min_pass_min": 0.720, "cos_min_warn_min": 0.600},
+    },
+    "single_layer_cliff": {
+        "adjacent_delta_cos_warn": -0.080,
+        "adjacent_delta_cos_fail": -0.100,
+        "sparse_gap_slope_per_layer": -0.004,
+        "sparse_gap_fail_cap": -0.200,
+        "adjacent_log_norm_ratio_warn": 0.150,
+        "adjacent_log_norm_ratio_fail": 0.250,
+    },
+    "layer_out_norm_ratio": {
+        "L0": {"pass_min": 0.970, "pass_max": 1.030, "warn_min": 0.940, "warn_max": 1.060},
+        "L1_92": {"pass_min": 0.850, "pass_max": 1.180, "warn_min": 0.750, "warn_max": 1.330},
+    },
+    "outlier_max_abs_ratio": {
+        "warn_min": 0.330,
+        "warn_max": 3.000,
+        "fail_min": 0.100,
+        "fail_max": 10.000,
+    },
+    "subtap_cosine": {
+        "L0_any": {"pass_min": 0.990, "warn_min": 0.975},
+        "L1_15_attn": {"pass_min": 0.920, "warn_min": 0.850},
+        "L16_92_attn": {"pass_min": 0.850, "warn_min": 0.750},
+        "L1_15_mlp_out": {"pass_min": 0.880, "warn_min": 0.780},
+        "L16_92_mlp_out": {"pass_min": 0.800, "warn_min": 0.700},
+        "final_norm": {"pass_min": 0.850, "warn_min": 0.780},
+    },
+    "subtap_norm_ratio": {
+        "L0_any": {"pass_min": 0.950, "pass_max": 1.050, "warn_min": 0.900, "warn_max": 1.110},
+        "L1_92_attn": {"pass_min": 0.850, "pass_max": 1.180, "warn_min": 0.750, "warn_max": 1.330},
+        "L1_15_mlp_out": {"pass_min": 0.800, "pass_max": 1.250, "warn_min": 0.700, "warn_max": 1.430},
+        "L16_92_mlp_out": {"pass_min": 0.750, "pass_max": 1.330, "warn_min": 0.650, "warn_max": 1.540},
+        "final_norm": {"pass_min": 0.850, "pass_max": 1.180, "warn_min": 0.750, "warn_max": 1.330},
+    },
+    "logits_and_tokens": {
+        "top1_agreement": {"pass_min": 0.550, "warn_min": 0.400},
+        "top5_containment": {"pass_min": 0.850, "warn_min": 0.700},
+        "top16_jaccard": {"pass_min": 0.550, "warn_min": 0.400},
+        "kl_nats": {"pass_max": 0.350, "warn_max": 0.600},
+        "js_nats": {"pass_max": 0.120, "warn_max": 0.220},
+    },
+}
+
+STATUS_ORDER = {"PASS": 0, "WARN": 1, "FAIL": 2}
+EXIT_CODE_BY_STATUS = {"PASS": 0, "WARN": 2, "FAIL": 1}
+
+
+def worst_status(*statuses: str) -> str:
+    best = "PASS"
+    for s in statuses:
+        if STATUS_ORDER.get(s, 0) > STATUS_ORDER[best]:
+            best = s
+    return best
+
+
+def layer_tags(layer_idx: int, pp_boundaries: tuple[int, ...] = DEFAULT_PP_BOUNDARIES) -> list[str]:
+    tags: list[str] = []
+    if layer_idx in K31_DENSE_LAYERS:
+        tags.append("DENSE")
+    if layer_idx in K31_MLA_DSA_LAYERS:
+        tags.append("MLA/DSA")
+    else:
+        tags.append("KDA")
+    if layer_idx in K31_ATTNRES_BOUNDARIES:
+        tags.append("ATTNRES_BLK")
+    if layer_idx in K31_ABLITERATED_LAYERS:
+        tags.append("ABL")
+    if layer_idx in pp_boundaries:
+        tags.append("PP_STAGE")
+    return tags
+
+
+def suspect_hint_for_tags(tags: list[str], reason: str) -> str:
+    hints: list[str] = []
+    if "PP_STAGE" in tags:
+        hints.append("PP stage relay (hidden_states/residual bank handoff)")
+    if "ATTNRES_BLK" in tags:
+        hints.append("AttnRes block-write / banking boundary (layer % 12 == 0)")
+    if "MLA/DSA" in tags:
+        hints.append("MLA/DSA attention or indexer kernel")
+    elif "KDA" in tags:
+        hints.append("KDA linear-attention conv1d/decay/scan kernel")
+    if "ABL" in tags:
+        hints.append("abliteration weight edit mismatch (layers 48..84)")
+    if "norm_ratio" in reason or "log_nr_jump" in reason:
+        hints.append("missing/double TP all-reduce or residual scale bug")
+    if "nan" in reason or "inf" in reason:
+        hints.append("numerical overflow / NaN propagation")
+    return "; ".join(hints) if hints else "layer projection / expert quantization kernel"
+
+
+@dataclass
+class PromptDump:
+    prompt_id: str
+    source_format: str
+    engine: str
+    tensors: dict[str, torch.Tensor] = field(default_factory=dict)
+    prompt_token_ids: list[int] | None = None
+    prompt_text: str = ""
+    generated_ids: list[int] | None = None
+    generated_text: str = ""
+    topk_ids: np.ndarray | None = None
+    topk_logits: np.ndarray | None = None
+    logsumexp: np.ndarray | None = None
+    meta: dict[str, Any] = field(default_factory=dict)
+
+
+def _parse_row_slice(spec: str | None) -> slice | None:
+    if not spec:
+        return None
+    parts = spec.split(":")
+    if len(parts) != 2:
+        raise ValueError(f"Invalid row slice {spec!r}, expected start:end (e.g. 0:64)")
+    start = int(parts[0]) if parts[0] else None
+    end = int(parts[1]) if parts[1] else None
+    return slice(start, end)
+
+
+def _slice_hidden_tensors(tensors: dict[str, torch.Tensor], sl: slice | None) -> dict[str, torch.Tensor]:
+    if sl is None:
+        return tensors
+    out: dict[str, torch.Tensor] = {}
+    for k, v in tensors.items():
+        if v.ndim >= 2 and k != "final_norm":
+            out[k] = v[sl]
+        else:
+            out[k] = v
+    return out
+
+
+def reconstruct_attnres_l_out(
+    tensors: dict[str, torch.Tensor],
+    relay_in_by_start_layer: dict[int, torch.Tensor] | None = None,
+    block_size: int = K31_ATTNRES_BLOCK_SIZE,
+) -> list[int]:
+    """Reconstruct post-layer residual stream `L{i}.out` (`l_out`) from `attn_out` + `mlp_out`.
+
+    Exact Kimi-K3.1 recurrence verified in both `kimi-k31.cpp` (lines 328-375) and
+    `vllm/models/kimi_k3/nvidia/model.py` (`_post_attn_norm` + `forward`):
+      - If `i % block_size == 0`: `prefix_sum_after_attn = L{i}.attn_out`
+      - Else:                     `prefix_sum_after_attn = l_out[i - 1] + L{i}.attn_out`
+      - Always:                   `l_out[i] = prefix_sum_after_attn + L{i}.mlp_out`
+    """
+    relay_map = relay_in_by_start_layer or {}
+    layers_avail = sorted({
+        int(m.group(1))
+        for k in tensors
+        if (m := re.match(r"^L(\d+)\.(attn_out|mlp_out|out)$", k))
+    })
+    reconstructed: list[int] = []
+    for i in layers_avail:
+        out_key = f"L{i}.out"
+        if out_key in tensors:
+            continue
+        attn_key = f"L{i}.attn_out"
+        mlp_key = f"L{i}.mlp_out"
+        if attn_key not in tensors or mlp_key not in tensors:
+            continue
+        attn_t = tensors[attn_key].float()
+        mlp_t = tensors[mlp_key].float()
+        if i % block_size == 0:
+            l_out = attn_t + mlp_t
+        else:
+            prev_key = f"L{i - 1}.out"
+            prev_t: torch.Tensor | None = None
+            if prev_key in tensors:
+                prev_t = tensors[prev_key].float()
+            elif i in relay_map:
+                prev_t = relay_map[i].float()
+            if prev_t is None:
+                continue
+            l_out = prev_t + attn_t + mlp_t
+        tensors[out_key] = l_out
+        reconstructed.append(i)
+    return reconstructed
+
+
+def _load_safetensors_prompt(
+    st_path: Path,
+    meta_path: Path | None,
+    variant: str | None = None,
+    row_slice: slice | None = None,
+    prompt_id_override: str | None = None,
+) -> PromptDump:
+    with safe_open(str(st_path), framework="pt") as f:
+        st_meta = f.metadata() or {}
+        raw_keys = list(f.keys())
+        raw_tensors = {k: f.get_tensor(k) for k in raw_keys}
+
+    if st_meta.get("format") == "k31q_ref_acts" or any(k.endswith(".orig") or k.endswith(".q") for k in raw_keys):
+        chosen = variant or "q"
+        suffix = f".{chosen}"
+        tensors: dict[str, torch.Tensor] = {}
+        for k, t in raw_tensors.items():
+            if k == "embed":
+                tensors["embed"] = t
+            elif k.endswith(suffix):
+                base = k[: -len(suffix)]
+                m_out = re.match(r"^L(\d+)\.out$", base)
+                if m_out:
+                    tensors[f"L{m_out.group(1)}.mlp_out"] = t
+                else:
+                    tensors[base] = t
+        reconstruct_attnres_l_out(tensors)
+        toks = raw_tensors["token_ids"].long().tolist() if "token_ids" in raw_tensors else None
+        if row_slice is not None:
+            tensors = _slice_hidden_tensors(tensors, row_slice)
+            if toks is not None:
+                toks = toks[row_slice]
+        pid = prompt_id_override or f"{st_path.stem}_{chosen}"
+        return PromptDump(
+            prompt_id=pid,
+            source_format="ref_acts",
+            engine=f"ref_acts.{chosen}",
+            tensors=tensors,
+            prompt_token_ids=toks,
+            meta={"st_metadata": st_meta, "variant": chosen, "path": str(st_path)},
+        )
+
+    meta: dict[str, Any] = {}
+    if meta_path is not None and meta_path.is_file():
+        meta = json.loads(meta_path.read_text())
+
+    tensors = {}
+    topk_ids = None
+    topk_logits = None
+    logsumexp = None
+    prompt_token_ids = meta.get("prompt_token_ids")
+    generated_ids = meta.get("generated_ids")
+
+    for k, t in raw_tensors.items():
+        if k == "topk_ids":
+            topk_ids = t.cpu().numpy().astype(np.int32)
+        elif k == "topk_logits":
+            topk_logits = t.cpu().numpy().astype(np.float32)
+        elif k == "logsumexp":
+            logsumexp = t.cpu().numpy().astype(np.float32)
+        elif k == "prompt_token_ids":
+            if prompt_token_ids is None:
+                prompt_token_ids = t.long().tolist()
+        elif k == "generated_ids":
+            if generated_ids is None:
+                generated_ids = t.long().tolist()
+        elif k == "logit_positions":
+            continue
+        else:
+            tensors[k] = t
+
+    if row_slice is not None:
+        tensors = _slice_hidden_tensors(tensors, row_slice)
+        if prompt_token_ids is not None:
+            prompt_token_ids = prompt_token_ids[row_slice]
+
+    pid = prompt_id_override or meta.get("prompt_id") or st_meta.get("prompt_id") or st_path.stem
+    return PromptDump(
+        prompt_id=pid,
+        source_format=SCHEMA_VERSION,
+        engine=meta.get("engine") or st_meta.get("engine") or "unknown",
+        tensors=tensors,
+        prompt_token_ids=prompt_token_ids,
+        prompt_text=meta.get("prompt_text", ""),
+        generated_ids=generated_ids,
+        generated_text=meta.get("generated_text", ""),
+        topk_ids=topk_ids,
+        topk_logits=topk_logits,
+        logsumexp=logsumexp,
+        meta=meta,
+    )
+
+
+def _select_g3taps_record(
+    records: list[dict[str, Any]],
+    flags: list[dict[str, Any]],
+    record_idx: int | None,
+) -> dict[str, Any]:
+    if not records:
+        raise ValueError("g3taps file contains zero records")
+    if record_idx is not None:
+        return records[record_idx]
+    best_i = 0
+    best_score = (-1, -1)
+    for idx, rec in enumerate(records):
+        pos = rec.get("positions")
+        captured = bool(flags[idx].get("captured", False)) if idx < len(flags) else False
+        n_rows = int(pos.shape[0]) if torch.is_tensor(pos) and pos.ndim >= 1 else 0
+        starts_zero = bool(n_rows > 0 and int(pos[0].item()) == 0)
+        score = (int(not captured and starts_zero), n_rows)
+        if score > best_score:
+            best_score = score
+            best_i = idx
+    return records[best_i]
+
+
+def _load_g3taps_files(
+    pt_files: list[Path],
+    record_idx: int | None = None,
+    row_slice: slice | None = None,
+    prompt_id_override: str | None = None,
+) -> PromptDump:
+    """Load one or more g3taps `.pp<stage>tp<rank>.pt` files, merging PP stages on tp0."""
+    loaded_stages: dict[int, tuple[int, Path, dict[str, Any]]] = {}
+    for p in sorted(pt_files):
+        obj = torch.load(p, map_location="cpu", weights_only=False)
+        meta = obj.get("meta", {})
+        pp = int(meta.get("pp", 0))
+        tp = int(meta.get("tp", 0))
+        if pp not in loaded_stages or tp < loaded_stages[pp][0]:
+            loaded_stages[pp] = (tp, p, obj)
+
+    merged_tensors: dict[str, torch.Tensor] = {}
+    relay_in_by_start_layer: dict[int, torch.Tensor] = {}
+    stage_metas: list[dict[str, Any]] = []
+
+    for pp in sorted(loaded_stages.keys()):
+        _, p, obj = loaded_stages[pp]
+        meta = obj.get("meta", {})
+        stage_metas.append({"file": str(p), **meta})
+        rec = _select_g3taps_record(obj.get("records", []), obj.get("flags", []), record_idx)
+
+        layers_in_rec = sorted({
+            int(m.group(1))
+            for k in rec
+            if (m := re.match(r"^L(\d+)\.", k))
+        })
+        if layers_in_rec and "relay_in.hidden_states" in rec and torch.is_tensor(rec["relay_in.hidden_states"]):
+            relay_in_by_start_layer[layers_in_rec[0]] = rec["relay_in.hidden_states"]
+
+        for k, v in rec.items():
+            if not torch.is_tensor(v):
+                continue
+            if k in ("positions",) or k.startswith("relay_in.") or k.startswith("relay."):
+                continue
+            m_out = re.match(r"^L(\d+)\.out$", k)
+            if m_out:
+                merged_tensors[f"L{m_out.group(1)}.mlp_out"] = v
+            elif k == "final":
+                merged_tensors["final_pre_norm"] = v
+            else:
+                merged_tensors[k] = v
+
+    reconstructed = reconstruct_attnres_l_out(merged_tensors, relay_in_by_start_layer=relay_in_by_start_layer)
+    if row_slice is not None:
+        merged_tensors = _slice_hidden_tensors(merged_tensors, row_slice)
+
+    pid = prompt_id_override or pt_files[0].stem.split(".")[0]
+    return PromptDump(
+        prompt_id=pid,
+        source_format="g3taps",
+        engine="vllm-g3taps",
+        tensors=merged_tensors,
+        meta={"stages": stage_metas, "reconstructed_l_out_layers": reconstructed},
+    )
+
+
+def load_dump_source(
+    path_spec: str,
+    variant: str | None = None,
+    row_slice: slice | None = None,
+    g3_record_idx: int | None = None,
+) -> dict[str, PromptDump]:
+    """Auto-detect and load a dump directory, single safetensors, ref_acts, or g3taps .pt file(s)."""
+    if "," in path_spec:
+        files = [Path(s.strip()) for s in path_spec.split(",") if s.strip()]
+        pd = _load_g3taps_files(files, record_idx=g3_record_idx, row_slice=row_slice)
+        return {pd.prompt_id: pd}
+
+    p = Path(path_spec)
+    if not p.exists():
+        raise FileNotFoundError(f"Dump path not found: {p}")
+
+    if p.is_file():
+        if p.suffix == ".safetensors":
+            meta_p = p.with_suffix(".meta.json")
+            pd = _load_safetensors_prompt(p, meta_p if meta_p.is_file() else None, variant=variant, row_slice=row_slice)
+            return {pd.prompt_id: pd}
+        if p.suffix == ".pt":
+            pd = _load_g3taps_files([p], record_idx=g3_record_idx, row_slice=row_slice)
+            return {pd.prompt_id: pd}
+        raise ValueError(f"Unsupported dump file extension: {p}")
+
+    manifest_p = p / "manifest.json"
+    if manifest_p.is_file():
+        manifest = json.loads(manifest_p.read_text())
+        if manifest.get("partial_eval_callback"):
+            raise ValueError(
+                f"{p} was generated by llama-eval-callback fallback (text logs only, no full tensors). "
+                "Build and run llama-k31-dump for full tensor comparison."
+            )
+        out: dict[str, PromptDump] = {}
+        for pid in manifest.get("prompts", []):
+            st_p = p / f"{pid}.safetensors"
+            meta_p = p / f"{pid}.meta.json"
+            out[pid] = _load_safetensors_prompt(
+                st_p, meta_p if meta_p.is_file() else None, variant=variant, row_slice=row_slice, prompt_id_override=pid
+            )
+        return out
+
+    pt_files = sorted(p.glob("*.pt"))
+    if pt_files:
+        groups: dict[str, list[Path]] = {}
+        for f in pt_files:
+            tag = re.sub(r"\.pp\d+tp\d+$", "", f.stem)
+            groups.setdefault(tag, []).append(f)
+        out = {}
+        for tag, flist in sorted(groups.items()):
+            pd = _load_g3taps_files(flist, record_idx=g3_record_idx, row_slice=row_slice, prompt_id_override=tag)
+            out[tag] = pd
+        return out
+
+    st_files = sorted(p.glob("*.safetensors"))
+    if st_files:
+        out = {}
+        for st_p in st_files:
+            meta_p = st_p.with_suffix(".meta.json")
+            pd = _load_safetensors_prompt(st_p, meta_p if meta_p.is_file() else None, variant=variant, row_slice=row_slice)
+            out[pd.prompt_id] = pd
+        return out
+
+    raise ValueError(f"Directory {p} contains no manifest.json, .safetensors, or .pt dump files")
+
+
+def compute_tensor_metrics(ref: torch.Tensor, cand: torch.Tensor) -> dict[str, Any]:
+    """Compute cosine similarity, norm ratio, rel_l2, outlier ratios, and NaN/Inf counts."""
+    r = ref.detach().cpu().float()
+    c = cand.detach().cpu().float()
+
+    r_nan = int(torch.isnan(r).sum().item())
+    r_inf = int(torch.isinf(r).sum().item())
+    c_nan = int(torch.isnan(c).sum().item())
+    c_inf = int(torch.isinf(c).sum().item())
+
+    if r.shape != c.shape:
+        return {
+            "shape_ref": list(r.shape),
+            "shape_cand": list(c.shape),
+            "shape_mismatch": True,
+            "ref_nan": r_nan,
+            "ref_inf": r_inf,
+            "cand_nan": c_nan,
+            "cand_inf": c_inf,
+        }
+
+    if (r_nan + r_inf + c_nan + c_inf) > 0:
+        return {
+            "shape_ref": list(r.shape),
+            "shape_cand": list(c.shape),
+            "shape_mismatch": False,
+            "ref_nan": r_nan,
+            "ref_inf": r_inf,
+            "cand_nan": c_nan,
+            "cand_inf": c_inf,
+            "cos_mean": float("nan"),
+            "cos_min": float("nan"),
+            "cos_global": float("nan"),
+            "norm_ratio": float("nan"),
+            "rel_l2": float("nan"),
+            "max_abs_ratio": float("nan"),
+        }
+
+    r2 = r.reshape(-1, r.shape[-1])
+    c2 = c.reshape(-1, c.shape[-1])
+
+    r_row_norms = torch.linalg.vector_norm(r2, dim=-1)
+    c_row_norms = torch.linalg.vector_norm(c2, dim=-1)
+    denom = (r_row_norms * c_row_norms).clamp_min(1e-12)
+    row_cos = (r2 * c2).sum(dim=-1) / denom
+
+    r_norm = float(torch.linalg.vector_norm(r2).item())
+    c_norm = float(torch.linalg.vector_norm(c2).item())
+    cos_global = float(((r2 * c2).sum().item()) / max(r_norm * c_norm, 1e-12))
+    norm_ratio = c_norm / max(r_norm, 1e-12)
+    rel_l2 = float(torch.linalg.vector_norm(c2 - r2).item()) / max(r_norm, 1e-12)
+
+    r_abs = r2.abs()
+    c_abs = c2.abs()
+    r_max = float(r_abs.max().item())
+    c_max = float(c_abs.max().item())
+    r_p99 = (
+        float(torch.quantile(r_abs.reshape(-1), 0.99).item())
+        if r_abs.numel() <= 4_000_000
+        else float(r_abs.max(dim=-1).values.median().item())
+    )
+    c_p99 = (
+        float(torch.quantile(c_abs.reshape(-1), 0.99).item())
+        if c_abs.numel() <= 4_000_000
+        else float(c_abs.max(dim=-1).values.median().item())
+    )
+
+    r_rms = r_norm / math.sqrt(max(r2.numel(), 1))
+    c_rms = c_norm / math.sqrt(max(c2.numel(), 1))
+
+    return {
+        "shape_ref": list(r.shape),
+        "shape_cand": list(c.shape),
+        "shape_mismatch": False,
+        "ref_nan": 0,
+        "ref_inf": 0,
+        "cand_nan": 0,
+        "cand_inf": 0,
+        "cos_mean": float(row_cos.mean().item()),
+        "cos_min": float(row_cos.min().item()),
+        "cos_global": cos_global,
+        "ref_norm": r_norm,
+        "cand_norm": c_norm,
+        "norm_ratio": norm_ratio,
+        "rel_l2": rel_l2,
+        "ref_max_abs": r_max,
+        "cand_max_abs": c_max,
+        "max_abs_ratio": c_max / max(r_max, 1e-12),
+        "p99_abs_ratio": c_p99 / max(r_p99, 1e-12),
+        "ref_outlier_factor": r_max / max(r_rms, 1e-12),
+        "cand_outlier_factor": c_max / max(c_rms, 1e-12),
+    }
+
+
+def _evaluate_band_min(val: float, pass_min: float, warn_min: float) -> str:
+    if not math.isfinite(val):
+        return "FAIL"
+    if val >= pass_min:
+        return "PASS"
+    if val >= warn_min:
+        return "WARN"
+    return "FAIL"
+
+
+def _evaluate_band_range(val: float, pass_min: float, pass_max: float, warn_min: float, warn_max: float) -> str:
+    if not math.isfinite(val):
+        return "FAIL"
+    if pass_min <= val <= pass_max:
+        return "PASS"
+    if warn_min <= val <= warn_max:
+        return "WARN"
+    return "FAIL"
+
+
+def _evaluate_band_max(val: float, pass_max: float, warn_max: float) -> str:
+    if not math.isfinite(val):
+        return "FAIL"
+    if val <= pass_max:
+        return "PASS"
+    if val <= warn_max:
+        return "WARN"
+    return "FAIL"
+
+
+def evaluate_layer_out(
+    layer_idx: int,
+    metrics: dict[str, Any],
+    prev_layer_idx: int | None,
+    prev_metrics: dict[str, Any] | None,
+    pp_boundaries: tuple[int, ...] = DEFAULT_PP_BOUNDARIES,
+) -> dict[str, Any]:
+    """Apply pre-fixed tolerances to a single layer's `L{i}.out` residual stream metrics."""
+    tags = layer_tags(layer_idx, pp_boundaries)
+    reasons: list[str] = []
+
+    if metrics.get("shape_mismatch"):
+        return {
+            "layer": layer_idx,
+            "tags": tags,
+            "status": "FAIL",
+            "reasons": [f"shape_mismatch: ref={metrics['shape_ref']} cand={metrics['shape_cand']}"],
+            "metrics": metrics,
+        }
+
+    total_nonfinite = metrics["ref_nan"] + metrics["ref_inf"] + metrics["cand_nan"] + metrics["cand_inf"]
+    if total_nonfinite > 0:
+        return {
+            "layer": layer_idx,
+            "tags": tags,
+            "status": "FAIL",
+            "reasons": [
+                f"nonfinite: ref_nan={metrics['ref_nan']} ref_inf={metrics['ref_inf']} "
+                f"cand_nan={metrics['cand_nan']} cand_inf={metrics['cand_inf']}"
+            ],
+            "metrics": metrics,
+        }
+
+    cos_band_key = "L0" if layer_idx == 0 else ("L1_15" if layer_idx <= 15 else "L16_92")
+    cos_tol = TOLERANCES_V1["layer_out_cosine"][cos_band_key]
+    st_cos = _evaluate_band_min(metrics["cos_mean"], cos_tol["pass_min"], cos_tol["warn_min"])
+    if st_cos != "PASS":
+        reasons.append(f"cos_mean={metrics['cos_mean']:.4f} < {cos_tol['pass_min']:.3f} ({st_cos})")
+
+    cos_min_pass = cos_tol.get("cos_min_pass_min", cos_tol["cos_min_floor"])
+    cos_min_warn = cos_tol.get("cos_min_warn_min", cos_tol["cos_min_floor"])
+    st_cos_min = _evaluate_band_min(metrics["cos_min"], cos_min_pass, cos_min_warn)
+    if st_cos_min != "PASS":
+        reasons.append(
+            f"cos_min={metrics['cos_min']:.4f} < {cos_min_pass:.3f} (floor={cos_tol['cos_min_floor']:.3f}, {st_cos_min})"
+        )
+
+    nr_band_key = "L0" if layer_idx == 0 else "L1_92"
+    nr_tol = TOLERANCES_V1["layer_out_norm_ratio"][nr_band_key]
+    st_nr = _evaluate_band_range(
+        metrics["norm_ratio"],
+        nr_tol["pass_min"],
+        nr_tol["pass_max"],
+        nr_tol["warn_min"],
+        nr_tol["warn_max"],
+    )
+    if st_nr != "PASS":
+        reasons.append(
+            f"norm_ratio={metrics['norm_ratio']:.4f} outside [{nr_tol['pass_min']:.2f},{nr_tol['pass_max']:.2f}] ({st_nr})"
+        )
+
+    out_tol = TOLERANCES_V1["outlier_max_abs_ratio"]
+    st_out = _evaluate_band_range(
+        metrics["max_abs_ratio"],
+        out_tol["warn_min"],
+        out_tol["warn_max"],
+        out_tol["fail_min"],
+        out_tol["fail_max"],
+    )
+    if st_out != "PASS":
+        reasons.append(f"max_abs_ratio={metrics['max_abs_ratio']:.3f} ({st_out})")
+
+    delta_cos: float | None = None
+    log_nr_jump: float | None = None
+    st_cliff = "PASS"
+    st_nr_jump = "PASS"
+    gap: int | None = None
+
+    if prev_layer_idx is not None and prev_metrics is not None and math.isfinite(prev_metrics.get("cos_mean", float("nan"))):
+        gap = layer_idx - prev_layer_idx
+        delta_cos = metrics["cos_mean"] - prev_metrics["cos_mean"]
+        cliff_tol = TOLERANCES_V1["single_layer_cliff"]
+        if gap == 1:
+            warn_thr = cliff_tol["adjacent_delta_cos_warn"]
+            fail_thr = cliff_tol["adjacent_delta_cos_fail"]
+        else:
+            slope = cliff_tol["sparse_gap_slope_per_layer"]
+            fail_thr = max(cliff_tol["sparse_gap_fail_cap"], cliff_tol["adjacent_delta_cos_fail"] + slope * (gap - 1))
+            warn_thr = max(cliff_tol["sparse_gap_fail_cap"] + 0.02, cliff_tol["adjacent_delta_cos_warn"] + slope * (gap - 1))
+
+        if delta_cos <= fail_thr:
+            st_cliff = "FAIL"
+            reasons.append(f"delta_cos={delta_cos:+.4f} <= {fail_thr:.3f} (gap={gap}, FAIL)")
+        elif delta_cos <= warn_thr:
+            st_cliff = "WARN"
+            reasons.append(f"delta_cos={delta_cos:+.4f} <= {warn_thr:.3f} (gap={gap}, WARN)")
+
+        prev_nr = prev_metrics.get("norm_ratio", 1.0)
+        if gap == 1 and prev_nr > 0 and metrics["norm_ratio"] > 0:
+            log_nr_jump = abs(math.log(metrics["norm_ratio"] / prev_nr))
+            if log_nr_jump >= cliff_tol["adjacent_log_norm_ratio_fail"]:
+                st_nr_jump = "FAIL"
+                reasons.append(f"log_nr_jump={log_nr_jump:.4f} >= {cliff_tol['adjacent_log_norm_ratio_fail']:.2f} (FAIL)")
+            elif log_nr_jump >= cliff_tol["adjacent_log_norm_ratio_warn"]:
+                st_nr_jump = "WARN"
+                reasons.append(f"log_nr_jump={log_nr_jump:.4f} >= {cliff_tol['adjacent_log_norm_ratio_warn']:.2f} (WARN)")
+
+    status = worst_status(st_cos, st_cos_min, st_nr, st_out, st_cliff, st_nr_jump)
+    return {
+        "layer": layer_idx,
+        "tags": tags,
+        "status": status,
+        "delta_cos": delta_cos,
+        "gap": gap,
+        "log_nr_jump": log_nr_jump,
+        "reasons": reasons,
+        "metrics": metrics,
+    }
+
+
+def evaluate_subtap(key: str, metrics: dict[str, Any]) -> dict[str, Any]:
+    """Apply pre-fixed tolerances to a sub-tap (`L{i}.attn_out`, `L{i}.mlp_out`, `final_norm`, etc.)."""
+    reasons: list[str] = []
+    if metrics.get("shape_mismatch"):
+        return {"key": key, "status": "FAIL", "reasons": ["shape_mismatch"], "metrics": metrics}
+    total_nonfinite = metrics["ref_nan"] + metrics["ref_inf"] + metrics["cand_nan"] + metrics["cand_inf"]
+    if total_nonfinite > 0:
+        return {"key": key, "status": "FAIL", "reasons": ["nonfinite"], "metrics": metrics}
+
+    if key == "final_norm":
+        cos_tol = TOLERANCES_V1["subtap_cosine"]["final_norm"]
+        nr_tol = TOLERANCES_V1["subtap_norm_ratio"]["final_norm"]
+    elif key == "embed":
+        cos_tol = TOLERANCES_V1["subtap_cosine"]["L0_any"]
+        nr_tol = TOLERANCES_V1["subtap_norm_ratio"]["L0_any"]
+    else:
+        m = re.match(r"^L(\d+)\.(.+)$", key)
+        if not m:
+            cos_tol = {"pass_min": 0.85, "warn_min": 0.75}
+            nr_tol = {"pass_min": 0.85, "pass_max": 1.18, "warn_min": 0.75, "warn_max": 1.33}
+        else:
+            li = int(m.group(1))
+            sub = m.group(2)
+            if li == 0:
+                cos_tol = TOLERANCES_V1["subtap_cosine"]["L0_any"]
+                nr_tol = TOLERANCES_V1["subtap_norm_ratio"]["L0_any"]
+            elif sub == "mlp_out":
+                cos_tol = TOLERANCES_V1["subtap_cosine"]["L1_15_mlp_out" if li <= 15 else "L16_92_mlp_out"]
+                nr_tol = TOLERANCES_V1["subtap_norm_ratio"]["L1_15_mlp_out" if li <= 15 else "L16_92_mlp_out"]
+            else:
+                cos_tol = TOLERANCES_V1["subtap_cosine"]["L1_15_attn" if li <= 15 else "L16_92_attn"]
+                nr_tol = TOLERANCES_V1["subtap_norm_ratio"]["L1_92_attn"]
+
+    st_cos = _evaluate_band_min(metrics["cos_mean"], cos_tol["pass_min"], cos_tol["warn_min"])
+    if st_cos != "PASS":
+        reasons.append(f"cos_mean={metrics['cos_mean']:.4f} < {cos_tol['pass_min']:.3f} ({st_cos})")
+
+    st_nr = _evaluate_band_range(
+        metrics["norm_ratio"],
+        nr_tol["pass_min"],
+        nr_tol["pass_max"],
+        nr_tol["warn_min"],
+        nr_tol["warn_max"],
+    )
+    if st_nr != "PASS":
+        reasons.append(f"norm_ratio={metrics['norm_ratio']:.4f} ({st_nr})")
+
+    return {"key": key, "status": worst_status(st_cos, st_nr), "reasons": reasons, "metrics": metrics}
+
+
+def compute_topk_kl_js(
+    ref_ids: np.ndarray,
+    ref_logits: np.ndarray,
+    ref_lse: float,
+    cand_ids: np.ndarray,
+    cand_logits: np.ndarray,
+    cand_lse: float,
+) -> tuple[float, float]:
+    """Compute forward KL(P_ref || P_cand) and symmetric JS(P_ref, P_cand) from top-K + exact full-vocab LSE."""
+    if not (math.isfinite(ref_lse) and math.isfinite(cand_lse)):
+        return float("nan"), float("nan")
+    if not (np.all(np.isfinite(ref_logits)) and np.all(np.isfinite(cand_logits))):
+        return float("nan"), float("nan")
+
+    eps = 1e-12
+    p_map: dict[int, float] = {}
+    q_map: dict[int, float] = {}
+
+    for tid, lgt in zip(ref_ids.tolist(), ref_logits.tolist()):
+        p_map[int(tid)] = math.exp(float(lgt) - float(ref_lse))
+    for tid, lgt in zip(cand_ids.tolist(), cand_logits.tolist()):
+        q_map[int(tid)] = math.exp(float(lgt) - float(cand_lse))
+
+    p_sum = sum(p_map.values())
+    q_sum = sum(q_map.values())
+    p_tail = max(0.0, 1.0 - p_sum)
+    q_tail = max(0.0, 1.0 - q_sum)
+
+    union_ids = sorted(set(p_map.keys()) | set(q_map.keys()))
+    n_miss_p = sum(1 for tid in union_ids if tid not in p_map)
+    n_miss_q = sum(1 for tid in union_ids if tid not in q_map)
+
+    p_min_top = min(p_map.values()) if p_map else eps
+    q_min_top = min(q_map.values()) if q_map else eps
+
+    p_fill = min(p_min_top, p_tail / max(n_miss_p, 1)) if n_miss_p > 0 else 0.0
+    q_fill = min(q_min_top, q_tail / max(n_miss_q, 1)) if n_miss_q > 0 else 0.0
+
+    p_vec = np.empty(len(union_ids) + 1, dtype=np.float64)
+    q_vec = np.empty(len(union_ids) + 1, dtype=np.float64)
+
+    for idx, tid in enumerate(union_ids):
+        p_vec[idx] = p_map.get(tid, p_fill)
+        q_vec[idx] = q_map.get(tid, q_fill)
+
+    p_vec[-1] = max(0.0, p_tail - p_fill * n_miss_p)
+    q_vec[-1] = max(0.0, q_tail - q_fill * n_miss_q)
+
+    p_vec = np.maximum(p_vec, eps)
+    q_vec = np.maximum(q_vec, eps)
+    p_vec /= p_vec.sum()
+    q_vec /= q_vec.sum()
+
+    kl = float(np.sum(p_vec * np.log(p_vec / q_vec)))
+    m_vec = 0.5 * (p_vec + q_vec)
+    js = float(0.5 * np.sum(p_vec * np.log(p_vec / m_vec)) + 0.5 * np.sum(q_vec * np.log(q_vec / m_vec)))
+    return max(0.0, kl), max(0.0, js)
+
+
+def compare_logits_and_tokens(ref: PromptDump, cand: PromptDump) -> dict[str, Any] | None:
+    """Compare top-K logits, LSE, KL/JS divergence, top-1/top-5/top-16 agreement, and greedy rollout."""
+    has_logits = (
+        ref.topk_ids is not None
+        and cand.topk_ids is not None
+        and ref.topk_logits is not None
+        and cand.topk_logits is not None
+        and ref.logsumexp is not None
+        and cand.logsumexp is not None
+    )
+    has_gen = ref.generated_ids is not None and cand.generated_ids is not None
+
+    if not has_logits and not has_gen:
+        return None
+
+    res: dict[str, Any] = {"status": "PASS", "reasons": []}
+
+    if has_logits:
+        assert ref.topk_ids is not None and cand.topk_ids is not None
+        assert ref.topk_logits is not None and cand.topk_logits is not None
+        assert ref.logsumexp is not None and cand.logsumexp is not None
+
+        n_pos = min(ref.topk_ids.shape[0], cand.topk_ids.shape[0])
+        if n_pos == 0:
+            res["status"] = "WARN"
+            res["reasons"].append("zero logit positions to compare")
+            return res
+
+        nan_inf = int(
+            np.isnan(ref.topk_logits[:n_pos]).sum()
+            + np.isinf(ref.topk_logits[:n_pos]).sum()
+            + np.isnan(cand.topk_logits[:n_pos]).sum()
+            + np.isinf(cand.topk_logits[:n_pos]).sum()
+            + np.isnan(ref.logsumexp[:n_pos]).sum()
+            + np.isinf(ref.logsumexp[:n_pos]).sum()
+            + np.isnan(cand.logsumexp[:n_pos]).sum()
+            + np.isinf(cand.logsumexp[:n_pos]).sum()
+        )
+        if nan_inf > 0:
+            res["status"] = "FAIL"
+            res["reasons"].append(f"nonfinite_logits_or_lse: count={nan_inf}")
+            res["n_positions"] = n_pos
+            return res
+
+        top1_hits = 0
+        top5_hits = 0
+        top16_jaccards: list[float] = []
+        kls: list[float] = []
+        jss: list[float] = []
+
+        for pos in range(n_pos):
+            r_ids = ref.topk_ids[pos]
+            c_ids = cand.topk_ids[pos]
+            if int(c_ids[0]) == int(r_ids[0]):
+                top1_hits += 1
+            if int(c_ids[0]) in set(r_ids[:5].tolist()):
+                top5_hits += 1
+            s_r16 = set(r_ids[:16].tolist())
+            s_c16 = set(c_ids[:16].tolist())
+            union16 = len(s_r16 | s_c16)
+            top16_jaccards.append(len(s_r16 & s_c16) / max(union16, 1))
+            kl, js = compute_topk_kl_js(
+                r_ids, ref.topk_logits[pos], float(ref.logsumexp[pos]),
+                c_ids, cand.topk_logits[pos], float(cand.logsumexp[pos]),
+            )
+            kls.append(kl)
+            jss.append(js)
+
+        top1_rate = top1_hits / n_pos
+        top5_rate = top5_hits / n_pos
+        top16_jacc = float(np.mean(top16_jaccards))
+        kl_mean = float(np.mean(kls))
+        js_mean = float(np.mean(jss))
+
+        lt = TOLERANCES_V1["logits_and_tokens"]
+        st_top1 = _evaluate_band_min(top1_rate, lt["top1_agreement"]["pass_min"], lt["top1_agreement"]["warn_min"])
+        st_top5 = _evaluate_band_min(top5_rate, lt["top5_containment"]["pass_min"], lt["top5_containment"]["warn_min"])
+        st_j16 = _evaluate_band_min(top16_jacc, lt["top16_jaccard"]["pass_min"], lt["top16_jaccard"]["warn_min"])
+        st_kl = _evaluate_band_max(kl_mean, lt["kl_nats"]["pass_max"], lt["kl_nats"]["warn_max"])
+        st_js = _evaluate_band_max(js_mean, lt["js_nats"]["pass_max"], lt["js_nats"]["warn_max"])
+
+        for label, st, val in [
+            ("top1_agreement", st_top1, top1_rate),
+            ("top5_containment", st_top5, top5_rate),
+            ("top16_jaccard", st_j16, top16_jacc),
+            ("kl_nats", st_kl, kl_mean),
+            ("js_nats", st_js, js_mean),
+        ]:
+            if st != "PASS":
+                res["reasons"].append(f"{label}={val:.4f} ({st})")
+
+        res.update({
+            "status": worst_status(st_top1, st_top5, st_j16, st_kl, st_js),
+            "n_positions": n_pos,
+            "top1_agreement": top1_rate,
+            "top5_containment": top5_rate,
+            "top16_jaccard": top16_jacc,
+            "kl_mean_nats": kl_mean,
+            "kl_max_nats": float(np.max(kls)),
+            "js_mean_nats": js_mean,
+            "js_max_nats": float(np.max(jss)),
+            "prefill_last_top1_ref": int(ref.topk_ids[0, 0]),
+            "prefill_last_top1_cand": int(cand.topk_ids[0, 0]),
+            "prefill_last_kl_nats": kls[0],
+        })
+
+    if has_gen:
+        assert ref.generated_ids is not None and cand.generated_ids is not None
+        prefix_match = 0
+        for a, b in zip(ref.generated_ids, cand.generated_ids):
+            if a == b:
+                prefix_match += 1
+            else:
+                break
+        res["greedy_prefix_match_len"] = prefix_match
+        res["ref_generated_len"] = len(ref.generated_ids)
+        res["cand_generated_len"] = len(cand.generated_ids)
+        res["ref_generated_text"] = ref.generated_text
+        res["cand_generated_text"] = cand.generated_text
+        if ref.generated_text or cand.generated_text:
+            diff_lines = list(
+                difflib.unified_diff(
+                    ref.generated_text.splitlines(keepends=False),
+                    cand.generated_text.splitlines(keepends=False),
+                    fromfile="ref_klx",
+                    tofile="cand_vllm",
+                    lineterm="",
+                )
+            )
+            res["text_diff"] = diff_lines[:40]
+
+    return res
+
+
+def compare_prompt_dumps(
+    ref: PromptDump,
+    cand: PromptDump,
+    pp_boundaries: tuple[int, ...] = DEFAULT_PP_BOUNDARIES,
+    allow_token_mismatch: bool = False,
+    check_subtaps: bool = True,
+    allow_partial_layers: bool = False,
+    allow_missing_token_ids: bool = False,
+) -> dict[str, Any]:
+    """Run full layer-by-layer + sub-tap + logit + boundary comparison for one prompt."""
+    hard_errors: list[str] = []
+
+    if ref.prompt_token_ids is None or cand.prompt_token_ids is None:
+        if not allow_missing_token_ids:
+            missing_sides = []
+            if ref.prompt_token_ids is None:
+                missing_sides.append("ref")
+            if cand.prompt_token_ids is None:
+                missing_sides.append("cand")
+            hard_errors.append(
+                f"missing prompt_token_ids on {' and '.join(missing_sides)}; "
+                "pass --allow-missing-token-ids to override"
+            )
+    elif not allow_token_mismatch and ref.prompt_token_ids != cand.prompt_token_ids:
+        hard_errors.append(
+            f"prompt_token_ids mismatch: ref_len={len(ref.prompt_token_ids)} vs cand_len={len(cand.prompt_token_ids)}"
+        )
+
+    ref_layers = {
+        int(m.group(1))
+        for k in ref.tensors
+        if (m := re.match(r"^L(\d+)\.out$", k))
+    }
+    cand_layers = {
+        int(m.group(1))
+        for k in cand.tensors
+        if (m := re.match(r"^L(\d+)\.out$", k))
+    }
+    common_layers = sorted(ref_layers & cand_layers)
+    missing_layers = sorted(ref_layers - cand_layers)
+    extra_layers = sorted(cand_layers - ref_layers)
+    if not allow_partial_layers and ref_layers != cand_layers:
+        if missing_layers:
+            preview = missing_layers[:10]
+            more = f" (+{len(missing_layers) - 10} more)" if len(missing_layers) > 10 else ""
+            hard_errors.append(
+                f"incomplete layer coverage: candidate missing {len(missing_layers)}/{len(ref_layers)} "
+                f"reference layers ({preview}{more}); pass --allow-partial-layers to override"
+            )
+        if extra_layers:
+            preview = extra_layers[:10]
+            more = f" (+{len(extra_layers) - 10} more)" if len(extra_layers) > 10 else ""
+            hard_errors.append(
+                f"layer coverage mismatch: candidate has {len(extra_layers)} extra layers not in reference "
+                f"({preview}{more}); pass --allow-partial-layers to override"
+            )
+
+    layer_results: list[dict[str, Any]] = []
+    prev_idx: int | None = None
+    prev_metrics: dict[str, Any] | None = None
+
+    for li in common_layers:
+        key = f"L{li}.out"
+        m = compute_tensor_metrics(ref.tensors[key], cand.tensors[key])
+        ev = evaluate_layer_out(li, m, prev_idx, prev_metrics, pp_boundaries=pp_boundaries)
+        layer_results.append(ev)
+        prev_idx = li
+        prev_metrics = m
+
+    subtap_results: list[dict[str, Any]] = []
+    if check_subtaps:
+        common_subtaps = sorted(
+            (set(ref.tensors.keys()) & set(cand.tensors.keys()))
+            - {f"L{li}.out" for li in common_layers}
+        )
+        for key in common_subtaps:
+            if not (
+                key in ("embed", "final_norm", "final_pre_norm")
+                or re.match(r"^L\d+\.(attn_in|attn_out|mlp_in|mlp_out|prefix_sum_attn)$", key)
+            ):
+                continue
+            m = compute_tensor_metrics(ref.tensors[key], cand.tensors[key])
+            subtap_results.append(evaluate_subtap(key, m))
+
+    logits_result = compare_logits_and_tokens(ref, cand)
+
+    if not common_layers and not subtap_results and logits_result is None:
+        hard_errors.append("no overlapping layers, subtaps, or logits found between reference and candidate")
+
+    first_fail_layer = next((r for r in layer_results if r["status"] == "FAIL"), None)
+    first_warn_layer = next((r for r in layer_results if r["status"] == "WARN"), None)
+
+    boundary_summary: dict[str, Any] = {
+        "pp_boundaries": list(pp_boundaries),
+        "first_fail_layer": None,
+        "first_warn_layer": None,
+        "flagged_boundaries": [],
+    }
+    if first_fail_layer is not None:
+        reason_str = "; ".join(first_fail_layer["reasons"])
+        boundary_summary["first_fail_layer"] = {
+            "layer": first_fail_layer["layer"],
+            "tags": first_fail_layer["tags"],
+            "reasons": first_fail_layer["reasons"],
+            "suspect_hint": suspect_hint_for_tags(first_fail_layer["tags"], reason_str),
+        }
+    if first_warn_layer is not None:
+        reason_str = "; ".join(first_warn_layer["reasons"])
+        boundary_summary["first_warn_layer"] = {
+            "layer": first_warn_layer["layer"],
+            "tags": first_warn_layer["tags"],
+            "reasons": first_warn_layer["reasons"],
+            "suspect_hint": suspect_hint_for_tags(first_warn_layer["tags"], reason_str),
+        }
+    for r in layer_results:
+        if r["status"] != "PASS" and any(
+            t in r["tags"] for t in ("MLA/DSA", "ATTNRES_BLK", "ABL", "PP_STAGE")
+        ):
+            boundary_summary["flagged_boundaries"].append({
+                "layer": r["layer"],
+                "status": r["status"],
+                "tags": r["tags"],
+                "reasons": r["reasons"],
+            })
+
+    all_statuses: list[str] = []
+    if hard_errors:
+        all_statuses.append("FAIL")
+    all_statuses.extend(r["status"] for r in layer_results)
+    all_statuses.extend(r["status"] for r in subtap_results)
+    if logits_result is not None:
+        all_statuses.append(logits_result["status"])
+
+    overall = worst_status(*all_statuses) if all_statuses else "FAIL"
+
+    return {
+        "prompt_id": ref.prompt_id,
+        "ref_engine": ref.engine,
+        "cand_engine": cand.engine,
+        "ref_format": ref.source_format,
+        "cand_format": cand.source_format,
+        "status": overall,
+        "hard_errors": hard_errors,
+        "compared_layers": common_layers,
+        "layer_results": layer_results,
+        "subtap_results": subtap_results,
+        "logits_result": logits_result,
+        "boundary_summary": boundary_summary,
+    }
+
+
+def render_markdown_report(report: dict[str, Any]) -> str:
+    """Format a crisp Markdown/terminal comparison report."""
+    lines: list[str] = []
+    lines.append(f"# Kimi-K3.1 Numerics Comparison Report: **{report['overall_status']}**")
+    lines.append("")
+    lines.append(f"- Reference: `{report['ref_path']}`")
+    lines.append(f"- Candidate: `{report['cand_path']}`")
+    lines.append(f"- Tolerance Table: `{report['tolerances']['version']}` ({report['tolerances']['calibration_basis']})")
+    lines.append("")
+
+    for pr in report["prompts"]:
+        lines.append(f"## Prompt `{pr['prompt_id']}`: **{pr['status']}**")
+        lines.append(f"- Engines: ref=`{pr['ref_engine']}` ({pr['ref_format']}) vs cand=`{pr['cand_engine']}` ({pr['cand_format']})")
+        if pr["hard_errors"]:
+            for err in pr["hard_errors"]:
+                lines.append(f"- HARD ERROR: {err}")
+
+        bs = pr["boundary_summary"]
+        if bs["first_fail_layer"]:
+            ff = bs["first_fail_layer"]
+            lines.append(
+                f"- **FIRST FAILURE at L{ff['layer']}** `[{', '.join(ff['tags'])}]`: "
+                f"{'; '.join(ff['reasons'])} -> suspect: {ff['suspect_hint']}"
+            )
+        elif bs["first_warn_layer"]:
+            fw = bs["first_warn_layer"]
+            lines.append(
+                f"- First warning at L{fw['layer']} `[{', '.join(fw['tags'])}]`: "
+                f"{'; '.join(fw['reasons'])} -> hint: {fw['suspect_hint']}"
+            )
+        lines.append("")
+
+        if pr["layer_results"]:
+            lines.append("| Layer | Tags | Cos (mean) | Cos (min) | dCos | NormRatio | RelL2 | MaxAbsRatio | Status |")
+            lines.append("|---:|---|---:|---:|---:|---:|---:|---:|---|")
+            for r in pr["layer_results"]:
+                m = r["metrics"]
+                dcos_s = f"{r['delta_cos']:+.4f}" if r.get("delta_cos") is not None else "-"
+                cos_m = f"{m['cos_mean']:.4f}" if "cos_mean" in m and math.isfinite(m["cos_mean"]) else "NaN"
+                cos_min = f"{m['cos_min']:.4f}" if "cos_min" in m and math.isfinite(m["cos_min"]) else "NaN"
+                nr = f"{m['norm_ratio']:.4f}" if "norm_ratio" in m and math.isfinite(m["norm_ratio"]) else "NaN"
+                rl2 = f"{m['rel_l2']:.4f}" if "rel_l2" in m and math.isfinite(m["rel_l2"]) else "NaN"
+                mar = f"{m['max_abs_ratio']:.3f}" if "max_abs_ratio" in m and math.isfinite(m["max_abs_ratio"]) else "NaN"
+                lines.append(
+                    f"| L{r['layer']} | {','.join(r['tags'])} | {cos_m} | {cos_min} | {dcos_s} | {nr} | {rl2} | {mar} | {r['status']} |"
+                )
+            lines.append("")
+
+        if pr["subtap_results"]:
+            show_subs = [
+                s for s in pr["subtap_results"]
+                if s["status"] != "PASS" or s["key"] in ("embed", "final_norm") or len(pr["subtap_results"]) <= 12
+            ]
+            if show_subs:
+                lines.append("### Sub-Taps")
+                lines.append("| Key | Cos (mean) | NormRatio | RelL2 | Status |")
+                lines.append("|---|---:|---:|---:|---|")
+                for s in show_subs:
+                    m = s["metrics"]
+                    cos_m = f"{m['cos_mean']:.4f}" if "cos_mean" in m and math.isfinite(m["cos_mean"]) else "NaN"
+                    nr = f"{m['norm_ratio']:.4f}" if "norm_ratio" in m and math.isfinite(m["norm_ratio"]) else "NaN"
+                    rl2 = f"{m['rel_l2']:.4f}" if "rel_l2" in m and math.isfinite(m["rel_l2"]) else "NaN"
+                    lines.append(f"| `{s['key']}` | {cos_m} | {nr} | {rl2} | {s['status']} |")
+                lines.append("")
+
+        lr = pr["logits_result"]
+        if lr is not None:
+            lines.append("### Logits and Greedy Rollout")
+            lines.append(f"- Status: **{lr['status']}**" + (f" ({'; '.join(lr['reasons'])})" if lr["reasons"] else ""))
+            if "top1_agreement" in lr:
+                lines.append(
+                    f"- Positions: {lr['n_positions']} | Top-1: {lr['top1_agreement']:.3f} | "
+                    f"Top-5 containment: {lr['top5_containment']:.3f} | Top-16 Jaccard: {lr['top16_jaccard']:.3f} | "
+                    f"KL: {lr['kl_mean_nats']:.4f} nats (max {lr['kl_max_nats']:.4f}) | "
+                    f"JS: {lr['js_mean_nats']:.4f} nats"
+                )
+            if "greedy_prefix_match_len" in lr:
+                lines.append(
+                    f"- Greedy prefix match: {lr['greedy_prefix_match_len']} / "
+                    f"{min(lr['ref_generated_len'], lr['cand_generated_len'])} tokens"
+                )
+            if lr.get("text_diff"):
+                lines.append("```diff")
+                lines.extend(lr["text_diff"])
+                lines.append("```")
+            lines.append("")
+
+    return "\n".join(lines) + "\n"
+
+
+def compare_dumps(
+    ref_path: str,
+    cand_path: str,
+    pp_boundaries: tuple[int, ...] = DEFAULT_PP_BOUNDARIES,
+    ref_variant: str | None = None,
+    cand_variant: str | None = None,
+    row_slice: str | None = None,
+    ref_row_slice: str | None = None,
+    cand_row_slice: str | None = None,
+    g3_record_idx: int | None = None,
+    allow_token_mismatch: bool = False,
+    check_subtaps: bool = True,
+    allow_partial_layers: bool = False,
+    allow_missing_token_ids: bool = False,
+) -> dict[str, Any]:
+    sl_ref = _parse_row_slice(ref_row_slice or row_slice)
+    sl_cand = _parse_row_slice(cand_row_slice or row_slice)
+
+    ref_map = load_dump_source(ref_path, variant=ref_variant, row_slice=sl_ref, g3_record_idx=g3_record_idx)
+    cand_map = load_dump_source(cand_path, variant=cand_variant, row_slice=sl_cand, g3_record_idx=g3_record_idx)
+
+    pairs: list[tuple[PromptDump, PromptDump]] = []
+    common_ids = sorted(set(ref_map.keys()) & set(cand_map.keys()))
+    if common_ids:
+        for pid in common_ids:
+            pairs.append((ref_map[pid], cand_map[pid]))
+    elif len(ref_map) == 1 and len(cand_map) == 1:
+        r_only = next(iter(ref_map.values()))
+        c_only = next(iter(cand_map.values()))
+        pairs.append((r_only, c_only))
+    else:
+        raise ValueError(
+            f"No matching prompt IDs between ref ({sorted(ref_map.keys())}) and cand ({sorted(cand_map.keys())})"
+        )
+
+    prompt_reports = [
+        compare_prompt_dumps(
+            r,
+            c,
+            pp_boundaries=pp_boundaries,
+            allow_token_mismatch=allow_token_mismatch,
+            check_subtaps=check_subtaps,
+            allow_partial_layers=allow_partial_layers,
+            allow_missing_token_ids=allow_missing_token_ids,
+        )
+        for r, c in pairs
+    ]
+
+    overall = worst_status(*(pr["status"] for pr in prompt_reports))
+    return {
+        "schema": "k31_numerics_comparison_v1",
+        "overall_status": overall,
+        "exit_code": EXIT_CODE_BY_STATUS[overall],
+        "ref_path": ref_path,
+        "cand_path": cand_path,
+        "tolerances": TOLERANCES_V1,
+        "prompts": prompt_reports,
+    }
+
+
+def build_arg_parser() -> argparse.ArgumentParser:
+    p = argparse.ArgumentParser(
+        description="Compare Kimi-K3.1 per-layer hidden states and logits against KLX llama.cpp with pre-fixed tolerances."
+    )
+    p.add_argument("--ref", required=True, help="Reference dump (KLX llama.cpp dir/file, ref_acts, or g3taps .pt).")
+    p.add_argument("--cand", required=True, help="Candidate dump (vLLM k31q dir/file, g3taps .pt(s), or ref_acts).")
+    p.add_argument("--pp-boundaries", default="27,50,73", help="Comma-separated PP stage start layers (default: 27,50,73).")
+    p.add_argument("--ref-variant", choices=["orig", "q"], default=None, help="Variant for ref_acts.safetensors reference.")
+    p.add_argument("--cand-variant", choices=["orig", "q"], default=None, help="Variant for ref_acts.safetensors candidate.")
+    p.add_argument("--row-slice", default=None, help="Optional token row slice applied to both (e.g. 0:64 or 256:320).")
+    p.add_argument("--ref-row-slice", default=None, help="Optional token row slice applied to reference only.")
+    p.add_argument("--cand-row-slice", default=None, help="Optional token row slice applied to candidate only.")
+    p.add_argument("--g3-record-idx", type=int, default=None, help="Explicit record index inside g3taps .pt files.")
+    p.add_argument("--allow-token-mismatch", action="store_true", help="Do not fail on prompt_token_ids mismatch.")
+    p.add_argument("--allow-partial-layers", action="store_true", help="Allow candidate to omit reference layers (default: require full ref_layers == cand_layers).")
+    p.add_argument("--allow-missing-token-ids", action="store_true", help="Allow missing prompt_token_ids on ref or cand (default: FAIL when absent).")
+    p.add_argument("--no-subtaps", action="store_true", help="Skip sub-tap evaluation (compare L{i}.out + logits only).")
+    p.add_argument("--json-out", type=Path, default=None, help="Write machine-readable comparison_report.json.")
+    p.add_argument("--md-out", type=Path, default=None, help="Write Markdown report to file.")
+    p.add_argument("--quiet", action="store_true", help="Suppress Markdown report on stdout.")
+    return p
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = build_arg_parser().parse_args(argv)
+    pp_bounds = tuple(int(x.strip()) for x in args.pp_boundaries.split(",") if x.strip())
+
+    report = compare_dumps(
+        ref_path=args.ref,
+        cand_path=args.cand,
+        pp_boundaries=pp_bounds,
+        ref_variant=args.ref_variant,
+        cand_variant=args.cand_variant,
+        row_slice=args.row_slice,
+        ref_row_slice=args.ref_row_slice,
+        cand_row_slice=args.cand_row_slice,
+        g3_record_idx=args.g3_record_idx,
+        allow_token_mismatch=args.allow_token_mismatch,
+        check_subtaps=not args.no_subtaps,
+        allow_partial_layers=args.allow_partial_layers,
+        allow_missing_token_ids=args.allow_missing_token_ids,
+    )
+
+    md = render_markdown_report(report)
+    if not args.quiet:
+        print(md)
+    if args.md_out is not None:
+        args.md_out.parent.mkdir(parents=True, exist_ok=True)
+        args.md_out.write_text(md)
+    if args.json_out is not None:
+        args.json_out.parent.mkdir(parents=True, exist_ok=True)
+        args.json_out.write_text(json.dumps(report, indent=2) + "\n")
+
+    return int(report["exit_code"])
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
