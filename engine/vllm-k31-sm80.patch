index 0000000000..2c988fb522
--- /dev/null
+++ b/vllm/sm80/kernels/k31q/dense.py
@@ -0,0 +1,603 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""K3.1 dense EXL3 projections through the K3.1 dense library.
+
+The dense EXL3 matrices of a k31q checkpoint (KDA q, k, v, g and o_proj, the
+MLA projections, the shared experts, the latent down- and up-projections, the
+layer 0 MLP and the LM head) launch through ``linear_out_k31_multi`` of
+``vllm/_k31_dense_C`` (csrc/k31_dense, vllm/sm80/kernels/k31q/dense_k31_ops.py)
+instead of the EXL3 extension's scalar ``exl3_linear``, which launches one
+input transform, one GEMM and one output transform per matrix.
+
+One launch takes the members of one module that share the module's input: the
+KDA in-projection's q, k, v and g (its plain f_a and b stay a torch linear),
+the shared experts' and the layer 0 MLP's gate and up, the MLA q_a and kv_a,
+and every single matrix. The library writes the members' outputs side by side
+in member order, which is the layout the module's forward splits.
+
+Rows: up to :data:`DECODE_MAX_ROWS` the library takes its decode path (two
+kernels per launch), above it the prefill path (per member: the input
+transform rounded to BF16, the trellis dequantized to BF16 into the
+workspace, a cuBLAS BF16 GEMM, the output transform). By default
+(VLLM_K31Q_DENSE_PREFILL=exl3) only calls of up to DECODE_MAX_ROWS rows
+take the library and larger calls keep the EXL3 path: on the mini
+checkpoint the prefill path's BF16 roundings put the layer 1 shared-expert
+output 0.0103 to 0.0108 from the reference (the lane's chain tolerance is
+0.010; the EXL3 path gives 0.009). With VLLM_K31Q_DENSE_PREFILL=k31 every
+call takes the library; its prefill workspace grows with the rows, so a call
+of more than ``launch_rows`` rows (the scheduler's batch, at most
+:data:`LAUNCH_ROWS`) runs as consecutive launches of at most that many rows;
+every row is computed from its own input.
+
+Workspace: one persistent FP32 buffer per process and device for the compute
+stream and one for upstream's auxiliary stream (when present), taken once from
+the engine's workspace manager and sized for the largest launch any K3.1 dense
+module of the process registered at load. Starting in release 4 (api_version=4),
+each workspace holds its own 16 KB split-arrival counter table (zero device
+globals), making concurrent launches on compute and auxiliary streams 100%
+isolated. With VLLM_K31Q_DENSE_PREFILL=exl3 (default), launches are bounded at
+DECODE_MAX_ROWS (32) and linear_workspace_size_k31 returns decode-only sizing
+(~29 MiB/stream, 58 MiB total, reclaiming >406 MiB/rank vs release 2). Nothing
+is allocated for the workspace in the forward and nothing waits for the device.
+Not the manager's shared scratch: the MoE kernel keeps its live buffers there
+while it calls the shared experts.
+
+The switch VLLM_K31Q_DENSE_BACKEND, read when the weights are processed:
+``k31`` (default) takes the library for every module whose matrices it
+supports (codebook mul1, 5, 6 or 7 bits, 1 to 4 members) when the library is
+built, and the EXL3 path otherwise; a library that is present but refused (a
+release 1 build, another PyTorch) stops the load with the build command.
+``exl3`` keeps the EXL3 path everywhere. :func:`log_backends` writes which
+module runs where once the model is loaded.
+"""
+
+import importlib.util
+import re
+from collections import Counter
+from collections.abc import Sequence
+from dataclasses import dataclass
+
+import torch
+from torch import nn
+
+from vllm import envs
+from vllm.logger import init_logger
+from vllm.utils.torch_utils import direct_register_custom_op
+
+logger = init_logger(__name__)
+
+DENSE_BACKENDS = ("k31", "exl3")
+DENSE_PREFILL = ("exl3", "k31")
+LIBRARY = "_k31_dense_C"
+# csrc/k31_dense/dense_k31.cu: the decode path takes up to 32 rows of
+# members of one bitrate; launch_fused_all and the prefill dequantization
+# dispatch bits_x2 10, 12 and 14; kMaxMembers 4; the trellis decoder is the
+# mul1 codebook (EXL3 codebook id 2, vllm/sm80/kernels/exl3/utils.py).
+DECODE_MAX_ROWS = 32
+BITS_X2 = (10, 12, 14)
+MUL1_CODEBOOK = 2
+MAX_MEMBERS = 4
+OUT_DTYPES = (torch.bfloat16, torch.float32)
+# Most rows of one prefill launch (calls above run as several launches): the
+# workspace of a launch grows with its rows (an [rows, padded_in] BF16 copy
+# of the input and [rows, 8192] of the output beside one dequantized
+# [padded_in, 8192] chunk of the weights).
+LAUNCH_ROWS = 2048
+WORKSPACE_KEY = "k31_dense_workspace"
+
+
+def dense_backend() -> str:
+    """VLLM_K31Q_DENSE_BACKEND, checked."""
+    backend = envs.VLLM_K31Q_DENSE_BACKEND
+    if backend not in DENSE_BACKENDS:
+        raise ValueError(
+            f"VLLM_K31Q_DENSE_BACKEND must be one of {DENSE_BACKENDS}, not {backend!r}"
+        )
+    return backend
+
+
+def dense_prefill() -> str:
+    """VLLM_K31Q_DENSE_PREFILL, checked: which path a call of more than
+    DECODE_MAX_ROWS rows takes on a module of the k31 backend."""
+    prefill = envs.VLLM_K31Q_DENSE_PREFILL
+    if prefill not in DENSE_PREFILL:
+        raise ValueError(
+            f"VLLM_K31Q_DENSE_PREFILL must be one of {DENSE_PREFILL}, not {prefill!r}"
+        )
+    return prefill
+
+
+def library_built() -> bool:
+    """Whether ``vllm/_k31_dense_C`` exists (built or not, it is not loaded
+    here)."""
+    return importlib.util.find_spec(f"vllm.{LIBRARY}") is not None
+
+
+def load_dense_native():
+    """The dense ops module over the loaded and checked library; a library
+    that is present but refused raises with the command that builds it."""
+    from vllm.sm80.kernels.k31q import dense_k31_ops
+
+    dense_k31_ops.ensure_dense_k31_extension()
+    return dense_k31_ops
+
+
+def native_or_reason():
+    """(ops module, None) when the K3.1 dense backend serves this process,
+    else (None, why not)."""
+    if dense_backend() == "exl3":
+        return None, "VLLM_K31Q_DENSE_BACKEND=exl3"
+    if not library_built():
+        from vllm.sm80.kernels.k31q.dense_k31_ops import BUILD_COMMAND
+
+        return None, f"vllm/{LIBRARY} is not built (build: {BUILD_COMMAND})"
+    return load_dense_native(), None
+
+
+def unsupported_reason(weights, out_dtype: torch.dtype) -> str | None:
+    """Why the library cannot take these EXL3 members (Exl3PackedWeight) as
+    launches of the module, or None."""
+    if not weights:
+        return "no EXL3 member"
+    if out_dtype not in OUT_DTYPES:
+        return f"output dtype {out_dtype}"
+    padded_in = {weight.padded_in for weight in weights}
+    if len(padded_in) != 1:
+        return f"members of different input widths {sorted(padded_in)}"
+    for weight in weights:
+        matrix = weight.matrix
+        if matrix.codebook != MUL1_CODEBOOK:
+            return f"{matrix.prefix}: codebook {matrix.marker}, not mul1"
+        if matrix.bits_x2 not in BITS_X2:
+            return f"{matrix.prefix}: {matrix.bits_x2 / 2:g} bits (5, 6 or 7 only)"
+    return None
+
+
+def launch_groups(weights) -> list[list[int]]:
+    """Member indices per launch: consecutive members of one bitrate, at most
+    MAX_MEMBERS each (the decode path needs one bitrate per launch)."""
+    groups: list[list[int]] = []
+    for index, weight in enumerate(weights):
+        if (
+            groups
+            and len(groups[-1]) < MAX_MEMBERS
+            and weights[groups[-1][0]].matrix.bits_x2 == weight.matrix.bits_x2
+        ):
+            groups[-1].append(index)
+        else:
+            groups.append([index])
+    return groups
+
+
+def configured_launch_rows() -> int:
+    """Rows of one launch: the scheduler's batch of the model being built,
+    capped at LAUNCH_ROWS (LAUNCH_ROWS when no engine config is current)."""
+    from vllm.config import get_current_vllm_config_or_none
+
+    config = get_current_vllm_config_or_none()
+    rows = LAUNCH_ROWS
+    scheduler = getattr(config, "scheduler_config", None) if config else None
+    batched = getattr(scheduler, "max_num_batched_tokens", None)
+    if isinstance(batched, int) and batched > 0:
+        rows = min(rows, batched)
+    return rows
+
+
+# FP32 elements of the largest launch registered per device ("cuda:0").
+_WORKSPACE_NEEDS: dict[str, int] = {}
+
+
+def require_workspace(device: torch.device, elements: int) -> None:
+    key = str(device)
+    _WORKSPACE_NEEDS[key] = max(_WORKSPACE_NEEDS.get(key, 0), int(elements))
+
+
+def workspace_elements(device: torch.device) -> int:
+    return _WORKSPACE_NEEDS.get(str(device), 0)
+
+
+def _workspace(device: torch.device) -> torch.Tensor:
+    """The FP32 workspace of the current stream: the compute stream's or the
+    auxiliary stream's. Both are allocated on the first call (before graph
+    capture: the profile run) and never resized; a model loaded later that
+    needs more gets new buffers of its own size. Each workspace holds its own
+    per-stream arrival counter table (api_version=4) for concurrent safety."""
+    from vllm.utils.torch_utils import aux_stream, current_stream
+    from vllm.v1.worker.workspace import current_workspace_manager
+
+    elements = workspace_elements(device)
+    if elements <= 0:
+        raise RuntimeError(f"No K3.1 dense launch was registered on {device}")
+    cuda = device.type == "cuda"
+
+    def allocate():
+        if cuda and torch.cuda.is_current_stream_capturing():
+            raise RuntimeError(
+                "The K3.1 dense workspace must be allocated before graph capture"
+            )
+        count = 2 if cuda and aux_stream() is not None else 1
+        return [
+            torch.empty(elements, dtype=torch.float32, device=device)
+            for _ in range(count)
+        ]
+
+    buffers = current_workspace_manager().get_persistent_resource(
+        (WORKSPACE_KEY, str(device), elements), allocate
+    )
+    if len(buffers) > 1 and current_stream() == aux_stream():
+        return buffers[1]
+    return buffers[0]
+
+
+def _linear_impl(
+    x: torch.Tensor,
+    trellises: list[torch.Tensor],
+    suhs: list[torch.Tensor],
+    svhs: list[torch.Tensor],
+    bits_x2s: list[int],
+    logical_outs: list[int],
+    launch_rows: int,
+    out_dtype: torch.dtype = torch.bfloat16,
+) -> torch.Tensor:
+    """One module's launch group on ``x`` BF16 [rows, in] (contiguous):
+    [rows, sum(logical_outs)] in ``out_dtype``, the members side by side."""
+    ops = load_dense_native()
+    rows = x.shape[0]
+    out = torch.empty((rows, sum(logical_outs)), dtype=out_dtype, device=x.device)
+    if rows == 0:
+        return out
+    workspace = _workspace(x.device)
+    for start in range(0, rows, launch_rows):
+        stop = min(rows, start + launch_rows)
+        ops.linear_out_k31_multi(
+            x[start:stop],
+            trellises,
+            suhs,
+            svhs,
+            bits_x2s,
+            logical_outs,
+            out[start:stop],
+            workspace,
+        )
+    return out
+
+
+def _linear_fake(
+    x: torch.Tensor,
+    trellises: list[torch.Tensor],
+    suhs: list[torch.Tensor],
+    svhs: list[torch.Tensor],
+    bits_x2s: list[int],
+    logical_outs: list[int],
+    launch_rows: int,
+    out_dtype: torch.dtype = torch.bfloat16,
+) -> torch.Tensor:
+    torch._check(x.dtype == torch.bfloat16)
+    torch._check(x.dim() == 2)
+    torch._check(out_dtype in OUT_DTYPES)
+    return x.new_empty((x.shape[0], sum(logical_outs)), dtype=out_dtype)
+
+
+direct_register_custom_op(
+    op_name="k31_dense_linear",
+    op_func=_linear_impl,
+    mutates_args=[],
+    fake_impl=_linear_fake,
+)
+
+
+def _dense_linear(x, trellises, suhs, svhs, bits_x2s, logical_outs, launch_rows, dtype):
+    """One launch group through the registered operator (CPU tests replace
+    this with :func:`_linear_impl` and a stand-in for the library)."""
+    return torch.ops.vllm.k31_dense_linear(
+        x, trellises, suhs, svhs, bits_x2s, logical_outs, launch_rows, dtype
+    )
+
+
+def _plain_linear_impl(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None = None,
+) -> torch.Tensor:
+    ops = load_dense_native()
+    out = torch.empty((x.shape[0], weight.shape[0]), dtype=x.dtype, device=x.device)
+    if x.shape[0] == 0 or weight.shape[0] == 0:
+        return out
+    ops.linear_plain_invariant_k31(x, weight, bias, out)
+    return out
+
+
+def _plain_linear_fake(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None = None,
+) -> torch.Tensor:
+    torch._check(x.dtype == torch.bfloat16)
+    torch._check(weight.dtype == torch.bfloat16)
+    torch._check(x.dim() == 2 and weight.dim() == 2)
+    return x.new_empty((x.shape[0], weight.shape[0]), dtype=x.dtype)
+
+
+direct_register_custom_op(
+    op_name="k31_plain_linear",
+    op_func=_plain_linear_impl,
+    mutates_args=[],
+    fake_impl=_plain_linear_fake,
+)
+
+
+def _plain_linear(
+    x: torch.Tensor, weight: torch.Tensor, bias: torch.Tensor | None = None
+) -> torch.Tensor:
+    return torch.ops.vllm.k31_plain_linear(x, weight, bias)
+
+
+_DEFAULT_LOAD_DENSE_NATIVE = load_dense_native
+
+
+def plain_invariant_available() -> bool:
+    """Whether ``_k31_dense_C`` with api_version >= 3 is available for
+    bit-exact row-count-invariant BF16 plain linears."""
+    from vllm.sm80.kernels.k31q import dense_k31_ops
+
+    if (
+        load_dense_native is _DEFAULT_LOAD_DENSE_NATIVE
+        and dense_k31_ops._LOADED
+        and dense_k31_ops._MODULE is not None
+    ):
+        return int(dense_k31_ops._MODULE.build_info().get("api_version", 0)) >= 3
+    if not library_built():
+        return False
+    try:
+        ops = load_dense_native()
+    except RuntimeError:
+        return False
+    if not hasattr(ops, "linear_plain_invariant_k31"):
+        return False
+    info_fn = getattr(ops, "build_info", None)
+    if callable(info_fn):
+        return int(info_fn().get("api_version", 0)) >= 3
+    return True
+
+
+def linear_plain_invariant_k31(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Bit-exact row-count-invariant BF16 linear (0-ULP across M=1..2048).
+
+    Uses ``_k31_dense_C::linear_plain_invariant_k31`` (api_version >= 3) on
+    CUDA BF16 inputs; falls back cleanly to ``fp32_gemm_reduction`` +
+    ``torch.nn.functional.linear`` on CPU, non-BF16 dtypes, or older binaries.
+    """
+    shape = x.shape[:-1]
+    x2d = x.reshape(-1, x.shape[-1])
+    if (
+        x2d.is_cuda
+        and weight.is_cuda
+        and x2d.dtype == torch.bfloat16
+        and weight.dtype == torch.bfloat16
+    ):
+        if plain_invariant_available():
+            w2d = weight.contiguous()
+            b1d = bias.contiguous() if bias is not None else None
+            out = _plain_linear(x2d.contiguous(), w2d, b1d)
+            return out.reshape(*shape, out.shape[-1])
+        logger.warning_once(
+            "Kimi K3.1 row-invariant plain linear falling back to cuBLAS "
+            "(fp32_gemm_reduction + F.linear): vllm._k31_dense_C api_version >= 3 "
+            "is unavailable."
+        )
+    from vllm.sm80.kernels.k31q.quant import fp32_gemm_reduction
+
+    with fp32_gemm_reduction():
+        out = torch.nn.functional.linear(x2d, weight, bias)
+    return out.reshape(*shape, out.shape[-1])
+
+
+@dataclass
+class _Group:
+    trellises: list[torch.Tensor]
+    suhs: list[torch.Tensor]
+    svhs: list[torch.Tensor]
+    bits_x2s: list[int]
+    logical_outs: list[int]
+    padded_out: int
+    workspace: int
+
+
+class K31DenseLauncher:
+    """The K3.1 dense launches of one module's EXL3 members (a list of
+    Exl3PackedWeight sharing one input), in member order; needs no model.
+
+    Built after the weights are loaded: it holds the members' trellis, suh
+    and svh tensors, which must not move afterwards. Registers the workspace
+    its largest launch needs. ``max_rows``: the most rows of a call it takes
+    (:meth:`takes`; the module runs larger calls on the EXL3 path), None for
+    any."""
+
+    def __init__(self, ops, weights, launch_rows: int, max_rows: int | None = None):
+        if launch_rows < 1:
+            raise ValueError(f"K3.1 dense launch rows must be positive: {launch_rows}")
+        self.max_rows = max_rows
+        if max_rows is not None:
+            launch_rows = min(launch_rows, max_rows)
+        self.launch_rows = int(launch_rows)
+        self.members = [weight.matrix.prefix for weight in weights]
+        self.padded_in = weights[0].padded_in
+        self.device = weights[0].trellis.device
+        self.groups: list[_Group] = []
+        for indices in launch_groups(weights):
+            members = [weights[i] for i in indices]
+            padded_out = sum(w.padded_out for w in members)
+            elements = int(
+                ops.linear_workspace_size_k31(
+                    self.launch_rows, self.padded_in, padded_out, len(members)
+                )
+            )
+            self.groups.append(
+                _Group(
+                    trellises=[w.trellis for w in members],
+                    suhs=[w.suh for w in members],
+                    svhs=[w.svh for w in members],
+                    bits_x2s=[int(w.matrix.bits_x2) for w in members],
+                    logical_outs=[int(w.logical_out) for w in members],
+                    padded_out=padded_out,
+                    workspace=elements,
+                )
+            )
+            require_workspace(self.device, elements)
+        self.logical_out = sum(sum(g.logical_outs) for g in self.groups)
+
+    def takes(self, rows: int) -> bool:
+        """Whether a call of ``rows`` rows runs on the library."""
+        return self.max_rows is None or rows <= self.max_rows
+
+    def launches(self, rows: int) -> int:
+        """Library calls for a call of ``rows`` rows."""
+        if rows <= 0 or not self.takes(rows):
+            return 0
+        return len(self.groups) * -(-rows // self.launch_rows)
+
+    def __call__(self, x: torch.Tensor, out_dtype: torch.dtype) -> torch.Tensor:
+        outputs = [
+            _dense_linear(
+                x,
+                group.trellises,
+                group.suhs,
+                group.svhs,
+                group.bits_x2s,
+                group.logical_outs,
+                self.launch_rows,
+                out_dtype,
+            )
+            for group in self.groups
+        ]
+        return outputs[0] if len(outputs) == 1 else torch.cat(outputs, dim=-1)
+
+
+def select_launcher(weights, out_dtype: torch.dtype, launch_rows: int):
+    """(K31DenseLauncher, None) for members the library serves in this
+    process, (None, why not) for the EXL3 path."""
+    reason = unsupported_reason(weights, out_dtype)
+    if reason is not None:
+        return None, reason
+    ops, reason = native_or_reason()
+    if ops is None:
+        return None, reason
+    max_rows = DECODE_MAX_ROWS if dense_prefill() == "exl3" else None
+    return K31DenseLauncher(ops, weights, launch_rows, max_rows), None
+
+
+def build_combined_decode_launcher(
+    layers: Sequence[nn.Module],
+) -> K31DenseLauncher | None:
+    """Build one decode-only K31DenseLauncher over several K3.1 dense layers
+    that share one BF16 input (e.g. MLA fused_qkv_a_proj + g_proj).
+
+    Shares the layers' existing packed weight tensors with zero extra weight
+    memory and registers the combined decode workspace via require_workspace
+    immediately (before warmup and CUDA Graph capture). Returns None when any
+    layer is ineligible or the combined members need more than one launch
+    group."""
+    from vllm.model_executor.layers.linear import RowParallelLinear
+    from vllm.sm80.kernels.k31q.quant import K31DenseLinearMethod
+
+    if not layers:
+        return None
+    ops, _ = native_or_reason()
+    if ops is None:
+        return None
+    weights = []
+    for layer in layers:
+        method = getattr(layer, "quant_method", None)
+        if not isinstance(method, K31DenseLinearMethod):
+            return None
+        if method.launcher is None or method.out_dtype != torch.bfloat16:
+            return None
+        if method.head_columns is not None:
+            return None
+        if getattr(layer, "bias", None) is not None:
+            return None
+        if getattr(layer, "gather_output", False) or isinstance(
+            layer, RowParallelLinear
+        ):
+            return None
+        layer_weights = list(getattr(layer, "exl3_weights", ()))
+        if not layer_weights:
+            return None
+        weights.extend(layer_weights)
+    if unsupported_reason(weights, torch.bfloat16) is not None:
+        return None
+    if len(launch_groups(weights)) != 1:
+        return None
+    if len({w.trellis.device for w in weights}) != 1:
+        return None
+    return K31DenseLauncher(
+        ops, weights, launch_rows=DECODE_MAX_ROWS, max_rows=DECODE_MAX_ROWS
+    )
+
+
+def _pattern(name: str) -> str:
+    return re.sub(r"\.layers\.\d+\.", ".layers.*.", name)
+
+
+def backends(model: nn.Module) -> list[tuple[str, str, list[str], str | None]]:
+    """(module name, "k31" or "exl3", EXL3 members, why exl3) of every K3.1
+    dense module of ``model``."""
+    rows = []
+    for name, module in model.named_modules():
+        method = getattr(module, "quant_method", None)
+        state = getattr(method, "k31_dense_state", None)
+        if state is None:
+            continue
+        launcher, reason, members = state()
+        rows.append((name, "exl3" if launcher is None else "k31", members, reason))
+    return rows
+
+
+def log_backends(model: nn.Module) -> list[tuple[str, str, list[str], str | None]]:
+    """Log one line naming which K3.1 dense modules run on which backend
+    (module names with the layer index replaced by *), and return the rows."""
+    rows = backends(model)
+    if not rows:
+        return rows
+    tally = Counter()
+    for name, backend, members, reason in rows:
+        leaf = [m.rsplit(".", 1)[-1] for m in members]
+        what = _pattern(name) + (f" [{'+'.join(leaf)}]" if len(leaf) > 1 else "")
+        tally[backend, what, reason] += 1
+    k31 = [
+        f"{what} x{n}"
+        for (b, what, _), n in sorted(tally.items(), key=str)
+        if b == "k31"
+    ]
+    exl3 = [
+        f"{what} x{n} ({reason})"
+        for (b, what, reason), n in sorted(tally.items(), key=str)
+        if b == "exl3"
+    ]
+    devices = sorted(_WORKSPACE_NEEDS)
+    workspace = ", ".join(
+        f"{d} {_WORKSPACE_NEEDS[d] * 4 / 2**20:.1f} MiB per stream" for d in devices
+    )
+    rows_taken = (
+        f"calls of up to {DECODE_MAX_ROWS} rows (its decode path), larger calls "
+        "on exl3_linear (VLLM_K31Q_DENSE_PREFILL=exl3)"
+        if dense_prefill() == "exl3"
+        else f"all calls (decode path up to {DECODE_MAX_ROWS} rows, prefill path "
+        "above; VLLM_K31Q_DENSE_PREFILL=k31)"
+    )
+    logger.info(
+        "Kimi K3.1 dense EXL3 modules: %d on the k31 backend (%s.linear_out_k31_multi "
+        "for %s; workspace %s): %s. %d on the exl3 backend (exl3_linear): %s.",
+        sum(n for (b, _, _), n in tally.items() if b == "k31"),
+        LIBRARY,
+        rows_taken,
+        workspace or "none",
+        "; ".join(k31) or "none",
+        sum(n for (b, _, _), n in tally.items() if b == "exl3"),
+        "; ".join(exl3) or "none",
+    )
+    return rows
