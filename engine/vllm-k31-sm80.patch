+def test_kimi_k3_wrapper_propagates_outer_head_dtype_to_text_config(monkeypatch):
+    from vllm.models.kimi_k3.nvidia import model as upstream_model
+    from vllm.models.kimi_k3.nvidia import sm80_model
+
+    observed: list[object] = []
+
+    def fake_super_init(self, vllm_config, prefix=""):
+        nn.Module.__init__(self)
+        observed.append(
+            getattr(vllm_config.model_config.hf_config.text_config, "head_dtype", None)
+        )
+
+    monkeypatch.setattr(
+        upstream_model.KimiK3ForConditionalGeneration, "__init__", fake_super_init
+    )
+
+    # Case A: outer head_dtype="float32", text_config has no head_dtype -> propagated.
+    text_cfg = SimpleNamespace()
+    hf_cfg = SimpleNamespace(head_dtype="float32", text_config=text_cfg)
+    vllm_cfg = SimpleNamespace(model_config=SimpleNamespace(hf_config=hf_cfg))
+    sm80_model.KimiK3ForConditionalGeneration(vllm_config=vllm_cfg)
+    assert text_cfg.head_dtype == "float32"
+    assert observed[-1] == "float32"
+
+    # Case B: explicit text_config.head_dtype must NOT be clobbered.
+    text_cfg_explicit = SimpleNamespace(head_dtype="bfloat16")
+    hf_cfg_explicit = SimpleNamespace(
+        head_dtype="float32", text_config=text_cfg_explicit
+    )
+    vllm_cfg_explicit = SimpleNamespace(
+        model_config=SimpleNamespace(hf_config=hf_cfg_explicit)
+    )
+    sm80_model.KimiK3ForConditionalGeneration(vllm_config=vllm_cfg_explicit)
+    assert text_cfg_explicit.head_dtype == "bfloat16"
+    assert observed[-1] == "bfloat16"
+
+    # Case C: outer head_dtype unset -> text_config left untouched.
+    text_cfg_none = SimpleNamespace()
+    hf_cfg_none = SimpleNamespace(text_config=text_cfg_none)
+    vllm_cfg_none = SimpleNamespace(model_config=SimpleNamespace(hf_config=hf_cfg_none))
+    sm80_model.KimiK3ForConditionalGeneration(vllm_config=vllm_cfg_none)
+    assert getattr(text_cfg_none, "head_dtype", None) is None
+    assert observed[-1] is None
