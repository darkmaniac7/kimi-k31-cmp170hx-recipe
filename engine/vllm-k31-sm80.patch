+def test_mla_update_kv_cache_defers_or_runs_upstream(glue_on):
+    from vllm.model_executor.layers.attention import mla_attention as upstream
+
+    calls = []
+    glue_on.setattr(upstream.MLAAttention, "update_kv_cache",
+                    lambda self, *a: calls.append(("upstream", a)))
+    m = _fork_mla()
+    m.impl.do_kv_cache_update = lambda *a: calls.append(("write", a))
+    kv = torch.zeros(2, 64, 512, dtype=torch.bfloat16)
+    decode = types.SimpleNamespace(num_prefills=0)
+    args = ("kv_c", "k_pe", kv, "slots", decode, "auto", "k_scale")
+    hand_off = ("kv_c", "k_pe", kv, "slots", "auto", "k_scale")
+    m.update_kv_cache(*args)
+    assert calls == [] and m.impl._idx_glue_pending_kv == hand_off
+    # A second hand-off writes the outstanding one first.
+    m.update_kv_cache(*args)
+    assert calls == [("write", hand_off)] and m.impl._idx_glue_pending_kv == hand_off
+    calls.clear()
+    m.impl._idx_glue_pending_kv = None
+    # Not deferred: upstream's update, with the same arguments.
+    prefill = args[:4] + (types.SimpleNamespace(num_prefills=1),) + args[5:]
+    m.update_kv_cache(*prefill)
+    assert calls == [("upstream", prefill)]
+    calls.clear()
+    # No slot mapping: upstream's early return, the gate is not asked.
+    m._idx_glue_defer_kv = lambda *a: pytest.fail("asked without a slot mapping")
+    no_slots = args[:3] + (None,) + args[4:]
+    m.update_kv_cache(*no_slots)
+    assert calls == [("upstream", no_slots)]
