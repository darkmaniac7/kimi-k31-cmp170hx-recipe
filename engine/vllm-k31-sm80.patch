+class _FakeSuffix:
+    """CPU stand-in for SuffixSpeculator with explicit device-like tensors."""
+
+    def __init__(self, max_num_reqs: int, k: int, max_model_len: int = 4096):
+        self.max_num_reqs = max_num_reqs
+        self.num_speculative_steps = k
+        self.max_model_len = max_model_len
+        self.enable_adaptive_verification = True
+        self.drafts = torch.zeros((max_num_reqs, k), dtype=torch.int64)
+        self.num_valid = torch.zeros(max_num_reqs, dtype=torch.int32)
+        self.scratch = torch.zeros((max_num_reqs, 4), dtype=torch.int64)
+        self.last_bucket = torch.full((max_num_reqs,), -1, dtype=torch.int32)
+        self.accept_stats = torch.zeros((18, k, 2), dtype=torch.int64)
+        self.added: list[int] = []
+        self.finished: list[list[str]] = []
+        self.reset_count = 0
+        self.propose_calls = 0
+
+    def set_match(
+        self,
+        batch_row: int,
+        req_slot: int,
+        tokens: list[int],
+        match_len: int,
+        *,
+        bucket: int = -1,
+    ) -> None:
+        k = self.num_speculative_steps
+        self.drafts[batch_row].zero_()
+        n = min(len(tokens), k)
+        if n > 0:
+            self.drafts[batch_row, :n] = torch.tensor(tokens[:n], dtype=torch.int64)
+        self.num_valid[batch_row] = n
+        self.scratch[batch_row].zero_()
+        if match_len > 0:
+            self.scratch[batch_row, 0] = match_len * (self.max_model_len + 1) + 17
+        self.last_bucket[req_slot] = bucket
+
+    def add_request(self, req_index: int, new_req_data) -> None:
+        self.added.append(req_index)
+
+    def on_requests_finished(self, finished_req_ids) -> None:
+        self.finished.append(list(finished_req_ids))
+
+    def reset_state(self) -> None:
+        self.reset_count += 1
+
+    def propose(self, input_batch, *args, **kwargs):
+        self.propose_calls += 1
+        return self.drafts[: input_batch.num_reqs]
+
