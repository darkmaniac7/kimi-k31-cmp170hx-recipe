+        tensors[f"layers.{l}.self_attn.v_proj.weight"] = torch.zeros((_TINY_NKV * _TINY_HD, _TINY_H), dtype=torch.bfloat16)
+        tensors[f"layers.{l}.self_attn.o_proj.weight"] = torch.zeros((_TINY_H, _TINY_NQ * _TINY_HD), dtype=torch.bfloat16)
+        tensors[f"layers.{l}.mlp.gate_proj.weight"] = torch.zeros((_TINY_INTER, _TINY_H), dtype=torch.bfloat16)
+        tensors[f"layers.{l}.mlp.up_proj.weight"] = torch.zeros((_TINY_INTER, _TINY_H), dtype=torch.bfloat16)
+        tensors[f"layers.{l}.mlp.down_proj.weight"] = torch.zeros((_TINY_H, _TINY_INTER), dtype=torch.bfloat16)
+        tensors[f"layers.{l}.input_layernorm.weight"] = torch.ones((_TINY_H,), dtype=torch.bfloat16)
+        tensors[f"layers.{l}.post_attention_layernorm.weight"] = torch.ones((_TINY_H,), dtype=torch.bfloat16)
+        tensors[f"layers.{l}.self_attn.q_norm.weight"] = torch.ones((_TINY_HD,), dtype=torch.bfloat16)
+        tensors[f"layers.{l}.self_attn.k_norm.weight"] = torch.ones((_TINY_HD,), dtype=torch.bfloat16)
+    save_file(tensors, str(directory / "model.safetensors"))
+    (directory / "config.json").write_text(
+        json.dumps(_tiny_hf_config_dict(quantized=False), indent=2), encoding="utf-8"
+    )
