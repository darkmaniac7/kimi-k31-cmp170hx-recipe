+def test_blocker2_finish_epoch_broadcasts_full_k_drafts_for_pipespec_exit():
+    """Blocker 2: _ps_finish_epoch broadcasts all full_k drafts in p1 so
+    exiting PipeSpec to a Normal step (k=4..7) never embeds -1 on Stage 0."""
+    from vllm.v1.worker.gpu.model_runner import GPUModelRunner
+
+    full_k = 7
+    chunk_k = 3
+    runner = GPUModelRunner.__new__(GPUModelRunner)
+    runner.is_last_pp_rank = True
+    runner.is_first_pp_rank = False
+    runner.device = torch.device("cpu")
+    runner.num_speculative_steps = full_k
+    runner.main_stream = _FakeStream()
+    sent_rows = []
+    runner.pp_handler = SimpleNamespace(
+        broadcast_rows=lambda rows, ev: sent_rows.append(rows.clone()),
+    )
+    runner._ps_chunk_k = chunk_k
+    runner._ps_expect_b = True
+    runner._ps_p2 = None
+    runner._ps_p2_valid = False
+    runner._ps_p2_req = -1
+    runner._ps_pending = None
+
+    batch = _decode_batch(0, chunk_k)
+    proposed = torch.tensor([[100, 101, 102, 103, 104, 105, 106]], dtype=torch.int64)
+
+    # Valid Chunk B exit path (send_now=True): p1 carries ALL 7 drafts.
+    runner._ps_finish_epoch(batch, proposed, send_now=True)
+    assert len(sent_rows) == 2
+    p1_sent, p2_wire = sent_rows[0], sent_rows[1]
+    assert p1_sent.shape == (1, full_k)
+    assert p1_sent[0].tolist() == [100, 101, 102, 103, 104, 105, 106]
+    assert (p1_sent >= 0).all().item()
+    assert p2_wire[0].tolist() == [1, 103, 104, 105, 106]
+
+    # Failed Chunk A path (send_now=False): parked p1 also carries ALL 7 drafts.
+    proposed2 = torch.tensor([[200, 201, 202, 203, 204, 205, 206]], dtype=torch.int64)
+    runner._ps_finish_epoch(batch, proposed2, send_now=False)
+    assert runner._ps_pending is not None
+    parked_p1 = runner._ps_pending[0]
+    assert parked_p1[0].tolist() == [200, 201, 202, 203, 204, 205, 206]
+
+    # Narrow num_drafted_width=5 < full_k=7 preserves 5 valid drafts and -1 padding after.
+    narrow = torch.tensor([[300, 301, 302, 303, 304, 999, 999]], dtype=torch.int64)
+    runner._ps_finish_epoch(batch, narrow, send_now=True, num_drafted_width=5)
+    p1_narrow = sent_rows[-2]
+    assert p1_narrow[0].tolist() == [300, 301, 302, 303, 304, -1, -1]
+    assert int(sent_rows[-1][0, 0].item()) == 0
