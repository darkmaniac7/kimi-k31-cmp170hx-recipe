+    # Concentrated weights on row 0, ties on row 1, masked row on row 2
+    w[0] = torch.tensor(
+        [0.01, 0.40, 0.002, 0.25, 0.001, 0.15, 0.003, 0.10,
+         0.001, 0.04, 0.0005, 0.03, 0.0002, 0.01, 0.0001, 0.005],
+        device="cuda",
+    )
+    w[1, :8] = 0.125
+    w[1, 8:] = 0.001
+    ids = (
+        torch.arange(M * K, device="cuda", dtype=ids_dtype).view(M, K) * 7
+    ) % 896
+    ids[2].fill_(-1)
+    ids[3, 12:] = -1
+    w = torch.where(ids >= 0, w, torch.zeros_like(w))
+
+    for max_topk, rel_thresh, renorm in [
+        (12, 0.0, True),
+        (10, 0.025, True),
+        (12, 0.50, True),   # triggers min-4 guard
+        (8, 0.05, False),
+        (16, 0.0, True),    # 0 dropped -> bit-exact
+    ]:
+        # Force CPU reference on CPU copy for oracle comparison
+        ref_w, ref_ids = moe.prune_moe_topk(
+            w.cpu(), ids.cpu(), max_topk, rel_thresh, renormalize=renorm
+        )
+        gpu_w, gpu_ids = glue.moe_prune_topk(w, ids, max_topk, rel_thresh, renorm)
+        assert torch.equal(gpu_ids.cpu(), ref_ids)
+        assert torch.allclose(gpu_w.cpu(), ref_w, rtol=1e-6, atol=1e-6)
+        if max_topk == 16 and rel_thresh == 0.0:
+            w_masked = torch.where(ids >= 0, w, torch.zeros_like(w))
+            assert torch.equal(gpu_w, w_masked)
+
+    # CUDA Graph capture & replay
+    w_buf = w.clone()
+    ids_buf = ids.clone()
+    out_w_cg = torch.empty_like(w_buf)
+    out_ids_cg = torch.empty_like(ids_buf)
+
+    s = torch.cuda.Stream()
+    s.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(s):
+        glue_ops.moe_prune_topk(w_buf, ids_buf, 10, 0.025, True, out_w_cg, out_ids_cg)
+    torch.cuda.current_stream().wait_stream(s)
+
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        glue_ops.moe_prune_topk(w_buf, ids_buf, 10, 0.025, True, out_w_cg, out_ids_cg)
+
+    w_new = torch.rand((M, K), device="cuda", generator=gen, dtype=torch.float32)
+    w_buf.copy_(w_new)
+    graph.replay()
+    ref_w2, ref_ids2 = moe.prune_moe_topk(
+        w_new.cpu(), ids.cpu(), 10, 0.025, renormalize=True
+    )
+    assert torch.equal(out_ids_cg.cpu(), ref_ids2)
+    assert torch.allclose(out_w_cg.cpu(), ref_w2, rtol=1e-6, atol=1e-6)
