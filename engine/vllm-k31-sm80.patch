+# ---------------------------------------------------------------- driver
+
+
+# Families whose outputs of one captured call are replayed once (the replay
+# caches its last arguments by identity): their cases share the loaded source.
+REPLAYED_ONCE = {"attn_pipeline", "attn_wo_a_consumer"}
+# The families of the attention pipeline exports, ordered by call_order.
+PIPELINE_EXPORT = REPLAYED_ONCE | {"index_select"}
+_LOADED: dict[str, dict] = {}
+
+
+def _load(path: str, case_family: str) -> dict:
+    if case_family not in REPLAYED_ONCE:
+        return torch.load(path, map_location="cpu", weights_only=True)
+    if path not in _LOADED:
+        _LOADED[path] = torch.load(path, map_location="cpu", weights_only=True)
+    return _LOADED[path]
+
+
+def call_order(cases: list[dict]) -> list[dict]:
+    """The cases with the outputs of one captured call in a row, and the calls
+    round-robin over their strata (family, phase, context, drafter, rank), so
+    a run stopped early has judged every stratum evenly. Files of other
+    families keep their order."""
+    if not all(c.get("family") in PIPELINE_EXPORT for c in cases):
+        return cases
+    calls: dict[tuple, list[dict]] = {}
+    for case in cases:
+        calls.setdefault(tuple(case.get("captured_sources") or ()), []).append(case)
+    strata: dict[tuple, list[list[dict]]] = {}
+    for group in calls.values():
+        c = group[0]
+        key = tuple(str(c.get(k)) for k in ("family", "phase", "context", "drafter", "rank"))
+        strata.setdefault(key, []).append(group)
+    queues = [strata[k] for k in sorted(strata)]
+    ordered = []
+    for i in range(max((len(q) for q in queues), default=0)):
+        for q in queues:
+            if i < len(q):
+                ordered.extend(q[i])
+    return ordered
+
+
+def case_row(
+    case: dict, device: torch.device, checkpoint: dict, family_output: str | None = None
+) -> dict:
+    """``family_output``: the output a multi-output family judges when
+    neither the case's ``output`` nor its ``family`` (after ``:``) names one
+    (the cases file's ``family`` suffix)."""
+    sources = case.get("captured_sources")
+    if not sources:
+        raise ValueError("no captured_sources: the case cannot be replayed")
+    case_family, _, case_output = str(case.get("family") or "").partition(":")
+    output = case.get("output") or case_output or family_output
+    cand_sum = cand_max = ref_sum = ref_max = 0.0
+    count = numel = 0
+    bitwise = invariant = True
+    families = set()
+    if len(set(sources)) != len(sources):
+        raise ValueError("duplicate captured source path")
+    for stale in [p for p in _LOADED if p not in sources]:
+        del _LOADED[stale]
+    for path in sources:
+        expected_hash = (case.get("captured_sha256") or {}).get(path)
+        if expected_hash is not None:
+            expected_hash = expected_hash.removeprefix("sha256:")
+        if expected_hash is not None:
+            with open(path, "rb") as source_file:
+                actual_hash = hashlib.file_digest(source_file, "sha256").hexdigest()
+            if actual_hash != expected_hash:
+                raise ValueError(f"{path}: captured source hash changed")
+        obj = _load(path, case_family)
+        if obj.get("schema") != SOURCE_SCHEMA:
+            raise ValueError(f"{path}: schema {obj.get('schema')!r} is not {SOURCE_SCHEMA}")
+        family = obj.get("family")
+        if family not in FAMILIES:
+            raise ValueError(f"{path}: family {family!r} is not one of {sorted(FAMILIES)}")
+        if (case_family or family) != family:
+            raise ValueError(f"{path}: family {family!r} in a case of {case['family']!r}")
+        multi = family in MULTI_OUTPUT
+        families.add(f"{family}:{output}" if multi else family)
+        expert_tp = case.get("expert_tp")
+        if expert_tp is not None and family not in EXL3_MOE_FAMILIES:
+            raise ValueError(f"{path}: expert_tp is for the EXL3 MoE families, not {family!r}")
+        src = Source(obj.get("meta") or {}, checkpoint, output if multi else None,
+                     expert_tp)
+        call = FAMILIES[family](obj["tensors"], device, src)
+        cs, cm, n = abs_errors(call.cand, call.exact)
+        ref_exact = call.exact if call.ref_exact is None else call.ref_exact
+        rs, rm, _ = abs_errors(call.ref, ref_exact)
+        cand_sum, cand_max = cand_sum + cs, max(cand_max, cm)
+        ref_sum, ref_max = ref_sum + rs, max(ref_max, rm)
+        count += n
+        numel += call.cand.numel()
+        bitwise &= bits_equal(call.cand, call.ref)
+        invariant &= call.row_invariant
+    count = max(count, 1)
+    return {
+        "case": case["id"],
+        "family": ",".join(sorted(families)),
+        "fp64": {
+            "cand_mean": cand_sum / count,
+            "cand_max": cand_max,
+            "ref_mean": ref_sum / count,
+            "ref_max": ref_max,
+        },
+        "bitwise": bool(bitwise),
+        "row_invariance": bool(invariant),
+        "numel": int(numel),
+    }
+
+
+def header(device: torch.device) -> dict:
+    import triton
+
+    if device.type == "cuda":
+        props = torch.cuda.get_device_properties(device)
+        gpu, sms = props.name, props.multi_processor_count
+    else:
+        gpu, sms = "cpu", 0
+    return {
+        "torch": torch.__version__,
+        "triton": triton.__version__,
+        "cuda": torch.version.cuda,
+        "gpu": gpu,
+        "sm_count": sms,
+        "reference_math": {
+            "allow_tf32": torch.backends.cuda.matmul.allow_tf32,
+            "allow_bf16_reduced_precision_reduction": torch.backends.cuda.matmul.allow_bf16_reduced_precision_reduction,
+            "allow_fp16_reduced_precision_reduction": torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction,
+            "float32_matmul_precision": torch.get_float32_matmul_precision(),
+        },
+    }
+
+
+def run(cases: Path, out: Path, device: torch.device) -> int:
+    """Write the header and one line per case that runs. 0 when every case
+    has its line, 1 when one has none (each named on stderr), 2 when the
+    case file is not one of SCHEMAS."""
+    doc = json.loads(Path(cases).read_text())
+    if not isinstance(doc, dict) or doc.get("schema") not in SCHEMAS:
+        print(f"{cases}: schema is not one of {SCHEMAS}", file=sys.stderr)
+        return 2
+    if any(str(c.get("family", "")).startswith("hybrid_linear") for c in doc.get("cases", [])):
+        from tests.models.deepseek_v41.sm80.hybrid_linear_cases import reference_settings
+
+        reference_settings()
+    with Path(out).open("w") as f, torch.inference_mode():
+        f.write(json.dumps({"header": header(device)}) + "\n")
+        checkpoint = doc.get("checkpoint") or {}
+        family_output = str(doc.get("family") or "").partition(":")[2] or None
+        failed = []
+        for case in call_order(doc.get("cases") or []):
+            try:
+                row = case_row(case, device, checkpoint, family_output)
+            except Exception as exc:  # noqa: BLE001 - reported, the other cases still run
+                print(f"case {case.get('id')}: {type(exc).__name__}: {exc}", file=sys.stderr)
+                failed.append(str(case.get("id")))
+                continue
+            f.write(json.dumps(row) + "\n")
+            f.flush()
+    if failed:
+        print(f"fp64_cases: {len(failed)} case(s) without a result: {', '.join(failed)}",
+              file=sys.stderr)
+        return 1
+    return 0
+
+
+def _spread(records: list[dict], calls: int) -> list[dict]:
+    """Up to ``calls`` of ``records`` (capture index lines of one cell),
+    spread over their layers: evenly spaced layers first, each layer's calls
+    in step order."""
+    from vllm.model_executor.models.utils import extract_layer_index
+
+    by_layer: dict[int, list[dict]] = {}
+    for rec in sorted(records, key=lambda r: (r["step"], r["path"])):
+        by_layer.setdefault(extract_layer_index(rec["prefix"]), []).append(rec)
+    layers = sorted(by_layer)
+    chosen: list[dict] = []
+    for depth in range(max(map(len, by_layer.values()))):
+        left = [layer for layer in layers if depth < len(by_layer[layer])]
+        k = min(calls - len(chosen), len(left))
+        chosen += [by_layer[left[i * len(left) // k]][depth] for i in range(k)]
+        if len(chosen) == calls:
+            break
+    return chosen
+
+
+def expert_tp_cases(captures, checkpoint, size: int = 4, calls: int = 4) -> dict:
+    """served_cases/1 cases of the routed experts split across ``size``
+    tensor-parallel ranks, derived from captures of whole experts
+    (expert-parallel) at ``captures``: each the VLLM_SM80_CAPTURE_DIR of a
+    boot of ``size`` ranks, r<rank>/index.jsonl and the files it names, of
+    the ``checkpoint`` they served. Every rank of the split routes the same
+    rows, so rank 0's file of a call stands for every rank (each rank's file
+    of that name must hold the same x, topk_ids and topk_weights); the
+    driver derives each rank's arguments (tp_call). Per operator (decode,
+    verify, draft and prefill), phase, rows and model (target or drafter
+    layer) up to ``calls`` calls of all the captures, spread over the
+    layers, one case per request count, with ``expert_tp`` = ``size``; the
+    calls of decode, verify and draft steps are decode cases
+    (``scheduler_phase`` keeps the capture's phase)."""
+    from vllm.model_executor.models.utils import extract_layer_index
+
+    if size < 2 or calls < 1:
+        raise ValueError(f"a split of {size} ranks, {calls} calls per case")
+    captures, checkpoint = [Path(c) for c in captures], Path(checkpoint)
+    config = json.loads((checkpoint / "config.json").read_text())
+    targets = int(config.get("text_config", config)["num_hidden_layers"])
+    cells: dict[tuple, list[dict]] = {}
+    for capture in captures:
+        for line in (capture / "r0" / "index.jsonl").read_text().splitlines():
+            rec = json.loads(line) if line.strip() else {}
+            if rec.get("point") in EXL3_MOE_FAMILIES and rec.get("saved"):
+                drafter = extract_layer_index(rec["prefix"]) >= targets
+                key = (rec["point"], rec["phase"], int(rec["rows"]), drafter)
+                cells.setdefault(key, []).append(dict(rec, capture=capture))
+    if not cells:
+        raise ValueError(f"{', '.join(map(str, captures))}: no saved routed-expert call")
+    cases: dict[tuple, dict] = {}
+    for (point, phase, rows, drafter), records in sorted(cells.items()):
+        for rec in _spread(records, calls):
+            path, capture = Path(rec["path"]), rec["capture"]
+            name = path.relative_to(capture / "r0")
+            with path.open("rb") as f:
+                digest = hashlib.file_digest(f, "sha256").hexdigest()
+            if digest != rec["sha256"]:
+                raise ValueError(f"{path}: captured source hash changed")
+            obj = torch.load(path, map_location="cpu", weights_only=True)
+            if obj.get("schema") != SOURCE_SCHEMA or obj.get("family") != point:
+                raise ValueError(f"{path}: not a {SOURCE_SCHEMA} call of {point}")
+            a, meta = obj["tensors"], obj["meta"]
+            prefix = meta["module_prefix"]
+            tp_call(a, prefix, 0, 1)
+            # Whole experts: as wide as the checkpoint's (a split call's are
+            # narrower).
+            layout, resolver, ckpt = _expert_layout(str(checkpoint))
+            some = int(torch.nonzero(a["expert_map"] >= 0)[0])
+            gate = layout.expert_matrix(resolver, prefix, some, "gate_proj")
+            if int(a["intermediate_size"]) != ckpt.matrix(gate).padded_out:
+                raise ValueError(f"{path}: experts of {a['intermediate_size']} of the "
+                                 f"checkpoint's {ckpt.matrix(gate).padded_out} columns, "
+                                 "not whole experts")
+            for rank in range(1, size):
+                other = torch.load(capture / f"r{rank}" / name, map_location="cpu",
+                                   weights_only=True)["tensors"]
+                if not all(bits_equal(a[k], other[k])
+                           for k in ("x", "topk_ids", "topk_weights")):
+                    raise ValueError(f"{name}: rank {rank} routed other rows than rank 0")
+            n = len(meta.get("query_lens") or ())
+            if n < 1:
+                raise ValueError(f"{path}: the call records no requests")
+            model = "drafter" if drafter else "target"
+            case = cases.setdefault((point, phase, rows, drafter, n), {
+                "id": f"{point}/{phase}/M{rows}/c{n}/{model}/tp{size}", "family": point,
+                "phase": "prefill" if phase == "prefill" else "decode",
+                "scheduler_phase": phase, "concurrency": n, "rows": rows,
+                "drafter": drafter, "expert_tp": size, "captured_sources": [],
+                "captured_sha256": {},
+            })
+            case["captured_sources"].append(str(path))
+            case["captured_sha256"][str(path)] = "sha256:" + digest
+    return {
+        "schema": "served_cases/1",
+        "checkpoint": {"target": str(checkpoint)},
+        "source": [str(c) for c in captures],
+        "source_kind": "expert_tp_from_whole_experts",
+        "expert_tp": size,
+        "sampling": f"up to {calls} calls per operator, phase, rows and model, "
+                    "spread over the layers",
+        "limitations": ["the rows and routes of whole-expert calls, replayed on the "
+                        "layout of the split"],
+        "cases": [cases[k] for k in sorted(cases)],
+    }
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    ap.add_argument("--cases", type=Path)
+    ap.add_argument("--out", type=Path, required=True)
+    ap.add_argument("--export-expert-tp", type=Path, nargs="+", metavar="CAPTURE",
+                    help="write the split-expert cases of whole-expert captures to --out")
+    ap.add_argument("--checkpoint", type=Path,
+                    help="the target checkpoint the captures served")
+    ap.add_argument("--tp-size", type=int, default=4)
+    ap.add_argument("--calls", type=int, default=4, help="calls per case")
+    a = ap.parse_args(argv)
+    if a.export_expert_tp is not None:
+        if a.checkpoint is None:
+            ap.error("--export-expert-tp needs --checkpoint")
+        if a.out.exists():
+            print(f"fp64_cases: refusing to replace {a.out}", file=sys.stderr)
+            return 2
+        doc = expert_tp_cases(a.export_expert_tp, a.checkpoint, a.tp_size, a.calls)
+        a.out.write_text(json.dumps(doc, indent=1) + "\n")
+        return 0
+    if a.cases is None:
+        ap.error("--cases is required")
+    if not torch.cuda.is_available():
+        print("fp64_cases: the candidate path runs on CUDA; no CUDA device", file=sys.stderr)
+        return 2
+    return run(a.cases, a.out, torch.device("cuda"))
+
+
+if __name__ == "__main__":
+    # The tree this file is in is the one under test.
+    sys.path.insert(0, str(ROOT))
+    raise SystemExit(main())
diff --git a/tests/models/deepseek_v41/sm80/hybrid_consumer_cases.py b/tests/models/deepseek_v41/sm80/hybrid_consumer_cases.py
new file mode 100644
index 0000000000..e37fc59003
--- /dev/null
+++ b/tests/models/deepseek_v41/sm80/hybrid_consumer_cases.py
@@ -0,0 +1,281 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Replay byte-linked hybrid producer/consumer calls with explicit storage points."""
+
+import hashlib
+from pathlib import Path
+
+import torch
+
+from tests.models.deepseek_v41.sm80 import fp64_cases as fp64
+from tests.models.deepseek_v41.sm80 import hybrid_linear_cases as linear
+
+
+def _move(a, device):
+    return {k: v.to(device, copy=True) if isinstance(v, torch.Tensor) else v for k, v in a.items()}
+
+
+def _rope(a):
+    from tests.models.deepseek_v41.sm80.test_sm80_kernels_gpu import _inverse_rope_fp64
+    x = a["x"]
+    shape = x.shape
+    value = x.reshape(shape[0], -1, shape[-1])
+    freqs = a["freqs"] if a.get("inverse", False) else -a["freqs"]
+    return _inverse_rope_fp64(value, a["positions"], freqs).reshape(shape)
+
+
+def actual(op, a):
+    from vllm.model_executor.layers.activation import SiluAndMulWithClamp
+    from vllm.models.deepseek_v41.nvidia.ops import sm80_attn_core as core
+
+    if op == "gate":
+        from pytest import MonkeyPatch
+        from tests.models.deepseek_v41.sm80 import construct
+        from vllm.model_executor.layers.fused_moe.router.gate_linear import GateLinear
+        from vllm.models.deepseek_v41.nvidia.sm80_moe import _GATE_TIERS
+        with MonkeyPatch.context() as mp:
+            construct.set_groups(mp, 1, 0)
+            with torch.device(a["weight"].device):
+                gate = GateLinear(a["weight"].shape[1], a["weight"].shape[0],
+                                  params_dtype=torch.float32, out_dtype=torch.float32,
+                                  return_bias=a["return_bias"])
+        gate.weight = torch.nn.Parameter(a["weight"], requires_grad=False)
+        for flag in _GATE_TIERS:
+            setattr(gate, flag, False)
+        return gate(a["x"])
+    if op == "route":
+        from vllm.models.deepseek_v41.nvidia.sm80_moe import route
+        return route(**a)
+    if "mhc_" in op:
+        from vllm.models.deepseek_v41.nvidia.ops import sm80_mhc, sm80_mhc_fused
+        module = sm80_mhc_fused if op.startswith("fused_") else sm80_mhc
+        return getattr(module, op.removeprefix("fused_"))(**a)
+    if op == "add":
+        return torch.add(a["x"], a["y"], alpha=a["alpha"])
+    if op == "greedy":
+        from vllm.v1.sample.sampler import Sampler
+        return Sampler.greedy_sample(a["logits"])
+    if op == "compress_rows":
+        result = core.compress_rows(**a)
+        return {"0": result[0], "1": result[1], "ring": a["ring"]}
+    if op == "swiglu":
+        return SiluAndMulWithClamp(a["limit"], alpha=a["alpha"], beta=a["beta"])(a["x"])
+    if op == "store_rows":
+        core.store_rows(**a)
+        return a["cache"]
+    return getattr(core, op)(**a)
+
+
+def ideal(op, a):
+    from tests.models.deepseek_v41.sm80.test_act_quant import ref_fp4, ref_fp8
+    from vllm.models.deepseek_v41.nvidia.ops import sm80_attn_core as core
+
+    if op == "gate":
+        result = a["x"].double() @ a["weight"].double().T
+        return (result, None) if a["return_bias"] else result
+    if op == "route":
+        logits = a["logits"].double() / a["gate_temp"]
+        scores = torch.nn.functional.softplus(logits).sqrt()
+        bias = a["bias"].double()
+        if a["image_mask"] is not None and a["bias_vl"] is not None:
+            bias = torch.where(a["image_mask"][:, None], a["bias_vl"].double(), bias)
+        ids = (scores + bias).topk(a["top_k"], dim=-1).indices
+        weights = scores.gather(1, ids)
+        if a["renormalize"] and a["top_k"] > 1:
+            weights /= weights.sum(-1, keepdim=True) + 1e-20
+        return weights * a["routed_scaling_factor"], ids
+    if "mhc_" in op:
+        if op.removeprefix("fused_") == "mhc_post":
+            n, hc, _ = a["residual"].shape
+            return a["post_layer_mix"].double().reshape(n, hc, 1) * a["x"].double()[:, None] + torch.einsum(
+                "tjk,tjh->tkh", a["comb_res_mix"].double().reshape(n, hc, hc), a["residual"].double())
+        values = fp64.mhc_delayed_fp64(a, rounding=True)
+        result = (values["post"], values["comb"], values["layer_input"], values["pre"])
+        if a.get("x") is not None:
+            stored = values["residual"].to(torch.bfloat16).double()
+            aux = stored.mean(1) if a.get("capture_aux") else stored.new_empty(0, stored.shape[-1])
+            return values["residual"], *result, aux
+        return result
+    if op == "add":
+        return a["x"].double() + a["y"].double() * a["alpha"]
+    if op == "greedy":
+        return a["logits"].double().argmax(-1).view(-1)
+    if op == "rms_norm":
+        x = a["x"].double()
+        return x * torch.rsqrt(x.square().mean(-1, keepdim=True) + a["eps"]) * a["weight"].double()
+    if op == "rope":
+        return _rope(a)
+    if op == "swiglu":
+        gate, up = a["x"].double().chunk(2, -1)
+        gate = gate.clamp(max=a["limit"])
+        up = up.clamp(min=-a["limit"], max=a["limit"])
+        return gate * torch.sigmoid(a["alpha"] * gate) * (up + a["beta"])
+    if op == "qdq_fp8":
+        return ref_fp8(a["x"], a["block"]).double()
+    if op == "qdq_fp4":
+        return ref_fp4(a["x"], a["block"], a["scale"]).double()
+    if op in ("window_kv", "compressed_kv"):
+        key = "kv" if op == "window_kv" else "latent"
+        pos = a["positions"] if op == "window_kv" else a["group_pos"]
+        rotated = _rope({"x": a[key], "positions": pos, "freqs": a["freqs"]}).to(torch.bfloat16)
+        return (ref_fp8(rotated, 32) if op == "window_kv" else ref_fp4(rotated, 16, "e4m3")).double()
+    if op == "output_qdq":
+        o = a["o"]
+        n, h, d = o.shape
+        rotated = _rope({"x": o, "positions": a["positions"], "freqs": a["freqs"],
+                         "inverse": True}).to(torch.bfloat16)
+        return ref_fp8(rotated.reshape(n, a["n_groups"], -1), 32).reshape(n, h, d).double()
+    if op == "index_key_rows":
+        norm = ideal("rms_norm", {"x": a["k"], "weight": a["k_norm"], "eps": a["eps"]})
+        rotated = _rope({"x": norm.to(torch.bfloat16), "positions": a["group_pos"],
+                         "freqs": a["freqs"]}).to(torch.bfloat16)
+        return ref_fp4(rotated, 32, "e8m0").double()
+    if op == "compress_rows":
+        d, kv = a["head_dim"], a["kv_score"].double()
+        if a["compress_ratio"] == 1:
+            closes, pooled = a["comp_slots"] >= 0, kv[:, :d].to(torch.bfloat16)
+        else:
+            if a["compress_ratio"] != 2:
+                raise ValueError("unsupported captured compressor ratio")
+            t = torch.arange(kv.shape[0])
+            req, qsl, pos = a["token_to_req"].long(), a["query_start_loc"].long(), a["positions"].long()
+            slots, ring = a["ring_slots"].long().clamp_min(0), a["ring"].double()
+            prior = ring[slots // ring.shape[1], (pos - 1) % ring.shape[1]]
+            previous = torch.where((t == qsl[req])[:, None], prior, kv[(t - 1).clamp_min(0)])
+            pair = torch.stack((previous[:, :d], kv[:, :d]), 1)
+            scores = torch.stack((previous[:, d:], kv[:, d:]), 1)
+            pooled = (pair * scores.softmax(1)).sum(1).to(torch.bfloat16)
+            closes = (a["comp_slots"] >= 0) & ((pos + 1) % 2 == 0)
+        if a["ring"] is not None:
+            end = a["query_start_loc"].long()[a["token_to_req"].long() + 1]
+            t = torch.arange(kv.shape[0])
+            tail = (t >= end - a["ring"].shape[1]) & (t < end)
+            core.store_rows(a["ring"], torch.where(tail, a["ring_slots"], -1), a["kv_score"])
+        return {"0": closes, "1": ideal("rms_norm", {"x": pooled, "weight": a["norm_weight"], "eps": a["eps"]}),
+                "ring": a["ring"]}
+    if op in ("index_scores", "sparse_attention"):
+        # These independent captured-input references already implement paging,
+        # visibility, sink attention and the head/rank arithmetic contracts.
+        return fp64.FAMILIES[op](a, torch.device("cpu"), fp64.Source({}, {})).exact
+    if op in ("select_topk", "select_candidate_blocks", "mask_to_candidates", "store_rows"):
+        # Selection, masks and stores are exact contracts, not approximate math.
+        return actual(op, a)
+    raise ValueError(f"no independent FP64 consumer definition for {op}")
+
+
+def _outputs(value, prefix="out"):
+    if isinstance(value, torch.Tensor):
+        return {prefix: value} if value.numel() else {}
+    children = value.items() if isinstance(value, dict) else enumerate(value or ())
+    return {key: tensor for name, child in children
+            for key, tensor in _outputs(child, f"{prefix}.{name}").items()}
+
+
+def load_source(path, sha):
+    with Path(path).open("rb") as stream:
+        actual_sha = hashlib.file_digest(stream, "sha256").hexdigest()
+    if actual_sha != sha:
+        raise ValueError(f"consumer source hash changed: {path}")
+    return torch.load(path, map_location="cpu", weights_only=True, mmap=True)
+
+
+def _owned_state(op, args, outputs):
+    if op not in ("store_rows", "compress_rows"):
+        return
+    name = "cache" if op == "store_rows" else "ring"
+    before = args[name]
+    if before is None:
+        return
+    slots = args["slots" if op == "store_rows" else "ring_slots"].long()
+    if op == "compress_rows":
+        t = torch.arange(slots.numel(), device=slots.device)
+        ends = args["query_start_loc"].long()[args["token_to_req"].long() + 1]
+        slots = torch.where((t >= ends - before.shape[1]) & (t < ends), slots, -1)
+    mask = torch.zeros(before.shape[:2], dtype=torch.bool, device=before.device).flatten()
+    mask[slots[slots >= 0]] = True
+    after = outputs["out" if op == "store_rows" else "out.ring"]
+    if not fp64.bits_equal(before.flatten(0, 1)[~mask], after.flatten(0, 1)[~mask]):
+        raise ValueError("hybrid consumer writes outside owned slots")
+
+
+def evaluate(obj, device, checkpoint, stack=()):
+    meta, tensors = obj["meta"], obj["tensors"]
+    if meta.get("tp_boundary"):
+        raise ValueError("TP collective replay requires the distributed consumer check")
+    if meta["call_id"] in stack:
+        raise ValueError("cyclic hybrid consumer link")
+    stack = (*stack, meta["call_id"])
+    args = {k: v for k, v in tensors.items() if not k.startswith("out")}
+    arms = [_move(args, device), _move(args, device), _move(args, "cpu")]
+    invariant = True
+    for name, source in (meta.get("parent_sources") or {}).items():
+        parent = load_source(source["path"], source["sha256"])
+        pvals, pi = evaluate(parent, device, checkpoint, stack)
+        invariant &= pi
+        view = source["view"]
+        stored = parent["tensors"][view["output"]]
+        expected = stored.as_strided(view["shape"], view["stride"],
+                                     stored.storage_offset() + view["offset"])
+        if not fp64.bits_equal(expected, tensors[name]):
+            raise ValueError("actual-consumer link is not byte-identical to the recorded producer view")
+        for arm, values, target in zip(arms, pvals, (device, device, "cpu")):
+            value = values[view["output"]]
+            arm[name] = value.as_strided(view["shape"], view["stride"],
+                                         value.storage_offset() + view["offset"]).to(device=target, dtype=tensors[name].dtype)
+    if meta.get("linear") is not None:
+        vals = []
+        for index, arm in enumerate(arms):
+            inp = {**arm, "out": tensors["out"]}
+            got = linear.linear_outputs(inp, device, meta, checkpoint)
+            vals.append({"out": got[index]})
+        apply = got[3]
+        whole = vals[0]["out"]
+        invariant &= all(fp64.bits_equal(whole[i:i + 1], apply(arms[0]["x"][i:i + 1]))
+                         for i in fp64.picks(whole.shape[0]))
+        return vals, invariant
+    if not meta.get("parent_sources"):
+        raise ValueError("missing actual-consumer link")
+    outputs = [_outputs(actual(meta["op"], _move(arms[0], device))),
+               _outputs(actual(meta["op"], _move(arms[1], device))),
+               _outputs(ideal(meta["op"], _move(arms[2], "cpu")))]
+    for before, after in zip(arms, outputs):
+        _owned_state(meta["op"], before, after)
+    # Replay the unchanged captured call before substituting upstream outputs.
+    replay = _outputs(actual(meta["op"], _move(args, device)))
+    if any(not fp64.bits_equal(replay[name], tensors[name]) for name in meta["outputs"]):
+        raise ValueError("actual consumer does not replay its captured output")
+    op = meta["op"]
+    if op == "store_rows":
+        # Distinct owned writes commute; replay each write on the same pre-state.
+        state = arms[0]["cache"].clone()
+        from vllm.models.deepseek_v41.nvidia.ops.sm80_attn_core import store_rows
+        for row in range(arms[0]["slots"].numel()):
+            store_rows(state, arms[0]["slots"][row:row + 1], arms[0]["rows"][row:row + 1])
+        invariant &= fp64.bits_equal(state, outputs[0]["out"])
+    elif op in ("compress_rows", "index_key_rows", "index_scores", "sparse_attention"):
+        family = {"compress_rows": "compress", "index_key_rows": "index_keys"}.get(op, op)
+        invariant &= fp64.FAMILIES[family](arms[0], device, fp64.Source({}, {})).row_invariant
+    else:
+        n = next(v.shape[0] for v in args.values() if isinstance(v, torch.Tensor) and v.ndim)
+        constants = {"weight", "freqs", "cache", "norm_weight", "k_norm", "fn", "hc_scale", "hc_base", "bias", "bias_vl"}
+        for row in fp64.picks(n):
+            sub = {k: v[row:row + 1] if isinstance(v, torch.Tensor) and v.ndim and
+                   v.shape[0] == n and k not in constants else v for k, v in arms[0].items()}
+            single = _outputs(actual(op, _move(sub, device)))
+            invariant &= all(fp64.bits_equal(outputs[0][key][row:row + 1], value)
+                             for key, value in single.items())
+    return outputs, invariant
+
+
+def hybrid_linear_consumer(a, device, src):
+    linear.reference_settings()
+    obj = {"meta": src.meta, "tensors": a}
+    outputs, invariant = evaluate(obj, device, src.checkpoint["hybrid"])
+    if not invariant:
+        raise ValueError("hybrid consumer violates row invariance")
+    name = src.output or "out"
+    cand, ref, exact = (values[name] for values in outputs)
+    if not cand.is_floating_point():
+        if not fp64.bits_equal(cand, ref) or not fp64.bits_equal(cand.cpu(), exact.cpu()):
+            raise ValueError("discrete hybrid consumer flip; no blanket tie forgiveness")
+    return fp64.Call(cand, ref, exact.double(), invariant)
diff --git a/tests/models/deepseek_v41/sm80/hybrid_fixture.py b/tests/models/deepseek_v41/sm80/hybrid_fixture.py
