+@pytest.mark.parametrize("seed", range(6))
+def test_late_scatter_equals_the_post_update_scatter(monkeypatch, seed):
+    """Random batches with filtered rows: the request state after the deferred
+    scatter is what post_update writes when the drafts ride with the counts."""
+    rng = np.random.default_rng(seed)
+    n = int(rng.integers(1, 6))
+    idx = rng.permutation(8)[:n].tolist()
+    need = (rng.random(n) < 0.7).tolist()
+    drafts = rng.integers(1, 1000, size=(n, K)).tolist()
+    init = torch.from_numpy(rng.integers(1000, 2000, size=(8, K)))
+
+    h, _ = _handler(monkeypatch, split=False)
+    _queue(h, _slot(idx, drafts, split=False, need=need))
+    want = init.clone()
+    out = h.get_prev_sampled_outputs()
+    if out is not None:
+        _post_update_scatter(want, out["idx_mapping"], out["draft_tokens"])
+
+    h, _ = _handler(monkeypatch, split=True)
+    _queue(h, _slot(idx, drafts, need=need))
+    got = init.clone()
+    out = h.get_prev_sampled_outputs()
+    assert (out is None) == (not any(need))
+    if out is not None:
+        assert out["draft_tokens"] is None
+    h.apply_pending_drafts(got)
+    assert torch.equal(got, want)
+
+
+def test_rows_freed_before_the_late_scatter_are_skipped(monkeypatch):
+    h, _ = _handler(monkeypatch)
+    _queue(h, _slot([3, 5], [[11, 12, 13], [21, 22, 23]]))
+    state = torch.zeros(8, K, dtype=torch.int64)
