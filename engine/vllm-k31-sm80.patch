+def test_m3_two_phase_gloo_teardown_order(monkeypatch, meta_platform):
+    """M3: both failed-probe retry and collective close run Phase 1
+    close_peer_imports on both ranks strictly before Phase 2 destroy on either."""
+    monkeypatch.setenv("VLLM_K31_P2P_ALLREDUCE", "1")
+
+    # 1) Asymmetric BAR1 failure -> SHM retry teardown must be strictly two-phase.
+    ops = fake_p2p.FakeP2POps(
+        probe_outcomes={
+            (False, 0): True,
+            (False, 1): False,
+            (True, 0): True,
+            (True, 1): True,
+        }
+    ).install(monkeypatch)
+    c0, c1, ok = _run_pair_init(ops, force_shm=False)
+    assert ok == [True, True]
+    assert len(ops.teardown_events) == 4
+    assert [ev[0] for ev in ops.teardown_events[:2]] == ["close_imports", "close_imports"]
+    assert [ev[0] for ev in ops.teardown_events[2:]] == ["destroy", "destroy"]
+    assert {ev[1] for ev in ops.teardown_events[:2]} == {0, 1}
+    assert {ev[1] for ev in ops.teardown_events[2:]} == {0, 1}
+
+    # 2) Explicit collective=True close runs two-phase Gloo teardown.
+    ops.teardown_events.clear()
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        f0 = pool.submit(c0.close, collective=True)
+        f1 = pool.submit(c1.close, collective=True)
+        f0.result(timeout=10)
+        f1.result(timeout=10)
+    assert len(ops.teardown_events) == 4
+    assert [ev[0] for ev in ops.teardown_events[:2]] == ["close_imports", "close_imports"]
+    assert [ev[0] for ev in ops.teardown_events[2:]] == ["destroy", "destroy"]
+
