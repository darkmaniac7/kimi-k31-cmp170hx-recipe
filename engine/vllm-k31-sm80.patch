@@ -0,0 +1,1012 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""PipeSpec: pipelined speculative decoding across PP stages for Kimi K3.1.
+
+Switch-gated by ``VLLM_K31_PIPESPEC=1`` (default off: completely inert).
+
+One epoch of a lone decoding request R consists of two consecutive scheduler
+steps across ``PP > 1`` stages:
+  A (step e)   : [last_token, d_1, ..., d_k]            verified normally
+  B (step e+1) : [d_{k+1}, d_{k+2}, ..., d_{2k+1}]      issued immediately
+                 before A is verified; d_{k+1} is the drafter's guess of A's
+                 bonus token, and d_{k+2}..d_{2k+1} are B's k drafts.
+
+B is valid iff A accepts all k drafts and A's bonus token equals d_{k+1}.
+Only the last PP rank makes that decision (one host sync after A); all stages
+stay in lockstep using the step marker ("N", "A", "B") carried in
+``SchedulerOutput.pipespec_markers``.
+
+On Kimi K3.1 with DSpark (single-pass block drafter of width K) and per-slot
+KDA state (``1 + K`` state blocks per request, no ReplaySSM under PP):
+  - One DSpark propose call already yields 2k + 1 <= K drafts:
+    ``P1 = drafts[:, :k]`` (next A) and ``P2 = drafts[:, k : 2*k + 1]`` (next B).
+  - KDA Bank-0 / Bank-1 isolation keeps Chunk A in state slots ``0..k`` (and
+    conv line ``block_table[0]``) and Chunk B in disjoint state slots
+    ``k+1..2k+1`` (and conv line ``block_table[k+1]``), requiring
+    ``2 * (k + 1) <= 1 + K`` (identical to ``2 * k + 1 <= K``).
+  - If Chunk B is dropped (``num_sampled == 0, num_rejected == k + 1``), Bank 0
+    and ``num_accepted_tokens_gpu`` stay untouched on every PP stage with zero
+    host sync on non-last ranks. If Chunk B is valid (``num_sampled == m_b``),
+    Bank 1's conv line and committed recurrent slot ``k + m_b`` commit into
+    Bank 0 slot ``m_b - 1`` on device (zero host sync).
+"""
+
+from __future__ import annotations
+
+import json
+import math
+from collections import deque
+from typing import Any
+
+import torch
+
+import vllm.envs as envs
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+
+def is_enabled() -> bool:
+    """Return True when VLLM_K31_PIPESPEC=1 is active."""
+    return bool(envs.VLLM_K31_PIPESPEC)
+
+
+def min_left() -> int:
+    return max(0, int(envs.VLLM_K31_PIPESPEC_MIN_LEFT))
+
+
+def min_conf() -> float:
+    return float(envs.VLLM_K31_PIPESPEC_MIN_CONF)
+
+
+def log_every() -> int:
+    return max(0, int(envs.VLLM_K31_PIPESPEC_LOG))
+
+
+def markers(scheduler_output: Any) -> dict[str, str]:
+    """Return the per-request PipeSpec step markers ("A" or "B"), or {}."""
+    return getattr(scheduler_output, "pipespec_markers", None) or {}
+
+
+def chunk_k_of(scheduler_output: Any) -> int:
+    """Return the half-epoch draft count k carried by ``scheduler_output``."""
+    return int(getattr(scheduler_output, "pipespec_chunk_k", 0) or 0)
+
+
+def max_legal_chunk_k(num_spec_tokens: int) -> int:
+    """Largest half-epoch k satisfying 2*k + 1 <= K and 2*(k + 1) <= K + 1."""
+    if num_spec_tokens < 3:
+        return 0
+    return (num_spec_tokens - 1) // 2
+
+
+def resolve_chunk_k(
+    num_spec_tokens: int,
+    adaptive_k_config: Any = None,
+    override_k: int | None = None,
+) -> int:
+    """Choose the half-epoch draft width k for PipeSpec.
+
+    Requires ``2 * k + 1 <= num_spec_tokens`` so a single DSpark block supplies
+    both P1 (k drafts) and P2 (k + 1 tokens) AND KDA Bank-0 / Bank-1 state
+    slots remain disjoint inside the ``1 + num_spec_tokens`` reserved blocks.
+    When ``adaptive_k_config`` is present, ``k`` is snapped to an allowed
+    captured tier so Chunk A and Chunk B replay captured decode graphs.
+    """
+    max_k = max_legal_chunk_k(num_spec_tokens)
+    if max_k <= 0:
+        return 0
+    allowed = tuple(adaptive_k_config.allowed) if adaptive_k_config is not None else ()
+    if override_k is None:
+        override_k = int(envs.VLLM_K31_PIPESPEC_CHUNK_K)
+    if override_k > 0:
+        if override_k > max_k:
+            return 0
+        if allowed and override_k not in allowed:
+            return 0
+        return override_k
+    if allowed:
+        fitting = [t for t in allowed if t <= max_k]
+        return fitting[-1] if fitting else 0
+    return max_k
+
+
+def full_accept_prob(probs: list[float] | tuple[float, ...], k: int) -> float:
+    """Probability that all k drafts of Chunk A are accepted: prod_{i<k} p_i."""
+    if len(probs) < k or k <= 0:
+        return 0.0
+    p = 1.0
+    for val in probs[:k]:
+        p *= min(max(float(val), 0.0), 1.0)
+    return p
+
+
+def b_valid_prob(probs: list[float] | tuple[float, ...], k: int) -> float:
+    """Probability Chunk B is valid: A accepts all k drafts AND bonus == d_k."""
+    if k <= 0 or len(probs) < k:
+        return 0.0
+    n = k + 1 if len(probs) >= k + 1 else k
+    p = 1.0
+    for val in probs[:n]:
+        p *= min(max(float(val), 0.0), 1.0)
+    return p
+
+
+DEFAULT_STEP_COSTS: dict[str, float] = {
+    "1": 35.5,
+    "2": 37.5,
+    "3": 39.5,
+    "4": 41.5,
+    "5": 43.5,
+    "6": 45.5,
+    "7": 47.5,
+    "8": 49.5,
+    "9": 51.5,
+    "10": 53.5,
+    "11": 55.5,
+    "12": 57.5,
+    "ps_hit_extra": 11.5,
+    "ps_miss_extra": 5.5,
+}
+
+
+def parse_step_costs(raw: str = "") -> dict[str, float]:
+    costs = dict(DEFAULT_STEP_COSTS)
+    raw = (raw or "").strip()
+    if raw:
+        data = json.loads(raw)
+        if isinstance(data, dict):
+            for key, val in data.items():
+                costs[str(key)] = float(val)
+    return costs
+
+
+def cost_for_normal_k(costs: dict[str, float], k: int) -> float:
+    key = str(int(k))
+    if key in costs:
+        return max(1.0, float(costs[key]))
+    return max(1.0, 33.5 + 2.0 * float(k))
+
+
+def parse_pipespec_cks(
+    raw: str,
+    num_spec_tokens: int,
+    allowed: tuple[int, ...],
+) -> tuple[int, ...]:
+    max_k = max_legal_chunk_k(num_spec_tokens)
+    if max_k <= 0:
+        return ()
+    raw = (raw or "").strip()
+    if raw:
+        vals = sorted({int(x.strip()) for x in raw.split(",") if x.strip()})
+        out = [
+            v
+            for v in vals
+            if 1 <= v <= max_k and (not allowed or v in allowed)
+        ]
+        return tuple(out)
+    if allowed:
+        return tuple(t for t in allowed if 1 <= t <= max_k)
+    return (max_k,)
+
+
+def select_optimal_action(
+    probs: list[float] | tuple[float, ...] | None,
+    accept_rate: float,
+    accept_weight: float,
+    allowed_k: tuple[int, ...],
+    legal_cks: tuple[int, ...],
+    costs: dict[str, float],
+    min_conf_val: float,
+    max_k_cap: int,
+) -> tuple[str, int]:
+    """Choose ("PS", ck) or ("N", k) maximizing expected tokens / ms."""
+    ar = min(max(float(accept_rate), 0.0), 1.0)
+    w = min(max(float(accept_weight), 0.0), 1.0)
+    n_pos = max(max_k_cap + 1, (max(legal_cks) * 2 + 1) if legal_cks else 1)
+    p_vec: list[float] = []
+    for i in range(n_pos):
+        if probs is not None and i < len(probs):
+            ci = min(max(float(probs[i]), 0.0), 1.0)
+            p_vec.append((1.0 - w) * ci + w * ar)
+        else:
+            p_vec.append(ar)
+
+    best_mode = "N"
+    best_k = allowed_k[0] if allowed_k else max(1, min(3, max_k_cap))
+    best_tps = -1.0
+
+    for k in allowed_k:
+        if k > max_k_cap or k <= 0:
+            continue
+        e_tok = 1.0
+        run = 1.0
+        for i in range(k):
+            run *= p_vec[i]
+            e_tok += run
+        c_ms = cost_for_normal_k(costs, k)
+        tps = e_tok / c_ms
+        if tps > best_tps:
+            best_tps = tps
+            best_mode = "N"
+            best_k = k
+
+    hit_extra = float(costs.get("ps_hit_extra", 11.5))
+    miss_extra = float(costs.get("ps_miss_extra", 5.5))
+    for ck in legal_cks:
+        if ck > max_k_cap or ck <= 0 or 2 * ck + 1 > len(p_vec):
+            continue
+        e_a = 1.0
+        run = 1.0
+        for i in range(ck):
+            run *= p_vec[i]
+            e_a += run
+        p_b = run * p_vec[ck]
+        if p_b < min_conf_val:
+            continue
+        e_b = 1.0
+        run_b = 1.0
+        for m in range(ck):
+            run_b *= p_vec[ck + 1 + m]
+            e_b += run_b
+        e_tok_ps = e_a + p_b * e_b
+        c_base = cost_for_normal_k(costs, ck)
+        e_ms_ps = c_base + p_b * hit_extra + (1.0 - p_b) * miss_extra
+        tps_ps = e_tok_ps / max(1.0, e_ms_ps)
+        if tps_ps > best_tps:
+            best_tps = tps_ps
+            best_mode = "PS"
+            best_k = ck
+
+    return best_mode, best_k
+
+
+class SchedulerPipeSpec:
+    """Scheduler-side PipeSpec state machine (inert unless VLLM_K31_PIPESPEC=1)."""
+
+    def __init__(self, sched: Any) -> None:
+        self.num_spec_tokens = int(getattr(sched, "num_spec_tokens", 0))
+        self.pp = int(sched.parallel_config.pipeline_parallel_size)
+        spec = sched.vllm_config.speculative_config
+        adaptive_cfg = getattr(spec, "adaptive_k_config", None) if spec is not None else None
+        self.chunk_k = resolve_chunk_k(self.num_spec_tokens, adaptive_cfg)
+        self.min_left = min_left()
+        self.min_conf = min_conf()
+        self.log_every = log_every()
+        self.bonus_conf = bool(getattr(envs, "VLLM_K31_PIPESPEC_BONUS_CONF", False))
+        self.dynamic = bool(getattr(envs, "VLLM_K31_PIPESPEC_DYNAMIC", False))
+        allowed_t = tuple(adaptive_cfg.allowed) if adaptive_cfg is not None else ()
+        self.allowed_k = allowed_t if allowed_t else (self.num_spec_tokens,)
+        self.legal_cks = parse_pipespec_cks(
+            getattr(envs, "VLLM_K31_PIPESPEC_CKS", ""),
+            self.num_spec_tokens,
+            allowed_t,
+        )
+        if self.dynamic and self.legal_cks and self.chunk_k <= 0:
+            self.chunk_k = self.legal_cks[-1]
+        self.step_costs = parse_step_costs(getattr(envs, "VLLM_K31_STEP_COSTS", ""))
+
+        cache_cfg = getattr(sched, "cache_config", None)
+        if cache_cfg is None:
+            cache_cfg = getattr(sched.vllm_config, "cache_config", None)
+        use_recoverssm = bool(getattr(cache_cfg, "use_kda_recoverssm", False))
+        draft_by_load = bool(getattr(adaptive_cfg, "draft_by_load", False))
+        v2_attr = getattr(sched, "use_v2_model_runner", None)
+        if v2_attr is None:
+            v2_attr = getattr(sched.vllm_config, "use_v2_model_runner", True)
+        use_v2 = bool(v2_attr)
+
+        want = is_enabled()
+        self.enabled = (
+            want
+            and self.pp > 1
+            and self.chunk_k >= 1
+            and 2 * self.chunk_k + 1 <= self.num_spec_tokens
+            and use_v2
+            and bool(sched.scheduler_config.async_scheduling)
+            and spec is not None
+            and getattr(spec, "draft_sample_method", "greedy")
+            in ("greedy", "probabilistic")
+            and not draft_by_load
+            and not use_recoverssm
+        )
+        if want and not self.enabled:
+            logger.warning_once(
+                "VLLM_K31_PIPESPEC=1 ignored: needs PP>1, V2 runner, async "
+                "scheduling, num_spec_tokens>=3 with a legal chunk_k, "
+                "draft_by_load=False, and use_kda_recoverssm=False (got "
+                "pp=%d, K=%d, chunk_k=%d, async=%s, v2=%s, draft_by_load=%s, "
+                "use_kda_recoverssm=%s).",
+                self.pp,
+                self.num_spec_tokens,
+                self.chunk_k,
+                sched.scheduler_config.async_scheduling,
+                use_v2,
+                draft_by_load,
+                use_recoverssm,
+            )
+        # req_id -> step index of its pending Chunk A.
+        self.epoch_a_step: dict[str, int] = {}
+        self.epoch_a_ck: dict[str, int] = {}
+        self._armed_a_ck: dict[str, int] = {}
+        self._disarmed_reqs: set[str] = set()
+        self._inflight_cks: dict[str, deque[int]] = {}
+        self.stats: dict[str, int] = dict(
+            epochs=0,
+            a_full=0,
+            b_sched=0,
+            b_missed=0,
+            b_valid=0,
+            b_invalid=0,
+            b_tokens=0,
+            a_tokens=0,
+            conf_skipped=0,
+            normal_steps=0,
+        )
+        if self.enabled:
+            logger.info(
+                "K3.1 PipeSpec enabled (chunk_k=%d, K=%d, pp=%d, min_conf=%.3f, "
+                "dynamic=%s, cks=%s, bonus_conf=%s).",
+                self.chunk_k,
+                self.num_spec_tokens,
+                self.pp,
+                self.min_conf,
+                self.dynamic,
+                list(self.legal_cks),
+                self.bonus_conf,
+            )
+
+    def lookahead(self, cur: int) -> int:
+        """Reserve lookahead slots for 2*max_ck + 1 drafts when enabled."""
+        if not self.enabled:
+            return cur
+        mx = max(self.legal_cks) if (self.dynamic and self.legal_cks) else self.chunk_k
+        return max(cur, 2 * mx + 1)
+
+    def is_b_step(self, request: Any, current_step: int) -> bool:
+        a = self.epoch_a_step.get(request.request_id)
+        return a is not None and a + 1 == current_step
+
+    def b_step_pending(self, current_step: int) -> bool:
+        """True while this step is some request's Chunk B (defer waiting admissions)."""
+        return self.enabled and any(
+            a + 1 == current_step for a in self.epoch_a_step.values()
+        )
+
+    def pending_b_ck(self, req_id: str) -> int:
+        return int(self.epoch_a_ck.get(req_id, self.chunk_k))
+
+    def b_token_ok(self, num_new_tokens: int, req_id: str | None = None) -> bool:
+        ck = self.pending_b_ck(req_id) if req_id is not None else self.chunk_k
+        return num_new_tokens == ck + 1
+
+    def _mamba_boundary_ok(
+        self,
+        sched: Any,
+        req: Any,
+        num_computed_before_a: int,
+        ck: int | None = None,
+    ) -> bool:
+        cache_cfg = getattr(sched, "cache_config", None)
+        if cache_cfg is None or not getattr(cache_cfg, "enable_prefix_caching", False):
+            return True
+        if not getattr(sched, "has_mamba_layers", False):
+            return True
+        mamba_block_size = getattr(cache_cfg, "mamba_block_size", None)
+        if not mamba_block_size or mamba_block_size <= 0:
+            return True
+        # Ensure Chunk A and Chunk B stay within one Mamba alignment block so
+        # Bank-0/Bank-1 state blocks do not cross a prefix-cache boundary.
+        start_blk = max(num_computed_before_a - 1, 0) // mamba_block_size
+        use_ck = self.chunk_k if ck is None else ck
+        end_pos = num_computed_before_a + 2 * (use_ck + 1) - 1
+        end_blk = max(end_pos - 1, 0) // mamba_block_size
+        return start_blk == end_blk
+
+    def _fresh_probs(self, sched: Any, req_id: str) -> tuple[float, ...] | None:
+        ak = getattr(sched, "adaptive_k", None)
+        if ak is None or ak.config.confidence is None:
+            return None
+        entry = ak._conf.get(req_id)
+        if entry is None:
+            return None
+        stamp, probs = entry
+        age = ak._steps.get(req_id, 0) - stamp
+        if age < 0 or age > ak.config.confidence.max_age:
+            return None
+        return probs
+
+    def _confidence_gate_ok(
+        self, sched: Any, req_id: str, ck: int | None = None
+    ) -> bool:
+        if self.min_conf <= 0.0:
+            return True
+        ak = getattr(sched, "adaptive_k", None)
+        if ak is None or ak.config.confidence is None:
+            return True
+        probs = self._fresh_probs(sched, req_id)
+        if probs is None:
+            return False
+        use_ck = self.chunk_k if ck is None else ck
+        fn = b_valid_prob if (self.bonus_conf or self.dynamic) else full_accept_prob
+        return fn(probs, use_ck) >= self.min_conf
+
+    def _base_request_ok(self, sched: Any, req: Any) -> bool:
+        if len(sched.running) != 1 or sched.waiting or getattr(sched, "skipped_waiting", None):
+            return False
+        if getattr(sched, "num_waiting_for_streaming_input", 0):
+            return False
+        if req.is_prefill_chunk or req.use_structured_output or req.lora_request:
+            return False
+        sp = req.sampling_params
+        if sp is None or sp.logprobs is not None or sp.prompt_logprobs is not None:
+            return False
+        if sched.kv_cache_manager.block_pool.get_num_free_blocks() < 4:
+            return False
+        return True
+
+    def _ck_budget_ok(self, sched: Any, req: Any, ck: int) -> bool:
+        if ck <= 0 or 2 * ck + 1 > self.num_spec_tokens:
+            return False
+        if len(req.spec_token_ids) < ck:
+            return False
+        if self.dynamic and len(req.spec_token_ids) < 2 * ck + 1:
+            return False
+        computed_after_a = req.num_computed_tokens + (ck + 1)
+        if (
+            req.num_prompt_tokens + req.max_tokens - computed_after_a
+            < (ck + 1 + self.min_left)
+        ):
+            return False
+        if (
+            computed_after_a + (ck + 1) + (2 * ck + 1) + self.min_left
+            >= sched.max_model_len
+        ):
+            return False
+        if not self._mamba_boundary_ok(sched, req, req.num_computed_tokens, ck=ck):
+            return False
+        return True
+
+    def desired_k_for_step(self, sched: Any, eligible: list[Any]) -> int | None:
+        """If this step will run a PipeSpec Chunk A or B, return its ``chunk_k``."""
+        if not self.enabled or not eligible:
+            return None
+        cur = getattr(sched, "current_step", 0)
+        for req in eligible:
+            if self.is_b_step(req, cur):
+                return self.pending_b_ck(req.request_id)
+        if len(eligible) != 1:
+            return None
+        req = eligible[0]
+        self._armed_a_ck.pop(req.request_id, None)
+        self._disarmed_reqs.discard(req.request_id)
+        if not self._base_request_ok(sched, req):
+            return None
+        if not self._ck_budget_ok(sched, req, self.chunk_k):
+            return None
+        if not self._confidence_gate_ok(sched, req.request_id, ck=self.chunk_k):
+            return None
+        self._armed_a_ck[req.request_id] = self.chunk_k
+        return self.chunk_k
+
+    def select_step_width(
+        self,
+        sched: Any,
+        eligible: list[Any],
+        k_want: int,
+        load_width: int,
+    ) -> int:
+        """Select verify width for the step (supports both static and DYNAMIC=1)."""
+        if not self.enabled or not eligible:
+            return k_want
+        if not self.dynamic:
+            ps_k = self.desired_k_for_step(sched, eligible)
+            if ps_k is not None and ps_k <= load_width:
+                return ps_k
+            return k_want
+
+        cur = getattr(sched, "current_step", 0)
+        for req in eligible:
+            if self.is_b_step(req, cur):
+                b_ck = self.pending_b_ck(req.request_id)
+                return b_ck if b_ck <= load_width else k_want
+
+        for req in eligible:
+            self._armed_a_ck.pop(req.request_id, None)
+            self._disarmed_reqs.discard(req.request_id)
+
+        if len(eligible) != 1:
+            return k_want
+        req = eligible[0]
+        if req.is_prefill_chunk or not req.spec_token_ids:
+            return k_want
+
+        ak = getattr(sched, "adaptive_k", None)
+        probs = self._fresh_probs(sched, req.request_id)
+        accept_rate = ak.accept_rate(req.request_id) if ak is not None else 0.70
+        accept_weight = (
+            ak.config.confidence.accept_weight
+            if (ak is not None and ak.config.confidence is not None)
+            else 0.15
+        )
+        max_k_cap = min(load_width, len(req.spec_token_ids))
+        allowed_k = tuple(k for k in self.allowed_k if k <= max_k_cap)
+        if not allowed_k:
+            return k_want
+
+        legal_cks: tuple[int, ...] = ()
+        if self._base_request_ok(sched, req):
+            legal_cks = tuple(
+                ck
+                for ck in self.legal_cks
+                if ck <= load_width and self._ck_budget_ok(sched, req, ck)
+            )
+
+        mode, chosen = select_optimal_action(
+            probs=probs,
+            accept_rate=accept_rate,
+            accept_weight=accept_weight,
+            allowed_k=allowed_k,
+            legal_cks=legal_cks,
+            costs=self.step_costs,
+            min_conf_val=self.min_conf,
+            max_k_cap=max_k_cap,
+        )
+        if mode == "PS":
+            self._armed_a_ck[req.request_id] = chosen
+            return chosen
+        self._disarmed_reqs.add(req.request_id)
+        if legal_cks:
+            self.stats["conf_skipped"] += 1
+        return chosen
+
+    def after_schedule(self, sched: Any, so: Any) -> None:
+        """Tag SchedulerOutput with PipeSpec step markers ("A" or "B")."""
+        if not self.enabled:
+            return
+        cur = sched.current_step
+        marks: dict[str, str] = {}
+        b_ck_used = self.chunk_k
+        for req_id, a_step in list(self.epoch_a_step.items()):
+            if a_step + 1 > cur:
+                continue
+            del self.epoch_a_step[req_id]
+            a_ck = self.epoch_a_ck.pop(req_id, self.chunk_k)
+            b_ck_used = a_ck
+            req = sched.requests.get(req_id)
+            n = so.num_scheduled_tokens.get(req_id)
+            if (
+                a_step + 1 == cur
+                and n == a_ck + 1
+                and len(so.scheduled_spec_decode_tokens.get(req_id, ())) == a_ck
+            ):
+                marks[req_id] = "B"
+                self.stats["b_sched"] += 1
+            else:
+                # Chunk A without Chunk B (abort/preempt/pause race).
+                assert n is None, f"PipeSpec: {req_id} scheduled off-cadence ({n})"
+                self.stats["b_missed"] += 1
+            if req is not None:
+                req.next_decode_eligible_step = a_step + self.pp
+        if marks:
+            so.pipespec_markers = marks
+            so.pipespec_chunk_k = b_ck_used
+            return
+        if len(so.num_scheduled_tokens) != 1:
+            return
+        ((req_id, n),) = so.num_scheduled_tokens.items()
+        if req_id in self._disarmed_reqs:
+            self._disarmed_reqs.discard(req_id)
+            self.stats["normal_steps"] += 1
+            return
+        cand_ck = self._armed_a_ck.pop(req_id, self.chunk_k)
+        req = sched.requests.get(req_id)
+        if req is None or not self._eligible_a(sched, req, n, so, ck=cand_ck):
+            return
+        self.epoch_a_step[req_id] = cur
+        self.epoch_a_ck[req_id] = cand_ck
+        self._inflight_cks.setdefault(req_id, deque()).append(cand_ck)
+        req.next_decode_eligible_step = cur + 1
+        so.pipespec_markers = {req_id: "A"}
+        so.pipespec_chunk_k = cand_ck
+        self.stats["epochs"] += 1
+
+    def _eligible_a(
+        self, sched: Any, req: Any, n: int, so: Any, ck: int | None = None
+    ) -> bool:
+        use_ck = self.chunk_k if ck is None else ck
+        if (
+            n != use_ck + 1
+            or len(so.scheduled_spec_decode_tokens.get(req.request_id, ()))
+            != use_ck
+        ):
+            return False
+        if not self._base_request_ok(sched, req):
+            return False
+        # num_computed_tokens already includes Chunk A (advanced in super()._update_after_schedule).
+        if (
+            req.num_prompt_tokens + req.max_tokens - req.num_computed_tokens
+            < (use_ck + 1 + self.min_left)
+        ):
+            return False
+        if (
+            req.num_computed_tokens
+            + (use_ck + 1)
+            + (2 * use_ck + 1)
+            + self.min_left
+            >= sched.max_model_len
+        ):
+            return False
+        if not self._mamba_boundary_ok(
+            sched, req, max(0, req.num_computed_tokens - (use_ck + 1)), ck=use_ck
+        ):
+            return False
+        if not self._confidence_gate_ok(sched, req.request_id, ck=use_ck):
+            self.stats["conf_skipped"] += 1
+            return False
+        return True
+
+    def on_output(self, req_id: str, mark: str | None, num_generated: int) -> None:
+        if mark == "A":
+            q = self._inflight_cks.get(req_id)
+            a_ck = q.popleft() if q else self.chunk_k
+            self.stats["a_tokens"] += num_generated
+            self.stats["a_full"] += int(num_generated == a_ck + 1)
+        elif mark == "B":
+            if num_generated > 0:
+                self.stats["b_valid"] += 1
+                self.stats["b_tokens"] += num_generated
+            else:
+                self.stats["b_invalid"] += 1
+            done = self.stats["b_valid"] + self.stats["b_invalid"]
+            if self.log_every and done % self.log_every == 0:
+                s = self.stats
+                ep = max(1, s["epochs"])
+                logger.info(
+                    "K3.1 PipeSpec: epochs=%d, normal=%d, skipped=%d, "
+                    "A_full=%.3f, B_valid=%.3f (%.2f tok), B_missed=%d, tok/epoch=%.2f",
+                    s["epochs"],
+                    s["normal_steps"],
+                    s["conf_skipped"],
+                    s["a_full"] / ep,
+                    s["b_valid"] / ep,
+                    s["b_tokens"] / max(1, s["b_valid"]),
+                    s["b_missed"],
+                    (s["a_tokens"] + s["b_tokens"]) / ep,
+                )
+
+
+class KDAPipeSpecStateManager:
+    """Device-only Bank-0 / Bank-1 KDA state isolation for PipeSpec Chunk B.
+
+    Layout per request across the ``1 + K`` reserved Mamba state blocks
+    (requiring ``2 * (chunk_k + 1) <= 1 + K``):
+      - Bank 0 (Chunk A / Normal): slots ``0 .. chunk_k``,
+        conv line ``block_table[0]``.
+      - Bank 1 (Chunk B speculative): slots ``chunk_k + 1 .. 2*chunk_k + 1``,
+        conv line ``block_table[chunk_k + 1]``.
+
+    Before Chunk B runs:
+      1. Copy ``conv_state[block_table[0]] -> conv_state[block_table[chunk_k + 1]]``
+      2. Copy ``recurrent_state[block_table[chunk_k]] -> recurrent_state[block_table[2*chunk_k + 1]]``
+      3. Build Chunk B ``spec_state_indices_tensor`` with cols ``0..chunk_k``
+         pointing to Bank 1 (``block_table[chunk_k + 1 .. 2*chunk_k + 1]``) and
+         ``num_accepted_tokens = chunk_k + 1``.
+
+    After Chunk B is post-processed (on GPU, zero host sync):
+      - If ``num_sampled_b == 0`` (dropped B): Bank 0 and
+        ``num_accepted_tokens_gpu`` stay 100% untouched (exact rollback to A's
+        committed slot ``m_a - 1``, even when ``m_a == chunk_k + 1``!).
+      - If ``num_sampled_b == m_b > 0`` (valid B): copy Bank 1 conv line into
+        Bank 0 conv line, copy Bank 1 slot ``chunk_k + m_b`` into Bank 0 slot
+        ``m_b - 1``, and set ``num_accepted_tokens_gpu = m_b``.
+    """
+
+    @staticmethod
+    def build_chunk_b_state_indices(
+        block_table_tensor: torch.Tensor,
+        chunk_k: int,
+        spec_state_slots: int,
+    ) -> torch.Tensor:
+        """Build Chunk B ``[num_reqs, spec_state_slots]`` state index matrix."""
+        needed = 2 * (chunk_k + 1)
+        if block_table_tensor.shape[1] < needed or spec_state_slots < needed:
+            raise ValueError(
+                f"PipeSpec Chunk B (chunk_k={chunk_k}) needs {needed} state slots, "
+                f"got block_table={block_table_tensor.shape[1]}, "
+                f"spec_state_slots={spec_state_slots}."
+            )
+        out = torch.zeros(
+            (block_table_tensor.shape[0], spec_state_slots),
+            dtype=block_table_tensor.dtype,
+            device=block_table_tensor.device,
+        )
+        out[:, : chunk_k + 1] = block_table_tensor[:, chunk_k + 1 : needed]
+        return out
+
+    @staticmethod
+    def prepare_chunk_b(
+        kda_state_pairs: list[tuple[torch.Tensor, torch.Tensor]],
+        block_table_row: torch.Tensor,
+        chunk_k: int,
+    ) -> None:
+        """Copy Bank-0 full-accept state into Bank-1 before Chunk B forward (CUDA-graph safe)."""
+        if not kda_state_pairs:
+            return
+        src_conv = block_table_row[0:1].to(torch.int64)
+        dst_conv = block_table_row[chunk_k + 1 : chunk_k + 2].to(torch.int64)
+        src_rec = block_table_row[chunk_k : chunk_k + 1].to(torch.int64)
+        dst_rec = block_table_row[2 * chunk_k + 1 : 2 * chunk_k + 2].to(torch.int64)
+        for conv_state, recurrent_state in kda_state_pairs:
+            conv_state.index_copy_(0, dst_conv, conv_state.index_select(0, src_conv))
+            recurrent_state.index_copy_(
+                0, dst_rec, recurrent_state.index_select(0, src_rec)
+            )
+
+    @staticmethod
+    def commit_or_rollback_chunk_b(
+        kda_state_pairs: list[tuple[torch.Tensor, torch.Tensor]],
+        block_table_row: torch.Tensor,
+        chunk_k: int,
+        num_sampled_b: torch.Tensor,
+        num_accepted_tokens_gpu: torch.Tensor,
+        req_idx: torch.Tensor,
+        *,
+        update_accepted: bool = True,
+    ) -> None:
+        """Predicated device-only commit of Bank 1 -> Bank 0 (zero host sync, CUDA-graph safe).
+
+        Uses 1D index_select / index_copy_ exclusively so PyTorch never triggers
+        cuStreamSynchronize on 0-D CUDA tensor indexing during graph capture.
+        When ``num_sampled_b[0] == 0`` (dropped B) this is a bit-exact no-op on
+        both Bank 0 and ``num_accepted_tokens_gpu``.
+        """
+        idx0_1d = req_idx[0:1].to(torch.int64)
+        valid_req = idx0_1d >= 0
+        valid_b_1d = (num_sampled_b[0:1] > 0) & valid_req
+        m_b_1d = num_sampled_b[0:1].clamp(min=1, max=chunk_k + 1).to(torch.int64)
+
+        if kda_state_pairs:
+            src_conv = block_table_row[chunk_k + 1 : chunk_k + 2].to(torch.int64)
+            dst_conv = block_table_row[0:1].to(torch.int64)
+            src_rec = block_table_row.index_select(0, chunk_k + m_b_1d).to(torch.int64)
+            dst_rec = block_table_row.index_select(0, m_b_1d - 1).to(torch.int64)
+            for conv_state, recurrent_state in kda_state_pairs:
+                c_cond = valid_b_1d.view((1,) + (1,) * (conv_state.ndim - 1))
+                c_new = torch.where(
+                    c_cond,
+                    conv_state.index_select(0, src_conv),
+                    conv_state.index_select(0, dst_conv),
+                )
+                conv_state.index_copy_(0, dst_conv, c_new)
+                r_cond = valid_b_1d.view((1,) + (1,) * (recurrent_state.ndim - 1))
+                r_new = torch.where(
+                    r_cond,
+                    recurrent_state.index_select(0, src_rec),
+                    recurrent_state.index_select(0, dst_rec),
+                )
+                recurrent_state.index_copy_(0, dst_rec, r_new)
+
+        if update_accepted:
+            safe_idx = idx0_1d.clamp(min=0, max=num_accepted_tokens_gpu.shape[0] - 1)
+            cur = num_accepted_tokens_gpu.index_select(0, safe_idx)
+            num_accepted_tokens_gpu.index_copy_(
+                0, safe_idx, torch.where(valid_b_1d, m_b_1d.to(cur.dtype), cur)
+            )
