+
+  __shared__ int32_t sh_cnt[1024];
+  __shared__ int32_t sh_pos[1024];
+  __shared__ int32_t sh_warp_sum[8];
+  __shared__ int32_t sh_warp_tsum[8];
+  __shared__ int32_t sh_masks[2];
