+def test_expert_matrices_are_indexed_once(checkpoint, monkeypatch):
+    """An EXL3 expert layer costs one name match per matrix of the
+    checkpoint and one file open per file for the codebook markers, not a
+    scan of every matrix per projection and a file open per matrix (an
+    all-EXL3 real checkpoint has about 250,000 expert matrices per rank)."""
+    from pathlib import Path
+
+    from vllm.sm80.kernels.k31q import manifest as module
+
+    matches, opens = [], []
+
+    class Counting:
+        def match(self, prefix):
+            matches.append(prefix)
+            return module_pattern.match(prefix)
+
+    module_pattern = module._EXPERT_MATRIX
+    real_open = Path.open
+
+    def counting_open(self, *args, **kwargs):
+        opens.append(self.name)
+        return real_open(self, *args, **kwargs)
+
+    with monkeypatch.context() as patch:
+        patch.setattr(module, "_EXPERT_MATRIX", Counting())
+        patch.setattr(Path, "open", counting_open)
+        manifest = K31QManifest(checkpoint)
+    layer = fixture.EXL3_EXPERT_LAYERS[0]
+    experts = fixture.TEXT["num_experts"]
+    expert_matrices = [p for p in manifest.matrices if ".experts." in p]
+    assert len(expert_matrices) == 3 * experts
+    # Each matrix name is matched exactly once.
+    assert sorted(matches) == sorted(manifest.matrices)
+    for w, _ in fixture.PROJECTIONS:
+        projection = manifest.expert_projections[layer, w]
+        assert [m.prefix for m in projection.matrices] == [
+            f"{fixture.P}layers.{layer}.block_sparse_moe.experts.{e}.{w}"
+            for e in range(experts)
+        ]
+    # The layer file is opened for its header and once for all its markers.
+    name = f"layer-{layer:03d}.safetensors"
+    assert opens.count(name) == 2
+    assert max(opens.count(n) for n in set(opens)) <= 2
+    # The markers were really read: a wrong one is still refused.
+    marker = manifest.tensors[expert_matrices[0] + ".mul1"]
+    assert marker.read_bytes() == np.uint32(fixture.EXL3_MUL1).tobytes()
