+def _real_logger():
+    from vllm.logger import _VllmLogger  # noqa: F401  (the patched methods)
+
+    assert type(dt.logger).__name__ != "MagicMock"
+    assert callable(dt.logger.info_once) and callable(dt.logger.warning_once)
+    return dt.logger
